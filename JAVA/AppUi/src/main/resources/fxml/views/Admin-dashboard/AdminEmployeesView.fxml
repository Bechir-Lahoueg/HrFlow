<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="25.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.controller.AdminEmployeesViewController">
    <padding>
        <Insets top="30.0" bottom="30.0" left="40.0" right="40.0" />
    </padding>
    
    <!-- Page Title -->
    <Label text="Gestion des employés" styleClass="page-title">
        <font><Font name="System Bold" size="26.0" /></font>
    </Label>
    
    <!-- Statistics Cards -->
    <GridPane hgap="20.0" vgap="20.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="33.33" />
            <ColumnConstraints percentWidth="33.33" />
            <ColumnConstraints percentWidth="33.33" />
        </columnConstraints>
        
        <VBox styleClass="stat-card, stat-card-blue" alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="0">
            <padding>
                <Insets top="20.0" bottom="20.0" left="20.0" right="20.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="👔" styleClass="stat-icon">
                    <font><Font size="24.0" /></font>
                </Label>
                <Label text="Total Employés" styleClass="stat-title">
                    <font><Font size="14.0" /></font>
                </Label>
            </HBox>
            <Label fx:id="totalEmployeesLabel" text="0" styleClass="stat-value">
                <font><Font name="System Bold" size="36.0" /></font>
            </Label>
        </VBox>
        
        <VBox styleClass="stat-card, stat-card-cyan" alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1">
            <padding>
                <Insets top="20.0" bottom="20.0" left="20.0" right="20.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="✅" styleClass="stat-icon">
                    <font><Font size="24.0" /></font>
                </Label>
                <Label text="Actifs" styleClass="stat-title">
                    <font><Font size="14.0" /></font>
                </Label>
            </HBox>
            <Label fx:id="activeEmployeesLabel" text="0" styleClass="stat-value">
                <font><Font name="System Bold" size="36.0" /></font>
            </Label>
        </VBox>
        
        <VBox styleClass="stat-card, stat-card-purple" alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="2">
            <padding>
                <Insets top="20.0" bottom="20.0" left="20.0" right="20.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="💼" styleClass="stat-icon">
                    <font><Font size="24.0" /></font>
                </Label>
                <Label text="Départements" styleClass="stat-title">
                    <font><Font size="14.0" /></font>
                </Label>
            </HBox>
            <Label fx:id="departmentsLabel" text="0" styleClass="stat-value">
                <font><Font name="System Bold" size="36.0" /></font>
            </Label>
        </VBox>
    </GridPane>
    
    <!-- Employees Table -->
    <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="20.0" bottom="20.0" left="20.0" right="20.0" />
        </padding>
        
        <HBox spacing="15.0" alignment="CENTER_LEFT">
            <Label text="Liste des employés" styleClass="section-title">
                <font><Font name="System Bold" size="18.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="refreshBtn" onAction="#handleRefresh" styleClass="action-btn, action-btn-primary" prefHeight="40.0" prefWidth="120.0" text="🔄 Actualiser">
                <font><Font name="System Bold" size="12.0" /></font>
            </Button>
        </HBox>
        
        <Region minHeight="15.0" />
        
        <TableView fx:id="employeesTableView" VBox.vgrow="ALWAYS" styleClass="modern-table">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="60.0" />
                <TableColumn fx:id="firstNameColumn" text="Prénom" prefWidth="150.0" />
                <TableColumn fx:id="lastNameColumn" text="Nom" prefWidth="150.0" />
                <TableColumn fx:id="emailColumn" text="Email" prefWidth="220.0" />
                <TableColumn fx:id="jobTitleColumn" text="Poste" prefWidth="180.0" />
                <TableColumn fx:id="ageColumn" text="Âge" prefWidth="70.0" />
                <TableColumn fx:id="rhColumn" text="RH Responsable" prefWidth="150.0" />
            </columns>
            <placeholder>
                <Label text="Aucun employé trouvé" style="-fx-text-fill: gray;"/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
