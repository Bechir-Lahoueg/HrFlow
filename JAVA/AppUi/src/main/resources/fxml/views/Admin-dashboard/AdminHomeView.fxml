        <Circle radius="2.5" centerX="1040" centerY="90"  style="-fx-fill: #c7d2fe; -fx-opacity: 0.4;"/>
        <Circle radius="2.5" centerX="1070" centerY="90"  style="-fx-fill: #c7d2fe; -fx-opacity: 0.4;"/>
