<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane prefHeight="760.0" prefWidth="1440.0"
            style="-fx-background-color: #F5F7FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.AdminDashboardController">

    <!-- ═══════════════════════════════════════════════════
         SIDEBAR  — deep slate, full height
    ════════════════════════════════════════════════════ -->
    <left>
        <VBox spacing="4"
              style="-fx-background-color: #0F172A;
                     -fx-min-width: 230; -fx-max-width: 230;
                     -fx-padding: 0;">

            <!-- Brand Block -->
            <VBox style="-fx-padding: 28 24 22 24; -fx-background-color: #0F172A;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <!-- Logo -->
                    <ImageView fitWidth="80" fitHeight="80" preserveRatio="true" smooth="true">
                        <image><Image url="@/logo.png"/></image>
                    </ImageView>
                    <VBox spacing="1">
                        <Label text="HR-Flow"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;
                                      -fx-text-fill: #F8FAFC;"/>
                        <Label text="Administration"
                               style="-fx-font-size: 10px; -fx-text-fill: #64748B;
                                      -fx-font-weight: normal;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Thin divider -->
            <Region style="-fx-background-color: #1E293B; -fx-min-height: 1; -fx-max-height: 1;"
                    maxWidth="Infinity"/>

            <!-- Navigation section label -->
            <Label text="NAVIGATION"
                   style="-fx-font-size: 9.5px; -fx-text-fill: #475569;
                          -fx-font-weight: bold; -fx-padding: 18 24 6 24;
                          -fx-letter-spacing: 1.2px;"/>

            <!-- Nav Buttons -->
            <VBox spacing="2" style="-fx-padding: 0 12 0 12;">

                <Button fx:id="homeBtn" text="🏠  Accueil"
                        maxWidth="Infinity"
                        onAction="#showHome"
                        style="-fx-background-color: #1D4ED8;
                               -fx-text-fill: white;
                               -fx-background-radius: 8;
                               -fx-padding: 11 16;
                               -fx-font-size: 13px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent;"/>

                <Button fx:id="usersBtn" text="Utilisateurs"
                        maxWidth="Infinity"
                        onAction="#showUsers"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8;
                               -fx-padding: 11 16;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent;"/>

                <Button fx:id="employeesBtn" text="Employés"
                        maxWidth="Infinity"
                        onAction="#showEmployees"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8;
                               -fx-padding: 11 16;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent;"/>

                <Button fx:id="statsBtn" text="Statistiques"
                        maxWidth="Infinity"
                        onAction="#showStatistics"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8;
                               -fx-padding: 11 16;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent;"/>

                <Button fx:id="settingsBtn" text="Paramètres"
                        maxWidth="Infinity"
                        onAction="#showSettings"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #94A3B8;
                               -fx-background-radius: 8;
                               -fx-padding: 11 16;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: transparent;"/>
            </VBox>

            <!-- Spacer pushes user block to bottom -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Thin divider -->
            <Region style="-fx-background-color: #1E293B; -fx-min-height: 1; -fx-max-height: 1;"
                    maxWidth="Infinity"/>

            <!-- Bottom User Card -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-padding: 16 18; -fx-background-color: #0F172A;">
                <!-- Avatar -->
                <StackPane style="-fx-background-color: #1E3A5F;
                                  -fx-background-radius: 20;
                                  -fx-min-width: 34; -fx-min-height: 34;
                                  -fx-max-width: 34; -fx-max-height: 34;">
                    <Label text="A"
                           style="-fx-text-fill: #93C5FD;
                                  -fx-font-size: 14px;
                                  -fx-font-weight: bold;"/>
                </StackPane>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label fx:id="sidebarUserLabel" text="Administrateur"
                           style="-fx-text-fill: #CBD5E1;
                                  -fx-font-size: 12px;
                                  -fx-font-weight: bold;"/>
                    <Label text="Super Admin"
                           style="-fx-text-fill: #475569;
                                  -fx-font-size: 10px;"/>
                </VBox>
            </HBox>

        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════
         MAIN CONTENT — white header + light grey body
    ════════════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #F5F7FA;">

            <!-- ── TOP HEADER (white) ── -->
            <HBox alignment="CENTER_LEFT"
                  prefHeight="68"
                  style="-fx-background-color: #FFFFFF;
                         -fx-border-color: transparent transparent #E2E8F0 transparent;
                         -fx-border-width: 0 0 1.5 0;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                <padding>
                    <Insets left="36" right="36"/>
                </padding>

                <!-- Page title area -->
                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Label text="Tableau de bord"
                           style="-fx-font-size: 19px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #0F172A;"/>
                    <Label text="Bienvenue dans l'espace administration"
                           style="-fx-font-size: 11px;
                                  -fx-text-fill: #94A3B8;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Notification bell -->
                <StackPane style="-fx-background-color: #F1F5F9;
                                  -fx-background-radius: 8;
                                  -fx-min-width: 38; -fx-min-height: 38;
                                  -fx-max-width: 38; -fx-max-height: 38;
                                  -fx-cursor: hand;
                                  -fx-border-color: #E2E8F0;
                                  -fx-border-radius: 8;
                                  -fx-border-width: 1;">
                    <Label text="🔔"
                           style="-fx-font-size: 15px;"/>
                </StackPane>

                <Region minWidth="12"/>

                <!-- User badge -->
                <HBox alignment="CENTER" spacing="9"
                      style="-fx-background-color: #F8FAFC;
                             -fx-background-radius: 10;
                             -fx-padding: 7 14;
                             -fx-border-color: #E2E8F0;
                             -fx-border-radius: 10;
                             -fx-border-width: 1;
                             -fx-cursor: hand;">
                    <StackPane style="-fx-background-color: #DBEAFE;
                                      -fx-background-radius: 14;
                                      -fx-min-width: 28; -fx-min-height: 28;
                                      -fx-max-width: 28; -fx-max-height: 28;">
                        <Label text="A"
                               style="-fx-text-fill: #2563EB;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label fx:id="welcomeLabel" text="Admin"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1E293B;"/>
                    <Label text="▾"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: #94A3B8;"/>
                </HBox>

                <Region minWidth="12"/>

                <!-- Logout -->
                <Button onAction="#handleLogout" text="Déconnexion"
                        style="-fx-background-color: #FEF2F2;
                               -fx-text-fill: #DC2626;
                               -fx-background-radius: 8;
                               -fx-border-color: #FECACA;
                               -fx-border-radius: 8;
                               -fx-border-width: 1;
                               -fx-padding: 8 16;
                               -fx-font-size: 12px;
                               -fx-font-weight: bold;
                               -fx-cursor: hand;"/>
            </HBox>

            <!-- ── CONTENT AREA (light grey, scrollable) ── -->
            <ScrollPane fitToWidth="true" fitToHeight="true"
                        VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent;
                               -fx-background: #F5F7FA;
                               -fx-border-color: transparent;
                               -fx-padding: 0;">
                <StackPane fx:id="contentArea"
                           style="-fx-background-color: #F5F7FA;
                                  -fx-padding: 32;">
                    <!-- Dynamic content loaded here -->
                </StackPane>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
