<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.chart.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.controller.AdminStatisticsViewController">
    <VBox spacing="25.0">
        <padding>
            <Insets top="30.0" bottom="30.0" left="40.0" right="40.0" />
        </padding>
        
        <!-- Page Title -->
        <Label text="Statistiques et Analyses" styleClass="page-title">
            <font><Font name="System Bold" size="26.0" /></font>
        </Label>
        
        <!-- Key Metrics Row -->
        <GridPane hgap="20.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
                <ColumnConstraints percentWidth="25.0" />
            </columnConstraints>
            
            <!-- Total Users -->
            <VBox styleClass="stat-card, stat-card-blue" alignment="CENTER" spacing="8.0" GridPane.columnIndex="0">
                <padding>
                    <Insets top="15.0" bottom="15.0" left="15.0" right="15.0" />
                </padding>
                <Label text="Total Utilisateurs" styleClass="stat-title">
                    <font><Font size="13.0" /></font>
                </Label>
                <Label fx:id="totalUsersLabel" text="0" styleClass="stat-value">
                    <font><Font name="System Bold" size="32.0" /></font>
                </Label>
            </VBox>
            
            <!-- Total Employees -->
            <VBox styleClass="stat-card, stat-card-cyan" alignment="CENTER" spacing="8.0" GridPane.columnIndex="1">
                <padding>
                    <Insets top="15.0" bottom="15.0" left="15.0" right="15.0" />
                </padding>
                <Label text="Total Employés" styleClass="stat-title">
                    <font><Font size="13.0" /></font>
                </Label>
                <Label fx:id="totalEmployeesLabel" text="0" styleClass="stat-value">
                    <font><Font name="System Bold" size="32.0" /></font>
                </Label>
            </VBox>
            
            <!-- Total RH -->
            <VBox styleClass="stat-card, stat-card-purple" alignment="CENTER" spacing="8.0" GridPane.columnIndex="2">
                <padding>
                    <Insets top="15.0" bottom="15.0" left="15.0" right="15.0" />
                </padding>
                <Label text="Total RH" styleClass="stat-title">
                    <font><Font size="13.0" /></font>
                </Label>
                <Label fx:id="totalRHLabel" text="0" styleClass="stat-value">
                    <font><Font name="System Bold" size="32.0" /></font>
                </Label>
            </VBox>
            
            <!-- Total Admins -->
            <VBox styleClass="stat-card, stat-card-red" alignment="CENTER" spacing="8.0" GridPane.columnIndex="3">
                <padding>
                    <Insets top="15.0" bottom="15.0" left="15.0" right="15.0" />
                </padding>
                <Label text="Administrateurs" styleClass="stat-title">
                    <font><Font size="13.0" /></font>
                </Label>
                <Label fx:id="totalAdminsLabel" text="0" styleClass="stat-value">
                    <font><Font name="System Bold" size="32.0" /></font>
                </Label>
            </VBox>
        </GridPane>
        
        <!-- Charts Row 1 -->
        <GridPane hgap="20.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" />
                <ColumnConstraints percentWidth="50.0" />
            </columnConstraints>
            
            <!-- User Distribution Pie Chart -->
            <VBox styleClass="chart-card" spacing="15.0" GridPane.columnIndex="0">
                <padding>
                    <Insets top="20.0" bottom="20.0" left="20.0" right="20.0" />
                </padding>
                <Label text="Répartition des Utilisateurs" styleClass="chart-title">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
                <PieChart fx:id="userDistributionChart" legendVisible="true" prefHeight="300.0" />
            </VBox>
            
            <!-- Employees by RH Bar Chart -->
            <VBox styleClass="chart-card" spacing="15.0" GridPane.columnIndex="1">
                <padding>
                    <Insets top="20.0" bottom="20.0" left="20.0" right="20.0" />
                </padding>
                <Label text="Employés par RH" styleClass="chart-title">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
                <BarChart fx:id="employeesByRHChart" prefHeight="300.0">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" label="RH" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" label="Nombre d'employés" />
                    </yAxis>
                </BarChart>
            </VBox>
        </GridPane>
        
        <!-- Charts Row 2 -->
        <GridPane hgap="20.0" vgap="20.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" />
                <ColumnConstraints percentWidth="50.0" />
            </columnConstraints>
            
            <!-- Age Distribution Chart -->
            <VBox styleClass="chart-card" spacing="15.0" GridPane.columnIndex="0">
                <padding>
                    <Insets top="20.0" bottom="20.0" left="20.0" right="20.0" />
                </padding>
                <Label text="Répartition des Âges" styleClass="chart-title">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
                <BarChart fx:id="ageDistributionChart" prefHeight="300.0">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" label="Tranche d'âge" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis side="LEFT" label="Nombre d'employés" />
                    </yAxis>
                </BarChart>
            </VBox>
            
            <!-- Job Title Distribution -->
            <VBox styleClass="chart-card" spacing="15.0" GridPane.columnIndex="1">
                <padding>
                    <Insets top="20.0" bottom="20.0" left="20.0" right="20.0" />
                </padding>
                <Label text="Répartition par Poste" styleClass="chart-title">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
                <PieChart fx:id="jobDistributionChart" legendVisible="true" prefHeight="300.0" />
            </VBox>
        </GridPane>
        
    </VBox>
</ScrollPane>
