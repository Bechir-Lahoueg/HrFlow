<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- ═════════════════════════════════════════════════════════════════════
     AIModelView.fxml  —  AI-Powered Data Analysis View
     User inputs prompts to generate dynamic tables and charts
     Controller: org.example.ui.controller.Rh.AI.DataVisualizationController
     ═════════════════════════════════════════════════════════════════════ -->
<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Ai.DataVisualizationController"
            styleClass="view-container"
            stylesheets="@/css/AiModel.css"
            fitToWidth="true"
            fitToHeight="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">

    <VBox spacing="24" style="-fx-background-color: #f8fafc; -fx-padding: 20;">

        <!-- ═══════════════════════════════════════════════════════════════
             HEADER SECTION — AI Instructions
             ═══════════════════════════════════════════════════════════════ -->
        <VBox styleClass="content-card" spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="20" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <StackPane styleClass="ai-model-icon">
                    <Label text="🤖" styleClass="ai-model-icon-emoji"/>
                </StackPane>

                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="AI Data Analysis" styleClass="ai-model-title"/>
                    <Label text="Ask questions about your recruitment data and get instant visualizations"
                           styleClass="ai-model-subtitle"
                           wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════════════════════════════════════════
             PROMPT SECTION 1 — Table Data Query
             ═══════════════════════════════════════════════════════════════ -->
        <VBox styleClass="content-card" spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="20" left="24"/>
            </padding>

            <!-- Prompt Label & Status -->
            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📊 Table Query" styleClass="ai-prompt-label"/>
                    <Label fx:id="tableStatusLabel" text="" styleClass="ai-status-label"/>
                </HBox>
            </VBox>

            <!-- Prompt Input with Actions -->
            <VBox spacing="12">
                <TextArea fx:id="tablePromptInput"
                          styleClass="ai-prompt-textarea"
                          promptText="e.g., 'Show me top 10 applicants by experience level' or 'List all interviews scheduled this week'"
                          wrapText="true"
                          prefRowCount="3"
                          VBox.vgrow="ALWAYS"/>
                
                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Button fx:id="tableGenerateBtn"
                            styleClass="btn-primary"
                            text="🔍 Generate Table"
                            onAction="#handleGenerateTable"
                            prefWidth="140"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- ═══════════════════════════════════════════════════════════════
             TABLE RESULTS SECTION
             ═══════════════════════════════════════════════════════════════ -->
        <VBox styleClass="content-card" VBox.vgrow="ALWAYS" spacing="0" minHeight="300">
            <padding>
                <Insets top="24" right="24" bottom="20" left="24"/>
            </padding>

            <!-- Table Header -->
            <VBox spacing="8">
                <Label fx:id="tableResultTitle" text="📊 Results Table"
                       styleClass="ai-model-title"/>
                <Label fx:id="tableResultSubtitle" text="Your query results will appear here"
                       styleClass="ai-model-subtitle"/>
            </VBox>

            <Separator style="-fx-background-color: #e2e8f0; -fx-pref-height: 1;"/>

            <!-- Dynamic Table Container -->
            <StackPane VBox.vgrow="ALWAYS" minHeight="200">
                
                <!-- Empty State (shown when no data) -->
                <VBox fx:id="tableEmptyState"
                      alignment="CENTER"
                      spacing="16"
                      style="-fx-background-color: #f8fafc; -fx-background-radius: 8;">
                    <padding>
                        <Insets top="40" right="20" bottom="40" left="20"/>
                    </padding>
                    <Label text="📊" style="-fx-font-size: 48px;"/>
                    <Label text="No data to display" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Label text="Enter a query above and click 'Generate' to see results"
                           style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;" wrapText="true"/>
                </VBox>

                <!-- Actual Table (hidden by default) -->
                <TableView fx:id="resultsTableView"
                           visible="false"
                           managed="false"
                           VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                    
                    <!-- Dynamic columns will be added programmatically by controller -->
                    <placeholder>
                        <VBox alignment="CENTER" spacing="12" style="-fx-background-color: #f8fafc;">
                            <padding>
                                <Insets top="20" right="20" bottom="20" left="20"/>
                            </padding>
                            <Label text="🔍" style="-fx-font-size: 32px;"/>
                            <Label text="No results found" style="-fx-font-size: 14px; -fx-text-fill: #64748b;"/>
                        </VBox>
                    </placeholder>

                </TableView>

            </StackPane>
        </VBox>

        <!-- ═══════════════════════════════════════════════════════════════
             PROMPT SECTION 2 — Chart/Graph Query
             ═══════════════════════════════════════════════════════════════ -->
        <VBox styleClass="content-card" spacing="16">
            <padding>
                <Insets top="24" right="24" bottom="20" left="24"/>
            </padding>

            <!-- Prompt Label & Status -->
            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="📈 Chart Query" styleClass="ai-prompt-label"/>
                    <Label fx:id="chartStatusLabel" text="" styleClass="ai-status-label"/>
                </HBox>
            </VBox>

            <!-- Prompt Input with Actions -->
            <VBox spacing="12">
                <TextArea fx:id="chartPromptInput"
                          styleClass="ai-prompt-textarea"
                          promptText="e.g., 'Show hiring trends over the past 6 months' or 'Compare applications by department'"
                          wrapText="true"
                          prefRowCount="3"
                          VBox.vgrow="ALWAYS"/>
                
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4">
                        <Label text="Chart Type:" style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                        <ComboBox fx:id="chartTypeSelector"
                                  styleClass="form-combo"
                                  prefWidth="120"
                                  onAction="#handleChartTypeChange"
                                  value="PIE">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="BAR"/>
                                    <String fx:value="PIE"/>
                                    <String fx:value="LINE"/>
                                    <String fx:value="AREA"/>
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </VBox>
                    
                    <Region HBox.hgrow="ALWAYS"/>
                    
                    <Button fx:id="chartGenerateBtn"
                            styleClass="btn-primary"
                            text="📈 Generate Chart"
                            onAction="#handleGenerateChart"
                            prefWidth="140"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- ═══════════════════════════════════════════════════════════════
             CHART RESULTS SECTION
             ═══════════════════════════════════════════════════════════════ -->
        <VBox styleClass="content-card" VBox.vgrow="ALWAYS" spacing="0" minHeight="300">
            <padding>
                <Insets top="24" right="24" bottom="28" left="24"/>
            </padding>

            <!-- Chart Header -->
            <VBox spacing="8">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="chartResultTitle" text="📈 Visualization"
                               styleClass="ai-model-title"/>
                        <Label fx:id="chartResultSubtitle" text="Your chart will appear here"
                               styleClass="ai-model-subtitle"/>
                    </VBox>
                    
                    <Button text="⬇ Export PNG" styleClass="btn-secondary"
                            onAction="#handleExportChart"
                            prefWidth="100"/>
                    <Button text="🔄 Refresh" styleClass="btn-secondary"
                            onAction="#handleRefreshChart"
                            prefWidth="100"/>
                </HBox>
            </VBox>

            <Separator style="-fx-background-color: #e2e8f0; -fx-pref-height: 1;"/>

            <!-- Chart Container -->
            <StackPane VBox.vgrow="ALWAYS" minHeight="200">
                
                <!-- Empty State (shown when no chart) -->
                <VBox fx:id="chartEmptyState"
                      alignment="CENTER"
                      spacing="16"
                      style="-fx-background-color: #f8fafc; -fx-background-radius: 8;">
                    <padding>
                        <Insets top="40" right="20" bottom="40" left="20"/>
                    </padding>
                    <Label text="📈" style="-fx-font-size: 48px;"/>
                    <Label text="No visualization to display" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #64748b;"/>
                    <Label text="Enter a query above and click 'Generate' to see a chart"
                           style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;" wrapText="true"/>
                </VBox>

                <!-- Bar Chart -->
                <BarChart fx:id="resultsBarChart"
                          visible="false"
                          managed="false"
                          legendVisible="true"
                          animated="true"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                    <xAxis>
                        <CategoryAxis fx:id="chartXAxis" label="Category"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="chartYAxis" label="Count" side="LEFT"/>
                    </yAxis>
                </BarChart>

                <!-- Line Chart -->
                <LineChart fx:id="resultsLineChart"
                           visible="false"
                           managed="false"
                           legendVisible="true"
                           animated="true"
                           style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                    <xAxis>
                        <CategoryAxis fx:id="lineChartXAxis" label="Time Period"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="lineChartYAxis" label="Value" side="LEFT"/>
                    </yAxis>
                </LineChart>

                <!-- Pie Chart -->
                <PieChart fx:id="resultsPieChart"
                          visible="false"
                          managed="false"
                          legendVisible="true"
                          animated="true"
                          style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;"/>

                <!-- Area Chart -->
                <AreaChart fx:id="resultsAreaChart"
                           visible="false"
                           managed="false"
                           legendVisible="true"
                           animated="true"
                           style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                    <xAxis>
                        <CategoryAxis fx:id="areaChartXAxis" label="Period"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="areaChartYAxis" label="Value" side="LEFT"/>
                    </yAxis>
                </AreaChart>

            </StackPane>
        </VBox>

    </VBox>
</ScrollPane>


