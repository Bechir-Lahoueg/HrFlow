<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="25.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ui.controller.AdminUsersViewController">
    <padding>
        <Insets top="30.0" bottom="30.0" left="40.0" right="40.0" />
    </padding>
    
    <!-- Page Title -->
    <Label text="Gestion des utilisateurs" styleClass="page-title">
        <font><Font name="System Bold" size="26.0" /></font>
    </Label>
    
    <!-- Management Tabs -->
    <VBox styleClass="table-container" VBox.vgrow="ALWAYS">
        <TabPane styleClass="modern-tabpane" VBox.vgrow="ALWAYS">
            <!-- RH Management Tab -->
            <Tab text="Gestion RH" closable="false">
                <VBox spacing="15.0">
                    <padding>
                        <Insets top="15.0" bottom="15.0" left="15.0" right="15.0" />
                    </padding>
                    
                    <!-- Action Buttons -->
                    <HBox spacing="15.0">
                        <Button fx:id="addRHBtn" onAction="#handleAddRH" styleClass="action-btn, action-btn-success" prefHeight="40.0" prefWidth="150.0" text="➕ Ajouter RH">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Button>
                        <Button fx:id="updateRHBtn" onAction="#handleUpdateRH" styleClass="action-btn, action-btn-warning" prefHeight="40.0" prefWidth="150.0" text="✏️ Modifier RH">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Button>
                        <Button fx:id="deleteRHBtn" onAction="#handleDeleteRH" styleClass="action-btn, action-btn-danger" prefHeight="40.0" prefWidth="150.0" text="🗑️ Supprimer RH">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="refreshBtn" onAction="#handleRefresh" styleClass="action-btn, action-btn-primary" prefHeight="40.0" prefWidth="120.0" text="🔄 Actualiser">
                            <font><Font name="System Bold" size="12.0" /></font>
                        </Button>
                    </HBox>
                    
                    <!-- RH Table -->
                    <TableView fx:id="rhTableView" VBox.vgrow="ALWAYS" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="80.0" />
                            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="300.0" />
                            <TableColumn fx:id="roleColumn" text="Rôle" prefWidth="200.0" />
                        </columns>
                        <placeholder>
                            <Label text="Aucun responsable RH trouvé" style="-fx-text-fill: gray;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>
            
            <!-- All Users Tab -->
            <Tab text="Tous les utilisateurs" closable="false">
                <VBox spacing="15.0">
                    <padding>
                        <Insets top="15.0" bottom="15.0" left="15.0" right="15.0" />
                    </padding>
                    
                    <HBox spacing="15.0" alignment="CENTER_LEFT">
                        <Label text="Liste complète des utilisateurs" styleClass="section-title">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleRefresh" styleClass="action-btn, action-btn-primary" text="🔄 Actualiser">
                            <font><Font size="12.0" /></font>
                        </Button>
                    </HBox>
                    
                    <TableView fx:id="allUsersTableView" VBox.vgrow="ALWAYS" styleClass="modern-table">
                        <columns>
                            <TableColumn fx:id="allIdColumn" text="ID" prefWidth="80.0" />
                            <TableColumn fx:id="allUsernameColumn" text="Username" prefWidth="300.0" />
                            <TableColumn fx:id="allRoleColumn" text="Rôle" prefWidth="200.0" />
                        </columns>
                        <placeholder>
                            <Label text="Aucun utilisateur trouvé" style="-fx-text-fill: gray;"/>
                        </placeholder>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </VBox>
</VBox>
