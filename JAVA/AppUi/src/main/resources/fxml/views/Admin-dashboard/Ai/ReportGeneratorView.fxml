<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="org.example.ui.controller.Ai.ReportGeneratorController"
    spacing="12" 
    style="-fx-padding: 20; -fx-background-color: #f8fafc;"
    stylesheets="@/css/AiModel.css"
    prefHeight="-1"
    minHeight="600">

    <!-- ===== REPORT INPUT SECTION ===== -->
    <VBox spacing="12" style="-fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 16; -fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 4, 0, 0, 2);">
        <Label text="📊 Generate Comprehensive Report" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        
        <Label text="Describe the report you need (e.g., 'Show recruitment pipeline overview with application trends')" style="-fx-font-size: 11; -fx-text-fill: #64748b;"/>
        
        <TextArea fx:id="reportPromptInput" 
            wrapText="true" 
            prefHeight="100"
            style="-fx-control-inner-background: #f8fafc; -fx-font-size: 11; -fx-font-family: 'Segoe UI', 'Courier New'; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-padding: 10;"/>
        
        <HBox spacing="12">
            <Button fx:id="generateReportBtn" 
                text="🚀 Generate Report" 
                onAction="#handleGenerateReport"
                style="-fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: transparent;"/>
            <Button fx:id="resetBtn"
                text="⟳ Reset"
                style="-fx-font-size: 12; -fx-padding: 10 18; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: transparent;"/>
            
            <Label fx:id="reportStatusLabel" 
                text="" 
                style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>
        
    <!-- ===== REPORT DISPLAY SECTION ===== -->
    <VBox VBox.vgrow="ALWAYS" spacing="8" minHeight="400">
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="📊 Report Preview" style="-fx-font-size: 14; -fx-font-weight: 600; -fx-text-fill: #1e293b;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="reportCountLabel" text="" style="-fx-font-size: 11; -fx-text-fill: #64748b; -fx-background-color: #f1f5f9; -fx-padding: 4 8; -fx-background-radius: 4;"/>
        </HBox>
        
        <!-- STACKED CONTAINERS - EMPTY STATE AND REPORT CONTAINER -->
        <StackPane VBox.vgrow="ALWAYS">
            <!-- EMPTY STATE -->
            <VBox fx:id="reportEmptyState" 
                alignment="CENTER" 
                spacing="16" 
                style="-fx-padding: 60 40; -fx-background-color: linear-gradient(to bottom, #f8fafc, #f1f5f9); -fx-background-radius: 12; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12; -fx-border-style: dashed;">
                <Label text="📊" style="-fx-font-size: 48; -fx-text-fill: #cbd5e1;"/>
                <Label text="No Report Generated Yet" 
                    style="-fx-font-size: 18; -fx-font-weight: 600; -fx-text-fill: #475569;"/>
                <Label text="Enter a detailed prompt above and click 'Generate Report' to create a comprehensive, narrative-rich report." 
                    wrapText="true"
                    style="-fx-font-size: 13; -fx-text-fill: #64748b; -fx-max-width: 450; -fx-text-alignment: CENTER; -fx-line-spacing: 1.4;"/>
            </VBox>
            
            <!-- REPORT CONTAINER (direct VBox without ScrollPane) -->
            <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
            <VBox fx:id="reportContainer" 
                spacing="16" 
                style="-fx-padding: 32 24; -fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 4);"
                VBox.vgrow="ALWAYS"
                visible="false">
                <!-- Dynamic content populated by controller -->
            </VBox>
            </content>
            </ScrollPane>
        </StackPane>
    </VBox>
</VBox>
