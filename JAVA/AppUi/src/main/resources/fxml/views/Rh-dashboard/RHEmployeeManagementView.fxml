<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="org.example.ui.controller.Rh.RHEmployeeManagementViewController"
            style="-fx-background-color: transparent; -fx-background: transparent;">
    <VBox spacing="25.0" minHeight="700" style="-fx-background-color: #f4f6f9;">
        <padding>
            <Insets top="30.0" bottom="30.0" left="40.0" right="40.0" />
        </padding>

        <!-- Page Title -->
        <HBox alignment="CENTER_LEFT" spacing="20.0">
            <Label text="👔 Gestion des Employés" styleClass="page-title">
                <font><Font name="System Bold" size="30.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button text="➕ Ajouter un Employé" onAction="#handleAddEmployee" styleClass="btn-primary"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;">
                <font><Font size="15.0" /></font>
            </Button>
        </HBox>

        <Separator style="-fx-background-color: #bdc3c7;"/>

        <!-- Statistics Cards -->
        <HBox spacing="22.0" alignment="CENTER_LEFT">
            <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card" prefWidth="240.0" minWidth="200"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #3498db; -fx-border-width: 0 0 4 0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <padding>
                    <Insets top="25.0" bottom="25.0" left="25.0" right="25.0" />
                </padding>
                <Label text="👥" style="-fx-font-size: 40px;" />
                <Label fx:id="totalEmployeesLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #3498db;">
                    <font><Font name="System Bold" size="38.0" /></font>
                </Label>
                <Label text="Total Employés" styleClass="stat-label" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;">
                    <font><Font size="14.0" /></font>
                </Label>
            </VBox>

            <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card, stat-card-age" prefWidth="240.0" minWidth="200"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #9b59b6; -fx-border-width: 0 0 4 0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <padding>
                    <Insets top="25.0" bottom="25.0" left="25.0" right="25.0" />
                </padding>
                <Label text="📊" style="-fx-font-size: 40px;" />
                <Label fx:id="avgAgeLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #9b59b6;">
                    <font><Font name="System Bold" size="38.0" /></font>
                </Label>
                <Label text="Âge Moyen" styleClass="stat-label" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;">
                    <font><Font size="14.0" /></font>
                </Label>
            </VBox>

            <VBox alignment="CENTER" spacing="10.0" styleClass="stat-card, stat-card-jobs" prefWidth="240.0" minWidth="200"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-border-color: #f39c12; -fx-border-width: 0 0 4 0; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <padding>
                    <Insets top="25.0" bottom="25.0" left="25.0" right="25.0" />
                </padding>
                <Label text="💼" style="-fx-font-size: 40px;" />
                <Label fx:id="jobTypesLabel" text="0" styleClass="stat-value" style="-fx-text-fill: #f39c12;">
                    <font><Font name="System Bold" size="38.0" /></font>
                </Label>
                <Label text="Types de Postes" styleClass="stat-label" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;">
                    <font><Font size="14.0" /></font>
                </Label>
            </VBox>
        </HBox>

        <!-- Table -->
        <VBox spacing="18.0" VBox.vgrow="ALWAYS" styleClass="table-container" prefHeight="450" minHeight="350"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Label text="📋 Liste des Employés" styleClass="section-title">
                    <font><Font name="System Bold" size="20.0" /></font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" promptText="🔍 Rechercher..." prefWidth="300.0" prefHeight="38"
                           style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-padding: 8;"/>
            </HBox>

            <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS" prefHeight="280" minHeight="250">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="70.0" minWidth="60"/>
                    <TableColumn fx:id="firstNameColumn" text="Prénom" prefWidth="160.0" minWidth="120"/>
                    <TableColumn fx:id="lastNameColumn" text="Nom" prefWidth="160.0" minWidth="120"/>
                    <TableColumn fx:id="ageColumn" text="Âge" prefWidth="90.0" minWidth="70"/>
                    <TableColumn fx:id="jobTitleColumn" text="Poste" prefWidth="220.0" minWidth="180"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="280.0" minWidth="220"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="160.0" minWidth="130"/>
                </columns>
                <placeholder>
                    <Label text="Aucun employé pour le moment" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                </placeholder>
            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button text="✏️ Modifier" onAction="#handleEditEmployee" styleClass="btn-secondary"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;">
                    <font><Font size="14.0" /></font>
                </Button>
                <Button text="🗑️ Supprimer" onAction="#handleDeleteEmployee" styleClass="btn-danger"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;">
                    <font><Font size="14.0" /></font>
                </Button>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
