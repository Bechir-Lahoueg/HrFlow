<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Rh.Congé.RHLeaveController"
            fitToWidth="true"
            style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">

    <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f0f2f5;">

        <!-- ===== EN-TÊTE ===== -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-padding: 18 24; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 12, 0, 0, 3);">
            <Label text="🏖️" style="-fx-font-size: 28px;"/>
            <Label text="Gestion des Congés RH" style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font><Font name="System Bold" size="22.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="statsButton" text="📊 Statistiques &amp; Export"
                    onAction="#handleShowStats"
                    style="-fx-background-color: rgba(255,255,255,0.20); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 22; -fx-background-radius: 7; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.7); -fx-border-width: 1.5; -fx-border-radius: 7;">
                <font><Font name="System Bold" size="12.0"/></font>
            </Button>
            <Button fx:id="refreshButton" text="🔄 Actualiser"
                    style="-fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 22; -fx-background-radius: 7; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.7); -fx-border-width: 1.5; -fx-border-radius: 7;">
                <font><Font name="System Bold" size="12.0"/></font>
            </Button>
        </HBox>

        <!-- ===== STATISTIQUES ===== -->
        <GridPane hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
            </columnConstraints>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="0"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(59,130,246,0.2), 10, 0, 0, 3); -fx-border-color: #3b82f6; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="📋" style="-fx-font-size: 28px;"/>
                <Label text="Total Demandes" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="totalRequestsLabel" text="0" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #3b82f6;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="1"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(251,191,36,0.2), 10, 0, 0, 3); -fx-border-color: #fbbf24; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="⏳" style="-fx-font-size: 28px;"/>
                <Label text="En Attente" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="pendingRequestsLabel" text="0" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #fbbf24;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="2"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(34,197,94,0.2), 10, 0, 0, 3); -fx-border-color: #22c55e; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="✅" style="-fx-font-size: 28px;"/>
                <Label text="Approuvées" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="approvedRequestsLabel" text="0" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #22c55e;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="3"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(239,68,68,0.2), 10, 0, 0, 3); -fx-border-color: #ef4444; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="❌" style="-fx-font-size: 28px;"/>
                <Label text="Refusées" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="rejectedRequestsLabel" text="0" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #ef4444;"/>
            </VBox>
        </GridPane>

        <!-- ===== DEMANDES (sous-vue) ===== -->
        <fx:include fx:id="leaveRequests" source="RHLeaveRequestsView.fxml"/>

        <!-- ===== SOLDES (sous-vue) ===== -->
        <fx:include fx:id="leaveBalances" source="RHLeaveBalancesView.fxml"/>

    </VBox>
</ScrollPane>
