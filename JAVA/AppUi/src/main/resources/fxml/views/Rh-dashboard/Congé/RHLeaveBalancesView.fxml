<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- Sous-vue : Soldes de congés des employés -->
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.controller.Rh.Congé.RHLeaveBalancesController"
      spacing="14"
      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.09), 10, 0, 0, 3);">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="📊" style="-fx-font-size: 20px;"/>
        <Label text="Soldes de Congés des Employés"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="accrueAllButton" text="🔄 Calculer Soldes Mensuels"
                style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 22; -fx-background-radius: 7; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 1);">
            <font><Font name="System Bold" size="12.0"/></font>
        </Button>
    </HBox>
    <Separator style="-fx-background-color: #e2e8f0;"/>
    <TableView fx:id="balanceTable" prefHeight="280"
               style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8; -fx-font-size: 13px;">
        <columns>
            <TableColumn fx:id="balEmpColumn"       text="👤 Employé"             prefWidth="240" minWidth="180"/>
            <TableColumn fx:id="balAvailableColumn" text="✅ Solde Disponible"     prefWidth="180" minWidth="140" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="balAccruedColumn"   text="📈 Total Accumulé"       prefWidth="180" minWidth="140" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="balUsedColumn"      text="📤 Total Utilisé"        prefWidth="160" minWidth="130" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="balLastAccrualCol"  text="📅 Dernière Attribution" prefWidth="200" minWidth="160" style="-fx-alignment: CENTER;"/>
        </columns>
        <placeholder>
            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 30;">
                <Label text="💰" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                <Label text="Aucun solde enregistré"
                       style="-fx-text-fill: #a0aec0; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label text="Les soldes s'initialisent lors de la 1ère connexion de chaque employé"
                       style="-fx-text-fill: #cbd5e0; -fx-font-size: 11px;" wrapText="true"/>
            </VBox>
        </placeholder>
    </TableView>

</VBox>
