<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" spacing="20" 
     style="-fx-background-color: #f8f9fa; -fx-padding: 30;"
     xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
     fx:controller="org.example.ui.controller.Rh.RHCsvImportExportController">
    
    <!-- Header -->
    <Label text="CSV Import/Export Management"
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 20 0;"/>
    
    <Label text="Manage your recruitment data import and export operations"
           style="-fx-font-size: 14px; -fx-text-fill: #6c757d; -fx-padding: 0 0 30 0;"/>
    
    <Separator style="-fx-background-color: #dee2e6;"/>
    
    <!-- Import Section -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
        <Label text="📥 Import Data"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 10 0;"/>
        
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button fx:id="importJobOffersBtn" text="Import Job Offers"
                    onAction="#importJobOffers"
                    style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 180px; -fx-pref-height: 45px;"/>
            
            <Button fx:id="importApplicationsBtn" text="Import Applications"
                    onAction="#importApplications"
                    style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 180px; -fx-pref-height: 45px;"/>
            
            <Button fx:id="importInterviewsBtn" text="Import Interviews"
                    onAction="#importInterviews"
                    style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 180px; -fx-pref-height: 45px;"/>
        </HBox>
        
        <Label text="Import CSV files to add new job offers, applications, or interviews to the database."
               style="-fx-font-size: 12px; -fx-text-fill: #6c757d; -fx-wrap-text: true; -fx-max-width: 600px;"/>
    </VBox>
    
    <!-- Export Section -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
        <Label text="📤 Export Data"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 10 0;"/>
        
        <HBox spacing="15" alignment="CENTER_LEFT">
            <Button fx:id="exportJobOffersBtn" text="Export Job Offers"
                    onAction="#exportJobOffers"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 180px; -fx-pref-height: 45px;"/>
            
            <Button fx:id="exportApplicationsBtn" text="Export Applications"
                    onAction="#exportApplications"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 180px; -fx-pref-height: 45px;"/>
            
            <Button fx:id="exportInterviewsBtn" text="Export Interviews"
                    onAction="#exportInterviews"
                    style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 180px; -fx-pref-height: 45px;"/>
        </HBox>
        
        <Label text="Export current job offers, applications, or interviews to CSV files for backup or analysis."
               style="-fx-font-size: 12px; -fx-text-fill: #6c757d; -fx-wrap-text: true; -fx-max-width: 600px;"/>
    </VBox>
    
    <!-- Templates Section -->
    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-border-color: #dee2e6; -fx-border-radius: 10;">
        <Label text="📋 Generate Templates"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 10 0;"/>
        
        <Button fx:id="generateTemplatesBtn" text="Generate CSV Templates"
                onAction="#generateTemplates"
                style="-fx-background-color: #6f42c1; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 200px; -fx-pref-height: 45px;"/>
        
        <Label text="Generate sample CSV templates with proper headers and format for easy data entry."
               style="-fx-font-size: 12px; -fx-text-fill: #6c757d; -fx-wrap-text: true; -fx-max-width: 600px;"/>
    </VBox>
    
    <!-- Progress Indicator -->
    <HBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
        <ProgressIndicator fx:id="progressIndicator" 
                       visible="false" 
                       prefWidth="40" 
                       prefHeight="40"
                       style="-fx-progress-color: #007bff;"/>
    </HBox>
    
    <!-- Back Button -->
    <HBox alignment="CENTER_LEFT">
        <Button fx:id="backBtn" text="← Back to Dashboard"
                onAction="#goBack"
                style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 24; -fx-font-size: 14px; -fx-cursor: hand; -fx-pref-width: 180px; -fx-pref-height: 45px;"/>
    </HBox>
    
</VBox>
