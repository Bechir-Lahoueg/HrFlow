<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.controller.Rh.RHProjectDetailsController"
            style="-fx-background-color: transparent;">
    <VBox spacing="20" style="-fx-background-color: #f4f6f9; -fx-padding: 30;">

        <!-- Header avec infos projet -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label fx:id="lblProjectName" text="📋 Nom du Projet"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnEdit" text="✏️ Modifier" onAction="#handleEdit"
                        style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 8 16;"/>
                <Button fx:id="btnDelete" text="🗑️ Supprimer" onAction="#handleDelete"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-padding: 8 16;"/>
                <Button fx:id="btnExportPDF" text="📄 Exporter PDF" onAction="#handleExportPDF"
                        style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Button fx:id="btnBack" text="← Retour" onAction="#handleBack"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 8 16;"/>
            </HBox>

            <Separator/>

            <HBox spacing="30">
                <VBox spacing="5">
                    <Label fx:id="lblProjectStatus" text="Statut: N/A" style="-fx-font-size: 13px;"/>
                    <Label fx:id="lblProjectPriority" text="Priorité: N/A" style="-fx-font-size: 13px;"/>
                    <Label fx:id="lblDates" text="Dates: N/A" style="-fx-font-size: 13px;"/>
                </VBox>
                <VBox spacing="5">
                    <Label fx:id="lblProgress" text="Avancement: 0%" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <ProgressBar fx:id="progressBar" prefWidth="200" progress="0"/>
                    <Label fx:id="lblBudget" text="Budget: N/A" style="-fx-font-size: 13px;"/>
                </VBox>
                <!-- Analytics -->
                <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="📊 Analytics &amp; Prédictions" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Separator/>
                    <Label fx:id="lblPrediction" text="Chargement..." style="-fx-font-size: 12px;"/>
                    <Label fx:id="lblHealthScore" text="Score: --" style="-fx-font-size: 14px;"/>
                    <VBox fx:id="vboxWarnings" spacing="3"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- TabPane avec tous les détails -->
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" minHeight="600"
                 style="-fx-background-color: white; -fx-border-radius: 12; -fx-background-radius: 12;">

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ONGLET 1: ÉQUIPE -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Tab text="👥 Équipe">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label fx:id="lblTeamCount" text="Équipe: 0 membres"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalHours" text="Total heures: 0h"
                               style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnAddMember" text="➕ Ajouter" onAction="#handleAddMember"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 16;"/>
                    </HBox>

                    <TableView fx:id="tableTeam" VBox.vgrow="ALWAYS" prefHeight="350">
                        <columns>
                            <TableColumn fx:id="colTeamName" text="Nom" prefWidth="200"/>
                            <TableColumn fx:id="colTeamRole" text="Rôle" prefWidth="180"/>
                            <TableColumn fx:id="colTeamHours" text="Heures" prefWidth="150"/>
                            <TableColumn fx:id="colTeamJoined" text="Depuis le" prefWidth="120"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10">
                        <Button fx:id="btnEditMember" text="✏️ Modifier rôle" onAction="#handleEditMember"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
                        <Button fx:id="btnRemoveMember" text="🗑️ Retirer" onAction="#handleRemoveMember"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ONGLET 2: TÂCHES KANBAN -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Tab text="✅ Tâches Kanban">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label fx:id="lblTaskStats" text="Tâches: 0/0 terminées"
                               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnNewTask" text="➕ Nouvelle tâche" onAction="#handleNewTask"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 16;"/>
                    </HBox>

                    <Label text="💡 Astuce: Glissez-déposez les tâches pour changer leur statut"
                           style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>

                    <!-- Kanban Board -->
                    <HBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-min-height: 400;">
                        <!-- TODO -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #ecf0f1; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="📋 À FAIRE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Separator/>
                            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
                                <VBox fx:id="kanbanTodo" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                            </ScrollPane>
                        </VBox>

                        <!-- IN PROGRESS -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #fff3cd; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="⏳ EN COURS" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Separator/>
                            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
                                <VBox fx:id="kanbanInProgress" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                            </ScrollPane>
                        </VBox>

                        <!-- REVIEW -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #d1ecf1; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="👁️ REVIEW" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Separator/>
                            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
                                <VBox fx:id="kanbanReview" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                            </ScrollPane>
                        </VBox>

                        <!-- DONE -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #d4edda; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <Label text="✅ TERMINÉ" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Separator/>
                            <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent;">
                                <VBox fx:id="kanbanDone" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                            </ScrollPane>
                        </VBox>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ONGLET 3: JALONS -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Tab text="🎯 Jalons">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label text="Timeline des Jalons" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnNewMilestone" text="➕ Nouveau jalon" onAction="#handleNewMilestone"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 16;"/>
                    </HBox>

                    <TableView fx:id="tableMilestones" VBox.vgrow="ALWAYS" prefHeight="350">
                        <columns>
                            <TableColumn fx:id="colMilestoneName" text="Nom" prefWidth="200"/>
                            <TableColumn fx:id="colMilestoneStatus" text="Statut" prefWidth="130"/>
                            <TableColumn fx:id="colMilestoneProgress" text="Avancement" prefWidth="180"/>
                            <TableColumn fx:id="colMilestoneTarget" text="Date cible" prefWidth="120"/>
                            <TableColumn fx:id="colMilestoneDays" text="Info" prefWidth="150"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10">
                        <Button fx:id="btnCompleteMilestone" text="✅ Marquer terminé" onAction="#handleCompleteMilestone"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                        <Button fx:id="btnEditMilestone" text="✏️ Modifier" onAction="#handleEditMilestone"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
                        <Button fx:id="btnDeleteMilestone" text="🗑️ Supprimer" onAction="#handleDeleteMilestone"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ONGLET 4: ACTIVITÉS -->
            <!-- ═══════════════════════════════════════════════════ -->
            <Tab text="📝 Activités">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <Label text="Historique des activités" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

                    <!-- Feed des activités -->
                    <ListView fx:id="listActivities" VBox.vgrow="ALWAYS" prefHeight="300"
                              style="-fx-border-color: #ddd; -fx-border-radius: 8;"/>

                    <!-- Ajouter un commentaire -->
                    <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;">
                        <Label text="💬 Ajouter un commentaire" style="-fx-font-weight: bold;"/>
                        <TextArea fx:id="txtNewComment" promptText="Écrire un commentaire..." prefRowCount="3"/>
                        <HBox alignment="CENTER_RIGHT">
                            <Button fx:id="btnAddComment" text="✉️ Publier" onAction="#handleAddComment"
                                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 20;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>
            <!-- ═══════════════════════════════════════════════════ -->
            <!-- ONGLET 5: ANALYTICS & RISQUES -->
            <!-- ═══════════════════════════════════════════════════ -->
            <!-- Dans l'onglet Analytics -->
            <Tab text="📊 Analytics">
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                    <VBox spacing="20" style="-fx-padding: 20;">

                        <!-- Prédiction -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                            <Label text="🔮 Prédiction de Date de Fin" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Separator/>
                            <Label fx:id="lblPredictionDetail" text="Analyse en cours..." wrapText="true" style="-fx-font-size: 13px; -fx-line-spacing: 5px;"/>
                        </VBox>

                        <!-- Indicateur de Santé -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                            <Label text="💊 Indicateur de Santé du Projet" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Separator/>
                            <HBox spacing="30" alignment="CENTER_LEFT">
                                <VBox alignment="CENTER" style="-fx-min-width: 120;">
                                    <Label fx:id="lblHealthScoreDetail" text="--" style="-fx-font-size: 56px; -fx-font-weight: bold;"/>
                                    <Label text="/100" style="-fx-font-size: 16px; -fx-text-fill: #666;"/>
                                </VBox>
                                <Separator orientation="VERTICAL"/>
                                <VBox fx:id="vboxHealthDetails" spacing="8" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <!-- Risques -->
                        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #ddd; -fx-border-radius: 8; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);">
                            <Label text="⚠️ Risques Identifiés" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <Separator/>
                            <VBox fx:id="vboxRisks" spacing="12"/>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </Tab>

        </TabPane>

    </VBox>
</ScrollPane>