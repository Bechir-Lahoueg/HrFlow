<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.controller.Rh.RHProjectController"
            style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5; -fx-border-color: transparent;">

    <VBox spacing="0" style="-fx-background-color: #f0f2f5;">

        <VBox spacing="25" style="-fx-padding: 25;">

            <VBox style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-padding: 25 35; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 12; -fx-padding: 12;">
                        <Label text="🎯" style="-fx-font-size: 28px;"/>
                    </StackPane>
                    <VBox>
                        <Label text="Gestion des Projets" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 24px;"/>
                        <Label text="Pilotage stratégique et suivi opérationnel" style="-fx-text-fill: white; -fx-opacity: 0.8; -fx-font-size: 13px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="← Retour Dashboard" onAction="#handleBackToDashboard"
                            style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 25; -fx-padding: 8 22; -fx-cursor: hand; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>

            <VBox spacing="15">
                <HBox spacing="15" alignment="CENTER">
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-border-color: #667eea; -fx-border-width: 0 0 4 0;">
                        <Label text="TOTAL PROJETS" style="-fx-text-fill: #718096; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotalProjects" text="0" style="-fx-text-fill: #2d3748; -fx-font-weight: bold; -fx-font-size: 22px;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-border-color: #38a169; -fx-border-width: 0 0 4 0;">
                        <Label text="ACTIFS" style="-fx-text-fill: #718096; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblActiveProjects" text="0" style="-fx-text-fill: #38a169; -fx-font-weight: bold; -fx-font-size: 22px;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-border-color: #e53e3e; -fx-border-width: 0 0 4 0;">
                        <Label text="EN RETARD" style="-fx-text-fill: #718096; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblDelayedProjects" text="0" style="-fx-text-fill: #e53e3e; -fx-font-weight: bold; -fx-font-size: 22px;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-border-color: #764ba2; -fx-border-width: 0 0 4 0;">
                        <Label text="TERMINÉS" style="-fx-text-fill: #718096; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        <Label fx:id="lblCompletedProjects" text="0" style="-fx-text-fill: #764ba2; -fx-font-weight: bold; -fx-font-size: 22px;"/>
                    </VBox>
                </HBox>

                <HBox spacing="15" alignment="CENTER">
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #ecc94b; -fx-border-width: 0 0 0 4;">
                        <Label text="À RISQUE" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
                        <Label fx:id="lblAtRisk" text="0" style="-fx-font-weight: bold; -fx-text-fill: #d69e2e;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #319795; -fx-border-width: 0 0 0 4;">
                        <Label text="TAUX SUCCÈS" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
                        <Label fx:id="lblSuccessRate" text="0%" style="-fx-font-weight: bold; -fx-text-fill: #319795;"/>
                    </VBox>
                    <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10; -fx-border-color: #4a5568; -fx-border-width: 0 0 0 4;">
                        <Label text="BUDGET UTILISÉ" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>
                        <Label fx:id="lblBudgetUsage" text="0%" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;"/>
                    </VBox>
                </HBox>
            </VBox>

            <HBox spacing="20">
                <VBox prefWidth="350" spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🏆" style="-fx-font-size: 20px;"/>
                        <VBox>
                            <Label text="Top Performers" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #2d3748;"/>
                            <Label text="Basé sur les tâches closes" style="-fx-font-size: 11px; -fx-text-fill: #718096;"/>
                        </VBox>
                    </HBox>
                    <Separator style="-fx-opacity: 0.5;"/>
                    <VBox fx:id="vboxTopPerformers" spacing="8" prefHeight="120"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="🔍 Rechercher un projet..." HBox.hgrow="ALWAYS" prefHeight="40"
                                   style="-fx-background-radius: 20; -fx-background-color: #f8fafc; -fx-border-color: #e2e8f0; -fx-border-radius: 20;"/>
                        <Button text="🔄" onAction="#handleRefresh" prefHeight="40" prefWidth="40"
                                style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-background-radius: 20; -fx-cursor: hand; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="15">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Statut" style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="filterStatus" maxWidth="Infinity" prefHeight="35" style="-fx-background-radius: 8;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Priorité" style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="filterPriority" maxWidth="Infinity" prefHeight="35" style="-fx-background-radius: 8;"/>
                        </VBox>
                        <VBox alignment="BOTTOM_CENTER">
                            <Button fx:id="btnNewProject" text="+ Nouveau Projet" onAction="#handleNewProject" prefHeight="35"
                                    style="-fx-background-color: #38a169; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-padding: 0 20; -fx-cursor: hand;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <VBox VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                <TableView fx:id="tableProjects" VBox.vgrow="ALWAYS" prefHeight="400" minHeight="350">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colName" text="Nom du Projet" prefWidth="220"/>
                        <TableColumn fx:id="colStatus" text="Statut" prefWidth="130"/>
                        <TableColumn fx:id="colPriority" text="Priorité" prefWidth="110"/>
                        <TableColumn fx:id="colProgress" text="Avancement" prefWidth="150"/>
                        <TableColumn fx:id="colEndDate" text="Date de fin" prefWidth="120"/>
                        <TableColumn fx:id="colCollabCount" text="Équipe" prefWidth="80"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>

            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 5 0;">
                <Button fx:id="btnViewDetails" text="👁️ Voir détails" onAction="#handleViewDetails"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Button text="👥 Équipe" onAction="#handleManageTeam"
                        style="-fx-background-color: #764ba2; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="📄 PDF" onAction="#handleQuickExportPDF"
                        style="-fx-background-color: #edf2f7; -fx-text-fill: #2d3748; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold;"/>

                <Button text="🔔 Alertes" onAction="#handleCheckAlerts"
                        style="-fx-background-color: #edf2f7; -fx-text-fill: #2d3748; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold;"/>

                <Button fx:id="btnEditProject" text="✏️ Modifier" onAction="#handleEditProject"
                        style="-fx-background-color: #f6ad55; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold;"/>

                <Button fx:id="btnDeleteProject" text="🗑️ Supprimer" onAction="#handleDeleteProject"
                        style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20; -fx-font-weight: bold;"/>
            </HBox>

        </VBox>
    </VBox>
</ScrollPane>