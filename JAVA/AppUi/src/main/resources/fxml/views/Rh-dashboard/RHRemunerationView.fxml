<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Rh.RHRemunerationController"
            fitToWidth="true"
            style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">

    <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f0f2f5;">
        
        <!-- ===== EN-TÊTE ===== -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-padding: 18 24; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 12, 0, 0, 3);">
            <Label text="💰" style="-fx-font-size: 28px;"/>
            <Label text="Gestion de la Rémunération" style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font><Font name="System Bold" size="22.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnGenerateFiche" text="⚡ Générer Auto"
                    onAction="#handleGenerateFiche"
                    style="-fx-background-color: rgba(255,255,255,0.20); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 22; -fx-background-radius: 7; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.7); -fx-border-width: 1.5; -fx-border-radius: 7;">
                <font><Font name="System Bold" size="12.0"/></font>
            </Button>
            <Button fx:id="refreshButton" text="🔄 Actualiser"
                    style="-fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 22; -fx-background-radius: 7; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.7); -fx-border-width: 1.5; -fx-border-radius: 7;">
                <font><Font name="System Bold" size="12.0"/></font>
            </Button>
        </HBox>

        <!-- ===== STATISTIQUES ===== -->
        <GridPane hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
                <ColumnConstraints percentWidth="25.0"/>
            </columnConstraints>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="0"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.2), 10, 0, 0, 3); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="💵" style="-fx-font-size: 28px;"/>
                <Label text="Total Fiches" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblTotalFiches" text="0" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #3498db;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="1"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(46,204,113,0.2), 10, 0, 0, 3); -fx-border-color: #2ecc71; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="🎁" style="-fx-font-size: 28px;"/>
                <Label text="Total Primes" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblTotalPrimes" text="0 DT" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #2ecc71;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="2"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.2), 10, 0, 0, 3); -fx-border-color: #e74c3c; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="📉" style="-fx-font-size: 28px;"/>
                <Label text="Total Déductions" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblTotalDeductions" text="0 DT" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #e74c3c;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="3"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(243,156,18,0.2), 10, 0, 0, 3); -fx-border-color: #f39c12; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="💰" style="-fx-font-size: 28px;"/>
                <Label text="Masse Salariale" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblMasseSalariale" text="0 DT" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #f39c12;"/>
            </VBox>
        </GridPane>

        <!-- ===== TABS ===== -->
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                 style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
            
            <!-- Tab 1: Fiches de Paie -->
            <Tab text="📄 Fiches de Paie">
                <VBox spacing="12" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊 Fiches de Paie" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtSearchFiche" promptText="🔍 Rechercher..." prefWidth="180"
                                  style="-fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6;"/>
                        <Button fx:id="btnRefreshFiches" text="🔄" onAction="#handleRefreshFiches"
                                style="-fx-background-color: #ecf0f1; -fx-text-fill: #34495e; -fx-font-size: 13px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="tableFiches" VBox.vgrow="ALWAYS"
                              style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colFicheId" text="ID" prefWidth="0.05" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colFicheEmploye" text="Employé" prefWidth="0.20"/>
                            <TableColumn fx:id="colFicheMois" text="Mois" prefWidth="0.10" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colFicheAnnee" text="Année" prefWidth="0.08" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colFicheSalaireBrut" text="Brut" prefWidth="0.12" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colFicheTotalPrimes" text="Primes" prefWidth="0.12" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colFicheTotalDeductions" text="Déductions" prefWidth="0.13" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colFicheSalaireNet" text="Net" prefWidth="0.14" style="-fx-alignment: CENTER_RIGHT;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                                <Label text="📭" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                <Label text="Aucune fiche de paie" style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
                            </VBox>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="btnAddFiche" text="➕ Nouvelle" onAction="#handleAddFiche"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="btnEditFiche" text="✏️ Modifier" onAction="#handleEditFiche"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="btnDeleteFiche" text="🗑️ Supprimer" onAction="#handleDeleteFiche"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Separator orientation="VERTICAL"/>
                        <Button fx:id="btnExportPdfFiche" text="📄 PDF" onAction="#handleExportPdfFiche"
                                style="-fx-background-color: #16a085; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- Tab 2: Primes -->
            <Tab text="🎁 Primes">
                <VBox spacing="12" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🎯 Gestion des Primes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtSearchPrime" promptText="🔍 Rechercher..." prefWidth="180"
                                  style="-fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6;"/>
                        <Button fx:id="btnRefreshPrimes" text="🔄" onAction="#handleRefreshPrimes"
                                style="-fx-background-color: #ecf0f1; -fx-text-fill: #34495e; -fx-font-size: 13px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="tablePrimes" VBox.vgrow="ALWAYS"
                              style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colPrimeId" text="ID" prefWidth="0.06" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colPrimeEmploye" text="Employé" prefWidth="0.30"/>
                            <TableColumn fx:id="colPrimeType" text="Type" prefWidth="0.32"/>
                            <TableColumn fx:id="colPrimeMontant" text="Montant" prefWidth="0.16" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colPrimeDate" text="Date" prefWidth="0.16" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                                <Label text="🎁" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                <Label text="Aucune prime" style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
                            </VBox>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="btnAddPrime" text="➕ Nouvelle" onAction="#handleAddPrime"
                                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="btnEditPrime" text="✏️ Modifier" onAction="#handleEditPrime"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="btnDeletePrime" text="🗑️ Supprimer" onAction="#handleDeletePrime"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- Tab 3: Déductions -->
            <Tab text="📉 Déductions">
                <VBox spacing="12" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊 Gestion des Déductions" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <TextField fx:id="txtSearchDeduction" promptText="🔍 Rechercher..." prefWidth="180"
                                  style="-fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6;"/>
                        <Button fx:id="btnRefreshDeductions" text="🔄" onAction="#handleRefreshDeductions"
                                style="-fx-background-color: #ecf0f1; -fx-text-fill: #34495e; -fx-font-size: 13px; -fx-padding: 6 10; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="tableDeductions" VBox.vgrow="ALWAYS"
                              style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colDeductionId" text="ID" prefWidth="0.06" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colDeductionEmploye" text="Employé" prefWidth="0.30"/>
                            <TableColumn fx:id="colDeductionType" text="Type" prefWidth="0.32"/>
                            <TableColumn fx:id="colDeductionMontant" text="Montant" prefWidth="0.16" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colDeductionDate" text="Date" prefWidth="0.16" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                                <Label text="📉" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                <Label text="Aucune déduction" style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
                            </VBox>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="btnAddDeduction" text="➕ Nouvelle" onAction="#handleAddDeduction"
                                style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="btnEditDeduction" text="✏️ Modifier" onAction="#handleEditDeduction"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="btnDeleteDeduction" text="🗑️ Supprimer" onAction="#handleDeleteDeduction"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- Tab 4: Conversion -->
            <Tab text="💱 Conversion">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🌍 Conversion TND" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnRefreshRates" text="🔄 Actualiser" onAction="#handleRefreshRates"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>

                    <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 18; -fx-background-radius: 10; -fx-border-color: #4a90e2; -fx-border-width: 2; -fx-border-radius: 10;">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="4">
                                <Label text="Montant (TND)" style="-fx-font-size: 11px; -fx-text-fill: #718096;"/>
                                <TextField fx:id="txtMontantConversion" promptText="Ex: 1500" prefWidth="150"
                                          style="-fx-font-size: 13px; -fx-padding: 8; -fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6;"/>
                            </VBox>

                            <Label text="→" style="-fx-font-size: 20px; -fx-text-fill: #4a90e2; -fx-padding: 8 0 0 0;"/>

                            <VBox spacing="6" alignment="CENTER" style="-fx-background-color: #edf2f7; -fx-padding: 12; -fx-background-radius: 8; -fx-min-width: 110;">
                                <Label text="🇪🇺 EUR" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                                <Label fx:id="lblConversionEUR" text="—" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                            </VBox>

                            <VBox spacing="6" alignment="CENTER" style="-fx-background-color: #edf2f7; -fx-padding: 12; -fx-background-radius: 8; -fx-min-width: 110;">
                                <Label text="🇺🇸 USD" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                                <Label fx:id="lblConversionUSD" text="—" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                            </VBox>
                        </HBox>

                        <Label fx:id="lblApiStatus" text="✅ API connectée" 
                               style="-fx-font-size: 10px; -fx-text-fill: #27ae60; -fx-background-color: #d5f4e6; -fx-padding: 5 8; -fx-background-radius: 5;"/>
                    </VBox>

                    <HBox spacing="15" alignment="CENTER" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-padding: 16; -fx-background-radius: 10;">
                        <VBox spacing="4" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 12; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                            <Label text="EUR" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            <Label fx:id="lblTauxEUR" text="0.290 €" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </VBox>

                        <VBox spacing="4" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.15); -fx-padding: 12; -fx-background-radius: 8;" HBox.hgrow="ALWAYS">
                            <Label text="USD" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                            <Label fx:id="lblTauxUSD" text="0.320 $" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>

    </VBox>
</ScrollPane>
