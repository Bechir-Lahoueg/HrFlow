<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- ═════════════════════════════════════════════════════════════════════
     Unified Data Analysis View - Single Scrollable Area
     Contains Table, Chart, and Report Generation in one view
     Controller: org.example.ui.controller.Rh.Recrutement.UnifiedDataAnalysisController
     ═════════════════════════════════════════════════════════════════════ -->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.controller.Ai.DataAnalysisController"
      spacing="0"
      styleClass="view-container"
      stylesheets="@/css/dashboard.css, /css/AiModel.css"
      VBox.vgrow="ALWAYS">

    <!-- Single Scrollable Area for All Content -->
    <ScrollPane fitToWidth="true" 
                fitToHeight="true" 
                VBox.vgrow="ALWAYS" 
                style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED">
        
        <VBox spacing="24" style="-fx-background-color: #f8fafc; -fx-padding: 20;">

            <!-- ═══════════════════════════════════════════════════════════════
                 TABLE DATA SECTION
                 ═══════════════════════════════════════════════════════════════ -->
            <VBox styleClass="content-card" spacing="16">
                <padding>
                    <Insets top="24" right="24" bottom="20" left="24"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <StackPane styleClass="ai-model-icon">
                        <Label text="📊" styleClass="ai-model-icon-emoji"/>
                    </StackPane>

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Table Data Analysis" styleClass="ai-model-title"/>
                        <Label text="Ask questions about your recruitment data and get instant table results"
                               styleClass="ai-model-subtitle"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- Table Prompt Section -->
                <VBox spacing="12">
                    <Label text="What data would you like to see in table format?" 
                           styleClass="ai-prompt-label"/>
                    
                    <TextArea fx:id="tablePromptInput"
                              promptText="e.g., 'Show all applications from last month' or 'List job offers by department'"
                              wrapText="true"
                              prefHeight="80"
                              styleClass="ai-prompt-textarea"/>
                    
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button fx:id="generateTableBtn"
                                text="🚀 Generate Table"
                                onAction="#handleGenerateTable"
                                styleClass="ai-generate-btn"/>
                        
                        <Label fx:id="tableStatusLabel"
                               text=""
                               styleClass="ai-status-label"/>
                        
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Table Results Section -->
                <VBox fx:id="tableResultsSection" 
                      spacing="12" 
                      visible="false" 
                      managed="false"
                      VBox.vgrow="ALWAYS">
                    
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📋 Results" styleClass="ai-results-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="tableRowCount" text="" styleClass="ai-results-count"/>
                    </HBox>
                    
                    <TableView fx:id="resultsTableView"
                               styleClass="ai-results-table"
                               VBox.vgrow="ALWAYS"
                               prefHeight="300">
                        <columns>
                            <TableColumn fx:id="tableColumn1" text="Column 1" prefWidth="150"/>
                            <TableColumn fx:id="tableColumn2" text="Column 2" prefWidth="150"/>
                            <TableColumn fx:id="tableColumn3" text="Column 3" prefWidth="150"/>
                            <TableColumn fx:id="tableColumn4" text="Column 4" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ═══════════════════════════════════════════════════════════════
                 CHART VISUALIZATION SECTION
                 ═══════════════════════════════════════════════════════════════ -->
            <VBox styleClass="content-card" spacing="16">
                <padding>
                    <Insets top="24" right="24" bottom="20" left="24"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <StackPane styleClass="ai-model-icon">
                        <Label text="📈" styleClass="ai-model-icon-emoji"/>
                    </StackPane>

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Chart Visualization" styleClass="ai-model-title"/>
                        <Label text="Create beautiful charts from your recruitment data"
                               styleClass="ai-model-subtitle"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- Chart Prompt Section -->
                <VBox spacing="12">
                    <Label text="What would you like to visualize?" 
                           styleClass="ai-prompt-label"/>
                    
                    <TextArea fx:id="chartPromptInput"
                              promptText="e.g., 'Show application trends by month' or 'Create a pie chart of job departments'"
                              wrapText="true"
                              prefHeight="80"
                              styleClass="ai-prompt-textarea"/>
                    
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Chart Type:" styleClass="ai-prompt-label"/>
                            <ComboBox fx:id="chartTypeSelector"
                                      styleClass="ai-chart-type-selector">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="BAR"/>
                                        <String fx:value="LINE"/>
                                        <String fx:value="PIE"/>
                                        <String fx:value="AREA"/>
                                    </FXCollections>
                                </items>
                                <value>
                                    <String fx:value="BAR"/>
                                </value>
                            </ComboBox>
                        </VBox>
                        
                        <Button fx:id="generateChartBtn"
                                text="🚀 Generate Chart"
                                onAction="#handleGenerateChart"
                                styleClass="ai-generate-btn"/>
                        
                        <Label fx:id="chartStatusLabel"
                               text=""
                               styleClass="ai-status-label"/>
                        
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Chart Results Section -->
                <VBox fx:id="chartResultsSection" 
                      spacing="12" 
                      visible="false" 
                      managed="false"
                      VBox.vgrow="ALWAYS">
                    
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📈 Visualization" styleClass="ai-results-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="chartDataPoints" text="" styleClass="ai-results-count"/>
                    </HBox>
                    
                    <!-- Chart Container -->
                    <StackPane fx:id="chartContainer" 
                               styleClass="ai-chart-container"
                               VBox.vgrow="ALWAYS"
                               prefHeight="300">
                        
                        <!-- Bar Chart -->
                        <BarChart fx:id="resultsBarChart" 
                                  visible="false" 
                                  managed="false"
                                  styleClass="ai-chart">
                            <xAxis>
                                <CategoryAxis fx:id="chartXAxis" label="Categories"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="chartYAxis" label="Values"/>
                            </yAxis>
                        </BarChart>
                        
                        <!-- Line Chart -->
                        <LineChart fx:id="resultsLineChart" 
                                   visible="false" 
                                   managed="false"
                                   styleClass="ai-chart">
                            <xAxis>
                                <CategoryAxis fx:id="lineChartXAxis" label="Categories"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="lineChartYAxis" label="Values"/>
                            </yAxis>
                        </LineChart>
                        
                        <!-- Pie Chart -->
                        <PieChart fx:id="resultsPieChart" 
                                  visible="false" 
                                  managed="false"
                                  styleClass="ai-chart"/>
                        
                        <!-- Area Chart -->
                        <AreaChart fx:id="resultsAreaChart" 
                                   visible="false" 
                                   managed="false"
                                   styleClass="ai-chart">
                            <xAxis>
                                <CategoryAxis fx:id="areaChartXAxis" label="Categories"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis fx:id="areaChartYAxis" label="Values"/>
                            </yAxis>
                        </AreaChart>
                    </StackPane>
                </VBox>
            </VBox>

            <!-- ═══════════════════════════════════════════════════════════════
                 REPORT GENERATION SECTION
                 ═══════════════════════════════════════════════════════════════ -->
            <VBox styleClass="content-card" spacing="16">
                <padding>
                    <Insets top="24" right="24" bottom="20" left="24"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <StackPane styleClass="ai-model-icon">
                        <Label text="📄" styleClass="ai-model-icon-emoji"/>
                    </StackPane>

                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Comprehensive Report Generation" styleClass="ai-model-title"/>
                        <Label text="Generate detailed reports with tables, charts, and insights"
                               styleClass="ai-model-subtitle"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- Report Prompt Section -->
                <VBox spacing="12">
                    <Label text="Describe the comprehensive report you need:" 
                           styleClass="ai-prompt-label"/>
                    
                    <TextArea fx:id="reportPromptInput"
                              promptText="e.g., 'Generate a complete recruitment pipeline report with application trends, interview success rates, and department breakdowns'"
                              wrapText="true"
                              prefHeight="100"
                              styleClass="ai-prompt-textarea"/>
                    
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Button fx:id="generateReportBtn"
                                text="🚀 Generate Report"
                                onAction="#handleGenerateReport"
                                styleClass="ai-generate-btn"/>
                        
                        <Button fx:id="resetReportBtn"
                                text="⟳ Reset"
                                onAction="#handleResetReport"
                                styleClass="ai-reset-btn"/>
                        
                        <Label fx:id="reportStatusLabel"
                               text=""
                               styleClass="ai-status-label"/>
                        
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                </VBox>

                <!-- Report Results Section -->
                <VBox fx:id="reportResultsSection" 
                      spacing="12" 
                      visible="false" 
                      managed="false"
                      VBox.vgrow="ALWAYS">
                    
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="📊 Report Preview" styleClass="ai-results-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="reportBlockCount" text="" styleClass="ai-results-count"/>
                    </HBox>
                    
                    <!-- Report Container -->
                    <ScrollPane fx:id="reportScrollPane"
                               fitToWidth="true"
                               hbarPolicy="NEVER"
                               vbarPolicy="AS_NEEDED"
                               styleClass="ai-report-scroll"
                               VBox.vgrow="ALWAYS"
                               prefHeight="400">
                        
                        <VBox fx:id="reportContainer" 
                              spacing="16" 
                              style="-fx-background-color: transparent;"/>
                    </ScrollPane>
                </VBox>
            </VBox>

        </VBox>
        
    </ScrollPane>

</VBox>
