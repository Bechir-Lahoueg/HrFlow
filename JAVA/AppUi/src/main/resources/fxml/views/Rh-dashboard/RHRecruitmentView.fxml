<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.controller.Rh.RHRecruitmentController" spacing="12" style="-fx-padding:20;">

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="👥 Gestion des recrutements" style="-fx-font-size:18; -fx-font-weight:bold;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="refreshBtn" text="🔄 Actualiser" />
        <Button fx:id="addBtn" text="➕ Ajouter" />
    </HBox>

    <TableView fx:id="offersTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60" />
            <TableColumn fx:id="colTitle" text="Titre" prefWidth="240" />
            <TableColumn fx:id="colDepartment" text="Département" prefWidth="140" />
            <TableColumn fx:id="colLocation" text="Lieu" prefWidth="140" />
            <TableColumn fx:id="colStatus" text="Statut" prefWidth="100" />
            <TableColumn fx:id="colCreated" text="Créé le" prefWidth="160" />
        </columns>
    </TableView>

</VBox>
