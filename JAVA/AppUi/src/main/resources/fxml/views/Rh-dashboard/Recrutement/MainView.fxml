<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!-- ═══════════════════════════════════════════════════════════════════════
     MainView.fxml  —  Shell Layout (Horizontal Nav)
     Root is a StackPane so the modal overlay floats over everything.
     Controller: controllers.MainController
     ═══════════════════════════════════════════════════════════════════════ -->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.ui.controller.Rh.Recrutement.MainController"
           stylesheets="@/css/dashboard.css">

    <!-- ═══════════════════════════════════════════════════════════════
         LAYER 1  —  The Actual Dashboard
         ═══════════════════════════════════════════════════════════════ -->
    <BorderPane styleClass="root-pane">

        <!-- ───────────────────────────────────────────────────────────
             TOP  —  Full-width navigation + sub-header
             ─────────────────────────────────────────────────────────── -->
        <top>
            <VBox minHeight="116">

                <!-- ── Row 1 : Horizontal Nav Bar ── -->
                <HBox styleClass="h-navbar" alignment="CENTER_LEFT" spacing="4">

                    <!-- Brand -->
                    <HBox styleClass="h-brand" alignment="CENTER_LEFT" spacing="10">
                        <StackPane styleClass="brand-icon-wrapper" prefWidth="32" prefHeight="32">
                            <Label text="HR" styleClass="brand-icon-text"/>
                        </StackPane>
                        <Label text="HRFlow" styleClass="h-brand-title"/>
                    </HBox>

                    <Separator orientation="VERTICAL" styleClass="h-nav-divider" prefHeight="28"/>

                    <!-- Primary Nav Tabs -->
                    <Button fx:id="btnJobOffers"
                            styleClass="h-nav-btn"
                            onAction="#handleJobOffers">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <Label text="📋" styleClass="nav-icon"/>
                                <Label text="Job Offers" styleClass="nav-label"/>
                                <Label fx:id="badgeJobs" text="" styleClass="nav-badge nav-badge-blue"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnApplications"
                            styleClass="h-nav-btn"
                            onAction="#handleApplications">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <Label text="📄" styleClass="nav-icon"/>
                                <Label text="Applications" styleClass="nav-label"/>
                                <Label fx:id="badgeApplications" text="" styleClass="nav-badge nav-badge-green"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnInterviews"
                            styleClass="h-nav-btn"
                            onAction="#handleInterviews">
                        <graphic>
                            <HBox alignment="CENTER" spacing="6">
                                <Label text="🎙" styleClass="nav-icon"/>
                                <Label text="Interviews" styleClass="nav-label"/>
                                <Label fx:id="badgeInterviews" text="" styleClass="nav-badge nav-badge-orange"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Separator orientation="VERTICAL" styleClass="h-nav-divider" prefHeight="28"/>

                    <!-- Actions -->
                    <HBox styleClass="h-actions" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnRefresh"
                                styleClass="h-action-btn"
                                onAction="#handleRefresh">
                            <graphic>
                                <Label text="�" styleClass="nav-icon"/>
                            </graphic>
                        </Button>
                    </HBox>



                </HBox>

                <!-- ── Row 2 : Sub-header (title + search + profile) ── -->
                <HBox styleClass="top-header" alignment="CENTER_LEFT" spacing="16">

                    <VBox spacing="2">
                        <Label fx:id="headerTitle" text="Job Offers"
                               styleClass="header-page-title"/>
                        <Label fx:id="headerBreadcrumb" text="Dashboard  /  Job Offers"
                               styleClass="header-breadcrumb"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                </HBox>

            </VBox>
        </top>

        <!-- ───────────────────────────────────────────────────────────
             CENTER  —  Dynamic Content Area
             ─────────────────────────────────────────────────────────── -->
        <center>
            <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="main-content-scrollpane"
                        style="-fx-background-color: transparent; -fx-padding: 0;">
                <StackPane fx:id="contentArea" styleClass="content-area" alignment="TOP_CENTER">
                    <Label text="⏳  Loading view…" styleClass="placeholder-label"
                           StackPane.alignment="CENTER"/>
                </StackPane>
            </ScrollPane>
        </center>

    </BorderPane>

    <!-- ═══════════════════════════════════════════════════════════════
         LAYER 2  —  Global Modal Overlay
         ═══════════════════════════════════════════════════════════════ -->
    <StackPane fx:id="globalModalOverlay"
               styleClass="modal-overlay"
               visible="false"
               managed="false">

        <Pane styleClass="modal-backdrop"
              onMouseClicked="#handleCloseModal"/>

        <VBox fx:id="modalCard"
              styleClass="modal-card"
              spacing="0"
              minWidth="580"
              prefWidth="580"
              maxWidth="580"
              StackPane.alignment="CENTER">

            <HBox styleClass="modal-header" alignment="CENTER_LEFT">
                <VBox spacing="3">
                    <Label fx:id="modalTitle" text="Add New Job Offer"
                           styleClass="modal-title"/>
                    <Label fx:id="modalSubtitle"
                           text="Fill in the details below."
                           styleClass="modal-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" styleClass="modal-close-btn"
                        onAction="#handleCloseModal"/>
            </HBox>

            <Separator styleClass="modal-divider"/>

            <StackPane fx:id="modalBody"
                       styleClass="modal-body-container"
                       VBox.vgrow="ALWAYS"/>

            <Separator styleClass="modal-divider"/>

            <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="12">
                <Label fx:id="formErrorLabel" text=""
                       styleClass="form-error-label"
                       maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Cancel" styleClass="btn-secondary"
                        onAction="#handleCloseModal"/>
                <Button fx:id="btnModalSave" text="Save"
                        styleClass="btn-primary"
                        onAction="#handleModalSave"/>
            </HBox>

        </VBox>
    </StackPane>

</StackPane>
