<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" pannable="true" vbarPolicy="AS_NEEDED" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.controller.Employee.EmployeeRequestController"
            style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">

    <VBox spacing="20" style="-fx-padding: 20;">

        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-padding: 15 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);">
            <Label text="📋" style="-fx-font-size: 24px;"/>
            <VBox>
                <Label text="Mes Demandes" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px;"/>
                <Label text="Suivi et création de requêtes" style="-fx-text-fill: white; -fx-opacity: 0.8; -fx-font-size: 11px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="backButton" text="← Retour" onAction="#handleBackToDashboard"
                    style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: white; -fx-border-width: 1;"/>
        </HBox>

        <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="➕" style="-fx-font-size: 18px; -fx-text-fill: #667eea;"/>
                <Label text="Nouvelle Demande" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
            </HBox>
            <Separator/>

            <GridPane hgap="25" vgap="15">
                <columnConstraints>
                    <ColumnConstraints minWidth="150" prefWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Type de demande :" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;"/>
                <ComboBox fx:id="requestTypeComboBox" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity" prefHeight="38"/>

                <Label text="Priorité :" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;"/>
                <ComboBox fx:id="priorityComboBox" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" prefHeight="38"/>

                <Label text="Titre :" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;"/>
                <TextField fx:id="titleField" GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="38" promptText="Ex: Demande de congés..."/>

                <Label text="Description :" GridPane.rowIndex="3" style="-fx-font-weight: bold; -fx-text-fill: #4a5568;" GridPane.valignment="TOP">
                    <padding><Insets top="5"/></padding>
                </Label>
                <TextArea fx:id="descriptionArea" GridPane.rowIndex="3" GridPane.columnIndex="1" prefRowCount="4" wrapText="true"/>
            </GridPane>

            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                <Label text="📎 Pièce jointe :" style="-fx-font-weight: bold;"/>
                <Button fx:id="btnAttachment" text="Choisir un fichier" onAction="#handleChooseAttachment" style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 5;"/>
                <Button text="Retirer" onAction="#handleRemoveAttachment" style="-fx-background-color: transparent; -fx-text-fill: #e53e3e; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Label fx:id="lblAttachmentName" text="Aucune pièce jointe" style="-fx-text-fill: #a0aec0; -fx-font-italic: true;"/>
            </HBox>

            <HBox spacing="12">
                <Button fx:id="submitButton" text="✅ Soumettre la demande" onAction="#handleSubmitRequest"
                        style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Button fx:id="clearButton" text="Réinitialiser" onAction="#handleClearForm"
                        style="-fx-background-color: #edf2f7; -fx-text-fill: #4a5568; -fx-padding: 12 24; -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>
        </VBox>

        <VBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 8, 0, 0, 2);">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="📑" style="-fx-font-size: 18px; -fx-text-fill: #764ba2;"/>
                <Label text="Historique des demandes" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-border-color: #667eea; -fx-border-radius: 20; -fx-padding: 6 15; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER">
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #ebf4ff; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label fx:id="totalRequestsLabel" text="Total : 0" style="-fx-text-fill: #2b6cb0; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #fffaf0; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label fx:id="pendingRequestsLabel" text="En attente : 0" style="-fx-text-fill: #9c4221; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #f0fff4; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label fx:id="approvedRequestsLabel" text="Approuvées : 0" style="-fx-text-fill: #276749; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </VBox>
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS" style="-fx-background-color: #fff5f5; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label fx:id="rejectedRequestsLabel" text="Rejetées : 0" style="-fx-text-fill: #9b2c2c; -fx-font-weight: bold; -fx-font-size: 14px;"/>
                </VBox>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f8fafc; -fx-padding: 12; -fx-background-radius: 8;">
                <TextField fx:id="searchField" promptText="🔍 Rechercher par titre..." prefWidth="300" prefHeight="35" style="-fx-background-radius: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 20; -fx-background-color: white;"/>
                <Separator orientation="VERTICAL" prefHeight="20"/>
                <Label text="Statut :" style="-fx-font-weight: bold; -fx-text-fill: #718096;"/>
                <ComboBox fx:id="filterStatusComboBox" prefWidth="180" prefHeight="35" style="-fx-background-radius: 20;"/>
            </HBox>

            <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS" prefHeight="300" style="-fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="titleColumn" text="Titre de la demande" prefWidth="250"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="150"/>
                    <TableColumn fx:id="priorityColumn" text="Priorité" prefWidth="100"/>
                    <TableColumn fx:id="statusColumn" text="Statut" prefWidth="120"/>
                    <TableColumn fx:id="submittedDateColumn" text="Date Création" prefWidth="150"/>
                    <TableColumn fx:id="reviewedDateColumn" text="Date Traitement" prefWidth="150"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="viewDetailsButton" text="👁️ Voir détails" onAction="#handleViewDetails"
                        style="-fx-background-color: #edf2f7; -fx-text-fill: #2d3748; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Button fx:id="editButton" text="✏️ Modifier" onAction="#handleEditRequest"
                        style="-fx-background-color: #fefcbf; -fx-text-fill: #744210; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="cancelButton" text="🚫 Annuler" onAction="#handleCancelRequest"
                        style="-fx-background-color: white; -fx-border-color: #e53e3e; -fx-text-fill: #e53e3e; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Button fx:id="deleteButton" text="🗑️ Supprimer" onAction="#handleDeleteRequest"
                        style="-fx-background-color: #e53e3e; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>