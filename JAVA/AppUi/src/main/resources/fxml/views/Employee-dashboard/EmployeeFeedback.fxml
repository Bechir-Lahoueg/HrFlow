<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.controller.Employee.EmployeeFeedbackController"
            style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">

    <VBox spacing="15" style="-fx-background-color: #f0f2f5; -fx-padding: 20;">

        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-padding: 15 20; -fx-background-radius: 10;">
            <Label text="💬" style="-fx-font-size: 24px;"/>
            <Label text="Mes Feedbacks" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="backButton" text="← Retour" onAction="#handleBackToDashboard"
                    style="-fx-background-color: rgba(255,255,255,0.3); -fx-text-fill: white; -fx-padding: 8 18; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: white; -fx-border-width: 1;"/>
        </HBox>

        <HBox fx:id="tabNavBar" spacing="0" alignment="CENTER_LEFT"
              style="-fx-background-color: white; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 2 0; -fx-padding: 0;">
            <Button fx:id="btnTabEmployee" text="👥 Feedback Employé" onAction="#showEmployeePanel"
                    style="-fx-background-color: transparent; -fx-text-fill: #667eea; -fx-padding: 16 20; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-width: 0 0 3 0; -fx-border-color: #667eea;"/>
            <Button fx:id="btnTabFormation" text="🎓 Feedback Formation" onAction="#showFormationPanel"
                    style="-fx-background-color: transparent; -fx-text-fill: #a0aec0; -fx-padding: 16 20; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 13px; -fx-border-width: 0 0 3 0; -fx-border-color: transparent;"/>
        </HBox>

        <StackPane fx:id="contentStackPane" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 0 0 10 10;">

            <VBox fx:id="panelEmployee" spacing="20" style="-fx-padding: 20;">
                <HBox spacing="20">
                    <VBox spacing="15" HBox.hgrow="ALWAYS">
                        <Label text="📬 Feedbacks reçus" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label fx:id="lblTotalReceived" text="Total : 0" style="-fx-background-color: #ebf4ff; -fx-text-fill: #3182ce; -fx-padding: 5 12; -fx-background-radius: 15; -fx-font-weight: bold;"/>
                            <Label fx:id="lblAvgRating" text="Moyenne : 0 ⭐" style="-fx-background-color: #fffaf0; -fx-text-fill: #dd6b20; -fx-padding: 5 12; -fx-background-radius: 15; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Filtrer :"/>
                            <ComboBox fx:id="filterTypeReceived" prefWidth="130" promptText="Type"/>
                            <Button text="🔄" onAction="#handleRefreshReceived" style="-fx-cursor: hand;"/>
                        </HBox>

                        <TableView fx:id="tableReceivedFeedbacks" prefHeight="180">
                            <columns>
                                <TableColumn fx:id="colReceivedFrom" text="De" prefWidth="120"/>
                                <TableColumn fx:id="colReceivedType" text="Type" prefWidth="120"/>
                                <TableColumn fx:id="colReceivedRating" text="Note" prefWidth="80"/>
                                <TableColumn fx:id="colReceivedDate" text="Date" prefWidth="120"/>
                            </columns>
                        </TableView>
                        <Button fx:id="btnViewReceivedDetails" text="👁️ Voir détails" onAction="#handleViewReceivedDetails" style="-fx-background-color: #edf2f7;"/>

                        <Separator/>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📤 Mes feedbacks envoyés" style="-fx-font-weight: bold;"/>
                            <Label fx:id="lblTotalSent" text="Total : 0" style="-fx-text-fill: #718096; -fx-font-size: 12px;"/>
                        </HBox>
                        <TableView fx:id="tableSentFeedbacks" prefHeight="150">
                            <columns>
                                <TableColumn fx:id="colSentTo" text="À" prefWidth="120"/>
                                <TableColumn fx:id="colSentType" text="Type" prefWidth="120"/>
                                <TableColumn fx:id="colSentRating" text="Note" prefWidth="80"/>
                                <TableColumn fx:id="colSentDate" text="Date" prefWidth="100"/>
                            </columns>
                        </TableView>
                        <HBox spacing="10">
                            <Button fx:id="btnEditSent" text="✏️ Modifier" onAction="#handleEditSentFeedback" style="-fx-background-color: #feebc8;"/>
                            <Button fx:id="btnDeleteSent" text="🗑️ Supprimer" onAction="#handleDeleteSentFeedback" style="-fx-background-color: #fed7d7;"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="12" style="-fx-background-color: #f7fafc; -fx-padding: 20; -fx-background-radius: 10;" minWidth="320">
                        <Label text="➕ Envoyer un feedback" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                        <Separator/>
                        <Label text="Destinataire *"/>
                        <ComboBox fx:id="cbToUser" promptText="Choisir un employé..." maxWidth="Infinity"/>
                        <Label text="Type *"/>
                        <ComboBox fx:id="cbFeedbackType" maxWidth="Infinity"/>
                        <Label text="Note *"/>
                        <Slider fx:id="sliderRating" min="1" max="5" value="3" showTickMarks="true" snapToTicks="true"/>
                        <Label fx:id="lblRatingValue" text="⭐ 3 / 5" alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold; -fx-text-fill: #d69e2e;"/>
                        <Label text="Commentaire *"/>
                        <TextArea fx:id="txtComment" promptText="Votre commentaire..." prefRowCount="4" wrapText="true"/>
                        <CheckBox fx:id="chkAnonymous" text="Envoyer anonymement" style="-fx-text-fill: #000000; -fx-font-weight: bold;"/>
                        <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                            <Button fx:id="btnSendFeedback" text="💾 Envoyer" onAction="#handleSendFeedback" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #667eea; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;"/>
                            <Button text="🔄" onAction="#handleClearFeedbackForm" style="-fx-padding: 10;"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>

            <VBox fx:id="panelFormation" spacing="20" style="-fx-padding: 20;" visible="false">
                <HBox spacing="20">
                    <VBox spacing="15" HBox.hgrow="ALWAYS">
                        <Label text="📚 Mes feedbacks formation" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label fx:id="lblTotalFF" text="Total : 0" style="-fx-background-color: #ebf4ff; -fx-padding: 5 12; -fx-background-radius: 15;"/>
                            <Label fx:id="lblAvgRatingFF" text="Moyenne : 0 ⭐" style="-fx-background-color: #fffaf0; -fx-padding: 5 12; -fx-background-radius: 15;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Formation :"/>
                            <ComboBox fx:id="filterFormationFF" prefWidth="180" promptText="Toutes"/>
                            <Button text="🔄" onAction="#handleRefreshFF"/>
                        </HBox>
                        <TableView fx:id="tableMyFF" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colFFFormation" text="Formation" prefWidth="150"/>
                                <TableColumn fx:id="colFFSession" text="Session" prefWidth="120"/>
                                <TableColumn fx:id="colFFRating" text="Note" prefWidth="80"/>
                                <TableColumn fx:id="colFFRecommande" text="Recommandé" prefWidth="100"/>
                                <TableColumn fx:id="colFFDate" text="Date" prefWidth="100"/>
                            </columns>
                        </TableView>
                        <HBox spacing="10">
                            <Button fx:id="btnViewFFDetails" text="👁️ Voir détails" onAction="#handleViewFFDetails"/>
                            <Button fx:id="btnEditFF" text="✏️ Modifier" onAction="#handleEditFF" style="-fx-background-color: #feebc8;"/>
                            <Button fx:id="btnDeleteFF" text="🗑️ Supprimer" onAction="#handleDeleteFF" style="-fx-background-color: #fed7d7;"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color: #f7fafc; -fx-padding: 20; -fx-background-radius: 10;" minWidth="320">
                        <Label text="📝 Nouveau feedback formation" style="-fx-font-weight: bold;"/>
                        <Separator/>
                        <Label text="Formation *"/>
                        <ComboBox fx:id="cbFormation" promptText="Choisir..." maxWidth="Infinity"/>
                        <Label text="Session"/>
                        <ComboBox fx:id="cbSession" promptText="Choisir..." maxWidth="Infinity"/>
                        <Label text="Note globale *"/>
                        <Slider fx:id="sliderRatingFF" min="1" max="5" value="3" showTickMarks="true"/>
                        <Label fx:id="lblRatingValueFF" text="⭐ 3 / 5" alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold;"/>
                        <Label text="Contenu"/>
                        <TextArea fx:id="txtContenu" promptText="Avis contenu..." prefRowCount="2"/>
                        <Label text="Formateur"/>
                        <TextArea fx:id="txtFormateur" promptText="Avis formateur..." prefRowCount="2"/>
                        <Label text="Organisation"/>
                        <TextArea fx:id="txtOrganisation" promptText="Avis organisation..." prefRowCount="2"/>
                        <CheckBox fx:id="chkRecommande" text="Je recommande ✅" selected="true" style="-fx-text-fill: #000000; -fx-font-weight: bold;"/>
                        <HBox spacing="10" style="-fx-padding: 10 0 0 0;">
                            <Button fx:id="btnSubmitFF" text="💾 Soumettre" onAction="#handleSubmitFF" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #764ba2; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;"/>
                            <Button text="🔄" onAction="#handleClearFFForm" style="-fx-padding: 10;"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </VBox>
</ScrollPane>