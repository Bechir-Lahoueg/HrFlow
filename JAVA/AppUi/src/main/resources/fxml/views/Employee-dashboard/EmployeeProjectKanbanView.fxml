<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.controller.Employee.EmployeeProjectKanbanController"
            style="-fx-background-color: transparent;">
    <VBox spacing="20" style="-fx-background-color: #f4f6f9; -fx-padding: 30;">

        <!-- Header projet -->
        <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12;">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label fx:id="lblProjectName" text="📋 Nom du Projet"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Actualiser" onAction="#handleRefresh"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 16;"/>
                <Button fx:id="btnBack" text="← Retour" onAction="#handleBack"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 8 16;"/>
            </HBox>

            <Separator/>

            <HBox spacing="30">
                <VBox spacing="5">
                    <Label fx:id="lblMyRole" text="Mon rôle: N/A" style="-fx-font-size: 13px;"/>
                    <Label fx:id="lblMyHours" text="Mes heures: 0h" style="-fx-font-size: 13px;"/>
                </VBox>
                <VBox spacing="5">
                    <Label fx:id="lblProgress" text="Avancement: 0%" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                    <ProgressBar fx:id="progressBar" prefWidth="200" progress="0"/>
                    <Label fx:id="lblTaskStats" text="Mes tâches: 0/0 terminées" style="-fx-font-size: 13px;"/>
                </VBox>
                <Separator orientation="VERTICAL" prefHeight="50"/>
                <VBox spacing="5" alignment="CENTER" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #ddd;">
                    <Label fx:id="lblTimer" text="00:00:00" style="-fx-font-family: 'Monospaced'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    <HBox spacing="10">
                        <Button fx:id="btnStartTimer" text="▶" onAction="#handleStartTimer" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                        <Button fx:id="btnStopTimer" text="■" onAction="#handleStopTimer" style="-fx-background-color: #c0392b; -fx-text-fill: white;" disable="true"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>

        <!-- Kanban Board -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12;">
            <Label text="✅ Mes Tâches - Kanban Board" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="💡 Glissez-déposez les tâches pour changer leur statut ou utilisez les boutons"
                   style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>

            <HBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-min-height: 450;">
                <!-- TODO -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #ecf0f1; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="📋 À FAIRE" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Separator/>
                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox fx:id="kanbanTodo" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                    </ScrollPane>
                </VBox>

                <!-- IN PROGRESS -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #fff3cd; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="⏳ EN COURS" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Separator/>
                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox fx:id="kanbanInProgress" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                    </ScrollPane>
                </VBox>

                <!-- REVIEW -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #d1ecf1; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="👁️ REVIEW" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Separator/>
                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox fx:id="kanbanReview" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                    </ScrollPane>
                </VBox>

                <!-- DONE -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" style="-fx-background-color: #d4edda; -fx-padding: 10; -fx-border-radius: 8; -fx-background-radius: 8;">
                    <Label text="✅ TERMINÉ" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <Separator/>
                    <ScrollPane fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                        <VBox fx:id="kanbanDone" spacing="10" style="-fx-padding: 5;" minHeight="500" />
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>

        <!-- Activités -->
        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 12; -fx-background-radius: 12;">
            <Label text="📝 Activités du Projet" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <ListView fx:id="listActivities" prefHeight="200"
                      style="-fx-border-color: #ddd; -fx-border-radius: 8;"/>

            <VBox spacing="10" style="-fx-background-color: #f8f9fa; -fx-padding: 15; -fx-border-radius: 8; -fx-background-radius: 8;">
                <Label text="💬 Ajouter un commentaire" style="-fx-font-weight: bold;"/>
                <TextArea fx:id="txtComment" promptText="Écrire un commentaire..." prefRowCount="2"/>
                <HBox alignment="CENTER_RIGHT">
                    <Button text="✉️ Publier" onAction="#handleAddComment"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 8 20;"/>
                </HBox>
            </VBox>
        </VBox>

    </VBox>
</ScrollPane>