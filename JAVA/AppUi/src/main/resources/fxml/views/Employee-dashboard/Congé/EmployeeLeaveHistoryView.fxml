<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.controller.Employee.Congé.EmployeeLeaveHistoryController"
      spacing="12" prefHeight="520"
      style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12;
             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="📋" style="-fx-font-size: 18px;"/>
        <Label text="Historique de mes Demandes"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="tableCountLabel" text="0 demande(s)"
               style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold;
                      -fx-background-color: #edf2f7; -fx-padding: 4 10; -fx-background-radius: 5;"/>
    </HBox>
    <Separator style="-fx-background-color: #e2e8f0;"/>
    <TableView fx:id="leaveRequestsTable" prefHeight="380" minHeight="300"
              style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="idColumn" text="#" prefWidth="55" minWidth="45" resizable="false"/>
            <TableColumn fx:id="startDateColumn" text="📅 Début" prefWidth="120" minWidth="95"/>
            <TableColumn fx:id="endDateColumn" text="📅 Fin" prefWidth="120" minWidth="95"/>
            <TableColumn fx:id="leaveTypeColumn" text="Type de Congé" prefWidth="190" minWidth="130"/>
            <TableColumn fx:id="daysColumn" text="⏱ Jours" prefWidth="85" minWidth="65" resizable="false"/>
            <TableColumn fx:id="statusColumn" text="Statut" prefWidth="140" minWidth="110"/>
            <TableColumn fx:id="requestDateColumn" text="Date Demande" prefWidth="130" minWidth="100"/>
        </columns>
        <placeholder>
            <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                <Label text="📭" style="-fx-font-size: 42px; -fx-opacity: 0.25;"/>
                <Label text="Aucune demande de congé"
                       style="-fx-text-fill: #a0aec0; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Label text="Créez votre première demande dans le formulaire ci-dessus"
                       style="-fx-text-fill: #cbd5e0; -fx-font-size: 11px;"/>
            </VBox>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="viewDetailsButton" text="👁️ Voir Détails"
                style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-font-weight: bold; -fx-padding: 7 16; -fx-background-radius: 7; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(66,153,225,0.3), 5, 0, 0, 2);"/>
        <Button fx:id="deleteButton" text="🗑️ Supprimer"
                style="-fx-background-color: #f56565; -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-font-weight: bold; -fx-padding: 7 16; -fx-background-radius: 7; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(245,101,101,0.3), 5, 0, 0, 2);"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="6" alignment="CENTER"
              style="-fx-background-color: #f7fafc; -fx-padding: 6 12; -fx-background-radius: 7;
                     -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 7;">
            <Label text="💡" style="-fx-font-size: 11px;"/>
            <Label text="Cliquez sur une ligne pour activer les actions"
                   style="-fx-font-size: 10px; -fx-text-fill: #718096; -fx-font-style: italic;"/>
        </HBox>
    </HBox>
</VBox>
