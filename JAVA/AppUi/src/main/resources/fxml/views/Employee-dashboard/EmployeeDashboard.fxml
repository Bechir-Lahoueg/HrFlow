<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane prefHeight="780.0" prefWidth="1440.0" minHeight="620" minWidth="1050"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Employee.EmployeeDashboardController"
            style="-fx-background-color: #ffffff;">

    <!-- ═══════════════════════════════════════════════════
         SIDEBAR — Premium dark sidebar (Espace Employé)
         ═══════════════════════════════════════════════════ -->
    <left>
        <VBox spacing="3"
              style="-fx-background-color: #111827;
                     -fx-padding: 0 0 0 0;
                     -fx-min-width: 235;
                     -fx-max-width: 235;">

            <!-- ── BRAND HEADER ── -->
            <VBox spacing="0"
                  style="-fx-background-color: #0d1420;
                         -fx-padding: 24 20 20 20;
                         -fx-border-color: transparent transparent #1f2937 transparent;
                         -fx-border-width: 1;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <!-- Logo -->
                    <ImageView fitWidth="84" fitHeight="84" preserveRatio="true" smooth="true">
                        <image><Image url="@/logo.png"/></image>
                    </ImageView>
                    <VBox spacing="2">
                        <Label text="HR-Flow"
                               style="-fx-font-size: 18px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #f9fafb;"/>
                        <Label text="Espace Employé"
                               style="-fx-font-size: 9px;
                                      -fx-text-fill: #4b5563;"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ── NAV AREA ── -->
            <VBox spacing="2" VBox.vgrow="ALWAYS" style="-fx-padding: 16 12 0 12;">

                <!-- Section label -->
                <Label text="MENU PRINCIPAL"
                       style="-fx-font-size: 9px;
                              -fx-text-fill: #374151;
                              -fx-padding: 4 6 8 6;
                              -fx-font-weight: bold;"/>

                <!-- ACTIVE — Accueil -->
                <HBox spacing="0" style="-fx-background-color: transparent;">
                    <Region prefWidth="3" minHeight="38"
                            style="-fx-background-color: #3b82f6;
                                   -fx-background-radius: 0 3 3 0;"/>
                    <Button fx:id="homeBtn" text="🏠   Accueil"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            onAction="#showHome"
                            style="-fx-background-color: rgba(59,130,246,0.12);
                                   -fx-text-fill: #60a5fa;
                                   -fx-background-radius: 0 10 10 0;
                                   -fx-padding: 11 14;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-cursor: hand;
                                   -fx-alignment: CENTER_LEFT;"/>
                </HBox>

                <!-- Inactive nav items -->
                <Button fx:id="leaveBtn" text="🏖️   Mes Congés"
                        maxWidth="Infinity"
                        onAction="#showLeave"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #6b7280;
                               -fx-background-radius: 10;
                               -fx-padding: 11 17;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;"/>

                <Button fx:id="requestsBtn" text="📋   Mes Demandes"
                        maxWidth="Infinity"
                        onAction="#showRequests"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #6b7280;
                               -fx-background-radius: 10;
                               -fx-padding: 11 17;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;"/>

                <Button fx:id="feedbacksBtn" text="💬   Feedbacks et Réclamations"
                        maxWidth="Infinity"
                        onAction="#showFeedbacks"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #6b7280;
                               -fx-background-radius: 10;
                               -fx-padding: 11 17;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;"/>

                <Button fx:id="projectsBtn" text="🎯   Projets"
                        maxWidth="Infinity"
                        onAction="#showProjects"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #6b7280;
                               -fx-background-radius: 10;
                               -fx-padding: 11 17;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;"/>

                <Button fx:id="formationBtn" text="📚   Formations"
                        maxWidth="Infinity"
                        onAction="#showFormations"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #6b7280;
                               -fx-background-radius: 10;
                               -fx-padding: 11 17;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;"/>

                <Button fx:id="remunerationBtn" text="💰   Rémunération"
                        maxWidth="Infinity"
                        onAction="#showRemuneration"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #6b7280;
                               -fx-background-radius: 10;
                               -fx-padding: 11 17;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;"/>

                <Button fx:id="recrutementBtn" text="👥   Recrutement"
                        maxWidth="Infinity"
                        onAction="#showRecruitment"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #6b7280;
                               -fx-background-radius: 10;
                               -fx-padding: 11 17;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;"/>

                <!-- Divider before settings -->
                <Region prefHeight="10"/>
                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4 6 8 6;">
                    <Region prefHeight="1" maxHeight="1" prefWidth="12"
                            style="-fx-background-color: #1f2937;"/>
                    <Label text="COMPTE"
                           style="-fx-font-size: 9px;
                                  -fx-text-fill: #374151;
                                  -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS" prefHeight="1" maxHeight="1"
                            style="-fx-background-color: #1f2937;"/>
                </HBox>

                <!-- Notifications -->
                <StackPane>
                    <Button fx:id="notifBellButton" text="🔔   Notifications"
                            maxWidth="Infinity"
                            onAction="#showNotificationPopup"
                            style="-fx-background-color: transparent;
                                   -fx-text-fill: #6b7280;
                                   -fx-background-radius: 10;
                                   -fx-padding: 11 17;
                                   -fx-font-size: 13px;
                                   -fx-cursor: hand;
                                   -fx-alignment: CENTER_LEFT;"/>
                    <Label fx:id="notifBadgeLabel" text="0" visible="false"
                           style="-fx-background-color: #ef4444;
                                  -fx-text-fill: white;
                                  -fx-font-size: 8px;
                                  -fx-font-weight: bold;
                                  -fx-background-radius: 8;
                                  -fx-padding: 2 4;
                                  -fx-min-width: 16; -fx-min-height: 16;"
                           StackPane.alignment="TOP_RIGHT"
                           translateX="-8.0" translateY="8.0"/>
                </StackPane>

                <!-- Paramètres — special tint -->
                <Button fx:id="settingsBtn" text="⚙️   Paramètres"
                        maxWidth="Infinity"
                        onAction="#showSettings"
                        style="-fx-background-color: rgba(107,114,128,0.08);
                               -fx-text-fill: #9ca3af;
                               -fx-background-radius: 10;
                               -fx-padding: 11 17;
                               -fx-font-size: 13px;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-border-color: rgba(107,114,128,0.15);
                               -fx-border-radius: 10;
                               -fx-border-width: 1;"/>

                <!-- Push user card to bottom -->
                <VBox VBox.vgrow="ALWAYS"/>
            </VBox>

            <!-- ── USER CARD BOTTOM ── -->
            <VBox style="-fx-padding: 0 12 16 12;">
                <Region prefHeight="1" maxHeight="1" maxWidth="Infinity"
                        style="-fx-background-color: #1f2937;"/>
                <Region prefHeight="12"/>
                <HBox alignment="CENTER_LEFT" spacing="11"
                      style="-fx-background-color: #1a2236;
                             -fx-background-radius: 14;
                             -fx-padding: 11 14;
                             -fx-border-color: #1f2d47;
                             -fx-border-radius: 14;
                             -fx-border-width: 1;">
                    <!-- Avatar with gradient ring + online dot -->
                    <StackPane>
                        <StackPane style="-fx-background-color: linear-gradient(135deg,#6366f1,#3b82f6);
                                           -fx-background-radius: 22;
                                           -fx-min-width: 38; -fx-min-height: 38;
                                           -fx-max-width: 38; -fx-max-height: 38;">
                            <StackPane style="-fx-background-color: #1a2236;
                                               -fx-background-radius: 19;
                                               -fx-min-width: 32; -fx-min-height: 32;
                                               -fx-max-width: 32; -fx-max-height: 32;">
                                <Label text="👤" style="-fx-font-size: 15px;"/>
                            </StackPane>
                        </StackPane>
                        <!-- Online indicator -->
                        <StackPane StackPane.alignment="BOTTOM_RIGHT"
                                   style="-fx-background-color: #22c55e;
                                          -fx-background-radius: 6;
                                          -fx-min-width: 10; -fx-min-height: 10;
                                          -fx-max-width: 10; -fx-max-height: 10;
                                          -fx-border-color: #1a2236;
                                          -fx-border-radius: 6;
                                          -fx-border-width: 2;"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="sidebarUserLabel" text="Employé"
                               style="-fx-text-fill: #e5e7eb;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>
                        <Label text="● En ligne"
                               style="-fx-text-fill: #22c55e;
                                      -fx-font-size: 9px;"/>
                    </VBox>
                    <Label text="⋯"
                           style="-fx-text-fill: #374151; -fx-font-size: 16px; -fx-padding: 0 0 4 0;"/>
                </HBox>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════════ -->
    <center>
        <VBox spacing="0" minWidth="780"
              style="-fx-background-color: #ffffff;">

            <!-- ─── TOP NAVBAR (blanc) ─── -->
            <HBox alignment="CENTER" prefHeight="70" spacing="20"
                  style="-fx-background-color: #ffffff;
                         -fx-border-color: #e8edf3;
                         -fx-border-width: 0 0 1 0;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 3);">
                <padding>
                    <Insets left="32" right="28" top="10" bottom="10"/>
                </padding>

                <!-- Page breadcrumb -->
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Mon Espace"
                           style="-fx-font-size: 17px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1e293b;"/>
                    <Label text="Tableau de bord · Aujourd'hui"
                           style="-fx-font-size: 10px;
                                  -fx-text-fill: #94a3b8;"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Date / Time -->
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="dateLabel" text="19 Fév 2026"
                           style="-fx-font-size: 11px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #475569;"/>
                    <Label fx:id="timeLabel" text="14:30"
                           style="-fx-font-size: 10px;
                                  -fx-text-fill: #94a3b8;"/>
                </VBox>

                <!-- Separator -->
                <Separator orientation="VERTICAL" prefHeight="30"
                           style="-fx-background-color: #e2e8f0;"/>

                <!-- Notification bell -->
                <StackPane>
                    <Button text="🔔"
                            onAction="#showNotificationPopup"
                            style="-fx-background-color: #f8fafc;
                                   -fx-background-radius: 10;
                                   -fx-min-width: 40; -fx-min-height: 40;
                                   -fx-max-width: 40; -fx-max-height: 40;
                                   -fx-font-size: 16px;
                                   -fx-cursor: hand;
                                   -fx-border-color: #e2e8f0;
                                   -fx-border-radius: 10;
                                   -fx-border-width: 1;"/>
                    <Label text="●" visible="false"
                           style="-fx-background-color: #ef4444;
                                  -fx-text-fill: white;
                                  -fx-font-size: 8px;
                                  -fx-font-weight: bold;
                                  -fx-background-radius: 8;
                                  -fx-padding: 2 4;
                                  -fx-min-width: 16; -fx-min-height: 16;"
                           StackPane.alignment="TOP_RIGHT"/>
                </StackPane>

                <!-- Separator -->
                <Separator orientation="VERTICAL" prefHeight="30"
                           style="-fx-background-color: #e2e8f0;"/>

                <!-- User pill navbar -->
                <HBox alignment="CENTER" spacing="10"
                      style="-fx-background-color: #f8fafc;
                             -fx-background-radius: 12;
                             -fx-padding: 7 16 7 8;
                             -fx-cursor: hand;
                             -fx-border-color: #e2e8f0;
                             -fx-border-radius: 12;
                             -fx-border-width: 1;">
                    <StackPane style="-fx-background-color: linear-gradient(135deg,#6366f1,#3b82f6);
                                       -fx-background-radius: 16;
                                       -fx-min-width: 32; -fx-min-height: 32;
                                       -fx-max-width: 32; -fx-max-height: 32;">
                        <Label text="👤" style="-fx-font-size: 15px;"/>
                    </StackPane>
                    <VBox alignment="CENTER_LEFT" spacing="1">
                        <Label fx:id="welcomeLabel" text="Employé"
                               style="-fx-text-fill: #1e293b;
                                      -fx-font-size: 12px;
                                      -fx-font-weight: bold;"/>
                        <Label text="Espace Employé"
                               style="-fx-text-fill: #94a3b8;
                                      -fx-font-size: 9px;"/>
                    </VBox>
                    <Label text="⌄"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-padding: 0 0 2 4;"/>
                </HBox>

                <!-- Logout -->
                <Button onAction="#handleLogout" text="Déconnexion"
                        style="-fx-background-color: #fff1f2;
                               -fx-text-fill: #dc2626;
                               -fx-background-radius: 10;
                               -fx-padding: 9 18;
                               -fx-cursor: hand;
                               -fx-font-weight: bold;
                               -fx-font-size: 12px;
                               -fx-border-color: #fecdd3;
                               -fx-border-radius: 10;
                               -fx-border-width: 1;">
                    <font><Font name="System Bold" size="12.0"/></font>
                </Button>
            </HBox>

            <!-- ─── SCROLLABLE CONTENT (blanc) ─── -->
            <ScrollPane fitToWidth="true" fitToHeight="true"
                        VBox.vgrow="ALWAYS" minHeight="540"
                        style="-fx-background-color: transparent;
                               -fx-background: #f4f7fb;">
                <StackPane fx:id="contentArea" minHeight="540"
                           style="-fx-background-color: #f4f7fb; -fx-padding: 28;">
                    <!-- Dynamic content loaded here -->
                </StackPane>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
