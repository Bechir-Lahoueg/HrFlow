<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<ScrollPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.ui.controller.Employee.EmployeeRemunerationController"
            fitToWidth="true"
            style="-fx-background-color: #f0f2f5; -fx-background: #f0f2f5;">

    <VBox spacing="20" style="-fx-padding: 25; -fx-background-color: #f0f2f5;">
        
        <!-- ===== EN-TÊTE ===== -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: linear-gradient(to right, #667eea 0%, #764ba2 100%); -fx-padding: 18 24; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.18), 12, 0, 0, 3);">
            <Label text="💰" style="-fx-font-size: 28px;"/>
            <Label text="Ma Rémunération" style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font><Font name="System Bold" size="22.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="refreshButton" text="🔄 Actualiser"
                    style="-fx-background-color: rgba(255,255,255,0.25); -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 9 22; -fx-background-radius: 7; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.7); -fx-border-width: 1.5; -fx-border-radius: 7;">
                <font><Font name="System Bold" size="12.0"/></font>
            </Button>
        </HBox>

        <!-- ===== STATISTIQUES ===== -->
        <GridPane hgap="16.0" vgap="16.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
                <ColumnConstraints percentWidth="33.33"/>
            </columnConstraints>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="0"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(52,152,219,0.2), 10, 0, 0, 3); -fx-border-color: #3498db; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="💵" style="-fx-font-size: 28px;"/>
                <Label text="Mes Fiches" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblTotalFiches" text="0" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #3498db;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="1"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(46,204,113,0.2), 10, 0, 0, 3); -fx-border-color: #2ecc71; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="🎁" style="-fx-font-size: 28px;"/>
                <Label text="Mes Primes" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblTotalPrimes" text="0 DT" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #2ecc71;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="8.0" GridPane.columnIndex="2"
                  style="-fx-background-color: white; -fx-padding: 20 12; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.2), 10, 0, 0, 3); -fx-border-color: #e74c3c; -fx-border-width: 2; -fx-border-radius: 10;">
                <Label text="📉" style="-fx-font-size: 28px;"/>
                <Label text="Mes Déductions" style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: #64748b;"/>
                <Label fx:id="lblTotalDeductions" text="0 DT" style="-fx-font-weight: bold; -fx-font-size: 28px; -fx-text-fill: #e74c3c;"/>
            </VBox>
        </GridPane>

        <!-- ===== WIDGET CONVERSION ===== -->
        <VBox spacing="12" style="-fx-background-color: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -fx-padding: 16; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="💱" style="-fx-font-size: 16px;"/>
                <Label text="Convertisseur TND" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnRefreshRatesEmployee" text="🔄" onAction="#handleRefreshRatesEmployee"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 5 8; -fx-background-radius: 5; -fx-cursor: hand;"/>
            </HBox>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Montant (TND)" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.8);"/>
                    <TextField fx:id="txtMontantConversionEmployee" promptText="Ex: 1000" prefWidth="130"
                              style="-fx-font-size: 12px; -fx-padding: 6; -fx-background-radius: 5; -fx-background-color: rgba(255,255,255,0.9);"/>
                </VBox>

                <Label text="→" style="-fx-font-size: 18px; -fx-text-fill: white; -fx-padding: 6 0 0 0;"/>

                <VBox spacing="4" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 10; -fx-background-radius: 7; -fx-min-width: 100;">
                    <Label text="🇪🇺 EUR" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                    <Label fx:id="lblConversionEUREmployee" text="—" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>

                <VBox spacing="4" alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 10; -fx-background-radius: 7; -fx-min-width: 100;">
                    <Label text="🇺🇸 USD" style="-fx-font-size: 10px; -fx-text-fill: rgba(255,255,255,0.9);"/>
                    <Label fx:id="lblConversionUSDEmployee" text="—" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                </VBox>
            </HBox>

            <Label fx:id="lblApiStatusEmployee" text="Taux: 1 TND = 0.290 EUR · 0.320 USD" 
                   style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.7);"/>
        </VBox>

        <!-- ===== TABS ===== -->
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS"
                 style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);">
            
            <!-- Tab 1: Mes Fiches -->
            <Tab text="📄 Mes Fiches">
                <VBox spacing="12" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊 Historique Fiches de Paie" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="cbFilterYear" promptText="Année" prefWidth="120"
                                 style="-fx-font-size: 12px; -fx-padding: 6; -fx-background-radius: 6;"/>
                    </HBox>

                    <TableView fx:id="tableFiches" VBox.vgrow="ALWAYS"
                              style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colFicheId" text="ID" prefWidth="0.08" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colFicheMois" text="Mois" prefWidth="0.15" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colFicheAnnee" text="Année" prefWidth="0.10" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colFicheSalaireBrut" text="Brut" prefWidth="0.15" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colFicheTotalPrimes" text="Primes" prefWidth="0.15" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colFicheTotalDeductions" text="Déductions" prefWidth="0.17" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colFicheSalaireNet" text="Net" prefWidth="0.20" style="-fx-alignment: CENTER_RIGHT;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                                <Label text="📭" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                <Label text="Aucune fiche disponible" style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
                            </VBox>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="btnViewFiche" text="👁️ Voir" onAction="#handleViewFiche"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                        <Button fx:id="btnDownloadFiche" text="📥 PDF" onAction="#handleDownloadFiche"
                                style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- Tab 2: Mes Primes -->
            <Tab text="🎁 Mes Primes">
                <VBox spacing="12" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="🎯 Historique Primes" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblPrimeCount" text="0 prime(s)" 
                               style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold; -fx-background-color: #edf2f7; -fx-padding: 5 10; -fx-background-radius: 5;"/>
                    </HBox>

                    <TableView fx:id="tablePrimes" VBox.vgrow="ALWAYS"
                              style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colPrimeId" text="ID" prefWidth="0.10" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colPrimeType" text="Type" prefWidth="0.45"/>
                            <TableColumn fx:id="colPrimeMontant" text="Montant" prefWidth="0.25" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colPrimeDate" text="Date" prefWidth="0.20" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                                <Label text="🎁" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                <Label text="Aucune prime reçue" style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
                            </VBox>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Tab 3: Mes Déductions -->
            <Tab text="📉 Mes Déductions">
                <VBox spacing="12" style="-fx-padding: 20;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📊 Historique Déductions" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblDeductionCount" text="0 déduction(s)" 
                               style="-fx-font-size: 11px; -fx-text-fill: #718096; -fx-font-weight: bold; -fx-background-color: #edf2f7; -fx-padding: 5 10; -fx-background-radius: 5;"/>
                    </HBox>

                    <TableView fx:id="tableDeductions" VBox.vgrow="ALWAYS"
                              style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8;">
                        <columns>
                            <TableColumn fx:id="colDeductionId" text="ID" prefWidth="0.10" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colDeductionType" text="Type" prefWidth="0.45"/>
                            <TableColumn fx:id="colDeductionMontant" text="Montant" prefWidth="0.25" style="-fx-alignment: CENTER_RIGHT;"/>
                            <TableColumn fx:id="colDeductionDate" text="Date" prefWidth="0.20" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <placeholder>
                            <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                                <Label text="📉" style="-fx-font-size: 40px; -fx-opacity: 0.3;"/>
                                <Label text="Aucune déduction" style="-fx-text-fill: #a0aec0; -fx-font-size: 14px;"/>
                            </VBox>
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>

    </VBox>
</ScrollPane>
