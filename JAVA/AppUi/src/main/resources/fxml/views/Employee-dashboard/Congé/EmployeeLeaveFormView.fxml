<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.controller.Employee.Congé.EmployeeLeaveFormController"
      spacing="14" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="📝" style="-fx-font-size: 18px;"/>
        <Label text="Nouvelle Demande de Congé"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="5" alignment="CENTER"
              style="-fx-background-color: #ebf8ff; -fx-padding: 4 10; -fx-background-radius: 12;
                     -fx-border-color: #4299e1; -fx-border-width: 1; -fx-border-radius: 12;">
            <Label text="🧮" style="-fx-font-size: 11px;"/>
            <Label text="Calculateur Intelligent Activé"
                   style="-fx-font-size: 10px; -fx-text-fill: #2c5282; -fx-font-weight: bold;"/>
        </HBox>
    </HBox>
    <Separator style="-fx-background-color: #e2e8f0;"/>

    <!-- Dates côte à côte -->
    <HBox spacing="12" alignment="CENTER">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="📅" style="-fx-font-size: 13px;"/>
                <Label text="Date de début" style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 12px;"/>
                <Label text=" *" style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;"/>
            </HBox>
            <DatePicker fx:id="startDatePicker" maxWidth="10000"
                       style="-fx-font-size: 13px; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
        </VBox>
        <VBox alignment="BOTTOM_CENTER" style="-fx-padding: 0 0 6 0;">
            <Label text="→" style="-fx-font-size: 22px; -fx-text-fill: #667eea; -fx-font-weight: bold;"/>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="📅" style="-fx-font-size: 13px;"/>
                <Label text="Date de fin" style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 12px;"/>
                <Label text=" *" style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;"/>
            </HBox>
            <DatePicker fx:id="endDatePicker" maxWidth="10000"
                       style="-fx-font-size: 13px; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
        </VBox>
    </HBox>

    <!-- Type de congé -->
    <VBox spacing="6">
        <HBox spacing="4" alignment="CENTER_LEFT">
            <Label text="🏷️" style="-fx-font-size: 13px;"/>
            <Label text="Type de congé" style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 12px;"/>
            <Label text=" *" style="-fx-text-fill: #e53e3e; -fx-font-size: 12px;"/>
        </HBox>
        <ComboBox fx:id="leaveTypeComboBox" maxWidth="10000"
                 style="-fx-font-size: 12px; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5;"/>
    </VBox>

    <!-- ══ PANNEAU ANALYSE INTELLIGENTE ══ -->
    <VBox spacing="0"
          style="-fx-background-color: #f7f8ff; -fx-background-radius: 10;
                 -fx-border-color: #c3d0f7; -fx-border-width: 1.5; -fx-border-radius: 10;">
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-padding: 10 14; -fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                     -fx-background-radius: 8 8 0 0;">
            <Label text="🧮" style="-fx-font-size: 14px;"/>
            <Label text="Analyse Intelligente de la Période"
                   style="-fx-font-weight: bold; -fx-font-size: 12px; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="4" alignment="CENTER"
                  style="-fx-background-color: rgba(255,255,255,0.2); -fx-padding: 3 8; -fx-background-radius: 10;">
                <Label text="🇹🇳" style="-fx-font-size: 10px;"/>
                <Label text="Nager.Date API" style="-fx-font-size: 9px; -fx-text-fill: rgba(255,255,255,0.9);"/>
            </HBox>
        </HBox>
        <HBox>
            <VBox spacing="4" alignment="CENTER" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 8; -fx-border-color: transparent #e2e8f0 transparent transparent; -fx-border-width: 0 1 0 0;">
                <Label text="📋" style="-fx-font-size: 20px;"/>
                <Label fx:id="daysCountLabel" text="--"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #667eea;"/>
                <Label text="jours ouvrables" style="-fx-font-size: 10px; -fx-text-fill: #718096;"/>
                <Label text="décomptés du solde" style="-fx-font-size: 9px; -fx-text-fill: #a0aec0;"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 8; -fx-border-color: transparent #e2e8f0 transparent transparent; -fx-border-width: 0 1 0 0;">
                <Label text="🗓️" style="-fx-font-size: 20px;"/>
                <Label fx:id="calendarDaysLabel" text="--"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4a5568;"/>
                <Label text="jours calendaires" style="-fx-font-size: 10px; -fx-text-fill: #718096;"/>
                <Label text="durée réelle" style="-fx-font-size: 9px; -fx-text-fill: #a0aec0;"/>
            </VBox>
            <VBox spacing="4" alignment="CENTER" HBox.hgrow="ALWAYS"
                  style="-fx-padding: 14 8;">
                <Label text="🚫" style="-fx-font-size: 20px;"/>
                <Label fx:id="weekendDaysLabel" text="--"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #718096;"/>
                <Label text="WE + fériés exclus" style="-fx-font-size: 10px; -fx-text-fill: #718096;"/>
                <Label text="non comptabilisés" style="-fx-font-size: 9px; -fx-text-fill: #a0aec0;"/>
            </VBox>
        </HBox>
        <HBox alignment="CENTER" spacing="6"
              style="-fx-background-color: #edf2f7; -fx-padding: 7 14; -fx-background-radius: 0 0 8 8;">
            <Label text="💡" style="-fx-font-size: 11px;"/>
            <Label text="Weekends et jours fériés tunisiens exclus automatiquement via l'API temps réel"
                   style="-fx-font-size: 10px; -fx-text-fill: #718096;" wrapText="true"/>
        </HBox>
    </VBox>

    <!-- ══ ALERTE JOURS FÉRIÉS ══ -->
    <VBox fx:id="holidayWarningBox" spacing="0" managed="false" visible="false"
          style="-fx-background-radius: 10; -fx-border-color: #fc8181; -fx-border-width: 2; -fx-border-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(245,101,101,0.3), 10, 0, 0, 3);">
        <HBox spacing="8" alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to right, #fc8181, #f56565);
                     -fx-padding: 10 14; -fx-background-radius: 8 8 0 0;">
            <Label text="🚨" style="-fx-font-size: 16px;"/>
            <Label text="Jours fériés détectés — Demande bloquée"
                   style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="🇹🇳 Tunisie" style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.85);"/>
        </HBox>
        <VBox spacing="4" style="-fx-background-color: #fff5f5; -fx-padding: 12 14;">
            <Label fx:id="holidayListLabel" text=""
                   style="-fx-text-fill: #742a2a; -fx-font-size: 12px;" wrapText="true"/>
        </VBox>
        <HBox spacing="6" alignment="CENTER_LEFT"
              style="-fx-background-color: #fed7d7; -fx-padding: 8 14; -fx-background-radius: 0 0 8 8;">
            <Label text="⛔" style="-fx-font-size: 12px;"/>
            <Label text="Les demandes incluant un jour férié sont automatiquement rejetées. Veuillez choisir d'autres dates."
                   style="-fx-text-fill: #c53030; -fx-font-size: 11px; -fx-font-style: italic;" wrapText="true"/>
        </HBox>
    </VBox>

    <!-- ══ ALERTE AUCUN JOUR OUVRABLE ══ -->
    <VBox fx:id="noWorkingDaysBox" spacing="0" managed="false" visible="false"
          style="-fx-background-radius: 10; -fx-border-color: #f6ad55; -fx-border-width: 2; -fx-border-radius: 10;
                 -fx-effect: dropshadow(gaussian, rgba(246,173,85,0.3), 10, 0, 0, 3);">
        <HBox spacing="8" alignment="CENTER_LEFT"
              style="-fx-background-color: linear-gradient(to right, #f6ad55, #ed8936);
                     -fx-padding: 10 14; -fx-background-radius: 8 8 0 0;">
            <Label text="⚠️" style="-fx-font-size: 16px;"/>
            <Label text="Période sans jour ouvrable"
                   style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: white;"/>
        </HBox>
        <HBox spacing="6" alignment="CENTER_LEFT"
              style="-fx-background-color: #fffaf0; -fx-padding: 10 14; -fx-background-radius: 0 0 8 8;">
            <Label text="🗓️" style="-fx-font-size: 13px;"/>
            <Label text="La période ne contient que des week-ends ou des jours fériés. Veuillez choisir une autre période."
                   style="-fx-text-fill: #7b341e; -fx-font-size: 11px;" wrapText="true"/>
        </HBox>
    </VBox>

    <!-- Motif -->
    <VBox spacing="6">
        <HBox spacing="4" alignment="CENTER_LEFT">
            <Label text="💬" style="-fx-font-size: 13px;"/>
            <Label text="Motif / Raison" style="-fx-font-weight: bold; -fx-text-fill: #4a5568; -fx-font-size: 12px;"/>
            <Label text=" (optionnel)" style="-fx-text-fill: #a0aec0; -fx-font-size: 10px;"/>
        </HBox>
        <TextArea fx:id="reasonTextArea" prefRowCount="2" wrapText="true"
                 promptText="Décrivez le motif de votre demande de congé..."
                 style="-fx-background-radius: 8; -fx-border-color: #cbd5e0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-padding: 8; -fx-font-size: 12px;"/>
    </VBox>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="clearButton" text="🔄 Réinitialiser"
                style="-fx-background-color: #718096; -fx-text-fill: white; -fx-font-size: 12px;
                       -fx-font-weight: bold; -fx-padding: 9 20; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 4, 0, 0, 1);"/>
        <Button fx:id="submitButton" text="✅ Soumettre la Demande"
                style="-fx-background-color: linear-gradient(to bottom, #48bb78, #38a169);
                       -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;
                       -fx-padding: 9 24; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(56,161,105,0.4), 8, 0, 0, 3);"/>
    </HBox>

    <!-- Note info -->
    <HBox spacing="6" alignment="CENTER_LEFT"
          style="-fx-background-color: #ebf8ff; -fx-padding: 8 12; -fx-background-radius: 8;
                 -fx-border-color: #4299e1; -fx-border-width: 1; -fx-border-radius: 8;">
        <Label text="ℹ️" style="-fx-font-size: 13px;"/>
        <Label text="Les champs * sont obligatoires. Le calcul exclut weekends et jours fériés tunisiens via l'API temps réel."
               style="-fx-text-fill: #2c5282; -fx-font-size: 11px;" wrapText="true"/>
    </HBox>
</VBox>
