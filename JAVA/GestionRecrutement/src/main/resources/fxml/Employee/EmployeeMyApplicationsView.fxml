<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- ═════════════════════════════════════════════════════════════════════
     EmployeeMyApplicationsView.fxml  —  My Application Tracking
     Employees view their submitted applications and progress
     Controller: controllers.EmployeeMyApplicationsController
     ═════════════════════════════════════════════════════════════════════ -->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.Employee.EmployeeMyApplicationsController"
      styleClass="view-container"
      spacing="0">

    <!-- STATS ROW -->
    <HBox styleClass="stats-row" spacing="16">
        <VBox.margin>
            <Insets top="28" right="28" bottom="0" left="28"/>
        </VBox.margin>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-blue">
                <Label text="📄" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="Total Applications" styleClass="stat-card-label"/>
                <Label fx:id="statTotal" text="8" styleClass="stat-card-value"/>
                <Label text="→ All time" styleClass="stat-card-trend, trend-neutral"/>
            </VBox>
        </HBox>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-orange">
                <Label text="⏳" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="In Progress" styleClass="stat-card-label"/>
                <Label fx:id="statInProgress" text="3" styleClass="stat-card-value"/>
                <Label text="→ Active" styleClass="stat-card-trend, trend-neutral"/>
            </VBox>
        </HBox>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-purple">
                <Label text="📅" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="Interviews Scheduled" styleClass="stat-card-label"/>
                <Label fx:id="statInterviews" text="1" styleClass="stat-card-value"/>
                <Label text="→ Upcoming" styleClass="stat-card-trend, trend-neutral"/>
            </VBox>
        </HBox>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-green">
                <Label text="✅" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="Response Rate" styleClass="stat-card-label"/>
                <Label fx:id="statResponseRate" text="75%" styleClass="stat-card-value"/>
                <Label text="→ Last 6 months" styleClass="stat-card-trend, trend-neutral"/>
            </VBox>
        </HBox>

    </HBox>

    <!-- MAIN CONTENT CARD -->
    <VBox styleClass="content-card" VBox.vgrow="ALWAYS" spacing="0">
        <VBox.margin>
            <Insets top="20" right="28" bottom="28" left="28"/>
        </VBox.margin>

        <!-- Header Action Bar -->
        <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="My Applications" styleClass="card-title"/>
                <Label text="Track the status of your submitted applications"
                       styleClass="card-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Filter by Status -->
            <ComboBox fx:id="filterStatus"
                      promptText="All Statuses"
                      styleClass="filter-combo"
                      prefWidth="140"
                      onAction="#handleStatusFilter">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="All Statuses"/>
                        <String fx:value="APPLIED"/>
                        <String fx:value="SCREENING"/>
                        <String fx:value="SHORTLISTED"/>
                        <String fx:value="INTERVIEW"/>
                        <String fx:value="OFFERED"/>
                        <String fx:value="REJECTED"/>
                        <String fx:value="HIRED"/>
                    </FXCollections>
                </items>
            </ComboBox>

        </HBox>

        <Separator styleClass="card-divider"/>

        <!-- Pagination Info -->
        <Label fx:id="paginationInfo" text="Loading applications..."
                styleClass="pagination-info">
            <VBox.margin>
                <Insets right="28" bottom="8" left="28"/>
            </VBox.margin>
        </Label>

        <!-- Applications Table -->
        <TableView fx:id="applicationsTableView" styleClass="applications-table" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colJobTitle" text="Position" prefWidth="220" sortable="true"/>
                <TableColumn fx:id="colDepartment" text="Department" prefWidth="140" sortable="true"/>
                <TableColumn fx:id="colDateApplied" text="Applied Date" prefWidth="120" sortable="true"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="120" sortable="true"/>
                <TableColumn fx:id="colActions" text="Actions" prefWidth="120" sortable="false"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <padding>
                <Insets top="0" right="28" bottom="28" left="28"/>
            </padding>
        </TableView>

    </VBox>

</VBox>
