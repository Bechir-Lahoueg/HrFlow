<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- ═════════════════════════════════════════════════════════════════════
     EmployeeBrowseJobsView.fxml  —  Browse Internal Job Postings
     Employees browse and apply for internal positions
     Controller: controllers.EmployeeBrowseJobsController
     ═════════════════════════════════════════════════════════════════════ -->
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.Employee.EmployeeBrowseJobsController"
      styleClass="view-container"
      spacing="0">

    <!-- HEADER BAR -->
    <HBox styleClass="browse-jobs-header" alignment="CENTER_LEFT" spacing="16">
        <VBox.margin>
            <Insets top="28" right="28" bottom="20" left="28"/>
        </VBox.margin>

        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Internal Opportunities" styleClass="card-title"/>
            <Label text="Explore open positions across the company"
                   styleClass="card-subtitle"/>
        </VBox>

        <!-- Department Filter -->
        <ComboBox fx:id="filterDepartment"
                  promptText="All Departments"
                  styleClass="filter-combo"
                  prefWidth="160"
                  onAction="#handleDepartmentFilter">
            <items>
                <FXCollections fx:factory="observableArrayList">
                </FXCollections>
            </items>
        </ComboBox>

        <!-- Location Filter -->
        <ComboBox fx:id="filterLocation"
                  promptText="All Locations"
                  styleClass="filter-combo"
                  prefWidth="140"
                  onAction="#handleLocationFilter">
            <items>
                <FXCollections fx:factory="observableArrayList">
                </FXCollections>
            </items>
        </ComboBox>

        <!-- Type Filter -->
        <ComboBox fx:id="filterType"
                  promptText="All Types"
                  styleClass="filter-combo"
                  prefWidth="130"
                  onAction="#handleTypeFilter">
            <items>
                <FXCollections fx:factory="observableArrayList">
                </FXCollections>
            </items>
        </ComboBox>

    </HBox>

    <!-- SEARCH BAR -->
    <HBox styleClass="search-bar" spacing="12">
        <VBox.margin>
            <Insets top="12" right="28" bottom="12" left="28"/>
        </VBox.margin>
        <TextField fx:id="searchField"
                   promptText="Search by job title, department, or location..."
                   styleClass="search-field"
                   HBox.hgrow="ALWAYS"
                   onAction="#handleSearch"/>
        <Button text="🔍 Search" styleClass="btn-primary" onAction="#handleSearch"/>
    </HBox>

    <!-- PAGINATION INFO -->
    <Label fx:id="paginationInfo" text="Loading jobs..."
            styleClass="pagination-info">
        <VBox.margin>
            <Insets right="28" bottom="8" left="28"/>
        </VBox.margin>
    </Label>

    <!-- JOBS TABLE -->
    <TableView fx:id="jobsTableView" styleClass="jobs-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTitle" text="Position" prefWidth="200" sortable="true"/>
            <TableColumn fx:id="colDepartment" text="Department" prefWidth="120" sortable="true"/>
            <TableColumn fx:id="colLocation" text="Location" prefWidth="100" sortable="true"/>
            <TableColumn fx:id="colType" text="Type" prefWidth="100" sortable="true"/>
            <TableColumn fx:id="colSalary" text="Salary Range" prefWidth="140" sortable="false"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="80" sortable="true"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="100" sortable="false"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <padding>
            <Insets top="0" right="28" bottom="28" left="28"/>
        </padding>
    </TableView>

</VBox>
