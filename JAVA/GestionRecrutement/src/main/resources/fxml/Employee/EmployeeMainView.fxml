<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!-- ═══════════════════════════════════════════════════════════════════════
     EmployeeMainView.fxml  —  Employee Role Dashboard Shell
     Employees: view profile, browse jobs, apply, track applications
     Controller: controllers.EmployeeMainController
     ═══════════════════════════════════════════════════════════════════════ -->
<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.Employee.EmployeeMainController"
           stylesheets="@/css/Employee/dashboard.css">

    <!-- ═══════════════════════════════════════════════════════════════
         LAYER 1  —  Main Dashboard
         ═══════════════════════════════════════════════════════════════ -->
    <BorderPane styleClass="root-pane">

        <!-- ───────────────────────────────────────────────────────────
             LEFT  —  Employee Sidebar Navigation
             ─────────────────────────────────────────────────────────── -->
        <left>
            <VBox styleClass="sidebar" prefWidth="240" spacing="0">

                <!-- Brand -->
                <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="12">
                    <StackPane styleClass="brand-icon-wrapper" prefWidth="38" prefHeight="38">
                        <Label text="HR" styleClass="brand-icon-text"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="TalentFlow" styleClass="brand-title"/>
                        <Label text="Employee Portal" styleClass="brand-subtitle"/>
                    </VBox>
                </HBox>

                <Separator styleClass="sidebar-divider"/>

                <!-- Back Button -->
                <VBox styleClass="nav-items-container">
                    <VBox.margin>
                        <Insets top="14" right="0" bottom="4" left="0"/>
                    </VBox.margin>
                    <Button fx:id="btnBack"
                            styleClass="nav-button, nav-button-back"
                            maxWidth="Infinity"
                            onAction="#handleBack"
                            disable="true">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="←" styleClass="nav-icon back-arrow-icon"/>
                                <Label text="Back" styleClass="nav-label"/>
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>

                <Separator styleClass="sidebar-divider-light"/>

                <!-- Section Label -->
                <Label text="MAIN" styleClass="nav-section-label">
                    <VBox.margin>
                        <Insets top="16" right="16" bottom="8" left="20"/>
                    </VBox.margin>
                </Label>

                <!-- Primary Nav Buttons -->
                <VBox styleClass="nav-items-container" spacing="4">
                    <VBox.margin>
                        <Insets top="0" right="12" bottom="0" left="12"/>
                    </VBox.margin>

                    <Button fx:id="btnDashboard"
                            styleClass="nav-button, nav-button-active"
                            maxWidth="Infinity"
                            onAction="#handleDashboard">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🏠" styleClass="nav-icon"/>
                                <Label text="Dashboard" styleClass="nav-label"/>
                            </HBox>
                        </graphic>
                    </Button>

                    

                    <Button fx:id="btnBrowseJobs"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleBrowseJobs">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                                <Label text="🔍" styleClass="nav-icon"/>
                                <Label text="Browse Jobs" styleClass="nav-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="12" styleClass="nav-badge nav-badge-blue"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button fx:id="btnMyApplications"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleMyApplications">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="Infinity">
                                <Label text="📄" styleClass="nav-icon"/>
                                <Label text="My Applications" styleClass="nav-label"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="3" styleClass="nav-badge nav-badge-green"/>
                            </HBox>
                        </graphic>
                    </Button>

                     <Button fx:id="btnAIMode"
                            styleClass="nav-button"
                            maxWidth="Infinity"
                            onAction="#handleAiMode">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🤖" styleClass="nav-icon"/>
                                <Label text="AI Mode" styleClass="nav-label"/>
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>

                <!-- Section Label: Career -->
                <Label text="CAREER" styleClass="nav-section-label">
                    <VBox.margin>
                        <Insets top="20" right="16" bottom="8" left="20"/>
                    </VBox.margin>
                </Label>


                <Region VBox.vgrow="ALWAYS"/>

                <Separator styleClass="sidebar-divider"/>

                <!-- Bottom Nav -->
                <VBox spacing="4" styleClass="nav-items-container">
                    <VBox.margin>
                        <Insets top="8" right="12" bottom="16" left="12"/>
                    </VBox.margin>
                    <Button styleClass="nav-button" maxWidth="Infinity">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="⚙" styleClass="nav-icon"/>
                                <Label text="Settings" styleClass="nav-label"/>
                            </HBox>
                        </graphic>
                    </Button>
                    <Button styleClass="nav-button, nav-button-danger" maxWidth="Infinity">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="🚪" styleClass="nav-icon"/>
                                <Label text="Log Out" styleClass="nav-label"/>
                            </HBox>
                        </graphic>
                    </Button>
                </VBox>

            </VBox>
        </left>

        <!-- ───────────────────────────────────────────────────────────
             TOP  —  Header
             ─────────────────────────────────────────────────────────── -->
        <top>
            <HBox styleClass="top-header" alignment="CENTER_LEFT" spacing="16">

                <VBox spacing="2">
                    <Label fx:id="headerTitle" text="Dashboard"
                           styleClass="header-page-title"/>
                    <Label fx:id="headerBreadcrumb" text="Home  /  Dashboard"
                           styleClass="header-breadcrumb"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox styleClass="search-wrapper" alignment="CENTER_LEFT" spacing="8">
                    <Label text="🔍" styleClass="search-icon"/>
                    <TextField fx:id="searchField"
                               promptText="Search jobs, skills..."
                               styleClass="search-field"
                               prefWidth="260"/>
                </HBox>

                <StackPane styleClass="icon-button-wrapper">
                    <Button styleClass="header-icon-button" text="🔔"/>
                    <Label text="1" styleClass="notification-badge"
                           StackPane.alignment="TOP_RIGHT"/>
                </StackPane>

                <Separator orientation="VERTICAL" styleClass="header-divider" prefHeight="32"/>

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="profile-widget">
                    <StackPane styleClass="avatar-wrapper">
                        <Circle radius="18" styleClass="avatar-circle"/>
                        <Label text="JD" styleClass="avatar-initials"/>
                    </StackPane>
                    <VBox spacing="1">
                        <Label text="John Doe" styleClass="profile-name"/>
                        <Label text="Software Engineer" styleClass="profile-role"/>
                    </VBox>
                    <Label text="▾" styleClass="profile-chevron"/>
                </HBox>

            </HBox>
        </top>

        <!-- ───────────────────────────────────────────────────────────
             CENTER  —  Dynamic Content Area
             ─────────────────────────────────────────────────────────── -->
        <center>
            <StackPane fx:id="contentArea" styleClass="content-area">
                <Label text="⏳  Loading view…" styleClass="placeholder-label"
                       StackPane.alignment="CENTER"/>
            </StackPane>
        </center>

    </BorderPane>

    <!-- ═══════════════════════════════════════════════════════════════
         LAYER 2  —  Global Modal Overlay
         ═══════════════════════════════════════════════════════════════ -->
    <StackPane fx:id="globalModalOverlay"
               styleClass="modal-overlay"
               visible="false"
               managed="false">

        <Pane styleClass="modal-backdrop"
              onMouseClicked="#handleCloseModal"/>

        <VBox fx:id="modalCard"
              styleClass="modal-card"
              spacing="0"
              maxWidth="580"
              StackPane.alignment="CENTER">

            <HBox styleClass="modal-header" alignment="CENTER_LEFT">
                <VBox spacing="3">
                    <Label fx:id="modalTitle" text="Apply for Position"
                           styleClass="modal-title"/>
                    <Label fx:id="modalSubtitle"
                           text="Complete your application."
                           styleClass="modal-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" styleClass="modal-close-btn"
                        onAction="#handleCloseModal"/>
            </HBox>

            <Separator styleClass="modal-divider"/>

            <StackPane fx:id="modalBody"
                       styleClass="modal-body-container"
                       VBox.vgrow="ALWAYS"/>

            <Separator styleClass="modal-divider"/>

            <HBox styleClass="modal-footer" alignment="CENTER_RIGHT" spacing="12">
                <Label fx:id="formErrorLabel" text=""
                       styleClass="form-error-label"
                       maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>

        </VBox>
    </StackPane>

</StackPane>
