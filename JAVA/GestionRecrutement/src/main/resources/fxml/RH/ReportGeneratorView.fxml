<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="controllers.RH.AiReportController"
    spacing="16" 
    style="-fx-padding: 20; -fx-background-color: #f1f5f9;"
    prefHeight="-1"
    minHeight="600">

    <!-- ===== REPORT INPUT SECTION ===== -->
    <VBox spacing="12" style="-fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8; -fx-padding: 16; -fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 4, 0, 0, 2);">
        <Label text="📊 Generate Comprehensive Report" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        
        <Label text="Describe the report you need (e.g., 'Show recruitment pipeline overview with application trends')" style="-fx-font-size: 11; -fx-text-fill: #64748b;"/>
        
        <TextArea fx:id="reportPromptInput" 
            wrapText="true" 
            prefHeight="100"
            style="-fx-control-inner-background: #f8fafc; -fx-font-size: 11; -fx-font-family: 'Segoe UI', 'Courier New'; -fx-border-color: #e2e8f0; -fx-border-radius: 6; -fx-padding: 10;"/>
        
        <HBox spacing="12">
            <Button fx:id="generateReportBtn" 
                text="🚀 Generate Report" 
                onAction="#handleGenerateReport"
                style="-fx-font-size: 12; -fx-font-weight: bold; -fx-padding: 10 18; -fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: transparent;"/>
            <Button fx:id="resetBtn"
                text="⟳ Reset"
                style="-fx-font-size: 12; -fx-padding: 10 18; -fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-border-color: transparent;"/>
            
            <Label fx:id="reportStatusLabel" 
                text="" 
                style="-fx-text-fill: #64748b; -fx-font-size: 11;"/>
            
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <!-- ===== REPORT DISPLAY SECTION ===== -->
    <Label text="Report Preview" style="-fx-font-size: 12; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
    
    <ScrollPane fx:id="reportScrollPane" 
        fitToWidth="true"
        minHeight="300"
        prefHeight="1000"
        style="-fx-fit-to-height: false; -fx-padding: 0; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-color: #ffffff;"
        VBox.vgrow="ALWAYS">
        <VBox fx:id="reportContainer" 
            spacing="20" 
            style="-fx-padding: 24; -fx-background-color: #ffffff;">
            
            <!-- Dynamic content populated by controller -->
        </VBox>
    </ScrollPane>

    <!-- ===== EMPTY STATE ===== -->
    <VBox fx:id="reportEmptyState" 
        alignment="CENTER" 
        spacing="12" 
        style="-fx-padding: 40; -fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 8; -fx-border-style: dashed;"
        minHeight="200"
        VBox.vgrow="ALWAYS">
        <Label text="📊 No Report Generated Yet" 
            style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #334155;"/>
        <Label text="Enter a detailed prompt above and click 'Generate Report' to create a comprehensive, narrative-rich report." 
            wrapText="true"
            style="-fx-font-size: 12; -fx-text-fill: #64748b; -fx-max-width: 400; -fx-text-alignment: CENTER;"/>
    </VBox>
</VBox>
