<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<!-- ═════════════════════════════════════════════════════════════════════
     HRDashboardView.fxml  —  HR Overview Dashboard
     Quick stats, upcoming interviews, recent candidates, pipeline summary
     Controller: controllers.HRDashboardController
     ═════════════════════════════════════════════════════════════════════ -->
<ScrollPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.RH.HRDashboardController"
            styleClass="view-container"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">

    <VBox spacing="0">
        <padding>
            <Insets top="28" right="28" bottom="28" left="28"/>
        </padding>

        <!-- ─────────────────────────────────────────────────────────────────
             STATS ROW
             ───────────────────────────────────────────────────────────────── -->
        <HBox styleClass="stats-row" spacing="16">
            <VBox.margin>
                <Insets top="0" right="0" bottom="24" left="0"/>
            </VBox.margin>

            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-bg, stat-icon-bg-blue">
                    <Label text="👥" styleClass="stat-icon"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Active Candidates" styleClass="stat-card-label"/>
                    <Label fx:id="statActiveCandidates" text="87" styleClass="stat-card-value"/>
                    <Label text="↑ 12 this week" styleClass="stat-card-trend, trend-up"/>
                </VBox>
            </HBox>

            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-bg, stat-icon-bg-orange">
                    <Label text="📅" styleClass="stat-icon"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Interviews Today" styleClass="stat-card-label"/>
                    <Label fx:id="statInterviewsToday" text="3" styleClass="stat-card-value"/>
                    <Label text="→ Next at 2:00 PM" styleClass="stat-card-trend, trend-neutral"/>
                </VBox>
            </HBox>

            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-bg, stat-icon-bg-purple">
                    <Label text="⭐" styleClass="stat-icon"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Shortlisted" styleClass="stat-card-label"/>
                    <Label fx:id="statShortlisted" text="43" styleClass="stat-card-value"/>
                    <Label text="↑ 5 this week" styleClass="stat-card-trend, trend-up"/>
                </VBox>
            </HBox>

            <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-bg, stat-icon-bg-green">
                    <Label text="🤝" styleClass="stat-icon"/>
                </StackPane>
                <VBox spacing="3">
                    <Label text="Pending Offers" styleClass="stat-card-label"/>
                    <Label fx:id="statPendingOffers" text="5" styleClass="stat-card-value"/>
                    <Label text="↑ 2 this week" styleClass="stat-card-trend, trend-up"/>
                </VBox>
            </HBox>
        </HBox>

        <!-- ─────────────────────────────────────────────────────────────────
             TWO-COLUMN LAYOUT: Upcoming Interviews + Recent Candidates
             ───────────────────────────────────────────────────────────────── -->
        <HBox spacing="20" alignment="TOP_LEFT">
            <VBox.margin>
                <Insets top="0" right="0" bottom="0" left="0"/>
            </VBox.margin>

            <!-- LEFT COLUMN: Upcoming Interviews -->
            <VBox styleClass="content-card" spacing="0" HBox.hgrow="ALWAYS">
                <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Upcoming Interviews" styleClass="card-title"/>
                        <Label text="Next 7 days" styleClass="card-subtitle"/>
                    </VBox>
                    <Button text="View All →" styleClass="btn-link"
                            onAction="#handleViewAllInterviews"/>
                </HBox>

                <Separator styleClass="card-divider"/>

                <!-- Interview list -->
                <VBox fx:id="upcomingInterviewsList" styleClass="timeline-list" spacing="0">
                    <!-- Populated by controller with timeline items -->
                    <!-- Sample static items for layout preview: -->
                    
                    <HBox styleClass="timeline-item" spacing="12">
                        <VBox spacing="2" styleClass="timeline-time">
                            <Label text="Today" styleClass="timeline-day"/>
                            <Label text="2:00 PM" styleClass="timeline-hour"/>
                        </VBox>
                        <Separator orientation="VERTICAL" styleClass="timeline-divider"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Alice Johnson  •  Technical Interview"
                                   styleClass="timeline-title"/>
                            <Label text="Senior Backend Engineer"
                                   styleClass="timeline-subtitle"/>
                            <HBox spacing="6">
                                <Label text="📹 Video Call" styleClass="timeline-meta"/>
                                <Label text="•" styleClass="timeline-dot"/>
                                <Label text="Mark Taylor" styleClass="timeline-meta"/>
                            </HBox>
                        </VBox>
                        <Button text="Join" styleClass="btn-timeline"
                                onAction="#handleJoinInterview"/>
                    </HBox>

                    <HBox styleClass="timeline-item" spacing="12">
                        <VBox spacing="2" styleClass="timeline-time">
                            <Label text="Today" styleClass="timeline-day"/>
                            <Label text="4:30 PM" styleClass="timeline-hour"/>
                        </VBox>
                        <Separator orientation="VERTICAL" styleClass="timeline-divider"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Bob Martinez  •  HR Round"
                                   styleClass="timeline-title"/>
                            <Label text="Product Designer"
                                   styleClass="timeline-subtitle"/>
                            <HBox spacing="6">
                                <Label text="🏢 In Person" styleClass="timeline-meta"/>
                                <Label text="•" styleClass="timeline-dot"/>
                                <Label text="Conference Room B" styleClass="timeline-meta"/>
                            </HBox>
                        </VBox>
                        <Button text="Details" styleClass="btn-timeline"
                                onAction="#handleViewDetails"/>
                    </HBox>

                    <HBox styleClass="timeline-item" spacing="12">
                        <VBox spacing="2" styleClass="timeline-time">
                            <Label text="Tomorrow" styleClass="timeline-day"/>
                            <Label text="10:00 AM" styleClass="timeline-hour"/>
                        </VBox>
                        <Separator orientation="VERTICAL" styleClass="timeline-divider"/>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Carol White  •  Phone Screen"
                                   styleClass="timeline-title"/>
                            <Label text="Marketing Lead"
                                   styleClass="timeline-subtitle"/>
                            <HBox spacing="6">
                                <Label text="📞 Phone Call" styleClass="timeline-meta"/>
                                <Label text="•" styleClass="timeline-dot"/>
                                <Label text="Sarah Miller" styleClass="timeline-meta"/>
                            </HBox>
                        </VBox>
                        <Button text="Reschedule" styleClass="btn-timeline-secondary"
                                onAction="#handleReschedule"/>
                    </HBox>

                </VBox>

            </VBox>

            <!-- RIGHT COLUMN: Recent Candidates -->
            <VBox styleClass="content-card" spacing="0" HBox.hgrow="ALWAYS">
                <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Recent Candidates" styleClass="card-title"/>
                        <Label text="Last 7 days" styleClass="card-subtitle"/>
                    </VBox>
                    <Button text="View All →" styleClass="btn-link"
                            onAction="#handleViewAllCandidates"/>
                </HBox>

                <Separator styleClass="card-divider"/>

                <!-- Candidate list -->
                <VBox fx:id="recentCandidatesList" styleClass="candidate-list" spacing="0">

                    <HBox styleClass="candidate-item" spacing="12">
                        <StackPane styleClass="candidate-avatar">
                            <Label text="AJ" styleClass="candidate-avatar-text"/>
                        </StackPane>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Alice Johnson" styleClass="candidate-name"/>
                            <Label text="Senior Backend Engineer  •  Engineering"
                                   styleClass="candidate-position"/>
                            <HBox spacing="8">
                                <Label text="📧 alice@email.com" styleClass="candidate-contact"/>
                                <Label text="•" styleClass="timeline-dot"/>
                                <Label text="Applied 2 days ago" styleClass="candidate-date"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="6" alignment="CENTER_RIGHT">
                            <Label text="Shortlisted" styleClass="badge badge-shortlisted"/>
                            <Button text="View Profile" styleClass="btn-candidate"
                                    onAction="#handleViewProfile"/>
                        </VBox>
                    </HBox>

                    <HBox styleClass="candidate-item" spacing="12">
                        <StackPane styleClass="candidate-avatar">
                            <Label text="BM" styleClass="candidate-avatar-text"/>
                        </StackPane>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Bob Martinez" styleClass="candidate-name"/>
                            <Label text="Product Designer  •  Design"
                                   styleClass="candidate-position"/>
                            <HBox spacing="8">
                                <Label text="📧 bob@email.com" styleClass="candidate-contact"/>
                                <Label text="•" styleClass="timeline-dot"/>
                                <Label text="Applied 3 days ago" styleClass="candidate-date"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="6" alignment="CENTER_RIGHT">
                            <Label text="Interview" styleClass="badge badge-interview"/>
                            <Button text="View Profile" styleClass="btn-candidate"
                                    onAction="#handleViewProfile"/>
                        </VBox>
                    </HBox>

                    <HBox styleClass="candidate-item" spacing="12">
                        <StackPane styleClass="candidate-avatar">
                            <Label text="CW" styleClass="candidate-avatar-text"/>
                        </StackPane>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Carol White" styleClass="candidate-name"/>
                            <Label text="Marketing Lead  •  Marketing"
                                   styleClass="candidate-position"/>
                            <HBox spacing="8">
                                <Label text="📧 carol@email.com" styleClass="candidate-contact"/>
                                <Label text="•" styleClass="timeline-dot"/>
                                <Label text="Applied 4 days ago" styleClass="candidate-date"/>
                            </HBox>
                        </VBox>
                        <VBox spacing="6" alignment="CENTER_RIGHT">
                            <Label text="Under Review" styleClass="badge badge-new"/>
                            <Button text="View Profile" styleClass="btn-candidate"
                                    onAction="#handleViewProfile"/>
                        </VBox>
                    </HBox>

                </VBox>

            </VBox>

        </HBox>

        <!-- ─────────────────────────────────────────────────────────────────
             PIPELINE SUMMARY CARD (full width)
             ───────────────────────────────────────────────────────────────── -->
        <VBox styleClass="content-card" spacing="0">
            <VBox.margin>
                <Insets top="20" right="0" bottom="0" left="0"/>
            </VBox.margin>

            <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label text="Recruitment Pipeline" styleClass="card-title"/>
                    <Label text="Current month progress" styleClass="card-subtitle"/>
                </VBox>
                <Button text="View Details →" styleClass="btn-link"
                        onAction="#handleViewPipeline"/>
            </HBox>

            <Separator styleClass="card-divider"/>

            <HBox styleClass="pipeline-summary" spacing="0" alignment="CENTER">
                <VBox.margin>
                    <Insets top="24" right="24" bottom="24" left="24"/>
                </VBox.margin>

                <!-- Stage 1: Applied -->
                <VBox styleClass="pipeline-stage" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Applied" styleClass="pipeline-stage-label"/>
                    <Label fx:id="pipelineApplied" text="312"
                           styleClass="pipeline-stage-value"/>
                    <ProgressBar fx:id="progressApplied" progress="1.0"
                                 styleClass="pipeline-progress-full"/>
                </VBox>

                <Label text="→" styleClass="pipeline-arrow"/>

                <!-- Stage 2: Screening -->
                <VBox styleClass="pipeline-stage" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Screening" styleClass="pipeline-stage-label"/>
                    <Label fx:id="pipelineScreening" text="87"
                           styleClass="pipeline-stage-value"/>
                    <ProgressBar fx:id="progressScreening" progress="0.75"
                                 styleClass="pipeline-progress"/>
                </VBox>

                <Label text="→" styleClass="pipeline-arrow"/>

                <!-- Stage 3: Interview -->
                <VBox styleClass="pipeline-stage" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Interview" styleClass="pipeline-stage-label"/>
                    <Label fx:id="pipelineInterview" text="43"
                           styleClass="pipeline-stage-value"/>
                    <ProgressBar fx:id="progressInterview" progress="0.5"
                                 styleClass="pipeline-progress"/>
                </VBox>

                <Label text="→" styleClass="pipeline-arrow"/>

                <!-- Stage 4: Offer -->
                <VBox styleClass="pipeline-stage" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Offer" styleClass="pipeline-stage-label"/>
                    <Label fx:id="pipelineOffer" text="11"
                           styleClass="pipeline-stage-value"/>
                    <ProgressBar fx:id="progressOffer" progress="0.25"
                                 styleClass="pipeline-progress"/>
                </VBox>

                <Label text="→" styleClass="pipeline-arrow"/>

                <!-- Stage 5: Hired -->
                <VBox styleClass="pipeline-stage" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Hired" styleClass="pipeline-stage-label"/>
                    <Label fx:id="pipelineHired" text="8"
                           styleClass="pipeline-stage-value"/>
                    <ProgressBar fx:id="progressHired" progress="0.15"
                                 styleClass="pipeline-progress-success"/>
                </VBox>

            </HBox>

        </VBox>

    </VBox>

</ScrollPane>
