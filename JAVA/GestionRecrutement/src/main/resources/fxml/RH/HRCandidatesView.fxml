<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.RH.ApplicationsController"
      styleClass="view-container"
      spacing="0">

    <!-- STATS ROW -->
    <HBox styleClass="stats-row" spacing="16">
        <VBox.margin>
            <Insets top="28" right="28" bottom="0" left="28"/>
        </VBox.margin>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-blue">
                <Label text="📄" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="Total Candidates" styleClass="stat-card-label"/>
                <Label fx:id="statTotal" text="312" styleClass="stat-card-value"/>
                <Label text="↑ 28 this month" styleClass="stat-card-trend, trend-up"/>
            </VBox>
        </HBox>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-orange">
                <Label text="🔍" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="In Review" styleClass="stat-card-label"/>
                <Label fx:id="statReview" text="87" styleClass="stat-card-value"/>
                <Label text="→ Awaiting decision" styleClass="stat-card-trend, trend-neutral"/>
            </VBox>
        </HBox>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-purple">
                <Label text="⭐" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="Shortlisted" styleClass="stat-card-label"/>
                <Label fx:id="statShortlisted" text="43" styleClass="stat-card-value"/>
                <Label text="↑ 5 this week" styleClass="stat-card-trend, trend-up"/>
            </VBox>
        </HBox>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-green">
                <Label text="✅" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="Interview Stage" styleClass="stat-card-label"/>
                <Label fx:id="statInterviewStage" text="18" styleClass="stat-card-value"/>
                <Label text="→ Scheduled" styleClass="stat-card-trend, trend-neutral"/>
            </VBox>
        </HBox>

    </HBox>

    <!-- MAIN CONTENT CARD -->
    <VBox styleClass="content-card" VBox.vgrow="ALWAYS" spacing="0">
        <VBox.margin>
            <Insets top="20" right="28" bottom="28" left="28"/>
        </VBox.margin>

        <!-- Header Action Bar -->
        <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="12">
            <VBox spacing="3">
                <Label text="All Candidates" styleClass="card-title"/>
                <Label text="Search, filter, and manage candidate profiles" styleClass="card-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>

            <!-- Filter by Stage -->
            <ComboBox fx:id="filterStage"
                      promptText="All Stages"
                      styleClass="filter-combo"
                      prefWidth="140"
                      onAction="#handleStageFilter">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="All Stages"/>
                        <String fx:value="New"/>
                        <String fx:value="Screening"/>
                        <String fx:value="Shortlisted"/>
                        <String fx:value="Interview"/>
                        <String fx:value="Offer"/>
                        <String fx:value="Rejected"/>
                    </FXCollections>
                </items>
            </ComboBox>

            <!-- Filter by Position -->
            <ComboBox fx:id="filterPosition"
                      promptText="All Positions"
                      styleClass="filter-combo"
                      prefWidth="160"
                      onAction="#handlePositionFilter">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="All Positions"/>
                        <String fx:value="Senior Backend Engineer"/>
                        <String fx:value="Product Designer"/>
                        <String fx:value="Marketing Lead"/>
                        <String fx:value="Data Analyst"/>
                    </FXCollections>
                </items>
            </ComboBox>

                <Button text="⬇  Export" styleClass="btn-secondary" onAction="#handleExport"/>
        </HBox>

        <Separator styleClass="card-divider"/>

        <!-- TableView -->
        <TableView fx:id="candidateTableView"
                   styleClass="job-table"
                   VBox.vgrow="ALWAYS">

            <columns>
                <!-- Candidate Name -->
                <TableColumn fx:id="colName" text="CANDIDATE" prefWidth="200" sortable="true"/>

                <!-- Email -->
                <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="190" sortable="true"/>

                <!-- Position Applied -->
                <TableColumn fx:id="colPosition" text="POSITION" prefWidth="190" sortable="true"/>

                <!-- Department -->
                <TableColumn fx:id="colDepartment" text="DEPARTMENT" prefWidth="130" sortable="true"/>

                <!-- Applied Date -->
                <TableColumn fx:id="colAppliedDate" text="APPLIED" prefWidth="110" sortable="true"/>

                <!-- Stage — badge cell -->
                <TableColumn fx:id="colStage" text="STAGE" prefWidth="120" sortable="true"/>

                <!-- Actions -->
                <TableColumn fx:id="colActions" text="ACTIONS" prefWidth="120"
                             sortable="false" resizable="false"/>
            </columns>

            <placeholder>
                <VBox alignment="CENTER" spacing="12" styleClass="table-placeholder">
                    <Label text="👥" styleClass="table-placeholder-icon"/>
                    <Label text="No candidates found" styleClass="table-placeholder-title"/>
                    <Label text="Add your first candidate to get started."
                           styleClass="table-placeholder-subtitle"/>
                </VBox>
            </placeholder>

        </TableView>

        <!-- Pagination Bar -->
        <HBox styleClass="pagination-bar" alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="paginationInfo" text="Showing 1–10 of 312 results"
                   styleClass="pagination-info"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Pagination fx:id="tablePagination"
                        pageCount="32"
                        currentPageIndex="0"
                        maxPageIndicatorCount="5"
                        styleClass="table-pagination"/>
        </HBox>

    </VBox>

</VBox>
