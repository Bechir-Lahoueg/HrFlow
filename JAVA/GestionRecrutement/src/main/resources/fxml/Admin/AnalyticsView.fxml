<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AnalyticsController"
      styleClass="view-container"
      spacing="0">

    <HBox styleClass="stats-row" spacing="16">
        <VBox.margin>
            <Insets top="28" right="28" bottom="0" left="28"/>
        </VBox.margin>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-blue">
                <Label text="📈" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="Hiring Velocity" styleClass="stat-card-label"/>
                <Label fx:id="hiringVelocityLabel" text="0 days" styleClass="stat-card-value"/>
                <Label text="" styleClass="stat-card-trend"/>
            </VBox>
        </HBox>

        <HBox styleClass="stat-card" HBox.hgrow="ALWAYS" spacing="16" alignment="CENTER_LEFT">
            <StackPane styleClass="stat-icon-bg, stat-icon-bg-orange">
                <Label text="🎯" styleClass="stat-icon"/>
            </StackPane>
            <VBox spacing="3">
                <Label text="Interview Pass Rate" styleClass="stat-card-label"/>
                <Label fx:id="passRateLabel" text="0%" styleClass="stat-card-value"/>
                <Label text="" styleClass="stat-card-trend"/>
            </VBox>
        </HBox>
    </HBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox.margin>
            <Insets top="20" right="28" bottom="28" left="28"/>
        </VBox.margin>

        <!-- Pipeline Funnel Chart -->
        <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="0">
            <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Pipeline Funnel" styleClass="card-title"/>
                    <Label text="Distribution of applications by status" styleClass="card-subtitle"/>
                </VBox>
            </HBox>
            <Separator styleClass="card-divider"/>
            <StackPane VBox.vgrow="ALWAYS">
                <BarChart fx:id="funnelChart" animated="false">
                    <xAxis><CategoryAxis label="Status"/></xAxis>
                    <yAxis><NumberAxis label="Count"/></yAxis>
                </BarChart>
            </StackPane>
        </VBox>

        <!-- Application Trends Chart -->
        <VBox styleClass="content-card" HBox.hgrow="ALWAYS" spacing="0">
            <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="3">
                    <Label text="Application Trends" styleClass="card-title"/>
                    <Label text="Applications received over last 30 days" styleClass="card-subtitle"/>
                </VBox>
            </HBox>
            <Separator styleClass="card-divider"/>
            <StackPane VBox.vgrow="ALWAYS">
                <LineChart fx:id="trendsChart" animated="false">
                    <xAxis><CategoryAxis label="Date"/></xAxis>
                    <yAxis><NumberAxis label="Count"/></yAxis>
                </LineChart>
            </StackPane>
        </VBox>
    </HBox>
</VBox>
