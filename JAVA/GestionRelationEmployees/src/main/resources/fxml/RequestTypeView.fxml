<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.RequestTypeController"
      spacing="20"
      style="-fx-background-color: #f4f6f9; -fx-padding: 20;">

    <!-- ═══ COLONNE GAUCHE : Tableau ════════════════════════════════ -->
    <VBox spacing="12" HBox.hgrow="ALWAYS">

        <HBox spacing="16" alignment="CENTER_LEFT">
            <Label text="🗂️ Types de Demandes"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;
                          -fx-text-fill: #2c3e50;"/>
            <Label fx:id="lblTotal"
                   text="Total : 0 types"
                   style="-fx-background-color: #3498db; -fx-text-fill: white;
                          -fx-padding: 4 12; -fx-background-radius: 12;
                          -fx-font-size: 12px;"/>
        </HBox>

        <TableView fx:id="tableTypes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId"
                             text="#"
                             prefWidth="50"/>
                <TableColumn fx:id="colName"
                             text="Nom"
                             prefWidth="160"/>
                <TableColumn fx:id="colDescription"
                             text="Description"
                             prefWidth="200"/>
                <TableColumn fx:id="colRequiresApproval"
                             text="Approbation"
                             prefWidth="110"/>
                <TableColumn fx:id="colCreatedAt"
                             text="Créé le"
                             prefWidth="150"/>
            </columns>
            <placeholder>
                <Label text="Aucun type de demande."
                       style="-fx-text-fill: #999; -fx-font-style: italic;"/>
            </placeholder>
        </TableView>

        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="btnDelete"
                    text="🗑️ Supprimer le type sélectionné"
                    onAction="#handleDelete"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-padding: 8 16;
                           -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <Separator orientation="VERTICAL"/>

    <!-- ═══ COLONNE DROITE : Formulaire ═════════════════════════════ -->
    <VBox spacing="14" minWidth="280" maxWidth="300">

        <Label fx:id="lblFormTitle"
               text="➕ Nouveau type"
               style="-fx-font-size: 15px; -fx-font-weight: bold;
                      -fx-text-fill: #2c3e50;"/>

        <Separator/>

        <VBox spacing="4">
            <Label text="Nom *"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <TextField fx:id="txtName"
                       promptText="Ex: Demande de matériel"
                       style="-fx-border-color: #ddd; -fx-background-radius: 6;
                              -fx-border-radius: 6; -fx-padding: 7 10;"/>
        </VBox>

        <VBox spacing="4">
            <Label text="Description"
                   style="-fx-font-weight: bold; -fx-text-fill: #555;"/>
            <TextArea fx:id="txtDescription"
                      promptText="Décrivez ce type de demande..."
                      prefRowCount="4"
                      wrapText="true"
                      style="-fx-border-color: #ddd; -fx-background-radius: 6;
                             -fx-border-radius: 6;"/>
        </VBox>

        <CheckBox fx:id="chkRequiresApproval"
                  text="Nécessite une approbation"
                  selected="true"
                  style="-fx-font-size: 13px;"/>

        <Separator/>

        <HBox spacing="10">
            <Button fx:id="btnSave"
                    text="💾 Ajouter"
                    onAction="#handleSave"
                    maxWidth="Infinity"
                    HBox.hgrow="ALWAYS"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-padding: 9 0;
                           -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button fx:id="btnClear"
                    text="🔄"
                    onAction="#handleClear"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                           -fx-background-radius: 6; -fx-padding: 9 14;
                           -fx-cursor: hand;"/>
        </HBox>

        <Label text="💡 Cliquez sur une ligne pour modifier."
               style="-fx-text-fill: #999; -fx-font-size: 11px;
                      -fx-font-style: italic;"/>
    </VBox>

</HBox>