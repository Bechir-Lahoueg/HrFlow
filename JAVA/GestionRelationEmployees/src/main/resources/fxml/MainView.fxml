<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.MainController"
            style="-fx-background-color: #2c3e50;">

    <!-- ═══ SIDEBAR GAUCHE ══════════════════════════════════════════ -->
    <left>
        <VBox spacing="6"
              style="-fx-background-color: #2c3e50; -fx-padding: 20 10; -fx-min-width: 210;">

            <Label text="HR-Flow"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;
                          -fx-text-fill: white; -fx-padding: 0 0 4 6;"/>
            <Label text="Relations Employés"
                   style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;
                          -fx-padding: 0 0 16 6;"/>

            <Separator style="-fx-background-color: #34495e;"/>

            <Button text="📋  Demandes"
                    maxWidth="Infinity"
                    onAction="#showRequests"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-padding: 10 16;
                           -fx-font-size: 13px; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="🗂️  Types de demandes"
                    maxWidth="Infinity"
                    onAction="#showRequestTypes"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                           -fx-background-radius: 8; -fx-padding: 10 16;
                           -fx-font-size: 13px; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="💬  Feedbacks"
                    maxWidth="Infinity"
                    onAction="#showFeedbacks"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                           -fx-background-radius: 8; -fx-padding: 10 16;
                           -fx-font-size: 13px; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <Button text="🔔  Notifications"
                    maxWidth="Infinity"
                    onAction="#showNotifications"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                           -fx-background-radius: 8; -fx-padding: 10 16;
                           -fx-font-size: 13px; -fx-cursor: hand;
                           -fx-alignment: CENTER_LEFT;"/>

            <VBox VBox.vgrow="ALWAYS"/>
            <Separator style="-fx-background-color: #34495e;"/>
            <Label text="👤 Utilisateur connecté"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px; -fx-padding: 8 6;"/>
        </VBox>
    </left>

    <!-- ═══ CONTENU PRINCIPAL ═══════════════════════════════════════ -->
    <center>
        <StackPane fx:id="contentArea"
                   style="-fx-background-color: #f4f6f9;"/>
    </center>

</BorderPane>