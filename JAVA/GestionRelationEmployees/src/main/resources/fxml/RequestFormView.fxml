<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.RequestFormController"
      spacing="16"
      style="-fx-background-color: #f4f6f9; -fx-padding: 30;">

    <!-- ═══ TITRE ═══════════════════════════════════════════════════ -->
    <Label fx:id="lblTitle"
           text="Nouvelle demande"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <Separator/>

    <!-- ═══ FORMULAIRE ══════════════════════════════════════════════ -->
    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints prefWidth="130"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <!-- Titre -->
        <Label text="Titre *"
               GridPane.rowIndex="0" GridPane.columnIndex="0"
               style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtTitle"
                   promptText="Ex: Demande de matériel"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"
                   style="-fx-border-color: #ddd; -fx-background-radius: 6;
                          -fx-border-radius: 6; -fx-padding: 6 10;"/>

        <!-- Type -->
        <Label text="Type *"
               GridPane.rowIndex="1" GridPane.columnIndex="0"
               style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="cbType"
                  promptText="Choisir un type..."
                  maxWidth="Infinity"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Priorité -->
        <Label text="Priorité *"
               GridPane.rowIndex="2" GridPane.columnIndex="0"
               style="-fx-font-weight: bold;"/>
        <ComboBox fx:id="cbPriority"
                  maxWidth="Infinity"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Description -->
        <Label text="Description"
               GridPane.rowIndex="3" GridPane.columnIndex="0"
               style="-fx-font-weight: bold;"/>
        <TextArea fx:id="txtDescription"
                  promptText="Décrivez votre demande..."
                  prefRowCount="5"
                  wrapText="true"
                  GridPane.rowIndex="3" GridPane.columnIndex="1"
                  style="-fx-border-color: #ddd; -fx-background-radius: 6;
                         -fx-border-radius: 6;"/>
    </GridPane>

    <Separator/>

    <!-- ═══ BOUTONS ══════════════════════════════════════════════════ -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel"
                text="Annuler"
                onAction="#handleCancel"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 20;
                       -fx-cursor: hand;"/>
        <Button fx:id="btnSave"
                text="💾 Enregistrer"
                onAction="#handleSave"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 20;
                       -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>
</VBox>