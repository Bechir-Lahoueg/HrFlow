<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.NotificationController"
      spacing="12"
      style="-fx-background-color: #f4f6f9; -fx-padding: 20;">

    <!-- Titre + Stats -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <Label text="🔔 Notifications"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label fx:id="lblTotal" text="Total : 0"
               style="-fx-background-color: #3498db; -fx-text-fill: white;
                      -fx-padding: 4 12; -fx-background-radius: 12;"/>
        <Label fx:id="lblUnread" text="🔵 Non lues : 0"
               style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                      -fx-padding: 4 12; -fx-background-radius: 12;"/>
    </HBox>

    <!-- Filtre -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Afficher :"/>
        <ComboBox fx:id="filterRead" prefWidth="140"/>
    </HBox>

    <!-- Tableau -->
    <TableView fx:id="tableNotifications" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colStatus"  text="Statut"   prefWidth="100"/>
            <TableColumn fx:id="colType"    text="Type"     prefWidth="100"/>
            <TableColumn fx:id="colTitle"   text="Titre"    prefWidth="200"/>
            <TableColumn fx:id="colMessage" text="Message"  prefWidth="300"/>
            <TableColumn fx:id="colDate"    text="Date"     prefWidth="160"/>
        </columns>
        <placeholder>
            <Label text="Aucune notification."
                   style="-fx-text-fill: #999; -fx-font-style: italic;"/>
        </placeholder>
    </TableView>

    <!-- Boutons -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnMarkRead" text="✅ Marquer comme lu"
                onAction="#handleMarkRead"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 14; -fx-cursor: hand;"/>
        <Button fx:id="btnMarkAllRead" text="✅✅ Tout marquer lu"
                onAction="#handleMarkAllRead"
                style="-fx-background-color: #2ecc71; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 14; -fx-cursor: hand;"/>
        <Button fx:id="btnDelete" text="🗑️ Supprimer"
                onAction="#handleDelete"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 14; -fx-cursor: hand;"/>
    </HBox>

    <Label text="💡 Double-clic sur une notification pour la marquer comme lue."
           style="-fx-text-fill: #999; -fx-font-style: italic; -fx-font-size: 11px;"/>
</VBox>