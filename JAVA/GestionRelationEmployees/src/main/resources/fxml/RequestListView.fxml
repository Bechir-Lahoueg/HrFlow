<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.RequestController"
      spacing="12"
      style="-fx-background-color: #f4f6f9; -fx-padding: 20;">

    <!-- ═══ TITRE ═══════════════════════════════════════════════════ -->
    <Label text="📋 Gestion des Demandes"
           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <!-- ═══ STATISTIQUES ════════════════════════════════════════════ -->
    <HBox spacing="20">
        <Label fx:id="lblTotal"
               text="Total : 0"
               style="-fx-background-color: #3498db; -fx-text-fill: white;
                      -fx-padding: 8 16; -fx-background-radius: 8;
                      -fx-font-weight: bold;"/>
        <Label fx:id="lblPending"
               text="En attente : 0"
               style="-fx-background-color: #f39c12; -fx-text-fill: white;
                      -fx-padding: 8 16; -fx-background-radius: 8;
                      -fx-font-weight: bold;"/>
        <Label fx:id="lblApproved"
               text="Approuvées : 0"
               style="-fx-background-color: #27ae60; -fx-text-fill: white;
                      -fx-padding: 8 16; -fx-background-radius: 8;
                      -fx-font-weight: bold;"/>
    </HBox>

    <!-- ═══ FILTRES ══════════════════════════════════════════════════ -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <TextField fx:id="searchField"
                   promptText="🔍 Rechercher par titre..."
                   prefWidth="250"
                   style="-fx-background-radius: 6; -fx-border-radius: 6;
                          -fx-border-color: #ddd; -fx-padding: 6 10;"/>
        <Label text="Statut :"/>
        <ComboBox fx:id="filterStatus" prefWidth="140"/>
    </HBox>

    <!-- ═══ TABLEAU ══════════════════════════════════════════════════ -->
    <TableView fx:id="tableRequests"
               VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 8;">
        <columns>
            <TableColumn fx:id="colId"       text="#"          prefWidth="50"/>
            <TableColumn fx:id="colTitle"    text="Titre"      prefWidth="200"/>
            <TableColumn fx:id="colType"     text="Type"       prefWidth="160"/>
            <TableColumn fx:id="colPriority" text="Priorité"   prefWidth="100"/>
            <TableColumn fx:id="colStatus"   text="Statut"     prefWidth="110"/>
            <TableColumn fx:id="colDate"     text="Date"       prefWidth="160"/>
        </columns>
        <placeholder>
            <Label text="Aucune demande trouvée."
                   style="-fx-text-fill: #999; -fx-font-style: italic;"/>
        </placeholder>
    </TableView>

    <!-- ═══ BOUTONS ══════════════════════════════════════════════════ -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnAdd"
                text="➕ Nouvelle demande"
                onAction="#handleAdd"
                style="-fx-background-color: #3498db; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 16;
                       -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button fx:id="btnEdit"
                text="✏️ Modifier"
                onAction="#handleEdit"
                style="-fx-background-color: #f39c12; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 16;
                       -fx-cursor: hand;"/>
        <Button fx:id="btnApprove"
                text="✅ Approuver"
                onAction="#handleApprove"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 16;
                       -fx-cursor: hand;"/>
        <Button fx:id="btnReject"
                text="❌ Rejeter"
                onAction="#handleReject"
                style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 16;
                       -fx-cursor: hand;"/>
        <Button fx:id="btnDelete"
                text="🗑️ Supprimer"
                onAction="#handleDelete"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                       -fx-background-radius: 6; -fx-padding: 8 16;
                       -fx-cursor: hand;"/>
    </HBox>
</VBox>