<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.AddSessionController"
      style="-fx-background-color: white;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="lblTitle" text="Planifier une nouvelle session" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="15">
        <Label text="Date de début :" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpDateDebut" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Date de fin :" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dpDateFin" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Lieu / Lien :" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtLieu" promptText="Ex: Salle A ou URL Teams" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Capacité max :" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtCapacite" promptText="Ex: 20" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Mode :" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbMode" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Statut :" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbStatut" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="Annuler" styleClass="delete-button"/>
        <Button fx:id="btnSave" text="Enregistrer" styleClass="primary-button"/>
    </HBox>
</VBox>