<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" prefWidth="650.0" prefHeight="450.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controllers.ManageParticipantsController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="lblTitle" text="Gestion des Inscriptions" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tableParticipants" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNom" text="Employé" prefWidth="200"/>
            <TableColumn fx:id="colDate" text="Date Inscription" prefWidth="120"/>
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>