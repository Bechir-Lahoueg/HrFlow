{% extends 'base.html.twig' %}

{% block title %}Mon Espace - Formations{% endblock %}

{% block body %}
<div class="p-4 sm:ml-64">
    <div class="mb-8">
        <h2 class="text-2xl font-extrabold text-gray-900">Développer mes compétences</h2>
        <p class="text-gray-500">Inscrivez-vous aux prochaines sessions disponibles.</p>
    </div>

    {# Messages de confirmation d'inscription #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-4 p-4 rounded-lg {{ label == 'success' ? 'bg-green-50 text-green-800' : 'bg-red-50 text-red-800' }} border border-{{ label == 'success' ? 'green' : 'red' }}-200">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {% for session in sessions %}
        <div class="max-w-sm bg-white border border-gray-200 rounded-2xl shadow-sm hover:shadow-lg transition-shadow duration-300">
            <div class="p-5">
                <div class="flex items-center justify-between mb-3">
                    <span class="text-xs font-semibold px-2 py-1 bg-purple-100 text-purple-700 rounded uppercase tracking-wider">
                        {{ session.mode }}
                    </span>
                    <div class="text-xs text-gray-400">Places : {{ session.capacite_max }}</div>
                </div>

                <h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900">{{ session.formation_titre }}</h5>

                <div class="space-y-2 mb-5">
                    <div class="flex items-center text-sm text-gray-600">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        Dès le {{ session.date_debut|date('d/m/Y') }}
                    </div>
                    <div class="flex items-center text-sm text-gray-600">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path></svg>
                        {{ session.lieu }}
                    </div>
                </div>

                <form action="{{ path('employee_formation_register', {'id': session.id_session}) }}" method="POST">
                    <button type="submit" class="inline-flex items-center justify-center w-full px-4 py-2.5 text-sm font-bold text-white bg-gray-900 rounded-xl hover:bg-gray-800 transition-colors">
                        Rejoindre la formation
                    </button>
                </form>
            </div>
        </div>
        {% else %}
        <div class="col-span-full py-20 text-center">
            <p class="text-gray-400 text-lg">Aucune session ouverte pour le moment.</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}