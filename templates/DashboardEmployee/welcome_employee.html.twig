{% extends 'base.html.twig' %}

{% block title %}Employee Dashboard | HrFlow{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardEmployee/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ═══════════════ Welcome Banner ═══════════════ #}
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-amber-500 via-amber-600 to-orange-700 p-8 sm:p-10 text-white animate-slide-up">
                {# Decorative shapes #}
                <div class="absolute inset-0 overflow-hidden">
                    <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full bg-white/10 blur-3xl mesh-blob"></div>
                    <div class="absolute -bottom-32 -left-20 w-80 h-80 rounded-full bg-orange-400/20 blur-3xl mesh-blob-alt"></div>
                    <div class="absolute top-0 right-0 w-80 h-80 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
                </div>
                {# Content #}
                <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                        <span class="text-[11px] font-bold text-amber-200 uppercase tracking-wider">Portal Active</span>
                    </div>
                    <h2 class="text-3xl sm:text-4xl font-extrabold mb-2">
                        Welcome back, <span class="text-white/90">{{ user.fullName is defined and user.fullName ? user.fullName : user.userIdentifier }}</span>
                    </h2>
                    <p class="text-amber-200 max-w-lg text-[15px] leading-relaxed">
                        {% if user.jobTitle is defined and user.jobTitle %}
                            {{ user.jobTitle }} &mdash; Access your leaves, payslips, training, and documents all in one place.
                        {% else %}
                            Access your leaves, payslips, training, and documents all in one place.
                        {% endif %}
                    </p>
                </div>
            </div>

            {# ═══════════════ Stats Grid ═══════════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">

                {# Stat: Leave Balance #}
                <div class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none card-hover hover:border-amber-200 dark:hover:border-amber-500/20 animate-slide-up stagger-1">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center">
                            <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                            </svg>
                        </div>
                        <span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10 px-2 py-0.5 rounded-md">Balance</span>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ availableLeaveDays|default(0)|number_format(1, '.', ',') }}</p>
                    <p class="text-[13px] text-zinc-400 dark:text-zinc-500 mt-1 font-medium">Leave Balance</p>
                    <p class="text-[11px] text-zinc-400 dark:text-zinc-500 mt-1">Accrued {{ balance.total_accrued|default(0)|number_format(1, '.', ',') }} &bull; Used {{ balance.total_used|default(0)|number_format(1, '.', ',') }}</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden">
                        <div class="h-full w-3/4 rounded-full bg-gradient-to-r from-amber-500 to-orange-400"></div>
                    </div>
                </div>

                {# Stat: Pending Requests #}
                <div class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none card-hover hover:border-sky-200 dark:hover:border-sky-500/20 animate-slide-up stagger-2">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-10 h-10 rounded-lg bg-sky-50 dark:bg-sky-500/10 flex items-center justify-center">
                            <svg class="w-5 h-5 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></span>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ pendingLeaveCount|default(0) }}</p>
                    <p class="text-[13px] text-zinc-400 dark:text-zinc-500 mt-1 font-medium">Pending Requests</p>
                    <p class="text-[11px] text-zinc-400 dark:text-zinc-500 mt-1">Approved {{ leaveStats.approved_count|default(0) }} &bull; Rejected {{ leaveStats.rejected_count|default(0) }}</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden">
                        <div class="h-full w-1/3 rounded-full bg-gradient-to-r from-sky-500 to-cyan-400"></div>
                    </div>
                </div>

                {# Stat: Training Courses #}
                <div class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none card-hover hover:border-emerald-200 dark:hover:border-emerald-500/20 animate-slide-up stagger-3">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-10 h-10 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center">
                            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
                            </svg>
                        </div>
                        <span class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 px-2 py-0.5 rounded-md">Courses</span>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">--</p>
                    <p class="text-[13px] text-zinc-400 dark:text-zinc-500 mt-1 font-medium">Training Courses</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden">
                        <div class="h-full w-1/2 rounded-full bg-gradient-to-r from-emerald-500 to-teal-400"></div>
                    </div>
                </div>

                {# Stat: Documents #}
                <div class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none card-hover hover:border-violet-200 dark:hover:border-violet-500/20 animate-slide-up stagger-4">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-10 h-10 rounded-lg bg-violet-50 dark:bg-violet-500/10 flex items-center justify-center">
                            <svg class="w-5 h-5 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                            </svg>
                        </div>
                        <span class="text-[11px] font-bold text-violet-600 dark:text-violet-400 bg-violet-50 dark:bg-violet-500/10 px-2 py-0.5 rounded-md">Files</span>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">--</p>
                    <p class="text-[13px] text-zinc-400 dark:text-zinc-500 mt-1 font-medium">Documents</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden">
                        <div class="h-full w-full rounded-full bg-gradient-to-r from-violet-500 to-fuchsia-400"></div>
                    </div>
                </div>
            </div>

            {# ═══════════════ Main Content ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

                {# ── Recent Activity ── #}
                <div class="xl:col-span-2 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm dark:shadow-none animate-slide-up stagger-5">
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center">
                                <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </div>
                            <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Recent Activity</h3>
                        </div>
                        <button class="text-[12px] font-semibold text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 px-3 py-1.5 rounded-lg hover:bg-amber-50 dark:hover:bg-amber-500/10 transition-colors">View All</button>
                    </div>

                    {# Activity timeline #}
                    <div class="space-y-0">
                        <div class="flex gap-4 pb-6 relative">
                            <div class="flex flex-col items-center">
                                <div class="w-3 h-3 rounded-full bg-amber-500 ring-4 ring-amber-100 dark:ring-amber-500/10 shrink-0 mt-0.5"></div>
                                <div class="w-px flex-1 bg-zinc-200 dark:bg-zinc-800 mt-2"></div>
                            </div>
                            <div class="pb-2">
                                <p class="text-[13px] font-medium text-zinc-700 dark:text-zinc-300">Portal initialized</p>
                                <p class="text-[12px] text-zinc-400 dark:text-zinc-500 mt-0.5">Employee dashboard is active</p>
                                <span class="inline-block text-[11px] text-zinc-300 dark:text-zinc-600 mt-1.5">Just now</span>
                            </div>
                        </div>

                        <div class="flex gap-4 pb-6 relative">
                            <div class="flex flex-col items-center">
                                <div class="w-3 h-3 rounded-full bg-sky-500 ring-4 ring-sky-100 dark:ring-sky-500/10 shrink-0 mt-0.5"></div>
                                <div class="w-px flex-1 bg-zinc-200 dark:bg-zinc-800 mt-2"></div>
                            </div>
                            <div class="pb-2">
                                <p class="text-[13px] font-medium text-zinc-700 dark:text-zinc-300">Dashboard loaded</p>
                                <p class="text-[12px] text-zinc-400 dark:text-zinc-500 mt-0.5">All modules connected and operational</p>
                                <span class="inline-block text-[11px] text-zinc-300 dark:text-zinc-600 mt-1.5">2 minutes ago</span>
                            </div>
                        </div>

                        <div class="flex gap-4 relative">
                            <div class="flex flex-col items-center">
                                <div class="w-3 h-3 rounded-full bg-zinc-300 dark:bg-zinc-700 ring-4 ring-zinc-100 dark:ring-zinc-800 shrink-0 mt-0.5"></div>
                            </div>
                            <div>
                                <p class="text-[13px] font-medium text-zinc-400 dark:text-zinc-500">No more recent activity</p>
                                <p class="text-[12px] text-zinc-300 dark:text-zinc-600 mt-0.5">Events will appear here as they occur</p>
                            </div>
                        </div>
                    </div>
                </div>

                {# ── Profile Card ── #}
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm dark:shadow-none animate-slide-up stagger-5">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Your Profile</h3>
                    </div>

                    <div class="flex flex-col items-center text-center mb-6">
                        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center shadow-xl shadow-amber-500/20 mb-4 ring-4 ring-amber-100 dark:ring-amber-500/10">
                            <span class="text-2xl font-bold text-white">{{ user.userIdentifier|first|upper }}</span>
                        </div>
                        <p class="text-lg font-bold text-zinc-900 dark:text-zinc-100">{{ user.fullName is defined and user.fullName ? user.fullName : user.userIdentifier }}</p>
                        {% if user.jobTitle is defined and user.jobTitle %}
                            <p class="text-[13px] text-zinc-400 dark:text-zinc-500 mt-0.5">{{ user.jobTitle }}</p>
                        {% endif %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold bg-amber-50 dark:bg-amber-500/10 text-amber-600 dark:text-amber-400 mt-2 uppercase tracking-wider">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 dark:bg-amber-400"></span>
                            Employee
                        </span>
                    </div>

                    <div class="space-y-3 pt-5 border-t border-zinc-100 dark:border-zinc-800/50">
                        {% if user.email is defined and user.email %}
                        <div class="flex items-center gap-3 text-sm">
                            <div class="w-8 h-8 rounded-md bg-zinc-50 dark:bg-zinc-800/80 flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4 text-zinc-400 dark:text-zinc-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                            </div>
                            <span class="text-[13px] text-zinc-600 dark:text-zinc-400 truncate">{{ user.email }}</span>
                        </div>
                        {% endif %}
                        {% if user.age is defined and user.age %}
                        <div class="flex items-center gap-3 text-sm">
                            <div class="w-8 h-8 rounded-md bg-zinc-50 dark:bg-zinc-800/80 flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4 text-zinc-400 dark:text-zinc-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                            </div>
                            <span class="text-[13px] text-zinc-600 dark:text-zinc-400">{{ user.age }} years old</span>
                        </div>
                        {% endif %}
                        <div class="flex items-center gap-3 text-sm">
                            <div class="w-8 h-8 rounded-md bg-zinc-50 dark:bg-zinc-800/80 flex items-center justify-center shrink-0">
                                <svg class="w-4 h-4 text-zinc-400 dark:text-zinc-500" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                            </div>
                            <span class="text-[13px] text-zinc-600 dark:text-zinc-400">Employee Access</span>
                        </div>
                    </div>
                </div>
            </div>

            {# ═══════════════ Quick Actions ═══════════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-slide-up stagger-5">
                <a href="{{ path('app_employee_leave_requests') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none hover:border-amber-200 dark:hover:border-amber-500/20 transition-all duration-200 card-hover">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center group-hover:bg-amber-100 dark:group-hover:bg-amber-500/20 transition-colors">
                            <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-amber-700 dark:group-hover:text-amber-300 transition-colors">My Leaves</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Request & track leaves</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-amber-500 dark:group-hover:text-amber-400 ml-auto transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>

                <a href="#" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none hover:border-emerald-200 dark:hover:border-emerald-500/20 transition-all duration-200 card-hover">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center group-hover:bg-emerald-100 dark:group-hover:bg-emerald-400/10 transition-colors">
                            <svg class="w-5 h-5 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-emerald-700 dark:group-hover:text-emerald-300 transition-colors">Training</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Browse available courses</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-emerald-500 dark:group-hover:text-emerald-400 ml-auto transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>

                <a href="#" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none hover:border-violet-200 dark:hover:border-violet-500/20 transition-all duration-200 card-hover">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg bg-violet-50 dark:bg-violet-500/10 flex items-center justify-center group-hover:bg-violet-100 dark:group-hover:bg-violet-400/10 transition-colors">
