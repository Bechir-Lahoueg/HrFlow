{% extends 'base.html.twig' %}

{% block title %}Mes Formations | HrFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .decision-table thead th{position:sticky;top:0;z-index:10}
        .decision-row{transition:all .2s}
        .decision-row:hover{background:#f8fafc;transform:scale(1.001)}
        .filter-chip{transition:all .2s}
        .filter-chip:hover{transform:translateY(-1px)}
        .filter-chip.active{box-shadow:0 4px 14px -4px rgba(15,23,42,.3)}
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardEmployee/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ══════════ Hero Banner ══════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-cyan-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-400/15 blur-3xl mesh-blob"></div>
                <div class="absolute -left-20 bottom-0 h-48 w-48 rounded-full bg-emerald-300/10 blur-3xl mesh-blob-alt"></div>
                <div class="relative z-10 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-cyan-200 uppercase tracking-wider">Formation Studio</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Développez vos compétences</h2>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">Découvrez nos formations et inscrivez-vous aux sessions disponibles.</p>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">Formations</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ formations|length }}</p>
                            <p class="text-xs text-cyan-100/60 mt-1">disponibles</p>
                        </div>
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">Mes Demandes</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num"><a href="{{ path('employee_formation_requests') }}" class="hover:text-cyan-300 transition-colors">Voir</a></p>
                            <p class="text-xs text-cyan-100/60 mt-1">suivi</p>
                        </div>
                    </div>
                </div>
            </section>

            {# ══════════ Formation Table ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center">
                            <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/></svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Catalogue des Formations</h3>
                    </div>
                </div>

                {# ══════════ Filtres ══════════ #}
                <div class="flex justify-end gap-4 mb-6 bg-zinc-50/50 dark:bg-zinc-800/20 rounded-xl p-3 border border-zinc-100 dark:border-zinc-800/50">
                    <form method="get" action="{{ path('employee_formation_index') }}" class="flex items-center gap-2 w-full md:w-auto">
                        <select name="type" class="rounded-lg border-zinc-200 bg-white py-1.5 px-3 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 shadow-sm">
                            <option value="">Tous les types</option>
                            <option value="Technique" {% if filters.type == 'Technique' %}selected{% endif %}>Technique</option>
                            <option value="Management" {% if filters.type == 'Management' %}selected{% endif %}>Management</option>
                            <option value="Langues" {% if filters.type == 'Langues' %}selected{% endif %}>Langues</option>
                            <option value="Qualité" {% if filters.type == 'Qualité' %}selected{% endif %}>Qualité</option>
                            <option value="Sécurité" {% if filters.type == 'Sécurité' %}selected{% endif %}>Sécurité</option>
                            <option value="Autre" {% if filters.type == 'Autre' %}selected{% endif %}>Autre</option>
                        </select>

                        <select name="sort" class="rounded-lg border-zinc-200 bg-white py-1.5 px-3 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 shadow-sm">
                            <option value="created_at-DESC" {% if filters.sort == 'created_at-DESC' %}selected{% endif %}>Plus récent</option>
                            <option value="created_at-ASC" {% if filters.sort == 'created_at-ASC' %}selected{% endif %}>Plus ancien</option>
                            <option value="titre-ASC" {% if filters.sort == 'titre-ASC' %}selected{% endif %}>Titre (A-Z)</option>
                            <option value="titre-DESC" {% if filters.sort == 'titre-DESC' %}selected{% endif %}>Titre (Z-A)</option>
                            <option value="duree-ASC" {% if filters.sort == 'duree-ASC' %}selected{% endif %}>Durée (Croissant)</option>
                            <option value="duree-DESC" {% if filters.sort == 'duree-DESC' %}selected{% endif %}>Durée (Décroissant)</option>
                        </select>

                        <button type="submit" class="px-4 py-1.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition flex items-center justify-center shadow-sm" title="Filtrer">
                            Filtrer
                        </button>

                        {% if filters.type or (filters.sort != 'created_at-DESC') %}
                        <a href="{{ path('employee_formation_index') }}" class="text-zinc-400 hover:text-red-500 transition" title="Réinitialiser filtres">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </a>
                        {% endif %}
                    </form>
                </div>

                {# Grid des Formations #}
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
                    {% for formation in formations %}
                        <div onclick="window.location.href='{{ path('employee_formation_sessions', {id: formation.id_formation}) }}'"
                             class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover flex flex-col justify-between cursor-pointer transition-all hover:ring-2 hover:ring-indigo-500/20">
                            <div>
                                <div class="flex justify-between items-start mb-3">
                                    <h4 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 line-clamp-1" title="{{ formation.titre }}">{{ formation.titre }}</h4>
                                    <span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider whitespace-nowrap ml-2">{{ formation.type }}</span>
                                </div>
                                <div class="mb-4 space-y-2">
                                    <div>
                                        <p class="text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-0.5">Description</p>
                                        <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2" title="{{ formation.description }}">
                                            {{ formation.description ?: 'Aucune description' }}
                                        </p>
                                    </div>
                                    <div>
                                        <p class="text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-0.5">Objectifs</p>
                                        <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2" title="{{ formation.objectifs }}">
                                            {{ formation.objectifs ?: 'Aucun objectif défini' }}
                                        </p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-2 mb-4">
                                    <div class="bg-zinc-50 dark:bg-zinc-800/50 p-2 rounded-lg">
                                        <p class="text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-1">Durée</p>
                                        <p class="text-sm font-bold text-zinc-700 dark:text-zinc-300 font-mono-num">{{ formation.duree }} Jours</p>
                                    </div>
                                    <div class="bg-zinc-50 dark:bg-zinc-800/50 p-2 rounded-lg">
                                        <p class="text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-1">Organisme</p>
                                        <p class="text-sm font-bold text-zinc-700 dark:text-zinc-300 truncate" title="{{ formation.organisme }}">{{ formation.organisme }}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-span-1 md:col-span-2 lg:col-span-3 py-14 text-center text-zinc-400 text-sm bg-zinc-50 border border-zinc-100 rounded-xl border-dashed">
                            Aucune formation disponible.
                        </div>
                    {% endfor %}
                </div>
            </section>
        </main>
    </div>
</div>
{% endblock %}





