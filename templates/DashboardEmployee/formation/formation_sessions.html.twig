{% extends 'base.html.twig' %}

{% block title %}Sessions de {{ formation.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .decision-table thead th{position:sticky;top:0;z-index:10}
        .decision-row{transition:all .2s}
        .decision-row:hover{background:#f8fafc;transform:scale(1.001)}
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardEmployee/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            <div class="mb-6">
                <a href="{{ path('employee_formation_index') }}" class="inline-flex items-center gap-2 text-zinc-600 hover:text-zinc-800 text-sm font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour au catalogue
                </a>
            </div>

            {# ══════════ Hero Banner ══════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-sky-900 to-indigo-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-sky-300/15 blur-3xl mesh-blob"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-300/15 blur-3xl mesh-blob-alt"></div>
                <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                        <span class="text-[11px] font-bold text-cyan-200 uppercase tracking-wider">Sessions Disponibles</span>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">{{ formation.titre }}</h2>
                    <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">{{ formation.description }}</p>
                    <div class="mt-4 flex items-center gap-4 text-sm flex-wrap">
                        <span class="bg-white/10 px-3 py-1 rounded-full">{{ formation.type }}</span>
                        <span class="text-cyan-200">{{ formation.duree }} Jours</span>
                        <span class="text-slate-400">•</span>
                        <span class="text-slate-300">{{ formation.organisme }}</span>
                    </div>
                </div>
            </section>

            {# ══════════ Sessions Table ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center">
                            <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Sessions Programmées</h3>
                    </div>
                </div>

                {# Table #}
                <div class="overflow-x-auto rounded-lg border border-zinc-100 max-h-[70vh]">
                    <table class="decision-table min-w-full text-sm">
                        <thead>
                            <tr class="text-left text-[11px] font-bold uppercase tracking-wider text-zinc-400 border-b border-zinc-100 bg-zinc-50/95">
                                <th class="py-3 px-4">Période</th>
                                <th class="py-3 px-4">Lieu</th>
                                <th class="py-3 px-4">Mode</th>
                                <th class="py-3 px-4">Capacité</th>
                                <th class="py-3 px-4">Statut</th>
                                <th class="py-3 px-4">Mon Taux Présence</th>
                                <th class="py-3 px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for session in sessions %}
                            <tr class="decision-row border-b border-zinc-50 align-top">
                                <td class="py-3 px-4">
                                    <p class="text-[13px] font-medium text-zinc-700">{{ session.dateDebut|date('d M Y') }}</p>
                                    <p class="text-[11px] text-zinc-400">au {{ session.dateFin|date('d M Y') }}</p>
                                </td>
                                <td class="py-3 px-4 font-semibold text-zinc-700">{{ session.lieu }}</td>
                                <td class="py-3 px-4">
                                    <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded">{{ session.mode }}</span>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex flex-col">
                                        <span class="font-bold text-zinc-800 font-mono-num">{{ max(0, session.capaciteMax - session.acceptedCount) }} / {{ session.capaciteMax }}</span>
                                        <span class="text-[10px] text-zinc-400 font-semibold uppercase tracking-wider">places dispo</span>
                                    </div>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold
                                        {% if session.statut == 'Planifiee' %}bg-blue-50 text-blue-700 border border-blue-200{% endif %}
                                        {% if session.statut == 'En cours' %}bg-amber-50 text-amber-700 border border-amber-200{% endif %}
                                        {% if session.statut == 'Terminee' %}bg-emerald-50 text-emerald-700 border border-emerald-200{% endif %}
                                        {% if session.statut == 'Annulee' %}bg-red-50 text-red-700 border border-red-200{% endif %}">
                                        <span class="w-1.5 h-1.5 rounded-full
                                            {% if session.statut == 'Planifiee' %}bg-blue-500{% endif %}
                                            {% if session.statut == 'En cours' %}bg-amber-500{% endif %}
                                            {% if session.statut == 'Terminee' %}bg-emerald-500{% endif %}
                                            {% if session.statut == 'Annulee' %}bg-red-500{% endif %}"></span>
                                        {{ session.statut }}
                                    </span>
                                </td>
                                <td class="py-3 px-4">
                                    {% if mySessionStats is defined and mySessionStats[session.id] is defined and mySessionStats[session.id].statut == 'Accepte' %}
                                        <div class="flex items-center gap-2">
                                            <div class="w-14 bg-zinc-200 rounded-full h-1.5 overflow-hidden">
                                                <div class="bg-teal-500 h-1.5 rounded-full" style="width: {{ mySessionStats[session.id].pourcentage }}%"></div>
                                            </div>
                                            <span class="text-xs font-semibold text-zinc-600">{{ mySessionStats[session.id].pourcentage }}%</span>
                                        </div>
                                    {% else %}
                                        <span class="text-xs text-zinc-400">-</span>
                                    {% endif %}
                                </td>
                                <td class="py-3 px-4">
                                        {# 1. On vérifie d'abord si l'employé est déjà inscrit #}
                                        {% if mySessionStats is defined and mySessionStats[session.id] is defined %}
                                            {% set p_statut = mySessionStats[session.id].statut %}
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold
                                                {% if p_statut == 'Inscrit' %}bg-amber-50 text-amber-700 border border-amber-200
                                                {% elseif p_statut == 'Accepte' %}bg-emerald-50 text-emerald-700 border border-emerald-200
                                                {% elseif p_statut == 'Refuse' %}bg-red-50 text-red-700 border border-red-200
                                                {% elseif p_statut == 'Certificat obtenu' %}bg-purple-50 text-purple-700 border border-purple-200
                                                {% else %}bg-gray-50 text-gray-700 border border-gray-200{% endif %}">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                    {% if p_statut == 'Refuse' %}
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                                    {% elseif p_statut == 'Inscrit' %}
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                    {% else %}
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                                    {% endif %}
                                                </svg>
                                                {% if p_statut == 'Inscrit' %}En attente{% else %}{{ p_statut }}{% endif %}
                                            </span>

                                        {# 2. Si pas inscrit, on vérifie si la session est ouverte à l'inscription (Planifiée) #}
                                        {% elseif session.statut == 'Planifiee' %}
                                            {% if session.acceptedCount >= session.capaciteMax %}
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-red-50 text-red-700 border border-red-200">
                                                    Session Complète
                                                </span>
                                            {% else %}
                                                <form method="post" action="{{ path('employee_formation_register', {id: session.id}) }}" class="inline">
                                                    <button type="submit" class="text-indigo-600 hover:text-indigo-800 text-xs font-medium flex items-center gap-1 px-3 py-1.5 rounded-lg border border-indigo-200 bg-indigo-50 hover:bg-indigo-100 transition-colors">
                                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/>
                                                        </svg>
                                                        S'inscrire
                                                    </button>
                                                </form>
                                            {% endif %}

                                        {# 3. Sinon, on affiche que ce n'est pas disponible (session en cours, terminée ou annulée) #}
                                        {% else %}
                                            <span class="text-[11px] text-zinc-400">Non disponible</span>
                                        {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="7" class="py-14 text-center text-zinc-400 text-sm">Aucune session programmée pour cette formation.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
</div>
{% endblock %}
