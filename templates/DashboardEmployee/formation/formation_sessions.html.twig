{% extends 'base.html.twig' %}

{% block title %}Sessions de {{ formation.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-dark: #022E69;
            --primary-blue: #145EB7;
            --accent-blue: #3FA9F5;
            --border-gray: #D0D0D0;
        }

        .session-card{transition:transform .2s, box-shadow .2s}
        .session-card:hover{transform:translateY(-2px); box-shadow:0 18px 40px -20px rgba(2, 46, 105, .35)}
        .mono-num{font-variant-numeric:tabular-nums}

        .btn-primary{
            background: var(--primary-blue);
            color: #fff;
        }
        .btn-primary:hover{background: var(--primary-dark)}

        .hf-modal-overlay{position:fixed;inset:0;background:rgba(2,46,105,.45);display:flex;align-items:center;justify-content:center;z-index:9999;padding:1rem}
        .hf-modal{width:min(520px,100%);background:#fff;border:1px solid #D0D0D0;border-radius:16px;box-shadow:0 24px 60px -22px rgba(2,46,105,.45);overflow:hidden}
        .hf-modal-head{background:#022E69;color:#fff;padding:14px 18px;display:flex;align-items:center;justify-content:space-between}
        .hf-modal-title{font-weight:800;font-size:14px;letter-spacing:.02em}
        .hf-modal-close{background:transparent;border:0;color:#fff;font-size:18px;line-height:1;cursor:pointer}
        .hf-modal-body{padding:18px;color:#1f2937}
        .hf-modal-actions{padding:0 18px 18px;display:flex;justify-content:flex-end}
        .hf-modal-btn{border:1px solid #145EB7;background:#145EB7;color:#fff;padding:8px 14px;border-radius:10px;font-weight:700;font-size:13px;cursor:pointer;transition:.15s}
        .hf-modal-btn:hover{background:#3FA9F5;border-color:#3FA9F5}
        .hf-modal-badge{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;padding:4px 9px;border-radius:999px;border:1px solid #D0D0D0}
        .hf-modal-badge.error{background:#fff5f5;color:#b42318;border-color:#f4c7c7}
        .hf-modal-badge.success{background:#effaf6;color:#067647;border-color:#b7ebcf}
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardEmployee/components/_header.html.twig' %}

        {% set successFlashes = app.flashes('success') %}
        {% set errorFlashes = app.flashes('error') %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            <div class="mb-6">
                <a href="{{ path('employee_formation_index') }}" class="inline-flex items-center gap-2 text-zinc-600 hover:text-zinc-800 text-sm font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour au catalogue
                </a>
            </div>

            {% set formationTypeStyles = {
                'Technique': 'background:#dbeafe;color:#1e3a8a;border:1px solid #93c5fd;',
                'Soft Skills': 'background:#fce7f3;color:#9d174d;border:1px solid #f9a8d4;',
                'Management': 'background:#ede9fe;color:#5b21b6;border:1px solid #c4b5fd;',
                'Leadership': 'background:#cffafe;color:#155e75;border:1px solid #67e8f9;',
                'Langues': 'background:#ffedd5;color:#9a3412;border:1px solid #fdba74;',
                'Qualité': 'background:#fef9c3;color:#854d0e;border:1px solid #fde047;',
                'Sécurité': 'background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;',
                'Conformité': 'background:#e0e7ff;color:#3730a3;border:1px solid #a5b4fc;',
                'Bureautique': 'background:#f3e8ff;color:#7e22ce;border:1px solid #d8b4fe;',
                'Finance': 'background:#dcfce7;color:#166534;border:1px solid #86efac;',
                'RH': 'background:#e0f2fe;color:#075985;border:1px solid #7dd3fc;',
                'Digital': 'background:#ccfbf1;color:#0f766e;border:1px solid #5eead4;',
                'Autre': 'background:#f3f4f6;color:#374151;border:1px solid #d1d5db;'
            } %}
            {% set typeStyle = formationTypeStyles[formation.type]|default('background:#f3f4f6;color:#374151;border:1px solid #d1d5db;') %}

            {# ══════════ Hero Banner ══════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-sky-900 to-indigo-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-sky-300/15 blur-3xl mesh-blob"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-300/15 blur-3xl mesh-blob-alt"></div>
                <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                        <span class="text-[11px] font-bold text-cyan-200 uppercase tracking-wider">Sessions Disponibles</span>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">{{ formation.titre }}</h2>
                    <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">{{ formation.description }}</p>
                    <div class="mt-4 flex items-center gap-4 text-sm flex-wrap">
                        <span class="px-3 py-1 rounded-full font-semibold" style="{{ typeStyle }}">{{ formation.type }}</span>
                        <span class="text-cyan-200">{{ formation.duree }} Jours</span>
                        <span class="text-slate-400">•</span>
                        <span class="text-slate-300">{{ formation.organisme }}</span>
                    </div>
                </div>
            </section>

            {# ══════════ Sessions Cards ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center">
                            <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Sessions Programmées</h3>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                    {% for session in sessions %}
                        {% set occupees = session.acceptedCount|default(0) %}
                        {% set dispo = max(0, session.capaciteMax - occupees) %}
                        {% set modeNormalized = session.mode|lower %}
                        {% set modeBadgeClass = modeNormalized starts with 'en ligne'
                            ? 'bg-indigo-100 text-indigo-800 border border-indigo-300'
                            : (modeNormalized starts with 'presentiel'
                                ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                                : 'bg-violet-50 text-violet-700 border border-violet-200') %}

                        <article class="session-card group rounded-2xl border border-zinc-100 dark:border-zinc-800/60 bg-gradient-to-b from-white to-zinc-50/40 dark:from-zinc-950 dark:to-zinc-900 p-5">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <p class="text-[11px] font-extrabold uppercase tracking-wider text-zinc-400">Période</p>
                                    <p class="mt-1 text-[15px] font-bold text-zinc-900 dark:text-zinc-100 mono-num">{{ session.dateDebut|date('d M Y') }}</p>
                                    <p class="text-[12px] text-zinc-500 mono-num">au {{ session.dateFin|date('d M Y') }}</p>
                                </div>

                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold shrink-0
                                    {% if session.statut == 'Planifiee' %}bg-blue-50 text-blue-700 border border-blue-200{% endif %}
                                    {% if session.statut == 'En cours' %}bg-amber-50 text-amber-700 border border-amber-200{% endif %}
                                    {% if session.statut == 'Terminee' %}bg-emerald-50 text-emerald-700 border border-emerald-200{% endif %}
                                    {% if session.statut == 'Annulee' %}bg-red-50 text-red-700 border border-red-200{% endif %}">
                                    <span class="w-1.5 h-1.5 rounded-full
                                        {% if session.statut == 'Planifiee' %}bg-blue-500{% endif %}
                                        {% if session.statut == 'En cours' %}bg-amber-500{% endif %}
                                        {% if session.statut == 'Terminee' %}bg-emerald-500{% endif %}
                                        {% if session.statut == 'Annulee' %}bg-red-500{% endif %}"></span>
                                    {{ session.statut }}
                                </span>
                            </div>

                            <div class="mt-4 grid grid-cols-2 gap-3">
                                <div class="rounded-xl bg-white/70 dark:bg-zinc-950/60 border border-zinc-100/70 dark:border-zinc-800/60 p-3">
                                    <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">{{ session.mode|lower == 'en ligne' ? 'Lien' : 'Lieu' }}</p>
                                    {% set sessionStatut = mySessionStats is defined and mySessionStats[session.id] is defined ? mySessionStats[session.id].statut : null %}
                                    {% set isAcceptedEmployee = sessionStatut == 'Accepte' or sessionStatut == 'Certificat obtenu' %}
                                    {% set isHttpLink = session.lieu and (session.lieu matches '/^https?:\\/\\//i') %}

                                    {% if isHttpLink %}
                                        {% if isAcceptedEmployee %}
                                            <a href="{{ session.lieu }}" target="_blank" rel="noopener noreferrer" class="mt-1 inline-flex items-center gap-1.5 text-[13px] font-semibold text-[#145EB7] hover:text-[#3FA9F5] underline break-all">
                                                Ouvrir le lien
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M15 13.5V18a2 2 0 01-2 2H6a2 2 0 01-2-2v-7a2 2 0 012-2h4.5"/></svg>
                                            </a>
                                        {% else %}
                                            <p class="mt-1 text-[12px] font-medium text-zinc-500">Lien disponible apres validation de votre inscription.</p>
                                        {% endif %}
                                    {% else %}
                                        <p class="mt-1 text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 line-clamp-2">{{ session.lieu ?: '—' }}</p>
                                    {% endif %}
                                </div>

                                <div class="rounded-xl bg-white/70 dark:bg-zinc-950/60 border border-zinc-100/70 dark:border-zinc-800/60 p-3">
                                    <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">Mode</p>
                                    <div class="mt-1">
                                        <span class="inline-flex text-xs font-bold px-2.5 py-0.5 rounded-lg {{ modeBadgeClass }}">{{ session.mode }}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 rounded-xl border border-zinc-100 dark:border-zinc-800/60 bg-white/60 dark:bg-zinc-950/50 p-4">
                                <div class="flex items-center justify-between gap-4">
                                    <div>
                                        <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">Capacité</p>
                                        <p class="mt-1 font-extrabold text-zinc-900 dark:text-zinc-100 mono-num">{{ dispo }} / {{ session.capaciteMax }}</p>
                                        <p class="text-[10px] text-zinc-400 font-semibold uppercase tracking-wider">places dispo</p>
                                    </div>
                                    <div class="w-16">
                                        {% set percent = session.capaciteMax > 0 ? ((dispo / session.capaciteMax) * 100) : 0 %}
                                        <div class="h-2 rounded-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden">
                                            <div class="h-2 rounded-full" style="background: var(--accent-blue); width: {{ percent }}%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 rounded-xl border border-zinc-100 dark:border-zinc-800/60 bg-white/50 dark:bg-zinc-950/40 p-4">
                                <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">Mon taux de présence</p>
                                {% if mySessionStats is defined and mySessionStats[session.id] is defined and mySessionStats[session.id].statut == 'Accepte' %}
                                    <div class="mt-2 flex items-center gap-2">
                                        <div class="flex-1 bg-zinc-200 dark:bg-zinc-800 rounded-full h-2 overflow-hidden">
                                            <div class="h-2 rounded-full" style="background: var(--accent-blue); width: {{ mySessionStats[session.id].pourcentage }}%"></div>
                                        </div>
                                        <span class="text-xs font-semibold text-zinc-600 dark:text-zinc-300 mono-num">{{ mySessionStats[session.id].pourcentage }}%</span>
                                    </div>
                                {% else %}
                                    <p class="mt-2 text-xs text-zinc-400">-</p>
                                {% endif %}
                            </div>

                            <div class="mt-4 flex flex-wrap items-center gap-2">
                                {# 1) Déjà inscrit #}
                                {% if mySessionStats is defined and mySessionStats[session.id] is defined %}
                                    {% set p_statut = mySessionStats[session.id].statut %}
                                    <span class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-[11px] font-extrabold
                                        {% if p_statut == 'Inscrit' %}bg-amber-50 text-amber-700 border border-amber-200
                                        {% elseif p_statut == 'Accepte' %}bg-emerald-50 text-emerald-700 border border-emerald-200
                                        {% elseif p_statut == 'Refuse' %}bg-red-50 text-red-700 border border-red-200
                                        {% elseif p_statut == 'Certificat obtenu' %}bg-purple-50 text-purple-700 border border-purple-200
                                        {% else %}bg-gray-50 text-gray-700 border border-gray-200{% endif %}">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                            {% if p_statut == 'Refuse' %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                                            {% elseif p_statut == 'Inscrit' %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            {% else %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                                            {% endif %}
                                        </svg>
                                        {% if p_statut == 'Inscrit' %}En attente{% else %}{{ p_statut }}{% endif %}
                                    </span>

                                {# 2) Inscription possible si Planifiée #}
                                {% elseif session.statut == 'Planifiee' %}
                                    {% if occupees >= session.capaciteMax %}
                                        <span class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-[11px] font-extrabold bg-red-50 text-red-700 border border-red-200">
                                            Session complète
                                        </span>
                                    {% else %}
                                        <form method="post" action="{{ path('employee_formation_register', {id: session.id}) }}" class="inline">
                                            <button type="submit" class="btn-primary px-3 py-2 rounded-xl text-xs font-extrabold inline-flex items-center gap-2 transition">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                                                S'inscrire
                                            </button>
                                        </form>
                                    {% endif %}
                                {% else %}
                                    <span class="text-[11px] text-zinc-400">Non disponible</span>
                                {% endif %}
                            </div>

                            {% set canFeedback = mySessionStats is defined and mySessionStats[session.id] is defined and mySessionStats[session.id].statut == 'Accepte' and session.statut == 'Terminee' %}
                            {% if canFeedback %}
                                <div class="mt-3 rounded-xl border border-zinc-200 bg-white p-3">
                                    {% if feedbackGivenBySession[session.id]|default(false) %}
                                        <p class="text-xs font-semibold text-emerald-700">Feedback deja envoye pour cette session.</p>
                                    {% else %}
                                        <details>
                                            <summary class="cursor-pointer text-xs font-bold text-[#145EB7]">Donner mon feedback</summary>
                                            <form method="post" action="{{ path('employee_formation_feedback_submit', {id: session.id}) }}" class="mt-3 space-y-3">
                                                <input type="hidden" name="_token" value="{{ csrf_token('feedback-session-' ~ session.id) }}">
                                                <div>
                                                    <label class="text-[11px] font-semibold text-zinc-600">Note (etoiles)</label>
                                                    <select name="rating" class="mt-1 w-full rounded-lg border-zinc-300 text-sm" required>
                                                        <option value="">Choisir une note</option>
                                                        <option value="5">5 - Excellent</option>
                                                        <option value="4">4 - Tres bien</option>
                                                        <option value="3">3 - Bien</option>
                                                        <option value="2">2 - Moyen</option>
                                                        <option value="1">1 - Faible</option>
                                                    </select>
                                                </div>
                                                <div>
                                                    <label class="text-[11px] font-semibold text-zinc-600">Commentaire</label>
                                                    <textarea name="comment" rows="3" class="mt-1 w-full rounded-lg border-zinc-300 text-sm" required></textarea>
                                                </div>
                                                <label class="inline-flex items-center gap-2 text-xs text-zinc-600">
                                                    <input type="checkbox" name="is_anonymous" value="1" class="rounded border-zinc-300 text-[#145EB7]">
                                                    Publier en anonyme
                                                </label>
                                                <button type="submit" class="w-full px-3 py-2 rounded-lg bg-[#145EB7] text-white text-xs font-bold hover:bg-[#3FA9F5] transition-colors">Envoyer mon feedback</button>
                                            </form>
                                        </details>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </article>
                    {% else %}
                        <div class="col-span-full">
                            <div class="rounded-2xl border border-dashed border-zinc-200 dark:border-zinc-800 p-10 text-center bg-white/60 dark:bg-zinc-950/30">
                                <p class="text-zinc-500 font-medium">Aucune session programmée pour cette formation.</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        </main>
    </div>
</div>

<script>
(function () {
    var successMessages = {{ successFlashes|json_encode|raw }};
    var errorMessages = {{ errorFlashes|json_encode|raw }};
    var queue = [];

    successMessages.forEach(function (message) {
        queue.push({ type: 'success', message: message });
    });
    errorMessages.forEach(function (message) {
        queue.push({ type: 'error', message: message });
    });

    function closeModal() {
        var overlay = document.getElementById('hf-modal-overlay');
        if (overlay) {
            overlay.remove();
        }
        if (queue.length > 0) {
            showNext();
        }
    }

    function showNext() {
        if (queue.length === 0 || document.getElementById('hf-modal-overlay')) return;

        var data = queue.shift();
        var label = data.type === 'error' ? 'Erreur' : 'Succes';

        var overlay = document.createElement('div');
        overlay.id = 'hf-modal-overlay';
        overlay.className = 'hf-modal-overlay';
        overlay.innerHTML =
            '<div class="hf-modal" role="dialog" aria-modal="true" aria-label="Notification">' +
                '<div class="hf-modal-head">' +
                    '<span class="hf-modal-title">Notification</span>' +
                    '<button type="button" class="hf-modal-close" aria-label="Fermer">&times;</button>' +
                '</div>' +
                '<div class="hf-modal-body">' +
                    '<span class="hf-modal-badge ' + data.type + '">' + label + '</span>' +
                    '<p style="margin-top:12px;font-size:14px;line-height:1.55;white-space:pre-line;">' + String(data.message).replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</p>' +
                '</div>' +
                '<div class="hf-modal-actions">' +
                    '<button type="button" class="hf-modal-btn">OK</button>' +
                '</div>' +
            '</div>';

        document.body.appendChild(overlay);

        overlay.addEventListener('click', function (event) {
            if (event.target === overlay) {
                closeModal();
            }
        });
        overlay.querySelector('.hf-modal-close').addEventListener('click', closeModal);
        overlay.querySelector('.hf-modal-btn').addEventListener('click', closeModal);
    }

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && document.getElementById('hf-modal-overlay')) {
            closeModal();
        }
    });

    showNext();
})();
</script>
{% endblock %}
