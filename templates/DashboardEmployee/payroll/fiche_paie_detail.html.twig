{% extends "base.html.twig" %}

{% block title %}Fiche de Paie — Détail{% endblock %}

{% set months = {1:'Janvier',2:'Février',3:'Mars',4:'Avril',5:'Mai',6:'Juin',7:'Juillet',8:'Août',9:'Septembre',10:'Octobre',11:'Novembre',12:'Décembre'} %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}
    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardEmployee/components/_header.html.twig' %}
        <main class="p-6 lg:p-8 max-w-[1440px] mx-auto space-y-8">

            {# ═══ HERO BANNER ═══ #}
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-teal-950 to-sky-900 p-8 sm:p-10 text-white animate-slide-up">
                <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-teal-500/15 blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-32 -left-20 w-96 h-96 rounded-full bg-sky-500/10 blur-3xl pointer-events-none"></div>
                <div class="relative z-10">
                    <a href="{{ path('app_employee_payroll_fiches') }}"
                       class="inline-flex items-center gap-1 text-teal-300 hover:text-white text-xs font-semibold mb-4 transition-colors">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                        Retour aux fiches
                    </a>                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></div>
                        <span class="text-[11px] font-bold text-teal-300 uppercase tracking-[0.15em]">Bulletin de Salaire</span>
                    </div>
                    <h1 class="font-display text-4xl sm:text-5xl leading-[1.1] tracking-tight text-white mb-1">
                        {{ months[fiche.mois] ?? fiche.mois }} {{ fiche.annee }}
                    </h1>
                    <p class="text-teal-200/80 text-[15px]">{{ fiche.employeeName }}</p>
                </div>
                <div class="relative z-10 mt-5 flex items-center gap-3">
                    {% if fiche.statutPaiement %}
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>Salaire Versé
                        </span>
                    {% else %}
                        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-500/20 border border-amber-400/30 text-amber-300 text-xs font-bold">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>En Attente de Versement
                        </span>
                    {% endif %}
                    <a href="{{ path('app_employee_payroll_fiche_pdf', {id: fiche.id}) }}"
                       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white text-sm font-semibold transition-all">
                        <svg class="w-4 h-4 text-rose-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                        Télécharger PDF
                    </a>
                </div>
            </div>

            {# ═══ SALARY STAT CARDS ═══ #}
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 animate-slide-up stagger-1">
                <div class="card-surface stat-stripe stat-stripe-sky p-5 group">
                    <p class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em] mb-2">Salaire Brut</p>
                    <p class="text-3xl font-extrabold font-mono-num leading-none text-zinc-900 dark:text-white">{{ fiche.salaireBrut }}</p>
                    <p class="text-xs text-zinc-400 mt-1">TND</p>
                </div>
                <div class="card-surface stat-stripe stat-stripe-emerald p-5 group">
                    <p class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em] mb-2">Total Primes</p>
                    <p class="text-3xl font-extrabold font-mono-num leading-none text-emerald-600 dark:text-emerald-400">+{{ fiche.totalPrimes }}</p>
                    <p class="text-xs text-zinc-400 mt-1">TND</p>
                </div>
                <div class="card-surface stat-stripe stat-stripe-amber p-5 group">
                    <p class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em] mb-2">Total Déductions</p>
                    <p class="text-3xl font-extrabold font-mono-num leading-none text-orange-600 dark:text-orange-400">-{{ fiche.totalDeductions }}</p>
                    <p class="text-xs text-zinc-400 mt-1">TND</p>
                </div>
                <div class="card-surface stat-stripe stat-stripe-teal p-5 group">
                    <p class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em] mb-2">Salaire Net</p>
                    <p class="text-3xl font-extrabold font-mono-num leading-none text-teal-700 dark:text-teal-300">{{ fiche.salaireNet }}</p>
                    <p class="text-xs text-zinc-400 mt-1">TND</p>
                </div>
            </div>

            {# ═══ MAIN GRID: PRIMES + DEDUCTIONS / SIDEBAR ═══ #}
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 animate-slide-up stagger-2">

                {# ── LEFT: primes & deductions tables ── #}
                <div class="lg:col-span-2 space-y-6">

                    {# Primes Table #}
                    <div class="card-surface rounded-2xl overflow-hidden">
                        <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800 flex items-center gap-2">
                            <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
                            <span class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.15em]">Primes du mois</span>
                        </div>
                        {% if primes %}
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-zinc-100 dark:border-zinc-800">
                                        <th class="px-6 py-3 text-left text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Type</th>
                                        <th class="px-6 py-3 text-left text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Motif</th>
                                        <th class="px-6 py-3 text-right text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Montant</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
                                    {% for prime in primes %}
                                        <tr class="row-refined">
                                            <td class="px-6 py-3 font-semibold text-zinc-900 dark:text-white">{{ prime.typePrime.value }}</td>
                                            <td class="px-6 py-3 text-sm text-zinc-500 dark:text-zinc-400">{{ prime.motif ?? '—' }}</td>
                                            <td class="px-6 py-3 text-right font-mono-num font-bold text-emerald-600 dark:text-emerald-400">+{{ prime.montant }} <span class="text-xs text-emerald-400/70">TND</span></td>
                                        </tr>
                                    {% endfor %}
                                    <tr class="bg-emerald-50 dark:bg-emerald-500/10">
                                        <td colspan="2" class="px-6 py-3 font-bold text-zinc-700 dark:text-zinc-200 text-sm">Total Primes</td>
                                        <td class="px-6 py-3 text-right font-mono-num font-extrabold text-emerald-600 dark:text-emerald-400">{{ fiche.totalPrimes }} <span class="text-xs">TND</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        {% else %}
                            <div class="px-6 py-10 text-center text-zinc-400 dark:text-zinc-500">
                                <p class="text-sm italic">Aucune prime pour cette période.</p>
                            </div>
                        {% endif %}
                    </div>

                    {# Deductions Table #}
                    <div class="card-surface rounded-2xl overflow-hidden">
                        <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800 flex items-center gap-2">
                            <div class="w-2 h-2 rounded-full bg-orange-500"></div>
                            <span class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.15em]">Déductions du mois</span>
                        </div>
                        {% if deductions %}
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-zinc-100 dark:border-zinc-800">
                                        <th class="px-6 py-3 text-left text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Type</th>
                                        <th class="px-6 py-3 text-left text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Motif</th>
                                        <th class="px-6 py-3 text-right text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Montant</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
                                    {% for deduction in deductions %}
                                        <tr class="row-refined">
                                            <td class="px-6 py-3 font-semibold text-zinc-900 dark:text-white">{{ deduction.typeDeduction.value }}</td>
                                            <td class="px-6 py-3 text-sm text-zinc-500 dark:text-zinc-400">{{ deduction.motif ?? '—' }}</td>
                                            <td class="px-6 py-3 text-right font-mono-num font-bold text-orange-600 dark:text-orange-400">-{{ deduction.montant }} <span class="text-xs text-orange-400/70">TND</span></td>
                                        </tr>
                                    {% endfor %}
                                    <tr class="bg-orange-50 dark:bg-orange-500/10">
                                        <td colspan="2" class="px-6 py-3 font-bold text-zinc-700 dark:text-zinc-200 text-sm">Total Déductions</td>
                                        <td class="px-6 py-3 text-right font-mono-num font-extrabold text-orange-600 dark:text-orange-400">{{ fiche.totalDeductions }} <span class="text-xs">TND</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        {% else %}
                            <div class="px-6 py-10 text-center text-zinc-400 dark:text-zinc-500">
                                <p class="text-sm italic">Aucune déduction pour cette période.</p>
                            </div>
                        {% endif %}
                    </div>

                </div>

                {# ── RIGHT: summary sidebar ── #}
                <div class="lg:col-span-1">
                    <div class="card-surface rounded-2xl p-6 space-y-4 sticky top-24">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.15em]">Récapitulatif</span>
                        </div>

                        <div class="p-4 rounded-xl bg-sky-50 dark:bg-sky-500/10 border border-sky-100 dark:border-sky-500/20">
                            <p class="text-[11px] font-bold text-sky-600 dark:text-sky-400 uppercase tracking-[0.08em] mb-1">Salaire Brut</p>
                            <p class="text-2xl font-extrabold font-mono-num text-zinc-900 dark:text-white">{{ fiche.salaireBrut }} <span class="text-sm font-normal text-zinc-400">TND</span></p>
                        </div>

                        <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-100 dark:border-emerald-500/20 border-l-4 border-l-emerald-500">
                            <p class="text-[11px] font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-[0.08em] mb-1">+ Primes</p>
                            <p class="text-2xl font-extrabold font-mono-num text-emerald-600 dark:text-emerald-400">{{ fiche.totalPrimes }} <span class="text-sm font-normal text-zinc-400">TND</span></p>
                        </div>

                        <div class="p-4 rounded-xl bg-orange-50 dark:bg-orange-500/10 border border-orange-100 dark:border-orange-500/20 border-l-4 border-l-orange-500">
                            <p class="text-[11px] font-bold text-orange-600 dark:text-orange-400 uppercase tracking-[0.08em] mb-1">− Déductions</p>
                            <p class="text-2xl font-extrabold font-mono-num text-orange-600 dark:text-orange-400">{{ fiche.totalDeductions }} <span class="text-sm font-normal text-zinc-400">TND</span></p>
                        </div>

                        <div class="p-4 rounded-xl bg-teal-50 dark:bg-teal-500/10 border-2 border-teal-300 dark:border-teal-500/40">
                            <p class="text-[11px] font-bold text-teal-600 dark:text-teal-400 uppercase tracking-[0.08em] mb-1">Salaire Net à Recevoir</p>
                            <p class="text-3xl font-extrabold font-mono-num text-teal-700 dark:text-teal-300">{{ fiche.salaireNet }} <span class="text-sm font-normal text-zinc-400">TND</span></p>
                        </div>

                        {% if fiche.notes %}
                        <div class="pt-2 border-t border-zinc-100 dark:border-zinc-800">
                            <p class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em] mb-1">Notes</p>
                            <p class="text-sm text-zinc-600 dark:text-zinc-300 italic">{{ fiche.notes }}</p>
                        </div>
                        {% endif %}
                    </div>
                </div>

            </div>

        </main>
    </div>
</div>
{% endblock %}
