{% extends "base.html.twig" %}

{% block title %}Mes Déductions{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 dark:from-zinc-900 dark:to-zinc-800 py-8 px-4">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-slate-900 dark:text-white mb-2">Mes Déductions</h1>
            <p class="text-slate-600 dark:text-slate-400">Visualisez toutes les déductions appliquées</p>
        </div>

        <!-- Deductions Table -->
        <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-50 dark:bg-zinc-700 border-b border-slate-200 dark:border-zinc-600">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Type</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Motif</th>
                            <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Montant</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Date</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-zinc-600">
                        {% for deduction in deductions %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-zinc-700 transition-colors">
                                <td class="px-6 py-4 text-slate-900 dark:text-white font-semibold">{{ deduction.typeDeduction }}</td>
                                <td class="px-6 py-4 text-slate-600 dark:text-slate-400 text-sm">{{ deduction.motif ?? '—' }}</td>
                                <td class="px-6 py-4 text-right text-orange-600 font-bold text-lg">{{ deduction.montant }} TND</td>
                                <td class="px-6 py-4 text-slate-600 dark:text-slate-400">{{ deduction.dateDeduction|date('d/m/Y') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="px-6 py-12 text-center text-slate-600 dark:text-slate-400">
                                    <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17H3v-2h10v2zm-2-4H3v-2h8v2zm4-4H3V7h12v2z"/>
                                    </svg>
                                    <p class="text-lg font-semibold">Aucune déduction appliquée</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Total Deductions Card -->
        {% if deductions|length > 0 %}
            <div class="mt-6 bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-900/50 rounded-lg p-6">
                <p class="text-orange-700 dark:text-orange-400 text-sm font-semibold">TOTAL DÉDUCTIONS</p>
                <p class="text-4xl font-bold text-orange-600 mt-2">{{ totalDeductions }} TND</p>
            </div>
        {% endif %}

        <!-- Navigation Links -->
        <div class="flex gap-4 mt-8">
            <a href="{{ path('app_employee_payroll_fiches') }}" class="px-6 py-3 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-semibold transition-all">
                Mes Fiches de Paie
            </a>
            <a href="{{ path('app_employee_payroll_primes') }}" class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-semibold transition-all">
                Mes Primes
            </a>
        </div>
    </div>
</div>
{% endblock %}
