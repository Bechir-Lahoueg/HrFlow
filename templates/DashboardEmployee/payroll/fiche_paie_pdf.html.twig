{% set months = {1:'Janvier',2:'Février',3:'Mars',4:'Avril',5:'Mai',6:'Juin',7:'Juillet',8:'Août',9:'Septembre',10:'Octobre',11:'Novembre',12:'Décembre'} %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Bulletin de Paie — {{ months[fiche.mois] }} {{ fiche.annee }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: Arial, Helvetica, sans-serif;
            font-size: 11px;
            color: #1e293b;
            background: #ffffff;
        }

        /* â•â• TOP ACCENT BAR â•â• */
        .accent-bar {
            height: 5px;
            background: #0d9488;
        }

        /* â•â• HEADER â•â• */
        .header {
            background: #0f172a;
            color: #fff;
            padding: 22px 36px 18px;
        }
        .header-table { width: 100%; border-collapse: collapse; }
        .header-table td { vertical-align: top; padding: 0; border: none; }
        .header-table td.right-col { text-align: right; }

        .logo-name {
            font-size: 26px;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.5px;
            line-height: 1;
        }
        .logo-sub {
            font-size: 9px;
            color: #5eead4;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-top: 5px;
        }
        .period-badge {
            display: inline-block;
            background: #134e4a;
            border: 1px solid #0d9488;
            border-radius: 6px;
            padding: 8px 18px;
            text-align: center;
        }
        .period-badge .label { font-size: 8px; color: #5eead4; text-transform: uppercase; letter-spacing: 2px; }
        .period-badge .value { font-size: 15px; font-weight: 700; color: #ffffff; margin-top: 3px; }

        /* â•â• INFO STRIP â•â• */
        .info-strip {
            background: #f8fafc;
            border-bottom: 2px solid #e2e8f0;
            padding: 0;
        }
        .info-strip table { width: 100%; border-collapse: collapse; }
        .info-strip td {
            padding: 12px 36px;
            border-right: 1px solid #e2e8f0;
            vertical-align: top;
        }
        .info-strip td:last-child { border-right: none; }
        .info-label { font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #94a3b8; margin-bottom: 3px; }
        .info-value { font-size: 12px; font-weight: 700; color: #0f172a; }

        /* â•â• STATUS BAR â•â• */
        .status-bar-paid    { background: #f0fdf4; border-bottom: 1px solid #bbf7d0; padding: 8px 36px; }
        .status-bar-pending { background: #fffbeb; border-bottom: 1px solid #fde68a; padding: 8px 36px; }
        .status-chip-paid    { font-size: 10px; font-weight: 700; color: #15803d; }
        .status-chip-pending { font-size: 10px; font-weight: 700; color: #b45309; }

        /* â•â• BODY â•â• */
        .body { padding: 24px 36px; }

        /* â•â• RECAP CARDS (table-based) â•â• */
        .recap-table { width: 100%; border-collapse: separate; border-spacing: 8px; margin-bottom: 20px; }
        .recap-cell {
            width: 25%;
            padding: 12px 14px;
            border-radius: 6px;
            border: 1px solid #e2e8f0;
            vertical-align: top;
        }
        .recap-cell.brut   { border-top: 3px solid #0ea5e9; background: #f0f9ff; }
        .recap-cell.primes { border-top: 3px solid #10b981; background: #f0fdf4; }
        .recap-cell.deduct { border-top: 3px solid #f97316; background: #fff7ed; }
        .recap-cell.net    { border-top: 3px solid #0d9488; background: #f0fdfa; }
        .recap-label { font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #64748b; }
        .recap-amount { font-size: 18px; font-weight: 700; margin-top: 5px; line-height: 1; }
        .recap-cell.brut   .recap-amount { color: #0369a1; }
        .recap-cell.primes .recap-amount { color: #047857; }
        .recap-cell.deduct .recap-amount { color: #c2410c; }
        .recap-cell.net    .recap-amount { color: #0f766e; }
        .recap-unit { font-size: 9px; color: #94a3b8; margin-top: 3px; }

        /* â•â• NET SALARY HIGHLIGHT â•â• */
        .net-highlight {
            background: #0f172a;
            border-radius: 8px;
            padding: 16px 20px;
            margin-bottom: 24px;
        }
        .net-highlight-table { width: 100%; border-collapse: collapse; }
        .net-highlight-table td { vertical-align: middle; border: none; padding: 0; }
        .net-hl-label { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; color: #5eead4; }
        .net-hl-name  { font-size: 13px; color: #94a3b8; margin-top: 3px; }
        .net-hl-amount { font-size: 32px; font-weight: 700; color: #ffffff; text-align: right; line-height: 1; }
        .net-hl-currency { font-size: 13px; color: #5eead4; font-weight: 400; }

        /* â•â• SECTION TITLES â•â• */
        .section-header {
            margin-bottom: 8px;
            padding-bottom: 6px;
            border-bottom: 2px solid #e2e8f0;
        }
        .section-header table { width: 100%; border-collapse: collapse; }
        .section-header td { vertical-align: middle; border: none; padding: 0; }
        .section-dot-teal   { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #0d9488; margin-right: 7px; vertical-align: middle; }
        .section-dot-orange { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #f97316; margin-right: 7px; vertical-align: middle; }
        .section-title-text {
            font-size: 10px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 1.5px; color: #334155; vertical-align: middle;
        }
        .section-count { font-size: 9px; color: #94a3b8; text-align: right; font-style: italic; }

        /* â•â• TABLES â•â• */
        .data-table { width: 100%; border-collapse: collapse; margin-bottom: 22px; font-size: 10px; }
        .data-table thead tr { background: #f1f5f9; }
        .data-table th {
            padding: 8px 10px; text-align: left;
            font-size: 8px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 1px; color: #64748b;
            border-bottom: 2px solid #cbd5e1;
        }
        .data-table th.right { text-align: right; }
        .data-table td { padding: 8px 10px; color: #334155; border-bottom: 1px solid #f1f5f9; }
        .data-table td.right { text-align: right; }
        .data-table tbody tr:nth-child(even) td { background: #f8fafc; }
        .data-table .total-row td {
            background: #f1f5f9 !important;
            font-weight: 700;
            border-top: 2px solid #cbd5e1;
            border-bottom: none;
            font-size: 11px;
        }
        .data-table .empty-row td { text-align: center; color: #94a3b8; font-style: italic; padding: 16px; }

        .badge-teal {
            display: inline-block;
            background: #ccfbf1; color: #0f766e;
            border-radius: 20px; padding: 2px 9px;
            font-size: 9px; font-weight: 700;
        }
        .badge-orange {
            display: inline-block;
            background: #fed7aa; color: #c2410c;
            border-radius: 20px; padding: 2px 9px;
            font-size: 9px; font-weight: 700;
        }
        .amount-positive { color: #047857; font-weight: 700; }
        .amount-negative { color: #c2410c; font-weight: 700; }

        /* â•â• NOTES â•â• */
        .notes-block {
            background: #f8fafc; border-left: 3px solid #94a3b8;
            border-radius: 4px; padding: 10px 14px; margin-bottom: 20px;
        }
        .notes-title { font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #94a3b8; margin-bottom: 5px; }
        .notes-text  { font-style: italic; color: #475569; font-size: 10px; line-height: 1.5; }

        /* ══ SIGNATURES ══ */
        .signature-wrap {
            margin-top: 18px;
            margin-bottom: 18px;
            border-top: 1px dashed #cbd5e1;
            padding-top: 12px;
        }
        .signature-table { width: 100%; border-collapse: collapse; }
        .signature-table td {
            width: 50%;
            vertical-align: top;
            border: none;
            padding: 0 12px;
        }
        .signature-label {
            font-size: 8px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #64748b;
            margin-bottom: 16px;
        }
        .signature-line {
            margin-top: 34px;
            border-top: 1px solid #94a3b8;
            padding-top: 6px;
            font-size: 9px;
            color: #475569;
            text-align: center;
        }

        /* â•â• FOOTER â•â• */
        .footer-wrap {
            background: #f8fafc;
            border-top: 2px solid #e2e8f0;
            padding: 12px 36px;
        }
        .footer-table { width: 100%; border-collapse: collapse; }
        .footer-table td { vertical-align: middle; border: none; padding: 0; font-size: 8px; color: #94a3b8; }
        .footer-table td.right { text-align: right; }
        .footer-strong { color: #475569; font-weight: 700; }
        .footer-ref { color: #0d9488; font-weight: 700; font-size: 9px; }
        .bottom-bar { height: 4px; background: #0d9488; }
    </style>
</head>
<body>

<div class="accent-bar"></div>

{# â•â• HEADER â•â• #}
<div class="header">
    <table class="header-table">
        <tr>
            <td>
                <div class="logo-name">HrFlow</div>
                <div class="logo-sub">Gestion des Ressources Humaines</div>
            </td>
            <td class="right-col">
                <div class="period-badge">
                    <div class="label">Bulletin de Paie</div>
                    <div class="value">{{ months[fiche.mois] ?? fiche.mois }} {{ fiche.annee }}</div>
                </div>
            </td>
        </tr>
    </table>
</div>

{# â•â• INFO STRIP â•â• #}
<div class="info-strip">
    <table>
        <tr>
            <td style="width:40%">
                <div class="info-label">Employé</div>
                <div class="info-value">{{ fiche.employeeName }}</div>
            </td>
            <td style="width:30%">
                <div class="info-label">Référence</div>
                <div class="info-value">#BP-{{ '%05d'|format(fiche.id) }}</div>
            </td>
            <td style="width:30%">
                <div class="info-label">Date d'émission</div>
                <div class="info-value">{{ "now"|date('d/m/Y') }}</div>
            </td>
        </tr>
    </table>
</div>

{# â•â• STATUS â•â• #}
{% if fiche.statutPaiement %}
<div class="status-bar-paid">
    <span class="status-chip-paid">&#10003;&nbsp; Salaire versé — paiement confirmé</span>
</div>
{% else %}
<div class="status-bar-pending">
    <span class="status-chip-pending">&#9679;&nbsp; En attente de versement</span>
</div>
{% endif %}

{# â•â• BODY â•â• #}
<div class="body">

    {# â”€â”€ RECAP CARDS â”€â”€ #}
    <table class="recap-table">
        <tr>
            <td class="recap-cell brut">
                <div class="recap-label">Salaire Brut</div>
                <div class="recap-amount">{{ fiche.salaireBrut }}</div>
                <div class="recap-unit">TND</div>
            </td>
            <td class="recap-cell primes">
                <div class="recap-label">+ Primes</div>
                <div class="recap-amount">{{ fiche.totalPrimes }}</div>
                <div class="recap-unit">TND</div>
            </td>
            <td class="recap-cell deduct">
                <div class="recap-label">− Déductions</div>
                <div class="recap-amount">{{ fiche.totalDeductions }}</div>
                <div class="recap-unit">TND</div>
            </td>
            <td class="recap-cell net">
                <div class="recap-label">Salaire Net</div>
                <div class="recap-amount">{{ fiche.salaireNet }}</div>
                <div class="recap-unit">TND</div>
            </td>
        </tr>
    </table>

    {# â”€â”€ NET HIGHLIGHT â”€â”€ #}
    <div class="net-highlight">
        <table class="net-highlight-table">
            <tr>
                <td>
                    <div class="net-hl-label">Salaire Net à Recevoir</div>
                    <div class="net-hl-name">{{ fiche.employeeName }} &mdash; {{ months[fiche.mois] ?? fiche.mois }} {{ fiche.annee }}</div>
                </td>
                <td>
                    <div class="net-hl-amount">{{ fiche.salaireNet }} <span class="net-hl-currency">TND</span></div>
                </td>
            </tr>
        </table>
    </div>

    {# â”€â”€ PRIMES TABLE â”€â”€ #}
    <div class="section-header">
        <table>
            <tr>
                <td><span class="section-dot-teal"></span><span class="section-title-text">Détail des Primes</span></td>
                <td><span class="section-count">{{ primes|length }} prime{{ primes|length != 1 ? 's' : '' }}</span></td>
            </tr>
        </table>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th style="width:35%">Type</th>
                <th style="width:45%">Motif</th>
                <th class="right" style="width:20%">Montant (TND)</th>
            </tr>
        </thead>
        <tbody>
            {% if primes %}
                {% for prime in primes %}
                    <tr>
                        <td><span class="badge-teal">{{ prime.typePrime.value }}</span></td>
                        <td>{{ prime.motif ?? '—' }}</td>
                        <td class="right amount-positive">+&nbsp;{{ prime.montant }}</td>
                    </tr>
                {% endfor %}
                <tr class="total-row">
                    <td colspan="2">Total Primes</td>
                    <td class="right amount-positive">+&nbsp;{{ fiche.totalPrimes }}</td>
                </tr>
            {% else %}
                <tr class="empty-row"><td colspan="3">Aucune prime pour cette période.</td></tr>
            {% endif %}
        </tbody>
    </table>

    {# â”€â”€ DEDUCTIONS TABLE â”€â”€ #}
    <div class="section-header">
        <table>
            <tr>
                <td><span class="section-dot-orange"></span><span class="section-title-text">Détail des Déductions</span></td>
                <td><span class="section-count">{{ deductions|length }} déduction{{ deductions|length != 1 ? 's' : '' }}</span></td>
            </tr>
        </table>
    </div>
    <table class="data-table">
        <thead>
            <tr>
                <th style="width:35%">Type</th>
                <th style="width:45%">Motif</th>
                <th class="right" style="width:20%">Montant (TND)</th>
            </tr>
        </thead>
        <tbody>
            {% if deductions %}
                {% for deduction in deductions %}
                    <tr>
                        <td><span class="badge-orange">{{ deduction.typeDeduction.value }}</span></td>
                        <td>{{ deduction.motif ?? '—' }}</td>
                        <td class="right amount-negative">-&nbsp;{{ deduction.montant }}</td>
                    </tr>
                {% endfor %}
                <tr class="total-row">
                    <td colspan="2">Total Déductions</td>
                    <td class="right amount-negative">-&nbsp;{{ fiche.totalDeductions }}</td>
                </tr>
            {% else %}
                <tr class="empty-row"><td colspan="3">Aucune déduction pour cette période.</td></tr>
            {% endif %}
        </tbody>
    </table>

    {% if fiche.notes %}
    <div class="notes-block">
        <div class="notes-title">Notes</div>
        <div class="notes-text">{{ fiche.notes }}</div>
    </div>
    {% endif %}

    <div class="signature-wrap">
        <table class="signature-table">
            <tr>
                <td>
                    <div class="signature-label">Signature Employe</div>
                    <div class="signature-line">{{ fiche.employeeName }}</div>
                </td>
                <td>
                    <div class="signature-label">Signature Responsable RH</div>
                    <div class="signature-line">HrFlow RH</div>
                </td>
            </tr>
        </table>
    </div>

</div>

{# â•â• FOOTER â•â• #}
<div class="footer-wrap">
    <table class="footer-table">
        <tr>
            <td>
                Document généré par <span class="footer-strong">HrFlow</span>
                le {{ "now"|date('d/m/Y') }} à {{ "now"|date('H:i') }}
            </td>
            <td class="right">
                <span class="footer-ref">Réf&nbsp;#BP-{{ '%05d'|format(fiche.id) }}</span>
                &nbsp;&mdash;&nbsp;Ce bulletin est à conserver à titre de justificatif.
            </td>
        </tr>
    </table>
</div>
<div class="bottom-bar"></div>

</body>
</html>
