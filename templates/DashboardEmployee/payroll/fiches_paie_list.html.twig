{% extends "base.html.twig" %}

{% block title %}Mes Fiches de Paie{% endblock %}

{% set months = {1:'Janvier',2:'Février',3:'Mars',4:'Avril',5:'Mai',6:'Juin',7:'Juillet',8:'Août',9:'Septembre',10:'Octobre',11:'Novembre',12:'Décembre'} %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}
    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardEmployee/components/_header.html.twig' %}
        <main class="p-6 lg:p-8 max-w-[1440px] mx-auto space-y-8">

            {# ═══ HERO BANNER ═══ #}
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-teal-950 to-sky-900 p-8 sm:p-10 text-white animate-slide-up">
                <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-teal-500/15 blur-3xl pointer-events-none"></div>
                <div class="absolute -bottom-32 -left-20 w-96 h-96 rounded-full bg-sky-500/10 blur-3xl pointer-events-none"></div>
                <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></div>
                        <span class="text-[11px] font-bold text-teal-300 uppercase tracking-[0.15em]">Espace Personnel</span>
                    </div>
                    <h1 class="font-display text-4xl sm:text-5xl leading-[1.1] tracking-tight text-white mb-2">Mes Fiches de Paie</h1>
                    <p class="text-teal-200/80 text-[15px] max-w-xl">Consultez l'historique de vos bulletins de salaire mensuels.</p>
                </div>
                <div class="relative z-10 flex gap-3 mt-6">
                    <a href="{{ path('app_employee_payroll_primes') }}"
                       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white text-sm font-semibold transition-all">
                        <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Mes Primes
                    </a>
                    <a href="{{ path('app_employee_payroll_deductions') }}"
                       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white text-sm font-semibold transition-all">
                        <svg class="w-4 h-4 text-orange-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Mes Déductions
                    </a>
                </div>
            </div>

            {# ═══ STATS STRIP ═══ #}
            {% if fiches|length > 0 %}
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 animate-slide-up stagger-1">
                <div class="card-surface stat-stripe stat-stripe-teal p-5 group">
                    <p class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em] mb-2">Bulletins</p>
                    <p class="text-3xl font-extrabold font-mono-num leading-none text-zinc-900 dark:text-white">{{ fiches|length }}</p>
                </div>
                <div class="card-surface stat-stripe stat-stripe-sky p-5 group">
                    <p class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em] mb-2">Dernier Net</p>
                    <p class="text-3xl font-extrabold font-mono-num leading-none text-zinc-900 dark:text-white">{{ fiches[0].salaireNet }}</p>
                    <p class="text-xs text-zinc-400 mt-1">TND</p>
                </div>
                <div class="card-surface stat-stripe stat-stripe-emerald p-5 group">
                    <p class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em] mb-2">Dernières Primes</p>
                    <p class="text-3xl font-extrabold font-mono-num leading-none text-zinc-900 dark:text-white">{{ fiches[0].totalPrimes }}</p>
                    <p class="text-xs text-zinc-400 mt-1">TND</p>
                </div>
                <div class="card-surface stat-stripe stat-stripe-amber p-5 group">
                    <p class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em] mb-2">Dernières Déductions</p>
                    <p class="text-3xl font-extrabold font-mono-num leading-none text-zinc-900 dark:text-white">{{ fiches[0].totalDeductions }}</p>
                    <p class="text-xs text-zinc-400 mt-1">TND</p>
                </div>
            </div>
            {% endif %}

            {# ═══ FICHES TABLE ═══ #}
            <div class="card-surface rounded-2xl overflow-hidden animate-slide-up stagger-2">
                <div class="px-6 py-5 border-b border-zinc-100 dark:border-zinc-800 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-teal-500 animate-pulse"></div>
                        <span class="text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.15em]">Historique</span>
                    </div>
                    <span class="text-xs text-zinc-400 font-mono-num">{{ fiches|length }} bulletin{{ fiches|length != 1 ? 's' : '' }}</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-zinc-100 dark:border-zinc-800">
                                <th class="px-6 py-3 text-left text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Mois</th>
                                <th class="px-6 py-3 text-left text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Année</th>
                                <th class="px-6 py-3 text-right text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Salaire Brut</th>
                                <th class="px-6 py-3 text-right text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Primes</th>
                                <th class="px-6 py-3 text-right text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Déductions</th>
                                <th class="px-6 py-3 text-right text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Salaire Net</th>
                                <th class="px-6 py-3 text-center text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]">Statut</th>
                                <th class="px-6 py-3 text-center text-[11px] font-bold text-zinc-500 dark:text-zinc-400 uppercase tracking-[0.08em]" colspan="2">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800">
                            {% for fiche in fiches %}
                                <tr class="row-refined">
                                    <td class="px-6 py-4 font-semibold text-zinc-900 dark:text-white">
                                        {{ months[fiche.mois] ?? fiche.mois }}
                                    </td>
                                    <td class="px-6 py-4 font-mono-num text-zinc-700 dark:text-zinc-300">{{ fiche.annee }}</td>
                                    <td class="px-6 py-4 text-right font-mono-num text-zinc-800 dark:text-zinc-200">{{ fiche.salaireBrut }} <span class="text-xs text-zinc-400">TND</span></td>
                                    <td class="px-6 py-4 text-right font-mono-num font-semibold text-emerald-600 dark:text-emerald-400">+{{ fiche.totalPrimes }} <span class="text-xs text-emerald-400/70">TND</span></td>
                                    <td class="px-6 py-4 text-right font-mono-num font-semibold text-orange-600 dark:text-orange-400">-{{ fiche.totalDeductions }} <span class="text-xs text-orange-400/70">TND</span></td>
                                    <td class="px-6 py-4 text-right font-mono-num font-bold text-teal-700 dark:text-teal-300 text-[15px]">{{ fiche.salaireNet }} <span class="text-xs text-teal-400/70">TND</span></td>
                                    <td class="px-6 py-4 text-center">
                                        {% if fiche.statutPaiement %}
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 dark:bg-emerald-500/15 text-emerald-700 dark:text-emerald-400">
                                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>Payé
                                            </span>
                                        {% else %}
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 dark:bg-amber-500/15 text-amber-700 dark:text-amber-400">
                                                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>En attente
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <a href="{{ path('app_employee_payroll_fiche_show', {id: fiche.id}) }}"
                                           class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-teal-50 dark:bg-teal-500/10 hover:bg-teal-100 dark:hover:bg-teal-500/20 text-teal-700 dark:text-teal-400 text-xs font-semibold transition-all">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                            Voir
                                        </a>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <a href="{{ path('app_employee_payroll_fiche_pdf', {id: fiche.id}) }}"
                                           class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-rose-50 dark:bg-rose-500/10 hover:bg-rose-100 dark:hover:bg-rose-500/20 text-rose-700 dark:text-rose-400 text-xs font-semibold transition-all"
                                           title="Télécharger le bulletin PDF">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                                            PDF
                                        </a>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="8" class="px-6 py-16 text-center">
                                        <svg class="w-14 h-14 mx-auto mb-4 text-zinc-300 dark:text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                        <p class="text-zinc-500 dark:text-zinc-400 font-semibold">Aucune fiche de paie disponible</p>
                                        <p class="text-xs text-zinc-400 mt-1">Vos bulletins apparaîtront ici une fois générés.</p>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>
{% endblock %}
