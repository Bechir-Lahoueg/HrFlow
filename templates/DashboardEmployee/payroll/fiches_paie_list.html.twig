{% extends "base.html.twig" %}

{% block title %}Mes Fiches de Paie{% endblock %}

{% block content %}
<div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 dark:from-zinc-900 dark:to-zinc-800 py-8 px-4">
    <div class="max-w-6xl mx-auto">
        <!-- Header -->
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-slate-900 dark:text-white mb-2">Mes Fiches de Paie</h1>
            <p class="text-slate-600 dark:text-slate-400">Visualisez vos fiches de paie mensuelles</p>
        </div>

        <!-- Fiches Table -->
        <div class="bg-white dark:bg-zinc-800 rounded-lg shadow-md overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-50 dark:bg-zinc-700 border-b border-slate-200 dark:border-zinc-600">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Période</th>
                            <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Salaire Brut</th>
                            <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Primes</th>
                            <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Déductions</th>
                            <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Salaire Net</th>
                            <th class="px-6 py-4 text-center text-sm font-semibold text-slate-900 dark:text-white">Action</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-zinc-600">
                        {% for fiche in fiches %}
                            <tr class="hover:bg-slate-50 dark:hover:bg-zinc-700 transition-colors">
                                <td class="px-6 py-4 text-slate-900 dark:text-white font-semibold">{{ fiche.periodLabel }}</td>
                                <td class="px-6 py-4 text-right text-slate-900 dark:text-white">{{ fiche.salaireBrut }} TND</td>
                                <td class="px-6 py-4 text-right text-green-600 font-semibold">+{{ fiche.totalPrimes }} TND</td>
                                <td class="px-6 py-4 text-right text-orange-600 font-semibold">-{{ fiche.totalDeductions }} TND</td>
                                <td class="px-6 py-4 text-right text-indigo-600 dark:text-indigo-400 font-bold text-lg">{{ fiche.salaireNet }} TND</td>
                                <td class="px-6 py-4 text-center">
                                    <a href="{{ path('app_employee_payroll_fiche_show', {id: fiche.id}) }}" class="text-indigo-600 hover:text-indigo-800 dark:text-indigo-400 inline-flex items-center gap-1 px-3 py-1 rounded hover:bg-indigo-50 dark:hover:bg-indigo-900/20 transition-colors">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                        Voir
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="px-6 py-12 text-center text-slate-600 dark:text-slate-400">
                                    <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                    </svg>
                                    <p class="text-lg font-semibold">Aucune fiche de paie disponible</p>
                                    <p class="text-sm mt-2">Vos fiches de paie apparaîtront ici une fois générées</p>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Navigation Links -->
        <div class="flex gap-4 mt-8">
            <a href="{{ path('app_employee_payroll_primes') }}" class="px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-semibold transition-all">
                Voir Mes Primes
            </a>
            <a href="{{ path('app_employee_payroll_deductions') }}" class="px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-lg font-semibold transition-all">
                Voir Mes Déductions
            </a>
        </div>
    </div>
</div>
{% endblock %}
