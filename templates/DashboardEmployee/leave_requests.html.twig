{% extends 'base.html.twig' %}

{% block title %}My Leave Requests | HrFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8fafc] font-[Manrope,sans-serif]">
    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}

    <div class="lg:ml-72 transition-all duration-300">
        {% include 'DashboardEmployee/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium">{{ message }}</div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                <div class="bg-white rounded-2xl border border-slate-200/60 p-6 relative overflow-hidden">
                    <div class="absolute -top-6 -right-6 w-20 h-20 rounded-full bg-amber-100/80"></div>
                    <p class="text-sm text-slate-400">Available Days</p>
                    <p class="text-3xl font-extrabold text-slate-800 mt-1">{{ balance.available_days|number_format(1, '.', ',') }}</p>
                    <p class="text-xs text-slate-500 mt-2">Smart credit balance (auto-accrual: 1.8 days/month)</p>
                </div>
                <div class="bg-white rounded-2xl border border-slate-200/60 p-6">
                    <p class="text-sm text-slate-400">Total Accrued</p>
                    <p class="text-3xl font-extrabold text-slate-800 mt-1">{{ balance.total_accrued|number_format(1, '.', ',') }}</p>
                    <p class="text-xs text-slate-500 mt-2">Used: {{ balance.total_used|number_format(1, '.', ',') }} days</p>
                </div>
                <div class="bg-white rounded-2xl border border-slate-200/60 p-6">
                    <p class="text-sm text-slate-400">Pending Requests</p>
                    <p class="text-3xl font-extrabold text-slate-800 mt-1">{{ pendingLeaveCount }}</p>
                    <p class="text-xs text-slate-500 mt-2">Approved: {{ leaveStats.approved_count|default(0) }} | Rejected: {{ leaveStats.rejected_count|default(0) }}</p>
                </div>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-5 gap-6">
                <section class="xl:col-span-2 bg-white rounded-2xl border border-slate-200/60 p-6">
                    <h3 class="text-lg font-bold text-slate-800 mb-5">New Leave Request</h3>
                    <div class="mb-4 p-3 rounded-xl bg-slate-50 border border-slate-100 text-xs text-slate-600 space-y-1">
                        <p><span class="font-semibold">Calendar intelligence enabled</span>:</p>
                        <p>- Past days are blocked</p>
                        <p>- Weekends are blocked</p>
                        <p>- Tunisia public holidays are synced from Nager API</p>
                    </div>

                    <form method="post" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('employee_leave_submit') }}">

                        <div>
                            <label for="start_date" class="block text-sm font-medium text-slate-600 mb-1">Start date</label>
                            <input id="start_date" name="start_date" type="text" required autocomplete="off" class="w-full rounded-xl border-slate-200 focus:border-amber-500 focus:ring-amber-500">
                        </div>

                        <div>
                            <label for="end_date" class="block text-sm font-medium text-slate-600 mb-1">End date</label>
                            <input id="end_date" name="end_date" type="text" required autocomplete="off" class="w-full rounded-xl border-slate-200 focus:border-amber-500 focus:ring-amber-500">
                        </div>

                        <div>
                            <label for="leave_type" class="block text-sm font-medium text-slate-600 mb-1">Leave type</label>
                            <select id="leave_type" name="leave_type" class="w-full rounded-xl border-slate-200 focus:border-amber-500 focus:ring-amber-500">
                                <option value="Conge annuel">Conge annuel</option>
                                <option value="Conge maladie">Conge maladie</option>
                                <option value="Conge exceptionnel">Conge exceptionnel</option>
                            </select>
                        </div>

                        <div>
                            <label for="reason" class="block text-sm font-medium text-slate-600 mb-1">Reason (optional)</label>
                            <textarea id="reason" name="reason" rows="4" class="w-full rounded-xl border-slate-200 focus:border-amber-500 focus:ring-amber-500"></textarea>
                        </div>

                        <div class="p-3 rounded-xl border border-slate-200 bg-slate-50 text-sm">
                            <div class="flex items-center justify-between">
                                <span class="text-slate-500">Selected working days</span>
                                <span id="sim-days" class="font-extrabold text-slate-800">0</span>
                            </div>
                            <div class="flex items-center justify-between mt-1">
                                <span class="text-slate-500">Projected remaining credit</span>
                                <span id="sim-credit" class="font-extrabold text-amber-600">{{ balance.available_days|number_format(1, '.', ',') }}</span>
                            </div>
                            <p id="sim-note" class="text-xs mt-2 text-slate-500">Pick your dates to preview impact before submission.</p>
                        </div>

                        <button type="submit" class="w-full px-4 py-2.5 rounded-xl bg-amber-500 text-white font-semibold hover:bg-amber-600 transition-colors">
                            Submit Request
                        </button>
                    </form>
                </section>

                <section class="xl:col-span-3 bg-white rounded-2xl border border-slate-200/60 p-6">
                    <h3 class="text-lg font-bold text-slate-800 mb-5">My Leave History</h3>

                    <div class="overflow-x-auto">
                        <table class="min-w-full text-sm">
                            <thead>
                                <tr class="text-left text-slate-500 border-b border-slate-100">
                                    <th class="py-3 pr-4">Period</th>
                                    <th class="py-3 pr-4">Type</th>
                                    <th class="py-3 pr-4">Days</th>
                                    <th class="py-3 pr-4">Status</th>
                                    <th class="py-3 pr-4">RH Comment</th>
                                    <th class="py-3">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for leave in leaveRequests %}
                                <tr class="border-b border-slate-100 align-top">
                                    <td class="py-3 pr-4 text-slate-700">{{ leave.start_date|date('Y-m-d') }} -> {{ leave.end_date|date('Y-m-d') }}</td>
                                    <td class="py-3 pr-4 text-slate-700">{{ leave.leave_type }}</td>
                                    <td class="py-3 pr-4 text-slate-700">{{ leave.days_count }}</td>
                                    <td class="py-3 pr-4">
                                        <span class="px-2 py-1 rounded-full text-xs font-semibold
                                            {{ leave.status == 'ATTENTE' ? 'bg-amber-100 text-amber-700' : '' }}
                                            {{ leave.status == 'ACCEPTE' ? 'bg-emerald-100 text-emerald-700' : '' }}
                                            {{ leave.status == 'REFUSE' ? 'bg-red-100 text-red-700' : '' }}">
                                            {{ leave.status }}
                                        </span>
                                    </td>
                                    <td class="py-3 pr-4 text-slate-500">{{ leave.rh_comment ?: '-' }}</td>
                                    <td class="py-3">
                                        {% if leave.status == 'ATTENTE' %}
                                            <form method="post" action="{{ path('app_employee_leave_request_delete', {id: leave.id}) }}" onsubmit="return confirm('Supprimer cette demande ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('employee_leave_delete_' ~ leave.id) }}">
                                                <button type="submit" class="text-xs px-3 py-1.5 rounded-lg bg-red-50 text-red-600 hover:bg-red-100">Delete</button>
                                            </form>
                                        {% else %}
                                            <span class="text-xs text-slate-400">-</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="py-8 text-center text-slate-400">No leave request yet.</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </main>
    </div>
</div>

<script>
    (function () {
        const holidayDates = {{ blockedHolidayDates|default([])|json_encode|raw }};
        const holidaySet = new Set(holidayDates);
        const availableCredit = {{ balance.available_days|default(0) }};

        const startInput = document.getElementById('start_date');
        const endInput = document.getElementById('end_date');
        const simDays = document.getElementById('sim-days');
        const simCredit = document.getElementById('sim-credit');
        const simNote = document.getElementById('sim-note');

        const isWeekend = function (date) {
            const day = date.getDay();
            return day === 0 || day === 6;
        };

        const formatIsoDate = function (date) {
            return date.toISOString().split('T')[0];
        };

        const isHoliday = function (date) {
            return holidaySet.has(formatIsoDate(date));
        };

        const disabledRule = function (date) {
            return isWeekend(date) || isHoliday(date);
        };

        const parseDate = function (value) {
            if (!value) {
                return null;
            }
            const parts = value.split('-');
            if (parts.length !== 3) {
                return null;
            }
            return new Date(Number(parts[0]), Number(parts[1]) - 1, Number(parts[2]));
        };

        const countWorkingDays = function (startDate, endDate) {
            let count = 0;
            const current = new Date(startDate.getTime());

            while (current <= endDate) {
                if (!disabledRule(current)) {
                    count += 1;
                }
                current.setDate(current.getDate() + 1);
            }

            return count;
        };

        const updateSimulation = function () {
            const startDate = parseDate(startInput.value);
            const endDate = parseDate(endInput.value);

            if (!startDate || !endDate || endDate < startDate) {
                simDays.textContent = '0';
                simCredit.textContent = availableCredit.toFixed(1);
                simCredit.classList.remove('text-red-600', 'text-emerald-600');
                simCredit.classList.add('text-amber-600');
                simNote.textContent = 'Pick your dates to preview impact before submission.';
                return;
            }

            const workingDays = countWorkingDays(startDate, endDate);
            const projected = availableCredit - workingDays;

            simDays.textContent = String(workingDays);
            simCredit.textContent = projected.toFixed(1);

            simCredit.classList.remove('text-amber-600', 'text-red-600', 'text-emerald-600');
            if (projected < 0) {
                simCredit.classList.add('text-red-600');
                simNote.textContent = 'Warning: this request may push your balance negative after approval.';
            } else {
                simCredit.classList.add('text-emerald-600');
                simNote.textContent = 'Selection is valid with smart calendar rules applied.';
            }
        };

        if (typeof flatpickr === 'function') {
            const options = {
                dateFormat: 'Y-m-d',
                minDate: 'today',
                disable: [disabledRule],
                onChange: updateSimulation,
            };

            flatpickr(startInput, options);
            flatpickr(endInput, options);
        }

        startInput.addEventListener('change', updateSimulation);
        endInput.addEventListener('change', updateSimulation);
        updateSimulation();
    })();
</script>
{% endblock %}
