{% extends 'base.html.twig' %}

{% block title %}My Leave Requests | HrFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        .flatpickr-calendar{border-radius:1rem!important;border:1px solid #e2e8f0!important;box-shadow:0 25px 60px -20px rgba(15,23,42,.18)!important;font-family:inherit!important;overflow:hidden}
        .flatpickr-months{background:linear-gradient(135deg,#0f172a,#1e293b);padding:.5rem 0}
        .flatpickr-months .flatpickr-month{color:#fff;fill:#fff}
        .flatpickr-current-month .flatpickr-monthDropdown-months,.flatpickr-current-month input.cur-year{color:#fff!important;font-weight:700}
        .flatpickr-months .flatpickr-prev-month,.flatpickr-months .flatpickr-next-month{fill:#94a3b8}
        .flatpickr-months .flatpickr-prev-month:hover,.flatpickr-months .flatpickr-next-month:hover{fill:#fff}
        span.flatpickr-weekday{color:#64748b;font-weight:700;font-size:11px}
        .flatpickr-day{border-radius:.5rem;font-weight:500;transition:all .15s}
        .flatpickr-day.selected,.flatpickr-day.startRange,.flatpickr-day.endRange{background:#0f172a!important;border-color:#0f172a!important;box-shadow:0 4px 14px -4px rgba(15,23,42,.5)}
        .flatpickr-day:hover{background:#f1f5f9;border-color:#f1f5f9}
        .flatpickr-day.flatpickr-disabled{color:#cbd5e1!important;text-decoration:line-through}
        .flatpickr-day.today{border-color:#06b6d4;color:#06b6d4;font-weight:700}
        .flatpickr-day.today.selected{color:#fff}

        .type-card{position:relative;cursor:pointer;transition:all .25s cubic-bezier(.4,0,.2,1)}
        .type-card::before{content:'';position:absolute;inset:0;border-radius:1rem;opacity:0;transition:opacity .25s;background:linear-gradient(135deg,#0f172a,#1e3a5f);z-index:0}
        .type-card[data-active='true']::before{opacity:1}
        .type-card[data-active='true']{border-color:transparent;box-shadow:0 10px 30px -10px rgba(15,23,42,.5);transform:translateY(-2px)}
        .type-card[data-active='true'] .type-icon{background:rgba(255,255,255,.15)!important;color:#fff!important}
        .type-card[data-active='true'] .type-label{color:#fff}
        .type-card[data-active='true'] .type-desc{color:rgba(255,255,255,.7)}
        .type-card>*{position:relative;z-index:1}

        .sim-ring{width:80px;height:80px}
        .sim-ring circle{transition:stroke-dashoffset .6s cubic-bezier(.4,0,.2,1)}

        @keyframes countUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
        .count-anim{animation:countUp .4s ease-out both}

        .history-row{transition:all .2s}
        .history-row:hover{background:#f8fafc;transform:scale(1.002)}
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardEmployee/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ══════════ Hero Banner ══════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-cyan-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-400/15 blur-3xl mesh-blob"></div>
                <div class="absolute -left-20 bottom-0 h-48 w-48 rounded-full bg-emerald-300/10 blur-3xl mesh-blob-alt"></div>
                <div class="relative z-10 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-cyan-200 uppercase tracking-wider">Leave Studio</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Planifiez vos conges intelligemment</h2>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">Weekends et jours feries exclus automatiquement. Visualisez l'impact sur votre solde avant validation.</p>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">Solde actuel</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ balance.available_days|number_format(1, '.', ',') }}</p>
                            <p class="text-xs text-cyan-100/60 mt-1">jours disponibles</p>
                        </div>
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">En attente</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ pendingLeaveCount }}</p>
                            <p class="text-xs text-cyan-100/60 mt-1">validation RH</p>
                        </div>
                    </div>
                </div>
            </section>

            {# ══════════ Stat Cards ══════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-1">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-cyan-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-cyan-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                        </div>
                        <span class="text-[11px] font-bold text-cyan-600 bg-cyan-50 px-2 py-0.5 rounded-md">Solde</span>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ balance.available_days|number_format(1, '.', ',') }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Credit disponible</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-3/4 rounded-full bg-gradient-to-r from-cyan-500 to-blue-500"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-2">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-indigo-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ balance.total_accrued|number_format(1, '.', ',') }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Total accumule</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-full rounded-full bg-gradient-to-r from-indigo-500 to-violet-500"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-3">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-orange-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ balance.total_used|number_format(1, '.', ',') }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Jours consommes</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-1/2 rounded-full bg-gradient-to-r from-orange-500 to-amber-400"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                    </div>
                    <p class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">
                        <span class="text-emerald-600">{{ leaveStats.approved_count|default(0) }}</span>
                        <span class="text-zinc-300 mx-1">/</span>
                        <span class="text-red-500">{{ leaveStats.rejected_count|default(0) }}</span>
                    </p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Approuvees / Refusees</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-2/3 rounded-full bg-gradient-to-r from-emerald-500 to-teal-400"></div></div>
                </div>
            </div>

            {# ══════════ Form + Table ══════════ #}
            <div class="grid grid-cols-1 2xl:grid-cols-12 gap-6">

                {# ── New Request Form ── #}
                <section class="2xl:col-span-5 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                    <div class="flex items-center justify-between gap-3 mb-5">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-cyan-50 flex items-center justify-center">
                                <svg class="w-4 h-4 text-cyan-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                            </div>
                            <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Nouvelle Demande</h3>
                        </div>
                        <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-md uppercase tracking-wider">Smart Cal</span>
                    </div>

                    <div class="mb-5 grid grid-cols-3 gap-2">
                        <div class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2 text-center">
                            <svg class="w-4 h-4 text-slate-400 mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
                            <p class="text-[10px] font-bold text-slate-500">Passes bloques</p>
                        </div>
                        <div class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2 text-center">
                            <svg class="w-4 h-4 text-slate-400 mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25"/></svg>
                            <p class="text-[10px] font-bold text-slate-500">WE bloques</p>
                        </div>
                        <div class="rounded-lg bg-slate-50 border border-slate-100 px-3 py-2 text-center">
                            <svg class="w-4 h-4 text-slate-400 mx-auto mb-1" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3"/></svg>
                            <p class="text-[10px] font-bold text-slate-500">Feries TN</p>
                        </div>
                    </div>

                    <form method="post" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('employee_leave_submit') }}">
                        <input type="hidden" name="leave_type" id="leave_type" value="Conge annuel">

                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label for="start_date" class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1.5">Date debut</label>
                                <input id="start_date" name="start_date" type="text" required autocomplete="off" placeholder="YYYY-MM-DD" class="w-full rounded-lg border-zinc-200 bg-zinc-50 text-sm focus:border-cyan-500 focus:ring-cyan-500 focus:bg-white transition-colors">
                            </div>
                            <div>
                                <label for="end_date" class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1.5">Date fin</label>
                                <input id="end_date" name="end_date" type="text" required autocomplete="off" placeholder="YYYY-MM-DD" class="w-full rounded-lg border-zinc-200 bg-zinc-50 text-sm focus:border-cyan-500 focus:ring-cyan-500 focus:bg-white transition-colors">
                            </div>
                        </div>

                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-2">Type de conge</label>
                            <div class="grid grid-cols-1 gap-2" id="leave-type-selector">
                                <button type="button" class="type-card flex items-center gap-3 rounded-xl border border-zinc-200 px-4 py-3 text-left" data-value="Conge annuel" data-active="true">
                                    <div class="type-icon w-9 h-9 rounded-lg bg-cyan-50 flex items-center justify-center shrink-0">
                                        <svg class="w-4 h-4 text-cyan-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
                                    </div>
                                    <div>
                                        <p class="type-label text-sm font-semibold text-zinc-800">Conge annuel</p>
                                        <p class="type-desc text-[11px] text-zinc-400">Vacances regulieres</p>
                                    </div>
                                </button>
                                <button type="button" class="type-card flex items-center gap-3 rounded-xl border border-zinc-200 px-4 py-3 text-left" data-value="Conge maladie" data-active="false">
                                    <div class="type-icon w-9 h-9 rounded-lg bg-rose-50 flex items-center justify-center shrink-0">
                                        <svg class="w-4 h-4 text-rose-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
                                    </div>
                                    <div>
                                        <p class="type-label text-sm font-semibold text-zinc-800">Conge maladie</p>
                                        <p class="type-desc text-[11px] text-zinc-400">Arret medical</p>
                                    </div>
                                </button>
                                <button type="button" class="type-card flex items-center gap-3 rounded-xl border border-zinc-200 px-4 py-3 text-left" data-value="Conge exceptionnel" data-active="false">
                                    <div class="type-icon w-9 h-9 rounded-lg bg-amber-50 flex items-center justify-center shrink-0">
                                        <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
                                    </div>
                                    <div>
                                        <p class="type-label text-sm font-semibold text-zinc-800">Conge exceptionnel</p>
                                        <p class="type-desc text-[11px] text-zinc-400">Evenement special</p>
                                    </div>
                                </button>
                            </div>
                        </div>

                        <div>
                            <label for="reason" class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1.5">Motif (optionnel)</label>
                            <textarea id="reason" name="reason" rows="3" placeholder="Contexte utile pour votre RH..." class="w-full rounded-lg border-zinc-200 bg-zinc-50 text-sm focus:border-cyan-500 focus:ring-cyan-500 focus:bg-white transition-colors"></textarea>
                        </div>

                        {# Live Simulation #}
                        <div class="rounded-xl border border-zinc-200 bg-gradient-to-br from-zinc-50 to-white p-4">
                            <div class="flex items-center gap-4">
                                <div class="sim-ring shrink-0">
                                    <svg viewBox="0 0 36 36" class="w-full h-full -rotate-90">
                                        <circle cx="18" cy="18" r="15.5" fill="none" stroke="#e2e8f0" stroke-width="3"/>
                                        <circle id="sim-ring-progress" cx="18" cy="18" r="15.5" fill="none" stroke="#06b6d4" stroke-width="3" stroke-linecap="round" stroke-dasharray="97.39" stroke-dashoffset="97.39"/>
                                    </svg>
                                    <div class="absolute inset-0 flex items-center justify-center" style="position:relative;margin-top:-80px">
                                        <span id="sim-days" class="text-lg font-extrabold text-zinc-800">0</span>
                                    </div>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between">
                                        <span class="text-[12px] font-medium text-zinc-500">Jours ouvrables</span>
                                        <span id="sim-days-label" class="text-[12px] font-bold text-zinc-700">0 jours</span>
                                    </div>
                                    <div class="mt-2 h-1.5 rounded-full bg-zinc-200 overflow-hidden">
                                        <div id="sim-bar" class="h-full rounded-full bg-gradient-to-r from-cyan-500 to-blue-500 transition-all duration-500" style="width:0%"></div>
                                    </div>
                                    <div class="flex items-center justify-between mt-2">
                                        <span class="text-[12px] font-medium text-zinc-500">Credit projete</span>
                                        <span id="sim-credit" class="text-[13px] font-extrabold text-cyan-700 font-mono-num">{{ balance.available_days|number_format(1, '.', ',') }}</span>
                                    </div>
                                    <p id="sim-note" class="text-[11px] mt-1.5 text-zinc-400">Selectionnez vos dates pour voir l'impact.</p>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="w-full px-4 py-3 rounded-xl bg-gradient-to-r from-slate-900 to-slate-700 text-white font-bold text-sm tracking-wide hover:from-slate-800 hover:to-slate-600 transition-all shadow-lg shadow-slate-900/20 active:scale-[0.98]">
                            Soumettre la demande
                        </button>
                    </form>
                </section>

                {# ── Leave History ── #}
                <section class="2xl:col-span-7 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3 mb-5">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-violet-50 flex items-center justify-center">
                                <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Historique</h3>
                        </div>
                        <div class="flex gap-2">
                            <input id="history-search" type="text" placeholder="Rechercher..." class="rounded-lg border-zinc-200 bg-zinc-50 text-sm w-40 focus:border-violet-400 focus:ring-violet-400 focus:bg-white">
                            <select id="history-status" class="rounded-lg border-zinc-200 bg-zinc-50 text-sm focus:border-violet-400 focus:ring-violet-400 focus:bg-white">
                                <option value="ALL">Tous</option>
                                <option value="ATTENTE">Attente</option>
                                <option value="ACCEPTE">Accepte</option>
                                <option value="REFUSE">Refuse</option>
                            </select>
                        </div>
                    </div>

                    <div class="overflow-x-auto rounded-lg border border-zinc-100">
                        <table class="min-w-full text-sm">
                            <thead>
                                <tr class="text-left text-[11px] font-bold uppercase tracking-wider text-zinc-400 border-b border-zinc-100 bg-zinc-50/80">
                                    <th class="py-3 px-4">Periode</th>
                                    <th class="py-3 px-4">Type</th>
                                    <th class="py-3 px-4">Jours</th>
                                    <th class="py-3 px-4">Statut</th>
                                    <th class="py-3 px-4">Commentaire RH</th>
                                    <th class="py-3 px-4">Action</th>
                                </tr>
                            </thead>
                            <tbody id="history-body">
                            {% for leave in leaveRequests %}
                                <tr class="history-row border-b border-zinc-50 align-top" data-status="{{ leave.status }}" data-search="{{ leave.leave_type|lower }} {{ leave.start_date|date('Y-m-d') }} {{ leave.end_date|date('Y-m-d') }} {{ leave.status|lower }}">
                                    <td class="py-3 px-4">
                                        <p class="text-[13px] font-medium text-zinc-700">{{ leave.start_date|date('d M Y') }}</p>
                                        <p class="text-[11px] text-zinc-400">au {{ leave.end_date|date('d M Y') }}</p>
                                    </td>
                                    <td class="py-3 px-4">
                                        <span class="text-[12px] font-medium text-zinc-600 bg-zinc-100 px-2 py-0.5 rounded-md">{{ leave.leave_type }}</span>
                                    </td>
                                    <td class="py-3 px-4 font-bold text-zinc-800 font-mono-num">{{ leave.days_count }}</td>
                                    <td class="py-3 px-4">
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold
                                            {{ leave.status == 'ATTENTE' ? 'bg-amber-50 text-amber-700 border border-amber-200' : '' }}
                                            {{ leave.status == 'ACCEPTE' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : '' }}
                                            {{ leave.status == 'REFUSE' ? 'bg-red-50 text-red-700 border border-red-200' : '' }}">
                                            <span class="w-1.5 h-1.5 rounded-full
                                                {{ leave.status == 'ATTENTE' ? 'bg-amber-500' : '' }}
                                                {{ leave.status == 'ACCEPTE' ? 'bg-emerald-500' : '' }}
                                                {{ leave.status == 'REFUSE' ? 'bg-red-500' : '' }}"></span>
                                            {{ leave.status }}
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-[12px] text-zinc-400 max-w-[180px]">{{ leave.rh_comment ?: '-' }}</td>
                                    <td class="py-3 px-4">
                                        {% if leave.status == 'ATTENTE' %}
                                            <form method="post" action="{{ path('app_employee_leave_request_delete', {id: leave.id}) }}" onsubmit="return confirm('Supprimer cette demande ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('employee_leave_delete_' ~ leave.id) }}">
                                                <button type="submit" class="text-[11px] font-semibold px-3 py-1.5 rounded-lg text-red-600 bg-red-50 border border-red-200 hover:bg-red-100 transition-colors">Supprimer</button>
                                            </form>
                                        {% else %}
                                            <span class="text-[11px] text-zinc-300">-</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="py-12 text-center text-zinc-400 text-sm">Aucune demande pour le moment.</td></tr>
                            {% endfor %}
                            <tr id="history-empty" class="hidden"><td colspan="6" class="py-12 text-center text-zinc-400 text-sm">Aucun resultat avec ces filtres.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </main>
    </div>
</div>

<script>
(function () {
    var holidayDates = {{ blockedHolidayDates|default([])|json_encode|raw }};
    var holidaySet = new Set(holidayDates);
    var availableCredit = {{ balance.available_days|default(0) }};
    var circumference = 2 * Math.PI * 15.5;

    var startInput = document.getElementById('start_date');
    var endInput = document.getElementById('end_date');
    var simDays = document.getElementById('sim-days');
    var simDaysLabel = document.getElementById('sim-days-label');
    var simCredit = document.getElementById('sim-credit');
    var simNote = document.getElementById('sim-note');
    var simBar = document.getElementById('sim-bar');
    var simRing = document.getElementById('sim-ring-progress');
    var leaveTypeInput = document.getElementById('leave_type');
    var leaveTypeSelector = document.getElementById('leave-type-selector');
    var historySearch = document.getElementById('history-search');
    var historyStatus = document.getElementById('history-status');
    var historyBody = document.getElementById('history-body');
    var historyEmpty = document.getElementById('history-empty');

    function isWeekend(d) { var day = d.getDay(); return day === 0 || day === 6; }
    function fmtIso(d) { return d.toISOString().split('T')[0]; }
    function isHoliday(d) { return holidaySet.has(fmtIso(d)); }
    function isDisabled(d) { return isWeekend(d) || isHoliday(d); }

    function parseDate(v) {
        if (!v) return null;
        var p = v.split('-');
        return p.length === 3 ? new Date(+p[0], +p[1] - 1, +p[2]) : null;
    }

    function countWorkingDays(s, e) {
        var c = 0, d = new Date(s.getTime());
        while (d <= e) { if (!isDisabled(d)) c++; d.setDate(d.getDate() + 1); }
        return c;
    }

    function updateSim() {
        var s = parseDate(startInput.value), e = parseDate(endInput.value);
        if (!s || !e || e < s) {
            simDays.textContent = '0';
            simDaysLabel.textContent = '0 jours';
            simCredit.textContent = availableCredit.toFixed(1);
            simBar.style.width = '0%';
            simRing.style.strokeDashoffset = circumference;
            simCredit.className = 'text-[13px] font-extrabold text-cyan-700 font-mono-num';
            simNote.textContent = "Selectionnez vos dates pour voir l'impact.";
            return;
        }
        var wd = countWorkingDays(s, e), proj = availableCredit - wd;
        var ratio = availableCredit > 0 ? Math.min(100, Math.round((wd / availableCredit) * 100)) : 100;
        simDays.textContent = wd;
        simDaysLabel.textContent = wd + ' jour' + (wd > 1 ? 's' : '');
        simCredit.textContent = proj.toFixed(1);
        simBar.style.width = ratio + '%';
        simRing.style.strokeDashoffset = circumference - (circumference * ratio / 100);
        simCredit.className = 'text-[13px] font-extrabold font-mono-num ' + (proj < 0 ? 'text-red-600' : 'text-emerald-600');
        simBar.className = 'h-full rounded-full transition-all duration-500 ' + (proj < 0 ? 'bg-gradient-to-r from-red-500 to-rose-400' : 'bg-gradient-to-r from-emerald-500 to-teal-400');
        simRing.style.stroke = proj < 0 ? '#ef4444' : '#10b981';
        simNote.textContent = proj < 0 ? 'Attention: solde negatif apres validation.' : 'Selection valide - calendrier intelligent applique.';
    }

    function updateType(val) {
        leaveTypeInput.value = val;
        if (!leaveTypeSelector) return;
        leaveTypeSelector.querySelectorAll('.type-card').forEach(function (b) {
            b.setAttribute('data-active', b.getAttribute('data-value') === val ? 'true' : 'false');
        });
    }

    function filterHistory() {
        if (!historyBody) return;
        var q = (historySearch ? historySearch.value : '').trim().toLowerCase();
        var st = historyStatus ? historyStatus.value : 'ALL';
        var vis = 0;
        historyBody.querySelectorAll('tr[data-status]').forEach(function (r) {
            var show = (st === 'ALL' || r.getAttribute('data-status') === st) && (q === '' || (r.getAttribute('data-search') || '').includes(q));
            r.classList.toggle('hidden', !show);
            if (show) vis++;
        });
        if (historyEmpty) historyEmpty.classList.toggle('hidden', vis !== 0);
    }

    if (typeof flatpickr === 'function') {
        var opts = { dateFormat: 'Y-m-d', minDate: 'today', disable: [isDisabled], onChange: updateSim };
        flatpickr(startInput, opts);
        flatpickr(endInput, opts);
    }

    if (leaveTypeSelector) {
        leaveTypeSelector.querySelectorAll('.type-card').forEach(function (b) {
            b.addEventListener('click', function () { updateType(b.getAttribute('data-value') || 'Conge annuel'); });
        });
    }
    if (historySearch) historySearch.addEventListener('input', filterHistory);
    if (historyStatus) historyStatus.addEventListener('change', filterHistory);
    startInput.addEventListener('change', updateSim);
    endInput.addEventListener('change', updateSim);
    updateType(leaveTypeInput.value || 'Conge annuel');
    updateSim();
    filterHistory();
})();
</script>
{% endblock %}
