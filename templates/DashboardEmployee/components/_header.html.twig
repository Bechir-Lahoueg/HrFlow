{% set user = app.user %}
{% set notificationCount = employee_unread_notifications_count() %}
{% set latestNotifications = employee_unread_notifications(6) %}
<header class="sticky top-0 z-10 bg-white/80 dark:bg-zinc-950/90 backdrop-blur-2xl border-b border-zinc-200 dark:border-zinc-800/50">
    <div class="flex items-center justify-between px-6 h-16">

        {# Mobile menu toggle #}
        <button class="lg:hidden p-2 -ml-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors"
                onclick="document.getElementById('sidebar').classList.toggle('-translate-x-full'); document.getElementById('sidebar-overlay').classList.toggle('hidden');">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"/>
            </svg>
        </button>

        {# Breadcrumb #}
        <div class="hidden lg:flex items-center gap-2 text-sm">
            <span class="text-zinc-400 dark:text-zinc-500">Employee</span>
            <svg class="w-3.5 h-3.5 text-zinc-300 dark:text-zinc-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
            <span class="font-semibold text-zinc-800 dark:text-zinc-200">
                {% if app.request.get('_route') == 'app_employee_leave_requests' %}My Leaves
                {% else %}Dashboard{% endif %}
            </span>
        </div>

        <div class="flex items-center gap-2">

            {# Theme toggle #}
            <button onclick="toggleTheme()" class="p-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors" title="Toggle theme">
                <svg id="theme-sun" class="w-5 h-5 dark:hidden theme-icon-in" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>
                </svg>
                <svg id="theme-moon" class="w-5 h-5 hidden dark:block theme-icon-in" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/>
                </svg>
            </button>

            {# Notifications #}
            <div class="relative" id="employee-notifications-root">
            <button id="employee-notifications-toggle" type="button" class="relative p-2 rounded-lg text-zinc-500 dark:text-zinc-400 hover:bg-zinc-100 dark:hover:bg-zinc-800/50 hover:text-zinc-700 dark:hover:text-zinc-200 transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
                </svg>
                {% if notificationCount > 0 %}
                    <span class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-rose-500 text-white text-[10px] font-bold flex items-center justify-center">{{ notificationCount > 99 ? '99+' : notificationCount }}</span>
                {% endif %}
            </button>
                <div id="employee-notifications-menu" class="hidden absolute right-0 mt-2 w-96 rounded-2xl border border-zinc-200 bg-white shadow-2xl z-20 overflow-hidden">
                    <div class="px-4 py-3 border-b border-zinc-100 flex items-center justify-between bg-white">
                        <div>
                            <p class="text-sm font-semibold text-zinc-800 dark:text-zinc-200">Notifications</p>
                            <p class="text-[11px] text-zinc-500">{{ notificationCount }} non lue(s)</p>
                        </div>
                        {% if notificationCount > 0 %}
                            <form method="post" action="{{ path('employee_notifications_mark_all_read') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('employee-notifications-mark-all-read') }}">
                                <button type="submit" class="text-[11px] font-semibold text-cyan-600 hover:text-cyan-700">Marquer tout lu</button>
                            </form>
                        {% endif %}
                    </div>
                    <div class="max-h-96 overflow-y-auto">
                        {% for notification in latestNotifications %}
                            <a href="{{ path('employee_notification_open', {id: notification.id}) }}" class="group block px-4 py-3 border-b border-zinc-100 dark:border-zinc-800/60 hover:bg-cyan-50/70 dark:hover:bg-zinc-800/60 transition-colors">
                                <div class="flex items-start gap-3">
                                    <span class="mt-1 w-2 h-2 rounded-full bg-cyan-500"></span>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center justify-between gap-2">
                                            <p class="text-[12px] font-semibold text-zinc-800 dark:text-zinc-200 truncate">{{ notification.title ?: 'Formation mise a jour' }}</p>
                                            <span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-100 text-cyan-700 dark:bg-cyan-900/40 dark:text-cyan-300">{{ notification.referenceType == 'session' ? 'Session' : 'Formation' }}</span>
                                        </div>
                                        <p class="mt-1 text-[12px] leading-relaxed text-zinc-600 dark:text-zinc-300">{{ notification.message }}</p>
                                        <p class="mt-1 text-[10px] text-zinc-400">{{ notification.createdAt ? notification.createdAt|date('d/m/Y H:i') : '' }} - Cliquer pour ouvrir</p>
                                    </div>
                                </div>
                            </a>
                        {% else %}
                            <div class="px-4 py-8 text-center">
                                <p class="text-sm text-zinc-400">Aucune nouvelle notification.</p>
                                <p class="text-[11px] text-zinc-400 mt-1">Vous verrez ici les changements de formations/sessions.</p>
                            </div>
                        {% endfor %}
                    </div>
                    <div class="px-4 py-2 border-t border-zinc-100 bg-white">
                        <a href="{{ path('employee_notifications_history') }}" class="text-xs font-semibold text-cyan-600 hover:text-cyan-700">Voir tout l'historique</a>
                    </div>
                </div>
            </div>

            {# Divider #}
            <div class="w-px h-8 bg-zinc-200 dark:bg-zinc-800/50 mx-1 hidden sm:block"></div>

            {# User menu #}
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center shadow-md shadow-amber-500/20">
                    <span class="text-xs font-bold text-white">{{ user.userIdentifier|first|upper }}</span>
                </div>
                <div class="hidden sm:block">
                    <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 leading-tight">{{ user.fullName is defined and user.fullName ? user.fullName : user.userIdentifier }}</p>
                    <p class="text-[11px] text-amber-600 dark:text-amber-400 font-medium">{{ user.jobTitle is defined and user.jobTitle ? user.jobTitle : 'Employee' }}</p>
                </div>
                <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-600 hidden sm:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/>
                </svg>
            </div>
        </div>
    </div>
</header>

<script>
(function () {
    var root = document.getElementById('employee-notifications-root');
    var toggle = document.getElementById('employee-notifications-toggle');
    var menu = document.getElementById('employee-notifications-menu');
    if (!root || !toggle || !menu) return;

    toggle.addEventListener('click', function (event) {
        event.stopPropagation();
        menu.classList.toggle('hidden');
    });

    document.addEventListener('click', function (event) {
        if (!root.contains(event.target)) {
            menu.classList.add('hidden');
        }
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            menu.classList.add('hidden');
        }
    });
})();
</script>

