<aside id="sidebar" class="fixed inset-y-0 left-0 z-30 w-[272px] bg-gradient-to-b from-amber-950 via-orange-950 to-stone-950 transform transition-transform duration-300 ease-in-out lg:translate-x-0 -translate-x-full flex flex-col overflow-hidden">

    {# Subtle accent glow #}
    <div class="absolute top-0 left-0 right-0 h-40 bg-gradient-to-b from-amber-500/10 to-transparent pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"></div>

    {# ── Brand ── #}
    <div class="relative flex items-center gap-3 px-5 h-16 border-b border-white/10 shrink-0 overflow-hidden">
        <div class="w-10 h-10 bg-white rounded-xl border border-zinc-200/80 flex items-center justify-center p-0 shadow-md shadow-black/10">
            <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-full h-full object-contain drop-shadow-[0_1px_1px_rgba(0,0,0,0.15)]">
        </div>
        <span class="text-[15px] font-bold text-white tracking-tight">Hr-Flow</span>
    </div>

    {# ── Navigation ── #}
    <nav class="relative flex-1 px-3 py-5 overflow-y-auto scrollbar-themed">

        <p class="px-3 mb-2.5 text-[10px] font-bold text-white/30 uppercase tracking-[0.15em]">Overview</p>

        {% set isDashboard = app.request.get('_route') == 'app_welcome_employee' %}
        <a href="{{ path('app_welcome_employee') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                  {{ isDashboard
                      ? 'bg-white/10 text-white shadow-lg shadow-amber-500/5'
                      : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
            <div class="w-7 h-7 rounded-md {{ isDashboard ? 'bg-amber-500/25 text-amber-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
                </svg>
            </div>
            Dashboard
        </a>

        <p class="px-3 mt-6 mb-2.5 text-[10px] font-bold text-white/30 uppercase tracking-[0.15em]">My Space</p>

        <a href="#" class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium text-zinc-400 hover:bg-white/5 hover:text-zinc-200 transition-all duration-200">
            <div class="w-7 h-7 rounded-md bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            My Profile
        </a>

        {% set isLeaves = app.request.get('_route') == 'app_employee_leave_requests' %}
        <a href="{{ path('app_employee_leave_requests') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                  {{ isLeaves
                      ? 'bg-white/10 text-white shadow-lg shadow-amber-500/5'
                      : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
            <div class="w-7 h-7 rounded-md {{ isLeaves ? 'bg-amber-500/25 text-amber-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                </svg>
            </div>
            My Leaves
            {% if (pendingLeaveCount|default(0)) > 0 %}
                <span class="ml-auto text-[10px] font-bold text-amber-300 bg-amber-500/25 px-1.5 py-0.5 rounded-md">{{ pendingLeaveCount|default(0) }}</span>
            {% endif %}
        </a>

        {% set isPayroll = app.request.get('_route') in ['app_employee_payroll_fiches', 'app_employee_payroll_fiche_show', 'app_employee_payroll_primes', 'app_employee_payroll_deductions'] %}
        <a href="{{ path('app_employee_payroll_fiches') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                  {{ isPayroll
                      ? 'bg-white/10 text-white shadow-lg shadow-amber-500/5'
                      : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
            <div class="w-7 h-7 rounded-md {{ isPayroll ? 'bg-amber-500/25 text-amber-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>
                </svg>
            </div>
            My Payslips
        </a>

        {% set isFormation = app.request.get('_route') in ['employee_formation_index', 'employee_formation_sessions', 'employee_formation_requests'] %}
        <a href="{{ path('employee_formation_index') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                  {{ isFormation
                      ? 'bg-white/10 text-white shadow-lg shadow-amber-500/5'
                      : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
            <div class="w-7 h-7 rounded-md {{ isFormation ? 'bg-amber-500/25 text-amber-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
                </svg>
            </div>
            Training
        </a>

    {% set isProjects = app.request.get('_route') starts with 'employee_project_' %}
                <a href="{{ path('employee_project_index') }}"
                   class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                          {{ isProjects
                              ? 'bg-white/10 text-white shadow-lg shadow-amber-500/5'
                              : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
                    <div class="w-7 h-7 rounded-md {{ isProjects ? 'bg-amber-500/25 text-amber-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6.878V6a2.25 2.25 0 012.25-2.25h7.5A2.25 2.25 0 0118 6v.878m-12 0c.235-.083.487-.128.75-.128h10.5c.263 0 .515.045.75.128m-12 0A2.25 2.25 0 004.5 9v.878m13.5-3A2.25 2.25 0 0119.5 9v.878m0 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128m15 0V18a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 18v-8.122m15 0a2.246 2.246 0 00-.75-.128H5.25c-.263 0-.515.045-.75.128" />
                        </svg>
                    </div>
                    My Projects
                </a>

        <a href="#" class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium text-zinc-400 hover:bg-white/5 hover:text-zinc-200 transition-all duration-200">
            <div class="w-7 h-7 rounded-md bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                </svg>
            </div>
            Documents
        </a>

        <p class="px-3 mt-6 mb-2.5 text-[10px] font-bold text-white/30 uppercase tracking-[0.15em]">System</p>

        <a href="#" class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium text-zinc-400 hover:bg-white/5 hover:text-zinc-200 transition-all duration-200">
            <div class="w-7 h-7 rounded-md bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            Settings
        </a>
    </nav>

    {# ── Logout ── #}
    <div class="relative px-3 py-4 border-t border-white/10 shrink-0">
        <a href="{{ path('app_logout') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium text-zinc-500 hover:bg-rose-500/10 hover:text-rose-400 transition-all duration-200">
            <div class="w-7 h-7 rounded-md bg-white/5 text-zinc-500 group-hover:bg-rose-500/15 group-hover:text-rose-400 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/>
                </svg>
            </div>
            Logout
        </a>
    </div>
</aside>

{# Mobile overlay #}
<div id="sidebar-overlay" class="fixed inset-0 z-20 bg-black/60 backdrop-blur-sm hidden lg:hidden" onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); this.classList.add('hidden');"></div>
