{% extends 'base.html.twig' %}

{% block title %}Feedbacks Formation — HRFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .table-row-hover{transition:all .15s}
    .table-row-hover:hover{background:#f8fafc}
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">

    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">

        {% include 'DashboardEmployee/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        {% set ffErrors = ffErrors ?? {} %}
        {% set ffOld = ffOld ?? {} %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ══ Hero ══ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-cyan-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-400/15 blur-3xl"></div>
                <div class="absolute -left-20 bottom-0 h-48 w-48 rounded-full bg-emerald-300/10 blur-3xl"></div>
                <div class="relative z-10 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-cyan-200 uppercase tracking-wider">Évaluations</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Feedbacks Formation</h2>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl">Évaluez les formations auxquelles vous avez participé.</p>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">Mes évaluations</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ ffList|length }}</p>
                        </div>
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">Note moy.</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ avgRating > 0 ? avgRating ~ '/5' : '-' }}</p>
                        </div>
                    </div>
                </div>
            </section>

            <div class="grid grid-cols-1 2xl:grid-cols-12 gap-6">

                {# ══ Formulaire nouveau feedback formation ══ #}
                <section class="2xl:col-span-5 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 p-6 shadow-sm animate-slide-up stagger-1">
                    <div class="flex items-center gap-3 mb-5">
                        <div class="w-8 h-8 rounded-lg bg-cyan-50 flex items-center justify-center">
                            <svg class="w-4 h-4 text-cyan-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Nouveau Feedback Formation</h3>
                        <span class="ml-auto text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-1 rounded-md uppercase tracking-wider">Smart Cal</span>
                    </div>

                    {% if formations is empty %}
                    <div class="py-8 text-center text-zinc-400">
                        <div style="font-size:2rem">🎓</div>
                        <p class="text-sm mt-2">Aucune formation approuvée disponible pour évaluation.</p>
                    </div>
                    {% else %}
                    <form action="{{ path('employee_relation_ff_new') }}" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1.5">Formation *</label>
                            <select name="formation_id" id="formationSelect" required onchange="loadSessions(this.value)"
                                    class="w-full rounded-lg border border-zinc-200 bg-zinc-50 text-sm px-3 py-2.5 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 focus:bg-white transition-all">
                                <option value="">Choisir une formation...</option>
                                {% for f in formations %}
                                <option value="{{ f.id_formation }}" {{ ffOld.formation_id is defined and ffOld.formation_id == f.id_formation ? 'selected' : '' }}>{{ f.titre }}</option>
                                {% endfor %}
                            </select>
                            {% if ffErrors.formation_id %}
                                <p class="text-[11px] text-red-600 mt-1">{{ ffErrors.formation_id }}</p>
                            {% endif %}
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1.5">Session</label>
                            <select name="session_id" id="sessionSelect"
                                    class="w-full rounded-lg border border-zinc-200 bg-zinc-50 text-sm px-3 py-2.5 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 focus:bg-white transition-all">
                                <option value="">Sélectionnez d'abord une formation</option>
                            </select>
                            {% if ffErrors.session_id %}
                                <p class="text-[11px] text-red-600 mt-1">{{ ffErrors.session_id }}</p>
                            {% endif %}
                        </div>
                        {% set ffRating = ffOld.rating ?? 3 %}
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1.5">Note globale * <span id="ffRatingDisplay" class="text-amber-500 ml-1">⭐ {{ ffRating }} / 5</span></label>
                            <input type="range" min="1" max="5" value="{{ ffRating }}" step="1" name="rating"
                                   oninput="document.getElementById('ffRatingDisplay').textContent = '⭐ ' + this.value + ' / 5';"
                                   class="w-full h-2 bg-zinc-200 rounded-lg cursor-pointer accent-amber-500">
                            {% if ffErrors.rating %}
                                <p class="text-[11px] text-red-600 mt-1">{{ ffErrors.rating }}</p>
                            {% endif %}
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1.5">📚 Contenu</label>
                            <textarea name="contenu_comment" rows="2" placeholder="Votre avis sur le contenu..."
                                      class="w-full rounded-lg border border-zinc-200 bg-zinc-50 text-sm px-3 py-2.5 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 focus:bg-white transition-all resize-none">{{ ffOld.contenu_comment ?? '' }}</textarea>
                            {% if ffErrors.contenu_comment %}
                                <p class="text-[11px] text-red-600 mt-1">{{ ffErrors.contenu_comment }}</p>
                            {% endif %}
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1.5">👨‍🏫 Formateur</label>
                            <textarea name="formateur_comment" rows="2" placeholder="Votre avis sur le formateur..."
                                      class="w-full rounded-lg border border-zinc-200 bg-zinc-50 text-sm px-3 py-2.5 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 focus:bg-white transition-all resize-none">{{ ffOld.formateur_comment ?? '' }}</textarea>
                            {% if ffErrors.formateur_comment %}
                                <p class="text-[11px] text-red-600 mt-1">{{ ffErrors.formateur_comment }}</p>
                            {% endif %}
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1.5">🗂️ Organisation</label>
                            <textarea name="organisation_comment" rows="2" placeholder="Votre avis sur l'organisation..."
                                      class="w-full rounded-lg border border-zinc-200 bg-zinc-50 text-sm px-3 py-2.5 focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 focus:bg-white transition-all resize-none">{{ ffOld.organisation_comment ?? '' }}</textarea>
                            {% if ffErrors.organisation_comment %}
                                <p class="text-[11px] text-red-600 mt-1">{{ ffErrors.organisation_comment }}</p>
                            {% endif %}
                        </div>
                        <label class="flex items-center gap-2 text-sm font-semibold text-zinc-700 cursor-pointer rounded-xl border border-zinc-200 bg-zinc-50 px-4 py-3">
                            <input type="checkbox" name="recommande" checked class="rounded border-zinc-300 text-cyan-600 focus:ring-cyan-500" {{ ffOld.recommande is defined and ffOld.recommande ? 'checked' : '' }}>
                            ✅ Je recommande cette formation
                        </label>
                        <button type="submit"
                                class="w-full px-4 py-3 rounded-xl bg-gradient-to-r from-slate-900 to-slate-700 text-white font-bold text-sm tracking-wide hover:from-slate-800 hover:to-slate-600 transition-all shadow-lg shadow-slate-900/20 active:scale-[0.98]">
                            Soumettre l'évaluation
                        </button>
                    </form>
                    {% endif %}
                </section>

                {# ══ Mes évaluations ══ #}
                <section class="2xl:col-span-7 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 p-6 shadow-sm animate-slide-up stagger-2">
                    <div class="flex flex-col lg:flex-row lg:items-center gap-3 mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-violet-50 flex items-center justify-center">
                                <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Mes Évaluations</h3>
                        </div>
                        {% if formations is not empty %}
                        <form method="GET" class="flex gap-2 lg:ml-auto">
                            <select name="formation" class="rounded-lg border border-zinc-200 bg-zinc-50 text-sm px-3 py-2 focus:border-violet-400 focus:outline-none">
                                <option value="">Toutes les formations</option>
                                {% for f in formations %}
                                <option value="{{ f.id_formation }}" {{ formFilter == f.id_formation|string ? 'selected' : '' }}>{{ f.titre }}</option>
                                {% endfor %}
                            </select>
                            <button class="px-3 py-2 rounded-lg bg-slate-900 text-white text-[11px] font-bold">Filtrer</button>
                        </form>
                        {% endif %}
                    </div>

                    <div class="overflow-x-auto rounded-lg border border-zinc-100">
                        <table class="min-w-full text-sm">
                            <thead class="text-[11px] font-bold uppercase tracking-wider text-zinc-400 bg-zinc-50/80">
                                <tr>
                                    <th class="py-3 px-4 text-left">Formation</th>
                                    <th class="py-3 px-4 text-left">Session</th>
                                    <th class="py-3 px-4 text-left">Note</th>
                                    <th class="py-3 px-4 text-left">Recommandé</th>
                                    <th class="py-3 px-4 text-left">Date</th>
                                    <th class="py-3 px-4 text-left">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                            {% for ff in ffList %}
                            <tr class="table-row-hover border-t border-zinc-50">
                                <td class="py-3 px-4 font-medium text-zinc-700 max-w-[160px] truncate">{{ ff.formation_name ?? '-' }}</td>
                                <td class="py-3 px-4 text-[12px] text-zinc-400 max-w-[130px] truncate">{{ ff.session_name ?? '-' }}</td>
                                <td class="py-3 px-4">
                                    <span class="text-amber-500 font-mono text-[13px]">{% for i in 1..5 %}{{ i <= ff.rating ? '★' : '☆' }}{% endfor %}</span>
                                    <span class="text-[11px] text-zinc-400 ml-1">{{ ff.rating }}/5</span>
                                </td>
                                <td class="py-3 px-4">
                                    <span class="text-[11px] font-bold {{ ff.recommande ? 'text-emerald-600' : 'text-red-500' }}">
                                        {{ ff.recommande ? '✅ Oui' : '❌ Non' }}
                                    </span>
                                </td>
                                <td class="py-3 px-4 text-[12px] text-zinc-400">{{ ff.created_at|date('d/m/Y') }}</td>
                                <td class="py-3 px-4">
                                    <div class="flex gap-1.5">
                                        <button onclick="loadFfDetails({{ ff.id }})"
                                                class="text-[11px] font-semibold px-2.5 py-1.5 rounded-lg bg-zinc-100 text-zinc-600 hover:bg-zinc-200">👁️</button>
                                        <button onclick="openEditFf({{ ff|json_encode|e('html_attr') }})"
                                                class="text-[11px] font-semibold px-2.5 py-1.5 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 hover:bg-amber-100">✏️</button>
                                        <form action="{{ path('employee_relation_ff_delete', {id: ff.id}) }}" method="POST" class="inline"
                                              onsubmit="return confirm('Supprimer cette évaluation ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('ff-del-' ~ ff.id) }}">
                                            <button class="text-[11px] font-semibold px-2.5 py-1.5 rounded-lg bg-red-50 text-red-700 border border-red-200 hover:bg-red-100">🗑️</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% else %}
                            <tr><td colspan="6" class="py-12 text-center text-zinc-400 text-sm">Aucune évaluation soumise.</td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

        </main>
    </div>
</div>

{# Details Modal #}
<div id="modalFfDetails" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeModal('modalFfDetails')"></div>
    <div class="relative flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden animate-slide-up">
            <div class="bg-gradient-to-r from-slate-900 to-slate-700 px-5 py-4 flex items-center justify-between">
                <h5 class="text-white font-bold text-[15px]">🎓 Détails de l'évaluation</h5>
                <button onclick="closeModal('modalFfDetails')" class="text-white/60 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <div id="ffDetailsBody" class="p-5 space-y-2 text-sm text-zinc-600"></div>
            <div class="px-5 pb-5 flex justify-end">
                <button onclick="closeModal('modalFfDetails')" class="px-4 py-2 rounded-lg text-[12px] font-semibold text-zinc-500 bg-zinc-100 hover:bg-zinc-200">Fermer</button>
            </div>
        </div>
    </div>
</div>

{# Edit FF Modal #}
<div id="modalEditFf" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeModal('modalEditFf')"></div>
    <div class="relative flex items-center justify-center min-h-screen p-4">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md overflow-hidden animate-slide-up" style="max-height:90vh;overflow-y:auto">
            <div class="bg-gradient-to-r from-slate-900 to-slate-700 px-5 py-4 flex items-center justify-between sticky top-0 z-10">
                <h5 class="text-white font-bold text-[15px]">✏️ Modifier l'évaluation</h5>
                <button onclick="closeModal('modalEditFf')" class="text-white/60 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <form id="editFfForm" method="POST">
                <div class="p-5 space-y-3">
                    <div><label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1">Note <span id="editFfRatingDisplay" class="text-amber-500 ml-1">⭐ 3</span></label>
                        <input type="range" min="1" max="5" value="3" step="1" id="editFfRatingRange" name="rating"
                               oninput="document.getElementById('editFfRatingDisplay').textContent = '⭐ ' + this.value;"
                               class="w-full h-2 bg-zinc-200 rounded-lg cursor-pointer accent-amber-500"></div>
                    <div><label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1">📚 Contenu</label>
                        <textarea name="contenu_comment" id="editFfContenu" rows="2" class="w-full rounded-lg border border-zinc-200 px-3 py-2 text-sm focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 resize-none"></textarea></div>
                    <div><label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1">👨‍🏫 Formateur</label>
                        <textarea name="formateur_comment" id="editFfFormateur" rows="2" class="w-full rounded-lg border border-zinc-200 px-3 py-2 text-sm focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 resize-none"></textarea></div>
                    <div><label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1">🗂️ Organisation</label>
                        <textarea name="organisation_comment" id="editFfOrganisation" rows="2" class="w-full rounded-lg border border-zinc-200 px-3 py-2 text-sm focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 resize-none"></textarea></div>
                    <label class="flex items-center gap-2 text-sm font-semibold text-zinc-700 cursor-pointer">
                        <input type="checkbox" name="recommande" id="editFfRec" class="rounded border-zinc-300 text-cyan-600"> Je recommande cette formation
                    </label>
                </div>
                <div class="px-5 pb-5 flex gap-2 justify-end">
                    <button type="button" onclick="closeModal('modalEditFf')" class="px-4 py-2 rounded-lg text-[12px] font-semibold text-zinc-500 bg-zinc-100 hover:bg-zinc-200">Annuler</button>
                    <button type="submit" class="px-4 py-2 rounded-lg bg-gradient-to-r from-slate-900 to-slate-700 text-white font-bold text-[12px]">Sauvegarder</button>
                </div>
            </form>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function openModal(id)  { document.getElementById(id).classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
function closeModal(id) { document.getElementById(id).classList.add('hidden');    document.body.style.overflow = ''; }
document.addEventListener('keydown', e => { if (e.key === 'Escape') ['modalFfDetails','modalEditFf'].forEach(closeModal); });

// Load sessions when formation changes
function loadSessions(formationId) {
    const sel = document.getElementById('sessionSelect');
    sel.innerHTML = '<option value="">Chargement...</option>';
    if (!formationId) { sel.innerHTML = '<option value="">Sélectionnez d\'abord une formation</option>'; return; }
    fetch('/employee/relations/feedbacks-formation/sessions?formation_id=' + formationId)
        .then(r => r.json())
        .then(sessions => {
            sel.innerHTML = '<option value="">Aucune session spécifique</option>';
            sessions.forEach(s => {
                sel.innerHTML += `<option value="${s.id_session}">${s.date_debut} — ${s.lieu}</option>`;
            });
        });
}

// Load FF details
function loadFfDetails(id) {
    fetch('/employee/relations/ff/' + id + '/details')
        .then(r => r.json())
        .then(ff => {
            const row = (l, v) => `<div class="flex gap-3"><span class="text-zinc-400 font-semibold w-32 shrink-0">${l}</span><span class="text-zinc-700">${v ?? '-'}</span></div>`;
            const stars = Array(5).fill(0).map((_, i) => i < ff.rating ? '★' : '☆').join('');
            let html = row('Formation', ff.formation_name) + row('Session', ff.session_name) + row('Note', `<span class="text-amber-500">${stars}</span> (${ff.rating}/5)`) + row('Recommandé', ff.recommande ? '✅ Oui' : '❌ Non') + row('Date', ff.created_at?.substring(0,10));
            if (ff.contenu_comment) html += `<div class="mt-3 pt-3 border-t border-zinc-100"><p class="text-zinc-400 font-semibold text-[11px] uppercase mb-1">Contenu</p><p>${ff.contenu_comment}</p></div>`;
            if (ff.formateur_comment) html += `<div class="mt-2"><p class="text-zinc-400 font-semibold text-[11px] uppercase mb-1">Formateur</p><p>${ff.formateur_comment}</p></div>`;
            if (ff.organisation_comment) html += `<div class="mt-2"><p class="text-zinc-400 font-semibold text-[11px] uppercase mb-1">Organisation</p><p>${ff.organisation_comment}</p></div>`;
            document.getElementById('ffDetailsBody').innerHTML = html;
            openModal('modalFfDetails');
        });
}

function openEditFf(ff) {
    document.getElementById('editFfRatingRange').value = ff.rating || 3;
    document.getElementById('editFfRatingDisplay').textContent = '⭐ ' + (ff.rating || 3);
    document.getElementById('editFfContenu').value      = ff.contenu_comment || '';
    document.getElementById('editFfFormateur').value    = ff.formateur_comment || '';
    document.getElementById('editFfOrganisation').value = ff.organisation_comment || '';
    document.getElementById('editFfRec').checked        = !!ff.recommande;
    document.getElementById('editFfForm').action        = '/employee/relations/feedbacks-formation/' + ff.id + '/edit';
    openModal('modalEditFf');
}
</script>
{% endblock %}
