                    {% endif %}
                    <div><label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1">Commentaire</label>
                        <textarea name="comment" id="editFbComment" rows="3" class="w-full rounded-lg border border-zinc-200 px-3 py-2 text-sm focus:outline-none focus:border-cyan-400 focus:ring-2 focus:ring-cyan-100 resize-none">{{ fbEditOld.comment ?? '' }}</textarea>
                    </div>
                    {% if fbEditErrors.comment is defined %}
                        <p class="text-[11px] text-red-600 mt-1">{{ fbEditErrors.comment }}</p>
                    {% endif %}
                    <label class="flex items-center gap-2 text-[12px] font-semibold text-zinc-700 cursor-pointer">
                        <input type="checkbox" name="is_anonymous" id="editFbAnon" class="rounded border-zinc-300 text-cyan-600" {{ fbEditOld.is_anonymous is defined and fbEditOld.is_anonymous ? 'checked' : '' }}> Envoyer anonymement
