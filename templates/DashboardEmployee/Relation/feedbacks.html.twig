{% block javascripts %}
{{ parent() }}
<script>
// ─── Tab switching ─────────────────────────────────────────────────
function switchTab(name) {
    ['employee', 'formation'].forEach(t => {
        document.getElementById('panel-' + t).classList.toggle('hidden', t !== name);
        const btn = document.getElementById('tab-btn-' + t);
        btn.classList.toggle('border-cyan-500', t === name);
        btn.classList.toggle('text-cyan-600',   t === name);
        btn.classList.toggle('border-transparent', t !== name);
        btn.classList.toggle('text-zinc-400',   t !== name);
    });
    history.replaceState(null, '', '?tab=' + name);
}

// ─── Modals ────────────────────────────────────────────────────────
function openModal(id)  { document.getElementById(id).classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
function closeModal(id) { document.getElementById(id).classList.add('hidden');    document.body.style.overflow = ''; }
document.addEventListener('keydown', e => {
    if (e.key === 'Escape') ['modalFbDetails','modalEditFb','modalFfDetails','modalEditFf'].forEach(closeModal);
});

// ─── Rating slider (formulaire envoi) ──────────────────────────────
function updateRating(v) {
    document.getElementById('ratingDisplay').textContent = '⭐ ' + v + ' / 5';
    document.getElementById('ratingHidden').value = v;
}

// ─── Détails feedback employé ──────────────────────────────────────
function loadFbDetails(id) {
    fetch('/employee/relations/feedbacks/' + id + '/details')
        .then(r => r.json())
        .then(fb => {
            const row = (l, v) => `<div class="flex gap-3"><span class="text-zinc-400 font-semibold w-28 shrink-0">${l}</span><span class="text-zinc-700">${v ?? '-'}</span></div>`;
            const stars = Array(5).fill(0).map((_, i) => i < fb.rating ? '★' : '☆').join('');
            let html = row('De', fb.from_username) + row('À', fb.to_username) + row('Type', fb.feedback_type)
                     + row('Note', `<span class="text-amber-500">${stars}</span> (${fb.rating}/5)`)
                     + row('Date', fb.created_at?.substring(0, 10));
            if (fb.comment) html += `<div class="mt-3 pt-3 border-t border-zinc-100"><p class="text-zinc-400 font-semibold text-[11px] uppercase mb-1">Commentaire</p><p>${fb.comment}</p></div>`;
            document.getElementById('fbDetailsBody').innerHTML = html;
            openModal('modalFbDetails');
        });
}

// ─── Modifier feedback employé ─────────────────────────────────────
function openEditFb(fb) {
    document.getElementById('editFbType').value      = fb.feedback_type || 'performance';
    document.getElementById('editRatingRange').value  = fb.rating || 3;
    document.getElementById('editRatingHidden').value = fb.rating || 3;
    document.getElementById('editRatingDisplay').textContent = '⭐ ' + (fb.rating || 3);
    document.getElementById('editFbComment').value    = fb.comment || '';
    document.getElementById('editFbAnon').checked     = !!fb.is_anonymous;
    document.getElementById('editFbForm').action      = '/employee/relations/feedbacks/' + fb.id + '/edit';
    openModal('modalEditFb');
}

// ─── Sessions (AJAX) ───────────────────────────────────────────────
const ffOldFormationId = {{ (ffOld is iterable and 'formation_id' in ffOld and ffOld['formation_id']) ? ffOld['formation_id'] : 'null' }};
const ffOldSessionId = {{ (ffOld is iterable and 'session_id' in ffOld and ffOld['session_id']) ? ffOld['session_id'] : 'null' }};

function loadSessions(formationId) {
    const sel = document.getElementById('sessionSelect');
    sel.innerHTML = '<option value="">Chargement...</option>';
    if (!formationId) { sel.innerHTML = '<option value="">Sélectionnez d\'abord une formation</option>'; return; }
    fetch('/employee/relations/feedbacks-formation/sessions?formation_id=' + formationId)
        .then(r => r.json())
        .then(sessions => {
            sel.innerHTML = '<option value="">Aucune session spécifique</option>';
            sessions.forEach(s => {
                sel.innerHTML += `<option value="${s.id_session}">${s.date_debut} — ${s.lieu}</option>`;
            });
            if (ffOldSessionId) {
                sel.value = String(ffOldSessionId);
            }
        });
}

// ─── Détails feedback formation ────────────────────────────────────
function loadFfDetails(id) {
    fetch('/employee/relations/ff/' + id + '/details')
        .then(r => r.json())
        .then(ff => {
            const row = (l, v) => `<div class="flex gap-3"><span class="text-zinc-400 font-semibold w-32 shrink-0">${l}</span><span class="text-zinc-700">${v ?? '-'}</span></div>`;
            const stars = Array(5).fill(0).map((_, i) => i < ff.rating ? '★' : '☆').join('');
            let html = row('Formation', ff.formation_name) + row('Session', ff.session_name)
                     + row('Note', `<span class="text-amber-500">${stars}</span> (${ff.rating}/5)`)
                     + row('Recommandé', ff.recommande ? '✅ Oui' : '❌ Non')
                     + row('Date', ff.created_at?.substring(0, 10));
            if (ff.contenu_comment)      html += `<div class="mt-3 pt-3 border-t border-zinc-100"><p class="text-zinc-400 font-semibold text-[11px] uppercase mb-1">Contenu</p><p>${ff.contenu_comment}</p></div>`;
            if (ff.formateur_comment)    html += `<div class="mt-2"><p class="text-zinc-400 font-semibold text-[11px] uppercase mb-1">Formateur</p><p>${ff.formateur_comment}</p></div>`;
            if (ff.organisation_comment) html += `<div class="mt-2"><p class="text-zinc-400 font-semibold text-[11px] uppercase mb-1">Organisation</p><p>${ff.organisation_comment}</p></div>`;
            document.getElementById('ffDetailsBody').innerHTML = html;
            openModal('modalFfDetails');
        });
}

// ─── Modifier feedback formation ───────────────────────────────────
function openEditFf(ff) {
    document.getElementById('editFfRatingRange').value  = ff.rating || 3;
    document.getElementById('editFfRatingDisplay').textContent = '⭐ ' + (ff.rating || 3);
    document.getElementById('editFfContenu').value      = ff.contenu_comment || '';
    document.getElementById('editFfFormateur').value    = ff.formateur_comment || '';
    document.getElementById('editFfOrganisation').value = ff.organisation_comment || '';
    document.getElementById('editFfRec').checked        = !!ff.recommande;
    document.getElementById('editFfForm').action        = '/employee/relations/feedbacks-formation/' + ff.id + '/edit';
    openModal('modalEditFf');
}

if (ffOldFormationId) {
    loadSessions(ffOldFormationId);
}

{% if fbEditErrors is not empty %}
openModal('modalEditFb');
{% endif %}
{% if ffEditErrors is not empty %}
openModal('modalEditFf');
{% endif %}
</script>
{% endblock %}
