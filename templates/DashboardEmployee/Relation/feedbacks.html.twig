            <div class="bg-gradient-to-r from-slate-900 to-slate-700 px-5 py-4 flex items-center justify-between">
                <h5 class="text-white font-bold text-[15px]">✏️ Modifier le Feedback</h5>
                <button onclick="closeModal('modalEditFb')" class="text-white/60 hover:text-white">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <form id="editFbForm" method="POST" action="{{ fbEditId ? path('employee_relation_feedback_edit', {id: fbEditId}) : '' }}">
                <div class="p-5 space-y-3">
                    <div><label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1">Type</label>
                        <select name="feedback_type" id="editFbType" class="w-full rounded-lg border border-zinc-200 px-3 py-2 text-sm focus:outline-none focus:border-cyan-400">
                            {% set editFbType = fbEditOld.feedback_type ?? 'performance' %}
                            {% for ft in feedbackTypes %}<option value="{{ ft }}" {{ editFbType == ft ? 'selected' : '' }}>{{ ft|capitalize }}</option>{% endfor %}
                        </select>
                    </div>
                    {% if fbEditErrors.feedback_type is defined %}
                        <p class="text-[11px] text-red-600 mt-1">{{ fbEditErrors.feedback_type }}</p>
                    {% endif %}
                    <div>
                        {% set editFbRating = fbEditOld.rating ?? 3 %}
                        <label class="block text-[11px] font-bold uppercase tracking-[0.1em] text-zinc-400 mb-1">Note <span id="editRatingDisplay" class="text-amber-500 ml-1">⭐ {{ editFbRating }}</span></label>
                        <input type="range" min="1" max="5" value="{{ editFbRating }}" step="1" id="editRatingRange"
                               oninput="document.getElementById('editRatingDisplay').textContent = '⭐ ' + this.value; document.getElementById('editRatingHidden').value = this.value;"
                               class="w-full h-2 bg-zinc-200 rounded-lg cursor-pointer accent-amber-500">
