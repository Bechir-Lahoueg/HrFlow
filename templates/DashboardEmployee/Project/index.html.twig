{% extends 'base.html.twig' %}

{% block title %}Mes Projets — HRFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
:root {
    --primary: #7c3aed;
    --primary-light: #a78bfa;
    --primary-dark: #5b21b6;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --surface: #ffffff;
    --bg: #f5f3ff;
    --border: #e5e7eb;
    --text: #1f2937;
    --text-muted: #6b7280;
    --radius: 12px;
    --shadow-sm: 0 1px 3px rgba(0,0,0,.08);
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,.1);
    --shadow-lg: 0 10px 15px -3px rgba(0,0,0,.1);
}
body { background: var(--bg); font-family: 'Segoe UI', system-ui, sans-serif; }

.page-hero {
    background: linear-gradient(135deg, #4c1d95 0%, var(--primary) 60%, var(--primary-light) 100%);
    border-radius: var(--radius);
    padding: 2rem 2.5rem;
    color: white;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-lg);
}
.page-hero h1 { font-size: 1.7rem; font-weight: 800; margin: 0; }
.page-hero p { margin: .3rem 0 0; opacity: .8; font-size: .875rem; }

.stat-card {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    transition: all .2s;
    height: 100%;
    text-align: center;
}
.stat-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.stat-value { font-size: 2rem; font-weight: 900; line-height: 1; }
.stat-label { font-size: .75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; margin-top: .3rem; }

.card-section {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    margin-bottom: 1.5rem;
}
.section-header { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 1rem; display: flex; align-items: center; gap: .5rem; }

.project-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg);
    margin-bottom: .6rem;
    transition: all .2s;
    text-decoration: none;
    color: inherit;
}
.project-row:hover { border-color: var(--primary-light); background: #f5f3ff; transform: translateX(4px); }
.project-dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
.project-dot.in_progress { background: var(--success); }
.project-dot.planning { background: var(--text-muted); }
.project-dot.on_hold { background: var(--warning); }
.project-dot.completed { background: #3b82f6; }
.project-dot.cancelled { background: var(--danger); }
.project-info { flex: 1; min-width: 0; }
.project-name { font-weight: 700; font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.project-role { font-size: .75rem; color: var(--text-muted); }
.progress-mini { width: 80px; height: 5px; background: var(--border); border-radius: 999px; overflow: hidden; }
.progress-mini .fill { height: 100%; background: linear-gradient(90deg, var(--primary), var(--primary-light)); border-radius: 999px; }
.btn-open { background: var(--primary); color: white; border: none; padding: .35em .9em; border-radius: 8px; font-size: .75rem; font-weight: 600; cursor: pointer; text-decoration: none; white-space: nowrap; transition: all .15s; }
.btn-open:hover { background: var(--primary-dark); color: white; }

/* Tasks Table */
.tasks-filter { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
.filter-chip {
    padding: .3em .9em;
    border-radius: 999px;
    border: 1.5px solid var(--border);
    font-size: .8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all .15s;
    text-decoration: none;
    color: var(--text-muted);
    background: var(--surface);
}
.filter-chip.active, .filter-chip:hover { background: var(--primary); border-color: var(--primary); color: white; }

.task-row {
    display: flex;
    align-items: center;
    gap: .75rem;
    padding: .75rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    margin-bottom: .4rem;
    background: var(--bg);
    transition: all .15s;
}
.task-row:hover { background: #f5f3ff; border-color: var(--primary-light); }
.task-status-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
.task-status-dot.todo { background: #9ca3af; }
.task-status-dot.in_progress { background: var(--warning); }
.task-status-dot.review { background: #7c3aed; }
.task-status-dot.done { background: var(--success); }
.task-info { flex: 1; min-width: 0; }
.task-title { font-weight: 600; font-size: .875rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.task-project { font-size: .72rem; color: var(--text-muted); }
.task-due { font-size: .75rem; white-space: nowrap; }
.task-due.overdue { color: var(--danger); font-weight: 600; }
.task-due.soon { color: var(--warning); font-weight: 600; }

.priority-badge { font-size: .65rem; padding: .2em .5em; border-radius: 999px; font-weight: 700; }
.prio-low { background: #d1fae5; color: #065f46; }
.prio-medium { background: #fef3c7; color: #92400e; }
.prio-high { background: #fee2e2; color: #991b1b; }

.empty-state { text-align: center; padding: 3rem 1rem; color: var(--text-muted); }
.empty-state .icon { font-size: 3rem; display: block; margin-bottom: .75rem; }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">

    {% include 'DashboardEmployee/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">

        {% include 'DashboardEmployee/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

    {% for type, messages in app.flashes %}
        {% for msg in messages %}
        <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show rounded-3 mb-3">
            {{ msg }}<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
        {% endfor %}
    {% endfor %}

    {# HERO #}
    <div class="page-hero">
        <h1>🎯 Mes Projets</h1>
        <p>Vos projets actifs, vos tâches et votre contribution à l'équipe</p>
    </div>

    {# STATS #}
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div style="font-size:1.8rem">🗂️</div>
                <div class="stat-value text-primary">{{ projects|length }}</div>
                <div class="stat-label">Mes Projets</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div style="font-size:1.8rem">✅</div>
                <div class="stat-value" style="color:var(--success)">{{ taskStats.completed_tasks }}</div>
                <div class="stat-label">Tâches Terminées</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div style="font-size:1.8rem">⏳</div>
                <div class="stat-value" style="color:var(--warning)">{{ taskStats.in_progress_tasks }}</div>
                <div class="stat-label">En Cours</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="stat-card">
                <div style="font-size:1.8rem">⏱️</div>
                <div class="stat-value" style="color:var(--primary)">{{ totalHours }}h</div>
                <div class="stat-label">Heures Travaillées</div>
            </div>
        </div>
    </div>

    {# MES PROJETS #}
    <div class="card-section">
        <div class="section-header">📋 Mes Projets Actifs ({{ projects|length }})</div>
        {% if projects is empty %}
        <div class="empty-state">
            <span class="icon">📭</span>
            <p>Vous n'êtes assigné à aucun projet pour le moment.</p>
        </div>
        {% else %}
        {% for project in projects %}
        <a href="{{ path('employee_project_show', {id: project.id}) }}" class="project-row" style="text-decoration:none; color:inherit;">
            <div class="project-dot {{ project.status }}"></div>
            <div class="project-info">
                <div class="project-name">{{ project.name }}</div>
                <div class="project-role">{{ project.role ?? 'Membre' }} · {{ project.worked_hours ?? 0 }}h / {{ project.assigned_hours ? (project.assigned_hours ~ 'h') : '∞' }}</div>
            </div>
            <div>
                <div class="progress-mini"><div class="fill" style="width:{{ project.completion_rate ?? 0 }}%"></div></div>
                <div style="font-size:.65rem; color:var(--text-muted); text-align:right; margin-top:.2rem">{{ project.completion_rate ?? 0 }}%</div>
            </div>
            <span class="btn-open">Kanban →</span>
        </a>
        {% endfor %}
        {% endif %}
    </div>

    {# MES TÂCHES #}
    <div class="card-section">
        <div class="section-header">✅ Mes Tâches ({{ myTasks|length }})</div>

        {# Filtres #}
        <div class="tasks-filter">
            <a href="{{ path('employee_project_index') }}" class="filter-chip {{ not statusFilter ? 'active' : '' }}">Toutes</a>
            <a href="{{ path('employee_project_index', {status: 'todo'}) }}" class="filter-chip {{ statusFilter == 'todo' ? 'active' : '' }}">📋 À faire</a>
            <a href="{{ path('employee_project_index', {status: 'in_progress'}) }}" class="filter-chip {{ statusFilter == 'in_progress' ? 'active' : '' }}">⏳ En cours</a>
            <a href="{{ path('employee_project_index', {status: 'review'}) }}" class="filter-chip {{ statusFilter == 'review' ? 'active' : '' }}">👁️ Review</a>
            <a href="{{ path('employee_project_index', {status: 'done'}) }}" class="filter-chip {{ statusFilter == 'done' ? 'active' : '' }}">✅ Terminées</a>
        </div>

        {% if myTasks is empty %}
        <div class="empty-state">
            <span class="icon">🎉</span>
            <p>Aucune tâche trouvée.</p>
        </div>
        {% else %}
        {% for task in myTasks %}
        {% set isOverdue = task.due_date and task.due_date < 'now'|date('Y-m-d') and task.status != 'done' %}
        {% set isSoon = task.due_date and task.due_date <= 'now'|date_modify('+2 days')|date('Y-m-d') and not isOverdue and task.status != 'done' %}
        <div class="task-row">
            <div class="task-status-dot {{ task.status }}"></div>
            <div class="task-info">
                <div class="task-title">{{ task.title }}</div>
                <div class="task-project">📂 {{ task.project_name }}</div>
            </div>
            <span class="priority-badge prio-{{ task.priority }}">{{ task.priority|upper }}</span>
            {% if task.due_date %}
            <div class="task-due {% if isOverdue %}overdue{% elseif isSoon %}soon{% endif %}">
                📅 {{ task.due_date|date('d/m') }}
                {% if isOverdue %} ⚠️{% elseif isSoon %} 🔥{% endif %}
            </div>
            {% endif %}
            <a href="{{ path('employee_project_show', {id: task.project_id}) }}" class="btn-open" style="font-size:.7rem">Ouvrir</a>
        </div>
        {% endfor %}
        {% endif %}

        {% if taskStats.overdue_tasks > 0 %}
        <div class="alert alert-danger mt-3 py-2 px-3" style="font-size:.85rem; border-radius:8px">
            ⚠️ Vous avez <strong>{{ taskStats.overdue_tasks }}</strong> tâche(s) en retard !
        </div>
        {% endif %}
    </div>

        </main>

    </div>

</div>
{% endblock %}
