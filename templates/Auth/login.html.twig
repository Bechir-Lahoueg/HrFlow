{% extends 'base.html.twig' %}

{% block title %}Login | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased flex">

    {# Left panel - branding #}
    <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        {# Decorative shapes #}
        <div class="absolute top-20 left-[10%] w-72 h-72 bg-teal-500/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-[10%] w-80 h-80 bg-purple-500/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-teal-400/5 rounded-full blur-3xl"></div>

        <div class="relative z-10 flex flex-col justify-between p-12 w-full">
            {# Brand #}
            <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 no-underline">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            {# Main content #}
            <div class="mt-auto mb-auto">
                <h1 class="text-4xl xl:text-5xl font-extrabold text-white leading-tight mb-6">
                    Connectez-vous a<br>
                    <span class="bg-gradient-to-r from-teal-400 to-emerald-400 bg-clip-text text-transparent">votre espace RH</span>
                </h1>
                <p class="text-lg text-slate-400 max-w-md leading-relaxed">
                    Suivez les candidatures, gerez vos equipes, et pilotez vos KPIs recrutement dans une interface simple et moderne.
                </p>

                {# Stats row #}
                <div class="flex items-center gap-8 mt-10">
                    <div>
                        <p class="text-2xl font-extrabold text-white">2,000+</p>
                        <p class="text-sm text-slate-500">Entreprises</p>
                    </div>
                    <div class="w-px h-10 bg-slate-700"></div>
                    <div>
                        <p class="text-2xl font-extrabold text-white">50k+</p>
                        <p class="text-sm text-slate-500">Employes</p>
                    </div>
                    <div class="w-px h-10 bg-slate-700"></div>
                    <div>
                        <p class="text-2xl font-extrabold text-white">99.9%</p>
                        <p class="text-sm text-slate-500">Uptime</p>
                    </div>
                </div>
            </div>

            {# Bottom quote #}
            <div class="mt-auto pt-10 border-t border-slate-700/50">
                <p class="text-sm text-slate-500 italic">"HrFlow a transforme notre processus de recrutement. Nous avons reduit notre temps d'embauche de 40%."</p>
                <p class="text-sm font-semibold text-slate-400 mt-2">— Sarah M., DRH</p>
            </div>
        </div>
    </div>

    {# Right panel - form #}
    <div class="w-full lg:w-1/2 flex items-center justify-center p-6 sm:p-12">
        <div class="w-full max-w-md">
            {# Mobile logo #}
            <a href="{{ path('app_home') }}" class="lg:hidden flex items-center gap-2.5 no-underline mb-10">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Bon retour</h2>
            <p class="text-slate-500 mb-8">Entrez vos informations pour continuer.</p>

            {% if error %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-sm text-red-600 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" class="space-y-5">
                <div>
                    <label for="identifier" class="block text-sm font-bold text-slate-700 mb-2">Email ou Username</label>
                    <input id="identifier" name="identifier" type="text"
                           placeholder="nom@entreprise.com ou Admin"
                           value="{{ last_username|default('') }}"
                           required
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 placeholder-slate-400 outline-none transition-all focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20">
                </div>

                <div>
                    <label for="password" class="block text-sm font-bold text-slate-700 mb-2">Mot de passe</label>
                    <input id="password" name="password" type="password"
                           placeholder="********"
                           required
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 placeholder-slate-400 outline-none transition-all focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" name="_remember_me" class="w-4 h-4 rounded border-slate-300 text-teal-600 focus:ring-teal-500">
                        <span class="text-sm text-slate-600">Se souvenir de moi</span>
                    </label>
                    <a href="#" class="text-sm font-semibold text-teal-600 hover:text-teal-700 transition-colors">Mot de passe oublie ?</a>
                </div>

                <button type="submit"
                        class="w-full py-3.5 px-6 text-base font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-full transition-all hover:shadow-xl hover:shadow-slate-900/20">
                    Se connecter
                </button>
            </form>

            <p class="text-center text-sm text-slate-500 mt-8">
                Retour a <a href="{{ path('app_home') }}" class="font-semibold text-teal-600 hover:text-teal-700 transition-colors">l'accueil</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
