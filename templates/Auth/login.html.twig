{% extends 'base.html.twig' %}

{% block title %}Login | HrFlow{% endblock %}

{% block stylesheets %}
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
	<style>
		:root {
			--bg: #f4f8f7;
			--text: #122025;
			--muted: #5e6e76;
			--line: #d6e1e5;
			--primary: #0f766e;
			--primary-dark: #0b5e58;
			--surface: #ffffff;
		}

		* {
			box-sizing: border-box;
			margin: 0;
			padding: 0;
		}

		body {
			font-family: 'Manrope', sans-serif;
			color: var(--text);
			background:
				radial-gradient(circle at 12% 18%, rgba(15, 118, 110, 0.12), transparent 35%),
				radial-gradient(circle at 90% 10%, rgba(14, 157, 146, 0.1), transparent 40%),
				var(--bg);
			min-height: 100vh;
			display: grid;
			place-items: center;
			padding: 1.2rem;
		}

		.login-shell {
			width: min(980px, 100%);
			display: grid;
			grid-template-columns: 1.05fr 0.95fr;
			border: 1px solid var(--line);
			border-radius: 22px;
			overflow: hidden;
			background: var(--surface);
			box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
		}

		.login-side {
			padding: 2rem;
			background: linear-gradient(145deg, #0f766e, #0ea79a);
			color: #fff;
		}

		.brand {
			display: inline-flex;
			align-items: center;
			gap: 0.55rem;
			text-decoration: none;
			color: #fff;
			margin-bottom: 1.3rem;
		}

		.brand img {
			width: 40px;
			height: 40px;
			border-radius: 10px;
			object-fit: cover;
			border: 1px solid rgba(255, 255, 255, 0.28);
		}

		.brand span {
			font-family: 'Space Grotesk', sans-serif;
			font-weight: 700;
			font-size: 1.1rem;
		}

		.login-side h1 {
			font-family: 'Space Grotesk', sans-serif;
			font-size: clamp(1.6rem, 3.2vw, 2.3rem);
			line-height: 1.12;
			margin-bottom: 0.8rem;
		}

		.login-side p {
			opacity: 0.9;
			line-height: 1.65;
			max-width: 34ch;
		}

		.login-side svg {
			display: block;
			width: 100%;
			margin-top: 1.4rem;
		}

		.login-form-wrap {
			padding: 2rem;
			display: flex;
			align-items: center;
		}

		.login-form {
			width: 100%;
			display: grid;
			gap: 0.95rem;
		}

		.login-form h2 {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 1.45rem;
			margin-bottom: 0.35rem;
		}

		.login-form p {
			color: var(--muted);
			margin-bottom: 0.6rem;
		}

		label {
			font-size: 0.9rem;
			font-weight: 700;
		}

		input {
			width: 100%;
			border: 1px solid var(--line);
			border-radius: 12px;
			padding: 0.8rem 0.9rem;
			font-size: 0.95rem;
			outline: none;
			transition: border-color 0.2s ease, box-shadow 0.2s ease;
		}

		input:focus {
			border-color: var(--primary);
			box-shadow: 0 0 0 3px rgba(15, 118, 110, 0.15);
		}

		.form-row {
			display: flex;
			justify-content: space-between;
			align-items: center;
			font-size: 0.87rem;
		}

		.form-row a {
			color: var(--primary);
			text-decoration: none;
			font-weight: 700;
		}

		button {
			border: none;
			border-radius: 999px;
			padding: 0.85rem 1.1rem;
			font-weight: 800;
			font-size: 0.92rem;
			background: linear-gradient(135deg, var(--primary), #0ea79a);
			color: #fff;
			cursor: pointer;
			transition: transform 0.2s ease, box-shadow 0.2s ease;
			box-shadow: 0 10px 26px rgba(15, 118, 110, 0.25);
		}

		button:hover {
			transform: translateY(-1px);
		}

		.back-home {
			margin-top: 0.4rem;
			font-size: 0.9rem;
			color: var(--muted);
		}

		.back-home a {
			color: var(--primary);
			font-weight: 700;
			text-decoration: none;
		}

		@media (max-width: 860px) {
			.login-shell {
				grid-template-columns: 1fr;
			}

			.login-side {
				padding: 1.5rem;
			}

			.login-side svg {
				max-height: 160px;
			}
		}
	</style>
{% endblock %}

{% block body %}
	<section class="login-shell" aria-label="Login page">
		<div class="login-side">
			<a href="{{ path('app_home') }}" class="brand" aria-label="Back to home">
				<img src="{{ asset('logo.png') }}" alt="HrFlow logo">
				<span>HrFlow</span>
			</a>
			<h1>Connectez-vous a votre espace RH</h1>
			<p>Suivez les candidatures, vos entretiens, et vos KPIs recrutement dans une interface simple.</p>
			<svg viewBox="0 0 360 180" role="img" aria-label="Illustration dashboard RH">
				<rect x="8" y="10" width="344" height="160" rx="16" fill="rgba(255,255,255,0.14)"/>
				<rect x="24" y="30" width="92" height="12" rx="6" fill="rgba(255,255,255,0.5)"/>
				<rect x="24" y="52" width="312" height="1" fill="rgba(255,255,255,0.32)"/>
				<rect x="24" y="66" width="96" height="86" rx="10" fill="rgba(255,255,255,0.24)"/>
				<rect x="132" y="66" width="96" height="86" rx="10" fill="rgba(255,255,255,0.24)"/>
				<rect x="240" y="66" width="96" height="86" rx="10" fill="rgba(255,255,255,0.24)"/>
				<circle cx="52" cy="98" r="10" fill="#fff" opacity="0.85"/>
				<circle cx="160" cy="98" r="10" fill="#fff" opacity="0.85"/>
				<circle cx="268" cy="98" r="10" fill="#fff" opacity="0.85"/>
			</svg>
		</div>

		<div class="login-form-wrap">
			<form class="login-form" method="post" action="{{ path('app_login') }}">
				<h2>Login</h2>
				<p>Entrez vos informations pour continuer.</p>

				{% if error %}
					<p style="color:#b42318;background:#fff0f0;border:1px solid #ffd0d0;padding:.6rem .75rem;border-radius:10px;">
						{{ error.messageKey|trans(error.messageData, 'security') }}
					</p>
				{% endif %}

				<label for="identifier">Email ou Username</label>
				<input id="identifier" name="identifier" type="text" placeholder="nom@entreprise.com ou Admin" value="{{ last_username|default('') }}" required>

				<label for="password">Password</label>
				<input id="password" name="password" type="password" placeholder="********" required>
				<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

				<div class="form-row">
					<label><input type="checkbox" name="_remember_me" style="width:auto; margin-right: 0.35rem;">Remember me</label>
					<a href="#">Mot de passe oublie ?</a>
				</div>

				<button type="submit">Se connecter</button>
				<p class="back-home">Retour a <a href="{{ path('app_home') }}">l'accueil</a>.</p>
			</form>
		</div>
	</section>
{% endblock %}
