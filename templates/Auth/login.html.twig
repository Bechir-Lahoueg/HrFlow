{% extends 'base.html.twig' %}

{% block title %}Login | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        @keyframes hintFadeIn {
            from { opacity: 0; transform: translateY(-3px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .login-input:user-invalid,
        .login-input:not(:placeholder-shown):invalid {
            border-color: #ef4444 !important;
            box-shadow: 0 0 0 3px rgba(239,68,68,0.12) !important;
        }
        .login-input:user-valid,
        .login-input:not(:placeholder-shown):valid {
            border-color: #22c55e !important;
            box-shadow: 0 0 0 3px rgba(34,197,94,0.12) !important;
        }
        .login-hint {
            display: none;
            font-size: 0.7rem;
            font-weight: 600;
            color: #ef4444;
            margin-top: 0.25rem;
            animation: hintFadeIn 0.15s ease-out;
        }
        .login-input:user-invalid + .login-hint,
        .login-input:not(:placeholder-shown):invalid + .login-hint {
            display: block;
        }
    </style>
{% endblock %}

{% block body %}
{% set lowerError = error ? (error.messageKey|lower) : '' %}
{% set showTotpByDefault = 'authenticator' in lowerError or '2fa' in lowerError or 'code google' in lowerError %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased flex">

    {# Left panel - branding #}
    <div class="hidden lg:flex lg:w-1/2 relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        {# Decorative shapes #}
        <div class="absolute top-20 left-[10%] w-72 h-72 bg-teal-500/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-[10%] w-80 h-80 bg-purple-500/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-teal-400/5 rounded-full blur-3xl"></div>

        <div class="relative z-10 flex flex-col justify-between p-12 w-full">
            {# Brand #}
            <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 no-underline">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            {# Main content #}
            <div class="mt-auto mb-auto">
                <h1 class="text-4xl xl:text-5xl font-extrabold text-white leading-tight mb-6">
                    Connectez-vous a<br>
                    <span class="bg-gradient-to-r from-teal-400 to-emerald-400 bg-clip-text text-transparent">votre espace RH</span>
                </h1>
                <p class="text-lg text-slate-400 max-w-md leading-relaxed">
                    Suivez les candidatures, gerez vos equipes, et pilotez vos KPIs recrutement dans une interface simple et moderne.
                </p>

                {# Stats row (real data) #}
                <div class="flex items-center gap-8 mt-10">
                    <div>
                        <p class="text-2xl font-extrabold text-white">{{ loginStats.employeesCount|number_format(0, '.', ' ') }}</p>
                        <p class="text-sm text-slate-500">Employes</p>
                    </div>
                    <div class="w-px h-10 bg-slate-700"></div>
                    <div>
                        <p class="text-2xl font-extrabold text-white">{{ loginStats.pendingLeavesCount|number_format(0, '.', ' ') }}</p>
                        <p class="text-sm text-slate-500">Conges en attente</p>
                    </div>
                    <div class="w-px h-10 bg-slate-700"></div>
                    <div>
                        <p class="text-2xl font-extrabold text-white">{{ loginStats.openPositionsCount|number_format(0, '.', ' ') }}</p>
                        <p class="text-sm text-slate-500">Offres ouvertes</p>
                    </div>
                </div>
            </div>

            {# Bottom quote #}
            <div class="mt-auto pt-10 border-t border-slate-700/50">
                <p class="text-sm text-slate-500 italic">"HrFlow a transforme notre processus de recrutement. Nous avons reduit notre temps d'embauche de 40%."</p>
                <p class="text-sm font-semibold text-slate-400 mt-2">— Sarah M., DRH</p>
            </div>
        </div>
    </div>

    {# Right panel - form #}
    <div class="w-full lg:w-1/2 flex items-center justify-center p-6 sm:p-12">
        <div class="w-full max-w-md">
            {# Mobile logo #}
            <a href="{{ path('app_home') }}" class="lg:hidden flex items-center gap-2.5 no-underline mb-10">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Bon retour</h2>
            <p class="text-slate-500 mb-8">Entrez vos informations pour continuer.</p>

            <div class="mb-6 grid grid-cols-3 gap-2">
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-center">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Etape 1</p>
                    <p class="text-xs font-semibold text-slate-700">Identifiant</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-center">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Etape 2</p>
                    <p class="text-xs font-semibold text-slate-700">Mot de passe</p>
                </div>
                <div id="step-2fa" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-center {{ showTotpByDefault ? 'ring-1 ring-teal-300 border-teal-300' : '' }}">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Etape 3</p>
                    <p class="text-xs font-semibold text-slate-700">Code 2FA</p>
                </div>
            </div>

            {% if error %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-sm text-red-600 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-sm text-emerald-700 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('warning') %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-amber-50 border border-amber-200 text-sm text-amber-700 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01"/></svg>
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('info') %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-sky-50 border border-sky-200 text-sm text-sky-700 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01"/></svg>
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-sm text-red-600 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01"/></svg>
                    {{ message }}
                </div>
            {% endfor %}

            <form method="post" action="{{ path('app_login') }}" class="space-y-5" novalidate data-2fa-status-url="{{ path('app_auth_2fa_status') }}">
                <div>
                    <label for="identifier" class="block text-sm font-bold text-slate-700 mb-2">Email ou Username</label>
                    <input id="identifier" name="identifier" type="text"
                           placeholder="nom@entreprise.com ou admin"
                           value="{{ last_username|default('') }}"
                           required
                           class="login-input w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 placeholder-slate-400 outline-none transition-all focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20">
                    <span class="login-hint">Veuillez entrer une adresse email valide</span>
                </div>

                <div>
                    <label for="password" class="block text-sm font-bold text-slate-700 mb-2">Mot de passe</label>
                    <input id="password" name="password" type="password"
                           placeholder="••••••••"
                           required
                           class="login-input w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 placeholder-slate-400 outline-none transition-all focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20">
                    <span class="login-hint">Ce champ est obligatoire</span>
                </div>

                <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                    <p id="twofa-status" class="text-xs font-medium text-slate-500">2FA detectee automatiquement selon le compte.</p>
                    <button id="toggle-2fa" type="button" class="text-xs font-semibold text-teal-600 hover:text-teal-700">Afficher le code 2FA</button>
                </div>

                <div id="totp-wrapper" class="{{ showTotpByDefault ? '' : 'hidden' }}">
                    <label for="totp_code" class="block text-sm font-bold text-slate-700 mb-2">Code Google Authenticator</label>
                    <input id="totp_code" name="totp_code" type="text"
                           placeholder="123456"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 placeholder-slate-400 outline-none transition-all focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20">
                    <p class="mt-2 text-xs text-slate-500">Requis uniquement si la double authentification est active sur votre compte.</p>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="flex items-center justify-between">
                    <span></span>
                    <a href="#" class="text-sm font-semibold text-teal-600 hover:text-teal-700 transition-colors">Mot de passe oublie ?</a>
                </div>

                <button type="submit"
                        class="w-full py-3.5 px-6 text-base font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-full transition-all hover:shadow-xl hover:shadow-slate-900/20">
                    Se connecter
                </button>
            </form>

            <p class="text-center text-sm text-slate-500 mt-8">
                Retour a <a href="{{ path('app_home') }}" class="font-semibold text-teal-600 hover:text-teal-700 transition-colors">l'accueil</a>
            </p>
        </div>
    </div>
</div>

<script>
(function () {
    const form = document.querySelector('form[data-2fa-status-url]');
    if (!form) return;

    const endpoint = form.getAttribute('data-2fa-status-url');
    const identifierInput = document.getElementById('identifier');
    const totpWrapper = document.getElementById('totp-wrapper');
    const totpInput = document.getElementById('totp_code');
    const toggleBtn = document.getElementById('toggle-2fa');
    const statusLabel = document.getElementById('twofa-status');
    const step2fa = document.getElementById('step-2fa');
    let timer = null;

    function showTotp(required, source) {
        const visible = required || !totpWrapper.classList.contains('hidden');
        if (required) {
            totpWrapper.classList.remove('hidden');
            totpInput.setAttribute('required', 'required');
            statusLabel.textContent = '2FA requise pour ce compte. Entrez le code Google Authenticator.';
            toggleBtn.textContent = 'Masquer le code 2FA';
            step2fa.classList.add('ring-1', 'ring-teal-300', 'border-teal-300');
            return;
        }

        if (source === 'manual' && visible) {
            const isHidden = totpWrapper.classList.toggle('hidden');
            if (isHidden) {
                totpInput.removeAttribute('required');
                statusLabel.textContent = '2FA detectee automatiquement selon le compte.';
                toggleBtn.textContent = 'Afficher le code 2FA';
                step2fa.classList.remove('ring-1', 'ring-teal-300', 'border-teal-300');
            } else {
                statusLabel.textContent = 'Activez ce champ si votre compte utilise Google Authenticator.';
                toggleBtn.textContent = 'Masquer le code 2FA';
                step2fa.classList.add('ring-1', 'ring-teal-300', 'border-teal-300');
            }
        }
    }

    async function checkTwoFactorStatus() {
        const identifier = (identifierInput.value || '').trim();
        if (identifier.length < 3) {
            return;
        }

        try {
            const response = await fetch(endpoint + '?identifier=' + encodeURIComponent(identifier), {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' }
            });
            const data = await response.json();
            showTotp(Boolean(data.required), 'auto');
        } catch (e) {
            // Keep silent; manual toggle still works.
        }
    }

    identifierInput.addEventListener('input', function () {
        if (timer) clearTimeout(timer);
        timer = setTimeout(checkTwoFactorStatus, 280);
    });

    toggleBtn.addEventListener('click', function () {
        showTotp(false, 'manual');
    });

    if (identifierInput.value.trim().length >= 3) {
        checkTwoFactorStatus();
    }
})();
</script>
{% endblock %}
