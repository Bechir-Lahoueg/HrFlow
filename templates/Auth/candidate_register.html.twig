{% extends 'base.html.twig' %}

{% block title %}Inscription Candidat | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased flex">

    {# Left panel - branding #}
    <div class="hidden md:flex w-1/2 relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        {# Decorative shapes #}
        <div class="absolute top-20 left-[10%] w-72 h-72 bg-teal-500/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-[10%] w-80 h-80 bg-purple-500/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-teal-400/5 rounded-full blur-3xl"></div>

        <div class="relative z-10 flex flex-col justify-between p-12 w-full">
            {# Brand #}
            <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 no-underline">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            {# Main content #}
            <div class="mt-auto mb-auto">
                <h1 class="text-4xl xl:text-5xl font-extrabold text-white leading-tight mb-6">
                    Creez votre compte<br>
                    <span class="bg-gradient-to-r from-teal-400 to-emerald-400 bg-clip-text text-transparent">candidat</span>
                </h1>
                <p class="text-lg text-slate-400 max-w-md leading-relaxed">
                    Rejoignez notre plateforme pour postuler aux offres d'emploi et suivre vos candidatures en temps reel.
                </p>

                {# Benefits #}
                <div class="flex flex-col gap-4 mt-10">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-slate-700/50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        </div>
                        <span class="text-slate-300 font-medium">Postulez aux offres en un clic</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-slate-700/50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2z"/></svg>
                        </div>
                        <span class="text-slate-300 font-medium">Suivez vos candidatures</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-slate-700/50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                        </div>
                        <span class="text-slate-300 font-medium">Recevez des alertes</span>
                    </div>
                </div>
            </div>

            {# Bottom quote #}
            <div class="mt-auto pt-10 border-t border-slate-700/50">
                <p class="text-sm text-slate-500 italic">"J'ai trouve mon emploi de reve grace a HrFlow. Le processus etait simple et rapide."</p>
                <p class="text-sm font-semibold text-slate-400 mt-2">— Amine K., Developpeur Web</p>
            </div>
        </div>
    </div>

    {# Right panel - form #}
    <div class="w-full md:w-1/2 flex items-center justify-center p-6 sm:p-12">
        <div class="w-full max-w-md">
            {# Mobile logo #}
            <a href="{{ path('app_home') }}" class="md:hidden flex items-center gap-2.5 no-underline mb-10">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Creer un compte</h2>
            <p class="text-slate-500 mb-8">Remplissez le formulaire pour commencer votre recherche d'emploi.</p>

            {% for flash_error in app.flashes('error') %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-sm text-red-600 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    {{ flash_error }}
                </div>
            {% endfor %}


            {{ form_start(form, {'attr': {'class': 'space-y-5', 'novalidate': 'novalidate'}}) }}

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        {{ form_label(form.firstName) }}
                        {{ form_widget(form.firstName) }}
                        {{ form_errors(form.firstName) }}
                    </div>
                    <div>
                        {{ form_label(form.lastName) }}
                        {{ form_widget(form.lastName) }}
                        {{ form_errors(form.lastName) }}
                    </div>
                </div>

                <div>
                    {{ form_label(form.username) }}
                    {{ form_widget(form.username) }}
                    {{ form_errors(form.username) }}
                </div>

                <div>
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <div>
                    {{ form_label(form.phone) }}
                    {{ form_widget(form.phone) }}
                    {{ form_errors(form.phone) }}
                </div>

                <div>
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first) }}
                    {{ form_errors(form.plainPassword.first) }}
                </div>

                <div>
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_widget(form.plainPassword.second) }}
                    {{ form_errors(form.plainPassword.second) }}
                </div>

                <button type="submit"
                        class="w-full py-3.5 px-6 text-base font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-full transition-all hover:shadow-xl hover:shadow-emerald-600/20">
                    Creer mon compte
                </button>

            {{ form_end(form) }}

            <p class="text-center text-sm text-slate-500 mt-8">
                Deja un compte ? <a href="{{ path('app_candidate_login') }}" class="font-semibold text-emerald-600 hover:text-emerald-700 transition-colors">Se connecter</a>
            </p>

            <p class="text-center text-sm text-slate-400 mt-4">
                <a href="{{ path('app_home') }}" class="hover:text-slate-600 transition-colors">Retour a l'accueil</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
