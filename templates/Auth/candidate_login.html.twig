{% extends 'base.html.twig' %}

{% block title %}Connexion Candidat | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased flex">

    {# Left panel - branding #}
    <div class="hidden md:flex w-1/2 relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        {# Decorative shapes #}
        <div class="absolute top-20 left-[10%] w-72 h-72 bg-teal-500/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-[10%] w-80 h-80 bg-purple-500/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-teal-400/5 rounded-full blur-3xl"></div>

        <div class="relative z-10 flex flex-col justify-between p-12 w-full">
            {# Brand #}
            <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 no-underline">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            {# Main content #}
            <div class="mt-auto mb-auto">
                <h1 class="text-4xl xl:text-5xl font-extrabold text-white leading-tight mb-6">
                    Bienvenue<br>
                    <span class="bg-gradient-to-r from-teal-400 to-emerald-400 bg-clip-text text-transparent">candidat</span>
                </h1>
                <p class="text-lg text-slate-400 max-w-md leading-relaxed">
                    Connectez-vous pour postuler aux offres d'emploi et suivre vos candidatures.
                </p>

                {# Stats #}
                <div class="flex items-center gap-8 mt-10">
                    <div>
                        <p class="text-2xl font-extrabold text-white">500+</p>
                        <p class="text-sm text-slate-500">Offres actives</p>
                    </div>
                    <div class="w-px h-10 bg-slate-700"></div>
                    <div>
                        <p class="text-2xl font-extrabold text-white">10k+</p>
                        <p class="text-sm text-slate-500">Candidats</p>
                    </div>
                    <div class="w-px h-10 bg-slate-700"></div>
                    <div>
                        <p class="text-2xl font-extrabold text-white">95%</p>
                        <p class="text-sm text-slate-500">Taux de reponse</p>
                    </div>
                </div>
            </div>

            {# Bottom quote #}
            <div class="mt-auto pt-10 border-t border-slate-700/50">
                <p class="text-sm text-slate-500 italic">"La meilleure plateforme pour trouver un emploi en Tunisie."</p>
                <p class="text-sm font-semibold text-slate-400 mt-2">— Leila M., Chargee de recrutement</p>
            </div>
        </div>
    </div>

    {# Right panel - form #}
    <div class="w-full md:w-1/2 flex items-center justify-center p-6 sm:p-12">
        <div class="w-full max-w-md">
            {# Mobile logo #}
            <a href="{{ path('app_home') }}" class="md:hidden flex items-center gap-2.5 no-underline mb-10">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Connexion candidat</h2>
            <p class="text-slate-500 mb-8">Entrez vos informations pour acceder a votre espace.</p>

            {% if error %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-sm text-red-600 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_candidate_login') }}" class="space-y-5">
                <div>
                    <label for="identifier" class="block text-sm font-bold text-slate-700 mb-2">Email ou Username</label>
                    <input id="identifier" name="identifier" type="text"
                           placeholder="nom@email.com ou jdupont"
                           value="{{ last_username|default('') }}"
                           required
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 placeholder-slate-400 outline-none transition-all focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20">
                </div>

                <div>
                    <label for="password" class="block text-sm font-bold text-slate-700 mb-2">Mot de passe</label>
                    <input id="password" name="password" type="password"
                           placeholder="********"
                           required
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 placeholder-slate-400 outline-none transition-all focus:border-emerald-500 focus:ring-2 focus:ring-emerald-500/20">
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="flex items-center justify-between">
                    <span></span>
                    <a href="#" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors">Mot de passe oublie ?</a>
                </div>

                <button type="submit"
                        class="w-full py-3.5 px-6 text-base font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-full transition-all hover:shadow-xl hover:shadow-emerald-600/20">
                    Se connecter
                </button>
            </form>

            <div class="text-center space-y-3 mt-8">
                <p class="text-sm text-slate-500">
                    Pas encore de compte ? <a href="{{ path('app_candidate_register') }}" class="font-semibold text-emerald-600 hover:text-emerald-700 transition-colors">S'inscrire</a>
                </p>
                <p class="text-sm text-slate-400">
                    <a href="{{ path('app_home') }}" class="hover:text-slate-600 transition-colors">Retour a l'accueil</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
