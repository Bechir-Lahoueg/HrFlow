{% extends 'base.html.twig' %}

{% block title %}Connexion Candidat | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
{% set lowerError = error ? (error.messageKey|lower) : '' %}
{% set showTotpByDefault = 'authenticator' in lowerError or '2fa' in lowerError or 'code google' in lowerError %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased flex">

    {# Left panel - branding #}
    <div class="hidden md:flex w-1/2 relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
        {# Decorative shapes #}
        <div class="absolute top-20 left-[10%] w-72 h-72 bg-teal-500/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 right-[10%] w-80 h-80 bg-purple-500/10 rounded-full blur-3xl"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-teal-400/5 rounded-full blur-3xl"></div>

        <div class="relative z-10 flex flex-col justify-between p-12 w-full">
            {# Brand #}
            <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 no-underline">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            {# Main content #}
            <div class="mt-auto mb-auto">
                <h1 class="text-4xl xl:text-5xl font-extrabold text-white leading-tight mb-6">
                    Bienvenue<br>
                    <span class="bg-gradient-to-r from-teal-400 to-emerald-400 bg-clip-text text-transparent">candidat</span>
                </h1>
                <p class="text-lg text-slate-400 max-w-md leading-relaxed">
                    Connectez-vous pour postuler aux offres d'emploi et suivre vos candidatures.
                </p>

                {# Stats (real data) #}
                <div class="flex items-center gap-8 mt-10">
                    <div>
                        <p class="text-2xl font-extrabold text-white">{{ candidateStats.openOffersCount|number_format(0, '.', ' ') }}</p>
                        <p class="text-sm text-slate-500">Offres actives</p>
                    </div>
                    <div class="w-px h-10 bg-slate-700"></div>
                    <div>
                        <p class="text-2xl font-extrabold text-white">{{ candidateStats.candidatesCount|number_format(0, '.', ' ') }}</p>
                        <p class="text-sm text-slate-500">Candidats</p>
                    </div>
                    <div class="w-px h-10 bg-slate-700"></div>
                    <div>
                        <p class="text-2xl font-extrabold text-white">{{ candidateStats.responseRate }}%</p>
                        <p class="text-sm text-slate-500">Taux de reponse</p>
                    </div>
                </div>
            </div>

            {# Bottom quote #}
            <div class="mt-auto pt-10 border-t border-slate-700/50">
                <p class="text-sm text-slate-500 italic">"La meilleure plateforme pour trouver un emploi en Tunisie."</p>
                <p class="text-sm font-semibold text-slate-400 mt-2">— Leila M., Chargee de recrutement</p>
            </div>
        </div>
    </div>

    {# Right panel - form #}
    <div class="w-full md:w-1/2 flex items-center justify-center p-6 sm:p-12">
        <div class="w-full max-w-md">
            {# Mobile logo #}
            <a href="{{ path('app_home') }}" class="md:hidden flex items-center gap-2.5 no-underline mb-10">
                <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
            </a>

            <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Connexion candidat</h2>
            <p class="text-slate-500 mb-8">Entrez vos informations pour acceder a votre espace.</p>

            <div class="mb-6 grid grid-cols-3 gap-2">
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-center">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Etape 1</p>
                    <p class="text-xs font-semibold text-slate-700">Identifiant</p>
                </div>
                <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-center">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Etape 2</p>
                    <p class="text-xs font-semibold text-slate-700">Mot de passe</p>
                </div>
                <div id="candidate-step-2fa" class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2 text-center {{ showTotpByDefault ? 'ring-1 ring-emerald-300 border-emerald-300' : '' }}">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-slate-500">Etape 3</p>
                    <p class="text-xs font-semibold text-slate-700">Code 2FA</p>
                </div>
            </div>

            {% if error %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-sm text-red-600 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% for message in app.flashes('success') %}
                <div class="mb-6 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-sm text-emerald-700 font-medium flex items-center gap-2">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{ message }}
                </div>
            {% endfor %}

            {{ form_start(form, { attr: {'data-2fa-status-url': path('app_auth_2fa_status')} }) }}
                {{ form_row(form.identifier) }}
                {{ form_row(form.password) }}

                <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
                    <p id="candidate-twofa-status" class="text-xs font-medium text-slate-500">2FA detectee automatiquement selon le compte.</p>
                    <button id="candidate-toggle-2fa" type="button" class="text-xs font-semibold text-emerald-600 hover:text-emerald-700">Afficher le code 2FA</button>
                </div>

                <div id="candidate-totp-wrapper" class="{{ showTotpByDefault ? '' : 'hidden' }}">
                    {{ form_row(form.totp_code) }}
                    <p class="-mt-3 text-xs text-slate-500">Requis uniquement si la double authentification est active sur votre compte.</p>
                </div>
                {{ form_widget(form._csrf_token) }}

                <div class="flex items-center justify-between">
                    <span></span>
                    <a href="#" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors">Mot de passe oublie ?</a>
                </div>

                <button type="submit"
                        class="w-full py-3.5 px-6 text-base font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-full transition-all hover:shadow-xl hover:shadow-emerald-600/20">
                    Se connecter
                </button>
            {{ form_end(form) }}

            <div class="text-center space-y-3 mt-8">
                <p class="text-sm text-slate-500">
                    Pas encore de compte ? <a href="{{ path('app_candidate_register') }}" class="font-semibold text-emerald-600 hover:text-emerald-700 transition-colors">S'inscrire</a>
                </p>
                <p class="text-sm text-slate-400">
                    <a href="{{ path('app_home') }}" class="hover:text-slate-600 transition-colors">Retour a l'accueil</a>
                </p>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    const form = document.querySelector('form[data-2fa-status-url]');
    if (!form) return;

    const endpoint = form.getAttribute('data-2fa-status-url');
    const identifierInput = document.getElementById('identifier');
    const totpWrapper = document.getElementById('candidate-totp-wrapper');
    const totpInput = document.getElementById('totp_code');
    const toggleBtn = document.getElementById('candidate-toggle-2fa');
    const statusLabel = document.getElementById('candidate-twofa-status');
    const step2fa = document.getElementById('candidate-step-2fa');
    let timer = null;

    function setTotpState(required, source) {
        const currentlyVisible = !totpWrapper.classList.contains('hidden');

        if (required) {
            totpWrapper.classList.remove('hidden');
            if (totpInput) totpInput.setAttribute('required', 'required');
            statusLabel.textContent = '2FA requise pour ce compte. Entrez le code Google Authenticator.';
            toggleBtn.textContent = 'Masquer le code 2FA';
            step2fa.classList.add('ring-1', 'ring-emerald-300', 'border-emerald-300');
            return;
        }

        if (source === 'manual' && currentlyVisible) {
            totpWrapper.classList.add('hidden');
            if (totpInput) totpInput.removeAttribute('required');
            statusLabel.textContent = '2FA detectee automatiquement selon le compte.';
            toggleBtn.textContent = 'Afficher le code 2FA';
            step2fa.classList.remove('ring-1', 'ring-emerald-300', 'border-emerald-300');
            return;
        }

        if (source === 'manual' && !currentlyVisible) {
            totpWrapper.classList.remove('hidden');
            statusLabel.textContent = 'Activez ce champ si votre compte utilise Google Authenticator.';
            toggleBtn.textContent = 'Masquer le code 2FA';
            step2fa.classList.add('ring-1', 'ring-emerald-300', 'border-emerald-300');
        }
    }

    async function checkTwoFactorStatus() {
        const identifier = (identifierInput.value || '').trim();
        if (identifier.length < 3) return;

        try {
            const response = await fetch(endpoint + '?identifier=' + encodeURIComponent(identifier), {
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json' }
            });
            const data = await response.json();
            setTotpState(Boolean(data.required), 'auto');
        } catch (e) {
            // Keep silent.
        }
    }

    if (identifierInput) {
        identifierInput.addEventListener('input', function () {
            if (timer) clearTimeout(timer);
            timer = setTimeout(checkTwoFactorStatus, 280);
        });
    }

    toggleBtn.addEventListener('click', function () {
        setTotpState(false, 'manual');
    });

    if (identifierInput && identifierInput.value.trim().length >= 3) {
        checkTwoFactorStatus();
    }
})();
</script>
{% endblock %}
