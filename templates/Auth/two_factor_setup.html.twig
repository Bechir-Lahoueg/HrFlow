{% extends 'base.html.twig' %}

{% block title %}Securite 2FA | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto">
        <div class="rounded-3xl border border-slate-200 bg-white shadow-sm p-6 sm:p-8">
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900">Google Authenticator</h1>
            <p class="mt-2 text-slate-600">Activez la double authentification (TOTP) pour securiser votre compte HrFlow.</p>

            {% for message in app.flashes('success') %}
                <div class="mt-6 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-sm text-emerald-700 font-medium">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="mt-6 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-sm text-red-700 font-medium">{{ message }}</div>
            {% endfor %}

            <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                    {% if qrCodeUrl %}
                        <img src="{{ qrCodeUrl }}" alt="QR code Google Authenticator" class="w-full max-w-[220px] rounded-xl border border-slate-200 bg-white p-2 mx-auto">
                    {% endif %}
                    <p class="mt-4 text-xs text-slate-500 break-all">Secret: {{ secret }}</p>
                </div>

                <div>
                    {% if enabled %}
                        <div class="rounded-xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-700 font-semibold">
                            La double authentification est activee.
                        </div>

                        <form method="post" class="mt-4">
                            <input type="hidden" name="_token" value="{{ csrf_token('2fa_setup') }}">
                            <input type="hidden" name="action" value="disable">
                            <button type="submit" class="w-full py-3 rounded-full bg-red-600 hover:bg-red-700 text-white font-bold transition-colors">
                                Desactiver la 2FA
                            </button>
                        </form>
                    {% else %}
                        <p class="text-sm text-slate-600">
                            1. Scannez le QR code dans Google Authenticator.<br>
                            2. Entrez le code a 6 chiffres pour activer la 2FA.
                        </p>

                        <form method="post" class="mt-4 space-y-3">
                            <input type="hidden" name="_token" value="{{ csrf_token('2fa_setup') }}">
                            <input type="hidden" name="action" value="enable">
                            <input type="text" name="code" placeholder="123456" inputmode="numeric" autocomplete="one-time-code"
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-sm text-slate-900 placeholder-slate-400 outline-none focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20" required>
                            <button type="submit" class="w-full py-3 rounded-full bg-slate-900 hover:bg-slate-800 text-white font-bold transition-colors">
                                Activer Google Authenticator
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
