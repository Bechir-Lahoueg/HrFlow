{% extends 'base.html.twig' %}

{% block title %}Contact | HrFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased">
    {% include 'Components/navbar.html.twig' %}

    {# Hero Section #}
    <section class="pt-32 pb-16 px-6">
        <div class="max-w-4xl mx-auto text-center">
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 text-emerald-700 text-sm font-semibold mb-6">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                Contactez-nous
            </span>

            <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-6 leading-tight">
                Nous sommes la <span class="text-emerald-600">pour vous aider</span>
            </h1>
            <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto">
                Une question ? Besoin d'aide ? Notre equipe est a votre ecoute pour vous accompagner dans votre experience HrFlow.
            </p>
        </div>
    </section>

    {# Contact Info Cards #}
    <section class="py-16 px-6">
        <div class="max-w-6xl mx-auto">
            <div class="grid md:grid-cols-3 gap-8">
                {# Email Card #}
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 text-center">
                    <div class="w-14 h-14 bg-emerald-100 rounded-xl flex items-center justify-center mx-auto mb-6">
                        <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Email</h3>
                    <p class="text-slate-600 mb-4">Reponse sous 24h</p>
                    <a href="mailto:contact@hrflow.tn" class="text-emerald-600 font-semibold hover:text-emerald-700">
                        contact@hrflow.tn
                    </a>
                </div>

                {# Phone Card #}
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 text-center">
                    <div class="w-14 h-14 bg-emerald-100 rounded-xl flex items-center justify-center mx-auto mb-6">
                        <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Telephone</h3>
                    <p class="text-slate-600 mb-4">Lun - Ven, 9h - 18h</p>
                    <a href="tel:+21612345678" class="text-emerald-600 font-semibold hover:text-emerald-700">
                        +216 12 345 678
                    </a>
                </div>

                {# Address Card #}
                <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-200 text-center">
                    <div class="w-14 h-14 bg-emerald-100 rounded-xl flex items-center justify-center mx-auto mb-6">
                        <svg class="w-7 h-7 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Adresse</h3>
                    <p class="text-slate-600 mb-4">Tunis, Tunisie</p>
                    <span class="text-emerald-600 font-semibold">
                        Centre Urbain Nord
                    </span>
                </div>
            </div>
        </div>
    </section>

    {# CTA Section #}
    <section class="py-16 px-6 bg-emerald-600">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
                Vous etes une entreprise ?
            </h2>
            <p class="text-emerald-100 text-lg mb-8 max-w-2xl mx-auto">
                Decouvrez comment HrFlow peut transformer votre gestion RH. Demandez une demonstration personnalisee.
            </p>
            <a href="mailto:demo@hrflow.tn" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-emerald-600 rounded-xl font-bold hover:bg-emerald-50 transition-colors">
                Demander une demo
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3"/></svg>
            </a>
        </div>
    </section>

    {% include 'Components/footer.html.twig' %}
</div>
{% endblock %}
