{% extends 'base.html.twig' %}

{% block title %}Offres d'emploi | HrFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased">
    {% include 'Components/navbar.html.twig' %}

    {# Hero Section #}
    <section class="pt-32 pb-16 px-6">
        <div class="max-w-6xl mx-auto text-center mb-10">
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 text-emerald-700 text-sm font-semibold mb-6">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Nous recrutons !
            </span>

            <h1 class="text-4xl md:text-6xl font-extrabold text-slate-900 mb-6 leading-tight text-center">
                Rejoignez 
                <span class="text-slate-900 bg-clip-text bg-gradient-to-r from-emerald-600 to-teal-500">
                    Notre Équipe
                </span>
            </h1>
            <p class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto">
                Découvrez nos opportunités de carrière et postulez pour faire partie de l'aventure HrFlow.
            </p>

        </div>
    </section>

    {# Job Offers Grid #}
    <section class="pb-20 px-6">
        <div class="max-w-6xl mx-auto">
            {% if jobOffers|length > 0 %}
                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for offer in jobOffers %}
                    <article class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-xl hover:border-emerald-200 transition-all duration-300 overflow-hidden flex flex-col">
                        {# Card Header with Icon #}
                        <div class="p-6 pb-4">
                            <div class="flex items-start justify-between mb-4">
                                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-violet-500/20">
                                    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none">
                                    <!-- Bigger background circle -->
                                    <circle cx="12" cy="12" r="10" fill="#7C3AED"/>

                                    <!-- Centered icon -->
                                    <path 
                                        d="M7 10h10v4H7zM7 14h10"
                                        stroke="white"
                                        stroke-width="1.8"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                    />
                                    </svg>
                                </div>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700">
                                    {{ offer.employmentType|default('CDI')|upper }}
                                </span>
                            </div>
                            
                            <h2 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-emerald-700 transition-colors">
                                {{ offer.title }}
                            </h2>
                            
                            <p class="text-slate-600 text-sm line-clamp-2 mb-4">
                                {{ offer.description|striptags|slice(0, 120) }}...
                            </p>
                        </div>

                        {# Details #}
                        <div class="px-6 py-4 bg-slate-50/50 border-t border-slate-100 mt-auto">
                            <div class="flex flex-wrap gap-3 mb-4">
                                {% if offer.department %}
                                <span class="inline-flex items-center gap-1.5 text-xs text-slate-600 bg-white px-2.5 py-1.5 rounded-lg border border-slate-200">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>
                                    {{ offer.department }}
                                </span>
                                {% endif %}
                                
                                {% if offer.location %}
                                <span class="inline-flex items-center gap-1.5 text-xs text-slate-600 bg-white px-2.5 py-1.5 rounded-lg border border-slate-200">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                                    {{ offer.location }}
                                </span>
                                {% endif %}
                                
                                {% if offer.salaryMin > 0 or offer.salaryMax > 0 %}
                                <span class="inline-flex items-center gap-1.5 text-xs text-emerald-700 bg-emerald-50 px-2.5 py-1.5 rounded-lg border border-emerald-200">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    {{ offer.salaryMin|number_format(0, '.', ' ') }} - {{ offer.salaryMax|number_format(0, '.', ' ') }} TND
                                </span>
                                {% endif %}
                            </div>

                            <div class="flex items-center justify-between mt-4 pt-4 border-t border-slate-100">
                                <span class="text-xs text-slate-400">
                                    Publie {{ offer.createdAt ? offer.createdAt|date('d M Y') : '' }}
                                </span>
                            </div>
                        </div>
                    </article>
                    {% endfor %}
                </div>
                
                {# Sign in CTA Section - Only show for non-authenticated users #}
                {% if not is_granted('IS_AUTHENTICATED_FULLY') %}
                <div class="mt-16 pt-10 border-t border-slate-200 text-center">
                    <div class="bg-slate-900 rounded-2xl p-8 text-white max-w-2xl mx-auto">
                        <h3 class="text-xl font-bold mb-3">Interesse par l'une de ces offres ?</h3>
                        <p class="text-slate-400 mb-6">Connectez-vous ou creez un compte pour postuler.</p>
                        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                            <a href="{{ path('app_candidate_login') }}" class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-semibold transition-all duration-200">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                                Se connecter
                            </a>
                            <a href="{{ path('app_candidate_register') }}" class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-white hover:bg-slate-100 text-slate-900 font-semibold transition-all duration-200">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766z"/></svg>
                                S'inscrire
                            </a>
                        </div>
                    </div>
                </div>
                {% elseif is_granted('ROLE_CANDIDATE') %}
                {# Show message for logged in candidates #}
                <div class="mt-16 pt-10 border-t border-slate-200 text-center">
                    <div class="bg-emerald-50 rounded-2xl p-8 text-slate-900 max-w-2xl mx-auto border border-emerald-200">
                        <h3 class="text-xl font-bold mb-3">Vous etes connecte en tant que candidat</h3>
                        <p class="text-slate-600 mb-6">Vous pouvez maintenant postuler aux offres qui vous interessent.</p>
                        <p class="text-sm text-slate-500">Connecte en tant que <span class="font-semibold">{{ app.user.username }}</span></p>
                    </div>
                </div>
                {% endif %}
            {% else %}
                {# Empty State #}
                <div class="text-center py-20">
                    <div class="w-24 h-24 rounded-3xl bg-slate-100 flex items-center justify-center mx-auto mb-6">
                        <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0v-2.25c0-1.094-.787-2.036-1.872-2.18-2.087-.277-4.216-.42-6.378-.42s-4.291.143-6.378.42c-1.085.144-1.872 1.086-1.872 2.18v2.25m16.5 0a2.25 2.25 0 012.25 2.25v4.5m-2.25-2.25h-15"/>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900 mb-2">Aucune offre disponible</h3>
                    <p class="text-slate-600 max-w-md mx-auto">
                        Nous n'avons pas d'offres d'emploi ouvertes pour le moment. Revenez bientot ou contactez-nous pour plus d'informations.
                    </p>
                </div>
            {% endif %}
        </div>
    </section>

    {# CTA Section #}
    <section class="py-16 px-6 bg-slate-900">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                Vous ne trouvez pas le poste ideal ?
            </h2>
            <p class="text-slate-400 text-lg mb-8 max-w-xl mx-auto">
                Envoyez-nous votre candidature spontanee et nous vous contacterons des qu'une opportunite correspondant a votre profil se presente.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="mailto:recrutement@hrflow.tn" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-emerald-500 hover:bg-emerald-400 text-slate-900 font-semibold transition-all duration-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                    Candidature spontanee
                </a>
                <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white font-semibold transition-all duration-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    Retour a l'accueil
                </a>
            </div>
        </div>
    </section>

    {% include 'Components/footer.html.twig' %}
</div>
{% endblock %}