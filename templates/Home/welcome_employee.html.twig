{% extends 'base.html.twig' %}

{% block title %}Welcome Employe | HrFlow{% endblock %}

{% block body %}
    <main style="min-height:100vh;display:grid;place-items:center;background:linear-gradient(145deg,#fff8ef,#ffefd8);font-family:Manrope,sans-serif;padding:1rem;">
        <section style="width:min(760px,100%);background:#fff;border:1px solid #f2dec3;border-radius:18px;padding:2rem;box-shadow:0 20px 45px rgba(15,23,42,.10);">
            {% for message in app.flashes('success') %}
                <p style="margin:0 0 1rem 0;padding:.7rem .9rem;border-radius:10px;background:#fff3e8;border:1px solid #f5d9bd;color:#c05621;font-weight:700;">{{ message }}</p>
            {% endfor %}
            <h1 style="margin:0 0 .4rem 0;color:#c05621;font-size:2rem;">Bienvenue Employe</h1>
            <p style="margin:0 0 1rem 0;color:#334155;">Connexion reussie. Vous etes connecte avec les droits employe.</p>

            {% if user %}
                <div style="display:grid;gap:.45rem;padding:1rem;border-radius:12px;background:#fffaf4;border:1px solid #f6e8d5;">
                    <p style="margin:0;"><strong>Utilisateur:</strong> {{ user.userIdentifier }}</p>
                    {% if user.email is defined and user.email %}
                        <p style="margin:0;"><strong>Email:</strong> {{ user.email }}</p>
                    {% endif %}
                    <p style="margin:0;"><strong>Role:</strong> ROLE_EMPLOYEE</p>
                </div>
            {% endif %}

            <div style="margin-top:1.2rem;display:flex;gap:.7rem;flex-wrap:wrap;">
                <a href="{{ path('app_home') }}" style="padding:.7rem 1rem;border-radius:999px;text-decoration:none;background:#c05621;color:white;font-weight:700;">Accueil</a>
                <a href="{{ path('app_logout') }}" style="padding:.7rem 1rem;border-radius:999px;text-decoration:none;background:#fff0e1;color:#c05621;font-weight:700;">Se deconnecter</a>
            </div>
        </section>
    </main>
{% endblock %}
