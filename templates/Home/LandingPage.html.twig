{% extends 'base.html.twig' %}

{% block title %}HrFlow | Smart Recruitment{% endblock %}

{% block stylesheets %}
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
	<style>
		/* ============================================
		   DESIGN TOKENS
		   ============================================ */
		:root {
			--bg: #f7f8f4;
			--surface: rgba(255, 255, 255, 0.78);
			--text: #151b1f;
			--muted: #596670;
			--line: #d9e0e4;
			--primary: #0f766e;
			--primary-dark: #0b5e58;
			--primary-soft: #d3f5ef;
			--accent: #f97316;
			--accent-soft: #fff3e6;
			--shadow: 0 24px 70px rgba(15, 118, 110, 0.16);
			--shadow-sm: 0 4px 16px rgba(15, 23, 42, 0.06);
			--shadow-lg: 0 32px 80px rgba(15, 118, 110, 0.2);
			--radius: 20px;
			--radius-sm: 12px;
			--radius-xs: 8px;
		}

		* { box-sizing: border-box; margin: 0; padding: 0; }
		html { scroll-behavior: smooth; }

		body {
			font-family: 'Manrope', sans-serif;
			color: var(--text);
			background:
				radial-gradient(circle at 8% 15%, rgba(15,118,110,0.10) 0%, transparent 32%),
				radial-gradient(circle at 92% 20%, rgba(249,115,22,0.08) 0%, transparent 38%),
				radial-gradient(circle at 50% 80%, rgba(15,118,110,0.05) 0%, transparent 50%),
				var(--bg);
			min-height: 100vh;
			-webkit-font-smoothing: antialiased;
		}

		.container { width: min(1160px, 92vw); margin-inline: auto; }

		/* ============================================
		   NAVBAR
		   ============================================ */
		.site-header {
			position: sticky;
			top: 0;
			z-index: 100;
			padding: 0.85rem 0;
			backdrop-filter: blur(16px) saturate(1.8);
			-webkit-backdrop-filter: blur(16px) saturate(1.8);
			background: linear-gradient(to bottom, rgba(247,248,244,0.92), rgba(247,248,244,0.6));
			border-bottom: 1px solid rgba(217,224,228,0.4);
			transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
		}

		.site-header.scrolled {
			padding: 0.55rem 0;
			background: rgba(247,248,244,0.96);
			border-bottom-color: rgba(217,224,228,0.7);
			box-shadow: 0 4px 30px rgba(15,23,42,0.06);
		}

		.nav-shell {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 1rem;
			background: rgba(255,255,255,0.55);
			border: 1px solid rgba(217,224,228,0.7);
			border-radius: 16px;
			padding: 0.55rem 0.55rem 0.55rem 0.85rem;
			box-shadow: 0 8px 32px rgba(15,23,42,0.04);
			transition: all 0.35s cubic-bezier(0.4,0,0.2,1);
		}

		.site-header.scrolled .nav-shell {
			background: rgba(255,255,255,0.75);
			box-shadow: var(--shadow-sm);
		}

		/* Brand */
		.brand {
			display: inline-flex;
			align-items: center;
			gap: 0.55rem;
			text-decoration: none;
			flex-shrink: 0;
		}

		.brand-title, .footer-brand {
			font-family: 'Space Grotesk', sans-serif;
			font-weight: 700;
			letter-spacing: 0.01em;
			font-size: 1.18rem;
			color: var(--text);
		}

		.brand-logo, .footer-logo {
			width: 40px;
			height: 40px;
			object-fit: cover;
			border-radius: var(--radius-sm);
			border: 1px solid rgba(15,118,110,0.15);
			box-shadow: 0 6px 18px rgba(15,118,110,0.15);
			transition: transform 0.3s ease;
		}

		.brand:hover .brand-logo { transform: rotate(-4deg) scale(1.06); }

		.brand-badge {
			font-size: 0.68rem;
			font-weight: 700;
			color: #0b4f4a;
			padding: 0.22rem 0.48rem;
			border-radius: 999px;
			background: var(--primary-soft);
			letter-spacing: 0.03em;
			text-transform: uppercase;
		}

		/* Nav links */
		.main-nav {
			display: flex;
			align-items: center;
			gap: 0.25rem;
		}

		.nav-link {
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			text-decoration: none;
			color: var(--muted);
			font-weight: 600;
			font-size: 0.9rem;
			padding: 0.5rem 0.75rem;
			border-radius: var(--radius-xs);
			transition: all 0.2s ease;
		}

		.nav-link svg { opacity: 0.5; transition: opacity 0.2s ease; }
		.nav-link:hover { color: var(--text); background: rgba(15,118,110,0.06); }
		.nav-link:hover svg { opacity: 0.85; }

		/* Nav right */
		.nav-right {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			flex-shrink: 0;
		}

		.nav-login {
			text-decoration: none;
			color: var(--muted);
			font-weight: 600;
			font-size: 0.9rem;
			padding: 0.5rem 0.85rem;
			border-radius: var(--radius-xs);
			transition: all 0.2s ease;
		}

		.nav-login:hover { color: var(--text); background: rgba(0,0,0,0.04); }

		.nav-cta {
			text-decoration: none;
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
			padding: 0.55rem 1.1rem;
			color: #fff;
			font-weight: 700;
			font-size: 0.88rem;
			background: linear-gradient(135deg, #0f766e, #0e9d92);
			border-radius: 999px;
			box-shadow: 0 6px 20px rgba(15,118,110,0.3);
			transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
		}

		.nav-cta:hover {
			transform: translateY(-2px);
			box-shadow: 0 10px 30px rgba(15,118,110,0.38);
		}

		.nav-cta svg {
			transition: transform 0.25s ease;
		}

		.nav-cta:hover svg { transform: translateX(3px); }

		/* Hamburger */
		.nav-hamburger {
			display: none;
			flex-direction: column;
			justify-content: center;
			gap: 5px;
			width: 40px;
			height: 40px;
			padding: 8px;
			background: transparent;
			border: 1px solid var(--line);
			border-radius: var(--radius-xs);
			cursor: pointer;
			transition: background 0.2s ease;
		}

		.nav-hamburger:hover { background: rgba(0,0,0,0.04); }

		.hamburger-line {
			display: block;
			width: 100%;
			height: 2px;
			background: var(--text);
			border-radius: 2px;
			transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
			transform-origin: center;
		}

		.nav-hamburger.is-active .hamburger-line:nth-child(1) {
			transform: translateY(7px) rotate(45deg);
		}
		.nav-hamburger.is-active .hamburger-line:nth-child(2) {
			opacity: 0;
			transform: scaleX(0);
		}
		.nav-hamburger.is-active .hamburger-line:nth-child(3) {
			transform: translateY(-7px) rotate(-45deg);
		}

		/* Mobile menu */
		.mobile-menu {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 99;
			background: rgba(247,248,244,0.98);
			backdrop-filter: blur(20px);
			-webkit-backdrop-filter: blur(20px);
			display: flex;
			align-items: center;
			justify-content: center;
			opacity: 0;
			visibility: hidden;
			transition: all 0.4s cubic-bezier(0.4,0,0.2,1);
		}

		.mobile-menu.is-open {
			opacity: 1;
			visibility: visible;
		}

		.mobile-menu-inner {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0.3rem;
			transform: translateY(20px);
			transition: transform 0.4s cubic-bezier(0.4,0,0.2,1);
		}

		.mobile-menu.is-open .mobile-menu-inner { transform: translateY(0); }

		.mobile-link {
			text-decoration: none;
			color: var(--text);
			font-family: 'Space Grotesk', sans-serif;
			font-weight: 700;
			font-size: 1.5rem;
			padding: 0.6rem 1.5rem;
			border-radius: var(--radius-sm);
			transition: all 0.2s ease;
		}

		.mobile-link:hover { background: rgba(15,118,110,0.08); color: var(--primary); }

		.mobile-login { font-size: 1.1rem; color: var(--muted); }

		.mobile-divider {
			width: 60px;
			border: none;
			border-top: 2px solid var(--line);
			margin: 0.8rem 0;
		}

		.mobile-cta {
			display: inline-flex;
			align-items: center;
			text-decoration: none;
			padding: 0.85rem 2rem;
			color: #fff;
			font-weight: 700;
			font-size: 1.1rem;
			background: linear-gradient(135deg, #0f766e, #0e9d92);
			border-radius: 999px;
			box-shadow: 0 10px 30px rgba(15,118,110,0.3);
			margin-top: 0.5rem;
		}

		/* ============================================
		   BUTTONS
		   ============================================ */
		.btn {
			text-decoration: none;
			display: inline-flex;
			align-items: center;
			justify-content: center;
			gap: 0.45rem;
			border-radius: 999px;
			font-weight: 700;
			font-size: 0.95rem;
			padding: 0.85rem 1.5rem;
			border: 1px solid transparent;
			transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
			cursor: pointer;
		}

		.btn-primary {
			background: linear-gradient(135deg, #0f766e, #0e9d92);
			color: #fff;
			box-shadow: 0 10px 30px rgba(15,118,110,0.25);
		}

		.btn-primary:hover {
			transform: translateY(-2px);
			box-shadow: 0 16px 40px rgba(15,118,110,0.35);
		}

		.btn-glow {
			box-shadow: 0 10px 30px rgba(15,118,110,0.25), 0 0 60px rgba(15,118,110,0.1);
		}

		.btn-secondary {
			color: var(--text);
			border-color: var(--line);
			background: rgba(255,255,255,0.8);
			backdrop-filter: blur(4px);
		}

		.btn-secondary:hover {
			transform: translateY(-2px);
			border-color: rgba(15,118,110,0.3);
			box-shadow: var(--shadow-sm);
		}

		/* ============================================
		   HERO
		   ============================================ */
		.hero { padding: 5.5rem 0 3rem; }

		.hero-grid {
			display: grid;
			grid-template-columns: 1.05fr 0.95fr;
			gap: 3rem;
			align-items: center;
		}

		.eyebrow {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			padding: 0.4rem 0.85rem;
			border-radius: 999px;
			background: var(--primary-soft);
			color: #0b4f4a;
			font-weight: 700;
			font-size: 0.8rem;
			margin-bottom: 1.2rem;
			letter-spacing: 0.02em;
		}

		.eyebrow-dot {
			width: 6px;
			height: 6px;
			border-radius: 50%;
			background: var(--primary);
			animation: pulse 2s ease-in-out infinite;
		}

		h1 {
			font-family: 'Space Grotesk', sans-serif;
			font-size: clamp(2.2rem, 4.5vw, 3.8rem);
			line-height: 1.08;
			margin-bottom: 1.1rem;
			letter-spacing: -0.02em;
		}

		h1 .text-gradient {
			background: linear-gradient(135deg, var(--primary), #14b8a6, var(--accent));
			-webkit-background-clip: text;
			-webkit-text-fill-color: transparent;
			background-clip: text;
		}

		.lead {
			color: var(--muted);
			line-height: 1.75;
			max-width: 52ch;
			margin-bottom: 1.8rem;
			font-size: 1.05rem;
		}

		.hero-actions {
			display: flex;
			flex-wrap: wrap;
			gap: 0.9rem;
			margin-bottom: 2rem;
		}

		.hero-stats {
			display: flex;
			gap: 2rem;
		}

		.stat-item {
			display: flex;
			flex-direction: column;
			gap: 0.15rem;
		}

		.stat-number {
			font-family: 'Space Grotesk', sans-serif;
			font-weight: 700;
			font-size: 1.5rem;
			color: var(--primary);
		}

		.stat-label {
			font-size: 0.82rem;
			color: var(--muted);
			font-weight: 600;
		}

		/* Hero card */
		.hero-card {
			background: linear-gradient(145deg, #ffffff, #f6fffd);
			border: 1px solid rgba(15,118,110,0.15);
			border-radius: var(--radius);
			padding: 1.5rem;
			box-shadow: var(--shadow);
			animation: floatCard 6s ease-in-out infinite;
			position: relative;
			overflow: hidden;
		}

		.hero-card::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 3px;
			background: linear-gradient(90deg, var(--primary), #14b8a6, var(--accent));
		}

		.hero-card h3 {
			font-family: 'Space Grotesk', sans-serif;
			margin-bottom: 0.5rem;
			font-size: 1.1rem;
		}

		.hero-card p { color: var(--muted); line-height: 1.6; margin-bottom: 1rem; }

		.mini-list { list-style: none; display: grid; gap: 0.55rem; }

		.mini-list li {
			display: flex;
			align-items: center;
			gap: 0.6rem;
			background: rgba(15,118,110,0.06);
			border: 1px solid rgba(15,118,110,0.1);
			border-radius: var(--radius-sm);
			padding: 0.7rem 0.85rem;
			font-size: 0.92rem;
			font-weight: 500;
			transition: all 0.2s ease;
		}

		.mini-list li:hover {
			background: rgba(15,118,110,0.1);
			transform: translateX(4px);
		}

		.mini-check {
			width: 20px;
			height: 20px;
			border-radius: 50%;
			background: var(--primary);
			display: flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
		}

		.mini-check svg { color: #fff; }

		/* Trusted by */
		.trusted-bar {
			padding: 2.5rem 0 1rem;
			text-align: center;
		}

		.trusted-label {
			font-size: 0.78rem;
			font-weight: 700;
			color: var(--muted);
			letter-spacing: 0.1em;
			text-transform: uppercase;
			margin-bottom: 1.2rem;
		}

		.trusted-logos {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 2.5rem;
			flex-wrap: wrap;
			opacity: 0.4;
		}

		.trusted-logos span {
			font-family: 'Space Grotesk', sans-serif;
			font-weight: 700;
			font-size: 1.15rem;
			color: var(--muted);
		}

		/* ============================================
		   SECTIONS
		   ============================================ */
		.section { padding: 3.5rem 0; }

		.section-header {
			text-align: center;
			max-width: 600px;
			margin: 0 auto 2.2rem;
		}

		.section-label {
			display: inline-block;
			padding: 0.3rem 0.7rem;
			border-radius: 999px;
			font-size: 0.75rem;
			font-weight: 700;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			margin-bottom: 0.8rem;
		}

		.section-label-teal {
			background: var(--primary-soft);
			color: #0b4f4a;
		}

		.section-label-orange {
			background: var(--accent-soft);
			color: #c2410c;
		}

		.section h2 {
			font-family: 'Space Grotesk', sans-serif;
			margin-bottom: 0.6rem;
			font-size: clamp(1.6rem, 3vw, 2.3rem);
			letter-spacing: -0.01em;
		}

		.section-subtitle {
			color: var(--muted);
			line-height: 1.65;
			font-size: 1rem;
		}

		/* Feature cards */
		.cards {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.1rem;
		}

		.card {
			background: var(--surface);
			border: 1px solid var(--line);
			border-radius: 16px;
			padding: 1.3rem;
			box-shadow: var(--shadow-sm);
			opacity: 0;
			transform: translateY(12px);
			animation: reveal 0.6s ease forwards;
			transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
			position: relative;
			overflow: hidden;
		}

		.card:hover {
			transform: translateY(-4px);
			box-shadow: var(--shadow);
			border-color: rgba(15,118,110,0.25);
		}

		.card::after {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 2px;
			background: linear-gradient(90deg, var(--primary), transparent);
			opacity: 0;
			transition: opacity 0.3s ease;
		}

		.card:hover::after { opacity: 1; }

		.cards .card:nth-child(2) { animation-delay: 0.1s; }
		.cards .card:nth-child(3) { animation-delay: 0.2s; }

		.card-icon {
			width: 44px;
			height: 44px;
			border-radius: var(--radius-sm);
			display: flex;
			align-items: center;
			justify-content: center;
			margin-bottom: 0.9rem;
			font-size: 1.4rem;
		}

		.card-icon-teal { background: var(--primary-soft); color: var(--primary); }
		.card-icon-orange { background: var(--accent-soft); color: var(--accent); }

		.card h3 { margin-bottom: 0.45rem; font-size: 1.05rem; }
		.card p { color: var(--muted); line-height: 1.65; font-size: 0.92rem; }

		/* Steps cards */
		.step-number {
			font-family: 'Space Grotesk', sans-serif;
			font-weight: 700;
			font-size: 2.5rem;
			color: rgba(15,118,110,0.12);
			line-height: 1;
			margin-bottom: 0.5rem;
		}

		/* ============================================
		   TESTIMONIALS
		   ============================================ */
		.testimonials-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.1rem;
		}

		.testimonial-card {
			background: var(--surface);
			border: 1px solid var(--line);
			border-radius: 16px;
			padding: 1.4rem;
			box-shadow: var(--shadow-sm);
			display: flex;
			flex-direction: column;
			gap: 1rem;
			opacity: 0;
			transform: translateY(12px);
			animation: reveal 0.6s ease forwards;
			transition: all 0.3s ease;
		}

		.testimonial-card:nth-child(2) { animation-delay: 0.1s; }
		.testimonial-card:nth-child(3) { animation-delay: 0.2s; }

		.testimonial-card:hover {
			transform: translateY(-3px);
			box-shadow: var(--shadow);
		}

		.testimonial-stars {
			display: flex;
			gap: 2px;
			color: #f59e0b;
		}

		.testimonial-text {
			color: var(--text);
			line-height: 1.7;
			font-size: 0.95rem;
			flex: 1;
		}

		.testimonial-author {
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}

		.testimonial-avatar {
			width: 40px;
			height: 40px;
			border-radius: 50%;
			display: flex;
			align-items: center;
			justify-content: center;
			font-weight: 700;
			font-size: 0.9rem;
			color: #fff;
			flex-shrink: 0;
		}

		.testimonial-name { font-weight: 700; font-size: 0.9rem; }
		.testimonial-role { font-size: 0.8rem; color: var(--muted); }

		/* ============================================
		   FOOTER
		   ============================================ */
		.site-footer {
			margin-top: 3rem;
			border-top: 1px solid var(--line);
			padding: 0 0 2rem;
			background: linear-gradient(to top, rgba(15,118,110,0.05), transparent);
		}

		.footer-cta-banner {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 2rem;
			padding: 2.2rem 2.5rem;
			margin: -1px 0 2.5rem;
			border-radius: 0 0 var(--radius) var(--radius);
			background: linear-gradient(135deg, rgba(15,118,110,0.08), rgba(15,118,110,0.03));
			border: 1px solid rgba(15,118,110,0.12);
			border-top: 3px solid var(--primary);
		}

		.footer-cta-title {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 1.5rem;
			margin-bottom: 0.35rem;
		}

		.footer-cta-text {
			color: var(--muted);
			font-size: 0.95rem;
		}

		.footer-cta-actions {
			display: flex;
			gap: 0.75rem;
			flex-shrink: 0;
		}

		/* Footer grid */
		.footer-grid {
			display: grid;
			grid-template-columns: 1.6fr 1fr 1fr 1fr;
			gap: 2rem;
			padding: 0 0.5rem;
		}

		.footer-col-brand .footer-brand-row {
			display: flex;
			align-items: center;
			gap: 0.55rem;
			margin-bottom: 0.85rem;
		}

		.footer-desc {
			color: var(--muted);
			line-height: 1.7;
			font-size: 0.9rem;
			max-width: 36ch;
			margin-bottom: 1.2rem;
		}

		.footer-socials {
			display: flex;
			gap: 0.5rem;
		}

		.social-link {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 38px;
			height: 38px;
			border-radius: var(--radius-xs);
			border: 1px solid var(--line);
			color: var(--muted);
			background: rgba(255,255,255,0.6);
			transition: all 0.25s cubic-bezier(0.4,0,0.2,1);
		}

		.social-link:hover {
			color: var(--primary);
			border-color: rgba(15,118,110,0.3);
			background: var(--primary-soft);
			transform: translateY(-2px);
			box-shadow: 0 4px 12px rgba(15,118,110,0.15);
		}

		.footer-heading {
			font-family: 'Space Grotesk', sans-serif;
			font-size: 0.85rem;
			font-weight: 700;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--text);
			margin-bottom: 1rem;
		}

		.footer-list {
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: 0.55rem;
		}

		.footer-list a {
			text-decoration: none;
			color: var(--muted);
			font-size: 0.9rem;
			font-weight: 500;
			transition: all 0.2s ease;
			display: inline-flex;
			align-items: center;
			gap: 0.4rem;
		}

		.footer-list a:hover { color: var(--primary); transform: translateX(3px); }

		.footer-badge {
			font-size: 0.65rem;
			font-weight: 700;
			padding: 0.15rem 0.4rem;
			border-radius: 999px;
			background: linear-gradient(135deg, var(--accent), #fb923c);
			color: #fff;
			letter-spacing: 0.04em;
			text-transform: uppercase;
		}

		/* Footer bottom */
		.footer-bottom {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-top: 2.2rem;
			padding-top: 1.5rem;
			border-top: 1px solid var(--line);
		}

		.footer-copy {
			color: var(--muted);
			font-size: 0.85rem;
		}

		.footer-legal {
			display: flex;
			align-items: center;
			gap: 0.9rem;
		}

		.footer-legal a {
			text-decoration: none;
			color: var(--muted);
			font-size: 0.85rem;
			font-weight: 500;
			transition: color 0.2s ease;
		}

		.footer-legal a:hover { color: var(--primary); }

		.footer-dot {
			width: 3px;
			height: 3px;
			border-radius: 50%;
			background: var(--line);
		}

		/* ============================================
		   ANIMATIONS
		   ============================================ */
		@keyframes reveal {
			to { opacity: 1; transform: translateY(0); }
		}

		@keyframes floatCard {
			0%, 100% { transform: translateY(0); }
			50% { transform: translateY(-8px); }
		}

		@keyframes pulse {
			0%, 100% { opacity: 1; transform: scale(1); }
			50% { opacity: 0.5; transform: scale(1.5); }
		}

		/* ============================================
		   RESPONSIVE
		   ============================================ */
		@media (max-width: 920px) {
			.hero-grid { grid-template-columns: 1fr; }
			.cards, .testimonials-grid { grid-template-columns: 1fr 1fr; }
			.footer-grid { grid-template-columns: 1.4fr 1fr 1fr; }
			.footer-col-brand { grid-column: 1 / -1; }
			.footer-cta-banner { flex-direction: column; text-align: center; align-items: center; }
		}

		@media (max-width: 700px) {
			.main-nav, .nav-right { display: none; }
			.nav-hamburger { display: flex; }
			.brand-badge { display: none; }

			.cards, .testimonials-grid { grid-template-columns: 1fr; }
			.hero { padding-top: 4rem; }

			.footer-grid { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
			.footer-col-brand { grid-column: 1 / -1; }
			.footer-cta-banner { padding: 1.5rem; }
			.footer-cta-actions { flex-direction: column; width: 100%; }
			.footer-cta-actions .btn { justify-content: center; }

			.footer-bottom { flex-direction: column; gap: 0.75rem; text-align: center; }
			.hero-stats { flex-direction: column; gap: 0.75rem; }

			.trusted-logos { gap: 1.5rem; }
		}
	</style>
{% endblock %}

