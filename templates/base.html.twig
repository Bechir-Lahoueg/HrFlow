<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        {# Cache control - prevents back button from showing authenticated content after logout #}
        <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0">
        <meta http-equiv="Pragma" content="no-cache">
        <meta http-equiv="Expires" content="0">
        
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="{{ asset('2a09aee0-9e72-44fa-b15e-1021491354a9.jpg') }}">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

        {# Prevent flash of wrong theme #}
        <script>
            (function(){
                if(localStorage.getItem('hrflow-theme')==='dark') document.documentElement.classList.add('dark');
            })();
        </script>

        {# ─── Préférences d'accessibilité (anti-flash) ───
           Applique les classes a11y-* sur <html> AVANT le premier render.
           Source : préférences DB (utilisateur connecté) ou localStorage (sinon). #}
        {% set __a11y_seed = app.user ? accessibility_prefs() : null %}
        <meta name="a11y-csrf" content="{{ csrf_token('a11y_prefs') }}">
        {% if __a11y_seed %}
            <meta name="a11y-prefs" content="{{ __a11y_seed|json_encode|e('html_attr') }}">
        {% endif %}
        <script>
            (function(){
                var html = document.documentElement;
                var prefs = null;
                {% if __a11y_seed %}
                    prefs = {{ __a11y_seed|json_encode|raw }};
                    window.__A11Y_PREFS__ = prefs;
                {% else %}
                    try {
                        var raw = localStorage.getItem('hrflow-a11y-prefs');
                        if (raw) prefs = JSON.parse(raw);
                    } catch(e) { prefs = null; }
                {% endif %}
                if (!prefs) prefs = { high_contrast:false, font_scale:100, voice_feedback:false, simplified_ui:false, reduce_motion:false };
                if (prefs.high_contrast) html.classList.add('a11y-high-contrast');
                if (prefs.simplified_ui) html.classList.add('a11y-simplified');
                if (prefs.reduce_motion) html.classList.add('a11y-reduce-motion');
                var fs = [90,100,115,130,150].indexOf(prefs.font_scale) !== -1 ? prefs.font_scale : 100;
                html.classList.add('a11y-font-' + fs);
            })();
        </script>
        
        {#
            Protection "bouton retour" SANS rechargements intempestifs.
            L'ancien script écoutait popstate/click et déclenchait window.location.reload() trop
            agressivement, ce qui provoquait des reload lors du focus/saisie dans certains formulaires.

            Ici on se contente de recharger uniquement quand la page revient du cache navigateur (bfcache).
        #}
        <script>
            window.addEventListener('pageshow', function (event) {
                if (event.persisted) {
                    // La page a été restaurée depuis le cache (bouton retour). Recharger pour revalider la session.
                    window.location.reload();
                }
            });
        </script>

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {# Skip link : accessible au clavier en premier (Tab) #}
        <a href="#main" class="a11y-skip-link">Aller au contenu principal</a>

        {% block body %}
        <div class="page-wrapper">
            {% block content %}{% endblock %}
        </div>
        {% endblock %}

        {# ── Composants d'accessibilité globaux ── #}
        {% if app.user %}
            {% include 'Components/_a11y_floating_button.html.twig' %}
        {% endif %}
        {% include 'Components/_confirm_dialog.html.twig' %}

        {# Theme toggle logic #}
        <script>
            function toggleTheme() {
                var html = document.documentElement;
                var isDark = html.classList.toggle('dark');
                localStorage.setItem('hrflow-theme', isDark ? 'dark' : 'light');
                var sun = document.getElementById('theme-sun');
                var moon = document.getElementById('theme-moon');
                if (sun && moon) {
                    sun.classList.toggle('hidden', isDark);
                    moon.classList.toggle('hidden', !isDark);
                    var visible = isDark ? moon : sun;
                    visible.classList.remove('theme-icon-in');
                    void visible.offsetWidth;
                    visible.classList.add('theme-icon-in');
                }
            }
        </script>
    {% block extra_js %}{% endblock %}
    </body>
</html>
