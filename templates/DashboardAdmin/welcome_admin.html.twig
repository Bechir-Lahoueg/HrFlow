{% extends 'base.html.twig' %}
{% import '_widgets/_welcome_widgets.html.twig' as w %}

{% block title %}Tableau de bord Admin | HrFlow{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardAdmin/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardAdmin/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ═══════════════ Welcome Banner ═══════════════ #}
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-violet-600 via-violet-700 to-indigo-800 p-8 sm:p-10 text-white animate-slide-up">
                <div class="absolute inset-0 overflow-hidden">
                    <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full bg-white/10 blur-3xl mesh-blob"></div>
                    <div class="absolute -bottom-32 -left-20 w-80 h-80 rounded-full bg-fuchsia-500/20 blur-3xl mesh-blob-alt"></div>
                    <div class="absolute top-0 right-0 w-80 h-80 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
                </div>
                <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-emerald-300 uppercase tracking-wider">Système opérationnel</span>
                        </div>
                        <h2 class="text-3xl sm:text-4xl font-extrabold mb-2">
                            Bonjour, <span class="text-white/90">{{ user.userIdentifier }}</span>
                        </h2>
                        <p class="text-violet-200 max-w-xl text-[15px] leading-relaxed">
                            Pilotage stratégique et veille externe en temps réel. Suivez la météo locale, les marchés, l'actualité économique et les jours fériés tunisiens.
                        </p>
                        <div class="mt-5">
                            <a href="{{ path('app_2fa_setup') }}" class="inline-flex items-center gap-2 rounded-full bg-white/15 px-5 py-2.5 text-sm font-bold text-white border border-white/30 hover:bg-white/25 transition-colors backdrop-blur">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                                Configurer Google Authenticator
                            </a>
                        </div>
                    </div>
                    <div class="hidden md:block shrink-0">
                        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-5 border border-white/20 min-w-[180px]">
                            <p class="text-[10px] uppercase tracking-widest text-violet-200 font-bold">Tunis • Maintenant</p>
                            <p class="text-4xl font-black mt-1 tabular-nums">{{ serverTime|date('H:i') }}</p>
                            <p class="text-[12px] text-violet-100 mt-1 font-semibold">{{ serverTime|date('d/m/Y') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {# ═══════════════ Row 1 : Météo (large) + News ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 animate-slide-up stagger-1">
                <div class="xl:col-span-1">
                    {{ w.weather(weather, 'violet', path('app_welcome_admin', {refresh: 'weather'})) }}
                </div>
                <div class="xl:col-span-2">
                    {{ w.news(news, 'violet', 'Actualités économie', path('app_welcome_admin', {refresh: 'news'})) }}
                </div>
            </div>

            {# ═══════════════ Row 2 : Prévisions 5j + Taux de change ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-5 gap-4 animate-slide-up stagger-2">
                <div class="xl:col-span-3">
                    {{ w.forecast(forecast, 'violet', path('app_welcome_admin', {refresh: 'forecast'})) }}
                </div>
                <div class="xl:col-span-2">
                    {{ w.rates(rates, 'violet', path('app_welcome_admin', {refresh: 'rates'})) }}
                </div>
            </div>

            {# ═══════════════ Row 3 : Jours fériés + Citation business ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 animate-slide-up stagger-3">
                {{ w.holidays(holidays, 'violet', path('app_welcome_admin', {refresh: 'holidays'})) }}
                {{ w.quote(quote, 'violet', path('app_welcome_admin', {refresh: 'quote'})) }}
            </div>

            {# ═══════════════ Quick Actions ═══════════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-slide-up stagger-5">
                <a href="{{ path('app_admin_employees') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none hover:border-violet-200 dark:hover:border-violet-500/20 transition-all duration-200 card-hover">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg bg-violet-50 dark:bg-violet-500/10 flex items-center justify-center group-hover:bg-violet-100 dark:group-hover:bg-violet-500/20 transition-colors">
                            <svg class="w-5 h-5 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-violet-700 dark:group-hover:text-violet-300 transition-colors">Gérer les employés</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Comptes RH & équipes</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-violet-500 dark:group-hover:text-violet-400 ml-auto transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>

                <a href="{{ path('app_admin_leave_exceptions') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none hover:border-sky-200 dark:hover:border-sky-500/20 transition-all duration-200 card-hover">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg bg-sky-50 dark:bg-sky-500/10 flex items-center justify-center group-hover:bg-sky-100 dark:group-hover:bg-sky-400/10 transition-colors">
                            <svg class="w-5 h-5 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-sky-700 dark:group-hover:text-sky-300 transition-colors">Exceptions de congés</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Gérer les cas spéciaux</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-sky-500 dark:group-hover:text-sky-400 ml-auto transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>

                <a href="{{ path('app_2fa_setup') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none hover:border-amber-200 dark:hover:border-amber-500/20 transition-all duration-200 card-hover">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center group-hover:bg-amber-100 dark:group-hover:bg-amber-400/10 transition-colors">
                            <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-amber-700 dark:group-hover:text-amber-300 transition-colors">Google Authenticator</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Sécurité 2FA</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-amber-500 dark:group-hover:text-amber-400 ml-auto transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>
            </div>

        </main>
    </div>
</div>
{% endblock %}
