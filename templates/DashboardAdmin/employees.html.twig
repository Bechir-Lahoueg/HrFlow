{% extends 'base.html.twig' %}

{% block title %}Employees | HrFlow Admin{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardAdmin/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardAdmin/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-lg bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/30 text-rose-700 dark:text-rose-400 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ═══════════════ Page Header ═══════════════ #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 animate-slide-up">
                <div>
                    <h1 class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-100">Employee Management</h1>
                    <p class="text-[13px] text-zinc-500 mt-1">Create RH accounts and manage your workforce. Passwords use SHA-256 hashing compatible with the Java module.</p>
                </div>
                <a href="{{ path('app_welcome_admin') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-[13px] font-semibold bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800/50 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 hover:border-zinc-300 dark:hover:border-zinc-700/50 shadow-sm dark:shadow-none transition-all shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    Dashboard
                </a>
            </div>
            {# ═══════════════ Create RH + Employees Table ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

                {# ── Create RH Form ── #}
                <section class="xl:col-span-1 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm dark:shadow-none animate-slide-up stagger-1 self-start">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-8 h-8 rounded-lg bg-violet-50 dark:bg-violet-500/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z"/></svg>
                        </div>
                        <h2 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Create RH Account</h2>
                    </div>

                    <form method="post" action="{{ path('app_admin_employees') }}" class="space-y-4">
                        <input type="hidden" name="_token" value="{{ csrf_token('create_rh') }}">

                        <div>
                            <label class="block text-[12px] font-semibold text-zinc-500 dark:text-zinc-400 mb-1.5 uppercase tracking-wider" for="username">Username</label>
                            <input id="username" name="username" type="text" required
                                   class="w-full rounded-lg border border-zinc-200 dark:border-zinc-800/50 bg-zinc-50 dark:bg-zinc-950 px-3.5 py-2.5 text-sm text-zinc-800 dark:text-zinc-200 placeholder-zinc-400 dark:placeholder-zinc-600 focus:outline-none focus:border-violet-300 dark:focus:border-violet-500/30 focus:ring-2 dark:focus:ring-1 focus:ring-violet-100 dark:focus:ring-violet-500/20 focus:bg-white dark:focus:bg-zinc-950 transition-colors"
                                   placeholder="e.g. rh_dupont" />
                        </div>

                        <div>
                            <label class="block text-[12px] font-semibold text-zinc-500 dark:text-zinc-400 mb-1.5 uppercase tracking-wider" for="email">Email</label>
                            <input id="email" name="email" type="email" required
                                   class="w-full rounded-lg border border-zinc-200 dark:border-zinc-800/50 bg-zinc-50 dark:bg-zinc-950 px-3.5 py-2.5 text-sm text-zinc-800 dark:text-zinc-200 placeholder-zinc-400 dark:placeholder-zinc-600 focus:outline-none focus:border-violet-300 dark:focus:border-violet-500/30 focus:ring-2 dark:focus:ring-1 focus:ring-violet-100 dark:focus:ring-violet-500/20 focus:bg-white dark:focus:bg-zinc-950 transition-colors"
                                placeholder="rh@company.com" />
                        </div>

                        <div>
                            <label class="block text-[12px] font-semibold text-zinc-500 dark:text-zinc-400 mb-1.5 uppercase tracking-wider" for="password">Password</label>
                            <input id="password" name="password" type="password" required
                                   class="w-full rounded-lg border border-zinc-200 dark:border-zinc-800/50 bg-zinc-50 dark:bg-zinc-950 px-3.5 py-2.5 text-sm text-zinc-800 dark:text-zinc-200 placeholder-zinc-400 dark:placeholder-zinc-600 focus:outline-none focus:border-violet-300 dark:focus:border-violet-500/30 focus:ring-2 dark:focus:ring-1 focus:ring-violet-100 dark:focus:ring-violet-500/20 focus:bg-white dark:focus:bg-zinc-950 transition-colors"
                                   placeholder="Secure password" />
                        </div>

                        <button type="submit" class="w-full inline-flex justify-center items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-bold bg-gradient-to-r from-violet-600 to-fuchsia-600 text-white hover:from-violet-500 hover:to-fuchsia-500 shadow-lg shadow-violet-500/20 transition-all duration-200 mt-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                            Create RH Account
                        </button>
                    </form>
                </section>

                {# ── Employees Table ── #}
                <section class="xl:col-span-2 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm dark:shadow-none animate-slide-up stagger-2">
                    <div class="flex items-center justify-between p-6 pb-0 mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-sky-50 dark:bg-sky-500/10 flex items-center justify-center">
                                <svg class="w-4 h-4 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                            </div>
                            <h2 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Employees</h2>
                        </div>
                        <span class="text-[11px] font-bold text-sky-600 dark:text-sky-400 bg-sky-50 dark:bg-sky-500/10 px-2.5 py-1 rounded-md">{{ employees|length }} total</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-sm">
                            <thead>
                                <tr class="border-y border-zinc-100 dark:border-zinc-800/50">
                                    <th class="text-left px-6 py-3 text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">First Name</th>
                                    <th class="text-left px-6 py-3 text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">Last Name</th>
                                    <th class="text-left px-6 py-3 text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">Email</th>
                                    <th class="text-left px-6 py-3 text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">Position</th>
                                    <th class="text-left px-6 py-3 text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">RH createur</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/50">
                                {% for employee in employees %}
                                <tr
                                    class="table-row-hover hover:bg-zinc-50 dark:hover:bg-zinc-800/50 cursor-pointer"
                                    data-employee-id="{{ employee.id }}"
                                    data-first-name="{{ employee.firstName|e('html_attr') }}"
                                    data-last-name="{{ employee.lastName|e('html_attr') }}"
                                    data-email="{{ employee.email|e('html_attr') }}"
                                    data-age="{{ employee.age }}"
                                    data-job-title="{{ employee.jobTitle|e('html_attr') }}"
                                    data-rh-id="{{ employee.rhId }}"
                                    data-rh-username="{{ (rhById[employee.rhId].username ?? 'Inconnu')|e('html_attr') }}"
                                    data-rh-email="{{ (rhById[employee.rhId].email ?? '-')|e('html_attr') }}"
                                    data-created-at="{{ employee.createdAt ? employee.createdAt|date('Y-m-d H:i') : '-' }}"
                                    data-updated-at="{{ employee.updatedAt ? employee.updatedAt|date('Y-m-d H:i') : '-' }}"
                                >
                                    <td class="px-6 py-3.5 text-[13px] font-medium text-zinc-800 dark:text-zinc-300">{{ employee.firstName }}</td>
                                    <td class="px-6 py-3.5 text-[13px] text-zinc-600 dark:text-zinc-400">{{ employee.lastName }}</td>
                                    <td class="px-6 py-3.5 text-[13px] text-zinc-500">{{ employee.email }}</td>
                                    <td class="px-6 py-3.5">
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-semibold bg-violet-50 dark:bg-violet-500/10 text-violet-600 dark:text-violet-400">{{ employee.jobTitle }}</span>
                                    </td>
                                    <td class="px-6 py-3.5 text-[13px] text-zinc-400 dark:text-zinc-600">
                                        <p class="font-semibold text-zinc-700 dark:text-zinc-300">{{ rhById[employee.rhId].username ?? 'Inconnu' }}</p>
                                        <p class="text-[11px] text-zinc-400 dark:text-zinc-600 font-mono-num">ID: {{ employee.rhId }}</p>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5" class="px-6 py-12 text-center">
                                        <div class="flex flex-col items-center gap-2">
                                            <div class="w-10 h-10 rounded-lg bg-zinc-50 dark:bg-zinc-800/80 flex items-center justify-center">
                                                <svg class="w-5 h-5 text-zinc-300 dark:text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                                            </div>
                                            <p class="text-[13px] text-zinc-400 dark:text-zinc-500">No employees registered yet</p>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            {# ── Employee Details Modal ── #}
            <div id="employee-detail-modal" class="hidden fixed inset-0 z-50">
                <div id="employee-detail-backdrop" class="absolute inset-0 bg-zinc-950/60"></div>
                <div class="absolute inset-0 flex items-center justify-center p-4">
                    <div class="w-full max-w-2xl rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-2xl">
                        <div class="flex items-center justify-between px-6 py-4 border-b border-zinc-100 dark:border-zinc-800">
                            <div>
                                <h3 class="text-lg font-extrabold text-zinc-900 dark:text-zinc-100">Employee Details</h3>
                                <p class="text-[12px] text-zinc-500">Informations completes de l'employe et du RH createur.</p>
                            </div>
                            <button type="button" id="employee-detail-close" class="inline-flex items-center justify-center w-9 h-9 rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                            </button>
                        </div>

                        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                            <div class="rounded-lg border border-zinc-100 dark:border-zinc-800 p-4">
                                <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider mb-3">Employe</p>
                                <div class="space-y-2">
                                    <p><span class="text-zinc-500">ID:</span> <span id="detail-id" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                    <p><span class="text-zinc-500">Nom:</span> <span id="detail-fullname" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                    <p><span class="text-zinc-500">Email:</span> <span id="detail-email" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                    <p><span class="text-zinc-500">Age:</span> <span id="detail-age" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                    <p><span class="text-zinc-500">Poste:</span> <span id="detail-job" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                </div>
                            </div>

                            <div class="rounded-lg border border-zinc-100 dark:border-zinc-800 p-4">
                                <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider mb-3">RH createur</p>
                                <div class="space-y-2">
                                    <p><span class="text-zinc-500">RH ID:</span> <span id="detail-rh-id" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                    <p><span class="text-zinc-500">Nom RH:</span> <span id="detail-rh-username" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                    <p><span class="text-zinc-500">Email:</span> <span id="detail-rh-email" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                </div>
                            </div>

                            <div class="md:col-span-2 rounded-lg border border-zinc-100 dark:border-zinc-800 p-4">
                                <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider mb-3">Historique</p>
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <p><span class="text-zinc-500">Cree le:</span> <span id="detail-created" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                    <p><span class="text-zinc-500">Mis a jour le:</span> <span id="detail-updated" class="font-semibold text-zinc-800 dark:text-zinc-200">-</span></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ═══════════════ Users Table ═══════════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm dark:shadow-none animate-slide-up stagger-3">
                <div class="flex items-center justify-between p-6 pb-0 mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/></svg>
                        </div>
                        <h2 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">User Accounts</h2>
                    </div>
                    <span class="text-[11px] font-bold text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10 px-2.5 py-1 rounded-md">{{ users|length }} total</span>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-y border-zinc-100 dark:border-zinc-800/50">
                                <th class="text-left px-6 py-3 text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">Username</th>
                                <th class="text-left px-6 py-3 text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">Email</th>
                                <th class="text-left px-6 py-3 text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">Role</th>
                                <th class="text-left px-6 py-3 text-[11px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">Created</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/50">
                            {% for item in users %}
                            <tr class="table-row-hover hover:bg-zinc-50 dark:hover:bg-zinc-800/50">
                                <td class="px-6 py-3.5">
                                    <div class="flex items-center gap-3">
                                        <div class="w-7 h-7 rounded-md bg-gradient-to-br from-violet-500 to-fuchsia-500 flex items-center justify-center shrink-0">
                                            <span class="text-[10px] font-bold text-white">{{ item.username|first|upper }}</span>
                                        </div>
                                        <span class="text-[13px] font-medium text-zinc-800 dark:text-zinc-300">{{ item.username }}</span>
                                    </div>
                                </td>
                                <td class="px-6 py-3.5 text-[13px] text-zinc-500">{{ item.email ?: '-' }}</td>
                                <td class="px-6 py-3.5">
                                    {% if item.role == 'ADMIN' %}
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400">
                                            <span class="w-1 h-1 rounded-full bg-rose-500 dark:bg-rose-400"></span>
                                            {{ item.role }}
                                        </span>
                                    {% elseif item.role == 'RH' %}
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-violet-50 dark:bg-violet-500/10 text-violet-600 dark:text-violet-400">
                                            <span class="w-1 h-1 rounded-full bg-violet-500 dark:bg-violet-400"></span>
                                            {{ item.role }}
                                        </span>
                                    {% else %}
                                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-sky-50 dark:bg-sky-500/10 text-sky-600 dark:text-sky-400">
                                            <span class="w-1 h-1 rounded-full bg-sky-500 dark:bg-sky-400"></span>
                                            {{ item.role }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-3.5 text-[13px] text-zinc-400 dark:text-zinc-600 font-mono-num">{{ item.createdAt ? item.createdAt|date('Y-m-d H:i') : '-' }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="px-6 py-12 text-center">
                                    <div class="flex flex-col items-center gap-2">
                                        <div class="w-10 h-10 rounded-lg bg-zinc-50 dark:bg-zinc-800/80 flex items-center justify-center">
                                            <svg class="w-5 h-5 text-zinc-300 dark:text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/></svg>
                                        </div>
                                        <p class="text-[13px] text-zinc-400 dark:text-zinc-500">No user accounts found</p>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>

        </main>
    </div>
</div>

<script>
(function () {
    var modal = document.getElementById('employee-detail-modal');
    if (!modal) return;

    var backdrop = document.getElementById('employee-detail-backdrop');
    var closeBtn = document.getElementById('employee-detail-close');
    var rows = document.querySelectorAll('tr[data-employee-id]');

    var detail = {
        id: document.getElementById('detail-id'),
        fullname: document.getElementById('detail-fullname'),
        email: document.getElementById('detail-email'),
        age: document.getElementById('detail-age'),
        job: document.getElementById('detail-job'),
        rhId: document.getElementById('detail-rh-id'),
        rhUsername: document.getElementById('detail-rh-username'),
        rhEmail: document.getElementById('detail-rh-email'),
        created: document.getElementById('detail-created'),
        updated: document.getElementById('detail-updated')
    };

    function openModal(row) {
        detail.id.textContent = row.dataset.employeeId || '-';
        detail.fullname.textContent = ((row.dataset.firstName || '') + ' ' + (row.dataset.lastName || '')).trim() || '-';
        detail.email.textContent = row.dataset.email || '-';
        detail.age.textContent = row.dataset.age || '-';
        detail.job.textContent = row.dataset.jobTitle || '-';
        detail.rhId.textContent = row.dataset.rhId || '-';
        detail.rhUsername.textContent = row.dataset.rhUsername || '-';
        detail.rhEmail.textContent = row.dataset.rhEmail || '-';
        detail.created.textContent = row.dataset.createdAt || '-';
        detail.updated.textContent = row.dataset.updatedAt || '-';

        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    rows.forEach(function (row) {
        row.addEventListener('click', function () {
            openModal(row);
        });
    });

    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
            closeModal();
        }
    });
})();
</script>
{% endblock %}
