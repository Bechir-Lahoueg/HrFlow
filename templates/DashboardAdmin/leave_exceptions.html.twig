<script>
(function () {
    var modal = document.getElementById('leave-detail-modal');
    if (!modal) return;

    var buttons = document.querySelectorAll('.leave-detail-btn');
    var backdrop = document.getElementById('leave-detail-backdrop');
    var closeBtn = document.getElementById('leave-detail-close');

    var fields = {
        id: document.getElementById('ld-id'),
        employee: document.getElementById('ld-employee'),
        employeeEmail: document.getElementById('ld-employee-email'),
        type: document.getElementById('ld-type'),
        category: document.getElementById('ld-category'),
        status: document.getElementById('ld-status'),
        workflow: document.getElementById('ld-workflow'),
        start: document.getElementById('ld-start'),
        end: document.getElementById('ld-end'),
        days: document.getElementById('ld-days'),
        requestDate: document.getElementById('ld-request-date'),
        returnDate: document.getElementById('ld-return-date'),
        urgency: document.getElementById('ld-urgency'),
        reason: document.getElementById('ld-reason'),
        rhComment: document.getElementById('ld-rh-comment'),
        rhBy: document.getElementById('ld-rh-by'),
        rhAt: document.getElementById('ld-rh-at'),
        adminComment: document.getElementById('ld-admin-comment'),
        adminBy: document.getElementById('ld-admin-by'),
        adminAt: document.getElementById('ld-admin-at'),
        audit: document.getElementById('ld-audit'),
        attachmentLink: document.getElementById('ld-attachment-link'),
        attachmentEmpty: document.getElementById('ld-attachment-empty')
    };

    function read(value, fallback) {
        return value && value.trim() !== '' ? value : fallback;
    }

    function openModal(button) {
        fields.id.textContent = read(button.dataset.id, '-');
        fields.employee.textContent = read(button.dataset.employeeName, '-');
        fields.employeeEmail.textContent = read(button.dataset.employeeEmail, '-');
        fields.type.textContent = read(button.dataset.leaveType, '-');
        fields.category.textContent = read(button.dataset.requestCategory, '-');
        fields.status.textContent = read(button.dataset.status, '-');
        fields.workflow.textContent = read(button.dataset.workflowStatus, '-');
        fields.start.textContent = read(button.dataset.startDate, '-');
        fields.end.textContent = read(button.dataset.endDate, '-');
        fields.days.textContent = read(button.dataset.daysCount, '-');
        fields.requestDate.textContent = read(button.dataset.requestDate, '-');
        fields.returnDate.textContent = read(button.dataset.expectedReturnDate, '-');
        fields.urgency.textContent = read(button.dataset.urgency, '-');
        fields.reason.textContent = read(button.dataset.reason, '-');
        fields.rhComment.textContent = read(button.dataset.rhComment, '-');
        fields.rhBy.textContent = read(button.dataset.rhDecisionBy, '-');
        fields.rhAt.textContent = read(button.dataset.rhDecisionAt, '-');
        fields.adminComment.textContent = read(button.dataset.adminComment, '-');
        fields.adminBy.textContent = read(button.dataset.adminDecisionBy, '-');
        fields.adminAt.textContent = read(button.dataset.adminDecisionAt, '-');
        fields.audit.textContent = read(button.dataset.auditLog, '-');

        var attachment = read(button.dataset.attachmentPath, '');
        if (attachment !== '') {
            fields.attachmentLink.href = attachment;
            fields.attachmentLink.classList.remove('hidden');
            fields.attachmentEmpty.classList.add('hidden');
        } else {
            fields.attachmentLink.href = '#';
            fields.attachmentLink.classList.add('hidden');
            fields.attachmentEmpty.classList.remove('hidden');
        }

        modal.classList.remove('hidden');
        document.body.classList.add('overflow-hidden');
    }

    function closeModal() {
        modal.classList.add('hidden');
        document.body.classList.remove('overflow-hidden');
    }

    buttons.forEach(function (button) {
        button.addEventListener('click', function () {
            openModal(button);
        });
    });

    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !modal.classList.contains('hidden')) {
            closeModal();
        }
    });
})();
</script>
