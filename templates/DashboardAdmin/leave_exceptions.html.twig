{% extends 'base.html.twig' %}

{% block title %}Conges Exceptionnels | HrFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .decision-row{transition:all .15s ease}
        .decision-row:hover{background:linear-gradient(90deg,#f8fafc,#f1f5f9)}
        .dark .decision-row:hover{background:rgba(255,255,255,.03)}
        .status-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;letter-spacing:.02em}
        .field-input{transition:all .2s}
        .field-input:focus{box-shadow:0 0 0 3px rgba(6,182,212,.12)}
    </style>
{% endblock %}

{% block body %}
{# Compute stats #}
{% set pendingCount = 0 %}
{% set approvedCount = 0 %}
{% set rejectedCount = 0 %}
{% for leave in leaveRequests %}
    {% if leave.workflowStatus == 'ADMIN_PENDING' %}
        {% set pendingCount = pendingCount + 1 %}
    {% elseif leave.workflowStatus == 'ADMIN_APPROVED' %}
        {% set approvedCount = approvedCount + 1 %}
    {% elseif leave.workflowStatus == 'ADMIN_REJECTED' %}
        {% set rejectedCount = rejectedCount + 1 %}
    {% endif %}
{% endfor %}

<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardAdmin/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardAdmin/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/30 text-rose-700 dark:text-rose-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-rose-100 dark:bg-rose-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 lg:p-8 space-y-6 max-w-[1440px] mx-auto"
              data-controller="tab-switcher"
              data-tab-switcher-active-value="0">

            {# ═══════════════════ PAGE HEADER ═══════════════════ #}
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 anim-up">
                <div>
                    <h1 class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 tracking-tight">Conges Exceptionnels</h1>
                    <p class="text-[13px] text-zinc-400 mt-1">Validation finale apres pre-approbation RH + historique (approuves/refuses par vous).</p>
                </div>
                {% if leaveRequests|length > 0 %}
                <div class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-violet-50 dark:bg-violet-950/30 border border-violet-200 dark:border-violet-800/50">
                    <div class="w-8 h-8 rounded-lg bg-violet-100 dark:bg-violet-900/40 flex items-center justify-center">
                        <svg class="w-4 h-4 text-violet-600 dark:text-violet-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-violet-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-violet-200 uppercase tracking-[0.15em]">Validation Admin</span>
                        </div>
                        <h2 class="text-3xl md:text-5xl font-display leading-[1.1] tracking-tight">Conges Exceptionnels</h2>
                        <p class="mt-3 text-[14px] text-slate-300/90 max-w-lg leading-relaxed">Validation finale des demandes exceptionnelles apres pre-approbation RH. Gerez les decisions et consultez l'historique.</p>
                    </div>
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="rounded-xl border border-white/15 bg-white/[0.08] backdrop-blur-sm p-4 hover:bg-white/[0.12] transition-colors group">
                            <p class="text-[9px] uppercase tracking-[0.15em] text-violet-200/60 font-bold">Total</p>
                            <p class="mt-1 text-2xl font-extrabold font-mono-num group-hover:scale-105 transition-transform origin-left">{{ leaveRequests|length }}</p>
                        </div>
                        <div class="rounded-xl border border-white/15 bg-white/[0.08] backdrop-blur-sm p-4 hover:bg-white/[0.12] transition-colors group">
                            <div class="flex items-center justify-between">
                                <p class="text-[9px] uppercase tracking-[0.15em] text-violet-200/60 font-bold">Attente</p>
                                {% if pendingCount > 0 %}<span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>{% endif %}
                            </div>
                            <p class="mt-1 text-2xl font-extrabold font-mono-num text-amber-300 group-hover:scale-105 transition-transform origin-left">{{ pendingCount }}</p>
                        </div>
                        <div class="rounded-xl border border-white/15 bg-white/[0.08] backdrop-blur-sm p-4 hover:bg-white/[0.12] transition-colors group">
                            <p class="text-[9px] uppercase tracking-[0.15em] text-violet-200/60 font-bold">Approuves</p>
                            <p class="mt-1 text-2xl font-extrabold font-mono-num text-emerald-400 group-hover:scale-105 transition-transform origin-left">{{ approvedCount }}</p>
                        </div>
                        <div class="rounded-xl border border-white/15 bg-white/[0.08] backdrop-blur-sm p-4 hover:bg-white/[0.12] transition-colors group">
                            <p class="text-[9px] uppercase tracking-[0.15em] text-violet-200/60 font-bold">Refuses</p>
                            <p class="mt-1 text-2xl font-extrabold font-mono-num text-rose-400 group-hover:scale-105 transition-transform origin-left">{{ rejectedCount }}</p>
                        </div>
                    </div>
                </div>
            </section>

            {# ═══════════ TAB NAVIGATION (2 tabs) ═══════════ #}
            <div class="animate-slide-up stagger-1 overflow-x-auto pb-1">
                <div class="tab-bar">
                    <div data-tab-switcher-target="indicator" class="tab-indicator"></div>

                    <button type="button" data-tab-switcher-target="tab" data-action="click->tab-switcher#switch" data-index="0" class="tab-btn tab-active" role="tab" aria-selected="true">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                        Decisions
                        {% if pendingCount > 0 %}
                            <span class="tab-count">{{ pendingCount }}</span>
                        {% endif %}
                    </button>

                    <button type="button" data-tab-switcher-target="tab" data-action="click->tab-switcher#switch" data-index="1" class="tab-btn tab-inactive" role="tab" aria-selected="false">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6z"/></svg>
                        Apercu
                    </button>
                </div>
            </div>

            {# ══════════════════════════════════════════════ #}
            {# ═══════════ PANEL 0: DECISIONS ═════════════ #}
            {# ══════════════════════════════════════════════ #}
            <div data-tab-switcher-target="panel" class="space-y-6">
                <section class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-100 dark:border-zinc-800/50 shadow-[0_1px_3px_rgba(0,0,0,.04)] overflow-hidden animate-slide-up">
                    {# Table Header #}
                    <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/50">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shadow-sm">
                                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Validation Admin</h3>
                                    <p class="text-[11px] text-zinc-400">Demandes en attente + historique de vos decisions admin</p>
                                </div>
                            </div>
                            <div>
                                <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Validation Admin</h3>
                                <p class="text-[11px] text-zinc-400">Demandes en attente + historique de vos decisions admin</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-violet-50 dark:bg-violet-950/30 border border-violet-100 dark:border-violet-900/50">
                            <div class="w-1.5 h-1.5 rounded-full bg-violet-500 animate-pulse"></div>
                            <span class="text-[10px] font-bold text-violet-700 dark:text-violet-400 uppercase tracking-wider">{{ leaveRequests|length }} demandes</span>
                        </div>
                    </div>

                {# Table #}
                <div class="overflow-x-auto">
                    <table class="min-w-full">
                        <thead>
                            <tr class="border-b border-zinc-100 dark:border-zinc-800/50">
                                <th class="text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-zinc-400 py-3 px-5 bg-zinc-50/60 dark:bg-zinc-800/30">Employe</th>
                                <th class="text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Periode</th>
                                <th class="text-center text-[10px] font-semibold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Jours</th>
                                <th class="text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Urgence</th>
                                <th class="text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Justificatif</th>
                                <th class="text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Commentaire RH</th>
                                <th class="text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Details</th>
                                <th class="text-left text-[10px] font-semibold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Decision</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-50 dark:divide-zinc-800/30">
                        {% for leave in leaveRequests %}
                            <tr class="decision-row align-top">
                                <td class="py-3.5 px-5">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-violet-500 to-purple-500 flex items-center justify-center shrink-0 shadow-sm">
                                            <span class="text-[11px] font-bold text-white">{{ leave.employeeName|first|upper }}</span>
                                        </div>
                                        <span class="text-[13px] font-semibold text-zinc-700 dark:text-zinc-300">{{ leave.employeeName }}</span>
                                    </div>
                                </td>
                                <td class="py-3.5 px-4">
                                    <p class="text-[13px] font-medium text-zinc-700 dark:text-zinc-300">{{ leave.startDate|date('d/m/Y') }}</p>
                                    <p class="text-[11px] text-zinc-400">au {{ leave.endDate|date('d/m/Y') }}</p>
                                </td>
                                <td class="py-3.5 px-4 text-center">
                                    <span class="text-[14px] font-bold text-zinc-800 dark:text-zinc-200 tabular-nums">{{ leave.daysCount }}</span>
                                </td>
                                <td class="py-3.5 px-4">
                                    {% if leave.urgencyLevel == 'HIGH' %}
                                        <span class="status-pill bg-red-50 dark:bg-red-950/30 text-red-700 dark:text-red-400 border border-red-200 dark:border-red-800/50">
                                            <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>HIGH
                                        </span>
                                    {% elseif leave.urgencyLevel == 'MEDIUM' %}
                                        <span class="status-pill bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50">
                                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>MEDIUM
                                        </span>
                                    {% else %}
                                        <span class="status-pill bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700">
                                            <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>{{ leave.urgencyLevel ?: 'LOW' }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="py-3.5 px-4">
                                    {% if leave.attachmentPath %}
                                        <a href="{{ leave.attachmentPath }}" target="_blank" class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-violet-600 dark:text-violet-400 hover:text-violet-700 bg-violet-50 dark:bg-violet-950/30 border border-violet-200 dark:border-violet-800/50 px-2.5 py-1.5 rounded-lg transition-colors">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13"/></svg>
                                            Ouvrir
                                        </a>
                                    {% else %}
                                        <span class="text-zinc-300 dark:text-zinc-600">-</span>
                                    {% endif %}
                                </td>
                                <td class="py-3.5 px-4">
                                    {% if leave.rhComment %}
                                        <p class="text-[12px] text-zinc-500 dark:text-zinc-400 max-w-[180px] truncate" title="{{ leave.rhComment }}">{{ leave.rhComment }}</p>
                                    {% else %}
                                        <span class="text-zinc-300 dark:text-zinc-600">-</span>
                                    {% endif %}
                                </td>
                                <td class="py-3.5 px-4">
                                    <button
                                        type="button"
                                        class="leave-detail-btn inline-flex items-center gap-1.5 text-[11px] font-semibold text-slate-700 dark:text-slate-200 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-2.5 py-1.5 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
                                        data-id="{{ leave.id }}"
                                        data-employee-name="{{ leave.employeeName|e('html_attr') }}"
                                        data-employee-email="{{ leave.employee ? leave.employee.email|default('-') : '-' }}"
                                        data-leave-type="{{ leave.leaveType|default('-')|e('html_attr') }}"
                                        data-request-category="{{ leave.requestCategory|default('-')|e('html_attr') }}"
                                        data-status="{{ leave.status|default('-')|e('html_attr') }}"
                                        data-workflow-status="{{ leave.workflowStatus|default('-')|e('html_attr') }}"
                                        data-start-date="{{ leave.startDate ? leave.startDate|date('d/m/Y') : '-' }}"
                                        data-end-date="{{ leave.endDate ? leave.endDate|date('d/m/Y') : '-' }}"
                                        data-days-count="{{ leave.daysCount|default('-') }}"
                                        data-request-date="{{ leave.requestDate ? leave.requestDate|date('d/m/Y') : '-' }}"
                                        data-urgency="{{ leave.urgencyLevel|default('LOW')|e('html_attr') }}"
                                        data-reason="{{ leave.reason|default('-')|e('html_attr') }}"
                                        data-rh-comment="{{ leave.rhComment|default('-')|e('html_attr') }}"
                                        data-rh-decision-by="{{ leave.rhDecisionBy|default('-')|e('html_attr') }}"
                                        data-rh-decision-at="{{ leave.rhDecisionAt ? leave.rhDecisionAt|date('d/m/Y H:i') : '-' }}"
                                        data-admin-comment="{{ leave.adminComment|default('-')|e('html_attr') }}"
                                        data-admin-decision-by="{{ leave.adminDecisionBy|default('-')|e('html_attr') }}"
                                        data-admin-decision-at="{{ leave.adminDecisionAt ? leave.adminDecisionAt|date('d/m/Y H:i') : '-' }}"
                                        data-expected-return-date="{{ leave.expectedReturnDate ? leave.expectedReturnDate|date('d/m/Y') : '-' }}"
                                        data-attachment-path="{{ leave.attachmentPath|default('')|e('html_attr') }}"
                                        data-audit-log="{{ leave.auditLog|default('-')|e('html_attr') }}"
                                    >
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12s3.75-7.5 9.75-7.5 9.75 7.5 9.75 7.5-3.75 7.5-9.75 7.5S2.25 12 2.25 12z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 15.75a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z"/></svg>
                                        Voir
                                    </button>
                                </td>
                                <td class="py-3.5 px-4">
                                    <div class="space-y-2 min-w-[220px]">
                                        {% if leave.workflowStatus == 'ADMIN_PENDING' %}
                                            <form method="post" action="{{ path('app_admin_leave_exception_approve', {id: leave.id}) }}" class="space-y-1.5 rounded-xl border border-emerald-200 dark:border-emerald-800/50 bg-emerald-50/50 dark:bg-emerald-950/20 p-2.5">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_leave_exception_approve_' ~ leave.id) }}">
                                                <input type="text" name="admin_comment" placeholder="Commentaire (optionnel)" class="field-input w-full rounded-lg border border-zinc-200 dark:border-zinc-700 text-[11px] bg-white dark:bg-zinc-800 py-1.5 px-2.5 focus:border-emerald-400 focus:ring-emerald-400 transition-all placeholder:text-zinc-300">
                                                <button type="submit" class="w-full text-[11px] font-semibold px-3 py-2 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-colors flex items-center justify-center gap-1.5 active:scale-[0.98]">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                    Approbation finale
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('app_admin_leave_exception_reject', {id: leave.id}) }}" class="space-y-1.5 rounded-xl border border-red-200 dark:border-red-800/50 bg-red-50/50 dark:bg-red-950/20 p-2.5" novalidate>
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin_leave_exception_reject_' ~ leave.id) }}">
                                                <input type="text" name="admin_comment" placeholder="Motif de refus (obligatoire)" class="field-input w-full rounded-lg border border-zinc-200 dark:border-zinc-700 text-[11px] bg-white dark:bg-zinc-800 py-1.5 px-2.5 focus:border-red-400 focus:ring-red-400 transition-all placeholder:text-zinc-300">
                                                <button type="submit" class="w-full text-[11px] font-semibold px-3 py-2 rounded-lg bg-red-600 text-white hover:bg-red-700 transition-colors flex items-center justify-center gap-1.5 active:scale-[0.98]">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                                                    Refuser
                                                </button>
                                            </form>
                                        {% else %}
                                            <div class="rounded-xl border border-emerald-200 dark:border-emerald-800/50 bg-emerald-50/70 dark:bg-emerald-950/20 p-2.5 text-[11px] font-semibold text-emerald-700 dark:text-emerald-400 flex items-center gap-2">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                Deja approuve par vous
                                            </div>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="8" class="py-20 text-center">
                                    <svg class="w-14 h-14 text-zinc-200 dark:text-zinc-700 mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>
