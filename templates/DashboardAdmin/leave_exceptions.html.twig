{% extends 'base.html.twig' %}

{% block title %}Exceptional Leave Validation | HrFlow{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardAdmin/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardAdmin/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm font-medium">{{ message }}</div>
        {% endfor %}

        <main class="p-6 max-w-7xl mx-auto space-y-6">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-100">Exceptional Leave Requests</h1>
                    <p class="text-sm text-zinc-500">Final admin validation after RH pre-approval.</p>
                </div>
                <span class="text-xs font-bold text-violet-600 bg-violet-50 px-2.5 py-1 rounded-md">{{ leaveRequests|length }} pending</span>
            </div>

            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-200/70 dark:border-zinc-800/50 overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="text-left text-[11px] font-bold uppercase tracking-wider text-zinc-400 border-b border-zinc-100 bg-zinc-50/80">
                            <th class="py-3 px-4">Employee</th>
                            <th class="py-3 px-4">Period</th>
                            <th class="py-3 px-4">Days</th>
                            <th class="py-3 px-4">Urgency</th>
                            <th class="py-3 px-4">Justification</th>
                            <th class="py-3 px-4">RH Comment</th>
                            <th class="py-3 px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-100">
                    {% for leave in leaveRequests %}
                        <tr>
                            <td class="py-3 px-4 font-semibold text-zinc-700">{{ leave.employeeName }}</td>
                            <td class="py-3 px-4 text-zinc-600">{{ leave.startDate|date('d/m/Y') }} - {{ leave.endDate|date('d/m/Y') }}</td>
                            <td class="py-3 px-4 text-zinc-700 font-bold">{{ leave.daysCount }}</td>
                            <td class="py-3 px-4">
                                <span class="inline-flex px-2 py-1 rounded-md text-xs font-semibold {{ leave.urgencyLevel == 'HIGH' ? 'bg-red-50 text-red-700' : (leave.urgencyLevel == 'MEDIUM' ? 'bg-amber-50 text-amber-700' : 'bg-slate-100 text-slate-700') }}">{{ leave.urgencyLevel ?: '-' }}</span>
                            </td>
                            <td class="py-3 px-4">
                                {% if leave.attachmentPath %}
                                    <a href="{{ leave.attachmentPath }}" target="_blank" class="text-violet-600 hover:text-violet-700 font-semibold">Open file</a>
                                {% else %}
                                    <span class="text-zinc-400">-</span>
                                {% endif %}
                            </td>
                            <td class="py-3 px-4 text-zinc-500 max-w-[220px]">{{ leave.rhComment ?: '-' }}</td>
                            <td class="py-3 px-4">
                                <div class="min-w-[220px] space-y-2">
                                    <form method="post" action="{{ path('app_admin_leave_exception_approve', {id: leave.id}) }}" class="space-y-1.5 rounded-lg border border-emerald-200 bg-emerald-50/60 p-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_leave_exception_approve_' ~ leave.id) }}">
                                        <input type="text" name="admin_comment" placeholder="Commentaire (optionnel)" class="w-full rounded-md border-zinc-200 text-xs py-1.5">
                                        <button type="submit" class="w-full px-3 py-2 rounded-md text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700">Final Approve</button>
                                    </form>

                                    <form method="post" action="{{ path('app_admin_leave_exception_reject', {id: leave.id}) }}" class="space-y-1.5 rounded-lg border border-red-200 bg-red-50/60 p-2">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin_leave_exception_reject_' ~ leave.id) }}">
                                        <input type="text" name="admin_comment" placeholder="Motif de refus (obligatoire)" required class="w-full rounded-md border-zinc-200 text-xs py-1.5">
                                        <button type="submit" class="w-full px-3 py-2 rounded-md text-xs font-bold text-white bg-red-600 hover:bg-red-700">Final Reject</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="7" class="py-16 text-center text-zinc-400">No exceptional requests pending admin validation.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </section>
        </main>
    </div>
</div>
{% endblock %}
