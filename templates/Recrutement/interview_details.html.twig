{% extends 'base.html.twig' %}

{% block title %}Détails entretien - {{ interview.application.candidateName|default('Candidat') }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6">
            <div class="max-w-3xl mx-auto">
                {# ══════════ Header ══════════ #}
                <header class="mb-8">
                    <div class="flex items-center gap-3 mb-2">
                        <a href="{{ path('app_rh_interviews') }}" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                        </a>
                        <h1 class="text-2xl font-bold text-slate-800 dark:text-white">Détails de l'entretien</h1>
                    </div>
                    <div class="flex items-center justify-between">
                    <p class="text-slate-500 dark:text-slate-400">{{ interview.type|title }} avec {{ interview.application.candidateName|default('Candidat') }}</p>
                        {# PDF Export Button #}
                        <a href="{{ path('app_rh_interview_pdf', {id: interview.id}) }}" class="inline-flex items-center gap-2 px-4 py-2 bg-red-50 text-red-600 rounded-lg hover:bg-red-100 transition-colors text-sm font-medium" target="_blank">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            Export PDF
                        </a>
                    </div>
                </header>

                <div class="bg-white dark:bg-zinc-800 rounded-2xl border border-slate-200/60 dark:border-zinc-700 p-6 shadow-sm">
                    <div class="flex items-center gap-4 mb-8">
                <div class="w-16 h-16 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                </div>
                <div>
                    <h2 class="text-xl font-bold text-slate-800 dark:text-white">{{ interview.type|title }}</h2>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium mt-1
                        {% if interview.result == 'PASSED' %}
                            bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400
                        {% elseif interview.result == 'FAILED' %}
                            bg-rose-100 text-rose-800 dark:bg-rose-900/30 dark:text-rose-400
                        {% else %}
                            bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400
                        {% endif %}">
                        {{ interview.result|default('PENDING') }}
                    </span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div class="p-4 rounded-xl bg-slate-50 dark:bg-zinc-700/50">
                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Candidat</label>
                    <p class="mt-2 text-lg font-semibold text-slate-800 dark:text-white">
                        <a href="{{ path('app_rh_applications_show', {id: interview.application.id}) }}" class="text-violet-600 hover:text-violet-700 dark:text-violet-400">{{ interview.application.candidateName|default('—') }}</a>
                    </p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">{{ interview.application.emailAddress|default('') }}</p>
                </div>

                <div class="p-4 rounded-xl bg-slate-50 dark:bg-zinc-700/50">
                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Date et heure</label>
                    <p class="mt-2 text-lg font-semibold text-slate-800 dark:text-white">{{ interview.interviewDate ? interview.interviewDate|date('d/m/Y H:i') : '—' }}</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">{{ interview.interviewDate ? interview.interviewDate|date('l') : '' }}</p>
                </div>

                <div class="p-4 rounded-xl bg-slate-50 dark:bg-zinc-700/50">
                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Interviewer</label>
                    <p class="mt-2 text-lg font-semibold text-slate-800 dark:text-white">{{ interviewer ? interviewer.username : 'Utilisateur #' ~ interview.interviewerId }}</p>
                    <p class="text-sm text-slate-500 dark:text-slate-400">{{ interviewer ? interviewer.email : '' }}</p>
                </div>

                <div class="p-4 rounded-xl bg-slate-50 dark:bg-zinc-700/50">
                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Lieu / Lien</label>
                    {% if interview.location %}
                        <p class="mt-2 text-lg font-semibold text-slate-800 dark:text-white">{{ interview.location }}</p>
                    {% elseif interview.meetingLink %}
                        <p class="mt-2">
                            <a href="{{ interview.meetingLink }}" target="_blank" class="text-violet-600 hover:text-violet-700 dark:text-violet-400 font-medium">Rejoindre la réunion</a>
                        </p>
                    {% else %}
                        <p class="mt-2 text-slate-500">Non précisé</p>
                    {% endif %}
                </div>
            </div>

            {% if interview.score > 0 %}
            <div class="mb-6">
                <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Score</label>
                <div class="mt-2 flex items-center gap-3">
                    <div class="flex-1 h-3 bg-slate-200 dark:bg-zinc-600 rounded-full overflow-hidden">
                        <div class="h-full rounded-full {% if interview.score >= 70 %}bg-emerald-500{% elseif interview.score >= 50 %}bg-amber-500{% else %}bg-rose-500{% endif %}" style="width: {{ interview.score }}%"></div>
                    </div>
                    <span class="text-lg font-bold text-slate-800 dark:text-white">{{ interview.score }}/100</span>
                </div>
            </div>
            {% endif %}

            {% if interview.feedback %}
            <div class="mb-6">
                <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Feedback</label>
                <div class="mt-2 p-4 rounded-xl bg-slate-50 dark:bg-zinc-700/50 border border-slate-200 dark:border-zinc-600">
                    <p class="text-sm text-slate-700 dark:text-slate-300 whitespace-pre-wrap">{{ interview.feedback }}</p>
                </div>
            </div>
            {% endif %}

            <div class="pt-6 border-t border-slate-200 dark:border-zinc-700 flex items-center gap-3">
                <a href="{{ path('app_rh_interviews_edit', {id: interview.id}) }}" class="inline-flex items-center justify-center gap-2 px-6 py-2.5 rounded-lg text-sm font-semibold bg-indigo-600 text-white hover:bg-indigo-700 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
                    Modifier
                </a>
                <a href="{{ path('app_rh_applications_show', {id: interview.application.id}) }}" class="px-4 py-2.5 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors border border-slate-200">
                    Voir le candidat
                </a>
            </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
