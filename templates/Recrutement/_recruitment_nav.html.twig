{# Recruitment Sub-Navigation #}
{% set currentRoute = app.request.get('_route') %}

{% macro navLink(href, label, isActive) %}
    <a href="{{ href }}"
       class="px-4 py-2 rounded-lg text-[13px] font-semibold transition-all duration-200 flex items-center gap-2"
       {% if isActive %}style="background: linear-gradient(to right, #145EB7, #1e7dd9); color: #fff; box-shadow: 0 2px 8px rgba(20,94,183,0.35);"{% else %}style="color: #475569;"
       onmouseover="this.style.background='#f1f5f9'; this.style.color='#1e293b';"
       onmouseout="this.style.background=''; this.style.color='#475569';"{% endif %}>
{% endmacro %}

<div class="mx-6 mt-4">
    <nav class="inline-flex items-center gap-1 p-1 bg-white rounded-xl border border-slate-200 shadow-sm">

        {# Offres #}
        <a href="{{ path('app_rh_job_offers') }}"
           class="px-4 py-2 rounded-lg text-[13px] font-semibold transition-all duration-200 flex items-center gap-2"
           {% if currentRoute == 'app_rh_job_offers' %}
               style="background: linear-gradient(to right, #145EB7, #1e7dd9); color: #fff; box-shadow: 0 2px 8px rgba(20,94,183,0.30);"
           {% else %}
               style="color: #475569;"
               onmouseover="this.style.background='#f1f5f9'; this.style.color='#1e293b';"
               onmouseout="this.style.background=''; this.style.color='#475569';"
           {% endif %}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z"/>
            </svg>
            Offres
        </a>

        {# Candidatures #}
        <a href="{{ path('app_rh_applications') }}"
           class="px-4 py-2 rounded-lg text-[13px] font-semibold transition-all duration-200 flex items-center gap-2"
           {% if currentRoute == 'app_rh_applications' %}
               style="background: linear-gradient(to right, #145EB7, #1e7dd9); color: #fff; box-shadow: 0 2px 8px rgba(20,94,183,0.30);"
           {% else %}
               style="color: #475569;"
               onmouseover="this.style.background='#f1f5f9'; this.style.color='#1e293b';"
               onmouseout="this.style.background=''; this.style.color='#475569';"
           {% endif %}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
            </svg>
            Candidatures
        </a>

        {# Entretiens #}
        <a href="{{ path('app_rh_interviews') }}"
           class="px-4 py-2 rounded-lg text-[13px] font-semibold transition-all duration-200 flex items-center gap-2"
           {% if currentRoute == 'app_rh_interviews' %}
               style="background: linear-gradient(to right, #145EB7, #1e7dd9); color: #fff; box-shadow: 0 2px 8px rgba(20,94,183,0.30);"
           {% else %}
               style="color: #475569;"
               onmouseover="this.style.background='#f1f5f9'; this.style.color='#1e293b';"
               onmouseout="this.style.background=''; this.style.color='#475569';"
           {% endif %}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
            </svg>
            Entretiens
        </a>

        {# Calendrier #}
        <a href="{{ path('app_rh_interviews_calendar') }}"
           class="px-4 py-2 rounded-lg text-[13px] font-semibold transition-all duration-200 flex items-center gap-2"
           {% if currentRoute == 'app_rh_interviews_calendar' %}
               style="background: linear-gradient(to right, #145EB7, #1e7dd9); color: #fff; box-shadow: 0 2px 8px rgba(20,94,183,0.30);"
           {% else %}
               style="color: #475569;"
               onmouseover="this.style.background='#f1f5f9'; this.style.color='#1e293b';"
               onmouseout="this.style.background=''; this.style.color='#475569';"
           {% endif %}>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Calendrier
        </a>

    </nav>
</div>
