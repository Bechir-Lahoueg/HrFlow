{# Recruitment Sub-Navigation - Subtle pill-style nav for recruitment module #}
{% set currentRoute = app.request.get('_route') %}

<div class="mx-6 mt-4">
    <nav class="inline-flex items-center gap-1 p-1 bg-white dark:bg-zinc-900 rounded-xl border border-slate-200/60 dark:border-zinc-800/50 shadow-sm">
        <a href="{{ path('app_rh_job_offers') }}"
           class="px-4 py-2 rounded-lg text-[13px] font-medium transition-all duration-200 flex items-center gap-2
                  {{ currentRoute == 'app_rh_job_offers' 
                      ? 'bg-gradient-to-r from-violet-500 to-indigo-600 text-white shadow-md' 
                      : 'text-slate-600 dark:text-zinc-400 hover:bg-slate-100 dark:hover:bg-zinc-800 hover:text-slate-800 dark:hover:text-zinc-200' }}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 9.006a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 9.006c-1.966.356-3.93.534-5.905.534-1.975 0-3.94-.178-5.905-.534"/>
            </svg>
            Offres
        </a>
        <a href="{{ path('app_rh_applications') }}"
           class="px-4 py-2 rounded-lg text-[13px] font-medium transition-all duration-200 flex items-center gap-2
                  {{ currentRoute == 'app_rh_applications' 
                      ? 'bg-gradient-to-r from-teal-500 to-emerald-600 text-white shadow-md' 
                      : 'text-slate-600 dark:text-zinc-400 hover:bg-slate-100 dark:hover:bg-zinc-800 hover:text-slate-800 dark:hover:text-zinc-200' }}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
            </svg>
            Candidatures
        </a>
        <a href="{{ path('app_rh_interviews') }}"
           class="px-4 py-2 rounded-lg text-[13px] font-medium transition-all duration-200 flex items-center gap-2
                  {{ currentRoute == 'app_rh_interviews' 
                      ? 'bg-gradient-to-r from-indigo-500 to-violet-600 text-white shadow-md' 
                      : 'text-slate-600 dark:text-zinc-400 hover:bg-slate-100 dark:hover:bg-zinc-800 hover:text-slate-800 dark:hover:text-zinc-200' }}">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
            </svg>
            Entretiens
        </a>
    </nav>
</div>
