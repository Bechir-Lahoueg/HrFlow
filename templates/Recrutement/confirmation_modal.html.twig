{# Configurable Confirmation Modal
   Usage:
   {% include 'Recrutement/confirmation_modal.html.twig' with {
       modal_id: 'deleteJobOfferModal',
       title: 'Confirmer la suppression',
       message: 'Êtes-vous sûr de vouloir supprimer cette offre d\'emploi ?',
       confirm_button_text: 'Supprimer',
       confirm_button_class: 'bg-red-600 hover:bg-red-700',
       form_action: path('app_rh_job_offers_delete', {id: offer.id}),
       csrf_token: csrf_token('delete_job_offer_' ~ offer.id)
   } %}
#}
<div id="{{ modal_id|default('confirmationModal') }}" class="fixed inset-0 z-[9999] hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    {# Backdrop #}
    <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity opacity-0 modal-backdrop"></div>

    <div class="fixed inset-0 z-[10000] overflow-y-auto">
        <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
            {# Modal panel #}
            <div class="relative transform overflow-hidden rounded-2xl bg-white dark:bg-zinc-900 text-left shadow-2xl shadow-slate-900/20 transition-all sm:my-8 sm:w-full sm:max-w-md opacity-0 scale-95 modal-panel">
                
                {# Header with icon #}
                <div class="bg-gradient-to-br from-rose-50 to-orange-50 dark:from-rose-900/20 dark:to-orange-900/20 px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-full bg-rose-100 dark:bg-rose-900/30 sm:mx-0 sm:h-10 sm:w-10">
                            <svg class="h-6 w-6 text-rose-600 dark:text-rose-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
                            </svg>
                        </div>
                        <div class="mt-3 text-center sm:ml-4 sm:mt-0 sm:text-left">
                            <h3 class="text-base font-semibold leading-6 text-slate-900 dark:text-zinc-100" id="modal-title">
                                {{ title|default('Confirmer l\'action') }}
                            </h3>
                            <div class="mt-2">
                                <p class="text-sm text-slate-500 dark:text-zinc-400">
                                    {{ message|default('Êtes-vous sûr de vouloir effectuer cette action ?') }}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Footer with buttons #}
                <div class="bg-slate-50 dark:bg-zinc-800/50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6 gap-2">
                    <form method="post" action="{{ form_action }}" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token }}">
                        <button type="submit" class="inline-flex w-full justify-center rounded-lg {{ confirm_button_class|default('bg-rose-600 hover:bg-rose-700') }} px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition-all hover:shadow-md sm:w-auto">
                            {{ confirm_button_text|default('Confirmer') }}
                        </button>
                    </form>
                    <button type="button" onclick="closeModal('{{ modal_id|default('confirmationModal') }}')" class="mt-3 inline-flex w-full justify-center rounded-lg bg-white dark:bg-zinc-800 px-4 py-2.5 text-sm font-semibold text-slate-700 dark:text-zinc-300 shadow-sm ring-1 ring-inset ring-slate-300 dark:ring-zinc-700 hover:bg-slate-50 dark:hover:bg-zinc-700 transition-all sm:mt-0 sm:w-auto">
                        Annuler
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
