{% extends 'base.html.twig' %}

{% block title %}Détails candidature - {{ application.candidateName }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6">
            {# ══════════ Header ══════════ #}
            <header class="mb-8">
                <div class="flex items-center gap-3 mb-2">
                    <a href="{{ path('app_rh_applications') }}" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    </a>
                    <h1 class="text-2xl font-bold text-slate-800 dark:text-white">Détails du candidat</h1>
                </div>
                <p class="text-slate-500 dark:text-slate-400 ml-12">{{ application.candidateName }}</p>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {# ══════════ Candidate Info Card ══════════ #}
                <div class="lg:col-span-1">
                    <div class="bg-white dark:bg-zinc-800 rounded-2xl border border-slate-200/60 dark:border-zinc-700 p-6 shadow-sm">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-16 h-16 rounded-full bg-gradient-to-br from-teal-400 to-cyan-500 flex items-center justify-center text-white font-bold text-xl">
                            {{ application.candidateName|first|upper }}
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-slate-800 dark:text-white">{{ application.candidateName }}</h2>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                {% if application.status == 'HIRED' %}
                                    bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400
                                {% elseif application.status == 'REJECTED' %}
                                    bg-rose-100 text-rose-800 dark:bg-rose-900/30 dark:text-rose-400
                                {% elseif application.status == 'INTERVIEW' %}
                                    bg-violet-100 text-violet-800 dark:bg-violet-900/30 dark:text-violet-400
                                {% else %}
                                    bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400
                                {% endif %}">
                                {{ application.status }}
                            </span>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Email</label>
                            <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ application.emailAddress|default('—') }}</p>
                        </div>

                        <div>
                            <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Offre</label>
                            <p class="mt-1 text-sm font-semibold text-violet-600 dark:text-violet-400">
                                <a href="{{ path('app_rh_job_offers_show', {id: application.jobOffer.id}) }}">{{ application.jobOffer.title }}</a>
                            </p>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Département</label>
                                <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ application.department|default('—') }}</p>
                            </div>
                            <div>
                                <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Expérience</label>
                                <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ application.experienceLevel|default('—') }}</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Source</label>
                                <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ application.source|default('—') }}</p>
                            </div>
                            <div>
                                <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Postulé le</label>
                                <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ application.appliedAt ? application.appliedAt|date('d/m/Y') : '—' }}</p>
                            </div>
                        </div>

                        {% if application.notes %}
                        <div>
                            <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Notes</label>
                            <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ application.notes }}</p>
                        </div>
                        {% endif %}

                        <div class="grid grid-cols-2 gap-4 pt-4 border-t border-slate-200 dark:border-zinc-700">
                            {% if application.cvPath %}
                            <a href="{{ asset('uploads/cv/' ~ application.cvPath) }}" target="_blank" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium bg-teal-50 text-teal-700 hover:bg-teal-100 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                                Voir CV
                            </a>
                            {% endif %}
                            {% if application.coverLetterPath %}
                            <a href="{{ asset('uploads/cover_letters/' ~ application.coverLetterPath) }}" target="_blank" class="inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-medium bg-cyan-50 text-cyan-700 hover:bg-cyan-100 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                                Lettre
                            </a>
                            {% endif %}
                        </div>
                    </div>

                    <div class="mt-6 pt-6 border-t border-slate-200 dark:border-zinc-700">
                        <a href="{{ path('app_rh_applications_edit', {id: application.id}) }}" class="inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-lg text-sm font-semibold bg-teal-600 text-white hover:bg-teal-700 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
                            Modifier
                        </a>
                    </div>
                </div>
            </div>

            {# ══════════ Interviews List ══════════ #}
            <div class="lg:col-span-2">
                <div class="bg-white dark:bg-zinc-800 rounded-2xl border border-slate-200/60 dark:border-zinc-700 p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-violet-600 flex items-center justify-center shadow-lg shadow-indigo-500/20">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                            </div>
                            <h2 class="text-lg font-bold text-slate-800 dark:text-white">Entretiens ({{ interviews|length }})</h2>
                        </div>
                        <a href="{{ path('app_rh_interviews', {application_id: application.id}) }}" class="text-sm font-medium text-violet-600 hover:text-violet-700 transition-colors">
                            Voir tous →
                        </a>
                    </div>

                    {% if interviews|length > 0 %}
                    <div class="space-y-3">
                        {% for interview in interviews %}
                        <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 dark:bg-zinc-700/50 border border-slate-100 dark:border-zinc-600 hover:bg-slate-100 dark:hover:bg-zinc-600 transition-colors">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-400 to-violet-500 flex items-center justify-center text-white">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15z"/></svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-slate-800 dark:text-white">{{ interview.type|title }} - {{ interview.interviewDate ? interview.interviewDate|date('d/m/Y H:i') : '—' }}</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    {% if interview.location %}
                                        {{ interview.location }}
                                    {% elseif interview.meetingLink %}
                                        En ligne
                                    {% else %}
                                        Non précisé
                                    {% endif %}
                                </p>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                {% if interview.result == 'PASSED' %}
                                    bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400
                                {% elseif interview.result == 'FAILED' %}
                                    bg-rose-100 text-rose-800 dark:bg-rose-900/30 dark:text-rose-400
                                {% else %}
                                    bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400
                                {% endif %}">
                                {{ interview.result|default('PENDING') }}
                            </span>
                            {% if interview.score > 0 %}
                            <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">{{ interview.score }}/100</span>
                            {% endif %}
                            <a href="{{ path('app_rh_interviews_show', {id: interview.id}) }}" class="p-2 rounded-lg text-slate-400 hover:text-violet-600 hover:bg-violet-50 transition-colors">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                            </a>
                        </div>
                        {% endfor %}
                    </div>
                    {% else %}
                    <div class="text-center py-12">
                        <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-zinc-700 flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15z"/></svg>
                        </div>
                        <p class="text-slate-500 dark:text-slate-400">Aucun entretien planifié</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
