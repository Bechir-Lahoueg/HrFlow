{% extends 'base.html.twig' %}

{% block title %}Détails de l'offre - {{ jobOffer.title }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6">
            {# ══════════ Header ══════════ #}
            <header class="mb-8">
                <div class="flex items-center gap-3 mb-2">
                    <a href="{{ path('app_rh_job_offers') }}" class="p-2 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    </a>
                    <h1 class="text-2xl font-bold text-slate-800 dark:text-white">Détails de l'offre</h1>
                </div>
                <p class="text-slate-500 dark:text-slate-400 ml-12">{{ jobOffer.title }}</p>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {# ══════════ Job Offer Info Card ══════════ #}
                <div class="lg:col-span-1">
                    <div class="bg-white dark:bg-zinc-800 rounded-2xl border border-slate-200/60 dark:border-zinc-700 p-6 shadow-sm">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-violet-500/20">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0v-2.25c0-1.094-.787-2.036-1.872-2.18-2.087-.277-4.216-.42-6.378-.42s-4.291.143-6.378.42c-1.085.144-1.872 1.086-1.872 2.18v2.25m16.5 0a2.25 2.25 0 012.25 2.25v4.5m-2.25-2.25h-15"/></svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-bold text-slate-800 dark:text-white">{{ jobOffer.title }}</h2>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                    {% if jobOffer.status == 'published' %}
                                        bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400
                                    {% elseif jobOffer.status == 'draft' %}
                                        bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400
                                    {% elseif jobOffer.status == 'closed' %}
                                        bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-400
                                    {% else %}
                                        bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-400
                                    {% endif %}">
                                    {{ jobOffer.status|title }}
                                </span>
                            </div>
                        </div>

                        <div class="space-y-4">
                            <div>
                                <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Description</label>
                                <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ jobOffer.description }}</p>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Département</label>
                                    <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ jobOffer.department|default('—') }}</p>
                                </div>
                                <div>
                                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Lieu</label>
                                    <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ jobOffer.location|default('—') }}</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Type</label>
                                    <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ jobOffer.employmentType|default('—') }}</p>
                                </div>
                                <div>
                                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Salaire</label>
                                    <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ jobOffer.salaryMin|default(0) }} - {{ jobOffer.salaryMax|default(0) }} TND</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-2 gap-4">
                                <div>
                                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Créé le</label>
                                    <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ jobOffer.createdAt ? jobOffer.createdAt|date('d/m/Y H:i') : '—' }}</p>
                                </div>
                                <div>
                                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Candidatures</label>
                                    <p class="mt-1 text-sm text-slate-700 dark:text-slate-300">{{ applications|length }}</p>
                                </div>
                            </div>
                        </div>

                        <div class="mt-6 pt-6 border-t border-slate-200 dark:border-zinc-700">
                            <a href="{{ path('app_rh_job_offers_edit', {id: jobOffer.id}) }}" class="inline-flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-lg text-sm font-semibold bg-violet-600 text-white hover:bg-violet-700 transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
                                Modifier l'offre
                            </a>
                        </div>
                    </div>
                </div>

                {# ══════════ Applications List ══════════ #}
                <div class="lg:col-span-2">
                    <div class="bg-white dark:bg-zinc-800 rounded-2xl border border-slate-200/60 dark:border-zinc-700 p-6 shadow-sm">
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-500 to-cyan-600 flex items-center justify-center shadow-lg shadow-teal-500/20">
                                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                                </div>
                                <h2 class="text-lg font-bold text-slate-800 dark:text-white">Candidatures ({{ applications|length }})</h2>
                            </div>
                            <a href="{{ path('app_rh_applications', {job_offer_id: jobOffer.id}) }}" class="text-sm font-medium text-violet-600 hover:text-violet-700 transition-colors">
                                Voir toutes →
                            </a>
                        </div>

                        {% if applications|length > 0 %}
                        <div class="space-y-3">
                            {% for application in applications %}
                            <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 dark:bg-zinc-700/50 border border-slate-100 dark:border-zinc-600 hover:bg-slate-100 dark:hover:bg-zinc-600 transition-colors">
                                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-teal-400 to-cyan-500 flex items-center justify-center text-white font-bold text-sm">
                                    {{ application.candidateName|first|upper }}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="text-sm font-semibold text-slate-800 dark:text-white truncate">{{ application.candidateName }}</p>
                                    <p class="text-xs text-slate-500 dark:text-slate-400">{{ application.emailAddress|default('—') }}</p>
                                </div>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium
                                    {% if application.status == 'HIRED' %}
                                        bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-400
                                    {% elseif application.status == 'REJECTED' %}
                                        bg-rose-100 text-rose-800 dark:bg-rose-900/30 dark:text-rose-400
                                    {% elseif application.status == 'INTERVIEW' %}
                                        bg-violet-100 text-violet-800 dark:bg-violet-900/30 dark:text-violet-400
                                    {% else %}
                                        bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400
                                    {% endif %}">
                                    {{ application.status }}
                                </span>
                                <a href="{{ path('app_rh_applications_show', {id: application.id}) }}" class="p-2 rounded-lg text-slate-400 hover:text-violet-600 hover:bg-violet-50 transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                                </a>
                            </div>
                            {% endfor %}
                        </div>
                        {% else %}
                        <div class="text-center py-12">
                            <div class="w-16 h-16 rounded-2xl bg-slate-100 dark:bg-zinc-700 flex items-center justify-center mx-auto mb-4">
                                <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                            </div>
                            <p class="text-slate-500 dark:text-slate-400">Aucune candidature pour cette offre</p>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
