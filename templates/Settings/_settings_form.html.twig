{# ── Flash messages ── #}
{% for message in app.flashes('success') %}
    <div class="flash-msg mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-sm font-semibold flex items-center gap-3 animate-slide-up">
        <div class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
        </div>
        {{ message }}
    </div>
{% endfor %}
{% for message in app.flashes('error') %}
    <div class="flash-msg mx-6 mt-4 px-4 py-3 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-700 dark:text-rose-400 text-sm font-semibold flex items-center gap-3 animate-slide-up">
        <div class="w-8 h-8 rounded-lg bg-rose-100 dark:bg-rose-500/20 flex items-center justify-center shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </div>
        {{ message }}
    </div>
{% endfor %}

<main id="main" class="p-6 max-w-2xl mx-auto space-y-6 animate-slide-up">

    {# ── Page header ── #}
    <div>
        <h1 class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-100 tracking-tight">Parametres du compte</h1>
        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">Espace {{ dashboardLabel }} — modifiez votre email ou mot de passe</p>
    </div>

    {# ── Account card ── #}
    <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/60 shadow-sm overflow-hidden">

        {# User banner #}
        <div class="px-6 py-5 bg-gradient-to-r from-{{ accentColor }}-50 to-{{ accentColor }}-100/50 dark:from-{{ accentColor }}-500/10 dark:to-{{ accentColor }}-500/5 border-b border-zinc-200/80 dark:border-zinc-800/60">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-{{ accentColor }}-500 flex items-center justify-center shadow-lg shadow-{{ accentColor }}-500/30">
                    <span class="text-lg font-bold text-white">{{ user.userIdentifier|first|upper }}</span>
                </div>
                <div>
                    <p class="text-sm font-bold text-zinc-800 dark:text-zinc-200">{{ user.fullName is defined and user.fullName ? user.fullName : user.userIdentifier }}</p>
                    <p class="text-xs text-{{ accentColor }}-600 dark:text-{{ accentColor }}-400 font-semibold mt-0.5">{{ user.email ?? '—' }}</p>
                </div>
            </div>
        </div>

        {# Form #}
        <div class="p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-5', 'novalidate': 'novalidate'}}) }}

                {# Form-level errors #}
                {% if form.vars.errors|length > 0 %}
                    {% for error in form.vars.errors %}
                        <p class="text-sm text-rose-600 dark:text-rose-400 font-medium">{{ error.message }}</p>
                    {% endfor %}
                {% endif %}

                {# Email #}
                <div>
                    <label class="block text-sm font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Adresse email</label>
                    {{ form_widget(form.email, {'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 outline-none transition-all focus:border-' ~ accentColor ~ '-500 focus:ring-2 focus:ring-' ~ accentColor ~ '-500/20',
                        'placeholder': 'vous@entreprise.com'
                    }}) }}
                    {% for error in form.email.vars.errors %}
                        <p class="mt-1.5 text-xs text-rose-600 dark:text-rose-400 font-semibold flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                            {{ error.message }}
                        </p>
                    {% endfor %}
                </div>

                <hr class="border-zinc-100 dark:border-zinc-800">

                {# Current password #}
                <div>
                    <label class="block text-sm font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Mot de passe actuel <span class="text-rose-500">*</span></label>
                    {{ form_widget(form.currentPassword, {'attr': {
                        'class': 'w-full px-4 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 outline-none transition-all focus:border-' ~ accentColor ~ '-500 focus:ring-2 focus:ring-' ~ accentColor ~ '-500/20',
                        'placeholder': 'Entrez votre mot de passe actuel',
                        'autocomplete': 'current-password'
                    }}) }}
                    {% for error in form.currentPassword.vars.errors %}
                        <p class="mt-1.5 text-xs text-rose-600 dark:text-rose-400 font-semibold flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                            {{ error.message }}
                        </p>
                    {% endfor %}
                </div>

                {# New password #}
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Nouveau mot de passe</label>
                        {{ form_widget(form.newPassword.first, {'attr': {
                            'class': 'w-full px-4 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 outline-none transition-all focus:border-' ~ accentColor ~ '-500 focus:ring-2 focus:ring-' ~ accentColor ~ '-500/20',
                            'placeholder': 'Min. 8 caracteres',
                            'autocomplete': 'new-password'
                        }}) }}
                        {% for error in form.newPassword.first.vars.errors %}
                            <p class="mt-1.5 text-xs text-rose-600 dark:text-rose-400 font-semibold flex items-center gap-1">
                                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                                {{ error.message }}
                            </p>
                        {% endfor %}
                    </div>
                    <div>
                        <label class="block text-sm font-bold text-zinc-700 dark:text-zinc-300 mb-1.5">Confirmer</label>
                        {{ form_widget(form.newPassword.second, {'attr': {
                            'class': 'w-full px-4 py-2.5 rounded-xl border border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 outline-none transition-all focus:border-' ~ accentColor ~ '-500 focus:ring-2 focus:ring-' ~ accentColor ~ '-500/20',
                            'placeholder': 'Confirmer le mot de passe',
                            'autocomplete': 'new-password'
                        }}) }}
                        {% for error in form.newPassword.second.vars.errors %}
                            <p class="mt-1.5 text-xs text-rose-600 dark:text-rose-400 font-semibold flex items-center gap-1">
                                <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                                {{ error.message }}
                            </p>
                        {% endfor %}
                    </div>
                </div>
                {% for error in form.newPassword.vars.errors %}
                    <p class="text-xs text-rose-600 dark:text-rose-400 font-semibold flex items-center gap-1">
                        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                        {{ error.message }}
                    </p>
                {% endfor %}

                {# Info box #}
                <div class="flex items-start gap-3 rounded-xl bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700/50 p-4">
                    <svg class="w-5 h-5 text-zinc-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z"/></svg>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                        Le mot de passe actuel est requis pour valider toute modification. Laissez les champs "nouveau mot de passe" vides si vous souhaitez uniquement changer l'email.
                    </p>
                </div>

                {# Submit #}
                <button type="submit" class="w-full sm:w-auto px-6 py-2.5 rounded-xl bg-{{ accentColor }}-600 hover:bg-{{ accentColor }}-700 text-white text-sm font-bold transition-colors focus:outline-none focus:ring-2 focus:ring-{{ accentColor }}-500/40 shadow-lg shadow-{{ accentColor }}-500/20">
                    Enregistrer les modifications
                </button>

            {{ form_end(form) }}
        </div>
    </div>

    {# ── Theme picker (admin seulement) ── #}
    {% if showThemePicker|default(false) %}
    <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200/80 dark:border-zinc-800/60 shadow-sm overflow-hidden">
        <div class="px-6 py-5 border-b border-zinc-200/80 dark:border-zinc-800/60 flex items-center justify-between gap-4">
            <div>
                <h2 class="text-base font-extrabold text-zinc-900 dark:text-zinc-100 tracking-tight flex items-center gap-2">
                    <svg class="w-4 h-4 text-{{ accentColor }}-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 005.304 0l6.401-6.402M6.75 21A3.75 3.75 0 013 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 003.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.879 2.88M6.75 17.25h.008v.008H6.75v-.008z"/></svg>
                    Theme du tableau de bord
                </h2>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Choisissez parmi 4 ambiances — s'applique immediatement apres enregistrement.</p>
            </div>
            <span class="hidden sm:inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider {{ admin_theme.badge_class|default('bg-violet-100 text-violet-700') }} px-2 py-1 rounded-full">
                Actuel : {{ admin_theme.label }}
            </span>
        </div>

        <form method="post" action="{{ path('app_admin_settings_theme') }}" class="p-6 space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_theme') }}">

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                {% for theme in admin_themes %}
                    {% set isSelected = theme.key == admin_theme_key %}
                    <label class="theme-card group relative rounded-xl border {{ isSelected ? 'border-' ~ accentColor ~ '-500 ring-2 ring-' ~ accentColor ~ '-500/30' : 'border-zinc-200 dark:border-zinc-700 hover:border-' ~ accentColor ~ '-300' }} bg-white dark:bg-zinc-800/40 overflow-hidden cursor-pointer transition-all">
                        <input type="radio" name="theme" value="{{ theme.key }}" class="sr-only peer" {% if isSelected %}checked{% endif %}>
                        <div class="h-20 relative" style="background: {{ theme.banner_gradient }};">
                            <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.25),transparent_60%)]"></div>
                            <span class="absolute top-2 right-2 w-4 h-4 rounded-full border-2 border-white {{ isSelected ? '' : 'opacity-0 group-hover:opacity-100' }} transition-opacity" style="background-color: {{ theme.accent_300 }};"></span>
                            {% if isSelected %}
                                <span class="absolute bottom-2 left-2 inline-flex items-center gap-1 text-[9px] font-bold uppercase tracking-wider bg-white/95 text-zinc-900 px-1.5 py-0.5 rounded">
                                    <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                                    Actif
                                </span>
                            {% endif %}
                        </div>
                        <div class="p-3">
                            <p class="text-[13px] font-bold text-zinc-800 dark:text-zinc-200">{{ theme.label }}</p>
                            <p class="text-[10px] text-zinc-500 dark:text-zinc-400 mt-0.5">{{ theme.tagline }}</p>
                            <div class="mt-2 flex items-center gap-1">
                                <span class="w-4 h-4 rounded-full border border-zinc-200 dark:border-zinc-700" style="background-color: {{ theme.accent_600 }};"></span>
                                <span class="w-4 h-4 rounded-full border border-zinc-200 dark:border-zinc-700" style="background-color: {{ theme.accent_500 }};"></span>
                                <span class="w-4 h-4 rounded-full border border-zinc-200 dark:border-zinc-700" style="background-color: {{ theme.accent_300 }};"></span>
                            </div>
                        </div>
                    </label>
                {% endfor %}
            </div>

            <div class="flex items-center justify-between gap-4 pt-2">
                <p class="text-[11px] text-zinc-400">La barre laterale, l'en-tete et la banniere d'accueil utiliseront l'ambiance choisie.</p>
                <button type="submit" class="px-5 py-2 rounded-xl bg-{{ accentColor }}-600 hover:bg-{{ accentColor }}-700 text-white text-[13px] font-bold transition-colors focus:outline-none focus:ring-2 focus:ring-{{ accentColor }}-500/40 shadow-md shadow-{{ accentColor }}-500/20">
                    Enregistrer le theme
                </button>
            </div>
        </form>
    </div>
    {% endif %}

    {# ── Panneau d'accessibilité (commun aux 3 dashboards) ── #}
    {% include 'Settings/_accessibility_panel.html.twig' %}
</main>

<script>
document.querySelectorAll('.flash-msg').forEach(function(el) {
    setTimeout(function() {
        el.style.transition = 'opacity .4s ease, transform .4s ease';
        el.style.opacity = '0';
        el.style.transform = 'translateY(-8px)';
        setTimeout(function() { el.remove(); }, 400);
    }, 5000);
});
</script>
