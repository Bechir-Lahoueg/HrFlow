{% set current_section = current_section|default('') %}

{% extends 'base.html.twig' %}

{% block title %}Documentation | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        .docs-sidebar a.active {
            background: #EEF2FF;
            color: #4338CA;
            font-weight: 600;
        }
        .docs-sidebar a:hover {
            background: #F8FAFC;
        }
        .docs-sidebar.open {
            display: block;
        }
        .docs-content h2 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-top: 2rem;
            margin-bottom: 0.75rem;
            color: #0F172A;
        }
        .docs-content h3 {
            font-size: 1.125rem;
            font-weight: 600;
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            color: #1E293B;
        }
        .docs-content p {
            margin-bottom: 1rem;
            line-height: 1.75;
            color: #475569;
        }
        .docs-content ul, .docs-content ol {
            margin-bottom: 1rem;
            padding-left: 1.5rem;
            color: #475569;
            line-height: 1.75;
        }
        .docs-content li {
            margin-bottom: 0.375rem;
        }
        .docs-content table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 1.5rem;
            font-size: 0.875rem;
        }
        .docs-content table th {
            background: #F1F5F9;
            text-align: left;
            padding: 0.625rem 0.75rem;
            font-weight: 600;
            color: #0F172A;
            border: 1px solid #E2E8F0;
        }
        .docs-content table td {
            padding: 0.625rem 0.75rem;
            border: 1px solid #E2E8F0;
            color: #475569;
        }
        .docs-content table tr:nth-child(even) td {
            background: #FAFAFA;
        }
        .docs-content code {
            background: #F1F5F9;
            padding: 0.125rem 0.375rem;
            border-radius: 0.25rem;
            font-size: 0.8125rem;
            color: #0F172A;
        }
        .docs-content pre {
            background: #0F172A;
            color: #E2E8F0;
            padding: 1rem;
            border-radius: 0.5rem;
            overflow-x: auto;
            margin-bottom: 1.25rem;
            font-size: 0.8125rem;
            line-height: 1.5;
        }
        .docs-content pre code {
            background: none;
            padding: 0;
            color: inherit;
        }
        .docs-content blockquote {
            border-left: 3px solid #818CF8;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            background: #F8FAFC;
            border-radius: 0 0.375rem 0.375rem 0;
            color: #475569;
        }
        .docs-content hr {
            border: none;
            border-top: 1px solid #E2E8F0;
            margin: 2rem 0;
        }
        .docs-nav-group {
            margin-bottom: 0.25rem;
        }
        .docs-nav-group-title {
            font-size: 0.6875rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #94A3B8;
            padding: 0.75rem 0.75rem 0.375rem;
        }
        .docs-sidebar a {
            display: block;
            padding: 0.375rem 0.75rem;
            font-size: 0.8125rem;
            color: #64748B;
            border-radius: 0.375rem;
            transition: all 0.15s ease;
            text-decoration: none;
        }
        .docs-sidebar {
            display: block;
        }
        @media (max-width: 1023px) {
            .docs-sidebar {
                display: none;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased">
    {% include 'Components/navbar.html.twig' %}

    <div class="pt-20 lg:pt-24">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex gap-8">
                <button id="docsSidebarToggle" class="lg:hidden fixed bottom-6 right-6 z-50 w-14 h-14 rounded-full bg-[#022E69] text-white shadow-lg flex items-center justify-center hover:bg-[#011d47] transition-colors" aria-label="Ouvrir le menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
                </button>

                <aside id="docsSidebar" class="docs-sidebar w-64 shrink-0 py-8">
                    <div class="sticky top-24">
                        <div class="docs-nav-group">
                            <div class="docs-nav-group-title">Accueil</div>
                            <a href="{{ path('app_docs', {path: ''}) }}" class="{{ current_section == 'index' ? 'active' : '' }}">Presentation</a>
                        </div>
                        <div class="docs-nav-group">
                            <div class="docs-nav-group-title">Installation</div>
                            <a href="{{ path('app_docs', {path: 'installation/linux'}) }}" class="{{ current_section == 'installation-linux' ? 'active' : '' }}">Linux</a>
                            <a href="{{ path('app_docs', {path: 'installation/windows'}) }}" class="{{ current_section == 'installation-windows' ? 'active' : '' }}">Windows</a>
                            <a href="{{ path('app_docs', {path: 'installation/macos'}) }}" class="{{ current_section == 'installation-macos' ? 'active' : '' }}">macOS</a>
                            <a href="{{ path('app_docs', {path: 'installation/database'}) }}" class="{{ current_section == 'installation-database' ? 'active' : '' }}">Base de donnees</a>
                        </div>
                        <div class="docs-nav-group">
                            <div class="docs-nav-group-title">Premiers pas</div>
                            <a href="{{ path('app_docs', {path: 'getting-started/login'}) }}" class="{{ current_section == 'getting-started-login' ? 'active' : '' }}">Connexion</a>
                            <a href="{{ path('app_docs', {path: 'getting-started/first-steps'}) }}" class="{{ current_section == 'getting-started-first-steps' ? 'active' : '' }}">Premieres etapes</a>
                        </div>
                        <div class="docs-nav-group">
                            <div class="docs-nav-group-title">Guides par role</div>
                            <a href="{{ path('app_docs', {path: 'user-guides/admin'}) }}" class="{{ current_section == 'user-guides-admin' ? 'active' : '' }}">Administrateur</a>
                            <a href="{{ path('app_docs', {path: 'user-guides/hr-manager'}) }}" class="{{ current_section == 'user-guides-hr-manager' ? 'active' : '' }}">RH / Manager</a>
                            <a href="{{ path('app_docs', {path: 'user-guides/employee'}) }}" class="{{ current_section == 'user-guides-employee' ? 'active' : '' }}">Employe</a>
                        </div>
                        <div class="docs-nav-group">
                            <div class="docs-nav-group-title">Modules</div>
                            <a href="{{ path('app_docs', {path: 'modules/recruitment'}) }}" class="{{ current_section == 'modules-recruitment' ? 'active' : '' }}">Recrutement</a>
                            <a href="{{ path('app_docs', {path: 'modules/training'}) }}" class="{{ current_section == 'modules-training' ? 'active' : '' }}">Formations</a>
                            <a href="{{ path('app_docs', {path: 'modules/leave'}) }}" class="{{ current_section == 'modules-leave' ? 'active' : '' }}">Conges</a>
                            <a href="{{ path('app_docs', {path: 'modules/payroll'}) }}" class="{{ current_section == 'modules-payroll' ? 'active' : '' }}">Paie</a>
                            <a href="{{ path('app_docs', {path: 'modules/employee-relations'}) }}" class="{{ current_section == 'modules-employee-relations' ? 'active' : '' }}">Relations employes</a>
                            <a href="{{ path('app_docs', {path: 'modules/ai-reporting'}) }}" class="{{ current_section == 'modules-ai-reporting' ? 'active' : '' }}">Rapports IA</a>
                        </div>
                        <div class="docs-nav-group">
                            <div class="docs-nav-group-title">Support</div>
                            <a href="{{ path('app_docs', {path: 'faq'}) }}" class="{{ current_section == 'faq' ? 'active' : '' }}">FAQ</a>
                            <a href="{{ path('app_docs', {path: 'troubleshooting'}) }}" class="{{ current_section == 'troubleshooting' ? 'active' : '' }}">Depannage</a>
                        </div>
                    </div>
                </aside>

                <main class="flex-1 min-w-0 py-8">
                    <div class="docs-content max-w-3xl mx-auto bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm text-center">
                        {% block docs_content %}{% endblock %}
                    </div>
                </main>
            </div>
        </div>
    </div>

    {% include 'Components/footer.html.twig' %}
</div>

<script>
(function() {
    var toggle = document.getElementById('docsSidebarToggle');
    var sidebar = document.getElementById('docsSidebar');
    if (!toggle || !sidebar) return;
    var backdrop = document.createElement('div');
    backdrop.id = 'docsSidebarBackdrop';
    backdrop.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.3);z-index:30;display:none;';
    document.body.appendChild(backdrop);

    function openSidebar() {
        sidebar.style.display = 'block';
        sidebar.classList.add('fixed', 'inset-y-0', 'left-0', 'z-40', 'bg-[#fafafa]', 'shadow-xl', 'px-4', 'overflow-y-auto');
        backdrop.style.display = 'block';
        document.body.style.overflow = 'hidden';
    }

    function closeSidebar() {
        sidebar.style.display = '';
        sidebar.classList.remove('fixed', 'inset-y-0', 'left-0', 'z-40', 'bg-[#fafafa]', 'shadow-xl', 'px-4', 'overflow-y-auto');
        backdrop.style.display = 'none';
        document.body.style.overflow = '';
    }

    toggle.addEventListener('click', openSidebar);
    backdrop.addEventListener('click', closeSidebar);

    window.addEventListener('resize', function() {
        if (window.innerWidth >= 1024) closeSidebar();
    });
})();
</script>
{% endblock %}
