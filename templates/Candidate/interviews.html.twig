{% extends 'base.html.twig' %}

{% block title %}Mes Entretiens | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .card-anim { animation: fadeUp 0.35s ease-out both; }
        @keyframes pulse-ring { 0% { transform:scale(1); opacity:1; } 100% { transform:scale(1.5); opacity:0; } }
        .pulse-ring::before { content:''; position:absolute; inset:-4px; border-radius:50%; border:2px solid currentColor; animation:pulse-ring 1.5s ease-out infinite; }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8fafc] antialiased overflow-x-hidden">
    {% include 'Candidate/components/_header.html.twig' %}

    <main class="w-full p-6 lg:p-8 max-w-[1400px] mx-auto">

                {# Page Header #}
                <div class="mb-8">
                    <h1 class="text-2xl font-bold text-slate-900">Mes entretiens</h1>
                    <p class="text-slate-500 text-sm mt-1">Préparez-vous et suivez l'avancement de votre processus de recrutement.</p>
                </div>

                {% if interviews|length > 0 %}
                    <div class="space-y-5">
                        {% for i, interview in interviews %}
                            {% set isPast = interview.interviewDate < date() %}
                            {% set isToday = interview.interviewDate|date('Y-m-d') == 'now'|date('Y-m-d') %}

                            <article class="bg-white rounded-2xl border shadow-sm overflow-hidden transition-all duration-200 card-anim
                                {{ isToday ? 'border-violet-200 ring-2 ring-violet-500/20 shadow-violet-100' : (isPast ? 'border-slate-100' : 'border-emerald-100 hover:border-emerald-200') }}"
                                     style="animation-delay: {{ (i * 0.07) }}s">

                                {# Header Strip #}
                                <div class="px-6 py-5 border-b {{ isToday ? 'border-violet-100 bg-gradient-to-r from-violet-50 to-purple-50' : (isPast ? 'border-slate-100 bg-slate-50' : 'border-emerald-50 bg-gradient-to-r from-emerald-50/50 to-teal-50/30') }}">
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                                        <div class="flex items-center gap-4">
                                            {# Date Badge #}
                                            <div class="relative w-14 h-14 rounded-2xl flex flex-col items-center justify-center text-white shrink-0 shadow-lg
                                                {{ isToday ? 'bg-gradient-to-br from-violet-500 to-purple-600 shadow-violet-500/25' : (isPast ? 'bg-slate-500 shadow-slate-400/20' : 'bg-gradient-to-br from-emerald-500 to-teal-600 shadow-emerald-500/20') }}">
                                                <span class="text-[9px] font-black uppercase tracking-widest leading-none">{{ interview.interviewDate|date('M') }}</span>
                                                <span class="text-2xl font-black leading-none mt-0.5">{{ interview.interviewDate|date('d') }}</span>
                                            </div>

                                            <div>
                                                <div class="flex flex-wrap items-center gap-2 mb-1">
                                                    <h2 class="text-lg font-bold text-slate-900">{{ interview.application.jobOffer.title }}</h2>
                                                    {# Status Pill #}
                                                    {% if isToday %}
                                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-black bg-violet-500 text-white shadow-md shadow-violet-500/25">
                                                            <span class="relative flex w-2 h-2">
                                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-60"></span>
                                                                <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
                                                            </span>
                                                            AUJOURD'HUI
                                                        </span>
                                                    {% elseif isPast %}
                                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-slate-200 text-slate-600">Passé</span>
                                                    {% else %}
                                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">
                                                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                            À venir
                                                        </span>
                                                    {% endif %}
                                                </div>
                                                <div class="flex items-center gap-2 text-sm text-slate-500">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                    <span class="font-semibold">{{ interview.interviewDate|date('H:i') }}</span>
                                                    <span class="text-slate-300">•</span>
                                                    <span>{{ interview.interviewDate|date('l d MMMM Y') }}</span>
                                                </div>
                                            </div>
                                        </div>

                                        {# Result badge for past interviews #}
                                        {% if isPast and interview.result is defined %}
                                            <div class="shrink-0">
                                                {% if interview.result == 'PASSED' %}
                                                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                        Retenu
                                                    </span>
                                                {% elseif interview.result == 'FAILED' %}
                                                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold bg-red-100 text-red-700 border border-red-200">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                                                        Non retenu
                                                    </span>
                                                {% else %}
                                                    <span class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold bg-amber-100 text-amber-700 border border-amber-200">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                        En attente
                                                    </span>
                                                {% endif %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>

                                {# Body #}
                                <div class="p-6">
                                    <div class="grid md:grid-cols-2 gap-6">

                                        {# Details #}
                                        <div class="space-y-4">
                                            <div class="flex items-start gap-3">
                                                <div class="w-9 h-9 rounded-xl {{ isToday ? 'bg-violet-100' : 'bg-slate-100' }} flex items-center justify-center shrink-0">
                                                    <svg class="w-4 h-4 {{ isToday ? 'text-violet-600' : 'text-slate-500' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                                                    </svg>
                                                </div>
                                                <div>
                                                    <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Type d'entretien</p>
                                                    <p class="text-sm font-semibold text-slate-800 mt-0.5">{{ interview.type }}</p>
                                                </div>
                                            </div>

                                            {% if interview.location %}
                                                <div class="flex items-start gap-3">
                                                    <div class="w-9 h-9 rounded-xl bg-blue-50 flex items-center justify-center shrink-0">
                                                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Lieu</p>
                                                        <p class="text-sm font-semibold text-slate-800 mt-0.5">{{ interview.location }}</p>
                                                    </div>
                                                </div>
                                            {% endif %}

                                            {% if interview.meetingLink %}
                                                <div class="flex items-start gap-3">
                                                    <div class="w-9 h-9 rounded-xl bg-emerald-50 flex items-center justify-center shrink-0">
                                                        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                                        </svg>
                                                    </div>
                                                    <div>
                                                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Lien de réunion</p>
                                                        <a href="{{ interview.meetingLink }}" target="_blank"
                                                           class="inline-flex items-center gap-1 text-sm font-bold text-emerald-600 hover:text-emerald-700 hover:underline mt-0.5 transition-colors">
                                                            Rejoindre l'appel
                                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                                        </a>
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>

                                        {# Feedback or Prep Tips #}
                                        {% if isPast and interview.feedback is defined and interview.feedback %}
                                            <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                                                <div class="flex items-center gap-2 mb-3">
                                                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                                                    <p class="text-xs font-bold text-slate-500 uppercase tracking-wider">Retour du recruteur</p>
                                                </div>
                                                <p class="text-sm text-slate-700 leading-relaxed">{{ interview.feedback }}</p>
                                            </div>
                                        {% elseif not isPast %}
                                            <div class="bg-gradient-to-br from-emerald-50 to-teal-50 rounded-xl p-4 border border-emerald-100">
                                                <div class="flex items-center gap-2 mb-3">
                                                    <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                                                    <p class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Conseils de préparation</p>
                                                </div>
                                                <ul class="space-y-1.5">
                                                    {% for tip in [
                                                        'Recherchez l\'entreprise et le poste en détail',
                                                        'Préparez des questions pertinentes à poser',
                                                        'Connectez-vous 5 min avant (entretien en ligne)',
                                                        'Ayez votre CV et portfolio à portée de main'
                                                    ] %}
                                                        <li class="flex items-start gap-2 text-xs text-emerald-800">
                                                            <svg class="w-3.5 h-3.5 text-emerald-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                            {{ tip }}
                                                        </li>
                                                    {% endfor %}
                                                </ul>
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>

                {% else %}
                    {# Empty State #}
                    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-16 text-center">
                        <div class="w-20 h-20 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-5">
                            <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">Aucun entretien programmé</h3>
                        <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">Postulez aux offres qui vous intéressent pour être invité à des entretiens par nos recruteurs.</p>
                        <a href="{{ path('app_candidate_job_offers') }}"
                           class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm transition-colors shadow-md shadow-emerald-500/20">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            Parcourir les offres
                        </a>
                    </div>
                {% endif %}
    </main>
</div>
{% endblock %}
