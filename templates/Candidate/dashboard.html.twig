{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:translateY(0); } }
        @keyframes slideIn { from { opacity:0; transform:translateX(-20px); } to { opacity:1; transform:translateX(0); } }
        @keyframes scaleIn { from { opacity:0; transform:scale(0.95); } to { opacity:1; transform:scale(1); } }
        @keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-10px); } }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
        @keyframes shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }
        
        .fade-up { animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }
        .fade-up-1 { animation-delay: 0.08s; }
        .fade-up-2 { animation-delay: 0.16s; }
        .fade-up-3 { animation-delay: 0.24s; }
        .fade-up-4 { animation-delay: 0.32s; }
        .fade-up-5 { animation-delay: 0.40s; }
        .fade-up-6 { animation-delay: 0.48s; }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        
        .stat-card {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .stat-card:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.1);
        }
        .stat-card:hover .stat-icon {
            transform: scale(1.15) rotate(5deg);
        }
        .stat-icon {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .hover-lift {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .hover-lift:hover {
            transform: translateY(-2px);
        }
        
        .gradient-border {
            position: relative;
        }
        .gradient-border::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1px;
            background: linear-gradient(135deg, rgba(16, 185, 129, 0.3), rgba(99, 102, 241, 0.3));
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
        }
        
        .animate-float { animation: float 6s ease-in-out infinite; }
        .animate-pulse-slow { animation: pulse 3s ease-in-out infinite; }
        
        .progress-ring {
            transform: rotate(-90deg);
        }
        .progress-ring-circle {
            transition: stroke-dashoffset 0.5s ease-in-out;
        }
        
        .shine {
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            background-size: 200% 100%;
            animation: shimmer 3s infinite;
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f0f4f8] antialiased overflow-x-hidden">
    {% include 'Candidate/components/_header.html.twig' %}

    <main class="w-full p-6 lg:p-8 max-w-[1440px] mx-auto">

        {# Welcome Banner - Modern Glassmorphism #}
        <div class="relative overflow-hidden rounded-3xl p-8 lg:p-10 mb-8 fade-up" style="background: linear-gradient(135deg, #059669 0%, #047857 50%, #10b981 100%);">
            {# Animated Background Elements #}
            <div class="absolute -right-20 -top-20 w-96 h-96 rounded-full bg-white/5 animate-pulse-slow"></div>
            <div class="absolute right-20 -bottom-32 w-80 h-80 rounded-full bg-white/5"></div>
            <div class="absolute left-1/2 top-1/2 w-64 h-64 rounded-full bg-emerald-400/10 blur-3xl animate-float"></div>
            
            {# Decorative Pattern #}
            <div class="absolute inset-0 opacity-5" style="background-image: url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"1\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

            <div class="relative flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div class="flex items-center gap-5">
                    {# User Avatar with Ring #}
                    <div class="relative">
                        <div class="w-20 h-20 rounded-2xl flex items-center justify-center text-white text-2xl font-bold shadow-2xl shadow-emerald-900/30 border-4 border-white/20"
                             style="background: linear-gradient(135deg, #34d399 0%, #059669 100%);">
                            {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                        </div>
                        <div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-emerald-400 border-2 border-white flex items-center justify-center">
                            <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                    </div>
                    <div>
                        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/20 text-white text-xs font-semibold mb-3 backdrop-blur-sm border border-white/10">
                            <span class="w-2 h-2 rounded-full bg-emerald-300 animate-pulse"></span>
                            Espace Candidat Actif
                        </div>
                        <h1 class="text-3xl lg:text-4xl font-bold text-white mb-2 tracking-tight">
                            Bonjour, {{ app.user.firstName|default(app.user.userIdentifier) }} 👋
                        </h1>
                        <p class="text-emerald-100/90 text-sm lg:text-base font-medium">
                            Suivez vos candidatures et découvrez de nouvelles opportunités professionnelles.
                        </p>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-3">
                    <a href="{{ path('app_candidate_job_offers') }}"
                       class="shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-white text-emerald-700 font-bold text-sm hover:bg-emerald-50 transition-all shadow-xl shadow-emerald-900/20 hover:shadow-2xl hover:scale-[1.02] hover:-translate-y-0.5">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        Découvrir les offres
                    </a>
                    <a href="{{ path('app_candidate_applications') }}"
                       class="shrink-0 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-emerald-800/50 text-white font-bold text-sm hover:bg-emerald-800/70 transition-all border border-emerald-400/30 backdrop-blur-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                        Mes candidatures
                    </a>
                </div>
            </div>
        </div>

        {# Enhanced Stats Grid with Progress Indicators #}
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5 mb-8">
            {% set total = stats.total > 0 ? stats.total : 1 %}
            {% set statsData = [
                { label: 'Total candidatures', value: stats.total, color: 'blue', path: 'app_candidate_applications',
                  icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>',
                  desc: 'postes visés', percent: 100, ring: 'stroke-blue-500' },
                { label: 'En attente', value: stats.pending + stats.reviewing, color: 'amber', path: 'app_candidate_applications',
                  icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>',
                  desc: 'en cours', percent: ((stats.pending + stats.reviewing) / total * 100)|round, ring: 'stroke-amber-500' },
                { label: 'Entretiens', value: stats.interview, color: 'violet', path: 'app_candidate_interviews',
                  icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
                  desc: 'programmés', percent: (stats.interview / total * 100)|round, ring: 'stroke-violet-500' },
                { label: 'Offres', value: stats.offer + stats.hired, color: 'emerald', path: 'app_candidate_applications',
                  icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>',
                  desc: 'acceptées', percent: ((stats.offer + stats.hired) / total * 100)|round, ring: 'stroke-emerald-500' }
            ] %}

            {% for i, stat in statsData %}
                <a href="{{ path(stat.path) }}"
                   class="stat-card group bg-white rounded-2xl border border-slate-200/60 shadow-sm hover:shadow-xl p-5 fade-up fade-up-{{ i + 1 }}">
                    <div class="flex items-start justify-between mb-4">
                        <div class="stat-icon w-12 h-12 rounded-xl bg-gradient-to-br from-{{ stat.color }}-500/10 to-{{ stat.color }}-600/20 flex items-center justify-center ring-1 ring-{{ stat.color }}-500/20">
                            <svg class="w-6 h-6 text-{{ stat.color }}-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                {{ stat.icon|raw }}
                            </svg>
                        </div>
                        {# Progress Ring #}
                        <div class="relative w-12 h-12">
                            <svg class="progress-ring w-12 h-12" viewBox="0 0 44 44">
                                <circle cx="22" cy="22" r="18" fill="none" stroke="#e2e8f0" stroke-width="3"/>
                                <circle cx="22" cy="22" r="18" fill="none" class="{{ stat.ring }} progress-ring-circle" stroke-width="3" stroke-linecap="round"
                                        stroke-dasharray="113" stroke-dashoffset="{{ 113 - (113 * stat.percent / 100) }}"/>
                            </svg>
                            <span class="absolute inset-0 flex items-center justify-center text-[10px] font-bold text-slate-400">{{ stat.percent }}%</span>
                        </div>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-bold text-slate-900">{{ stat.value }}</span>
                        <span class="text-xs text-slate-400 font-medium">{{ stat.desc }}</span>
                    </div>
                    <p class="text-sm font-semibold text-slate-600 mt-1">{{ stat.label }}</p>
                    
                    {# Mini Progress Bar #}
                    <div class="mt-3 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-{{ stat.color }}-500 rounded-full transition-all duration-500" style="width: {{ stat.percent }}%"></div>
                    </div>
                </a>
            {% endfor %}
        </div>

        <div class="grid lg:grid-cols-3 gap-6 lg:gap-8">

            {# Left Column (2/3) #}
            <div class="lg:col-span-2 space-y-6">

                {# Quick Actions - Modern Cards #}
                <div class="grid sm:grid-cols-2 gap-4 fade-up fade-up-3">
                    <a href="{{ path('app_candidate_job_offers') }}"
                       class="group relative overflow-hidden flex items-center gap-4 p-5 rounded-2xl bg-white border border-slate-200/60 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                        <div class="absolute inset-0 bg-gradient-to-br from-emerald-500/5 to-teal-500/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/30 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div class="relative">
                            <p class="text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors">Parcourir les offres</p>
                            <p class="text-sm text-slate-500 mt-0.5">{{ stats.availableJobs|default(12) }} opportunités disponibles</p>
                        </div>
                        <svg class="w-5 h-5 text-slate-300 group-hover:text-emerald-500 group-hover:translate-x-1 transition-all ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                    
                    <a href="{{ path('app_candidate_profile') }}"
                       class="group relative overflow-hidden flex items-center gap-4 p-5 rounded-2xl bg-white border border-slate-200/60 shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
                        <div class="absolute inset-0 bg-gradient-to-br from-slate-500/5 to-slate-700/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        <div class="relative w-14 h-14 rounded-2xl bg-gradient-to-br from-slate-600 to-slate-800 flex items-center justify-center shadow-lg shadow-slate-700/30 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </div>
                        <div class="relative">
                            <p class="text-base font-bold text-slate-900 group-hover:text-slate-700 transition-colors">Compléter mon profil</p>
                            <p class="text-sm text-slate-500 mt-0.5">{{ app.user.profileCompletion|default(75) }}% complété</p>
                        </div>
                        <svg class="w-5 h-5 text-slate-300 group-hover:text-slate-500 group-hover:translate-x-1 transition-all ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>

                {# Upcoming Interviews - Rich Timeline Style #}
                <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm p-6 fade-up fade-up-4">
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 flex items-center justify-center shadow-lg shadow-violet-500/25">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-bold text-slate-900">Prochains entretiens</h2>
                                <p class="text-xs text-slate-400">{{ upcomingInterviews|length }} événements prévus</p>
                            </div>
                        </div>
                        <a href="{{ path('app_candidate_interviews') }}" class="inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors group">
                            Voir tout
                            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>

                    {% if upcomingInterviews|length > 0 %}
                        <div class="space-y-3">
                            {% for interview in upcomingInterviews %}
                                <div class="group flex items-center gap-4 p-4 rounded-xl bg-gradient-to-r from-slate-50 to-white border border-slate-100 hover:border-violet-200 hover:shadow-md transition-all duration-200 cursor-pointer">
                                    {# Date Badge #}
                                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-violet-500 to-purple-600 flex flex-col items-center justify-center text-white shrink-0 shadow-lg shadow-violet-500/25 group-hover:scale-105 transition-transform">
                                        <span class="text-[10px] font-bold uppercase leading-none opacity-90">{{ interview.interviewDate|date('M') }}</span>
                                        <span class="text-xl font-bold leading-none mt-0.5">{{ interview.interviewDate|date('d') }}</span>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-base font-semibold text-slate-900 truncate group-hover:text-violet-700 transition-colors">{{ interview.application.jobOffer.title }}</p>
                                        <div class="flex flex-wrap items-center gap-3 mt-1.5">
                                            <span class="inline-flex items-center gap-1.5 text-xs text-slate-500">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                </svg>
                                                {{ interview.interviewDate|date('H:i') }}
                                            </span>
                                            <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                                            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-violet-100 text-violet-700 text-xs font-semibold">
                                                <span class="w-1.5 h-1.5 rounded-full bg-violet-500"></span>
                                                {{ interview.type }}
                                            </span>
                                            {% if interview.location %}
                                                <span class="inline-flex items-center gap-1.5 text-xs text-slate-500">
                                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                                    </svg>
                                                    {{ interview.location }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="shrink-0 flex items-center gap-2">
                                        <button class="w-9 h-9 rounded-lg bg-violet-50 text-violet-600 hover:bg-violet-100 flex items-center justify-center transition-colors" title="Ajouter au calendrier">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                        </button>
                                        <svg class="w-5 h-5 text-slate-300 group-hover:text-violet-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                        </svg>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="flex flex-col items-center justify-center py-12 text-center bg-gradient-to-b from-slate-50 to-white rounded-xl border border-slate-100 border-dashed">
                            <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mb-4">
                                <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <p class="text-base font-semibold text-slate-600">Aucun entretien prévu</p>
                            <p class="text-sm text-slate-400 mt-1 mb-4">Postulez à des offres pour être contacté</p>
                            <a href="{{ path('app_candidate_job_offers') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                Parcourir les offres
                            </a>
                        </div>
                    {% endif %}
                </div>

                {# Recent Applications - Rich List with Progress #}
                <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm p-6 fade-up fade-up-5">
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-blue-500/25">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                            </div>
                            <div>
                                <h2 class="text-lg font-bold text-slate-900">Candidatures récentes</h2>
                                <p class="text-xs text-slate-400">{{ recentApplications|length }} candidatures au total</p>
                            </div>
                        </div>
                        <a href="{{ path('app_candidate_applications') }}" class="inline-flex items-center gap-1 text-sm font-semibold text-emerald-600 hover:text-emerald-700 transition-colors group">
                            Voir tout
                            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </a>
                    </div>

                    {% if recentApplications|length > 0 %}
                        <div class="space-y-3">
                            {% for application in recentApplications|slice(0, 5) %}
                                <div class="group flex items-center gap-4 p-4 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all duration-200 cursor-pointer">
                                    <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shrink-0 shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
                                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-base font-semibold text-slate-900 truncate group-hover:text-blue-700 transition-colors">{{ application.jobOffer.title }}</p>
                                        <div class="flex items-center gap-3 mt-1">
                                            <span class="text-xs text-slate-400 flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                                </svg>
                                                {{ application.appliedAt|date('d M Y') }}
                                            </span>
                                            <span class="w-1 h-1 rounded-full bg-slate-300"></span>
                                            <span class="text-xs text-slate-500">{{ application.jobOffer.department|default('Département non spécifié') }}</span>
                                        </div>
                                        {# Progress Bar for Application Status #}
                                        <div class="mt-2 flex items-center gap-2">
                                            <div class="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                                {% set progressMap = {'PENDING': 20, 'REVIEWING': 40, 'REVIEWED': 40, 'INTERVIEW': 60, 'OFFER': 80, 'HIRED': 100, 'REJECTED': 0} %}
                                                {% set progress = progressMap[application.status] ?? 0 %}
                                                <div class="h-full bg-{{ application.statusColor|default('slate') }}-500 rounded-full transition-all duration-500" style="width: {{ progress }}%"></div>
                                            </div>
                                            <span class="text-[10px] font-semibold text-slate-400">{{ progress }}%</span>
                                        </div>
                                    </div>
                                    <span class="shrink-0 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold
                                        bg-{{ application.statusColor }}-50 text-{{ application.statusColor }}-700 border border-{{ application.statusColor }}-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-{{ application.statusColor }}-500"></span>
                                        {{ application.statusLabel }}
                                    </span>
                                    <svg class="w-5 h-5 text-slate-300 group-hover:text-slate-400 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                    </svg>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="flex flex-col items-center justify-center py-12 text-center bg-gradient-to-b from-slate-50 to-white rounded-xl border border-slate-100 border-dashed">
                            <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center mb-4">
                                <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                            </div>
                            <p class="text-base font-semibold text-slate-600">Aucune candidature pour le moment</p>
                            <p class="text-sm text-slate-400 mt-1 mb-4">Commencez votre recherche dès maintenant</p>
                            <a href="{{ path('app_candidate_job_offers') }}" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition-colors shadow-lg shadow-emerald-500/25">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                Découvrir les offres
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Right Sidebar Column (1/3) - Enhanced #}
            <div class="space-y-6">

                {# Profile Card - Glassmorphism #}
                <div class="relative overflow-hidden rounded-2xl border border-white/50 shadow-xl shadow-slate-200/50 fade-up fade-up-3" style="background: linear-gradient(135deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.7) 100%);">
                    {# Decorative Top Gradient #}
                    <div class="h-24 relative overflow-hidden" style="background: linear-gradient(135deg, #10b981 0%, #059669 50%, #14b8a6 100%);">
                        <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 30% 50%, white 2px, transparent 2px), radial-gradient(circle at 70% 30%, white 1px, transparent 1px); background-size: 32px 32px;"></div>
                        <div class="absolute inset-0 shine"></div>
                    </div>
                    <div class="px-6 pb-6 pt-12 relative">
                        <div class="absolute left-6 top-12 -translate-y-1/2">
                            <div class="w-20 h-20 rounded-2xl flex items-center justify-center text-white text-2xl font-bold shadow-2xl shadow-emerald-500/30 border-4 border-white/90"
                                 style="background: linear-gradient(135deg, #34d399 0%, #10b981 50%, #059669 100%);">
                                {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                            </div>
                        </div>
                        <div class="pt-8">
                            <h3 class="font-bold text-slate-900 text-lg">{{ app.user.firstName|default('') }} {{ app.user.lastName|default('') }}</h3>
                            <p class="text-sm text-slate-500 mt-0.5">{{ app.user.email }}</p>
                            
                            {# Profile Progress #}
                            <div class="mt-4 mb-5">
                                <div class="flex items-center justify-between text-xs mb-1.5">
                                    <span class="text-slate-500 font-medium">Complétion du profil</span>
                                    <span class="text-emerald-600 font-bold">{{ app.user.profileCompletion|default(75) }}%</span>
                                </div>
                                <div class="h-2 bg-slate-100 rounded-full overflow-hidden">
                                    <div class="h-full bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full transition-all duration-500" style="width: {{ app.user.profileCompletion|default(75) }}%"></div>
                                </div>
                            </div>

                            <div class="grid grid-cols-3 gap-2">
                                <div class="flex flex-col items-center p-3 rounded-xl bg-slate-50/80 border border-slate-100 hover:bg-slate-50 transition-colors">
                                    <span class="text-xl font-bold text-slate-900">{{ stats.total }}</span>
                                    <span class="text-[10px] text-slate-500 font-medium mt-0.5 uppercase tracking-wider">Envoyées</span>
                                </div>
                                <div class="flex flex-col items-center p-3 rounded-xl bg-slate-50/80 border border-slate-100 hover:bg-slate-50 transition-colors">
                                    <span class="text-xl font-bold text-slate-900">{{ stats.interview }}</span>
                                    <span class="text-[10px] text-slate-500 font-medium mt-0.5 uppercase tracking-wider">Entretiens</span>
                                </div>
                                <div class="flex flex-col items-center p-3 rounded-xl bg-slate-50/80 border border-slate-100 hover:bg-slate-50 transition-colors">
                                    <span class="text-xl font-bold text-slate-900">{{ stats.offer + stats.hired }}</span>
                                    <span class="text-[10px] text-slate-500 font-medium mt-0.5 uppercase tracking-wider">Offres</span>
                                </div>
                            </div>

                            <a href="{{ path('app_candidate_profile') }}"
                               class="mt-5 w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-sm font-semibold transition-all shadow-lg shadow-slate-900/20 hover:shadow-xl hover:-translate-y-0.5">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                Voir mon profil complet
                            </a>
                        </div>
                    </div>
                </div>

                {# Activity Feed #}
                <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm p-5 fade-up fade-up-4">
                    <h3 class="text-sm font-bold text-slate-900 mb-4 flex items-center gap-2">
                        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Activité récente
                    </h3>
                    <div class="space-y-4">
                        {% if recentApplications|length > 0 %}
                            {% for application in recentApplications|slice(0, 3) %}
                                <div class="flex gap-3">
                                    <div class="w-8 h-8 rounded-lg bg-{{ application.statusColor }}-100 flex items-center justify-center shrink-0">
                                        <svg class="w-4 h-4 text-{{ application.statusColor }}-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/>
                                        </svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-sm text-slate-700 truncate">
                                            Candidature <span class="font-semibold">{{ application.jobOffer.title }}</span>
                                        </p>
                                        <p class="text-xs text-slate-400 mt-0.5">{{ application.appliedAt|date('d M') }} • {{ application.statusLabel }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-4">
                                <p class="text-sm text-slate-400">Aucune activité récente</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Daily Tip - Enhanced #}
                <div class="relative overflow-hidden rounded-2xl p-6 text-white shadow-xl shadow-slate-900/20 fade-up fade-up-5" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-3xl"></div>
                    <div class="absolute bottom-0 left-0 w-24 h-24 bg-blue-500/10 rounded-full blur-2xl"></div>
                    
                    <div class="relative">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-400/20 to-emerald-600/20 flex items-center justify-center mb-4 border border-emerald-400/30">
                            <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                            </svg>
                        </div>
                        <h3 class="font-bold text-base mb-2">Conseil du jour</h3>
                        <p class="text-sm text-slate-300 leading-relaxed mb-4">Personnalisez votre lettre de motivation pour chaque poste. Les recruteurs apprécient les candidats qui montrent un intérêt spécifique.</p>
                        <a href="#" class="inline-flex items-center gap-2 text-sm font-bold text-emerald-400 hover:text-emerald-300 transition-colors group">
                            Lire le guide complet
                            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                            </svg>
                        </a>
                    </div>
                </div>

                {# Quick Links #}
                <div class="bg-white rounded-2xl border border-slate-200/60 shadow-sm p-5 fade-up fade-up-6">
                    <h3 class="text-sm font-bold text-slate-900 mb-4">Raccourcis</h3>
                    <div class="space-y-2">
                        <a href="{{ path('app_candidate_job_offers') }}" class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors group">
                            <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center group-hover:bg-emerald-200 transition-colors">
                                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <span class="text-sm font-medium text-slate-600 group-hover:text-slate-900">Offres d'emploi</span>
                        </a>
                        <a href="{{ path('app_candidate_applications') }}" class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors group">
                            <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center group-hover:bg-blue-200 transition-colors">
                                <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                </svg>
                            </div>
                            <span class="text-sm font-medium text-slate-600 group-hover:text-slate-900">Mes candidatures</span>
                        </a>
                        <a href="{{ path('app_candidate_interviews') }}" class="flex items-center gap-3 p-3 rounded-xl hover:bg-slate-50 transition-colors group">
                            <div class="w-8 h-8 rounded-lg bg-violet-100 flex items-center justify-center group-hover:bg-violet-200 transition-colors">
                                <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <span class="text-sm font-medium text-slate-600 group-hover:text-slate-900">Mes entretiens</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
