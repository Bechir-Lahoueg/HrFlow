{% extends 'base.html.twig' %}

{% block title %}Espace Candidat | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased">
    {# Navigation #}
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex items-center justify-between h-16">
                {# Logo #}
                <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 no-underline">
                    <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[2.5] origin-left">
                </a>

                {# Nav Links #}
                <div class="hidden md:flex items-center gap-1">
                    <a href="{{ path('app_candidate_dashboard') }}" class="px-4 py-2 rounded-lg text-sm font-semibold text-emerald-700 bg-emerald-50">
                        Tableau de bord
                    </a>
                    <a href="{{ path('app_candidate_applications') }}" class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        Mes candidatures
                    </a>
                    <a href="{{ path('app_candidate_job_offers') }}" class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        Offres d'emploi
                    </a>
                    <a href="{{ path('app_candidate_interviews') }}" class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        Mes entretiens
                    </a>
                    <a href="{{ path('app_candidate_profile') }}" class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        Mon profil
                    </a>
                </div>

                {# User Menu #}
                <div class="flex items-center gap-4">
                    <span class="text-sm text-slate-600 hidden sm:block">{{ app.user.username }}</span>
                    <a href="{{ path('app_logout') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-red-600 hover:bg-red-50 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                        Deconnexion
                    </a>
                </div>
            </div>
        </div>
    </nav>

    {# Main Content #}
    <main class="max-w-7xl mx-auto px-6 py-8">
        {# Welcome Banner #}
        <div class="bg-gradient-to-r from-emerald-600 to-teal-600 rounded-2xl p-8 text-white mb-8 relative overflow-hidden">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml,%3Csvg width=\"60\" height=\"60\" viewBox=\"0 0 60 60\" xmlns=\"http://www.w3.org/2000/svg\"%3E%3Cg fill=\"none\" fill-rule=\"evenodd\"%3E%3Cg fill=\"%23ffffff\" fill-opacity=\"0.05\"%3E%3Cpath d=\"M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E')] opacity-50"></div>
            <div class="relative">
                <div class="flex items-center gap-3 mb-3">
                    <span class="px-3 py-1 rounded-full bg-white/20 text-white text-xs font-semibold">Espace Candidat</span>
                </div>
                <h1 class="text-3xl font-bold mb-2">Bienvenue, {{ app.user.firstName|default(app.user.username) }} !</h1>
                <p class="text-emerald-100">Voici un apercu de votre espace candidat. Postulez aux offres et suivez vos candidatures.</p>
            </div>
        </div>

        {# Stats Cards #}
        <div class="grid md:grid-cols-4 gap-4 mb-8">
            <a href="{{ path('app_candidate_applications') }}" class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm hover:shadow-md hover:border-emerald-200 transition-all group">
                <div class="flex items-center justify-between mb-3">
                    <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center group-hover:bg-blue-100 transition-colors">
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </div>
                    <span class="text-2xl font-bold text-slate-900">{{ stats.total }}</span>
                </div>
                <h3 class="text-sm font-semibold text-slate-600">Candidatures</h3>
            </a>

            <a href="{{ path('app_candidate_applications') }}" class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm hover:shadow-md hover:border-amber-200 transition-all group">
                <div class="flex items-center justify-between mb-3">
                    <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center group-hover:bg-amber-100 transition-colors">
                        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <span class="text-2xl font-bold text-slate-900">{{ stats.pending + stats.reviewing }}</span>
                </div>
                <h3 class="text-sm font-semibold text-slate-600">En attente</h3>
            </a>

            <a href="{{ path('app_candidate_interviews') }}" class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm hover:shadow-md hover:border-purple-200 transition-all group">
                <div class="flex items-center justify-between mb-3">
                    <div class="w-10 h-10 rounded-lg bg-purple-50 flex items-center justify-center group-hover:bg-purple-100 transition-colors">
                        <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                    <span class="text-2xl font-bold text-slate-900">{{ stats.interview }}</span>
                </div>
                <h3 class="text-sm font-semibold text-slate-600">Entretiens</h3>
            </a>

            <a href="{{ path('app_candidate_applications') }}" class="bg-white rounded-xl p-5 border border-slate-200 shadow-sm hover:shadow-md hover:border-emerald-200 transition-all group">
                <div class="flex items-center justify-between mb-3">
                    <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center group-hover:bg-emerald-100 transition-colors">
                        <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <span class="text-2xl font-bold text-slate-900">{{ stats.offer + stats.hired }}</span>
                </div>
                <h3 class="text-sm font-semibold text-slate-600">Offres reçues</h3>
            </a>
        </div>

        <div class="grid lg:grid-cols-3 gap-8 mb-8">
            {# Left Column: Quick Actions & Upcoming Interviews #}
            <div class="lg:col-span-2 space-y-6">
                {# Quick Actions #}
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                    <h2 class="text-lg font-bold text-slate-900 mb-4">Actions rapides</h2>
                    <div class="grid sm:grid-cols-2 gap-4">
                        <a href="{{ path('app_candidate_job_offers') }}" class="flex items-center gap-4 p-4 rounded-xl bg-emerald-50 hover:bg-emerald-100 border border-emerald-100 transition-colors group">
                            <div class="w-12 h-12 rounded-lg bg-emerald-500 flex items-center justify-center group-hover:scale-105 transition-transform">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </div>
                            <div>
                                <h3 class="font-semibold text-emerald-900">Parcourir les offres</h3>
                                <p class="text-sm text-emerald-700">Decouvrez les opportunites</p>
                            </div>
                        </a>
                        <a href="{{ path('app_candidate_profile') }}" class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 transition-colors group">
                            <div class="w-12 h-12 rounded-lg bg-slate-500 flex items-center justify-center group-hover:scale-105 transition-transform">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            </div>
                            <div>
                                <h3 class="font-semibold text-slate-900">Completer mon profil</h3>
                                <p class="text-sm text-slate-600">Mettez a jour vos informations</p>
                            </div>
                        </a>
                    </div>
                </div>

                {# Upcoming Interviews Section #}
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-bold text-slate-900">Prochains entretiens</h2>
                        <a href="{{ path('app_candidate_interviews') }}" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700">Voir tout</a>
                    </div>
                    
                    {% if upcomingInterviews|length > 0 %}
                        <div class="space-y-4">
                            {% for interview in upcomingInterviews %}
                                <div class="flex items-center gap-4 p-4 rounded-xl bg-purple-50 border border-purple-100">
                                    <div class="w-12 h-12 rounded-lg bg-purple-500 flex items-center justify-center shrink-0">
                                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h3 class="font-semibold text-slate-900 truncate">{{ interview.application.jobOffer.title }}</h3>
                                        <p class="text-sm text-slate-600">
                                            {{ interview.interviewDate|date('d M Y') }} à {{ interview.interviewDate|date('H:i') }}
                                        </p>
                                        <div class="flex items-center gap-2 mt-1">
                                            <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-purple-100 text-purple-700">
                                                {{ interview.type }}
                                            </span>
                                            {% if interview.location %}
                                                <span class="text-xs text-slate-500">📍 {{ interview.location }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-8">
                            <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4">
                                <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </div>
                            <p class="text-slate-500 text-sm">Aucun entretien prevu</p>
                        </div>
                    {% endif %}
                </div>

                {# Recent Applications #}
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-bold text-slate-900">Candidatures recentes</h2>
                        <a href="{{ path('app_candidate_applications') }}" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700">Voir tout</a>
                    </div>
                    
                    {% if recentApplications|length > 0 %}
                        <div class="space-y-3">
                            {% for application in recentApplications|slice(0, 5) %}
                                <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100 hover:border-emerald-200 transition-colors">
                                    <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shrink-0">
                                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <h3 class="font-semibold text-slate-900 truncate">{{ application.jobOffer.title }}</h3>
                                        <p class="text-sm text-slate-500">Postule {{ application.appliedAt|date('d M Y') }}</p>
                                    </div>
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-{{ application.statusColor }}-50 text-{{ application.statusColor }}-700 border border-{{ application.statusColor }}-200">
                                        {{ application.statusLabel }}
                                    </span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-8">
                            <div class="w-16 h-16 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4">
                                <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            </div>
                            <p class="text-slate-500 mb-4">Aucune candidature pour le moment</p>
                            <a href="{{ path('app_candidate_job_offers') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold transition-colors">
                                Decouvrir les offres
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Right Column: Profile Summary #}
            <div class="space-y-6">
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
                    <div class="text-center mb-6">
                        <div class="w-20 h-20 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center mx-auto mb-4 shadow-lg shadow-emerald-500/20">
                            <span class="text-2xl font-bold text-white">{{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}</span>
                        </div>
                        <h3 class="font-bold text-slate-900">{{ app.user.fullName|default(app.user.username) }}</h3>
                        <p class="text-sm text-slate-500">{{ app.user.email }}</p>
                    </div>
                    
                    <div class="space-y-3">
                        <a href="{{ path('app_candidate_profile') }}" class="flex items-center gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors">
                            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            <span class="text-sm font-medium text-slate-700">Modifier mon profil</span>
                        </a>
                        <a href="{{ path('app_candidate_applications') }}" class="flex items-center gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors">
                            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            <span class="text-sm font-medium text-slate-700">Mes candidatures</span>
                            <span class="ml-auto text-xs font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">{{ stats.total }}</span>
                        </a>
                        <a href="{{ path('app_candidate_interviews') }}" class="flex items-center gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors">
                            <svg class="w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            <span class="text-sm font-medium text-slate-700">Mes entretiens</span>
                        </a>
                    </div>
                </div>

                {# Help Card #}
                <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-xl p-6 text-white">
                    <div class="w-12 h-12 rounded-lg bg-white/10 flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <h3 class="font-semibold mb-2">Besoin d'aide ?</h3>
                    <p class="text-sm text-slate-400 mb-4">Consultez notre guide candidat pour optimiser vos candidatures.</p>
                    <a href="#" class="inline-flex items-center gap-2 text-sm font-semibold text-emerald-400 hover:text-emerald-300 transition-colors">
                        Voir le guide
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>
            </div>
        </div>

    </main>
</div>
{% endblock %}
