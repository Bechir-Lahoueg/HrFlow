{% extends 'base.html.twig' %}

{% block title %}Tableau de bord | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'DM Sans', sans-serif; background: #f5f6f8; color: #1a1d23; }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(14px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-up  { animation: fadeUp 0.45s cubic-bezier(.22,1,.36,1) both; }
        .d1 { animation-delay: .06s; }
        .d2 { animation-delay: .12s; }
        .d3 { animation-delay: .18s; }
        .d4 { animation-delay: .24s; }
        .d5 { animation-delay: .30s; }
        .d6 { animation-delay: .36s; }

        .card {
            background: #fff;
            border: 1px solid #e8eaed;
            border-radius: 16px;
            overflow: hidden;
        }

        /* Stat cards */
        .stat-card {
            background: #fff; border: 1px solid #e8eaed; border-radius: 14px;
            padding: 20px; text-decoration: none; color: inherit;
            display: block;
            transition: transform .2s, box-shadow .2s, border-color .2s;
        }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.07); border-color: #d1d5db; }

        /* Quick action cards */
        .action-card {
            background: #fff; border: 1px solid #e8eaed; border-radius: 14px;
            padding: 18px 20px; text-decoration: none; color: inherit;
            display: flex; align-items: center; gap: 14px;
            transition: transform .2s, box-shadow .2s;
        }
        .action-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,.06); }
        .action-icon {
            width: 48px; height: 48px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center; flex-shrink: 0;
            transition: transform .2s;
        }
        .action-card:hover .action-icon { transform: scale(1.08) rotate(3deg); }

        /* Interview items */
        .interview-item {
            display: flex; align-items: center; gap: 14px;
            padding: 14px 16px; border-radius: 12px; border: 1px solid #f1f3f5;
            background: #fafbfc;
            transition: border-color .2s, background .2s;
            cursor: pointer;
        }
        .interview-item:hover { border-color: #c4b5fd; background: #faf5ff; }

        /* Application items */
        .app-item {
            display: flex; align-items: center; gap: 14px;
            padding: 12px 14px; border-radius: 10px;
            transition: background .15s; cursor: pointer;
        }
        .app-item:hover { background: #f9fafb; }

        /* Progress bar */
        .prog-bar { height: 4px; background: #f1f3f5; border-radius: 99px; overflow: hidden; }
        .prog-fill { height: 100%; border-radius: 99px; transition: width .5s; }

        /* Empty state */
        .empty-state {
            display: flex; flex-direction: column; align-items: center;
            text-align: center; padding: 48px 24px;
            background: #fafbfc; border: 1.5px dashed #e5e7eb; border-radius: 12px;
        }
        .empty-icon {
            width: 56px; height: 56px; border-radius: 14px;
            background: #f1f3f5; display: flex; align-items: center; justify-content: center;
            margin-bottom: 14px;
        }

        .section-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 18px;
        }
        .section-header-left {
            display: flex; align-items: center; gap: 12px;
        }
        .section-header-icon {
            width: 36px; height: 36px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
        }
        .see-all {
            font-size: 13px; font-weight: 600; color: #16a34a;
            text-decoration: none; display: flex; align-items: center; gap: 3px;
            transition: color .15s;
        }
        .see-all:hover { color: #15803d; }

        .btn-green {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 10px 20px; border-radius: 10px;
            background: #16a34a; color: #fff; font-weight: 600; font-size: 13px;
            border: none; cursor: pointer; text-decoration: none;
            transition: background .15s;
        }
        .btn-green:hover { background: #15803d; }

        .badge {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 3px 9px; border-radius: 99px;
            font-size: 11px; font-weight: 700;
        }

        /* Sidebar profile card */
        .profile-banner {
            height: 80px;
            background: linear-gradient(135deg, #16a34a, #0d9488);
            position: relative; overflow: hidden;
        }
        .profile-banner::after {
            content:'';
            position:absolute; inset:0;
            background-image: radial-gradient(circle, rgba(255,255,255,.12) 1px, transparent 1px);
            background-size: 20px 20px;
        }
    </style>
{% endblock %}

{% block body %}
<div style="min-height:100vh; background:#f5f6f8;">
    {% include 'Candidate/components/_header.html.twig' %}

    <main style="max-width:1380px; margin:0 auto; padding:28px 20px 60px;">

        {# Welcome Banner #}
        <div class="fade-up" style="border-radius:20px; overflow:hidden; margin-bottom:28px; background: linear-gradient(135deg,#15803d 0%,#16a34a 60%,#059669 100%); padding:32px 36px; position:relative;">
            <div style="position:absolute;right:-60px;top:-60px;width:280px;height:280px;border-radius:50%;background:rgba(255,255,255,.05);"></div>
            <div style="position:absolute;right:80px;bottom:-80px;width:200px;height:200px;border-radius:50%;background:rgba(255,255,255,.04);"></div>

            <div style="position:relative; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:20px;">
                <div style="display:flex; align-items:center; gap:18px;">
                    <div style="position:relative;">
                        <div style="width:68px;height:68px;border-radius:16px;background:rgba(255,255,255,.15);border:2px solid rgba(255,255,255,.3);display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;color:#fff;">
                            {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                        </div>
                        <div style="position:absolute;bottom:-3px;right:-3px;width:18px;height:18px;border-radius:50%;background:#4ade80;border:2px solid rgba(255,255,255,.8);"></div>
                    </div>
                    <div>
                        <div style="display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);border-radius:99px;padding:4px 12px;font-size:11px;font-weight:600;color:rgba(255,255,255,.9);margin-bottom:8px;">
                            <span style="width:6px;height:6px;border-radius:50%;background:#86efac;"></span>
                            Espace Candidat Actif
                        </div>
                        <h1 style="font-size:26px;font-weight:700;color:#fff;margin:0 0 4px;">Bonjour, {{ app.user.firstName|default(app.user.userIdentifier) }} 👋</h1>
                        <p style="font-size:14px;color:rgba(255,255,255,.8);margin:0;">Suivez vos candidatures et découvrez de nouvelles opportunités.</p>
                    </div>
                </div>
                <div style="display:flex;flex-wrap:wrap;gap:10px;">
                    <a href="{{ path('app_candidate_job_offers') }}" style="display:inline-flex;align-items:center;gap:8px;padding:11px 22px;border-radius:10px;background:#fff;color:#15803d;font-weight:700;font-size:13px;text-decoration:none;transition:transform .15s,box-shadow .15s;" onmouseover="this.style.transform='translateY(-1px)';this.style.boxShadow='0 6px 16px rgba(0,0,0,.15)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        Découvrir les offres
                    </a>
                    <a href="{{ path('app_candidate_applications') }}" style="display:inline-flex;align-items:center;gap:8px;padding:11px 22px;border-radius:10px;background:rgba(255,255,255,.15);color:#fff;font-weight:600;font-size:13px;border:1px solid rgba(255,255,255,.25);text-decoration:none;">
                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        Mes candidatures
                    </a>
                </div>
            </div>
        </div>

        {# Stats Grid #}
        {% set total = stats.total > 0 ? stats.total : 1 %}
        {% set statsData = [
            { label: 'Total candidatures', value: stats.total, sub: 'postes visés', color: '#3b82f6', bg: '#eff6ff', path: 'app_candidate_applications',
              icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>',
              pct: 100 },
            { label: 'En cours', value: stats.pending + stats.reviewing, sub: 'en attente', color: '#f59e0b', bg: '#fffbeb', path: 'app_candidate_applications',
              icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>',
              pct: ((stats.pending + stats.reviewing) / total * 100)|round },
            { label: 'Entretiens', value: stats.interview, sub: 'programmés', color: '#8b5cf6', bg: '#f5f3ff', path: 'app_candidate_interviews',
              icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
              pct: (stats.interview / total * 100)|round },
            { label: 'Offres reçues', value: stats.offer + stats.hired, sub: 'acceptées', color: '#16a34a', bg: '#f0fdf4', path: 'app_candidate_applications',
              icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>',
              pct: ((stats.offer + stats.hired) / total * 100)|round }
        ] %}

        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:14px; margin-bottom:28px;">
            {% for i, s in statsData %}
                <a href="{{ path(s.path) }}" class="stat-card fade-up d{{ i + 1 }}">
                    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                        <div style="width:42px;height:42px;border-radius:10px;background:{{ s.bg }};display:flex;align-items:center;justify-content:center;">
                            <svg width="20" height="20" fill="none" stroke="{{ s.color }}" viewBox="0 0 24 24">{{ s.icon|raw }}</svg>
                        </div>
                        <span style="font-size:12px;font-weight:700;color:{{ s.color }};">{{ s.pct }}%</span>
                    </div>
                    <div style="font-size:28px;font-weight:700;color:#1a1d23;line-height:1;">{{ s.value }}</div>
                    <div style="font-size:12px;color:#6b7280;margin-top:2px;">{{ s.sub }}</div>
                    <p style="font-size:13px;font-weight:600;color:#374151;margin:10px 0 8px;">{{ s.label }}</p>
                    <div class="prog-bar">
                        <div class="prog-fill" style="width:{{ s.pct }}%;background:{{ s.color }};"></div>
                    </div>
                </a>
            {% endfor %}
        </div>

        {# Main Grid #}
        <div style="display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start;">

            {# Left Column #}
            <div style="display:flex;flex-direction:column;gap:20px;">

                {# Quick Actions #}
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;" class="fade-up d3">
                    <a href="{{ path('app_candidate_job_offers') }}" class="action-card">
                        <div class="action-icon" style="background:linear-gradient(135deg,#16a34a,#0d9488);">
                            <svg width="22" height="22" fill="none" stroke="#fff" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <p style="font-size:14px;font-weight:700;color:#1a1d23;margin:0 0 2px;">Parcourir les offres</p>
                            <p style="font-size:12px;color:#6b7280;margin:0;">{{ stats.availableJobs|default(12) }} opportunités</p>
                        </div>
                        <svg width="16" height="16" fill="none" stroke="#d1d5db" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                    <a href="{{ path('app_candidate_profile') }}" class="action-card">
                        <div class="action-icon" style="background:linear-gradient(135deg,#475569,#1e293b);">
                            <svg width="22" height="22" fill="none" stroke="#fff" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        </div>
                        <div style="flex:1;min-width:0;">
                            <p style="font-size:14px;font-weight:700;color:#1a1d23;margin:0 0 2px;">Mon profil</p>
                            <p style="font-size:12px;color:#6b7280;margin:0;">{{ app.user.profileCompletion|default(75) }}% complété</p>
                        </div>
                        <svg width="16" height="16" fill="none" stroke="#d1d5db" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </a>
                </div>

                {# Upcoming Interviews #}
                <div class="card fade-up d4" style="padding:24px;">
                    <div class="section-header">
                        <div class="section-header-left">
                            <div class="section-header-icon" style="background:#f5f3ff;">
                                <svg width="18" height="18" fill="none" stroke="#7c3aed" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                            </div>
                            <div>
                                <h2 style="font-size:15px;font-weight:700;color:#1a1d23;margin:0 0 1px;">Prochains entretiens</h2>
                                <p style="font-size:12px;color:#9ca3af;margin:0;">{{ upcomingInterviews|length }} événements prévus</p>
                            </div>
                        </div>
                        <a href="{{ path('app_candidate_interviews') }}" class="see-all">Voir tout <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
                    </div>

                    {% if upcomingInterviews|length > 0 %}
                        <div style="display:flex;flex-direction:column;gap:10px;">
                            {% for interview in upcomingInterviews %}
                                <div class="interview-item">
                                    <div style="width:52px;height:52px;border-radius:12px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;flex-shrink:0;">
                                        <span style="font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;opacity:.85;">{{ interview.interviewDate|date('M') }}</span>
                                        <span style="font-size:20px;font-weight:700;line-height:1.1;">{{ interview.interviewDate|date('d') }}</span>
                                    </div>
                                    <div style="flex:1;min-width:0;">
                                        <p style="font-size:14px;font-weight:600;color:#1a1d23;margin:0 0 5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ interview.application.jobOffer.title }}</p>
                                        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;">
                                            <span style="font-size:12px;color:#6b7280;display:flex;align-items:center;gap:3px;">
                                                <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                {{ interview.interviewDate|date('H:i') }}
                                            </span>
                                            <span class="badge" style="background:#ede9fe;color:#5b21b6;">{{ interview.type }}</span>
                                            {% if interview.location %}
                                                <span style="font-size:12px;color:#6b7280;">{{ interview.location }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <svg width="16" height="16" fill="none" stroke="#d1d5db" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <div class="empty-icon"><svg width="24" height="24" fill="none" stroke="#9ca3af" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>
                            <p style="font-size:14px;font-weight:600;color:#374151;margin:0 0 4px;">Aucun entretien prévu</p>
                            <p style="font-size:13px;color:#9ca3af;margin:0 0 16px;">Postulez à des offres pour être contacté</p>
                            <a href="{{ path('app_candidate_job_offers') }}" class="btn-green">
                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                Parcourir les offres
                            </a>
                        </div>
                    {% endif %}
                </div>

                {# Recent Applications #}
                <div class="card fade-up d5" style="padding:24px;">
                    <div class="section-header">
                        <div class="section-header-left">
                            <div class="section-header-icon" style="background:#eff6ff;">
                                <svg width="18" height="18" fill="none" stroke="#2563eb" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                            </div>
                            <div>
                                <h2 style="font-size:15px;font-weight:700;color:#1a1d23;margin:0 0 1px;">Candidatures récentes</h2>
                                <p style="font-size:12px;color:#9ca3af;margin:0;">{{ recentApplications|length }} candidatures</p>
                            </div>
                        </div>
                        <a href="{{ path('app_candidate_applications') }}" class="see-all">Voir tout <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
                    </div>

                    {% if recentApplications|length > 0 %}
                        <div style="display:flex;flex-direction:column;gap:4px;">
                            {% for application in recentApplications|slice(0, 5) %}
                                <div class="app-item">
                                    <div style="width:40px;height:40px;border-radius:10px;background:#eff6ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <svg width="18" height="18" fill="none" stroke="#3b82f6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                    </div>
                                    <div style="flex:1;min-width:0;">
                                        <p style="font-size:14px;font-weight:600;color:#1a1d23;margin:0 0 3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">{{ application.jobOffer.title }}</p>
                                        <div style="display:flex;align-items:center;gap:6px;">
                                            <span style="font-size:12px;color:#9ca3af;">{{ application.appliedAt|date('d M Y') }}</span>
                                            {% if application.jobOffer.department is defined and application.jobOffer.department %}
                                                <span style="width:3px;height:3px;border-radius:50%;background:#d1d5db;"></span>
                                                <span style="font-size:12px;color:#9ca3af;">{{ application.jobOffer.department }}</span>
                                            {% endif %}
                                        </div>
                                        {% set progressMap = {'PENDING': 20, 'REVIEWING': 40, 'REVIEWED': 40, 'INTERVIEW': 65, 'OFFER': 85, 'HIRED': 100, 'REJECTED': 0} %}
                                        {% set progress = progressMap[application.status] ?? 0 %}
                                        <div class="prog-bar" style="margin-top:6px;">
                                            <div class="prog-fill" style="width:{{ progress }}%;background:#3b82f6;"></div>
                                        </div>
                                    </div>
                                    <span class="badge" style="background:{{ application.statusBg|default('#f1f5f9') }};color:{{ application.statusText|default('#475569') }};flex-shrink:0;">
                                        {{ application.statusLabel }}
                                    </span>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="empty-state">
                            <div class="empty-icon"><svg width="24" height="24" fill="none" stroke="#9ca3af" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg></div>
                            <p style="font-size:14px;font-weight:600;color:#374151;margin:0 0 4px;">Aucune candidature pour le moment</p>
                            <p style="font-size:13px;color:#9ca3af;margin:0 0 16px;">Commencez votre recherche dès maintenant</p>
                            <a href="{{ path('app_candidate_job_offers') }}" class="btn-green">
                                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                Découvrir les offres
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Right Sidebar #}
            <div style="display:flex;flex-direction:column;gap:18px;">

                {# Profile Card #}
                <div class="card fade-up d3">
                    <div class="profile-banner"></div>
                    <div style="padding:0 20px 20px;position:relative;">
                        <div style="position:absolute;top:-36px;left:20px;">
                            <div style="width:68px;height:68px;border-radius:16px;background:linear-gradient(135deg,#34d399,#059669);display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:700;color:#fff;border:3px solid #fff;box-shadow:0 4px 12px rgba(0,0,0,.12);">
                                {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                            </div>
                        </div>
                        <div style="height:40px;"></div>
                        <h3 style="font-size:16px;font-weight:700;color:#1a1d23;margin:0 0 2px;">{{ app.user.firstName|default('') }} {{ app.user.lastName|default('') }}</h3>
                        <p style="font-size:13px;color:#6b7280;margin:0 0 14px;">{{ app.user.email }}</p>

                        <div style="margin-bottom:14px;">
                            <div style="display:flex;align-items:center;justify-content:space-between;font-size:12px;margin-bottom:6px;">
                                <span style="color:#6b7280;font-weight:500;">Complétion du profil</span>
                                <span style="color:#16a34a;font-weight:700;">{{ app.user.profileCompletion|default(75) }}%</span>
                            </div>
                            <div class="prog-bar" style="height:6px;">
                                <div class="prog-fill" style="width:{{ app.user.profileCompletion|default(75) }}%;background:linear-gradient(90deg,#16a34a,#0d9488);"></div>
                            </div>
                        </div>

                        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:16px;">
                            {% for stat in [
                                { val: stats.total, lbl: 'Envoyées' },
                                { val: stats.interview, lbl: 'Entretiens' },
                                { val: stats.offer + stats.hired, lbl: 'Offres' }
                            ] %}
                                <div style="text-align:center;padding:10px 6px;background:#f8f9fa;border:1px solid #f1f3f5;border-radius:10px;">
                                    <div style="font-size:18px;font-weight:700;color:#1a1d23;">{{ stat.val }}</div>
                                    <div style="font-size:10px;color:#9ca3af;font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin-top:1px;">{{ stat.lbl }}</div>
                                </div>
                            {% endfor %}
                        </div>

                        <a href="{{ path('app_candidate_profile') }}" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:11px;border-radius:10px;background:#1a1d23;color:#fff;font-weight:600;font-size:13px;text-decoration:none;transition:background .15s;" onmouseover="this.style.background='#374151'" onmouseout="this.style.background='#1a1d23'">
                            <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                            Voir mon profil complet
                        </a>
                    </div>
                </div>

                {# Activity Feed #}
                <div class="card fade-up d4" style="padding:20px;">
                    <h3 style="font-size:13px;font-weight:700;color:#1a1d23;margin:0 0 14px;display:flex;align-items:center;gap:6px;">
                        <svg width="14" height="14" fill="none" stroke="#9ca3af" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Activité récente
                    </h3>
                    <div style="display:flex;flex-direction:column;gap:12px;">
                        {% if recentApplications|length > 0 %}
                            {% for application in recentApplications|slice(0, 3) %}
                                <div style="display:flex;gap:10px;align-items:flex-start;">
                                    <div style="width:30px;height:30px;border-radius:8px;background:#f0fdf4;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                        <svg width="14" height="14" fill="none" stroke="#16a34a" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4"/></svg>
                                    </div>
                                    <div style="flex:1;min-width:0;">
                                        <p style="font-size:13px;color:#374151;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                            <strong>{{ application.jobOffer.title }}</strong>
                                        </p>
                                        <p style="font-size:11px;color:#9ca3af;margin:2px 0 0;">{{ application.appliedAt|date('d M') }} · {{ application.statusLabel }}</p>
                                    </div>
                                </div>
                            {% endfor %}
                        {% else %}
                            <p style="font-size:13px;color:#9ca3af;text-align:center;padding:12px 0;">Aucune activité récente</p>
                        {% endif %}
                    </div>
                </div>

                {# Daily Tip #}
                <div class="fade-up d5" style="border-radius:16px;padding:22px;background:#1a1d23;color:#fff;position:relative;overflow:hidden;">
                    <div style="position:absolute;top:-20px;right:-20px;width:100px;height:100px;border-radius:50%;background:rgba(22,163,74,.12);"></div>
                    <div style="position:relative;">
                        <div style="width:40px;height:40px;border-radius:10px;background:rgba(22,163,74,.2);border:1px solid rgba(22,163,74,.3);display:flex;align-items:center;justify-content:center;margin-bottom:12px;">
                            <svg width="18" height="18" fill="none" stroke="#4ade80" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                        </div>
                        <p style="font-size:12px;font-weight:700;color:#4ade80;text-transform:uppercase;letter-spacing:.06em;margin:0 0 6px;">Conseil du jour</p>
                        <p style="font-size:13px;color:rgba(255,255,255,.75);line-height:1.6;margin:0 0 14px;">Personnalisez votre lettre de motivation pour chaque poste. Les recruteurs apprécient les candidats qui montrent un intérêt spécifique.</p>
                        <a href="#" style="font-size:13px;font-weight:700;color:#4ade80;text-decoration:none;display:flex;align-items:center;gap:4px;">
                            Lire le guide
                            <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                        </a>
                    </div>
                </div>

                {# Quick Links #}
                <div class="card fade-up d6" style="padding:16px 14px;">
                    <h3 style="font-size:11px;font-weight:700;color:#9ca3af;text-transform:uppercase;letter-spacing:.07em;padding:0 6px;margin:0 0 8px;">Raccourcis</h3>
                    {% for link in [
                        { path: 'app_candidate_job_offers', label: 'Offres d\'emploi', sub: 'Explorer', icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z', ic: '#16a34a', ibg: '#f0fdf4' },
                        { path: 'app_candidate_applications', label: 'Mes candidatures', sub: 'Historique', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z', ic: '#2563eb', ibg: '#eff6ff' },
                        { path: 'app_candidate_interviews', label: 'Mes entretiens', sub: 'Calendrier', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z', ic: '#7c3aed', ibg: '#f5f3ff' }
                    ] %}
                        <a href="{{ path(link.path) }}" style="display:flex;align-items:center;gap:10px;padding:10px 8px;border-radius:10px;text-decoration:none;transition:background .15s;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background=''">
                            <div style="width:32px;height:32px;border-radius:8px;background:{{ link.ibg }};display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <svg width="15" height="15" fill="none" stroke="{{ link.ic }}" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ link.icon }}"/></svg>
                            </div>
                            <div>
                                <p style="font-size:13px;font-weight:600;color:#1a1d23;margin:0;">{{ link.label }}</p>
                                <p style="font-size:11px;color:#9ca3af;margin:0;">{{ link.sub }}</p>
                            </div>
                            <svg width="14" height="14" fill="none" stroke="#d1d5db" viewBox="0 0 24 24" style="margin-left:auto;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}
