{% extends 'base.html.twig' %}

{% block title %}Offres d'emploi | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .card-anim { animation: fadeUp 0.35s ease-out both; }
        .job-card:hover .job-icon { transform: rotate(-6deg) scale(1.05); }
        .job-icon { transition: transform 0.25s ease; }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8fafc] antialiased overflow-x-hidden">
    {% include 'Candidate/components/_header.html.twig' %}

    <main class="w-full p-6 lg:p-8 max-w-[1400px] mx-auto">

                {# Page Header #}
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
                    <div>
                        <h1 class="text-2xl font-bold text-slate-900">Offres d'emploi</h1>
                        <p class="text-slate-500 text-sm mt-1">Découvrez nos opportunités et postulez en quelques clics.</p>
                    </div>
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-700 text-sm font-semibold shrink-0">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        {{ jobOffers|length }} offre{{ jobOffers|length != 1 ? 's' : '' }} disponible{{ jobOffers|length != 1 ? 's' : '' }}
                    </div>
                </div>

                {# Search & Filters #}
                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 mb-6">
                    <form method="get" action="{{ path('app_candidate_job_offers') }}">
                        {# Search Bar #}
                        <div class="relative mb-4">
                            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                                </svg>
                            </div>
                            <input type="text" name="search" value="{{ filters.search }}"
                                   placeholder="Rechercher par titre, compétences, département..."
                                   class="w-full pl-11 pr-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-emerald-400 focus:ring-[3px] focus:ring-emerald-500/10 transition-all">
                        </div>

                        {# Filters #}
                        <div class="grid md:grid-cols-3 gap-3 mb-4">
                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Département</label>
                                <select name="department" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-white text-sm text-slate-700 focus:outline-none focus:border-emerald-400 focus:ring-[3px] focus:ring-emerald-500/10 transition-all">
                                    <option value="">Tous les départements</option>
                                    {% for dept in departments %}
                                        <option value="{{ dept }}" {{ filters.department == dept ? 'selected' : '' }}>{{ dept }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Localisation</label>
                                <select name="location" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-white text-sm text-slate-700 focus:outline-none focus:border-emerald-400 focus:ring-[3px] focus:ring-emerald-500/10 transition-all">
                                    <option value="">Toutes les localisations</option>
                                    {% for loc in locations %}
                                        <option value="{{ loc }}" {{ filters.location == loc ? 'selected' : '' }}>{{ loc }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div>
                                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1.5">Type de contrat</label>
                                <select name="employmentType" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 bg-white text-sm text-slate-700 focus:outline-none focus:border-emerald-400 focus:ring-[3px] focus:ring-emerald-500/10 transition-all">
                                    <option value="">Tous les types</option>
                                    {% for type in employmentTypes %}
                                        <option value="{{ type }}" {{ filters.employmentType == type ? 'selected' : '' }}>{{ type|upper }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="flex items-center justify-end gap-2">
                            <a href="{{ path('app_candidate_job_offers') }}"
                               class="px-4 py-2 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                                Réinitialiser
                            </a>
                            <button type="submit"
                                    class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition-colors shadow-sm shadow-emerald-500/20">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                                </svg>
                                Filtrer
                            </button>
                        </div>
                    </form>
                </div>

                {# Job Offers List #}
                {% if jobOffers|length > 0 %}
                    <div class="space-y-4">
                        {% for i, offer in jobOffers %}
                            {% set isApplied = offer.id in appliedJobIds %}
                            <article class="job-card group bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-[0_4px_24px_-4px_rgba(0,0,0,0.1)] hover:border-emerald-200 transition-all duration-300 overflow-hidden card-anim"
                                     style="animation-delay: {{ (i * 0.05) }}s">
                                <div class="p-6">
                                    <div class="flex flex-col lg:flex-row lg:items-start gap-5">

                                        {# Left: Job Info #}
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-start gap-4 mb-4">
                                                <div class="job-icon w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/20 shrink-0">
                                                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                                    </svg>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex flex-wrap items-center gap-2 mb-1.5">
                                                        <h2 class="text-lg font-bold text-slate-900 group-hover:text-emerald-700 transition-colors truncate">
                                                            {{ offer.title }}
                                                        </h2>
                                                        {% if isApplied %}
                                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">
                                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                                Postulé
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                    <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
                                                        {% if offer.department %}
                                                            <span class="inline-flex items-center gap-1.5">
                                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                                                                {{ offer.department }}
                                                            </span>
                                                        {% endif %}
                                                        {% if offer.location %}
                                                            <span class="inline-flex items-center gap-1.5">
                                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                                                                {{ offer.location }}
                                                            </span>
                                                        {% endif %}
                                                        {% if offer.createdAt %}
                                                            <span class="inline-flex items-center gap-1.5">
                                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                                                Publié le {{ offer.createdAt|date('d M Y') }}
                                                            </span>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>

                                            {% if offer.description %}
                                                <p class="text-sm text-slate-500 line-clamp-2 mb-4 leading-relaxed">
                                                    {{ offer.description|striptags|slice(0, 220) }}...
                                                </p>
                                            {% endif %}

                                            {# Tags #}
                                            <div class="flex flex-wrap gap-2">
                                                {% if offer.employmentType %}
                                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold bg-blue-50 text-blue-700 border border-blue-100">
                                                        {{ offer.employmentType|upper }}
                                                    </span>
                                                {% endif %}
                                                {% if offer.salaryMin > 0 or offer.salaryMax > 0 %}
                                                    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-100">
                                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                        {{ offer.salaryMin|number_format(0, '.', ' ') }} – {{ offer.salaryMax|number_format(0, '.', ' ') }} TND
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </div>

                                        {# Action Button #}
                                        <div class="lg:self-center shrink-0">
                                            {% if isApplied %}
                                                <span class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-100 text-slate-500 text-sm font-bold cursor-default select-none">
                                                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                                    Déjà postulé
                                                </span>
                                            {% else %}
                                                <a href="{{ path('app_candidate_apply', {id: offer.id}) }}"
                                                   class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition-all hover:shadow-lg hover:shadow-emerald-500/25 hover:scale-[1.02]">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 9l3 3m0 0l-3 3m3-3H8m13 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                    Postuler
                                                </a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </article>
                        {% endfor %}
                    </div>

                {% else %}
                    {# Empty State #}
                    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-16 text-center">
                        <div class="w-20 h-20 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-5">
                            <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0v-2.25c0-1.094-.787-2.036-1.872-2.18-2.087-.277-4.216-.42-6.378-.42s-4.291.143-6.378.42c-1.085.144-1.872 1.086-1.872 2.18v2.25"/>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-slate-900 mb-2">Aucune offre trouvée</h3>
                        <p class="text-sm text-slate-500 mb-6 max-w-sm mx-auto">Aucune offre ne correspond à vos critères. Essayez de modifier vos filtres.</p>
                        <a href="{{ path('app_candidate_job_offers') }}"
                           class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm transition-colors">
                            Voir toutes les offres
                        </a>
                    </div>
                {% endif %}
    </main>
</div>
{% endblock %}
