{% extends 'base.html.twig' %}

{% block title %}Mon Profil | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] font-[Manrope,sans-serif] antialiased">
    {# Navigation #}
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6">
            <div class="flex items-center justify-between h-16">
                <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 no-underline">
                    <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[2.5] origin-left">
                </a>

                <div class="hidden md:flex items-center gap-1">
                    <a href="{{ path('app_candidate_dashboard') }}" class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        Tableau de bord
                    </a>
                    <a href="{{ path('app_candidate_applications') }}" class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        Mes candidatures
                    </a>
                    <a href="{{ path('app_job_offers') }}" class="px-4 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                        Offres d'emploi
                    </a>
                    <a href="{{ path('app_candidate_profile') }}" class="px-4 py-2 rounded-lg text-sm font-semibold text-emerald-700 bg-emerald-50">
                        Mon profil
                    </a>
                </div>

                <div class="flex items-center gap-4">
                    <span class="text-sm text-slate-600 hidden sm:block">{{ app.user.username }}</span>
                    <a href="{{ path('app_logout') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-red-600 hover:bg-red-50 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-3xl mx-auto px-6 py-8">
        <h1 class="text-2xl font-bold text-slate-900 mb-6">Mon profil</h1>

        <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6">
            <div class="flex items-center gap-4 mb-6 pb-6 border-b border-slate-200">
                <div class="w-20 h-20 rounded-full bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center text-white text-2xl font-bold">
                    {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                </div>
                <div>
                    <h2 class="text-xl font-bold text-slate-900">{{ app.user.firstName|default('') }} {{ app.user.lastName|default('') }}</h2>
                    <p class="text-slate-500">{{ app.user.email }}</p>
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Nom d'utilisateur</label>
                    <p class="px-4 py-3 bg-slate-50 rounded-lg text-slate-900">{{ app.user.username }}</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Email</label>
                    <p class="px-4 py-3 bg-slate-50 rounded-lg text-slate-900">{{ app.user.email }}</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Prenom</label>
                    <p class="px-4 py-3 bg-slate-50 rounded-lg text-slate-900">{{ app.user.firstName|default('Non renseigne') }}</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Nom</label>
                    <p class="px-4 py-3 bg-slate-50 rounded-lg text-slate-900">{{ app.user.lastName|default('Non renseigne') }}</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Telephone</label>
                    <p class="px-4 py-3 bg-slate-50 rounded-lg text-slate-900">{{ app.user.phone|default('Non renseigne') }}</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Type de compte</label>
                    <p class="px-4 py-3 bg-slate-50 rounded-lg text-slate-900">Candidat</p>
                </div>
            </div>

            <div class="mt-6 pt-6 border-t border-slate-200">
                <p class="text-sm text-slate-500 mb-4">Cette page est en cours de developpement. La modification du profil sera bientot disponible.</p>
                <a href="{{ path('app_candidate_dashboard') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    Retour au tableau de bord
                </a>
            </div>
        </div>
    </main>
</div>
{% endblock %}
