{% extends 'base.html.twig' %}

{% block title %}Mon Profil | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .fade-up { animation: fadeUp 0.35s ease-out both; }
        .fade-up-2 { animation-delay: 0.08s; }
        .fade-up-3 { animation-delay: 0.16s; }
        .input-field {
            @apply w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50;
            @apply focus:bg-white focus:border-emerald-400 focus:ring-[3px] focus:ring-emerald-500/10;
            @apply text-sm text-slate-800 placeholder-slate-400 outline-none transition-all;
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8fafc] antialiased overflow-x-hidden">
    {% include 'Candidate/components/_header.html.twig' %}

    <main class="w-full p-6 lg:p-8 max-w-[1400px] mx-auto">

                {# Flash Messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="mb-4 p-4 rounded-xl {{ label == 'success' ? 'bg-emerald-50 border border-emerald-200 text-emerald-800' : 'bg-red-50 border border-red-200 text-red-800' }} fade-up">
                            <div class="flex items-center gap-2">
                                <svg class="w-5 h-5 {{ label == 'success' ? 'text-emerald-500' : 'text-red-500' }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    {% if label == 'success' %}
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                    {% else %}
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    {% endif %}
                                </svg>
                                <span class="text-sm font-semibold">{{ message }}</span>
                            </div>
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Page Header #}
                <div class="mb-8 fade-up">
                    <h1 class="text-2xl font-bold text-slate-900">Mon profil</h1>
                    <p class="text-slate-500 text-sm mt-1">Gérez vos informations personnelles et la sécurité de votre compte.</p>
                </div>

                <div class="grid lg:grid-cols-3 gap-6">

                    {# Left Column - Profile Card #}
                    <div class="lg:col-span-1 space-y-5">

                        {# Identity Card #}
                        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden fade-up">
                            {# Banner #}
                            <div class="h-24 bg-gradient-to-r from-emerald-500 via-teal-500 to-cyan-500 relative">
                                <div class="absolute inset-0 opacity-20"
                                     style="background-image: radial-gradient(circle at 30% 40%, white 1px, transparent 1px), radial-gradient(circle at 70% 70%, white 1px, transparent 1px); background-size: 20px 20px;"></div>
                            </div>

                            <div class="px-5 pb-5">
                                {# Avatar #}
                                <div class="relative -mt-11 mb-4 flex items-end gap-3">
                                    <div class="relative">
                                        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center text-white text-2xl font-black shadow-xl shadow-emerald-500/25 border-4 border-white">
                                            {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                                        </div>
                                        <button class="absolute -bottom-1 -right-1 w-7 h-7 rounded-xl bg-white shadow-md border border-slate-100 flex items-center justify-center hover:bg-slate-50 transition-colors" title="Modifier la photo">
                                            <svg class="w-3.5 h-3.5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                        </button>
                                    </div>
                                    <span class="inline-flex items-center gap-1 mb-1 px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-700 border border-emerald-200">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                                        Actif
                                    </span>
                                </div>

                                <h2 class="text-lg font-bold text-slate-900">{{ app.user.firstName|default('') }} {{ app.user.lastName|default('') }}</h2>
                                <p class="text-sm text-slate-400 mt-0.5 mb-5">{{ app.user.email }}</p>

                                {# Stats #}
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="flex flex-col p-3 rounded-xl bg-slate-50 border border-slate-100">
                                        <span class="text-xl font-black text-slate-900">{{ stats.total|default(0) }}</span>
                                        <span class="text-[11px] font-semibold text-slate-500 mt-0.5">Candidatures</span>
                                    </div>
                                    <div class="flex flex-col p-3 rounded-xl bg-slate-50 border border-slate-100">
                                        <span class="text-xl font-black text-slate-900">{{ stats.interviews|default(0) }}</span>
                                        <span class="text-[11px] font-semibold text-slate-500 mt-0.5">Entretiens</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        {# Quick Links #}
                        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-4 fade-up fade-up-2">
                            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest px-2 mb-3">Raccourcis</h3>
                            <div class="space-y-0.5">
                                <a href="{{ path('app_candidate_applications') }}"
                                   class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors group">
                                    <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center group-hover:bg-blue-100 transition-colors">
                                        <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-800">Mes candidatures</p>
                                        <p class="text-xs text-slate-400">Voir l'historique</p>
                                    </div>
                                    <svg class="w-4 h-4 text-slate-300 ml-auto group-hover:text-slate-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                </a>
                                <a href="{{ path('app_candidate_interviews') }}"
                                   class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors group">
                                    <div class="w-8 h-8 rounded-lg bg-violet-50 flex items-center justify-center group-hover:bg-violet-100 transition-colors">
                                        <svg class="w-4 h-4 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-800">Mes entretiens</p>
                                        <p class="text-xs text-slate-400">Calendrier</p>
                                    </div>
                                    <svg class="w-4 h-4 text-slate-300 ml-auto group-hover:text-slate-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                </a>
                                <a href="{{ path('app_candidate_job_offers') }}"
                                   class="flex items-center gap-3 px-3 py-2.5 rounded-xl hover:bg-slate-50 transition-colors group">
                                    <div class="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center group-hover:bg-emerald-100 transition-colors">
                                        <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-800">Offres d'emploi</p>
                                        <p class="text-xs text-slate-400">Explorer</p>
                                    </div>
                                    <svg class="w-4 h-4 text-slate-300 ml-auto group-hover:text-slate-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                                </a>
                            </div>
                        </div>
                    </div>

                    {# Right Column - Edit Forms #}
                    <div class="lg:col-span-2 space-y-5">

                        {# Personal Info Form #}
                        {{ form_start(profileForm, {'attr': {'class': 'bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden fade-up fade-up-2'}}) }}
                            <div class="flex items-center justify-between px-6 py-5 border-b border-slate-100">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-sm">
                                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                    </div>
                                    <div>
                                        <h3 class="text-sm font-bold text-slate-900">Informations personnelles</h3>
                                        <p class="text-xs text-slate-400 mt-0.5">Mettez à jour vos coordonnées</p>
                                    </div>
                                </div>
                                <button type="submit" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold transition-colors shadow-sm shadow-emerald-500/20">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                    Enregistrer
                                </button>
                            </div>
                            <div class="p-6">
                                <div class="grid md:grid-cols-2 gap-4">
                                    <div>
                                        {{ form_label(profileForm.firstName) }}
                                        {{ form_widget(profileForm.firstName) }}
                                        {{ form_errors(profileForm.firstName) }}
                                    </div>
                                    <div>
                                        {{ form_label(profileForm.lastName) }}
                                        {{ form_widget(profileForm.lastName) }}
                                        {{ form_errors(profileForm.lastName) }}
                                    </div>
                                    <div>
                                        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Nom d'utilisateur</label>
                                        <div class="relative">
                                            <input type="text" value="{{ app.user.username }}" disabled
                                                   class="w-full px-4 py-3 rounded-xl border border-slate-100 bg-slate-100 text-slate-400 text-sm cursor-not-allowed">
                                            <div class="absolute inset-y-0 right-3 flex items-center">
                                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                            </div>
                                        </div>
                                    </div>
                                    <div>
                                        {{ form_label(profileForm.email) }}
                                        {{ form_widget(profileForm.email) }}
                                        {{ form_errors(profileForm.email) }}
                                    </div>
                                    <div class="md:col-span-2">
                                        {{ form_label(profileForm.phone) }}
                                        {{ form_widget(profileForm.phone) }}
                                        {{ form_errors(profileForm.phone) }}
                                    </div>
                                </div>
                            </div>
                        {{ form_end(profileForm) }}

                        {# Security - Password Change Form #}
                        {{ form_start(passwordForm, {'action': path('app_candidate_change_password'), 'attr': {'class': 'bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden fade-up fade-up-3'}}) }}
                            <div class="flex items-center gap-3 px-6 py-5 border-b border-slate-100">
                                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center shadow-sm">
                                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900">Sécurité du compte</h3>
                                    <p class="text-xs text-slate-400 mt-0.5">Modifiez votre mot de passe</p>
                                </div>
                            </div>
                            <div class="p-6 space-y-4">
                                <div>
                                    {{ form_label(passwordForm.currentPassword) }}
                                    {{ form_widget(passwordForm.currentPassword) }}
                                    {{ form_errors(passwordForm.currentPassword) }}
                                </div>
                                <div class="grid md:grid-cols-2 gap-4">
                                    <div>
                                        {{ form_label(passwordForm.newPassword.first) }}
                                        {{ form_widget(passwordForm.newPassword.first) }}
                                        {{ form_errors(passwordForm.newPassword.first) }}
                                    </div>
                                    <div>
                                        {{ form_label(passwordForm.newPassword.second) }}
                                        {{ form_widget(passwordForm.newPassword.second) }}
                                        {{ form_errors(passwordForm.newPassword.second) }}
                                    </div>
                                </div>

                                {# Password Strength Hint #}
                                <div class="flex items-start gap-3 p-3 rounded-xl bg-amber-50 border border-amber-100">
                                    <svg class="w-4 h-4 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    <p class="text-xs text-amber-800">Utilisez au minimum 6 caractères pour un mot de passe sécurisé.</p>
                                </div>

                                <div class="pt-1">
                                    <button type="submit" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-red-800 hover:bg-red-900 text-white text-sm font-bold transition-colors shadow-sm">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                                        Mettre à jour le mot de passe
                                    </button>
                                </div>
                            </div>
                        {{ form_end(passwordForm) }}

                        {# Danger Zone - Delete Account Form #}
                        <div class="bg-white rounded-2xl border border-red-100 shadow-sm overflow-hidden">
                            <div class="flex items-center gap-3 px-6 py-4 border-b border-red-100 bg-red-50/40">
                                <div class="w-9 h-9 rounded-xl bg-red-100 flex items-center justify-center">
                                    <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-sm font-bold text-slate-900">Zone dangereuse</h3>
                                    <p class="text-xs text-slate-400 mt-0.5">Actions irréversibles sur votre compte</p>
                                </div>
                            </div>
                            <form action="{{ path('app_candidate_delete_account') }}" method="POST" class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4" onsubmit="return confirm('Êtes-vous absolument sûr de vouloir supprimer votre compte ? Cette action est irréversible.');">
                                <div>
                                    <p class="text-sm font-semibold text-slate-800">Supprimer mon compte</p>
                                    <p class="text-xs text-slate-500 mt-1 mb-3">Cette action est permanente et supprime toutes vos données. Tapez DELETE pour confirmer.</p>
                                    <input type="text" name="delete_confirm" placeholder="Tapez DELETE" 
                                           class="w-full sm:w-48 px-3 py-2 rounded-lg border border-red-200 text-sm focus:border-red-400 focus:ring-2 focus:ring-red-100 outline-none transition-all"
                                           autocomplete="off">
                                </div>
                                <button type="submit" class="shrink-0 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border-2 border-red-200 text-red-600 hover:bg-red-50 hover:border-red-300 text-sm font-bold transition-all">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    Supprimer le compte
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
    </main>
</div>
{% endblock %}
