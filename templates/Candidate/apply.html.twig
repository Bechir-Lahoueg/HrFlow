{% extends 'base.html.twig' %}

{% block title %}Postuler – {{ jobOffer.title }} | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { font-family: 'DM Sans', sans-serif; background: #f5f6f8; color: #1a1d23; }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-up   { animation: fadeUp 0.4s cubic-bezier(.22,1,.36,1) both; }
        .delay-1   { animation-delay: 0.07s; }
        .delay-2   { animation-delay: 0.14s; }
        .delay-3   { animation-delay: 0.21s; }

        /* Stepper */
        .step-dot {
            width: 32px; height: 32px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 700; flex-shrink: 0;
            transition: box-shadow .2s;
        }
        .step-dot.done { background: #145EB7; color: #fff; box-shadow: 0 0 0 4px #d0edfd; }
        .step-dot.active { background: #0d3d6f; color: #fff; box-shadow: 0 0 0 4px #a8dcfb; }
        .step-dot.idle { background: #e5e7eb; color: #9ca3af; }
        .step-line { flex: 1; height: 2px; margin-bottom: 18px; border-radius: 2px; }

        /* Cards */
        .card {
            background: #fff;
            border: 1px solid #e8eaed;
            border-radius: 16px;
            overflow: hidden;
        }
        .card-header {
            padding: 20px 24px;
            border-bottom: 1px solid #f1f3f5;
            background: #fafbfc;
        }

        /* Upload zone */
        .upload-zone {
            position: relative;
            border: 1.5px dashed #d1d5db;
            border-radius: 12px;
            padding: 32px 24px;
            text-align: center;
            cursor: pointer;
            transition: border-color .2s, background .2s;
            overflow: hidden;
        }
        .upload-zone:hover,
        .upload-zone.has-file {
            border-color: #145EB7;
            background: #e8f6fe;
        }
        .upload-zone input[type="file"] {
            position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
        }
        .upload-icon {
            width: 48px; height: 48px; border-radius: 10px;
            background: #f8f9fa; border: 1px solid #e8eaed;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 12px;
        }

        /* Input fields */
        textarea {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #d1d5db;
            border-radius: 10px;
            background: #fafafa;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            color: #1a1d23;
            resize: vertical;
            outline: none;
            transition: border-color .2s, box-shadow .2s, background .2s;
        }
        textarea:focus {
            border-color: #145EB7;
            background: #fff;
            box-shadow: 0 0 0 3px #d0edfd;
        }

        /* Notice boxes */
        .notice {
            display: flex; gap: 12px; align-items: flex-start;
            padding: 14px 16px; border-radius: 10px;
        }
        .notice.info  { background: #eff6ff; border: 1px solid #bfdbfe; }
        .notice.error { background: #fef2f2; border: 1px solid #fecaca; }

        /* Buttons */
        .btn-primary {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 11px 24px; border-radius: 10px;
            background: #145EB7; color: #fff;
            font-weight: 600; font-size: 14px;
            border: none; cursor: pointer;
            transition: background .15s, transform .12s, box-shadow .15s;
        }
        .btn-primary:hover { background: #0d3d6f; box-shadow: 0 4px 12px rgba(20,94,183,.25); transform: translateY(-1px); }
        .btn-primary:active { transform: translateY(0); }

        .btn-ghost {
            display: inline-flex; align-items: center;
            padding: 11px 20px; border-radius: 10px;
            background: #fff; color: #374151;
            font-weight: 500; font-size: 14px;
            border: 1px solid #d1d5db; cursor: pointer;
            transition: background .15s;
            text-decoration: none;
        }
        .btn-ghost:hover { background: #f9fafb; }

        /* Section headings inside form */
        .field-label {
            display: flex; align-items: center; gap: 8px;
            margin-bottom: 12px;
        }
        .field-label-icon {
            width: 28px; height: 28px; border-radius: 7px;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }

        /* Badge pill */
        .badge {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 4px 10px; border-radius: 999px;
            font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
        }

        .error-msg {
            margin-top: 6px; font-size: 12px; font-weight: 600; color: #dc2626;
            display: flex; align-items: center; gap: 4px;
        }

        .divider { border: none; border-top: 1px solid #f1f3f5; }
    </style>
{% endblock %}

{% block body %}
<div style="min-height: 100vh; background: #f5f6f8;">
    {% include 'Candidate/components/_header.html.twig' %}

    <main style="max-width: 860px; margin: 0 auto; padding: 28px 20px 60px;">

        {# Breadcrumb #}
        <nav class="fade-up" style="display:flex; align-items:center; gap:6px; font-size:12px; color:#9ca3af; margin-bottom:24px;">
            <a href="{{ path('app_candidate_job_offers') }}" style="color:#6b7280; font-weight:500; text-decoration:none; transition:color .15s;" onmouseover="this.style.color='#145EB7'" onmouseout="this.style.color='#6b7280'">Offres d'emploi</a>
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <span style="color:#374151; font-weight:500; max-width:200px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{{ jobOffer.title }}</span>
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <span style="color:#1a1d23; font-weight:600;">Postuler</span>
        </nav>

        {# Step Indicator #}
        <div class="fade-up delay-1" style="display:flex; align-items:flex-start; gap:0; margin-bottom:32px;">
            {% set steps = [
                { label: 'Offre sélectionnée', state: 'done' },
                { label: 'Documents', state: 'active' },
                { label: 'Confirmation', state: 'idle' }
            ] %}
            {% for step in steps %}
                <div style="display:flex; flex-direction:column; align-items:center;">
                    <div class="step-dot {{ step.state }}">
                        {% if step.state == 'done' %}
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                        {% else %}
                            {{ loop.index }}
                        {% endif %}
                    </div>
                    <span style="font-size:11px; font-weight:600; margin-top:6px; white-space:nowrap; color:{{ step.state != 'idle' ? '#0d3d6f' : '#9ca3af' }};">{{ step.label }}</span>
                </div>
                {% if not loop.last %}
                    <div class="step-line" style="background:{{ loop.index < 2 ? '#74c4f8' : '#e5e7eb' }};"></div>
                {% endif %}
            {% endfor %}
        </div>

        {# Job Summary Card #}
        <div class="card fade-up delay-1" style="margin-bottom:20px; padding:20px 24px;">
            <div style="display:flex; align-items:flex-start; gap:16px;">
                <div style="width:52px; height:52px; border-radius:12px; background:linear-gradient(135deg,#145EB7,#3FA9F5); display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                    <svg width="24" height="24" fill="none" stroke="#fff" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div style="flex:1; min-width:0;">
                    <div style="display:flex; flex-wrap:wrap; align-items:flex-start; justify-content:space-between; gap:10px;">
                        <div>
                            <h1 style="font-size:18px; font-weight:700; color:#1a1d23; margin:0 0 6px;">{{ jobOffer.title }}</h1>
                            <div style="display:flex; flex-wrap:wrap; align-items:center; gap:12px;">
                                {% if jobOffer.department %}
                                    <span style="font-size:12px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                                        <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"/></svg>
                                        {{ jobOffer.department }}
                                    </span>
                                {% endif %}
                                {% if jobOffer.location %}
                                    <span style="font-size:12px; color:#6b7280; display:flex; align-items:center; gap:4px;">
                                        <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                                        {{ jobOffer.location }}
                                    </span>
                                {% endif %}
                                {% if jobOffer.employmentType %}
                                    <span class="badge" style="background:#d0edfd; color:#0d3d6f;">{{ jobOffer.employmentType }}</span>
                                {% endif %}
                            </div>
                        </div>
                        <span class="badge" style="background:#d0edfd; color:#0d3d6f; border:1px solid #a8dcfb;">
                            <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                            Poste sélectionné
                        </span>
                    </div>
                </div>
            </div>
        </div>

        {# Application Form #}
        <div class="card fade-up delay-2">
            <div class="card-header">
                <h2 style="font-size:15px; font-weight:700; color:#1a1d23; margin:0 0 2px;">Votre candidature</h2>
                <p style="font-size:13px; color:#6b7280; margin:0;">Complétez les informations ci-dessous pour finaliser votre dossier.</p>
            </div>

            {{ form_start(form, {'attr': {'data-turbo': 'false'}}) }}

                {# Global Errors #}
                {% if form.vars.errors|length > 0 %}
                    <div style="padding:20px 24px; border-bottom:1px solid #f1f3f5;">
                        <div class="notice error">
                            <svg width="18" height="18" fill="none" stroke="#ef4444" viewBox="0 0 24 24" style="flex-shrink:0;margin-top:1px;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            <div>
                                <p style="font-size:13px; font-weight:700; color:#991b1b; margin:0 0 4px;">Veuillez corriger les erreurs suivantes</p>
                                <div style="font-size:13px; color:#b91c1c;">{{ form_errors(form) }}</div>
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# Pre-filled Info Notice #}
                <div style="padding:20px 24px; border-bottom:1px solid #f1f3f5;">
                    <div class="notice info">
                        <div style="width:34px; height:34px; border-radius:8px; background:#145EB7; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                            <svg width="15" height="15" fill="none" stroke="#fff" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        </div>
                        <div>
                            <p style="font-size:13px; font-weight:700; color:#1e3a8a; margin:0 0 3px;">Informations pré-remplies</p>
                            <p style="font-size:12px; color:#0d3d6f; margin:0; line-height:1.5;">
                                Votre nom (<strong>{{ app.user.firstName|default('') }} {{ app.user.lastName|default('') }}</strong>) et votre email (<strong>{{ app.user.email }}</strong>) seront transmis automatiquement au recruteur.
                            </p>
                        </div>
                    </div>
                </div>

                {# CV Upload #}
                <div style="padding:24px; border-bottom:1px solid #f1f3f5;">
                    <div class="field-label">
                        <div class="field-label-icon" style="background:#d0edfd;">
                            <svg width="14" height="14" fill="none" stroke="#0d3d6f" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4"/></svg>
                        </div>
                        <h3 style="font-size:14px; font-weight:700; color:#1a1d23; margin:0;">CV <span style="color:#ef4444;">*</span></h3>
                    </div>
                    <div class="upload-zone" id="cv-zone">
                        {{ form_widget(form.cvFile) }}
                        <div style="pointer-events:none;">
                            <div class="upload-icon">
                                <svg width="22" height="22" fill="none" stroke="#9ca3af" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                            </div>
                            <p style="font-size:14px; font-weight:600; color:#374151; margin:0 0 4px;" id="cv-label">Glissez votre CV ici ou cliquez pour parcourir</p>
                            <p style="font-size:12px; color:#9ca3af; margin:0;">PDF, DOC, DOCX — max 5 Mo</p>
                        </div>
                    </div>
                    {% if form.cvFile.vars.errors|length > 0 %}
                        <p class="error-msg">
                            <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            {{ form_errors(form.cvFile) }}
                        </p>
                    {% endif %}
                </div>

                {# Cover Letter Upload #}
                <div style="padding:24px; border-bottom:1px solid #f1f3f5;">
                    <div class="field-label">
                        <div class="field-label-icon" style="background:#d0edfd;">
                            <svg width="14" height="14" fill="none" stroke="#0d3d6f" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        </div>
                        <h3 style="font-size:14px; font-weight:700; color:#1a1d23; margin:0;">
                            Lettre de motivation
                            <span style="font-size:12px; font-weight:400; color:#9ca3af;">(optionnel)</span>
                        </h3>
                    </div>
                    <div class="upload-zone" id="cl-zone">
                        {{ form_widget(form.coverLetterFile) }}
                        <div style="pointer-events:none;">
                            <div class="upload-icon">
                                <svg width="22" height="22" fill="none" stroke="#9ca3af" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                            </div>
                            <p style="font-size:14px; font-weight:600; color:#374151; margin:0 0 4px;" id="cl-label">Joindre une lettre de motivation</p>
                            <p style="font-size:12px; color:#9ca3af; margin:0;">Fortement recommandé — augmente vos chances</p>
                        </div>
                    </div>
                    {% if form.coverLetterFile.vars.errors|length > 0 %}
                        <p class="error-msg">{{ form_errors(form.coverLetterFile) }}</p>
                    {% endif %}
                </div>

                {# Notes #}
                <div style="padding:24px; border-bottom:1px solid #f1f3f5;">
                    <div class="field-label">
                        <div class="field-label-icon" style="background:#ede9fe;">
                            <svg width="14" height="14" fill="none" stroke="#6d28d9" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        </div>
                        <h3 style="font-size:14px; font-weight:700; color:#1a1d23; margin:0;">
                            Message au recruteur
                            <span style="font-size:12px; font-weight:400; color:#9ca3af;">(optionnel)</span>
                        </h3>
                    </div>
                    {{ form_widget(form.notes, {
                        'attr': {
                            'rows': 4,
                            'placeholder': 'Partagez votre motivation, vos expériences pertinentes, ou toute autre information utile...'
                        }
                    }) }}
                    {% if form.notes.vars.errors|length > 0 %}
                        <p class="error-msg">{{ form_errors(form.notes) }}</p>
                    {% endif %}
                </div>

                {# Actions #}
                <div style="padding:18px 24px; background:#fafbfc; display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px;">
                    <span style="font-size:12px; color:#9ca3af; display:flex; align-items:center; gap:6px;">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                        Données traitées en toute confidentialité.
                    </span>
                    <div style="display:flex; align-items:center; gap:10px;">
                        <a href="{{ path('app_candidate_job_offers') }}" class="btn-ghost">Annuler</a>
                        <button type="submit" class="btn-primary">
                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            Envoyer ma candidature
                        </button>
                    </div>
                </div>

            {{ form_end(form) }}
        </div>
    </main>
</div>

<script>
document.querySelectorAll('.upload-zone').forEach(zone => {
    const input = zone.querySelector('input[type="file"]');
    const label = zone.querySelector('p');
    if (!input || !label) return;
    input.addEventListener('change', function () {
        if (this.files.length && label) {
            label.textContent = this.files[0].name;
            zone.classList.add('has-file');
        }
    });
    zone.addEventListener('dragover', e => { e.preventDefault(); zone.style.borderColor = '#145EB7'; });
    zone.addEventListener('dragleave', () => { if (!zone.classList.contains('has-file')) zone.style.borderColor = ''; });
    zone.addEventListener('drop', e => {
        e.preventDefault();
        if (e.dataTransfer.files.length) {
            input.files = e.dataTransfer.files;
            label.textContent = e.dataTransfer.files[0].name;
            zone.classList.add('has-file');
        }
    });
});
</script>
{% endblock %}
