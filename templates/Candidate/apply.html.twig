{% extends 'base.html.twig' %}

{% block title %}Postuler – {{ jobOffer.title }} | HrFlow{% endblock %}

{% block stylesheets %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }
        .fade-up { animation: fadeUp 0.35s ease-out both; }
        .fade-up-2 { animation-delay: 0.08s; }
        .fade-up-3 { animation-delay: 0.16s; }
        .file-zone:hover { border-color: #10b981; background-color: #f0fdf4; }
        .file-zone input[type="file"] { position:absolute; inset:0; opacity:0; cursor:pointer; }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8fafc] antialiased overflow-x-hidden">
    {% include 'Candidate/components/_header.html.twig' %}

    <main class="w-full p-6 lg:p-8 max-w-[900px] mx-auto">

                {# Breadcrumb #}
                <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6 fade-up">
                    <a href="{{ path('app_candidate_job_offers') }}" class="hover:text-emerald-600 font-medium transition-colors">Offres d'emploi</a>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    <span class="text-slate-600 font-semibold truncate">{{ jobOffer.title }}</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    <span class="text-slate-900 font-bold">Postuler</span>
                </nav>

                {# Step Indicator #}
                <div class="flex items-center gap-0 mb-8 fade-up">
                    {% for step in [
                        { n: '1', label: 'Offre sélectionnée' },
                        { n: '2', label: 'Documents' },
                        { n: '3', label: 'Confirmation' }
                    ] %}
                        <div class="flex items-center {{ not loop.last ? 'flex-1' : '' }}">
                            <div class="flex flex-col items-center">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold
                                    {{ loop.index == 1 ? 'bg-emerald-500 text-white shadow-md shadow-emerald-500/30' :
                                       loop.index == 2 ? 'bg-emerald-600 text-white shadow-md shadow-emerald-500/30' :
                                       'bg-slate-100 text-slate-400' }}">
                                    {{ loop.index < 3 ? '✓' : step.n }}
                                </div>
                                <span class="text-[10px] font-semibold mt-1.5 whitespace-nowrap {{ loop.index <= 2 ? 'text-emerald-600' : 'text-slate-400' }}">{{ step.label }}</span>
                            </div>
                            {% if not loop.last %}
                                <div class="flex-1 h-0.5 mx-3 mb-5 {{ loop.index < 2 ? 'bg-emerald-400' : 'bg-slate-200' }} rounded-full"></div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                {# Job Summary Card #}
                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5 mb-6 fade-up fade-up-2">
                    <div class="flex items-start gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/20 shrink-0">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div>
                                    <h1 class="text-xl font-bold text-slate-900">{{ jobOffer.title }}</h1>
                                    <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 mt-1.5">
                                        {% if jobOffer.department %}
                                            <span class="inline-flex items-center gap-1.5">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"/></svg>
                                                {{ jobOffer.department }}
                                            </span>
                                        {% endif %}
                                        {% if jobOffer.location %}
                                            <span class="inline-flex items-center gap-1.5">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>
                                                {{ jobOffer.location }}
                                            </span>
                                        {% endif %}
                                        {% if jobOffer.employmentType %}
                                            <span class="px-2 py-0.5 rounded-lg bg-blue-50 text-blue-700 font-bold border border-blue-100">{{ jobOffer.employmentType|upper }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-emerald-50 border border-emerald-100 text-xs font-bold text-emerald-700">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                                    Poste sélectionné
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                {# Application Form #}
                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden fade-up fade-up-3">
                    <div class="px-6 py-5 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
                        <h2 class="text-base font-bold text-slate-900">Votre candidature</h2>
                        <p class="text-sm text-slate-500 mt-0.5">Complétez les informations ci-dessous pour finaliser votre dossier.</p>
                    </div>

                    {{ form_start(form, {'attr': {'class': 'divide-y divide-slate-100', 'data-turbo': 'false'}}) }}

                        {# Global Errors #}
                        {% if form.vars.errors|length > 0 %}
                            <div class="p-5">
                                <div class="flex items-start gap-3 p-4 rounded-xl bg-red-50 border border-red-100">
                                    <svg class="w-5 h-5 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    <div>
                                        <p class="text-sm font-bold text-red-800 mb-1">Veuillez corriger les erreurs suivantes</p>
                                        <div class="text-sm text-red-700">{{ form_errors(form) }}</div>
                                    </div>
                                </div>
                            </div>
                        {% endif %}

                        {# Pre-filled Info Notice #}
                        <div class="p-6">
                            <div class="flex items-start gap-4 p-4 rounded-xl bg-blue-50 border border-blue-100">
                                <div class="w-9 h-9 rounded-xl bg-blue-500 flex items-center justify-center shrink-0">
                                    <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-blue-900">Informations pré-remplies</p>
                                    <p class="text-xs text-blue-700 mt-1 leading-relaxed">
                                        Votre nom (<strong>{{ app.user.firstName|default('') }} {{ app.user.lastName|default('') }}</strong>) et votre email
                                        (<strong>{{ app.user.email }}</strong>) seront transmis automatiquement au recruteur.
                                    </p>
                                </div>
                            </div>
                        </div>

                        {# CV Upload #}
                        <div class="p-6">
                            <div class="flex items-center gap-2 mb-4">
                                <div class="w-7 h-7 rounded-lg bg-emerald-100 flex items-center justify-center">
                                    <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4"/></svg>
                                </div>
                                <h3 class="text-sm font-bold text-slate-900">CV <span class="text-red-500">*</span></h3>
                            </div>

                            <div class="relative file-zone border-2 border-dashed border-slate-200 rounded-2xl p-8 text-center transition-all duration-200 bg-slate-50 overflow-hidden">
                                {{ form_widget(form.cvFile, {'attr': {'class': 'sr-only'}}) }}
                                <div class="pointer-events-none">
                                    <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 shadow-sm flex items-center justify-center mx-auto mb-3">
                                        <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                                    </div>
                                    <p class="text-sm font-semibold text-slate-700 mb-1">Glissez votre CV ici ou cliquez pour parcourir</p>
                                    <p class="text-xs text-slate-400">PDF, DOC, DOCX — max 5 Mo</p>
                                </div>
                            </div>
                            {% if form.cvFile.vars.errors|length > 0 %}
                                <p class="mt-2 text-xs font-semibold text-red-600 flex items-center gap-1">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    {{ form_errors(form.cvFile) }}
                                </p>
                            {% endif %}
                        </div>

                        {# Cover Letter Upload #}
                        <div class="p-6">
                            <div class="flex items-center gap-2 mb-4">
                                <div class="w-7 h-7 rounded-lg bg-blue-100 flex items-center justify-center">
                                    <svg class="w-3.5 h-3.5 text-blue-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                                </div>
                                <h3 class="text-sm font-bold text-slate-900">Lettre de motivation <span class="text-xs font-medium text-slate-400">(optionnel)</span></h3>
                            </div>

                            <div class="relative file-zone border-2 border-dashed border-slate-200 rounded-2xl p-8 text-center transition-all duration-200 bg-slate-50 overflow-hidden">
                                {{ form_widget(form.coverLetterFile, {'attr': {'class': 'sr-only'}}) }}
                                <div class="pointer-events-none">
                                    <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 shadow-sm flex items-center justify-center mx-auto mb-3">
                                        <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                                    </div>
                                    <p class="text-sm font-semibold text-slate-700 mb-1">Joindre une lettre de motivation</p>
                                    <p class="text-xs text-slate-400">Fortement recommandé — augmente vos chances</p>
                                </div>
                            </div>
                            {% if form.coverLetterFile.vars.errors|length > 0 %}
                                <p class="mt-2 text-xs font-semibold text-red-600">{{ form_errors(form.coverLetterFile) }}</p>
                            {% endif %}
                        </div>

                        {# Notes Section #}
                        <div class="p-6">
                            <div class="flex items-center gap-2 mb-3">
                                <div class="w-7 h-7 rounded-lg bg-violet-100 flex items-center justify-center">
                                    <svg class="w-3.5 h-3.5 text-violet-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                </div>
                                <h3 class="text-sm font-bold text-slate-900">Message au recruteur <span class="text-xs font-medium text-slate-400">(optionnel)</span></h3>
                            </div>
                            {{ form_widget(form.notes, {
                                'attr': {
                                    'class': 'w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-emerald-400 focus:ring-[3px] focus:ring-emerald-500/10 text-sm text-slate-800 placeholder-slate-400 outline-none transition-all resize-none',
                                    'rows': 4,
                                    'placeholder': 'Partagez votre motivation, vos expériences pertinentes, ou toute autre information utile...'
                                }
                            }) }}
                            {% if form.notes.vars.errors|length > 0 %}
                                <p class="mt-2 text-xs font-semibold text-red-600">{{ form_errors(form.notes) }}</p>
                            {% endif %}
                        </div>

                        {# Actions #}
                        <div class="px-6 py-5 bg-slate-50/60 flex flex-col sm:flex-row items-center justify-between gap-4">
                            <div class="flex items-center gap-2 text-xs text-slate-400">
                                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                Vos données sont traitées de manière confidentielle.
                            </div>
                            <div class="flex items-center gap-3 w-full sm:w-auto">
                                <a href="{{ path('app_candidate_job_offers') }}"
                                   class="flex-1 sm:flex-none px-5 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:bg-slate-200 border border-slate-200 bg-white transition-colors text-center">
                                    Annuler
                                </a>
                                <button type="submit"
                                        class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-7 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-bold transition-all shadow-md shadow-emerald-500/20 hover:shadow-lg hover:shadow-emerald-500/30 hover:scale-[1.01]">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    Envoyer ma candidature
                                </button>
                            </div>
                        </div>

                    {{ form_end(form) }}
                </div>
    </main>
</div>

<script>
// Update file zone label on file select
document.querySelectorAll('.file-zone input[type="file"]').forEach(input => {
    input.addEventListener('change', function() {
        const zone = this.closest('.file-zone');
        const label = zone.querySelector('p');
        if (this.files.length && label) {
            label.textContent = this.files[0].name;
            zone.style.borderColor = '#10b981';
            zone.style.backgroundColor = '#f0fdf4';
        }
    });
});
</script>
{% endblock %}
