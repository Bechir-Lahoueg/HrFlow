{% set user = app.user %}
{% set currentRoute = app.request.get('_route') %}

<header class="sticky top-0 z-30 bg-white border-b border-slate-200 shadow-sm">
    <div class="flex items-center justify-between px-6 h-16 gap-4">

        {# Left: Brand + Navigation #}
        <div class="flex items-center gap-6 min-w-0">
            <a href="{{ path('app_candidate_dashboard') }}" class="flex items-center gap-2 font-bold text-slate-900 no-underline shrink-0">
                <span class="inline-block w-8 h-8 rounded-xl bg-gradient-to-br from-formation-600 to-formation-500"></span>
                HrFlow
            </a>

            {% set navItems = [
                { route: 'app_candidate_dashboard', label: 'Dashboard' },
                { route: 'app_candidate_job_offers', label: "Offres" },
                { route: 'app_candidate_applications', label: 'Candidatures' },
                { route: 'app_candidate_interviews', label: 'Entretiens' },
                { route: 'app_candidate_profile', label: 'Profil' }
            ] %}

            <nav class="hidden lg:flex items-center gap-1 min-w-0">
                {% for item in navItems %}
                    {% set isActive = currentRoute == item.route %}
                    <a href="{{ path(item.route) }}"
                       class="px-3 py-2 rounded-lg text-sm font-semibold transition-colors
                              {{ isActive ? 'bg-formation-600 text-white' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' }}">
                        {{ item.label }}
                    </a>
                {% endfor %}
            </nav>

            <div class="relative lg:hidden" id="nav-dropdown">
                <button onclick="togglePanel('nav-panel')"
                        class="inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-semibold text-slate-600 hover:bg-slate-100 transition-colors">
                    Menu
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>
                <div id="nav-panel" class="hidden absolute left-0 top-full mt-2 w-56 bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden z-50">
                    <div class="p-1.5">
                        {% for item in navItems %}
                            {% set isActive = currentRoute == item.route %}
                            <a href="{{ path(item.route) }}"
                               class="flex items-center px-3 py-2.5 rounded-lg text-sm font-semibold transition-colors
                                      {{ isActive ? 'bg-formation-600 text-white' : 'text-slate-700 hover:bg-slate-50' }}">
                                {{ item.label }}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        {# Right: Search + Notifications + User #}
        <div class="flex items-center gap-2 shrink-0">

            {# Search Input #}
            <div class="hidden md:flex items-center gap-2.5 px-3.5 py-2 bg-slate-50 hover:bg-white rounded-xl w-64 border border-slate-200/80 hover:border-slate-300 focus-within:border-formation-400 focus-within:bg-white focus-within:shadow-[0_0_0_3px_rgba(20,94,183,0.08)] transition-all duration-200 cursor-text">
                <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
                </svg>
                <input type="text" placeholder="Rechercher..." class="bg-transparent text-sm text-slate-700 outline-none w-full placeholder-slate-400 min-w-0">
                <kbd class="hidden lg:inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded-md bg-slate-200/70 text-[10px] font-semibold text-slate-500 font-mono shrink-0">⌘K</kbd>
            </div>

            {# Notification Bell #}
            <div class="relative" id="notif-dropdown">
                <button onclick="togglePanel('notif-panel', 'user-panel')"
                        class="relative p-2.5 rounded-xl text-slate-500 hover:bg-slate-100 hover:text-slate-700 transition-all duration-150 group">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 005.454-1.31A8.967 8.967 0 0118 9.75v-.7V9A6 6 0 006 9v.75a8.967 8.967 0 01-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 01-5.714 0m5.714 0a3 3 0 11-5.714 0"/>
                    </svg>
                    {# Red dot #}
                    <span class="absolute top-2 right-2 w-2 h-2 bg-red-500 rounded-full ring-2 ring-white"></span>
                </button>

                {# Notifications Panel #}
                <div id="notif-panel"
                     class="hidden absolute right-0 top-full mt-2 w-80 bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden z-50">
                    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
                        <h3 class="text-sm font-bold text-slate-800">Notifications</h3>
                        <span class="px-2 py-0.5 rounded-full bg-red-500 text-white text-[10px] font-bold">2</span>
                    </div>
                    <div class="divide-y divide-slate-50 max-h-72 overflow-y-auto">
                        <a href="#" class="flex items-start gap-3 px-4 py-3.5 hover:bg-slate-50 transition-colors">
                            <div class="w-8 h-8 rounded-full bg-formation-100 flex items-center justify-center shrink-0 mt-0.5">
                                <svg class="w-4 h-4 text-formation-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-slate-800">Candidature acceptée</p>
                                <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">Votre candidature pour Développeur Web a été acceptée</p>
                                <p class="text-[10px] text-slate-400 mt-1 font-medium">Il y a 2 heures</p>
                            </div>
                        </a>
                        <a href="#" class="flex items-start gap-3 px-4 py-3.5 hover:bg-slate-50 transition-colors">
                            <div class="w-8 h-8 rounded-full bg-formation-100 flex items-center justify-center shrink-0 mt-0.5">
                                <svg class="w-4 h-4 text-formation-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-semibold text-slate-800">Entretien programmé</p>
                                <p class="text-xs text-slate-500 mt-0.5 leading-relaxed">Un entretien est prévu le 15 Avril à 14h</p>
                                <p class="text-[10px] text-slate-400 mt-1 font-medium">Il y a 5 heures</p>
                            </div>
                        </a>
                    </div>
                    <div class="px-4 py-3 border-t border-slate-100 bg-slate-50/60">
                        <a href="#" class="block text-center text-xs font-semibold text-formation-600 hover:text-formation-600 transition-colors">Voir toutes les notifications →</a>
                    </div>
                </div>
            </div>

            {# Divider #}
            <div class="w-px h-6 bg-slate-200 hidden sm:block mx-1"></div>

            {# User Menu #}
            <div class="relative" id="user-dropdown">
                <button onclick="togglePanel('user-panel', 'notif-panel')"
                        class="flex items-center gap-2.5 p-1.5 pr-3 rounded-xl hover:bg-slate-100 transition-all duration-150 group">
                    <div class="w-8 h-8 rounded-full bg-gradient-to-br from-formation-400 to-formation-500 flex items-center justify-center shadow-sm shadow-formation-400/30 shrink-0">
                        <span class="text-xs font-bold text-white leading-none">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</span>
                    </div>
                    <div class="hidden sm:block text-left">
                        <p class="text-[13px] font-semibold text-slate-800 leading-tight">{{ user.firstName|default(user.userIdentifier) }}</p>
                        <p class="text-[10px] text-formation-600 font-bold tracking-wide uppercase">Candidat</p>
                    </div>
                    <svg class="w-3.5 h-3.5 text-slate-400 hidden sm:block transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/>
                    </svg>
                </button>

                {# User Panel #}
                <div id="user-panel"
                     class="hidden absolute right-0 top-full mt-2 w-56 bg-white rounded-xl shadow-lg border border-slate-200 overflow-hidden z-50">
                    <div class="px-4 py-3.5 border-b border-slate-100 bg-gradient-to-br from-formation-50/60 to-formation-100/30">
                        <p class="text-sm font-bold text-slate-800 truncate">{{ user.firstName|default('') }} {{ user.lastName|default('') }}</p>
                        <p class="text-xs text-slate-500 mt-0.5 truncate">{{ user.email }}</p>
                    </div>
                    <div class="p-1.5">
                        <a href="{{ path('app_candidate_profile') }}"
                           class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            Mon profil
                        </a>
                        <a href="{{ path('app_candidate_applications') }}"
                           class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
                            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            Mes candidatures
                        </a>
                        <div class="h-px bg-slate-100 my-1 mx-1"></div>
                        <a href="{{ path('app_logout') }}"
                           class="flex items-center gap-2.5 px-3 py-2.5 rounded-xl text-sm font-medium text-red-600 hover:bg-red-50 transition-colors">
                            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            Déconnexion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
function togglePanel(showId, hideId) {
    const panels = ['nav-panel', 'notif-panel', 'user-panel'];

    if (hideId) {
        const hide = document.getElementById(hideId);
        if (hide) hide.classList.add('hidden');
    }

    panels.forEach(id => {
        if (id !== showId) {
            const el = document.getElementById(id);
            if (el) el.classList.add('hidden');
        }
    });

    const show = document.getElementById(showId);
    if (show) show.classList.toggle('hidden');
}
document.addEventListener('click', function(e) {
    const nav = document.getElementById('nav-dropdown');
    if (nav && !nav.contains(e.target)) {
        const navPanel = document.getElementById('nav-panel');
        if (navPanel) navPanel.classList.add('hidden');
    }

    const notif = document.getElementById('notif-dropdown');
    if (notif && !notif.contains(e.target)) {
        const notifPanel = document.getElementById('notif-panel');
        if (notifPanel) notifPanel.classList.add('hidden');
    }

    const user = document.getElementById('user-dropdown');
    if (user && !user.contains(e.target)) {
        const userPanel = document.getElementById('user-panel');
        if (userPanel) userPanel.classList.add('hidden');
    }
});
</script>
