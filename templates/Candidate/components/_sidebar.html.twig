{# Mobile overlay #}
<div id="sidebar-overlay"
     class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden lg:hidden"
     onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); this.classList.add('hidden');"></div>

<aside id="sidebar"
       class="fixed top-0 left-0 z-40 h-screen w-[220px] bg-white border-r border-slate-200 -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-out flex flex-col overflow-hidden shadow-lg">

    {# Logo #}
    <div class="flex items-center gap-3 px-5 h-16 border-b border-slate-100 shrink-0">
        <a href="{{ path('app_home') }}" class="flex items-center gap-3 group no-underline">
            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-md shadow-emerald-500/25 group-hover:shadow-emerald-500/40 transition-all duration-200 group-hover:scale-105 shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0v-2.25c0-1.094-.787-2.036-1.872-2.18-2.087-.277-4.216-.42-6.378-.42s-4.291.143-6.378.42c-1.085.144-1.872 1.086-1.872 2.18v2.25"/>
                </svg>
            </div>
            <div>
                <p class="text-[15px] font-bold text-slate-900 leading-none">HrFlow</p>
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-0.5">Candidat</p>
            </div>
        </a>
    </div>

    {# Navigation #}
    <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-4">

        {# Main Menu #}
        <div>
            <p class="px-3 mb-2 text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Menu</p>
            <div class="space-y-1">

                {% set navItems = [
                    {
                        route: 'app_candidate_dashboard',
                        label: 'Tableau de bord',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>'
                    },
                    {
                        route: 'app_candidate_job_offers',
                        label: "Offres d'emploi",
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0v-2.25c0-1.094-.787-2.036-1.872-2.18-2.087-.277-4.216-.42-6.378-.42s-4.291.143-6.378.42c-1.085.144-1.872 1.086-1.872 2.18v2.25"/>'
                    },
                    {
                        route: 'app_candidate_applications',
                        label: 'Mes candidatures',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>'
                    },
                    {
                        route: 'app_candidate_interviews',
                        label: 'Mes entretiens',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>'
                    }
                ] %}

                {% for item in navItems %}
                    {% set isActive = app.request.get('_route') == item.route %}
                    <a href="{{ path(item.route) }}"
                       class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors group
                              {{ isActive ? 'bg-emerald-600 text-white' : 'text-slate-600 hover:bg-slate-100' }}">
                        <svg class="w-5 h-5 shrink-0 {{ isActive ? 'text-white' : 'text-slate-400 group-hover:text-slate-600' }}"
                             fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            {{ item.icon|raw }}
                        </svg>
                        <span class="truncate">{{ item.label }}</span>
                    </a>
                {% endfor %}
            </div>
        </div>

        {# Account Section #}
        <div>
            <p class="px-3 mb-2 text-[11px] font-semibold text-slate-400 uppercase tracking-wide">Compte</p>
            <div class="space-y-1">
                {% set isProfileActive = app.request.get('_route') == 'app_candidate_profile' %}
                <a href="{{ path('app_candidate_profile') }}"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors group
                          {{ isProfileActive ? 'bg-emerald-600 text-white' : 'text-slate-600 hover:bg-slate-100' }}">
                    <svg class="w-5 h-5 shrink-0 {{ isProfileActive ? 'text-white' : 'text-slate-400 group-hover:text-slate-600' }}"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>
                    </svg>
                    Mon profil
                </a>

                <a href="{{ path('app_logout') }}"
                   class="flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium text-slate-500 hover:bg-red-50 hover:text-red-600 transition-colors group">
                    <svg class="w-5 h-5 shrink-0 text-slate-400 group-hover:text-red-500"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                    </svg>
                    Déconnexion
                </a>
            </div>
        </div>
    </nav>

    {# User Summary Footer #}
    <div class="px-3 py-3 border-t border-slate-100 shrink-0">
        <a href="{{ path('app_candidate_profile') }}" class="flex items-center gap-2 px-2 py-2 rounded-lg hover:bg-slate-100 transition-colors group">
            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-emerald-400 to-teal-500 flex items-center justify-center shrink-0">
                <span class="text-xs font-bold text-white">{{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}</span>
            </div>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-slate-700 truncate">{{ app.user.firstName|default('') }} {{ app.user.lastName|default('') }}</p>
                <p class="text-xs text-slate-400 truncate">{{ app.user.email }}</p>
            </div>
        </a>
    </div>
</aside>
