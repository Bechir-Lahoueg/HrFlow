{# ===== HERO SECTION — full-screen image background ===== #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
<style>
  @keyframes hero-badge-in {
    from { opacity:0; transform:translateY(-10px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes hero-title-in {
    from { opacity:0; transform:translateY(18px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes hero-sub-in {
    from { opacity:0; transform:translateY(12px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes hero-cta-in {
    from { opacity:0; transform:translateY(10px) scale(0.98); }
    to   { opacity:1; transform:translateY(0) scale(1); }
  }
  @keyframes hero-stats-in {
    from { opacity:0; transform:translateY(14px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes hero-card-in {
    from { opacity:0; transform:translateX(-14px); }
    to   { opacity:1; transform:translateX(0); }
  }
  @keyframes hero-card-in-r {
    from { opacity:0; transform:translateX(14px); }
    to   { opacity:1; transform:translateX(0); }
  }
  @keyframes hero-dot-blink {
    0%,100% { opacity:1; }
    50%     { opacity:0.35; }
  }
  @keyframes hero-bounce-down {
    0%,100% { transform:translateY(0); }
    50%     { transform:translateY(5px); }
  }

  .hero-badge   { animation: hero-badge-in  .5s cubic-bezier(.22,1,.36,1) .1s both; }
  .hero-title   { animation: hero-title-in  .65s cubic-bezier(.22,1,.36,1) .22s both; }
  .hero-sub     { animation: hero-sub-in    .65s cubic-bezier(.22,1,.36,1) .36s both; }
  .hero-cta     { animation: hero-cta-in    .65s cubic-bezier(.22,1,.36,1) .5s both; }
  .hero-stats   { animation: hero-stats-in  .75s cubic-bezier(.22,1,.36,1) .65s both; }
  .hero-card-l  { animation: hero-card-in   .7s cubic-bezier(.22,1,.36,1) .9s both; }
  .hero-card-r  { animation: hero-card-in-r .7s cubic-bezier(.22,1,.36,1) 1.05s both; }
  .hero-dot-blink { animation: hero-dot-blink 1.6s ease-in-out infinite; }
  .hero-scroll  { animation: hero-bounce-down 1.8s ease-in-out infinite; }

  .hero-glass-card {
    background: rgba(255,255,255,0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.88);
    box-shadow: 0 4px 24px rgba(2,46,105,0.10), 0 1px 4px rgba(2,46,105,0.06);
    transition: transform .25s, box-shadow .25s;
  }
  .hero-glass-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 40px rgba(2,46,105,0.16);
  }
  .hero-stat-card {
    background: rgba(255,255,255,0.68);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.92);
    box-shadow: 0 2px 16px rgba(2,46,105,0.08);
  }
  .hero-btn-secondary {
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.88);
    box-shadow: 0 2px 12px rgba(2,46,105,0.10);
    transition: background .2s, box-shadow .2s, transform .2s;
  }
  .hero-btn-secondary:hover {
    background: rgba(255,255,255,0.95);
    box-shadow: 0 6px 24px rgba(2,46,105,0.16);
    transform: translateY(-1px);
  }
</style>

{# Image hero choisie aléatoirement à chaque rechargement (la page est en no-store, donc re-rendue à chaque visite). #}
{% set heroImages = ['images/landingpage.png', 'images/Gemini_Generated_Image_fiil3mfiil3mfiil.png'] %}
{% set heroImage = random(heroImages) %}

<section class="relative overflow-hidden"
  style="height:min(100svh,780px);
         min-height:520px;
         background-image:url('{{ asset(heroImage) }}');
         background-size:cover;
         background-position:center bottom;
         background-repeat:no-repeat;
         background-color:#ffff;">

    {# ── Subtle navy-tinted overlay ── #}
    <div class="absolute inset-0 pointer-events-none"
         style="background:linear-gradient(to bottom,
           rgba(2,46,105,0.08) 0%,
           rgba(2,46,105,0.03) 38%,
           transparent 58%,
           rgba(20,94,183,0.06) 100%);"></div>

<div class="relative z-10 max-w-4xl mx-auto px-6 text-center flex flex-col items-center"
     style="padding-top:max(6rem,10vh); padding-bottom:30vh;">

    <h1 class="hero-title leading-[1.12] mb-5"
        style="font-family:'Playfair Display',Georgia,serif;
               font-size:clamp(2.6rem,5.8vw,5rem);
               font-weight:900;
               color:#022E69;
               letter-spacing:-0.01em;">
        Simplifiez vos RH<br>
        <span style="background:linear-gradient(90deg,#3FA9F5 0%,#145EB7 100%);
                     -webkit-background-clip:text;
                     -webkit-text-fill-color:transparent;
                     background-clip:text;">
            Libérez vos Talents
        </span>
    </h1>

</div>

    {# ── Scroll indicator ── #}
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 z-10">
        <span class="text-[9px] uppercase tracking-[.18em] font-semibold"
              style="color:rgba(2,46,105,0.40);">Défiler</span>
        <svg class="hero-scroll w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
             style="color:rgba(20,94,183,0.45);">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </div>
</section>
