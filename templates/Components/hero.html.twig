{# ===== HERO SECTION — full-screen image background ===== #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
<style>
  @keyframes hero-badge-in {
    from { opacity:0; transform:translateY(-10px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes hero-title-in {
    from { opacity:0; transform:translateY(18px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes hero-sub-in {
    from { opacity:0; transform:translateY(12px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes hero-cta-in {
    from { opacity:0; transform:translateY(10px) scale(0.98); }
    to   { opacity:1; transform:translateY(0) scale(1); }
  }
  @keyframes hero-stats-in {
    from { opacity:0; transform:translateY(14px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @keyframes hero-card-in {
    from { opacity:0; transform:translateX(-14px); }
    to   { opacity:1; transform:translateX(0); }
  }
  @keyframes hero-card-in-r {
    from { opacity:0; transform:translateX(14px); }
    to   { opacity:1; transform:translateX(0); }
  }
  @keyframes hero-dot-blink {
    0%,100% { opacity:1; }
    50%     { opacity:0.35; }
  }
  @keyframes hero-bounce-down {
    0%,100% { transform:translateY(0); }
    50%     { transform:translateY(5px); }
  }

  .hero-badge   { animation: hero-badge-in  .5s cubic-bezier(.22,1,.36,1) .1s both; }
  .hero-title   { animation: hero-title-in  .65s cubic-bezier(.22,1,.36,1) .22s both; }
  .hero-sub     { animation: hero-sub-in    .65s cubic-bezier(.22,1,.36,1) .36s both; }
  .hero-cta     { animation: hero-cta-in    .65s cubic-bezier(.22,1,.36,1) .5s both; }
  .hero-stats   { animation: hero-stats-in  .75s cubic-bezier(.22,1,.36,1) .65s both; }
  .hero-card-l  { animation: hero-card-in   .7s cubic-bezier(.22,1,.36,1) .9s both; }
  .hero-card-r  { animation: hero-card-in-r .7s cubic-bezier(.22,1,.36,1) 1.05s both; }
  .hero-dot-blink { animation: hero-dot-blink 1.6s ease-in-out infinite; }
  .hero-scroll  { animation: hero-bounce-down 1.8s ease-in-out infinite; }

  .hero-glass-card {
    background: rgba(255,255,255,0.72);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255,255,255,0.88);
    box-shadow: 0 4px 24px rgba(0,0,0,0.08), 0 1px 4px rgba(0,0,0,0.05);
    transition: transform .25s, box-shadow .25s;
  }
  .hero-glass-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 40px rgba(0,0,0,0.12);
  }
  .hero-stat-card {
    background: rgba(255,255,255,0.68);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.92);
    box-shadow: 0 2px 16px rgba(0,0,0,0.07);
  }
  .hero-btn-secondary {
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.88);
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    transition: background .2s, box-shadow .2s, transform .2s;
  }
  .hero-btn-secondary:hover {
    background: rgba(255,255,255,0.95);
    box-shadow: 0 6px 24px rgba(0,0,0,0.12);
    transform: translateY(-1px);
  }
</style>

<section class="relative overflow-hidden"
  style="height:min(100vh,780px);
         background-image:url('{{ asset('images/Gemini_Generated_Image_fiil3mfiil3mfiil.png') }}');
         background-size:contain;
         background-position:center bottom;
         background-repeat:no-repeat;
         background-color:#f5f0e8;">

    {# ── Subtle warm overlay ── #}
    <div class="absolute inset-0 pointer-events-none"
         style="background:linear-gradient(to bottom,
           rgba(255,252,248,0.22) 0%,
           rgba(255,252,248,0.06) 38%,
           transparent 58%,
           rgba(210,225,215,0.12) 100%);"></div>

    {# ── Floating card — left ── #}
    <div class="hero-card-l absolute pointer-events-none hidden lg:block" style="top:32%;left:3%;">
        <div class="hero-glass-card flex items-center gap-3 px-4 py-3 rounded-2xl">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
                 style="background:linear-gradient(135deg,#059669,#0d9488);">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <div>
                <p class="text-[10px] text-slate-500 leading-none mb-1 font-medium">Collaborateurs actifs</p>
                <p class="text-[15px] font-black text-slate-900 leading-none">2 400+</p>
            </div>
        </div>
    </div>

    {# ── Floating card — right ── #}
    <div class="hero-card-r absolute pointer-events-none hidden lg:block" style="top:38%;right:3%;">
        <div class="hero-glass-card flex items-center gap-3 px-4 py-3 rounded-2xl">
            <div class="w-9 h-9 rounded-xl flex items-center justify-center flex-shrink-0"
                 style="background:linear-gradient(135deg,#7c3aed,#4f46e5);">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
            </div>
            <div>
                <p class="text-[10px] text-slate-500 leading-none mb-1 font-medium">Paie à temps</p>
                <p class="text-[15px] font-black text-slate-900 leading-none">98,6 % <span class="text-emerald-600 text-[11px] font-bold">↑</span></p>
            </div>
        </div>
    </div>

    {# ── Main content — positioned in the sky/upper area of the illustration ── #}
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center flex flex-col items-center"
         style="padding-top:max(4rem,8vh); padding-bottom:30vh;">



        {# Heading #}
        <h1 class="hero-title leading-[1.12] mb-5"
            style="font-family:'Playfair Display',Georgia,serif;
                   font-size:clamp(2.6rem,5.8vw,5rem);
                   font-weight:900;
                   color:#1a1209;
                   letter-spacing:-0.01em;">
            Simplifiez vos RH.<br>
            Libérez vos Talents.
        </h1>



    </div>

    {# ── Scroll indicator ── #}
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 z-10">
        <span class="text-[9px] uppercase tracking-[.18em] font-semibold text-slate-500/55">Défiler</span>
        <svg class="hero-scroll w-4 h-4 text-slate-400/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
    </div>
</section>

