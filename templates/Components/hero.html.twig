{# ===== HERO SECTION ===== #}
<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden">
    {# Background decorations #}
    <div class="absolute inset-0 -z-10">
        <div class="absolute top-20 left-[10%] w-72 h-72 bg-teal-200/30 rounded-full blur-3xl"></div>
        <div class="absolute top-40 right-[10%] w-80 h-80 bg-orange-200/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-teal-100/20 rounded-full blur-3xl"></div>
    </div>

    <div class="max-w-7xl mx-auto px-6 text-center">
        {# Badge #}
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border border-slate-200 shadow-sm mb-8">
            <span class="px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider text-white bg-teal-600 rounded-full">New</span>
            <span class="text-sm font-medium text-slate-600">HR Management for All Your Employees</span>
        </div>

        {# Heading #}
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold text-slate-900 leading-[1.08] mb-6 tracking-tight">
            <span class="bg-gradient-to-r from-teal-600 to-emerald-500 bg-clip-text text-transparent">Simplify HR.</span>
            <br>
            Empower Your Workforce
        </h1>

        {# Subtitle #}
        <p class="text-lg sm:text-xl text-slate-500 max-w-2xl mx-auto mb-10 leading-relaxed">
            Manage payroll, recruitment, leaves, and employee relations seamlessly with our intuitive HR dashboard.
        </p>

        {# CTA buttons #}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-20">
            <a href="{{ path('app_login') }}"
               class="group px-8 py-4 text-base font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-full transition-all hover:shadow-xl hover:shadow-slate-900/20 flex items-center gap-2">
                Get Started
                <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="#how-it-works" class="px-8 py-4 text-base font-bold text-slate-700 bg-white border border-slate-200 hover:border-slate-300 rounded-full transition-all hover:shadow-lg">
                See how it works
            </a>
        </div>

        {# Dashboard preview #}
        <div class="relative max-w-5xl mx-auto">
            <div class="absolute -inset-4 bg-gradient-to-b from-teal-500/10 to-transparent rounded-3xl blur-2xl"></div>
            <div class="relative bg-white rounded-2xl border border-slate-200 shadow-2xl overflow-hidden">
                {# Browser bar #}
                <div class="flex items-center gap-2 px-5 py-3.5 border-b border-slate-100 bg-slate-50/50">
                    <div class="flex gap-1.5">
                        <div class="w-3 h-3 rounded-full bg-red-400"></div>
                        <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                        <div class="w-3 h-3 rounded-full bg-emerald-400"></div>
                    </div>
                    <div class="flex-1 mx-4">
                        <div class="max-w-md mx-auto px-4 py-1.5 bg-white rounded-lg border border-slate-200 text-xs text-slate-400 text-center">hrflow.com/dashboard</div>
                    </div>
                </div>
                {# Mock dashboard content #}
                <div class="p-6 lg:p-8">
                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                        <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                            <div class="w-8 h-8 rounded-lg bg-teal-100 flex items-center justify-center mb-3">
                                <svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                            </div>
                            <p class="text-xl font-extrabold text-slate-800">2,847</p>
                            <p class="text-xs text-slate-400 mt-0.5">Total Employees</p>
                        </div>
                        <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                            <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center mb-3">
                                <svg class="w-4 h-4 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <p class="text-xl font-extrabold text-slate-800">42</p>
                            <p class="text-xs text-slate-400 mt-0.5">Pending Leaves</p>
                        </div>
                        <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                            <div class="w-8 h-8 rounded-lg bg-purple-100 flex items-center justify-center mb-3">
                                <svg class="w-4 h-4 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            </div>
                            <p class="text-xl font-extrabold text-slate-800">18</p>
                            <p class="text-xs text-slate-400 mt-0.5">Open Positions</p>
                        </div>
                        <div class="bg-slate-50 rounded-xl p-4 border border-slate-100">
                            <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center mb-3">
                                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <p class="text-xl font-extrabold text-slate-800">96%</p>
                            <p class="text-xs text-slate-400 mt-0.5">Satisfaction</p>
                        </div>
                    </div>
                    {# Chart placeholder #}
                    <div class="bg-slate-50 rounded-xl p-5 border border-slate-100">
                        <div class="flex items-center justify-between mb-4">
                            <p class="text-sm font-bold text-slate-700">Employee Overview</p>
                            <div class="flex gap-2">
                                <span class="px-3 py-1 text-xs font-semibold bg-slate-900 text-white rounded-full">Monthly</span>
                                <span class="px-3 py-1 text-xs font-semibold text-slate-400 rounded-full">Yearly</span>
                            </div>
                        </div>
                        <div class="flex items-end gap-2 h-32">
                            {% for h in [40, 65, 50, 80, 60, 90, 75, 85, 55, 95, 70, 88] %}
                                <div class="flex-1 rounded-t-md bg-gradient-to-t from-teal-500 to-teal-400 opacity-80 hover:opacity-100 transition-opacity" style="height: {{ h }}%"></div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
