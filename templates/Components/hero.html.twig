{# ===== HERO SECTION ===== #}
<section class="relative min-h-screen overflow-hidden bg-slate-950">
    {# Video background (dark fallback behind it so text stays readable before/if the video loads) #}
    <div class="absolute inset-0 -z-20 bg-gradient-to-br from-slate-900 via-slate-950 to-emerald-950">
        <video id="hero-bg-video"
               class="h-full w-full object-cover opacity-0 transition-opacity duration-700"
               autoplay muted loop playsinline webkit-playsinline
               preload="auto"
               disablepictureinpicture
               aria-hidden="true">
            <source src="{{ asset('7640702-hd_1920_1080_25fps.mp4') }}" type="video/mp4">
        </video>
    </div>

    <script>
        (function () {
            function initHeroVideo() {
                var v = document.getElementById('hero-bg-video');
                if (!v) return;
                v.classList.add('opacity-0');
                v.muted = true;
                v.defaultMuted = true;
                v.setAttribute('muted', '');

                var revealed = false;
                var reveal = function () {
                    if (revealed) return;
                    revealed = true;
                    v.classList.remove('opacity-0');
                };

                // Cover all states: already loaded, about to load, or playing
                v.addEventListener('playing',      reveal, { once: true });
                v.addEventListener('canplay',      reveal, { once: true });
                v.addEventListener('loadeddata',   reveal, { once: true });

                // If the browser already has data (cached), reveal immediately
                if (v.readyState >= 2) { reveal(); }

                v.addEventListener('error', function () {
                    // Video failed to load — reveal anyway so the gradient fallback shows
                    reveal();
                }, { once: true });

                var tryPlay = function () {
                    var p = v.play();
                    if (p && typeof p.catch === 'function') {
                        p.catch(function () {
                            // Autoplay blocked: show the first frame / fallback and retry on user gesture
                            reveal();
                            var resume = function () {
                                v.play().catch(function () {});
                                ['click', 'touchstart', 'scroll', 'keydown'].forEach(function (ev) {
                                    document.removeEventListener(ev, resume);
                                });
                            };
                            ['click', 'touchstart', 'scroll', 'keydown'].forEach(function (ev) {
                                document.addEventListener(ev, resume, { once: true, passive: true });
                            });
                        });
                    }
                };

                if (document.readyState === 'complete' || document.readyState === 'interactive') {
                    tryPlay();
                } else {
                    document.addEventListener('DOMContentLoaded', tryPlay, { once: true });
                }
            }

            initHeroVideo();

            if (!document.__heroVideoTurboSetup) {
                document.__heroVideoTurboSetup = true;
                document.addEventListener('turbo:load', initHeroVideo);
            }
        })();
    </script>

    {# Lighter cinematic veil so the video remains vibrant across dark frames #}
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-slate-900/45 via-slate-900/35 to-slate-950/50"></div>

    {# Blooming ambient lights #}
    <div class="absolute inset-0 -z-10 pointer-events-none">
        <div class="mesh-blob absolute top-16 left-[8%] w-80 h-80 bg-teal-300/25 rounded-full blur-3xl"></div>
        <div class="mesh-blob-alt absolute top-28 right-[10%] w-96 h-96 bg-emerald-300/25 rounded-full blur-3xl"></div>
        <div class="mesh-blob absolute -bottom-24 left-1/3 w-[28rem] h-[28rem] bg-cyan-200/20 rounded-full blur-3xl"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_30%,rgba(255,255,255,0.14),transparent_60%)]"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-6 text-center min-h-screen flex flex-col items-center justify-center pt-28 pb-12">
        {# Badge #}
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/15 border border-white/30 shadow-sm mb-8 backdrop-blur">
            <span class="px-2 py-0.5 text-[11px] font-bold uppercase tracking-wider text-slate-900 bg-white rounded-full">New</span>
            <span class="text-sm font-medium text-white">HR Management for All Your Employees</span>
        </div>

        {# Heading #}
        <h1 class="text-4xl sm:text-5xl lg:text-7xl font-extrabold text-white leading-[1.08] mb-6 tracking-tight drop-shadow-[0_8px_24px_rgba(2,6,23,0.55)]">
            <span class="bg-gradient-to-r from-teal-200 to-emerald-100 bg-clip-text text-transparent">Simplify HR.</span>
            <br>
            Empower Your Workforce
        </h1>

        {# Subtitle #}
        <p class="text-lg sm:text-xl text-white/95 max-w-2xl mx-auto mb-10 leading-relaxed">
            Manage payroll, recruitment, leaves, and employee relations seamlessly with our intuitive HR dashboard.
        </p>

        {# CTA buttons #}
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10 lg:mb-12">
            <a href="{{ path('app_login') }}"
               class="group px-8 py-4 text-base font-bold text-slate-900 bg-white hover:bg-slate-100 rounded-full transition-all hover:shadow-xl hover:shadow-slate-900/20 flex items-center gap-2">
                Get Started
                <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </a>

            <a href="#how-it-works"
               class="px-8 py-4 text-base font-bold text-white bg-white/15 border border-white/35 hover:bg-white/25 rounded-full transition-all hover:shadow-lg backdrop-blur">
                See how it works
            </a>
        </div>
    </div>
</section>