<header id="siteHeader" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
        {# Brand #}
        <a href="{{ path('app_home') }}" class="flex items-center gap-2.5 no-underline">
            <img src="{{ asset('logo.png') }}" alt="HrFlow logo" class="w-9 h-9 rounded-lg object-cover scale-[3] origin-left">
        </a>

        {# Desktop nav #}
        <nav class="hidden md:flex items-center gap-1">
            <a href="#features" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100 transition-colors">Features</a>
            <a href="#how-it-works" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100 transition-colors">How it works</a>
            <a href="#testimonials" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100 transition-colors">Testimonials</a>
            <a href="#contact" class="px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100 transition-colors">Contact</a>
        </nav>

        {# Desktop CTA #}
        <div class="hidden md:flex items-center gap-3">
            <a href="{{ path('app_login') }}" class="px-4 py-2 text-sm font-semibold text-slate-700 hover:text-slate-900 transition-colors">Sign in</a>
            <a href="{{ path('app_login') }}" class="px-5 py-2.5 text-sm font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-full transition-all hover:shadow-lg">
                Sign up for free
            </a>
        </div>

        {# Mobile hamburger #}
        <button id="navToggle" class="md:hidden p-2 rounded-lg hover:bg-slate-100 transition-colors" aria-label="Toggle menu">
            <svg class="w-6 h-6 text-slate-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path id="hamburgerIcon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
        </button>
    </div>

    {# Mobile menu #}
    <div id="mobileMenu" class="md:hidden hidden bg-white border-t border-slate-100 shadow-xl">
        <div class="px-6 py-4 space-y-1">
            <a href="#features" class="block px-4 py-3 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-xl transition-colors" onclick="closeMobileMenu()">Features</a>
            <a href="#how-it-works" class="block px-4 py-3 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-xl transition-colors" onclick="closeMobileMenu()">How it works</a>
            <a href="#testimonials" class="block px-4 py-3 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-xl transition-colors" onclick="closeMobileMenu()">Testimonials</a>
            <a href="#contact" class="block px-4 py-3 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-xl transition-colors" onclick="closeMobileMenu()">Contact</a>
            <div class="pt-3 mt-3 border-t border-slate-100 space-y-2">
                <a href="{{ path('app_login') }}" class="block px-4 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 rounded-xl transition-colors">Sign in</a>
                <a href="{{ path('app_login') }}" class="block px-4 py-3 text-sm font-bold text-white text-center bg-slate-900 rounded-full">Sign up for free</a>
            </div>
        </div>
    </div>
</header>

<script>
(function() {
    const toggle = document.getElementById('navToggle');
    const menu = document.getElementById('mobileMenu');
    const header = document.getElementById('siteHeader');
    let open = false;

    toggle.addEventListener('click', function() {
        open = !open;
        menu.classList.toggle('hidden', !open);
        document.body.style.overflow = open ? 'hidden' : '';
    });

    window.closeMobileMenu = function() {
        open = false;
        menu.classList.add('hidden');
        document.body.style.overflow = '';
    };

    window.addEventListener('scroll', function() {
        if (window.scrollY > 40) {
            header.classList.add('bg-white/80', 'backdrop-blur-xl', 'shadow-sm', 'border-b', 'border-slate-200/60');
        } else {
            header.classList.remove('bg-white/80', 'backdrop-blur-xl', 'shadow-sm', 'border-b', 'border-slate-200/60');
        }
    });
})();
</script>
