{# ──────────────────────────────────────────────────────────────────────────
   Modale de confirmation accessible (focus trap, ESC, ARIA).
   Inclus une seule fois dans base.html.twig.
   Activée pour tout élément portant `data-confirm="..."`.
   Câblée par assets/js/accessibility/confirm-dialog.js
   ────────────────────────────────────────────────────────────────────────── #}
<div id="a11y-confirm-dialog"
     class="a11y-confirm-backdrop"
     role="dialog"
     aria-modal="true"
     aria-labelledby="a11y-confirm-title"
     aria-describedby="a11y-confirm-message"
     hidden>
    <div class="a11y-confirm-dialog" data-variant="danger">
        <h2 id="a11y-confirm-title" class="a11y-confirm-title" data-role="title">
            <svg width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
            </svg>
            <span>Confirmer l'action</span>
        </h2>
        <p id="a11y-confirm-message" class="a11y-confirm-message" data-role="message">
            Voulez-vous confirmer cette action ?
        </p>
        <div class="a11y-confirm-actions">
            <button type="button" class="a11y-confirm-btn a11y-confirm-btn-cancel" data-action="cancel">
                Annuler
            </button>
            <button type="button" class="a11y-confirm-btn a11y-confirm-btn-confirm" data-action="confirm">
                Confirmer
            </button>
        </div>
    </div>
</div>
