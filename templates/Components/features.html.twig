{# ===== FEATURES SECTION — premium alternating layout ===== #}
<style>
  @keyframes lp-reveal {
    from { opacity:0; transform:translateY(32px); }
    to   { opacity:1; transform:translateY(0); }
  }
  .lp-reveal { opacity:0; }
  .lp-reveal.is-visible { animation: lp-reveal .7s cubic-bezier(.22,1,.36,1) both; }

  .feature-pill { transition: background .2s, box-shadow .2s, transform .2s; }
  .feature-pill:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(20,94,183,0.18); }

  .lp-step-line {
    position: absolute;
    left: 50%;
    top: 0; bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(63,169,245,0.3) 20%, rgba(63,169,245,0.3) 80%, transparent);
  }
</style>
<script>
(function(){
  function onScroll() {
    document.querySelectorAll('.lp-reveal:not(.is-visible)').forEach(function(el){
      var rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight - 80) el.classList.add('is-visible');
    });
  }
  window.addEventListener('scroll', onScroll, { passive:true });
  document.addEventListener('DOMContentLoaded', onScroll);
  setTimeout(onScroll, 200);
})();
</script>

{# ── Trusted-by infinite marquee ── #}
<style>
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 28s linear infinite;
  }
  .marquee-track:hover { animation-play-state: paused; }
  .marquee-wrap {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
  }
  .logo-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 28px;
    margin: 0 10px;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #E2E8F0;
    box-shadow: 0 1px 4px rgba(2,46,105,0.06);
    white-space: nowrap;
    transition: box-shadow .2s, border-color .2s;
  }
  .logo-chip:hover {
    box-shadow: 0 4px 16px rgba(2,46,105,0.12);
    border-color: #B5D4F4;
  }
  .logo-chip .logo-icon { flex-shrink: 0; }
  .logo-chip .logo-name { font-size: 15px; font-weight: 800; letter-spacing: -.02em; color: #022E69; }
</style>

