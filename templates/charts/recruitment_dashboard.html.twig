{% extends 'base.html.twig' %}

{% block title %}Dashboard Recrutement - HRFlow{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            {# Header #}
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-zinc-800 dark:text-zinc-100">
                        <span class="text-teal-600 dark:text-teal-400">Dashboard</span> Recrutement
                    </h1>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
                        Indicateurs clés de performance en temps réel
                    </p>
                </div>
                <div class="flex gap-3">
                    <a href="{{ path('charts_index') }}"
                       class="px-4 py-2 text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg transition-colors">
                        Retour aux Graphiques
                    </a>
                    <button onclick="refreshDashboard()"
                            class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium rounded-lg transition-colors flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                        Actualiser
                    </button>
                </div>
            </div>

            {# KPI Cards #}
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Candidatures Totales</p>
                        <p class="text-2xl font-bold text-slate-800 dark:text-slate-100">245</p>
                    </div>
                    <div class="w-10 h-10 bg-teal-100 dark:bg-teal-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                        </svg>
                    </div>
                </div>
                <div class="mt-2 text-xs text-green-600">
                    ▲ 12% ce mois
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Entretiens Planifiés</p>
                        <p class="text-2xl font-bold text-slate-800 dark:text-slate-100">18</p>
                    </div>
                    <div class="w-10 h-10 bg-blue-100 dark:bg-blue-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                        </svg>
                    </div>
                </div>
                <div class="mt-2 text-xs text-slate-500">
                    Cette semaine
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Embauches (Mois)</p>
                        <p class="text-2xl font-bold text-slate-800 dark:text-slate-100">7</p>
                    </div>
                    <div class="w-10 h-10 bg-green-100 dark:bg-green-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </div>
                </div>
                <div class="mt-2 text-xs text-green-600">
                    Objectif: 10
                </div>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-4">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Postes Ouverts</p>
                        <p class="text-2xl font-bold text-slate-800 dark:text-slate-100">12</p>
                    </div>
                    <div class="w-10 h-10 bg-amber-100 dark:bg-amber-900/30 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                </div>
                <div class="mt-2 text-xs text-amber-600">
                    5 urgents
                </div>
            </div>
        </div>

        {# Gauge Metrics #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-4">
                <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4 text-center">Taux de Remplissage</h3>
                <div class="flex justify-center">
                    <img src="{{ metrics.fill_rate }}" alt="Taux de Remplissage" class="max-w-full h-auto">
                </div>
                <p class="text-center text-sm text-slate-500 mt-2">78% des postes pourvus</p>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-4">
                <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4 text-center">Temps de Recrutement</h3>
                <div class="flex justify-center">
                    <img src="{{ metrics.time_to_hire }}" alt="Temps de Recrutement" class="max-w-full h-auto">
                </div>
                <p class="text-center text-sm text-slate-500 mt-2">18 jours en moyenne (obj: 30)</p>
            </div>

            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 p-4">
                <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 mb-4 text-center">Taux d'Acceptation</h3>
                <div class="flex justify-center">
                    <img src="{{ metrics.offer_acceptance }}" alt="Taux d'Acceptation" class="max-w-full h-auto">
                </div>
                <p class="text-center text-sm text-slate-500 mt-2">85% des offres acceptées</p>
            </div>
        </div>

        {# Main Charts Grid #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {# Recruitment Funnel #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Entonnoir de Recrutement</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Conversion par étape</p>
                    </div>
                    <span class="text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-2 py-1 rounded-full">
                        8.75% conversion
                    </span>
                </div>
                <div class="p-4">
                    <img src="{{ funnel }}" alt="Entonnoir" class="w-full h-auto rounded-lg">
                </div>
                <div class="px-4 pb-4">
                    <div class="grid grid-cols-5 gap-2 text-center text-xs">
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-slate-700 dark:text-slate-300">320</div>
                            <div class="text-slate-500">Candidatures</div>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-slate-700 dark:text-slate-300">180</div>
                            <div class="text-slate-500">56%</div>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-slate-700 dark:text-slate-300">75</div>
                            <div class="text-slate-500">42%</div>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-slate-700 dark:text-slate-300">35</div>
                            <div class="text-slate-500">47%</div>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-green-600">28</div>
                            <div class="text-slate-500">80%</div>
                        </div>
                    </div>
                </div>
            </div>

            {# Hiring Trend #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Tendances Mensuelles</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Candidatures vs Embauches</p>
                </div>
                <div class="p-4">
                    <img src="{{ hiring_trend }}" alt="Tendances" class="w-full h-auto rounded-lg">
                </div>
                <div class="px-4 pb-4">
                    <div class="flex items-center justify-center gap-6 text-sm">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
                            <span class="text-slate-600 dark:text-slate-400">Candidatures</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-green-500"></span>
                            <span class="text-slate-600 dark:text-slate-400">Embauches</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Sources #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Sources de Candidatures</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Répartition par canal</p>
                </div>
                <div class="p-4">
                    <img src="{{ sources }}" alt="Sources" class="w-full h-auto rounded-lg max-h-[350px] mx-auto">
                </div>
            </div>

            {# Recruiter Performance #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Performance des Recruteurs</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Candidats présentés vs Embauches</p>
                </div>
                <div class="p-4">
                    <img src="{{ recruiter_perf }}" alt="Performance" class="w-full h-auto rounded-lg">
                </div>
            </div>
        </div>

        {# Job Offers Table #}
        <div class="mt-6 bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
            <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Offres d'Emploi Actives</h3>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-slate-50 dark:bg-slate-700/50">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Poste</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Département</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Candidatures</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Statut</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Publié le</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                        <tr>
                            <td class="px-4 py-3 text-sm font-medium text-slate-800 dark:text-slate-200">Développeur Senior</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">Engineering</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">45 candidatures</td>
                            <td class="px-4 py-3"><span class="text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-2 py-1 rounded-full">Actif</span></td>
                            <td class="px-4 py-3 text-sm text-slate-500">15 mars 2024</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 text-sm font-medium text-slate-800 dark:text-slate-200">Responsable Marketing</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">Marketing</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">32 candidatures</td>
                            <td class="px-4 py-3"><span class="text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-2 py-1 rounded-full">Actif</span></td>
                            <td class="px-4 py-3 text-sm text-slate-500">20 mars 2024</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 text-sm font-medium text-slate-800 dark:text-slate-200">Chargé RH</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">RH</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">18 candidatures</td>
                            <td class="px-4 py-3"><span class="text-xs bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 px-2 py-1 rounded-full">En cours</span></td>
                            <td class="px-4 py-3 text-sm text-slate-500">01 avril 2024</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 text-sm font-medium text-slate-800 dark:text-slate-200">Commercial</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">Ventes</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">38 candidatures</td>
                            <td class="px-4 py-3"><span class="text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-2 py-1 rounded-full">Actif</span></td>
                            <td class="px-4 py-3 text-sm text-slate-500">10 mars 2024</td>
                        </tr>
                        <tr>
                            <td class="px-4 py-3 text-sm font-medium text-slate-800 dark:text-slate-200">Designer UX/UI</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">Design</td>
                            <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">22 candidatures</td>
                            <td class="px-4 py-3"><span class="text-xs bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400 px-2 py-1 rounded-full">Urgent</span></td>
                            <td class="px-4 py-3 text-sm text-slate-500">05 février 2024</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        </main>
    </div>
</div>

<script>
function refreshDashboard() {
    const btn = document.querySelector('button[onclick="refreshDashboard()"]');
    const originalContent = btn.innerHTML;
    btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Actualisation...';
    btn.disabled = true;
    
    setTimeout(() => {
        window.location.reload();
    }, 500);
}
</script>
{% endblock %}
