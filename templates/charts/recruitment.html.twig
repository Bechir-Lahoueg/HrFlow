{% extends 'base.html.twig' %}

{% block title %}Statistiques Recrutement - HRFlow{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            {# Header Section #}
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-zinc-800 dark:text-zinc-100">
                        <span class="text-teal-600 dark:text-teal-400">Statistiques</span> Recrutement
                    </h1>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
                        Analyse et suivi des indicateurs de recrutement
                    </p>
                </div>
                <a href="{{ path('charts_dashboard') }}"
                   class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-sm font-medium rounded-lg transition-colors">
                    Dashboard Complet
                </a>
            </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
            {# Applications by Source #}
            <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="px-3 py-2 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Sources</h3>
                </div>
                <div class="p-2 flex justify-center">
                    <img src="{{ charts.applications_by_source }}" alt="Sources" class="max-w-full h-auto rounded">
                </div>
            </div>

            {# Hiring Timeline #}
            <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="px-3 py-2 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Activité</h3>
                </div>
                <div class="p-2 flex justify-center">
                    <img src="{{ charts.hiring_timeline }}" alt="Activité" class="max-w-full h-auto rounded">
                </div>
            </div>

            {# Application Status #}
            <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="px-3 py-2 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Statuts</h3>
                </div>
                <div class="p-2 flex justify-center">
                    <img src="{{ charts.application_status }}" alt="Statuts" class="max-w-full h-auto rounded">
                </div>
            </div>

            {# Job Offer Performance #}
            <div class="bg-white dark:bg-slate-800 rounded-lg shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="px-3 py-2 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-sm font-semibold text-slate-800 dark:text-slate-100">Offres</h3>
                </div>
                <div class="p-2 flex justify-center">
                    <img src="{{ charts.job_offer_performance }}" alt="Offres" class="max-w-full h-auto rounded">
                </div>
            </div>
            </div>

            {# Live Chart Generator - Compact #}
            <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-4 shadow-sm">
                <h3 class="text-sm font-semibold text-zinc-800 dark:text-zinc-200 mb-3">Générateur de Graphiques</h3>
                <div class="flex flex-wrap items-end gap-2">
                    <div class="flex-1 min-w-[100px]">
                        <label class="text-xs text-zinc-500 dark:text-zinc-400 block mb-1">Type</label>
                        <select id="chartType" class="w-full px-2 py-1.5 text-sm border border-zinc-200 dark:border-zinc-700 rounded bg-white dark:bg-zinc-800">
                            <option value="bar">Barres</option>
                            <option value="line">Ligne</option>
                            <option value="pie">Pie</option>
                            <option value="doughnut">Anneau</option>
                        </select>
                    </div>
                    <div class="flex-1 min-w-[100px]">
                        <label class="text-xs text-zinc-500 dark:text-zinc-400 block mb-1">Titre</label>
                        <input type="text" id="chartTitle" value="Graphique" class="w-full px-2 py-1.5 text-sm border border-zinc-200 dark:border-zinc-700 rounded bg-white dark:bg-zinc-800">
                    </div>
                    <div class="flex-1 min-w-[100px]">
                        <label class="text-xs text-zinc-500 dark:text-zinc-400 block mb-1">Labels</label>
                        <input type="text" id="chartLabels" value="A,B,C" class="w-full px-2 py-1.5 text-sm border border-zinc-200 dark:border-zinc-700 rounded bg-white dark:bg-zinc-800">
                    </div>
                    <div class="flex-1 min-w-[100px]">
                        <label class="text-xs text-zinc-500 dark:text-zinc-400 block mb-1">Données</label>
                        <input type="text" id="chartData" value="10,20,15" class="w-full px-2 py-1.5 text-sm border border-zinc-200 dark:border-zinc-700 rounded bg-white dark:bg-zinc-800">
                    </div>
                    <button onclick="generateChart()" class="px-4 py-1.5 text-sm bg-teal-600 hover:bg-teal-700 text-white rounded-lg">
                        Générer
                    </button>
                </div>
                <div id="generatedChartContainer" class="mt-3 flex justify-center min-h-[150px] items-center bg-zinc-50 dark:bg-zinc-800/50 rounded-lg">
                    <p class="text-xs text-zinc-400">Le graphique apparaîtra ici</p>
                </div>
            </div>

        </main>
    </div>
</div>

<script>
async function generateChart() {
    const type = document.getElementById('chartType').value;
    const title = document.getElementById('chartTitle').value;
    const labels = document.getElementById('chartLabels').value.split(',').map(s => s.trim());
    const data = document.getElementById('chartData').value.split(',').map(s => parseFloat(s.trim()));
    
    const payload = {
        type: type,
        options: { title: title, width: 300, height: 200 }
    };
    
    if (type === 'gauge') {
        payload.value = data[0] || 50;
        payload.max = data[1] || 100;
    } else if (['pie', 'doughnut', 'polarArea'].includes(type)) {
        payload.labels = labels;
        payload.data = data;
    } else {
        payload.labels = labels;
        payload.datasets = [{ label: 'Données', data: data }];
    }
    
    try {
        const response = await fetch('{{ path('charts_generate') }}', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        
        const result = await response.json();
        
        if (result.url) {
            document.getElementById('generatedChartContainer').innerHTML = 
                `<img src="${result.url}" alt="Generated Chart" class="max-w-full h-auto rounded-lg shadow-lg">`;
        } else {
            document.getElementById('generatedChartContainer').innerHTML = 
                `<p class="text-red-500">Erreur: ${result.error}</p>`;
        }
    } catch (err) {
        document.getElementById('generatedChartContainer').innerHTML = 
            `<p class="text-red-500">Erreur lors de la génération</p>`;
    }
}
</script>
{% endblock %}
