{% extends 'base.html.twig' %}

{% block title %}HR Metrics Dashboard - HRFlow{% endblock %}

{% block content %}
<div class="min-h-screen bg-slate-50 dark:bg-slate-900">
    {# Header #}
    <div class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100">
                        <span class="text-indigo-600 dark:text-indigo-400">HR</span> Metrics Dashboard
                    </h1>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                        Real-time analytics and visualizations
                    </p>
                </div>
                <div class="flex gap-3">
                    <a href="{{ path('charts_index') }}"
                       class="px-4 py-2 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-lg transition-colors">
                        Back to Gallery
                    </a>
                    <button onclick="refreshDashboard()"
                            class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium rounded-lg transition-colors flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                        Refresh
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Main Content #}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {# Key Metrics Row #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            {# Headcount Gauge #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4">
                    <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Headcount</h3>
                    <div class="flex justify-center">
                        <img src="{{ metrics.headcount }}" alt="Headcount Gauge" class="max-w-full h-auto">
                    </div>
                </div>
            </div>

            {# Satisfaction Gauge #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4">
                    <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Employee Satisfaction</h3>
                    <div class="flex justify-center">
                        <img src="{{ metrics.satisfaction }}" alt="Satisfaction Gauge" class="max-w-full h-auto">
                    </div>
                </div>
            </div>

            {# Turnover Sparkline #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4">
                    <div class="flex items-center justify-between mb-2">
                        <h3 class="text-sm font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">Turnover Rate</h3>
                        <span class="text-xs text-red-500 font-medium">▼ 2.3%</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="text-3xl font-bold text-slate-800 dark:text-slate-100">6.2%</div>
                        <img src="{{ metrics.turnover }}" alt="Turnover Trend" class="h-10 flex-1">
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-2">Last 12 months</p>
                </div>
            </div>
        </div>

        {# Charts Grid #}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {# Recruitment Funnel #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Recruitment Funnel</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Conversion rates by stage</p>
                    </div>
                    <span class="text-xs bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 px-2 py-1 rounded-full">
                        6% hire rate
                    </span>
                </div>
                <div class="p-4">
                    <img src="{{ funnel }}" alt="Recruitment Funnel" class="w-full h-auto rounded-lg">
                </div>
                <div class="px-4 pb-4">
                    <div class="grid grid-cols-5 gap-2 text-center text-xs">
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-slate-700 dark:text-slate-300">250</div>
                            <div class="text-slate-500">Applied</div>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-slate-700 dark:text-slate-300">120</div>
                            <div class="text-slate-500">48%</div>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-slate-700 dark:text-slate-300">60</div>
                            <div class="text-slate-500">50%</div>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-slate-700 dark:text-slate-300">20</div>
                            <div class="text-slate-500">33%</div>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded">
                            <div class="font-semibold text-green-600">15</div>
                            <div class="text-slate-500">75%</div>
                        </div>
                    </div>
                </div>
            </div>

            {# Skills Radar #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Team Skills Assessment</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Current vs Target competency levels</p>
                </div>
                <div class="p-4">
                    <img src="{{ skills_radar }}" alt="Skills Radar" class="w-full h-auto rounded-lg max-h-[350px] mx-auto">
                </div>
                <div class="px-4 pb-4">
                    <div class="flex items-center justify-center gap-6 text-sm">
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
                            <span class="text-slate-600 dark:text-slate-400">Current</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="w-3 h-3 rounded-full bg-slate-400"></span>
                            <span class="text-slate-600 dark:text-slate-400">Target</span>
                        </div>
                    </div>
                </div>
            </div>

            {# Training Status #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700 flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Training Progress</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400">Quarterly completion status</p>
                    </div>
                    <span class="text-xs bg-indigo-100 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-400 px-2 py-1 rounded-full">
                        65 completed
                    </span>
                </div>
                <div class="p-4">
                    <img src="{{ training }}" alt="Training Status" class="w-full h-auto rounded-lg">
                </div>
                <div class="px-4 pb-4">
                    <div class="grid grid-cols-3 gap-3 text-center">
                        <div class="p-2 bg-green-50 dark:bg-green-900/20 rounded border border-green-200 dark:border-green-800">
                            <div class="text-lg font-bold text-green-600 dark:text-green-400">65</div>
                            <div class="text-xs text-green-700 dark:text-green-500">Completed</div>
                        </div>
                        <div class="p-2 bg-amber-50 dark:bg-amber-900/20 rounded border border-amber-200 dark:border-amber-800">
                            <div class="text-lg font-bold text-amber-600 dark:text-amber-400">12</div>
                            <div class="text-xs text-amber-700 dark:text-amber-500">In Progress</div>
                        </div>
                        <div class="p-2 bg-slate-50 dark:bg-slate-700/50 rounded border border-slate-200 dark:border-slate-600">
                            <div class="text-lg font-bold text-slate-600 dark:text-slate-400">8</div>
                            <div class="text-xs text-slate-700 dark:text-slate-500">Pending</div>
                        </div>
                    </div>
                </div>
            </div>

            {# Salary Distribution #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Salary Distribution</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">Employee count by salary range</p>
                </div>
                <div class="p-4">
                    <img src="{{ salary_dist }}" alt="Salary Distribution" class="w-full h-auto rounded-lg max-h-[350px] mx-auto">
                </div>
                <div class="px-4 pb-4">
                    <div class="flex items-center justify-between text-sm text-slate-600 dark:text-slate-400">
                        <span>Average: <strong class="text-slate-800 dark:text-slate-200">$52,400</strong></span>
                        <span>Median: <strong class="text-slate-800 dark:text-slate-200">$48,500</strong></span>
                        <span>Range: <strong class="text-slate-800 dark:text-slate-200">$25k - $95k</strong></span>
                    </div>
                </div>
            </div>
        </div>

        {# Data Tables #}
        <div class="mt-8 grid grid-cols-1 lg:grid-cols-2 gap-6">
            {# Top Performers #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Top Performers</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-slate-50 dark:bg-slate-700/50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Employee</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Department</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Score</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Trend</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                            <tr>
                                <td class="px-4 py-3 text-sm text-slate-800 dark:text-slate-200">Sarah Johnson</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">Engineering</td>
                                <td class="px-4 py-3 text-sm font-semibold text-green-600">4.8</td>
                                <td class="px-4 py-3 text-sm text-green-500">▲ 0.3</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-3 text-sm text-slate-800 dark:text-slate-200">Michael Chen</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">Sales</td>
                                <td class="px-4 py-3 text-sm font-semibold text-green-600">4.7</td>
                                <td class="px-4 py-3 text-sm text-green-500">▲ 0.2</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-3 text-sm text-slate-800 dark:text-slate-200">Emily Davis</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">Marketing</td>
                                <td class="px-4 py-3 text-sm font-semibold text-green-600">4.6</td>
                                <td class="px-4 py-3 text-sm text-slate-400">−</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-3 text-sm text-slate-800 dark:text-slate-200">James Wilson</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">Engineering</td>
                                <td class="px-4 py-3 text-sm font-semibold text-green-600">4.5</td>
                                <td class="px-4 py-3 text-sm text-green-500">▲ 0.4</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {# Department Stats #}
            <div class="bg-white dark:bg-slate-800 rounded-xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
                <div class="p-4 border-b border-slate-200 dark:border-slate-700">
                    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Department Summary</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-slate-50 dark:bg-slate-700/50">
                            <tr>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Department</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Headcount</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Avg Rating</th>
                                <th class="px-4 py-3 text-left text-xs font-semibold text-slate-600 dark:text-slate-400 uppercase">Budget</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                            <tr>
                                <td class="px-4 py-3 text-sm text-slate-800 dark:text-slate-200">Engineering</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">45</td>
                                <td class="px-4 py-3 text-sm font-semibold text-green-600">4.2</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">$2.4M</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-3 text-sm text-slate-800 dark:text-slate-200">Sales</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">30</td>
                                <td class="px-4 py-3 text-sm font-semibold text-green-600">4.0</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">$1.8M</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-3 text-sm text-slate-800 dark:text-slate-200">Marketing</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">15</td>
                                <td class="px-4 py-3 text-sm font-semibold text-amber-600">3.8</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">$900K</td>
                            </tr>
                            <tr>
                                <td class="px-4 py-3 text-sm text-slate-800 dark:text-slate-200">Operations</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">25</td>
                                <td class="px-4 py-3 text-sm font-semibold text-green-600">3.9</td>
                                <td class="px-4 py-3 text-sm text-slate-600 dark:text-slate-400">$1.2M</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function refreshDashboard() {
    // Add loading state
    const btn = document.querySelector('button[onclick="refreshDashboard()"]');
    const originalContent = btn.innerHTML;
    btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Refreshing...';
    btn.disabled = true;
    
    // Simulate refresh - in real app, fetch new data
    setTimeout(() => {
        window.location.reload();
    }, 500);
}
</script>
{% endblock %}
