{% extends 'base.html.twig' %}

{% block title %}Employes | HrFlow RH{% endblock %}

{% block body %}
<style>
    @keyframes hintFadeIn {
        from { opacity: 0; transform: translateY(-3px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .emp-input:user-invalid,
    .emp-input:not(:placeholder-shown):invalid {
        border-color: #ef4444 !important;
        box-shadow: 0 0 0 3px rgba(239,68,68,0.10) !important;
    }
    .emp-input:user-valid,
    .emp-input:not(:placeholder-shown):valid {
        border-color: #22c55e !important;
        box-shadow: 0 0 0 3px rgba(34,197,94,0.10) !important;
    }
    .emp-hint {
        display: none;
        font-size: 0.68rem;
        font-weight: 600;
        color: #ef4444;
        margin-top: 0.2rem;
        animation: hintFadeIn 0.15s ease-out;
    }
    .emp-input:user-invalid + .emp-hint,
    .emp-input:not(:placeholder-shown):invalid + .emp-hint {
        display: block;
    }
    .dark .emp-hint { color: #f87171; }
</style>
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid"
     data-controller="employee-modal"
     data-action="keydown@document->employee-modal#closeOnEscape">

    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# ── Flash Messages ── #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/30 text-rose-700 dark:text-rose-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-rose-100 dark:bg-rose-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 lg:p-8 space-y-6 max-w-7xl mx-auto">

            {# ═══════════════════ HERO BANNER ═══════════════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-teal-950 to-emerald-900 text-white p-8 md:p-10 animate-slide-up">
                {# Decorative blur orbs #}
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-teal-400/15 blur-3xl mesh-blob"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-emerald-300/15 blur-3xl mesh-blob-alt"></div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-40 w-40 rounded-full bg-cyan-400/10 blur-3xl"></div>

                <div class="relative z-10 grid lg:grid-cols-[1.15fr_0.85fr] gap-6 items-center">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-teal-200 uppercase tracking-[0.15em]">Gestion des Ressources Humaines</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight tracking-tight">Gestion des employes</h2>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">Ajoutez, consultez et gerez les membres de votre equipe. Suivez leur evolution au sein de l'entreprise.</p>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-3">
                        <div class="rounded-xl border border-white/15 bg-white/[0.08] backdrop-blur-sm p-4 hover:bg-white/[0.12] transition-colors">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-teal-200/70 font-bold">Total employes</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ totalEmployees|default(employees|length) }}</p>
                            <p class="text-xs text-teal-100/60 mt-1">dans votre equipe</p>
                        </div>
                        <div class="rounded-xl border border-white/15 bg-white/[0.08] backdrop-blur-sm p-4 hover:bg-white/[0.12] transition-colors">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-teal-200/70 font-bold">Resultats</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ employees|length }}</p>
                            <p class="text-xs text-teal-100/60 mt-1">
                                {% if searchTerm is defined and searchTerm is not empty %}
                                    pour "{{ searchTerm }}"
                                {% else %}
                                    affichage complet
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            {# ═══════════════════ MAIN GRID ═══════════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

                {# ── Create Employee Form ── #}
                <section class="xl:col-span-1 animate-slide-up stagger-1">
                    <div class="card-surface stat-stripe stat-stripe-teal p-6 xl:sticky xl:top-24">
                        <div class="flex items-center gap-3 mb-6">
                            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-teal-500 to-emerald-600 flex items-center justify-center shadow-lg shadow-teal-500/20">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z"/></svg>
                            </div>
                            <div>
                                <h2 class="text-base font-bold text-zinc-800 dark:text-zinc-200">Nouvel employe</h2>
                                <p class="text-[11px] text-zinc-400">Ajoutez un membre a votre equipe</p>
                            </div>
                        </div>

                        <form method="post" action="{{ path('app_rh_employees') }}" class="space-y-4" novalidate>
                            <input type="hidden" name="_token" value="{{ csrf_token('create_employee_rh') }}">

                            <div class="grid grid-cols-2 gap-3">
                                <div>
                                    <label class="block text-[10px] font-bold text-zinc-500 dark:text-zinc-400 mb-1.5 uppercase tracking-[0.1em]" for="first_name">Prenom</label>
                                    <input id="first_name" name="first_name" type="text" required
                                           placeholder="Sara"
                                           class="emp-input input-refined w-full rounded-xl bg-zinc-50 dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-zinc-800 dark:text-zinc-200 placeholder-zinc-300 dark:placeholder-zinc-600" />
                                    <span class="emp-hint">Ce champ est obligatoire</span>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-zinc-500 dark:text-zinc-400 mb-1.5 uppercase tracking-[0.1em]" for="last_name">Nom</label>
                                    <input id="last_name" name="last_name" type="text" required
                                           placeholder="Ben Ali"
                                           class="emp-input input-refined w-full rounded-xl bg-zinc-50 dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-zinc-800 dark:text-zinc-200 placeholder-zinc-300 dark:placeholder-zinc-600" />
                                    <span class="emp-hint">Ce champ est obligatoire</span>
                                </div>
                            </div>

                            <div class="grid grid-cols-3 gap-3">
                                <div class="col-span-2">
                                    <label class="block text-[10px] font-bold text-zinc-500 dark:text-zinc-400 mb-1.5 uppercase tracking-[0.1em]" for="job_title">Poste</label>
                                    <input id="job_title" name="job_title" type="text" required
                                           placeholder="Developpeur Frontend"
                                           class="emp-input input-refined w-full rounded-xl bg-zinc-50 dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-zinc-800 dark:text-zinc-200 placeholder-zinc-300 dark:placeholder-zinc-600" />
                                    <span class="emp-hint">Ce champ est obligatoire</span>
                                </div>
                                <div>
                                    <label class="block text-[10px] font-bold text-zinc-500 dark:text-zinc-400 mb-1.5 uppercase tracking-[0.1em]" for="age">Age</label>
                                    <input id="age" name="age" type="number" min="18" max="100" required
                                           placeholder="29"
                                           class="emp-input input-refined w-full rounded-xl bg-zinc-50 dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-zinc-800 dark:text-zinc-200 placeholder-zinc-300 dark:placeholder-zinc-600 font-mono-num" />
                                    <span class="emp-hint">Age entre 18 et 100 ans</span>
                                </div>
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold text-zinc-500 dark:text-zinc-400 mb-1.5 uppercase tracking-[0.1em]" for="email">Email</label>
                                <input id="email" name="email" type="email" required
                                       placeholder="employe@entreprise.com"
                                       class="emp-input input-refined w-full rounded-xl bg-zinc-50 dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-zinc-800 dark:text-zinc-200 placeholder-zinc-300 dark:placeholder-zinc-600" />
                                <span class="emp-hint">Adresse email invalide</span>
                            </div>

                            <div>
                                <label class="block text-[10px] font-bold text-zinc-500 dark:text-zinc-400 mb-1.5 uppercase tracking-[0.1em]" for="password">Mot de passe</label>
                                <input id="password" name="password" type="password" required
                                       placeholder="••••••••"
                                       class="emp-input input-refined w-full rounded-xl bg-zinc-50 dark:bg-zinc-800 px-3.5 py-2.5 text-sm text-zinc-800 dark:text-zinc-200 placeholder-zinc-300 dark:placeholder-zinc-600" />
                                <span class="emp-hint">Ce champ est obligatoire</span>
                            </div>

                            <button type="submit"
                                    class="w-full inline-flex justify-center items-center gap-2 px-4 py-3 rounded-xl text-sm font-bold
                                           bg-gradient-to-r from-teal-600 to-emerald-600 text-white
                                           hover:from-teal-500 hover:to-emerald-500
                                           shadow-lg shadow-teal-600/25 hover:shadow-xl hover:shadow-teal-600/30
                                           active:scale-[0.98] transition-all duration-200 mt-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                                Ajouter l'employe
                            </button>
                        </form>
                    </div>
                </section>

                {# ── Employee List ── #}
                <section class="xl:col-span-2 animate-slide-up stagger-2">
                    <div class="card-surface overflow-hidden">

                        {# Table Header with Search #}
                        <div class="p-6 pb-4 border-b border-zinc-100 dark:border-zinc-800/50">
                            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-4">
                                <div class="flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-teal-500 to-emerald-600 flex items-center justify-center shadow-sm">
                                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
                                    </div>
                                    <h2 class="text-base font-bold text-zinc-800 dark:text-zinc-200">Liste des employes</h2>
                                    <span class="text-[11px] font-bold text-teal-700 dark:text-teal-400 bg-teal-50 dark:bg-teal-500/10 px-2.5 py-1 rounded-lg font-mono-num">
                                        {{ employees|length }}{% if searchTerm is defined and searchTerm is not empty %} / {{ totalEmployees|default(employees|length) }}{% endif %}
                                    </span>
                                </div>
                            </div>

                            <form method="get" action="{{ path('app_rh_employees') }}" class="flex items-center gap-3">
                                <div class="relative flex-1">
                                    <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-600 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.5 7.5 0 103.75 9.75a7.5 7.5 0 0012.9 6.9z"/></svg>
                                    <input type="text" name="q" value="{{ searchTerm|default('') }}"
                                           placeholder="Rechercher par nom, email ou poste..."
                                           class="input-refined w-full rounded-xl bg-zinc-50 dark:bg-zinc-800 pl-10 pr-4 py-2.5 text-sm text-zinc-700 dark:text-zinc-300 placeholder-zinc-300 dark:placeholder-zinc-600" />
                                </div>
                                <button type="submit" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-zinc-900 dark:bg-zinc-100 dark:text-zinc-900 hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors shadow-sm">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m21 21-4.35-4.35m0 0A7.5 7.5 0 103.75 9.75a7.5 7.5 0 0012.9 6.9z"/></svg>
                                    Rechercher
                                </button>
                                {% if searchTerm is defined and searchTerm is not empty %}
                                    <a href="{{ path('app_rh_employees') }}" class="inline-flex items-center justify-center px-4 py-2.5 rounded-xl text-sm font-semibold text-zinc-500 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors">
                                        Effacer
                                    </a>
                                {% endif %}
                            </form>

                            {% if searchTerm is defined and searchTerm is not empty %}
                                <p class="mt-3 text-xs text-zinc-400 dark:text-zinc-500">
                                    Resultats pour <span class="font-bold text-zinc-600 dark:text-zinc-300">"{{ searchTerm }}"</span>
                                </p>
                            {% endif %}
                        </div>

                        {# Employee Table #}
                        <div class="overflow-x-auto">
                            <table class="w-full text-sm">
                                <thead>
                                    <tr class="border-b border-zinc-100 dark:border-zinc-800/50">
                                        <th class="text-left px-6 py-3.5 text-[10px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-[0.1em] bg-zinc-50/60 dark:bg-zinc-800/30">Employe</th>
                                        <th class="text-left px-6 py-3.5 text-[10px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-[0.1em] bg-zinc-50/60 dark:bg-zinc-800/30">Email</th>
                                        <th class="text-left px-6 py-3.5 text-[10px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-[0.1em] bg-zinc-50/60 dark:bg-zinc-800/30">Poste</th>
                                        <th class="text-center px-6 py-3.5 text-[10px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-[0.1em] bg-zinc-50/60 dark:bg-zinc-800/30">Age</th>
                                        <th class="text-center px-6 py-3.5 text-[10px] font-bold text-zinc-400 dark:text-zinc-500 uppercase tracking-[0.1em] bg-zinc-50/60 dark:bg-zinc-800/30"></th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-50 dark:divide-zinc-800/30">
                                    {% for employee in employees %}
                                        <tr class="row-refined cursor-pointer group"
                                            data-action="click->employee-modal#open"
                                            data-employee-id="{{ employee.id }}"
                                            data-first-name="{{ employee.firstName|e('html_attr') }}"
                                            data-last-name="{{ employee.lastName|e('html_attr') }}"
                                            data-email="{{ employee.email|e('html_attr') }}"
                                            data-age="{{ employee.age }}"
                                            data-job-title="{{ employee.jobTitle|e('html_attr') }}"
                                            data-rh-id="{{ employee.rhId }}"
                                            data-rh-name="{{ user.userIdentifier|default('RH')|e('html_attr') }}"
                                            data-created-at="{{ employee.createdAt ? employee.createdAt|date('d/m/Y H:i') : '-' }}"
                                            data-updated-at="{{ employee.updatedAt ? employee.updatedAt|date('d/m/Y H:i') : '-' }}">
                                            <td class="px-6 py-4">
                                                <div class="flex items-center gap-3">
                                                    <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-teal-500 to-emerald-600 flex items-center justify-center shadow-sm shadow-teal-500/20 shrink-0 group-hover:shadow-md group-hover:shadow-teal-500/30 transition-shadow">
                                                        <span class="text-[11px] font-bold text-white tracking-tight">{{ employee.firstName|first|upper }}{{ employee.lastName|first|upper }}</span>
                                                    </div>
                                                    <div>
                                                        <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200">{{ employee.firstName }} {{ employee.lastName }}</p>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="text-[13px] text-zinc-500 dark:text-zinc-400">{{ employee.email }}</span>
                                            </td>
                                            <td class="px-6 py-4">
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">{{ employee.jobTitle }}</span>
                                            </td>
                                            <td class="px-6 py-4 text-center">
                                                <span class="text-[13px] text-zinc-500 dark:text-zinc-400 font-mono-num">{{ employee.age }}</span>
                                            </td>
                                            <td class="px-6 py-4 text-center">
                                                <span class="text-zinc-300 dark:text-zinc-600 group-hover:text-teal-500 dark:group-hover:text-teal-400 transition-colors">
                                                    <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                                                </span>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="5" class="px-6 py-20 text-center">
                                                <div class="w-16 h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mx-auto mb-4">
                                                    <svg class="w-7 h-7 text-zinc-300 dark:text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                                                </div>
                                                <p class="text-sm font-semibold text-zinc-400 dark:text-zinc-500">
                                                    {% if searchTerm is defined and searchTerm is not empty %}
                                                        Aucun employe ne correspond a votre recherche
                                                    {% else %}
                                                        Aucun employe pour le moment
                                                    {% endif %}
                                                </p>
                                                <p class="text-xs text-zinc-300 dark:text-zinc-600 mt-1">
                                                    {% if searchTerm is defined and searchTerm is not empty %}
                                                        Essayez un autre terme de recherche
                                                    {% else %}
                                                        Utilisez le formulaire pour ajouter votre premier employe
                                                    {% endif %}
                                                </p>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </section>
            </div>
        </main>
    </div>

    {# ═══════════════════ EMPLOYEE DETAIL SLIDE-OVER ═══════════════════ #}
    <div data-employee-modal-target="overlay" class="hidden fixed inset-0 z-50">
        <div data-employee-modal-target="backdrop"
             data-action="click->employee-modal#close"
             class="absolute inset-0 bg-zinc-950/50 backdrop-blur-sm opacity-0 transition-opacity duration-300"></div>

        <div data-employee-modal-target="panel" data-panel
             class="slide-panel absolute inset-y-0 right-0 w-full max-w-lg bg-white dark:bg-zinc-900 shadow-2xl shadow-black/20 translate-x-full flex flex-col">

            {# Panel Header #}
            <div class="relative overflow-hidden px-6 py-5 border-b border-zinc-100 dark:border-zinc-800">
                <div class="absolute inset-0 bg-gradient-to-r from-teal-500/5 to-emerald-500/5 dark:from-teal-500/10 dark:to-emerald-500/10"></div>
                <div class="relative flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-teal-500 to-emerald-600 flex items-center justify-center shadow-lg shadow-teal-500/25">
                            <span data-employee-modal-target="avatarLarge" class="text-sm font-bold text-white tracking-tight">--</span>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100" data-employee-modal-target="detailFullname">-</h3>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500" data-employee-modal-target="detailJob">-</p>
                        </div>
                    </div>
                    <button type="button" data-action="click->employee-modal#close"
                            class="w-9 h-9 rounded-xl flex items-center justify-center text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                    </button>
                </div>
            </div>

            {# Panel Body #}
            <div class="flex-1 overflow-y-auto p-6 space-y-6">

