{% extends 'base.html.twig' %}

{% block title %}Parametres | RH — HrFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Settings module color palette */
        :root {
            --settings-primary-deep: #022E69;
            --settings-primary: #145EB7;
            --settings-accent: #3FA9F5;
            --settings-border: #D0D0D0;
        }

        /* Hero Banner - Force les couleurs */
        .hero-banner-settings {
            background: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d) !important;
        }

        /* Settings page background */
        #settings-page-container {
            background-color: #f4f7fb !important;
        }

        /* High contrast mode support */
        html.a11y-high-contrast {
            --settings-primary-deep: #022E69;
            --settings-primary: #145EB7;
            --settings-accent: #3FA9F5;
            --settings-border: #3FA9F5;
        }
    </style>
{% endblock %}

{% block body %}
<div id="settings-page-container" class="min-h-screen dot-grid">
    <style>
        /* Settings module color palette */
        :root {
            --settings-primary-deep: #022E69;
            --settings-primary: #145EB7;
            --settings-accent: #3FA9F5;
            --settings-border: #D0D0D0;
        }

    </style>

    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# ══════════ Hero Banner ══════════ #}
        <div class="mx-6 mt-6">
            <section class="hero-banner-settings relative overflow-hidden rounded-2xl text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full blur-3xl mesh-blob" style="background: radial-gradient(circle, rgba(63, 169, 245, 0.15), transparent 70%);"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full blur-3xl mesh-blob-alt" style="background: radial-gradient(circle, rgba(20, 94, 183, 0.15), transparent 70%);"></div>
                <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full animate-pulse" style="background-color: #3FA9F5;"></div>
                        <span class="text-[11px] font-bold uppercase tracking-wider" style="color: #3FA9F5;">RH Control Center</span>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Paramètres du Compte</h2>
                    <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">Gérez votre profil, modifiez votre email ou mot de passe en toute sécurité.</p>
                </div>
            </section>
        </div>

        {% include 'Settings/_settings_form.html.twig' %}
    </div>
</div>
{% endblock %}
