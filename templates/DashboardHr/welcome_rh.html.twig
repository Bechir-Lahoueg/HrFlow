{% extends 'base.html.twig' %}
{% import '_widgets/_welcome_widgets.html.twig' as w %}

{% block title %}Tableau de bord RH | HrFlow{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ═══════════════ Welcome Banner ═══════════════ #}
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-teal-600 via-teal-700 to-emerald-800 p-8 sm:p-10 text-white animate-slide-up">
                <div class="absolute inset-0 overflow-hidden">
                    <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full bg-white/10 blur-3xl mesh-blob"></div>
                    <div class="absolute -bottom-32 -left-20 w-80 h-80 rounded-full bg-emerald-400/20 blur-3xl mesh-blob-alt"></div>
                    <div class="absolute top-0 right-0 w-80 h-80 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
                </div>
                <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-emerald-300 uppercase tracking-wider">Portail RH actif</span>
                        </div>
                        <h2 class="text-3xl sm:text-4xl font-extrabold mb-2">
                            Bonjour, <span class="text-white/90">{{ user.userIdentifier }}</span>
                        </h2>
                        <p class="text-teal-200 max-w-xl text-[15px] leading-relaxed">
                            Votre hub RH opérationnel. Anticipez les congés grâce aux jours fériés à venir, suivez les tendances du secteur et la météo pour mieux planifier.
                        </p>
                    </div>
                    <div class="hidden md:block shrink-0">
                        <div class="bg-white/10 backdrop-blur-md rounded-2xl p-5 border border-white/20 min-w-[180px]">
                            <p class="text-[10px] uppercase tracking-widest text-teal-200 font-bold">Tunis • Maintenant</p>
                            <p class="text-4xl font-black mt-1 tabular-nums">{{ serverTime|date('H:i') }}</p>
                            <p class="text-[12px] text-teal-100 mt-1 font-semibold">{{ serverTime|date('d/m/Y') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {# ═══════════════ KPI Row : Employés / Congés en attente / Formations ═══════════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-slide-up stagger-1">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none">
                    <p class="text-[11px] uppercase tracking-wider font-bold text-zinc-400">Employés</p>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 mt-1 tabular-nums">{{ employeeCount }}</p>
                    <p class="text-[12px] text-zinc-500 mt-1">Total actifs</p>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none">
                    <p class="text-[11px] uppercase tracking-wider font-bold text-amber-500">Congés en attente</p>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 mt-1 tabular-nums">{{ pendingLeaveCount }}</p>
                    <p class="text-[12px] text-zinc-500 mt-1">À traiter</p>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none">
                    <p class="text-[11px] uppercase tracking-wider font-bold text-sky-500">Formations</p>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 mt-1 tabular-nums">{{ formationMetrics.total_formations ?? 0 }}</p>
                    <p class="text-[12px] text-zinc-500 mt-1">Sessions créées</p>
                </div>
            </div>

            {# ═══════════════ Charts Row ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 animate-slide-up stagger-2">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none">
                    <h3 class="text-[13px] font-bold text-zinc-700 dark:text-zinc-200 mb-4">Formations par catégorie</h3>
                    {{ render_chart(formationCountChart) }}
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none">
                    <h3 class="text-[13px] font-bold text-zinc-700 dark:text-zinc-200 mb-4">Taux de participation</h3>
                    {{ render_chart(participationRateChart) }}
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none">
                    <h3 class="text-[13px] font-bold text-zinc-700 dark:text-zinc-200 mb-4">Formations (6 derniers mois)</h3>
                    {{ render_chart(formationByMonthChart) }}
                </div>
            </div>

            {# ═══════════════ Row : Jours fériés (hero) + Météo ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 animate-slide-up stagger-3">
                <div class="xl:col-span-2">
                    {{ w.holidays(holidays, 'teal', path('app_welcome_rh', {refresh: 'holidays'})) }}
                </div>
                <div class="xl:col-span-1">
                    {{ w.weather(weather, 'teal', path('app_welcome_rh', {refresh: 'weather'})) }}
                </div>
            </div>

            {# ═══════════════ Prévisions 5 jours ═══════════════ #}
            <div class="grid grid-cols-1 gap-4 animate-slide-up stagger-4">
                {{ w.forecast(forecast, 'teal', path('app_welcome_rh', {refresh: 'forecast'})) }}
            </div>

            {# ═══════════════ News RH + Citation leadership ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 animate-slide-up stagger-5">
                <div class="xl:col-span-2">
                    {{ w.news(news, 'teal', 'Veille RH & management', path('app_welcome_rh', {refresh: 'news'})) }}
                </div>
                <div class="xl:col-span-1">
                    {{ w.quote(quote, 'teal', path('app_welcome_rh', {refresh: 'quote'})) }}
                </div>
            </div>

            {# ═══════════════ Taux de change + Horloge ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 animate-slide-up stagger-5">
                {{ w.rates(rates, 'teal', path('app_welcome_rh', {refresh: 'rates'})) }}
                {{ w.clock(serverTime, 'teal') }}
            </div>

            {# ═══════════════ Quick Actions ═══════════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-slide-up stagger-5">
                <a href="{{ path('app_rh_employees') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none hover:border-teal-200 dark:hover:border-teal-500/20 transition-all duration-200 card-hover">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg bg-teal-50 dark:bg-teal-500/10 flex items-center justify-center group-hover:bg-teal-100 dark:group-hover:bg-teal-500/20 transition-colors">
                            <svg class="w-5 h-5 text-teal-600 dark:text-teal-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-teal-700 dark:group-hover:text-teal-300 transition-colors">Mon équipe</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Gérer les employés</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-teal-500 dark:group-hover:text-teal-400 ml-auto transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>

                <a href="{{ path('app_rh_leave_requests') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none hover:border-amber-200 dark:hover:border-amber-500/20 transition-all duration-200 card-hover">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center group-hover:bg-amber-100 dark:group-hover:bg-amber-400/10 transition-colors">
                            <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-amber-700 dark:group-hover:text-amber-300 transition-colors">Demandes de congés</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Examiner & approuver</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-amber-500 dark:group-hover:text-amber-400 ml-auto transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>

                <a href="{{ path('rh_formation_list') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none hover:border-sky-200 dark:hover:border-sky-500/20 transition-all duration-200 card-hover">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg bg-sky-50 dark:bg-sky-500/10 flex items-center justify-center group-hover:bg-sky-100 dark:group-hover:bg-sky-400/10 transition-colors">
                            <svg class="w-5 h-5 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 group-hover:text-sky-700 dark:group-hover:text-sky-300 transition-colors">Formations</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Gérer les sessions</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 group-hover:text-sky-500 dark:group-hover:text-sky-400 ml-auto transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>
            </div>

        </main>
    </div>
</div>
{% endblock %}
