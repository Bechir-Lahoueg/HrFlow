{% extends 'base.html.twig' %}
{% import '_widgets/_welcome_widgets.html.twig' as w %}

{% block title %}Tableau de bord RH | HrFlow{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f4f7fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ═══════════════ Welcome Banner ═══════════════ #}
            <div class="relative overflow-hidden rounded-2xl p-8 sm:p-10 text-white animate-slide-up" style="background: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d);">
                <div class="absolute inset-0 overflow-hidden">
                    <div class="absolute -top-20 -right-20 w-72 h-72 rounded-full blur-3xl mesh-blob" style="background: radial-gradient(circle, rgba(63,169,245,0.15), transparent 70%);"></div>
                    <div class="absolute -bottom-32 -left-20 w-80 h-80 rounded-full blur-3xl mesh-blob-alt" style="background: radial-gradient(circle, rgba(20,94,183,0.20), transparent 70%);"></div>
                    <div class="absolute top-0 right-0 w-80 h-80 rounded-full -translate-y-1/2 translate-x-1/3" style="background: rgba(255,255,255,0.05);"></div>
                </div>
                <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full animate-pulse" style="background-color: #3FA9F5;"></div>
                            <span class="text-[11px] font-bold uppercase tracking-wider" style="color: #3FA9F5;">Portail RH actif</span>
                        </div>
                        <h2 class="text-3xl sm:text-4xl font-extrabold mb-2">
                            Bonjour, <span class="text-white/90">{{ user.userIdentifier }}</span>
                        </h2>
                        <p class="max-w-xl text-[15px] leading-relaxed" style="color: rgba(63,169,245,0.85);">
                            Votre hub RH opérationnel. Anticipez les congés grâce aux jours fériés à venir, suivez les tendances du secteur et la météo pour mieux planifier.
                        </p>
                    </div>
                    <div class="hidden md:block shrink-0">
                        <div class="backdrop-blur-md rounded-2xl p-5 border border-white/20 min-w-[180px]" style="background: rgba(255,255,255,0.08);">
                            <p class="text-[10px] uppercase tracking-widest font-bold" style="color: rgba(63,169,245,0.7);">Tunis • Maintenant</p>
                            <p class="text-4xl font-black mt-1 tabular-nums">{{ serverTime|date('H:i') }}</p>
                            <p class="text-[12px] mt-1 font-semibold" style="color: rgba(63,169,245,0.85);">{{ serverTime|date('d/m/Y') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            {# ═══════════════ KPI Row ═══════════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-slide-up stagger-1">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none" style="border-left: 3px solid #145EB7;">
                    <p class="text-[11px] uppercase tracking-wider font-bold" style="color: #145EB7;">Employés</p>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 mt-1 tabular-nums">{{ employeeCount }}</p>
                    <p class="text-[12px] text-zinc-500 mt-1">Total actifs</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-full rounded-full" style="background: linear-gradient(90deg, #145EB7, #3FA9F5);"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none" style="border-left: 3px solid #3FA9F5;">
                    <p class="text-[11px] uppercase tracking-wider font-bold" style="color: #3FA9F5;">Congés en attente</p>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 mt-1 tabular-nums">{{ pendingLeaveCount }}</p>
                    <p class="text-[12px] text-zinc-500 mt-1">À traiter</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-1/3 rounded-full" style="background: linear-gradient(90deg, #022E69, #3FA9F5);"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none" style="border-left: 3px solid #022E69;">
                    <p class="text-[11px] uppercase tracking-wider font-bold" style="color: #022E69;">Formations</p>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 mt-1 tabular-nums">{{ formationMetrics.total_formations ?? 0 }}</p>
                    <p class="text-[12px] text-zinc-500 mt-1">Sessions créées</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-2/3 rounded-full" style="background: linear-gradient(90deg, #022E69, #145EB7);"></div></div>
                </div>
            </div>

            {# ═══════════════ Charts Row ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 animate-slide-up stagger-2">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none">
                    <h3 class="text-[13px] font-bold text-zinc-700 dark:text-zinc-200 mb-4">Formations par catégorie</h3>
                    {{ render_chart(formationCountChart) }}
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none">
                    <h3 class="text-[13px] font-bold text-zinc-700 dark:text-zinc-200 mb-4">Taux de participation</h3>
                    {{ render_chart(participationRateChart) }}
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none">
                    <h3 class="text-[13px] font-bold text-zinc-700 dark:text-zinc-200 mb-4">Formations (6 derniers mois)</h3>
                    {{ render_chart(formationByMonthChart) }}
                </div>
            </div>

            {# ═══════════════ Row : Jours fériés (hero) + Météo ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 animate-slide-up stagger-3">
                <div class="xl:col-span-2">
                    {{ w.holidays(holidays, 'blue', path('app_welcome_rh', {refresh: 'holidays'})) }}
                </div>
                <div class="xl:col-span-1">
                    {{ w.weather(weather, 'blue', path('app_welcome_rh', {refresh: 'weather'})) }}
                </div>
            </div>

            {# ═══════════════ Prévisions 5 jours ═══════════════ #}
            <div class="grid grid-cols-1 gap-4 animate-slide-up stagger-4">
                {{ w.forecast(forecast, 'blue', path('app_welcome_rh', {refresh: 'forecast'})) }}
            </div>

            {# ═══════════════ News RH + Citation leadership ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 animate-slide-up stagger-5">
                <div class="xl:col-span-2">
                    {{ w.news(news, 'blue', 'Veille RH & management', path('app_welcome_rh', {refresh: 'news'})) }}
                </div>
                <div class="xl:col-span-1">
                    {{ w.quote(quote, 'blue', path('app_welcome_rh', {refresh: 'quote'})) }}
                </div>
            </div>

            {# ═══════════════ Taux de change + Horloge ═══════════════ #}
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-4 animate-slide-up stagger-5">
                {{ w.rates(rates, 'blue', path('app_welcome_rh', {refresh: 'rates'})) }}
                {{ w.clock(serverTime, 'blue') }}
            </div>

            {# ═══════════════ Quick Actions ═══════════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 animate-slide-up stagger-5">
                <a href="{{ path('app_rh_employees') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none transition-all duration-200 card-hover" style="--hover-border: rgba(20,94,183,0.3);" onmouseover="this.style.borderColor='rgba(20,94,183,0.3)'" onmouseout="this.style.borderColor=''">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg flex items-center justify-center transition-colors" style="background-color: rgba(20,94,183,0.08);" onmouseover="this.style.backgroundColor='rgba(20,94,183,0.15)'" onmouseout="this.style.backgroundColor='rgba(20,94,183,0.08)'">
                            <svg class="w-5 h-5" style="color: #145EB7;" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 transition-colors group-hover:text-[#145EB7]">Mon équipe</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Gérer les employés</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 ml-auto transition-colors group-hover:text-[#3FA9F5]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>

                <a href="{{ path('app_rh_leave_requests') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none transition-all duration-200 card-hover" onmouseover="this.style.borderColor='rgba(63,169,245,0.35)'" onmouseout="this.style.borderColor=''">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg flex items-center justify-center transition-colors" style="background-color: rgba(63,169,245,0.10);" onmouseover="this.style.backgroundColor='rgba(63,169,245,0.18)'" onmouseout="this.style.backgroundColor='rgba(63,169,245,0.10)'">
                            <svg class="w-5 h-5" style="color: #3FA9F5;" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 transition-colors group-hover:text-[#3FA9F5]">Demandes de congés</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Examiner & approuver</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 ml-auto transition-colors group-hover:text-[#3FA9F5]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>

                <a href="{{ path('rh_formation_list') }}" class="group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm dark:shadow-none transition-all duration-200 card-hover" onmouseover="this.style.borderColor='rgba(2,46,105,0.25)'" onmouseout="this.style.borderColor=''">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 rounded-lg flex items-center justify-center transition-colors" style="background-color: rgba(2,46,105,0.07);" onmouseover="this.style.backgroundColor='rgba(2,46,105,0.14)'" onmouseout="this.style.backgroundColor='rgba(2,46,105,0.07)'">
                            <svg class="w-5 h-5" style="color: #022E69;" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/></svg>
                        </div>
                        <div>
                            <p class="text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 transition-colors group-hover:text-[#022E69]">Formations</p>
                            <p class="text-[12px] text-zinc-400 dark:text-zinc-500">Gérer les sessions</p>
                        </div>
                        <svg class="w-4 h-4 text-zinc-300 dark:text-zinc-700 ml-auto transition-colors group-hover:text-[#145EB7]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                    </div>
                </a>
            </div>

        </main>
    </div>
</div>
{% endblock %}
