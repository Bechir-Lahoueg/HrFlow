{% extends 'base.html.twig' %}

{% block title %}HR Dashboard | HrFlow{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8fafc] font-[Manrope,sans-serif]">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-72 transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            {# Welcome banner #}
            <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-teal-500 via-emerald-600 to-green-700 p-8 text-white">
                <div class="absolute top-0 right-0 w-80 h-80 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
                <div class="absolute bottom-0 left-1/4 w-48 h-48 bg-white/5 rounded-full translate-y-1/2"></div>
                <div class="relative">
                    <p class="text-teal-100 text-sm font-medium mb-1">Welcome back</p>
                    <h2 class="text-3xl font-extrabold mb-2">{{ user.userIdentifier }}</h2>
                    <p class="text-teal-50/80 max-w-md">Manage your team, approve leave requests, and keep track of recruitment and training programs.</p>
                </div>
            </div>

            {# Stats #}
            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5">
                <div class="group bg-white rounded-2xl border border-slate-200/60 p-6 hover:shadow-lg hover:shadow-teal-500/5 hover:border-teal-200 transition-all duration-300">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-teal-400 to-emerald-600 flex items-center justify-center shadow-lg shadow-teal-500/25">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-slate-800">--</p>
                    <p class="text-sm text-slate-400 mt-1">My Employees</p>
                </div>

                <div class="group bg-white rounded-2xl border border-slate-200/60 p-6 hover:shadow-lg hover:shadow-amber-500/5 hover:border-amber-200 transition-all duration-300">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center shadow-lg shadow-amber-500/25">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
                    </div>
                    <p class="text-3xl font-extrabold text-slate-800">--</p>
                    <p class="text-sm text-slate-400 mt-1">Pending Leaves</p>
                </div>

                <div class="group bg-white rounded-2xl border border-slate-200/60 p-6 hover:shadow-lg hover:shadow-purple-500/5 hover:border-purple-200 transition-all duration-300">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-500 to-violet-600 flex items-center justify-center shadow-lg shadow-purple-500/25">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-slate-800">--</p>
                    <p class="text-sm text-slate-400 mt-1">Open Positions</p>
                </div>

                <div class="group bg-white rounded-2xl border border-slate-200/60 p-6 hover:shadow-lg hover:shadow-blue-500/5 hover:border-blue-200 transition-all duration-300">
                    <div class="flex items-center justify-between mb-4">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-blue-500/25">
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-slate-800">--</p>
                    <p class="text-sm text-slate-400 mt-1">Training Sessions</p>
                </div>
            </div>

            {# Main content #}
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                <div class="xl:col-span-2 bg-white rounded-2xl border border-slate-200/60 p-6">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-lg font-bold text-slate-800">Recent Activity</h3>
                        <button class="text-xs font-semibold text-teal-500 hover:text-teal-600 px-3 py-1.5 rounded-lg hover:bg-teal-50 transition-colors">View All</button>
                    </div>
                    <div class="space-y-4">
                        <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50/50 border border-slate-100">
                            <div class="w-10 h-10 rounded-xl bg-teal-100 flex items-center justify-center shrink-0">
                                <svg class="w-5 h-5 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <div>
                                <p class="text-sm font-medium text-slate-600">No recent activity to display.</p>
                                <p class="text-xs text-slate-400 mt-0.5">Activity will appear here as events occur</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/60 p-6">
                    <h3 class="text-lg font-bold text-slate-800 mb-6">Your Profile</h3>
                    <div class="flex flex-col items-center text-center mb-6">
                        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-teal-400 to-emerald-600 flex items-center justify-center shadow-xl shadow-teal-500/20 mb-4">
                            <span class="text-2xl font-bold text-white">{{ user.userIdentifier|first|upper }}</span>
                        </div>
                        <p class="text-lg font-bold text-slate-800">{{ user.userIdentifier }}</p>
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-teal-50 text-teal-600 mt-2">
                            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 mr-1.5"></span>
                            HR MANAGER
                        </span>
                    </div>
                    <div class="space-y-3 pt-4 border-t border-slate-100">
                        {% if user.email is defined and user.email %}
                        <div class="flex items-center gap-3 text-sm">
                            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                            <span class="text-slate-600 truncate">{{ user.email }}</span>
                        </div>
                        {% endif %}
                        <div class="flex items-center gap-3 text-sm">
                            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                            <span class="text-slate-600">Team Management Access</span>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
