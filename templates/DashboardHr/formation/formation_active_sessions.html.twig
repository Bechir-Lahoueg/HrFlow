{% extends 'base.html.twig' %}

{% block title %}RH - Sessions actives{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-6xl mx-auto">
            <div class="flex items-center justify-between gap-3">
                <div>
                    <h2 class="text-2xl font-extrabold text-zinc-900 dark:text-zinc-100">Sessions actives</h2>
                    <p class="text-sm text-zinc-500">Acces rapide a la gestion des presences</p>
                </div>
                <a href="{{ path('rh_formation_list') }}" class="text-sm font-semibold text-[#145EB7] hover:text-[#022E69]">Retour</a>
            </div>

            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% for session in sessions %}
                        {% set formation = session.formation %}
                        <article class="rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-4 bg-zinc-50/50 dark:bg-zinc-900/60">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="text-sm font-bold text-zinc-900 dark:text-zinc-100 truncate">{{ formation.titre }}</p>
                                    <p class="text-xs text-zinc-500 mt-1">{{ session.dateDebut|date('d/m/Y') }} - {{ session.dateFin|date('d/m/Y') }}</p>
                                    <p class="text-xs text-zinc-500">{{ session.lieu ?: 'Lieu non precise' }}</p>
                                </div>
                                <span class="px-2 py-1 rounded text-[11px] font-bold bg-amber-100 text-amber-700 border border-amber-200">En cours</span>
                            </div>
                            <div class="mt-4 flex justify-end">
                                <a href="{{ path('rh_formation_session_presence', {id: session.id}) ~ '?return=active' }}" class="px-3 py-2 rounded-lg bg-[#145EB7] hover:bg-[#022E69] text-white text-xs font-bold transition">Gerer les presences</a>
                            </div>
                        </article>
                    {% else %}
                        <div class="col-span-full py-10 text-center text-sm text-zinc-500 border border-dashed border-zinc-200 rounded-xl">
                            Aucune session active pour le moment.
                        </div>
                    {% endfor %}
                </div>
            </section>
        </main>
    </div>
</div>
{% endblock %}


