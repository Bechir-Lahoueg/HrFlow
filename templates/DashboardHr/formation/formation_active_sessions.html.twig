{% extends 'base.html.twig' %}

{% block title %}RH — Sessions actives{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
    :root {
        --deep:    #022E69;
        --primary: #145EB7;
        --accent:  #3FA9F5;
        --light:   rgba(63,169,245,.1);
        --border:  #dce6f5;
        --bg:      #f4f7fb;
        --surface: #ffffff;
        --text:    #0d1f3c;
        --muted:   #6b82a8;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: 'DM Sans', system-ui, sans-serif; background: var(--bg); color: var(--text); }

    /* ── Hero ── */
    .hero-banner {
        background: linear-gradient(135deg, #022E69 0%, #0a3d8f 55%, #051f3d 100%);
        border-radius: 1rem;
        padding: 2rem 2.25rem;
        position: relative; overflow: hidden;
        box-shadow: 0 8px 32px -8px rgba(2,46,105,.35);
    }
    .hero-banner::before {
        content: ''; position: absolute; right: -60px; top: -60px;
        width: 220px; height: 220px; border-radius: 50%;
        background: radial-gradient(circle, rgba(63,169,245,.18), transparent 70%);
    }
    .hero-banner::after {
        content: ''; position: absolute; left: -40px; bottom: -60px;
        width: 180px; height: 180px; border-radius: 50%;
        background: radial-gradient(circle, rgba(20,94,183,.2), transparent 70%);
    }
    .hero-badge {
        display: inline-flex; align-items: center; gap: .4rem;
        font-size: .65rem; font-weight: 800; letter-spacing: .12em;
        text-transform: uppercase; color: #3FA9F5;
        margin-bottom: .6rem; position: relative; z-index: 1;
    }
    .hero-badge .dot {
        width: 6px; height: 6px; border-radius: 50%; background: #3FA9F5;
        animation: pulse-dot 2s ease-in-out infinite;
    }
    @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.4)} }
    .hero-banner h2  { font-size: 1.9rem; font-weight: 800; color: #fff; margin: 0 0 .3rem; position: relative; z-index: 1; }
    .hero-banner p   { font-size: .875rem; color: #93c5fd; margin: 0; position: relative; z-index: 1; }
    .hero-actions    { display: flex; align-items: center; gap: .75rem; margin-top: 1.25rem; position: relative; z-index: 1; flex-wrap: wrap; }
    .hero-stat-pill  {
        display: inline-flex; align-items: center; gap: .5rem;
        background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18);
        border-radius: 99px; padding: .35rem 1rem;
        font-size: .78rem; font-weight: 800; color: #e0f2fe;
        backdrop-filter: blur(6px);
    }
    .hero-stat-pill .count { font-size: 1.1rem; font-weight: 800; color: #fff; }

    /* ── Back link ── */
    .back-link {
        display: inline-flex; align-items: center; gap: .45rem;
        font-size: .8rem; font-weight: 700; color: var(--deep);
        text-decoration: none; transition: color .15s;
    }
    .back-link:hover { color: var(--primary); }

    /* ── Card surface ── */
    .fp-surface {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 1rem;
        box-shadow: 0 2px 16px -4px rgba(2,46,105,.1);
    }

    /* ── Session cards ── */
    .session-card {
        border-radius: .875rem;
        border: 1px solid var(--border);
        background: linear-gradient(160deg, #fff 60%, #f4f8ff 100%);
        padding: 1.25rem;
        transition: transform .2s, box-shadow .2s;
        display: flex; flex-direction: column; gap: .85rem;
    }
    .session-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px -12px rgba(2,46,105,.28);
    }

    /* ── Status badge ── */
    .badge-encours {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .28rem .75rem; border-radius: 99px;
        font-size: .68rem; font-weight: 800;
        background: #fffbeb; border: 1px solid #fde68a; color: #b45309;
        white-space: nowrap; flex-shrink: 0;
    }
    .badge-encours .dot { width: 6px; height: 6px; border-radius: 50%; background: #f59e0b; flex-shrink: 0; animation: pulse-dot 2s ease-in-out infinite; }

    /* ── Formation title row ── */
    .session-title {
        font-size: .9rem; font-weight: 800; color: var(--deep);
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .session-date {
        font-size: .75rem; color: var(--muted); font-weight: 600; margin-top: .15rem;
        font-variant-numeric: tabular-nums;
    }

    /* ── Info tile ── */
    .info-tile {
        background: #f8fafd; border: 1px solid var(--border);
        border-radius: .625rem; padding: .6rem .85rem;
        display: flex; align-items: center; gap: .5rem;
    }
    .info-tile svg { flex-shrink: 0; color: var(--primary); }
    .info-tile .val { font-size: .78rem; font-weight: 600; color: var(--text); }
    .info-tile a.val { color: var(--primary); text-decoration: underline; }
    .info-tile a.val:hover { color: var(--deep); }

    /* ── Presence button ── */
    .btn-presence {
        display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
        background: linear-gradient(135deg, var(--deep), var(--primary));
        color: #fff; padding: .6rem 1.25rem; border-radius: 9px;
        font-size: .8rem; font-weight: 800; font-family: inherit;
        text-decoration: none;
        box-shadow: 0 3px 12px -4px rgba(2,46,105,.4);
        transition: all .15s;
    }
    .btn-presence:hover { transform: translateY(-1px); box-shadow: 0 6px 20px -6px rgba(2,46,105,.5); color: #fff; }

    /* ── Empty state ── */
    .empty-state {
        border: 2px dashed var(--border); border-radius: 1rem;
        padding: 3.5rem 2rem; text-align: center; background: #f8fafd;
    }

    /* ── Section header ── */
    .section-icon {
        width: 36px; height: 36px; border-radius: .6rem;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f4f7fb] dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-6xl mx-auto">

            {# ── Back ── #}
            <a href="{{ path('rh_formation_list') }}" class="back-link">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7m11 7H3"/></svg>
                Retour aux formations
            </a>

            {# ── Hero ── #}
            <section class="hero-banner animate-slide-up">
                <div class="hero-badge"><span class="dot"></span>RH Control Center</div>
                <h2>Sessions actives</h2>
                <p>Accès rapide à la gestion des présences en cours.</p>
                <div class="hero-actions">
                    <span class="hero-stat-pill">
                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        <span class="count">{{ sessions|length }}</span>
                        session{{ sessions|length != 1 ? 's' : '' }} en cours
                    </span>
                </div>
            </section>

            {# ── Cards grid ── #}
            <section class="fp-surface p-6 animate-slide-up">

                <div style="display:flex; align-items:center; gap:.75rem; margin-bottom:1.5rem;">
                    <div class="section-icon">
                        <svg width="16" height="16" fill="none" stroke="white" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                    </div>
                    <div>
                        <p style="font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:0;">En temps réel</p>
                        <p style="font-size:.95rem;font-weight:800;color:var(--deep);margin:0;">Sessions en cours de formation</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    {% for session in sessions %}
                        {% set formation = session.formation %}
                        {% set lowerLieu = (session.lieu|default(''))|lower %}
                        {% set isLink = lowerLieu starts with 'http://' or lowerLieu starts with 'https://' %}

                        <article class="session-card">

                            {# Title + badge #}
                            <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:.75rem;">
                                <div style="min-width:0;">
                                    <p class="session-title">{{ formation.titre }}</p>
                                    <p class="session-date">{{ session.dateDebut|date('d/m/Y') }} — {{ session.dateFin|date('d/m/Y') }}</p>
                                </div>
                                <span class="badge-encours">
                                    <span class="dot"></span>En cours
                                </span>
                            </div>

                            {# Lieu / Lien #}
                            <div class="info-tile">
                                <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    {% if isLink %}
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5M15 13.5V18a2 2 0 01-2 2H6a2 2 0 01-2-2v-7a2 2 0 012-2h4.5"/>
                                    {% else %}
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                                    {% endif %}
                                </svg>
                                {% if isLink %}
                                    <a href="{{ session.lieu }}" target="_blank" rel="noopener noreferrer" class="val">
                                        {{ 'meet.jit.si' in session.lieu ? 'Ouvrir Jitsi Meet' : 'Ouvrir le lien de session' }}
                                        <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:inline;margin-left:.2rem"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5"/></svg>
                                    </a>
                                {% else %}
                                    <span class="val">{{ session.lieu ?: 'Lieu non précisé' }}</span>
                                {% endif %}
                            </div>

                            {# CTA #}
                            <div style="display:flex; justify-content:flex-end;">
                                <a href="{{ path('rh_formation_session_presence', {id: session.id}) ~ '?return=active' }}" class="btn-presence">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                    Gérer les présences
                                </a>
                            </div>

                        </article>

                    {% else %}
                        <div class="col-span-full">
                            <div class="empty-state">
                                <div style="width:48px;height:48px;border-radius:.75rem;background:var(--light);display:flex;align-items:center;justify-content:center;margin:0 auto .75rem;">
                                    <svg width="22" height="22" fill="none" stroke="#145EB7" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                </div>
                                <p style="font-size:.95rem;font-weight:700;color:var(--deep);margin:0 0 .3rem;">Aucune session active</p>
                                <p style="font-size:.82rem;color:var(--muted);margin:0;">Aucune session n'est en cours pour le moment.</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>

            </section>

        </main>
    </div>
</div>
{% endblock %}
