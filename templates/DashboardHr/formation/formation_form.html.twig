{% extends 'base.html.twig' %}

{% block title %}RH - {{ isEdit ? 'Modifier' : 'Créer' }} Formation{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-dark: #022E69;   /* Sidebar / Header / Titres */
            --primary-blue: #145EB7;   /* Boutons principaux */
            --accent-blue: #3FA9F5;    /* Accents / Hover */
            --border-gray: #D0D0D0;    /* Bordures secondaires */
        }

        .dot-grid {
            background-image: radial-gradient(var(--border-gray) 1px, transparent 0);
            background-size: 24px 24px;
        }

        /* Style des champs personnalisé : Cadre bleu très fin */
        .custom-input {
            border: 1px solid var(--primary-dark) !important;
            background-color: #ffffff !important;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            color: #1a1a1a;
        }

        .custom-input:focus {
            border-color: var(--accent-blue) !important;
            border-width: 1.5px !important;
            box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.15) !important;
            outline: none;
        }

        .form-card {
            border: 1px solid var(--border-gray);
            transition: transform 0.3s ease;
        }

        .text-primary-dark { color: var(--primary-dark); }
        .bg-primary-dark { background-color: var(--primary-dark); }
        .bg-primary-blue { background-color: var(--primary-blue); }

        /* Animation d'entrée */
        .animate-fade-in {
            animation: fadeIn 0.5s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#F9FBFF] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="px-8 mt-10 pb-16 w-full max-w-5xl mx-auto animate-fade-in">

            {# Flash Messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-6 px-5 py-4 rounded-2xl border flex items-center gap-3 shadow-sm bg-white
                        {{ label == 'success' ? 'border-emerald-200 text-emerald-800' : 'border-red-200 text-red-800' }}">
                        <div class="{{ label == 'success' ? 'bg-emerald-500' : 'bg-red-500' }} text-white rounded-full p-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="{{ label == 'success' ? 'M5 13l4 4L19 7' : 'M6 18L18 6M6 6l12 12' }}"/></svg>
                        </div>
                        <span class="text-sm font-bold">{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h2 class="text-3xl font-extrabold tracking-tight text-primary-dark">
                        {{ isEdit ? 'Modifier la formation' : 'Nouvelle formation' }}
                    </h2>
                    <p class="text-zinc-500 mt-1 font-medium italic">Configuration du catalogue de formation</p>
                </div>
                <a href="{{ path('rh_formation_list') }}"
                   class="inline-flex items-center text-sm font-bold text-zinc-500 hover:text-primary-blue transition-all group">
                    <div class="mr-3 p-2 rounded-xl bg-white border border-gray-200 group-hover:border-primary-blue shadow-sm transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    </div>
                    Retour à la liste
                </a>
            </div>

            <div class="bg-white rounded-[2rem] shadow-xl p-8 md:p-12 form-card">
                {{ form_start(formationForm, {'attr': {'id': 'formationForm', 'class': 'space-y-8', 'novalidate': 'novalidate'}}) }}

                    <div class="space-y-2">
                        <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1">Titre de la formation</label>
                        {{ form_widget(formationForm.titre, {'attr': {'class': 'custom-input block w-full rounded-xl py-4 px-5 text-base transition-all', 'placeholder': 'Ex: Management de Projet Agile'}}) }}
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1">Catégorie</label>
                            {{ form_widget(formationForm.type, {'attr': {'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all'}}) }}
                        </div>
                        <div class="space-y-2">
                            <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1">Durée (en jours)</label>
                            {{ form_widget(formationForm.duree, {'attr': {'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all'}}) }}
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1">Organisme </label>
                        {{ form_widget(formationForm.organisme, {'attr': {'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all', 'placeholder': "Nom de l'organisme formateur"}}) }}
                    </div>

                    <div class="space-y-2">
                        <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1">Description</label>
                        {{ form_widget(formationForm.description, {'attr': {'rows': 3, 'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all'}}) }}
                    </div>

                    <div class="bg-zinc-50 rounded-2xl p-6 border border-zinc-100 space-y-4">
                        <div class="flex items-center justify-between">
                            <label class="text-primary-dark font-bold text-xs tracking-widest uppercase flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full bg-accent-blue"></span>
                                Objectifs Pédagogiques
                            </label>
                            <button type="button" id="btn-generate-ai"
                                    class="inline-flex items-center px-4 py-2 bg-primary-dark text-white text-xs font-bold rounded-xl hover:shadow-lg hover:shadow-primary-dark/20 transition-all active:scale-95 group">
                                <i class="feather-cpu mr-2 group-hover:rotate-12 transition-transform"></i>
                                Générer avec l'IA
                            </button>
                        </div>
                        {{ form_widget(formationForm.objectifs, {'attr': {'rows': 5, 'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all shadow-inner', 'placeholder': 'Compétences attendues...'}}) }}
                        {{ form_errors(formationForm.objectifs) }}
                    </div>

                    <div class="flex flex-col md:flex-row items-center justify-end gap-4 pt-8 border-t border-gray-100">
                        <a href="{{ path('rh_formation_list') }}"
                           class="w-full md:w-auto px-8 py-4 rounded-xl text-zinc-500 font-bold hover:bg-zinc-50 transition-all text-center">
                            Annuler
                        </a>
                        <button type="submit"
                                class="w-full md:w-auto px-10 py-4 rounded-xl bg-primary-blue text-white font-bold shadow-lg shadow-blue-900/20 hover:bg-primary-dark hover:scale-[1.02] transition-all flex items-center justify-center">
                            <i class="feather-save mr-2"></i>
                            {{ isEdit ? 'Mettre à jour' : 'Enregistrer la formation' }}
                        </button>
                    </div>
                {{ form_end(formationForm) }}
            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const btnAi = document.getElementById('btn-generate-ai');
            const titreInput = document.querySelector('input[id$="_titre"]');
            const objectifsTextarea = document.querySelector('textarea[id$="_objectifs"]');

            if (btnAi && titreInput && objectifsTextarea) {
                btnAi.addEventListener('click', async (e) => {
                    e.preventDefault();
                    const titre = titreInput.value.trim();

                    if (!titre) {
                        titreInput.style.borderColor = "#ef4444";
                        alert("Veuillez saisir un titre.");
                        titreInput.focus();
                        return;
                    }
                    titreInput.style.borderColor = "var(--primary-dark)";

                    const originalHTML = btnAi.innerHTML;
                    btnAi.disabled = true;
                    btnAi.innerHTML = `<span class="animate-pulse italic">Analyse...</span>`;
                    objectifsTextarea.placeholder = "L'IA génère les objectifs stratégiques...";

                    try {
                        const response = await fetch("{{ path('rh_formation_generate_ai') }}", {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `titre=${encodeURIComponent(titre)}`
                        });

                        const data = await response.json();
                        if (data.objectifs) {
                            objectifsTextarea.value = data.objectifs;
                        } else {
                            alert("Erreur de génération.");
                        }
                    } catch (error) {
                        alert("Erreur réseau.");
                    } finally {
                        btnAi.disabled = false;
                        btnAi.innerHTML = originalHTML;
                        objectifsTextarea.placeholder = "Compétences attendues...";
                    }
                });
            }
        });
    </script>
{% endblock %}