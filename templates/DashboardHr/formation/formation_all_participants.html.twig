{% extends 'base.html.twig' %}

{% block title %}RH — Tous les Participants{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
    :root {
        --deep:    #022E69;
        --primary: #145EB7;
        --accent:  #3FA9F5;
        --light:   rgba(63,169,245,.1);
        --border:  #dce6f5;
        --bg:      #f4f7fb;
        --surface: #ffffff;
        --text:    #0d1f3c;
        --muted:   #6b82a8;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: 'DM Sans', system-ui, sans-serif; background: var(--bg); color: var(--text); }

    /* ── Hero ── */
    .hero-banner {
        background: linear-gradient(135deg, #022E69 0%, #0a3d8f 55%, #051f3d 100%);
        border-radius: 1rem;
        padding: 2rem 2.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 8px 32px -8px rgba(2,46,105,.35);
    }
    .hero-banner::before {
        content: '';
        position: absolute; right: -60px; top: -60px;
        width: 220px; height: 220px; border-radius: 50%;
        background: radial-gradient(circle, rgba(63,169,245,.18), transparent 70%);
    }
    .hero-banner::after {
        content: '';
        position: absolute; left: -40px; bottom: -60px;
        width: 180px; height: 180px; border-radius: 50%;
        background: radial-gradient(circle, rgba(20,94,183,.2), transparent 70%);
    }
    .hero-badge {
        display: inline-flex; align-items: center; gap: .4rem;
        font-size: .65rem; font-weight: 800; letter-spacing: .12em;
        text-transform: uppercase; color: #3FA9F5;
        margin-bottom: .6rem; position: relative; z-index: 1;
    }
    .hero-badge .dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: #3FA9F5;
        animation: pulse-dot 2s ease-in-out infinite;
    }
    @keyframes pulse-dot {
        0%,100% { opacity:1; transform:scale(1); }
        50%      { opacity:.5; transform:scale(1.4); }
    }
    .hero-banner h2   { font-size: 1.9rem; font-weight: 800; color: #fff; margin: 0 0 .4rem; position: relative; z-index: 1; }
    .hero-banner p    { font-size: .875rem; color: #93c5fd; margin: 0; position: relative; z-index: 1; }
    .hero-meta        { display: flex; align-items: center; gap: 1.5rem; margin-top: 1.25rem; position: relative; z-index: 1; }
    .hero-stat        { display: flex; flex-direction: column; }
    .hero-stat .num   { font-size: 1.6rem; font-weight: 800; color: #fff; line-height: 1; }
    .hero-stat .lbl   { font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: rgba(63,169,245,.75); }
    .hero-divider     { width: 1px; height: 36px; background: rgba(255,255,255,.15); }

    /* ── Card surface ── */
    .fp-surface {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 1rem;
        box-shadow: 0 2px 16px -4px rgba(2,46,105,.1);
    }

    /* ── Filter bar ── */
    .filter-bar {
        background: #f8fafd;
        border: 1px solid var(--border);
        border-radius: .75rem;
        padding: .85rem 1rem;
        display: flex; flex-wrap: wrap; gap: .6rem; align-items: center;
        margin-bottom: 1.25rem;
    }
    .filter-bar select,
    .filter-bar label.check-wrap {
        background: #fff;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        padding: .45rem .85rem;
        font-size: .8rem;
        font-weight: 600;
        color: var(--text);
        font-family: inherit;
        cursor: pointer;
        transition: border-color .15s;
    }
    .filter-bar select:focus { border-color: var(--accent); outline: none; box-shadow: 0 0 0 3px rgba(63,169,245,.15); }
    .filter-bar label.check-wrap { display: inline-flex; align-items: center; gap: .5rem; color: var(--muted); }
    .filter-bar label.check-wrap input[type=checkbox] { accent-color: var(--primary); }
    .btn-filter {
        background: linear-gradient(135deg, var(--deep), var(--primary));
        color: #fff; border: none; border-radius: 8px;
        padding: .5rem 1.1rem; font-size: .8rem; font-weight: 700;
        font-family: inherit; cursor: pointer;
        transition: all .15s; box-shadow: 0 3px 10px -3px rgba(2,46,105,.35);
    }
    .btn-filter:hover { transform: translateY(-1px); box-shadow: 0 5px 16px -4px rgba(2,46,105,.45); }
    .btn-reset {
        color: var(--muted); background: none; border: none; cursor: pointer; display: flex; align-items: center; padding: 0 .25rem;
        transition: color .15s;
    }
    .btn-reset:hover { color: #ef4444; }

    /* ── Table ── */
    .fp-table-wrap {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: .75rem;
        max-height: 70vh;
    }
    .fp-table { min-width: 820px; border-collapse: collapse; width: 100%; }
    .fp-table thead th {
        position: sticky; top: 0; z-index: 10;
        background: #edf4ff;
        color: var(--deep);
        font-size: .65rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em;
        padding: .8rem 1rem;
        border-bottom: 1px solid var(--border);
        white-space: nowrap;
    }
    .fp-row { transition: background .15s, transform .15s; }
    .fp-row:hover { background: #f3f8ff; transform: translateY(-1px); }
    .fp-row td { padding: .7rem 1rem; border-bottom: 1px solid #eef2f8; vertical-align: middle; }
    .fp-row:last-child td { border-bottom: none; }

    /* ── Avatar ── */
    .avatar {
        width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
        background: linear-gradient(135deg, var(--deep), var(--primary));
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: .7rem; font-weight: 800;
    }

    /* ── Badges ── */
    .badge-status {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .25rem .7rem; border-radius: 99px;
        font-size: .7rem; font-weight: 700; border: 1px solid transparent;
    }
    .badge-status .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .badge-inscrit      { background: #edf4ff; border-color: #bfdbfe; color: var(--primary); }
    .badge-inscrit .dot { background: var(--accent); }
    .badge-accepte      { background: #f0fdf4; border-color: #bbf7d0; color: #15803d; }
    .badge-accepte .dot { background: #22c55e; }
    .badge-refuse       { background: #fff0f0; border-color: #fecaca; color: #dc2626; }
    .badge-refuse .dot  { background: #ef4444; }
    .badge-certificat      { background: #eff6ff; border-color: #bfdbfe; color: var(--deep); }
    .badge-certificat .dot { background: var(--primary); }

    .badge-priority {
        display: inline-flex; align-items: center; gap: .3rem;
        font-size: .65rem; font-weight: 800; letter-spacing: .04em;
        background: rgba(20,94,183,.1); color: var(--primary);
        border: 1px solid rgba(20,94,183,.22); border-radius: 99px;
        padding: .15rem .6rem;
    }

    .badge-done {
        font-size: .7rem; font-weight: 700;
        background: #f8fafd; border: 1px solid var(--border);
        color: var(--muted); padding: .3rem .75rem; border-radius: 8px;
    }

    /* ── Action buttons ── */
    .btn-accept {
        font-size: .75rem; font-weight: 700; padding: .4rem .9rem; border-radius: 8px;
        background: var(--primary); color: #fff; border: none; cursor: pointer;
        display: inline-flex; align-items: center; gap: .4rem;
        transition: all .15s; font-family: inherit;
        box-shadow: 0 2px 8px -3px rgba(20,94,183,.45);
    }
    .btn-accept:hover { background: var(--deep); transform: translateY(-1px); }
    .btn-reject {
        font-size: .75rem; font-weight: 700; padding: .4rem .9rem; border-radius: 8px;
        background: #ef4444; color: #fff; border: none; cursor: pointer;
        display: inline-flex; align-items: center; gap: .4rem;
        transition: all .15s; font-family: inherit;
        box-shadow: 0 2px 8px -3px rgba(239,68,68,.35);
    }
    .btn-reject:hover { background: #dc2626; transform: translateY(-1px); }

    /* ── Back link ── */
    .back-link {
        display: inline-flex; align-items: center; gap: .45rem;
        font-size: .8rem; font-weight: 700; color: var(--deep);
        text-decoration: none; transition: color .15s;
    }
    .back-link:hover { color: var(--primary); }

    /* ── Flash ── */
    .flash-success { background:#f0fdf4; border:1px solid #bbf7d0; color:#15803d; border-radius:.75rem; padding:.7rem 1rem; font-size:.85rem; font-weight:600; display:flex; align-items:center; gap:.5rem; }
    .flash-error   { background:#fff0f0; border:1px solid #fecaca; color:#dc2626; border-radius:.75rem; padding:.7rem 1rem; font-size:.85rem; font-weight:600; display:flex; align-items:center; gap:.5rem; }

    /* ── Section header ── */
    .section-title-row { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:1.25rem; }
    .section-icon { width:36px; height:36px; border-radius:.6rem; background:linear-gradient(135deg,var(--primary),var(--accent)); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f4f7fb] dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ── Flash messages ── #}
            {% for message in app.flashes('success') %}
                <div class="flash-success animate-slide-up">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{ message }}
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="flash-error animate-slide-up">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                    {{ message }}
                </div>
            {% endfor %}

            {# ── Back ── #}
            <a href="{{ path('rh_formation_list') }}" class="back-link">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7m11 7H3"/></svg>
                Retour aux formations
            </a>

            {# ── Hero ── #}
            <section class="hero-banner animate-slide-up">
                <div class="hero-badge"><span class="dot"></span>RH Control Center</div>
                <h2>Tous les participants</h2>
                <p>Liste globale des employés inscrits aux sessions de formation.</p>
                <div class="hero-meta">
                    <div class="hero-stat">
                        <span class="num">{{ participations|length }}</span>
                        <span class="lbl">Participations</span>
                    </div>
                    <div class="hero-divider"></div>
                    <div class="hero-stat">
                        <span class="num">{{ participations|filter(p => p.statutParticipation == 'Accepte')|length }}</span>
                        <span class="lbl">Acceptées</span>
                    </div>
                    <div class="hero-divider"></div>
                    <div class="hero-stat">
                        <span class="num">{{ participations|filter(p => p.statutParticipation == 'Inscrit')|length }}</span>
                        <span class="lbl">En attente</span>
                    </div>
                </div>
            </section>

            {# ── Table card ── #}
            <section class="fp-surface p-6 animate-slide-up">

                <div class="section-title-row">
                    <div style="display:flex; align-items:center; gap:.75rem;">
                        <div class="section-icon">
                            <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                        </div>
                        <div>
                            <p style="font-size:.65rem; font-weight:800; text-transform:uppercase; letter-spacing:.1em; color:var(--muted); margin:0;">Vue globale</p>
                            <p style="font-size:.95rem; font-weight:800; color:var(--deep); margin:0;">Ensemble des participations</p>
                        </div>
                    </div>
                </div>

                {# ── Filters ── #}
                <form method="get" action="{{ path('rh_formation_all_participants') }}">
                    <div class="filter-bar">
                        <select name="formation">
                            <option value="">Toutes les formations</option>
                            {% for formation in formations %}
                                <option value="{{ formation.id }}" {% if filters.formation == formation.id %}selected{% endif %}>{{ formation.titre }}</option>
                            {% endfor %}
                        </select>

                        <select name="status">
                            <option value="">Tous les statuts</option>
                            <option value="Inscrit"           {% if filters.status == 'Inscrit' %}selected{% endif %}>Inscrit(e)</option>
                            <option value="Accepte"           {% if filters.status == 'Accepte' %}selected{% endif %}>Accepté(e)</option>
                            <option value="Refuse"            {% if filters.status == 'Refuse' %}selected{% endif %}>Refusé(e)</option>
                            <option value="Certificat obtenu" {% if filters.status == 'Certificat obtenu' %}selected{% endif %}>Certificat obtenu</option>
                        </select>

                        <label class="check-wrap">
                            <input type="checkbox" name="priorityOnly" value="1" {{ filters.priorityOnly ? 'checked' : '' }}>
                            Prioritaires seulement
                        </label>

                        <button type="submit" class="btn-filter">
                            <svg style="display:inline;width:13px;height:13px;margin-right:4px" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                            Filtrer
                        </button>

                        {% if filters.status or filters.formation or filters.priorityOnly %}
                        <a href="{{ path('rh_formation_all_participants') }}" class="btn-reset" title="Réinitialiser">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                        </a>
                        {% endif %}
                    </div>
                </form>

                {# ── Table ── #}
                <div class="fp-table-wrap">
                    <table class="fp-table">
                        <thead>
                            <tr>
                                <th>Employé</th>
                                <th>Formation / Session</th>
                                <th>Date de demande</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for participation in participations %}
                            <tr class="fp-row">
                                {# Employé #}
                                <td>
                                    <div style="display:flex; align-items:center; gap:.65rem;">
                                        <div class="avatar">
                                            {{ participation.employee.firstName|first|upper }}{{ participation.employee.lastName|first|upper }}
                                        </div>
                                        <div>
                                            <div style="display:flex; align-items:center; gap:.4rem; flex-wrap:wrap;">
                                                <span style="font-size:.82rem; font-weight:700; color:var(--deep);">{{ participation.employee.firstName }} {{ participation.employee.lastName }}</span>
                                                {% if participation.employee.rhId == participation.session.formation.rhId %}
                                                    <span class="badge-priority">
                                                        <svg width="9" height="9" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
                                                        Prioritaire RH
                                                    </span>
                                                {% endif %}
                                            </div>
                                            <span style="font-size:.72rem; color:var(--muted);">{{ participation.employee.email }}</span>
                                        </div>
                                    </div>
                                </td>

                                {# Formation #}
                                <td>
                                    <span style="font-size:.82rem; font-weight:700; color:var(--deep); display:block;">{{ participation.session.formation.titre }}</span>
                                    <span style="font-size:.72rem; color:var(--muted);">{{ participation.session.dateDebut|date('d/m/Y') }} – {{ participation.session.dateFin|date('d/m/Y') }} · {{ participation.session.lieu }}</span>
                                </td>

                                {# Date #}
                                <td style="font-size:.82rem; font-weight:700; color:var(--deep); white-space:nowrap;">
                                    {{ participation.dateInscription|date('d M Y') }}
                                </td>

                                {# Statut #}
                                <td>
                                    {% set s = participation.statutParticipation %}
                                    <span class="badge-status
                                        {% if s == 'Inscrit' %}badge-inscrit
                                        {% elseif s == 'Accepte' %}badge-accepte
                                        {% elseif s == 'Refuse' %}badge-refuse
                                        {% else %}badge-certificat{% endif %}">
                                        <span class="dot"></span>
                                        {{ s }}
                                    </span>
                                </td>

                                {# Actions #}
                                <td>
                                    {% if participation.statutParticipation == 'Inscrit' %}
                                        <div style="display:flex; gap:.5rem; flex-wrap:wrap;">
                                            <form method="post" action="{{ path('rh_formation_participation_approve', {id: participation.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('approve-participation-' ~ participation.id) }}">
                                                <button type="submit" class="btn-accept">
                                                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                                                    Accepter
                                                </button>
                                            </form>
                                            <form method="post" action="{{ path('rh_formation_participation_reject', {id: participation.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('reject-participation-' ~ participation.id) }}">
                                                <input type="hidden" name="refusal_reason" value="">
                                                <button type="submit"
                                                    onclick="const r=window.prompt('Motif du refus (optionnel) :',''); if(r===null)return false; this.form.querySelector('input[name=&quot;refusal_reason&quot;]').value=r.trim();"
                                                    class="btn-reject">
                                                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                                                    Refuser
                                                </button>
                                            </form>
                                        </div>
                                    {% else %}
                                        <span class="badge-done">Action traitée</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" style="padding:3.5rem 1rem; text-align:center; color:var(--muted); font-size:.875rem;">
                                    Aucune participation trouvée.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

            </section>
        </main>
    </div>
</div>
{% endblock %}
