{% extends 'base.html.twig' %}

{% block title %}RH - {{ isEdit ? 'Modifier' : 'Créer' }} Session{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-dark: #022E69;
            --primary-blue: #145EB7;
            --accent-blue: #3FA9F5;
            --border-gray: #D0D0D0;
        }

        .dot-grid {
            background-image: radial-gradient(var(--border-gray) 1px, transparent 0);
            background-size: 24px 24px;
        }

        .custom-input {
            border: 1px solid var(--primary-dark) !important;
            background-color: #ffffff !important;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            color: #1a1a1a;
        }

        .custom-input:focus {
            border-color: var(--accent-blue) !important;
            border-width: 1.5px !important;
            box-shadow: 0 0 0 4px rgba(63, 169, 245, 0.15) !important;
            outline: none;
        }

        .form-card {
            border: 1px solid var(--border-gray);
            transition: transform 0.3s ease;
        }

        .text-primary-dark { color: var(--primary-dark); }
        .bg-primary-dark { background-color: var(--primary-dark); }
        .bg-primary-blue { background-color: var(--primary-blue); }

        .animate-fade-in {
            animation: fadeIn 0.5s ease-out;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#F9FBFF] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="px-8 mt-10 pb-16 w-full max-w-5xl mx-auto animate-fade-in">

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-6 px-5 py-4 rounded-2xl border flex items-center gap-3 shadow-sm bg-white
                        {{ label == 'success' ? 'border-emerald-200 text-emerald-800' : 'border-red-200 text-red-800' }}">
                        <div class="{{ label == 'success' ? 'bg-emerald-500' : 'bg-red-500' }} text-white rounded-full p-1">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="{{ label == 'success' ? 'M5 13l4 4L19 7' : 'M6 18L18 6M6 6l12 12' }}"/></svg>
                        </div>
                        <span class="text-sm font-bold">{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}

            <div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div>
                    <h2 class="text-3xl font-extrabold tracking-tight text-primary-dark">
                        {{ isEdit ? 'Modifier la session' : 'Nouvelle session' }}
                    </h2>
                    <p class="text-zinc-500 mt-1 font-medium italic">
                        Formation : <span class="text-primary-blue font-bold">"{{ formation.titre }}"</span>
                    </p>
                </div>
                <a href="{{ path('rh_formation_sessions', {'id': formation.id}) }}"
                   class="inline-flex items-center text-sm font-bold text-zinc-500 hover:text-primary-blue transition-all group">
                    <div class="mr-3 p-2 rounded-xl bg-white border border-gray-200 group-hover:border-primary-blue shadow-sm transition-all">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
                    </div>
                    Retour aux sessions
                </a>
            </div>

            <div class="bg-white rounded-[2rem] shadow-xl p-8 md:p-12 form-card">
                {{ form_start(sessionForm, {'attr': {'id': 'sessionForm', 'class': 'space-y-8', 'novalidate': 'novalidate' }}) }}

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-2">
                            <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1">Date de début</label>
                            {{ form_widget(sessionForm.dateDebut, {'attr': {'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all'}}) }}
                            <div class="text-red-500 text-xs font-semibold mt-1">{{ form_errors(sessionForm.dateDebut) }}</div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1 flex justify-between">
                                Date de fin
                                <span class="text-[10px] text-accent-blue lowercase tracking-normal bg-blue-50 px-2 flex items-center rounded">Calcul auto</span>
                            </label>
                            {{ form_widget(sessionForm.dateFin, {'attr': {'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all bg-gray-50 cursor-not-allowed', 'readonly': 'readonly'}}) }}
                            <div class="text-red-500 text-xs font-semibold mt-1">{{ form_errors(sessionForm.dateFin) }}</div>
                            <p class="text-[11px] text-zinc-400 ml-1 italic">Basée sur la durée de {{ formation.duree }} jours.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <div class="md:col-span-2 space-y-2">
                            <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1">Lieu de la session</label>
                            {{ form_widget(sessionForm.lieu, {'attr': {'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all', 'placeholder': 'Ex: Salle Polyvalente, Paris ou Distanciel'}}) }}
                            <div class="text-red-500 text-xs font-semibold mt-1">{{ form_errors(sessionForm.lieu) }}</div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1">Mode</label>
                            {{ form_widget(sessionForm.mode, {'attr': {'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all'}}) }}
                            <div class="text-red-500 text-xs font-semibold mt-1">{{ form_errors(sessionForm.mode) }}</div>
                        </div>
                    </div>

                    <div class="space-y-2 max-w-xs">
                        <label class="text-primary-dark font-bold text-xs tracking-widest uppercase ml-1">Capacité maximale</label>
                        {{ form_widget(sessionForm.capaciteMax, {'attr': {'class': 'custom-input block w-full rounded-xl py-4 px-5 transition-all', 'min': '1'}}) }}
                        <div class="text-red-500 text-xs font-semibold mt-1">{{ form_errors(sessionForm.capaciteMax) }}</div>
                    </div>

                    <div class="flex flex-col md:flex-row items-center justify-end gap-4 pt-8 border-t border-gray-100">
                        <a href="{{ path('rh_formation_sessions', {'id': formation.id}) }}"
                           class="w-full md:w-auto px-8 py-4 rounded-xl text-zinc-500 font-bold hover:bg-zinc-50 transition-all text-center">
                            Annuler
                        </a>
                        <button type="submit"
                                class="w-full md:w-auto px-10 py-4 rounded-xl bg-primary-blue text-white font-bold shadow-lg shadow-blue-900/20 hover:bg-primary-dark hover:scale-[1.02] transition-all flex items-center justify-center">
                            <i class="feather-save mr-2"></i>
                            {{ isEdit ? 'Mettre à jour' : 'Enregistrer la session' }}
                        </button>
                    </div>
                {{ form_end(sessionForm) }}
            </div>
        </main>
    </div>
</div>
{% endblock %}
{% block extra_js %}
    <script>
        function initCalculSession() {
            console.log("--- Initialisation du calcul ---");

            const dateDebutInput = document.querySelector('input[id$="_dateDebut"]');
            const dateFinInput = document.querySelector('input[id$="_dateFin"]');
            const duree = parseInt("{{ formation.duree }}", 10) || 1;

            if (dateDebutInput && dateFinInput) {
                console.log("Champs trouvés !");

                const calculer = () => {
                    if (dateDebutInput.value) {
                        const start = new Date(dateDebutInput.value);
                        if (!isNaN(start.getTime())) {
                            const end = new Date(start);
                            end.setDate(end.getDate() + (duree - 1));

                            const y = end.getFullYear();
                            const m = String(end.getMonth() + 1).padStart(2, '0');
                            const d = String(end.getDate()).padStart(2, '0');

                            dateFinInput.value = `${y}-${m}-${d}`;
                            console.log("Date de fin mise à jour :", dateFinInput.value);
                        }
                    }
                };

                dateDebutInput.addEventListener('input', calculer);

                if (dateDebutInput.value) calculer();
            } else {
                console.log("Champs introuvables dans le DOM actuel.");
            }
        }

        document.addEventListener('DOMContentLoaded', initCalculSession);

        document.addEventListener('turbo:load', initCalculSession);
    </script>
{% endblock %}