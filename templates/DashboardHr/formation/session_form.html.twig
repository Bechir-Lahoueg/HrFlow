{% extends 'base.html.twig' %} {# <--- CETTE LIGNE EST OBLIGATOIRE POUR UTILISER parent() #}

{% block title %}RH - {{ isEdit ? 'Modifier' : 'Créer' }} Session{% endblock %}

{% block body %} {# <--- IL FAUT OUVRIR LE BLOCK BODY ICI #}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 max-w-4xl mx-auto">
            <div class="mb-6">
                <a href="{{ path('rh_formation_sessions', {id: formation.id_formation}) }}" class="inline-flex items-center gap-2 text-zinc-600 hover:text-zinc-800 text-sm font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour aux sessions
                </a>
            </div>

            <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-8 shadow-sm form-card">
                <div class="mb-6">
                    <h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">{{ isEdit ? 'Modifier la Session' : 'Créer une Nouvelle Session' }}</h1>
                    <p class="text-zinc-600 dark:text-zinc-400 mt-1">
                        Formation : <span class="font-semibold text-teal-600">{{ formation.titre }}</span>
                    </p>
                </div>

                <form method="post" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {# Date de début #}
                        <div>
                            <label for="date_debut" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Date de début *</label>
                            <input type="date" id="date_debut" name="date_debut"
                                   value="{{ session.date_debut is defined and session.date_debut ? session.date_debut|date('Y-m-d') : '' }}" required
                                   class="w-full rounded-lg border-zinc-200 bg-zinc-50 text-sm focus:border-teal-500 focus:ring-teal-500 py-2.5 px-3">
                        </div>

                        {# Date de fin #}
                        <div>
                            <label for="date_fin" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2 flex items-center justify-between">
                                Date de fin
                                <span class="text-[10px] text-teal-600 bg-teal-50 px-2 py-0.5 rounded normal-case tracking-normal">Calcul auto</span>
                            </label>
                            <input type="date" id="date_fin" name="date_fin"
                                   value="{{ session.date_fin is defined and session.date_fin ? session.date_fin|date('Y-m-d') : '' }}" required readonly
                                   class="w-full rounded-lg border-zinc-200 bg-zinc-100 text-sm focus:border-teal-500 focus:ring-teal-500 py-2.5 px-3 cursor-not-allowed opacity-80">
                            <p class="text-[11px] text-slate-500 mt-1.5 flex items-center gap-1">
                                Basée sur la durée de {{ formation.duree ?? 1 }} jours.
                            </p>
                        </div>

                        {# Lieu #}
                        <div>
                            <label for="lieu" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Lieu *</label>
                            <input type="text" id="lieu" name="lieu" value="{{ session.lieu ?? '' }}" required
                                   placeholder="Ex: Salle A, Paris ou Distanciel"
                                   class="w-full rounded-lg border-zinc-200 bg-zinc-50 text-sm focus:border-teal-500 focus:ring-teal-500 py-2.5 px-3">
                        </div>

                        {# Mode de formation #}
                        <div>
                            <label for="mode" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Mode *</label>
                            <select id="mode" name="mode" required
                                    class="w-full rounded-lg border-zinc-200 bg-zinc-50 text-sm focus:border-teal-500 focus:ring-teal-500 py-2.5 px-3">
                                <option value="">Sélectionner un mode</option>
                                <option value="Présentiel" {{ (session.mode ?? '') == 'Présentiel' ? 'selected' : '' }}>Présentiel</option>
                                <option value="En ligne" {{ (session.mode ?? '') == 'En ligne' ? 'selected' : '' }}>En ligne</option>
                                <option value="Hybride" {{ (session.mode ?? '') == 'Hybride' ? 'selected' : '' }}>Hybride</option>
                            </select>
                        </div>

                        {# Capacité maximale #}
                        <div>
                            <label for="capacite_max" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Capacité maximale *</label>
                            <input type="number" id="capacite_max" name="capacite_max" value="{{ session.capacite_max ?? '' }}" min="1" required
                                   class="w-full rounded-lg border-zinc-200 bg-zinc-50 text-sm focus:border-teal-500 focus:ring-teal-500 py-2.5 px-3">
                        </div>
                    </div>

                    <div class="flex gap-3 pt-4">
                        <button type="submit" class="px-6 py-2.5 rounded-lg bg-gradient-to-r from-teal-600 to-emerald-600 text-white text-sm font-bold hover:from-teal-700 hover:to-emerald-700 transition-all shadow-sm flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            {{ isEdit ? 'Mettre à jour la Session' : 'Créer la Session' }}
                        </button>
                        <a href="{{ path('rh_formation_sessions', {id: formation.id_formation}) }}" class="px-6 py-2.5 rounded-lg border border-zinc-200 bg-white text-zinc-600 text-sm font-semibold hover:bg-zinc-50 transition-colors">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const dateDebutInput = document.getElementById('date_debut');
            const dateFinInput = document.getElementById('date_fin');
            const statutInput = document.getElementById('statut'); // Assure-toi que ton select/input a l'id "statut"
            const duree = {{ formation.duree ?? 1 }};

            function mettreAJourSession() {
                if (dateDebutInput.value) {
                    // 1. CALCUL DE LA DATE DE FIN
                    const dateDebut = new Date(dateDebutInput.value);
                    const dateFin = new Date(dateDebut);
                    dateFin.setDate(dateFin.getDate() + Math.max(0, duree - 1));

                    const annee = dateFin.getFullYear();
                    const mois = String(dateFin.getMonth() + 1).padStart(2, '0');
                    const jour = String(dateFin.getDate()).padStart(2, '0');
                    const dateFinStr = `${annee}-${mois}-${jour}`;

                    dateFinInput.value = dateFinStr;

                    // 2. CALCUL DU STATUT AUTO
                    const aujourdhui = new Date();
                    aujourdhui.setHours(0, 0, 0, 0);
                    dateDebut.setHours(0, 0, 0, 0);
                    dateFin.setHours(0, 0, 0, 0);

                    if (statutInput) {
                        if (aujourdhui < dateDebut) {
                            statutInput.value = 'Planifiee';
                        } else if (aujourdhui > dateFin) {
                            statutInput.value = 'Terminee';
                        } else {
                            statutInput.value = 'En cours';
                        }
                    }
                }
            }

            dateDebutInput.addEventListener('change', mettreAJourSession);

            if(dateDebutInput.value) {
                mettreAJourSession();
            }
        });
    </script>
{% endblock %}