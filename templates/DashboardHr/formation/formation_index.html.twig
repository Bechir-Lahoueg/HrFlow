{% extends 'base.html.twig' %}

{% block title %}RH - Gestion Formations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .decision-table thead th{position:sticky;top:0;z-index:10}
        .decision-row{transition:all .2s}
        .decision-row:hover{background:#f8fafc;transform:scale(1.001)}
        .filter-chip{transition:all .2s}
        .filter-chip:hover{transform:translateY(-1px)}
        .filter-chip.active{box-shadow:0 4px 14px -4px rgba(15,23,42,.3)}
        .credit-card{position:relative;overflow:hidden}
        .credit-card::before{content:'';position:absolute;top:-50%;right:-30%;width:8rem;height:8rem;border-radius:9999px;opacity:.06;pointer-events:none}
        .credit-card:nth-child(1)::before{background:radial-gradient(circle,#14b8a6,transparent 70%)}
        .credit-card:nth-child(2)::before{background:radial-gradient(circle,#f97316,transparent 70%)}
        .credit-card:nth-child(3)::before{background:radial-gradient(circle,#6366f1,transparent 70%)}
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ══════════ Hero Banner ══════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-sky-900 to-indigo-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-sky-300/15 blur-3xl mesh-blob"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-300/15 blur-3xl mesh-blob-alt"></div>
                <div class="relative z-10 grid lg:grid-cols-[1.15fr_0.85fr] gap-6">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-cyan-200 uppercase tracking-wider">RH Control Center</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Catalogue des Formations</h2>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">Gérez les formations, créez des sessions et suivez les participations des employés.</p>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-3">
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">Total Formations</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ stats.total_formations }}</p>
                            <p class="text-xs text-cyan-100/60 mt-1">dans le catalogue</p>
                        </div>
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">Sessions Actives</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ stats.active_sessions }}</p>
                            <p class="text-xs text-cyan-100/60 mt-1">en cours</p>
                        </div>
                    </div>
                </div>
            </section>

            {# ══════════ Stats Grid ══════════ #}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-1">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center">
                            <svg class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
                        </div>
                        <span class="text-[11px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md">Total</span>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 font-mono-num">{{ stats.total_formations }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Formations</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-full rounded-full bg-gradient-to-r from-slate-400 to-slate-300"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-2">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
                    </div>
                    <p class="text-3xl font-extrabold text-amber-600 font-mono-num">{{ stats.active_sessions }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Sessions actives</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-1/3 rounded-full bg-gradient-to-r from-amber-500 to-orange-400"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-3">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-emerald-600 font-mono-num">{{ stats.total_participants }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Participants</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-2/3 rounded-full bg-gradient-to-r from-emerald-500 to-teal-400"></div></div>
                </div>
            </div>

            {# ══════════ Formation Table ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center">
                            <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/></svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Catalogue des Formations</h3>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('rh_formation_create') }}" class="px-4 py-2.5 rounded-lg bg-gradient-to-r from-teal-600 to-emerald-600 text-white text-sm font-bold hover:from-teal-700 hover:to-emerald-700 transition-all shadow-sm flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                            Nouvelle Formation
                        </a>
                    </div>
                </div>

                {# Table #}
                <div class="overflow-x-auto rounded-lg border border-zinc-100 max-h-[70vh]">
                    <table class="decision-table min-w-full text-sm">
                        <thead>
                            <tr class="text-left text-[11px] font-bold uppercase tracking-wider text-zinc-400 border-b border-zinc-100 bg-zinc-50/95">
                                <th class="py-3 px-4">Titre & Description</th>
                                <th class="py-3 px-4">Type</th>
                                <th class="py-3 px-4">Durée</th>
                                <th class="py-3 px-4">Organisme</th>
                                <th class="py-3 px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for formation in formations %}
                            <tr class="decision-row border-b border-zinc-50 align-top">
                                <td class="py-3 px-4">
                                    <div class="text-base font-semibold text-zinc-900">{{ formation.titre }}</div>
<div class="font-normal text-zinc-500 text-xs mt-1">
    {{ formation.description|length > 100 ? formation.description|slice(0, 100) ~ '...' : formation.description }}
</div>                                </td>
                                <td class="py-3 px-4">
                                    <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded">{{ formation.type }}</span>
                                </td>
                                <td class="py-3 px-4 font-bold text-zinc-800 font-mono-num">{{ formation.duree }}h</td>
                                <td class="py-3 px-4 font-semibold text-zinc-700">{{ formation.organisme }}</td>
                                <td class="py-3 px-4">
                                    <div class="flex gap-2">
                                        <a href="{{ path('rh_formation_sessions', {id: formation.id_formation}) }}" class="text-indigo-600 hover:text-indigo-800 text-xs font-medium flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                            Sessions
                                        </a>
                                        <a href="{{ path('rh_formation_edit', {id: formation.id_formation}) }}" class="text-amber-600 hover:text-amber-800 text-xs font-medium flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            Modifier
                                        </a>
                                        <form method="post" action="{{ path('rh_formation_delete', {id: formation.id_formation}) }}" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette formation ?')">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete-formation-' ~ formation.id_formation) }}">
                                            <button type="submit" class="text-red-600 hover:text-red-800 text-xs font-medium flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="py-14 text-center text-zinc-400 text-sm">Aucune formation disponible.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
</div>
{% endblock %}