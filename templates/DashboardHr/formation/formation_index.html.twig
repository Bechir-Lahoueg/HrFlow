{% extends 'base.html.twig' %}

{% block title %}RH - Gestion Formations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .decision-table thead th{position:sticky;top:0;z-index:10}
        .decision-row{transition:all .2s}
        .decision-row:hover{background:#f8fafc;transform:scale(1.001)}
        .filter-chip{transition:all .2s}
        .filter-chip:hover{transform:translateY(-1px)}
        .filter-chip.active{box-shadow:0 4px 14px -4px rgba(15,23,42,.3)}
        .rank-badge{min-width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:999px;font-size:11px;font-weight:800}
        .rank-gold{background:#fef3c7;color:#92400e;border:1px solid #f59e0b}
        .rank-silver{background:#e5e7eb;color:#374151;border:1px solid #9ca3af}
        .rank-bronze{background:#ffedd5;color:#9a3412;border:1px solid #fb923c}
        .credit-card{position:relative;overflow:hidden}
        .credit-card::before{content:'';position:absolute;top:-50%;right:-30%;width:8rem;height:8rem;border-radius:9999px;opacity:.06;pointer-events:none}
        .credit-card:nth-child(1)::before{background:radial-gradient(circle,#14b8a6,transparent 70%)}
        .credit-card:nth-child(2)::before{background:radial-gradient(circle,#f97316,transparent 70%)}
        .credit-card:nth-child(3)::before{background:radial-gradient(circle,#6366f1,transparent 70%)}

        /* Formation module background color - Force le fond correct */
        #formation-page-container {
            background-color: #f4f7fb !important;
        }

        /* Dark mode support */
        @media (prefers-color-scheme: dark) {
            #formation-page-container {
                background-color: #18181b !important;
            }
        }

        /* Hero Banner - Force les couleurs */
        .hero-banner-formation {
            background: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d) !important;
        }

        /* Formation module color palette */
        :root {
            --form-primary-deep: #022E69;
            --form-primary: #145EB7;
            --form-accent: #3FA9F5;
            --form-border: #D0D0D0;
        }

        /* High contrast mode support */
        html.a11y-high-contrast {
            --form-primary-deep: #022E69;
            --form-primary: #145EB7;
            --form-accent: #3FA9F5;
            --form-border: #3FA9F5;
        }
    </style>
{% endblock %}

{% block body %}
<div id="formation-page-container" class="min-h-screen dot-grid">
    <style>
        /* Formation module color palette */
        :root {
            --form-primary-deep: #022E69;
            --form-primary: #145EB7;
            --form-accent: #3FA9F5;
            --form-border: #D0D0D0;
        }

        /* High contrast mode support */
        html.a11y-high-contrast {
            --form-primary-deep: #022E69;
            --form-primary: #145EB7;
            --form-accent: #3FA9F5;
            --form-border: #3FA9F5;
        }

        /* Dark mode background */
        @media (prefers-color-scheme: dark) {
            body {
                background-color: #18181b;
            }
        }
    </style>

    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ══════════ Hero Banner ══════════ #}
            <section class="hero-banner-formation relative overflow-hidden rounded-2xl text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full blur-3xl mesh-blob" style="background: radial-gradient(circle, rgba(63, 169, 245, 0.15), transparent 70%);"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full blur-3xl mesh-blob-alt" style="background: radial-gradient(circle, rgba(20, 94, 183, 0.15), transparent 70%);"></div>
                <div class="relative z-10 grid lg:grid-cols-[1.15fr_0.85fr] gap-6">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full animate-pulse" style="background-color: #3FA9F5;"></div>
                            <span class="text-[11px] font-bold uppercase tracking-wider" style="color: #3FA9F5;">RH Control Center</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Catalogue des Formations</h2>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">Gérez les formations, créez des sessions et suivez les participations des employés.</p>
                    </div>
                    <div class="grid sm:grid-cols-2 gap-3">
                        <div class="rounded-xl border border-white/15 backdrop-blur-sm p-4" style="background: rgba(255, 255, 255, 0.08);">
                            <p class="text-[10px] uppercase tracking-[0.15em] font-bold" style="color: rgba(63, 169, 245, 0.7);">Total Formations</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ stats.total_formations }}</p>
                            <p class="text-xs mt-1" style="color: rgba(63, 169, 245, 0.6);">dans le catalogue</p>
                        </div>
                        <div class="rounded-xl border border-white/15 backdrop-blur-sm p-4" style="background: rgba(255, 255, 255, 0.08);">
                            <p class="text-[10px] uppercase tracking-[0.15em] font-bold" style="color: rgba(63, 169, 245, 0.7);">Sessions Actives</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ stats.active_sessions }}</p>
                            <p class="text-xs mt-1" style="color: rgba(63, 169, 245, 0.6);">en cours</p>
                        </div>
                    </div>
                </div>
            </section>

            {# ══════════ Stats Grid ══════════ #}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-1">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-blue-100" style="background-color: rgba(20, 94, 183, 0.1);">
                            <svg class="w-5 h-5 text-[#145EB7] m-2.5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
                        </div>
                        <span class="text-[11px] font-bold text-[#022E69] bg-blue-100" style="background-color: rgba(20, 94, 183, 0.1); padding: 0.375rem 0.5rem; border-radius: 0.375rem;">Total</span>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 font-mono-num">{{ stats.total_formations }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Formations</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-full rounded-full" style="background: linear-gradient(90deg, #145EB7, #3FA9F5);"></div></div>
                </div>
                <div onclick="window.location.href='{{ path('rh_formation_active_sessions') }}'" class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-2 cursor-pointer">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
                    </div>
                    <p class="text-3xl font-extrabold text-amber-600 font-mono-num">{{ stats.active_sessions }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Sessions actives</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-1/3 rounded-full bg-gradient-to-r from-amber-500 to-orange-400"></div></div>
                </div>
                <div onclick="window.location.href='{{ path('rh_formation_all_participants') }}'" class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-3 cursor-pointer">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-emerald-600 font-mono-num">{{ stats.total_participants }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Participants</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-2/3 rounded-full bg-gradient-to-r from-emerald-500 to-teal-400"></div></div>
                </div>
            </div>

            <section class="grid grid-cols-1 lg:grid-cols-2 gap-4 animate-slide-up">

                {# ── Top 3 Formations ── #}
                <article class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.483 9.246 5 7.5 5S4.168 5.483 3 6.253v13C4.168 18.483 5.754 18 7.5 18s3.332.483 4.5 1.253m0-13C13.168 5.483 14.754 5 16.5 5s3.332.483 4.5 1.253v13C19.832 18.483 18.246 18 16.5 18s-3.332.483-4.5 1.253"/></svg>
                            Top 3 Formations
                        </h3>
                        <span class="text-[11px] font-semibold text-zinc-500">Basé sur les notes</span>
                    </div>

                    <div class="space-y-3">
                        {% for item in topFormations|default([])|slice(0, 3) %}
                            {% set rankClass = loop.index == 1 ? 'rank-gold' : (loop.index == 2 ? 'rank-silver' : 'rank-bronze') %}
                            {% set topFormationId = item.formationId|default(item.id|default(null)) %}
                            <div {% if topFormationId is not null %}onclick="window.location.href='{{ path('rh_formation_sessions', {id: topFormationId}) }}'"{% endif %}
                                 class="rounded-xl border border-zinc-100 dark:border-zinc-800/60 p-3 transition bg-zinc-50/40 dark:bg-zinc-800/20 {% if topFormationId is not null %}hover:border-[#3FA9F5] hover:ring-2 hover:ring-[#3FA9F5]/10 cursor-pointer{% endif %}">
                                <div class="flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <span class="rank-badge {{ rankClass }}">#{{ loop.index }}</span>
                                        <div class="min-w-0">
                                            <p class="font-semibold text-sm text-zinc-800 dark:text-zinc-200 truncate">{{ item.titre }}</p>
                                            <p class="text-xs text-zinc-500 truncate">{{ item.organisme|default('Organisme non renseigné') }}</p>
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        {% if item.averageRating is not null %}
                                            <div class="flex items-center justify-end gap-0.5">
                                                {% for i in 1..5 %}
                                                    <span class="text-sm {{ item.averageRating >= i ? 'text-yellow-400' : 'text-zinc-300' }}">★</span>
                                                {% endfor %}
                                            </div>
                                            <p class="text-[11px] text-zinc-500 mt-0.5">{{ item.feedbackCount|default(0) }} avis</p>
                                        {% else %}
                                            <div class="flex items-center justify-end gap-0.5">
                                                {% for i in 1..5 %}<span class="text-sm text-zinc-300">★</span>{% endfor %}
                                            </div>
                                            <p class="text-[11px] text-zinc-500 mt-0.5">0 avis</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="rounded-xl border border-dashed border-zinc-200 p-4 text-sm text-zinc-400 text-center">Aucune donnée de classement pour le moment.</div>
                        {% endfor %}
                    </div>
                </article>

                {# ── Top 3 Formateurs ── #}
                <article class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M4 21V7l8-4 8 4v14M9 9h.01M9 12h.01M9 15h.01M12 9h.01M12 12h.01M12 15h.01M15 9h.01M15 12h.01M15 15h.01"/></svg>
                            Top 3 Formateurs
                        </h3>
                        <span class="text-[11px] font-semibold text-zinc-500">Par organisme</span>
                    </div>

                    <div class="space-y-3">
                        {% for item in topFormateurs|default([])|slice(0, 3) %}
                            {% set rankClass = loop.index == 1 ? 'rank-gold' : (loop.index == 2 ? 'rank-silver' : 'rank-bronze') %}
                            <div class="rounded-xl border border-zinc-100 dark:border-zinc-800/60 p-3 bg-zinc-50/40 dark:bg-zinc-800/20">
                                <div class="flex items-center justify-between gap-3">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <span class="rank-badge {{ rankClass }}">#{{ loop.index }}</span>
                                        <div class="min-w-0">
                                            <p class="font-semibold text-sm text-zinc-800 dark:text-zinc-200 truncate">{{ item.organisme }}</p>
                                            <p class="text-xs text-zinc-500">{{ item.formationsCount|default(0) }} formation(s)</p>
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        {% if item.averageRating is not null %}
                                            <div class="flex items-center justify-end gap-0.5">
                                                {% for i in 1..5 %}
                                                    <span class="text-sm {{ item.averageRating >= i ? 'text-yellow-400' : 'text-zinc-300' }}">★</span>
                                                {% endfor %}
                                            </div>
                                            <p class="text-[11px] text-zinc-500 mt-0.5">{{ item.feedbackCount|default(0) }} avis</p>
                                        {% else %}
                                            <div class="flex items-center justify-end gap-0.5">
                                                {% for i in 1..5 %}<span class="text-sm text-zinc-300">★</span>{% endfor %}
                                            </div>
                                            <p class="text-[11px] text-zinc-500 mt-0.5">0 avis</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="rounded-xl border border-dashed border-zinc-200 p-4 text-sm text-zinc-400 text-center">Aucune donnée de classement pour le moment.</div>
                        {% endfor %}
                    </div>
                </article>

            </section>


            {# ══════════ Formation Table ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/></svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Catalogue des Formations</h3>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('rh_formation_create') }}" data-turbo="false" class="px-4 py-2.5 rounded-lg text-white text-sm font-bold transition-all shadow-sm flex items-center gap-2" style="background: linear-gradient(135deg, #145EB7, #3FA9F5); hover:opacity: 0.9;">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                            Nouvelle Formation
                        </a>
                    </div>
                </div>

                {# ══════════ Filtres ══════════ #}
                <div class="flex justify-end gap-4 mb-6 bg-zinc-50/50 dark:bg-zinc-800/20 rounded-xl p-3 border border-zinc-100 dark:border-zinc-800/50">
                    {% set formationTypes = ['Technique', 'Soft Skills', 'Management', 'Leadership', 'Langues', 'Qualité', 'Sécurité', 'Conformité', 'Bureautique', 'Finance', 'RH', 'Digital', 'Autre'] %}
                    <form method="get" action="{{ path('rh_formation_list') }}" class="flex items-center gap-2 w-full md:w-auto">
                        <select name="type" class="rounded-lg border-zinc-200 bg-white py-1.5 px-3 text-sm focus:border-[#145EB7] focus:ring-1 focus:ring-[#145EB7] shadow-sm">
                            <option value="">Tous les types</option>
                            {% for type in formationTypes %}
                                <option value="{{ type }}" {% if filters.type == type %}selected{% endif %}>{{ type }}</option>
                            {% endfor %}
                        </select>

                        <select name="sort" class="rounded-lg border-zinc-200 bg-white py-1.5 px-3 text-sm focus:border-[#145EB7] focus:ring-1 focus:ring-[#145EB7] shadow-sm">
                            <option value="created_at-DESC" {% if filters.sort == 'created_at-DESC' %}selected{% endif %}>Plus récent</option>
                            <option value="created_at-ASC" {% if filters.sort == 'created_at-ASC' %}selected{% endif %}>Plus ancien</option>
                            <option value="titre-ASC" {% if filters.sort == 'titre-ASC' %}selected{% endif %}>Titre (A-Z)</option>
                            <option value="titre-DESC" {% if filters.sort == 'titre-DESC' %}selected{% endif %}>Titre (Z-A)</option>
                            <option value="duree-ASC" {% if filters.sort == 'duree-ASC' %}selected{% endif %}>Durée (Croissant)</option>
                            <option value="duree-DESC" {% if filters.sort == 'duree-DESC' %}selected{% endif %}>Durée (Décroissant)</option>
                        </select>

                        <button type="submit" class="shrink-0 px-4 py-1.5 text-white font-bold rounded-lg transition flex items-center justify-center shadow-sm" style="background-color: #145EB7;" title="Filtrer">
                            Filtrer
                        </button>

                        {% if filters.type or (filters.sort != 'created_at-DESC') %}
                        <a href="{{ path('rh_formation_list') }}" class="text-zinc-400 hover:text-red-500 transition" title="Réinitialiser filtres">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </a>
                        {% endif %}
                    </form>
                </div>

                {# Grid des Formations #}
                {% set formationTypeStyles = {
                    'Technique': 'background:#dbeafe;color:#1e3a8a;border:1px solid #93c5fd;',
                    'Soft Skills': 'background:#fce7f3;color:#9d174d;border:1px solid #f9a8d4;',
                    'Management': 'background:#ede9fe;color:#5b21b6;border:1px solid #c4b5fd;',
                    'Leadership': 'background:#cffafe;color:#155e75;border:1px solid #67e8f9;',
                    'Langues': 'background:#ffedd5;color:#9a3412;border:1px solid #fdba74;',
                    'Qualité': 'background:#fef9c3;color:#854d0e;border:1px solid #fde047;',
                    'Sécurité': 'background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;',
                    'Conformité': 'background:#e0e7ff;color:#3730a3;border:1px solid #a5b4fc;',
                    'Bureautique': 'background:#f3e8ff;color:#7e22ce;border:1px solid #d8b4fe;',
                    'Finance': 'background:#dcfce7;color:#166534;border:1px solid #86efac;',
                    'RH': 'background:#e0f2fe;color:#075985;border:1px solid #7dd3fc;',
                    'Digital': 'background:#ccfbf1;color:#0f766e;border:1px solid #5eead4;',
                    'Autre': 'background:#f3f4f6;color:#374151;border:1px solid #d1d5db;'
                } %}

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
                    {% for formation in formations %}
                        {% set formationText = (formation.titre ~ ' ' ~ formation.type)|lower %}
                        {% set logoByKeyword = {
                            'angular': 'https://cdn.simpleicons.org/angular/DD0031',
                            'symfony': 'https://cdn.simpleicons.org/symfony/000000',
                            'php': 'https://cdn.simpleicons.org/php/777BB4',
                            'java': 'https://cdn.simpleicons.org/openjdk/EA2D2E',
                            'spring': 'https://cdn.simpleicons.org/spring/6DB33F',
                            'javascript': 'https://cdn.simpleicons.org/javascript/F7DF1E',
                            'typescript': 'https://cdn.simpleicons.org/typescript/3178C6',
                            'node': 'https://cdn.simpleicons.org/nodedotjs/339933',
                            'react': 'https://cdn.simpleicons.org/react/61DAFB',
                            'vue': 'https://cdn.simpleicons.org/vuedotjs/4FC08D',
                            'python': 'https://cdn.simpleicons.org/python/3776AB',
                            'django': 'https://cdn.simpleicons.org/django/092E20',
                            'mysql': 'https://cdn.simpleicons.org/mysql/4479A1',
                            'docker': 'https://cdn.simpleicons.org/docker/2496ED',
                            'aws': 'https://cdn.simpleicons.org/amazonaws/232F3E'
                        } %}
                        {% set logoImage = null %}
                        {% for keyword, url in logoByKeyword %}
                            {% if logoImage is null and keyword in formationText %}
                                {% set logoImage = url %}
                            {% endif %}
                        {% endfor %}

                        {% set fallbackImage = logoImage ?: '/logo.png' %}
                        {% set hardFallbackImage = '/logo.png' %}
                        {% set rawCoverImage = formation.imageUrl|default('')|trim %}
                        {% set coverImage = rawCoverImage starts with '=' ? rawCoverImage|slice(1) : rawCoverImage %}
                        {% if coverImage == '' %}
                            {% set coverImage = fallbackImage %}
                        {% endif %}
                        <div onclick="window.location.href='{{ path('rh_formation_sessions', {id: formation.id}) }}'"
                             class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover flex flex-col justify-between cursor-pointer transition-all hover:ring-2 hover:ring-[#3FA9F5]/20">
                            <div>
                                {% set rating = ratingMap[formation.id]|default(null) %}
                                <div class="flex justify-between items-start mb-3 gap-2">
                                    <div class="min-w-0 flex items-start gap-3">
                                        <div class="w-11 h-11 rounded-full border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800/60 shrink-0 p-0.5">
                                            <img src="{{ coverImage }}" alt="Logo {{ formation.titre }}" class="w-full h-full rounded-full object-contain p-1 bg-white" loading="lazy" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='{{ hardFallbackImage }}';">
                                        </div>
                                        <div class="min-w-0">
                                        <h4 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 line-clamp-1" title="{{ formation.titre }}">{{ formation.titre }}</h4>
                                        <div class="mt-1 flex items-center gap-1 flex-wrap">
                                            {% set hasReviews = rating and rating.count > 0 %}
                                            {% if hasReviews %}
                                                {% set avg = rating.average %}
                                                {% for i in 1..5 %}
                                                    <span class="text-sm {{ avg >= i ? 'text-yellow-400' : 'text-zinc-300' }}">★</span>
                                                {% endfor %}
                                                <span class="text-xs text-zinc-500 ml-1">{{ rating.average ~ '/5' }}</span>
                                                <a href="{{ path('rh_formation_feedbacks', {id: formation.id}) }}" onclick="event.stopPropagation()" class="text-[11px] font-semibold text-[#145EB7] hover:text-[#3FA9F5] ml-2">
                                                    Voir avis ({{ rating.count }})
                                                </a>
                                            {% else %}
                                                <span class="text-xs text-zinc-500">Aucun avis</span>
                                            {% endif %}
                                        </div>
                                        </div>
                                    </div>
                                    {% set typeStyle = formationTypeStyles[formation.type]|default('background:#f3f4f6;color:#374151;border:1px solid #d1d5db;') %}
                                    <span class="text-[10px] font-bold px-2 py-1 rounded uppercase tracking-wider whitespace-nowrap ml-2" style="{{ typeStyle }}">{{ formation.type }}</span>
                                </div>
                                <div class="mb-4 space-y-2">
                                    <div>
                                        <p class="text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-0.5">Description</p>
                                        <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2" title="{{ formation.description }}">
                                            {{ formation.description ?: 'Aucune description' }}
                                        </p>
                                    </div>
                                    <div>
                                        <p class="text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-0.5">Objectifs</p>
                                        <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2" title="{{ formation.objectifs }}">
                                            {{ formation.objectifs ?: 'Aucun objectif défini' }}
                                        </p>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-2 mb-4">
                                    <div class="bg-zinc-50 dark:bg-zinc-800/50 p-2 rounded-lg">
                                        <p class="text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-1">Durée</p>
                                        <p class="text-sm font-bold text-zinc-700 dark:text-zinc-300 font-mono-num">{{ formation.duree }} Jours</p>
                                    </div>
                                    <div class="bg-zinc-50 dark:bg-zinc-800/50 p-2 rounded-lg">
                                        <p class="text-[10px] uppercase tracking-wider text-zinc-400 font-semibold mb-1">Organisme</p>
                                        <p class="text-sm font-bold text-zinc-700 dark:text-zinc-300 truncate" title="{{ formation.organisme }}">{{ formation.organisme }}</p>
                                    </div>
                                </div>

                                <div class="pt-2 border-t border-zinc-100"></div>
                            </div>

                            <div class="flex justify-end gap-2 pt-3 border-t border-zinc-100 dark:border-zinc-800/50 mt-auto" onclick="event.stopPropagation()">
                                <a href="{{ path('rh_formation_edit', {id: formation.id}) }}" class="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 hover:bg-amber-100 hover:text-amber-800 flex items-center justify-center transition-colors" title="Modifier">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                </a>
                                <form method="post" action="{{ path('rh_formation_delete', {id: formation.id}) }}" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette formation ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-formation-' ~ formation.id) }}">
                                    <button type="submit" class="w-8 h-8 rounded-lg text-white flex items-center justify-center transition-colors" style="background-color: #dc2626;" title="Supprimer">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-span-1 md:col-span-2 lg:col-span-3 py-14 text-center text-zinc-400 text-sm bg-zinc-50 border border-zinc-100 rounded-xl border-dashed">
                            Aucune formation disponible.
                        </div>
                    {% endfor %}
                </div>
            </section>
        </main>
    </div>
</div>
{% endblock %}







