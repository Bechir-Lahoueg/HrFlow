{% extends 'base.html.twig' %}

{% block title %}RH - Sessions de {{ formation.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --primary-dark: #022E69;
            --primary-blue: #145EB7;
            --accent-blue: #3FA9F5;
            --border-gray: #D0D0D0;
        }

        .session-card{transition:transform .2s, box-shadow .2s}
        .session-card:hover{transform:translateY(-2px); box-shadow:0 18px 40px -20px rgba(2, 46, 105, .35)}
        .mono-num{font-variant-numeric:tabular-nums}

        .btn-primary{
            background: var(--primary-blue);
            color: #fff;
        }
        .btn-primary:hover{background: var(--primary-dark)}
        .badge-accent{background: rgba(63, 169, 245, .14); color: var(--primary-dark)}
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            <div class="mb-6">
                <a href="{{ path('rh_formation_list') }}" class="inline-flex items-center gap-2 text-zinc-600 hover:text-zinc-800 text-sm font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour au catalogue
                </a>
            </div>

            {# ══════════ Hero Banner ══════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-sky-900 to-indigo-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-sky-300/15 blur-3xl mesh-blob"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-300/15 blur-3xl mesh-blob-alt"></div>
                <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                        <span class="text-[11px] font-bold text-cyan-200 uppercase tracking-wider">RH Control Center</span>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Sessions de Formation</h2>
                    <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">{{ formation.titre }}</p>
                    <div class="mt-4 flex items-center gap-4 text-sm">
                        <span class="bg-white/10 px-3 py-1 rounded-full">{{ formation.type }}</span>
                        <span class="text-cyan-200">{{ formation.duree }} Jours</span>
                        <span class="text-slate-400">•</span>
                        <span class="text-slate-300">{{ formation.organisme }}</span>
                    </div>
                </div>
            </section>

            {# ══════════ Sessions Cards ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center">
                            <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Sessions Programmées</h3>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('rh_formation_session_create', {id: formation.id}) }}" class="btn-primary px-4 py-2.5 rounded-lg text-white text-sm font-bold transition-all shadow-sm flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                            Nouvelle Session
                        </a>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                    {% for session in sessions %}
                        {% set occupees = session.acceptedCount|default(0) %}
                        {% set dispo = max(0, session.capaciteMax - occupees) %}

                        <article class="session-card group rounded-2xl border border-zinc-100 dark:border-zinc-800/60 bg-gradient-to-b from-white to-zinc-50/40 dark:from-zinc-950 dark:to-zinc-900 p-5">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <p class="text-[11px] font-extrabold uppercase tracking-wider text-zinc-400">Période</p>
                                    <p class="mt-1 text-[15px] font-bold text-zinc-900 dark:text-zinc-100 mono-num">
                                        {{ session.dateDebut|date('d M Y') }}
                                    </p>
                                    <p class="text-[12px] text-zinc-500 mono-num">
                                        au {{ session.dateFin|date('d M Y') }}
                                    </p>
                                </div>

                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold shrink-0
                                    {% if session.statut == 'Planifiee' %}bg-blue-50 text-blue-700 border border-blue-200{% endif %}
                                    {% if session.statut == 'En cours' %}bg-amber-50 text-amber-700 border border-amber-200{% endif %}
                                    {% if session.statut == 'Terminee' %}bg-emerald-50 text-emerald-700 border border-emerald-200{% endif %}
                                    {% if session.statut == 'Annulee' %}bg-red-50 text-red-700 border border-red-200{% endif %}">
                                    <span class="w-1.5 h-1.5 rounded-full
                                        {% if session.statut == 'Planifiee' %}bg-blue-500{% endif %}
                                        {% if session.statut == 'En cours' %}bg-amber-500{% endif %}
                                        {% if session.statut == 'Terminee' %}bg-emerald-500{% endif %}
                                        {% if session.statut == 'Annulee' %}bg-red-500{% endif %}"></span>
                                    {{ session.statut }}
                                </span>
                            </div>

                            <div class="mt-4 grid grid-cols-2 gap-3">
                                <div class="rounded-xl bg-white/70 dark:bg-zinc-950/60 border border-zinc-100/70 dark:border-zinc-800/60 p-3">
                                    <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">Lieu</p>
                                    <p class="mt-1 text-[13px] font-semibold text-zinc-800 dark:text-zinc-200 line-clamp-2">{{ session.lieu ?: '—' }}</p>
                                </div>
                                <div class="rounded-xl bg-white/70 dark:bg-zinc-950/60 border border-zinc-100/70 dark:border-zinc-800/60 p-3">
                                    <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">Mode</p>
                                    <div class="mt-1">
                                        <span class="badge-accent inline-flex text-xs font-bold px-2.5 py-0.5 rounded-lg">{{ session.mode }}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 rounded-xl border border-zinc-100 dark:border-zinc-800/60 bg-white/60 dark:bg-zinc-950/50 p-4">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-wider">Capacité</p>
                                        <p class="mt-1 font-extrabold text-zinc-900 dark:text-zinc-100 mono-num">{{ dispo }} / {{ session.capaciteMax }}</p>
                                        <p class="text-[10px] text-zinc-400 font-semibold uppercase tracking-wider">places dispo</p>
                                    </div>
                                    <div class="w-16">
                                        {% set percent = session.capaciteMax > 0 ? ((dispo / session.capaciteMax) * 100) : 0 %}
                                        <div class="h-2 rounded-full bg-zinc-100 dark:bg-zinc-800 overflow-hidden">
                                            <div class="h-2 rounded-full" style="background: var(--accent-blue); width: {{ percent }}%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4 flex flex-wrap gap-2">
                                <a href="{{ path('rh_formation_session_participants', {id: session.id}) }}" class="px-3 py-2 rounded-xl bg-indigo-50 text-indigo-700 hover:bg-indigo-100 text-xs font-bold inline-flex items-center gap-2 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                    Participants
                                </a>
                                {% if session.statut == 'En cours' %}
                                    <a href="{{ path('rh_formation_session_presence', {id: session.id}) }}" class="px-3 py-2 rounded-xl bg-teal-50 text-teal-700 hover:bg-teal-100 text-xs font-bold inline-flex items-center gap-2 transition">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                                        Présences
                                    </a>
                                {% endif %}
                                <a href="{{ path('rh_formation_session_edit', {id: session.id}) }}" class="px-3 py-2 rounded-xl bg-amber-50 text-amber-700 hover:bg-amber-100 text-xs font-bold inline-flex items-center gap-2 transition">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    Modifier
                                </a>
                            </div>
                        </article>
                    {% else %}
                        <div class="col-span-full">
                            <div class="rounded-2xl border border-dashed border-zinc-200 dark:border-zinc-800 p-10 text-center bg-white/60 dark:bg-zinc-950/30">
                                <p class="text-zinc-500 font-medium">Aucune session programmée pour cette formation.</p>
                                <a href="{{ path('rh_formation_session_create', {id: formation.id}) }}" class="btn-primary mt-4 inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-white text-sm font-bold transition-all shadow-sm">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                                    Créer la première session
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </section>
        </main>
    </div>
</div>
{% endblock %}
