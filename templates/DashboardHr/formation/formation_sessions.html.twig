{% extends 'base.html.twig' %}

{% block title %}RH - Sessions de {{ formation.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .decision-table thead th{position:sticky;top:0;z-index:10}
        .decision-row{transition:all .2s}
        .decision-row:hover{background:#f8fafc;transform:scale(1.001)}
        .filter-chip{transition:all .2s}
        .filter-chip:hover{transform:translateY(-1px)}
        .filter-chip.active{box-shadow:0 4px 14px -4px rgba(15,23,42,.3)}
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            <div class="mb-6">
                <a href="{{ path('rh_formation_list') }}" class="inline-flex items-center gap-2 text-zinc-600 hover:text-zinc-800 text-sm font-medium">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour au catalogue
                </a>
            </div>

            {# ══════════ Hero Banner ══════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-sky-900 to-indigo-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-sky-300/15 blur-3xl mesh-blob"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-300/15 blur-3xl mesh-blob-alt"></div>
                <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                        <span class="text-[11px] font-bold text-cyan-200 uppercase tracking-wider">RH Control Center</span>
                    </div>
                    <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Sessions de Formation</h2>
                    <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">{{ formation.titre }}</p>
                    <div class="mt-4 flex items-center gap-4 text-sm">
                        <span class="bg-white/10 px-3 py-1 rounded-full">{{ formation.type }}</span>
                        <span class="text-cyan-200">{{ formation.duree }} Jours</span>
                        <span class="text-slate-400">•</span>
                        <span class="text-slate-300">{{ formation.organisme }}</span>
                    </div>
                </div>
            </section>

            {# ══════════ Sessions Table ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-sky-50 flex items-center justify-center">
                            <svg class="w-4 h-4 text-sky-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Sessions Programmées</h3>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('rh_formation_session_create', {id: formation.id}) }}" class="px-4 py-2.5 rounded-lg bg-gradient-to-r from-teal-600 to-emerald-600 text-white text-sm font-bold hover:from-teal-700 hover:to-emerald-700 transition-all shadow-sm flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                            Nouvelle Session
                        </a>
                    </div>
                </div>

                {# Table #}
                <div class="overflow-x-auto rounded-lg border border-zinc-100 max-h-[70vh]">
                    <table class="decision-table min-w-full text-sm">
                        <thead>
                            <tr class="text-left text-[11px] font-bold uppercase tracking-wider text-zinc-400 border-b border-zinc-100 bg-zinc-50/95">
                                <th class="py-3 px-4">Période</th>
                                <th class="py-3 px-4">Lieu</th>
                                <th class="py-3 px-4">Mode</th>
                                <th class="py-3 px-4">Capacité</th>
                                <th class="py-3 px-4">Statut</th>
                                <th class="py-3 px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for session in sessions %}
                            <tr class="decision-row border-b border-zinc-50 align-top">
                                <td class="py-3 px-4">
                                    <p class="text-[13px] font-medium text-zinc-700">{{ session.dateDebut|date('d M Y') }}</p>
                                    <p class="text-[11px] text-zinc-400">au {{ session.dateFin|date('d M Y') }}</p>
                                </td>
                                <td class="py-3 px-4 font-semibold text-zinc-700">{{ session.lieu }}</td>
                                <td class="py-3 px-4">
                                    <span class="bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded">{{ session.mode }}</span>
                                </td>
                               <td class="py-3 px-4">
                                   <div class="flex flex-col">
                                       {% set occupees = session.acceptedCount|default(0) %}
                                       <span class="font-bold text-zinc-800 font-mono-num">
                                           {{ max(0, session.capaciteMax - occupees) }} / {{ session.capaciteMax }}
                                       </span>
                                       <span class="text-[10px] text-zinc-400 font-semibold uppercase tracking-wider">places dispo</span>
                                   </div>
                               </td>
                                <td class="py-3 px-4">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold
                                        {% if session.statut == 'Planifiee' %}bg-blue-50 text-blue-700 border border-blue-200{% endif %}
                                        {% if session.statut == 'En cours' %}bg-amber-50 text-amber-700 border border-amber-200{% endif %}
                                        {% if session.statut == 'Terminee' %}bg-emerald-50 text-emerald-700 border border-emerald-200{% endif %}
                                        {% if session.statut == 'Annulee' %}bg-red-50 text-red-700 border border-red-200{% endif %}">
                                        <span class="w-1.5 h-1.5 rounded-full
                                            {% if session.statut == 'Planifiee' %}bg-blue-500{% endif %}
                                            {% if session.statut == 'En cours' %}bg-amber-500{% endif %}
                                            {% if session.statut == 'Terminee' %}bg-emerald-500{% endif %}
                                            {% if session.statut == 'Annulee' %}bg-red-500{% endif %}"></span>
                                        {{ session.statut }}
                                    </span>
                                </td>
                                <td class="py-3 px-4">
                                    <div class="flex gap-2">
                                        <a href="{{ path('rh_formation_session_participants', {id: session.id}) }}" class="text-indigo-600 hover:text-indigo-800 text-xs font-medium flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                            Participants
                                        </a>
                                        {% if session.statut == 'En cours' %}
                                        <a href="{{ path('rh_formation_session_presence', {id: session.id}) }}" class="text-teal-600 hover:text-teal-800 text-xs font-medium flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                                            Présences
                                        </a>
                                        {% endif %}
                                        <a href="{{ path('rh_formation_session_edit', {id: session.id}) }}" class="text-amber-600 hover:text-amber-800 text-xs font-medium flex items-center gap-1">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            Modifier
                                        </a>
                                        <form method="post" action="#" class="inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette session ?')">
                                            <input type="hidden" name="_token" value="">
                                            <button type="submit" class="text-red-600 hover:text-red-800 text-xs font-medium flex items-center gap-1">
                                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                Supprimer
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="6" class="py-14 text-center text-zinc-400 text-sm">Aucune session programmée pour cette formation.</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>
</div>
{% endblock %}
