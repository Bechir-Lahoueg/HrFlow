{% extends 'base.html.twig' %}

{% block title %}RH — Sessions de {{ formation.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
    :root {
        --deep:    #022E69;
        --primary: #145EB7;
        --accent:  #3FA9F5;
        --light:   rgba(63,169,245,.1);
        --border:  #dce6f5;
        --bg:      #f4f7fb;
        --surface: #ffffff;
        --text:    #0d1f3c;
        --muted:   #6b82a8;
        --radius:  1rem;
        --shadow:  0 2px 16px -4px rgba(2,46,105,.1);
        --shadow-lg: 0 8px 32px -8px rgba(2,46,105,.25);
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: 'DM Sans', system-ui, sans-serif; background: var(--bg); color: var(--text); }

    /* ── Hero ── */
    .hero-banner {
        background: linear-gradient(135deg, #022E69 0%, #0a3d8f 55%, #051f3d 100%);
        border-radius: var(--radius);
        padding: 2rem 2.25rem;
        position: relative; overflow: hidden;
        box-shadow: var(--shadow-lg);
    }
    .hero-banner::before {
        content: ''; position: absolute; right: -60px; top: -60px;
        width: 220px; height: 220px; border-radius: 50%;
        background: radial-gradient(circle, rgba(63,169,245,.18), transparent 70%);
    }
    .hero-banner::after {
        content: ''; position: absolute; left: -40px; bottom: -60px;
        width: 180px; height: 180px; border-radius: 50%;
        background: radial-gradient(circle, rgba(20,94,183,.2), transparent 70%);
    }
    .hero-badge {
        display: inline-flex; align-items: center; gap: .4rem;
        font-size: .65rem; font-weight: 800; letter-spacing: .12em;
        text-transform: uppercase; color: #3FA9F5;
        margin-bottom: .65rem; position: relative; z-index: 1;
    }
    .hero-badge .dot {
        width: 6px; height: 6px; border-radius: 50%; background: #3FA9F5;
        animation: pulse-dot 2s ease-in-out infinite;
    }
    @keyframes pulse-dot { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.4)} }
    .hero-banner h2   { font-size: 1.9rem; font-weight: 800; color: #fff; margin: 0 0 .25rem; position: relative; z-index: 1; }
    .hero-banner .sub { font-size: .95rem; color: #93c5fd; margin: 0 0 1rem; position: relative; z-index: 1; }
    .hero-meta        { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; position: relative; z-index: 1; }
    .hero-chip {
        display: inline-flex; align-items: center; gap: .4rem;
        background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18);
        border-radius: 99px; padding: .3rem .85rem;
        font-size: .75rem; font-weight: 700; color: #e0f2fe;
        backdrop-filter: blur(6px);
    }

    /* ── Back link ── */
    .back-link {
        display: inline-flex; align-items: center; gap: .45rem;
        font-size: .8rem; font-weight: 700; color: var(--deep);
        text-decoration: none; transition: color .15s;
    }
    .back-link:hover { color: var(--primary); }

    /* ── Card surface ── */
    .fp-surface {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    /* ── Session cards ── */
    .session-card {
        border-radius: .875rem;
        border: 1px solid var(--border);
        background: linear-gradient(160deg, #fff 60%, #f4f8ff 100%);
        padding: 1.25rem;
        transition: transform .2s, box-shadow .2s;
        display: flex; flex-direction: column; gap: 1rem;
    }
    .session-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 32px -12px rgba(2,46,105,.28);
    }

    /* ── Status badge ── */
    .badge-status {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .28rem .75rem; border-radius: 99px;
        font-size: .68rem; font-weight: 800; border: 1px solid transparent;
        white-space: nowrap;
    }
    .badge-status .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .s-planifiee { background:#eff6ff; border-color:#bfdbfe; color:#1d4ed8; }
    .s-planifiee .dot { background:#3b82f6; }
    .s-encours   { background:#fffbeb; border-color:#fde68a; color:#b45309; }
    .s-encours .dot  { background:#f59e0b; }
    .s-terminee  { background:#f0fdf4; border-color:#bbf7d0; color:#15803d; }
    .s-terminee .dot { background:#22c55e; }
    .s-annulee   { background:#fff0f0; border-color:#fecaca; color:#dc2626; }
    .s-annulee .dot  { background:#ef4444; }

    /* ── Mini info tiles ── */
    .info-tile {
        background: #f8fafd; border: 1px solid var(--border);
        border-radius: .625rem; padding: .7rem .85rem;
    }
    .info-tile .lbl { font-size: .6rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); margin-bottom: .2rem; }
    .info-tile .val { font-size: .82rem; font-weight: 700; color: var(--text); }

    /* ── Capacity bar ── */
    .cap-bar-track { height: 6px; background: #e2eaf5; border-radius: 99px; overflow: hidden; margin-top: .4rem; }
    .cap-bar-fill  { height: 100%; border-radius: 99px; background: linear-gradient(90deg, var(--primary), var(--accent)); transition: width .6s ease; }

    /* ── Mode badge ── */
    .mode-badge { display: inline-flex; font-size: .7rem; font-weight: 700; padding: .25rem .65rem; border-radius: 6px; }
    .mode-online  { background:#ede9fe; color:#5b21b6; border:1px solid #c4b5fd; }
    .mode-present { background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; }
    .mode-hybrid  { background:#fdf4ff; color:#7e22ce; border:1px solid #e9d5ff; }

    /* ── Action buttons ── */
    .btn-action {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .42rem .85rem; border-radius: 8px;
        font-size: .73rem; font-weight: 700; border: none; cursor: pointer;
        font-family: inherit; text-decoration: none; transition: all .15s;
    }
    .btn-participants { background:#edf4ff; color:var(--primary); }
    .btn-participants:hover { background:var(--light); color:var(--deep); }
    .btn-presence { background:#f0fdf4; color:#15803d; }
    .btn-presence:hover { background:#dcfce7; }
    .btn-edit     { background:#fffbeb; color:#b45309; }
    .btn-edit:hover { background:#fef3c7; }
    .btn-delete   { background:#fff0f0; color:#dc2626; }
    .btn-delete:hover { background:#fee2e2; }

    .btn-new-session {
        display: inline-flex; align-items: center; gap: .45rem;
        background: linear-gradient(135deg, var(--deep), var(--primary));
        color: #fff; padding: .6rem 1.25rem; border-radius: 10px;
        font-size: .8rem; font-weight: 800; font-family: inherit;
        border: none; cursor: pointer; text-decoration: none;
        box-shadow: 0 3px 12px -4px rgba(2,46,105,.4);
        transition: all .15s;
    }
    .btn-new-session:hover { transform: translateY(-1px); box-shadow: 0 6px 20px -6px rgba(2,46,105,.5); color: #fff; }

    /* ── Flash ── */
    .flash-success { background:#f0fdf4; border:1px solid #bbf7d0; color:#15803d; border-radius:.75rem; padding:.7rem 1rem; font-size:.85rem; font-weight:600; display:flex; align-items:center; gap:.5rem; }
    .flash-error   { background:#fff0f0; border:1px solid #fecaca; color:#dc2626; border-radius:.75rem; padding:.7rem 1rem; font-size:.85rem; font-weight:600; display:flex; align-items:center; gap:.5rem; }

    /* ── Delete modal ── */
    .delete-session-modal { display: none; }
    .delete-session-modal.is-open { display: block; }
    .delete-session-backdrop { opacity: 0; transition: opacity .2s ease; }
    .delete-session-panel { opacity: 0; transform: translateY(10px) scale(.98); transition: all .25s ease; }
    .delete-session-modal.is-open .delete-session-backdrop { opacity: 1; }
    .delete-session-modal.is-open .delete-session-panel { opacity: 1; transform: translateY(0) scale(1); }

    .modal-header-blue {
        background: linear-gradient(135deg, #022E69 0%, #0a3d8f 55%, #051f3d 100%);
        padding: 1.25rem 1.5rem; border-radius: .875rem .875rem 0 0;
    }
    .btn-modal-cancel {
        display: inline-flex; align-items: center; justify-content: center;
        padding: .55rem 1.1rem; border-radius: 9px; font-size: .82rem; font-weight: 700;
        border: 1.5px solid var(--border); background: #fff; color: var(--muted);
        cursor: pointer; font-family: inherit; transition: all .15s;
    }
    .btn-modal-cancel:hover { border-color: var(--accent); color: var(--primary); }
    .btn-modal-delete {
        display: inline-flex; align-items: center; justify-content: center;
        padding: .55rem 1.25rem; border-radius: 9px; font-size: .82rem; font-weight: 800;
        background: #ef4444; color: #fff; border: none; cursor: pointer; font-family: inherit;
        transition: all .15s; box-shadow: 0 3px 10px -3px rgba(239,68,68,.4);
    }
    .btn-modal-delete:hover { background: #dc2626; transform: translateY(-1px); }

    /* ── Empty state ── */
    .empty-state {
        border: 2px dashed var(--border); border-radius: var(--radius);
        padding: 3.5rem 2rem; text-align: center;
        background: #f8fafd;
    }

    .mono-num { font-variant-numeric: tabular-nums; }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f4f7fb] dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 flash-success animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 flash-error animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# ── Back ── #}
            <a href="{{ path('rh_formation_list') }}" class="back-link">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7 7-7m11 7H3"/></svg>
                Retour au catalogue
            </a>

            {# ── Formation type styles map ── #}
            {% set formationTypeStyles = {
                'Technique':   'background:#dbeafe;color:#1e3a8a;border:1px solid #93c5fd;',
                'Soft Skills': 'background:#fce7f3;color:#9d174d;border:1px solid #f9a8d4;',
                'Management':  'background:#ede9fe;color:#5b21b6;border:1px solid #c4b5fd;',
                'Leadership':  'background:#cffafe;color:#155e75;border:1px solid #67e8f9;',
                'Langues':     'background:#ffedd5;color:#9a3412;border:1px solid #fdba74;',
                'Qualité':     'background:#fef9c3;color:#854d0e;border:1px solid #fde047;',
                'Sécurité':    'background:#fee2e2;color:#991b1b;border:1px solid #fca5a5;',
                'Conformité':  'background:#e0e7ff;color:#3730a3;border:1px solid #a5b4fc;',
                'Bureautique': 'background:#f3e8ff;color:#7e22ce;border:1px solid #d8b4fe;',
                'Finance':     'background:#dcfce7;color:#166534;border:1px solid #86efac;',
                'RH':          'background:#e0f2fe;color:#075985;border:1px solid #7dd3fc;',
                'Digital':     'background:#ccfbf1;color:#0f766e;border:1px solid #5eead4;',
                'Autre':       'background:#f3f4f6;color:#374151;border:1px solid #d1d5db;'
            } %}
            {% set typeStyle = formationTypeStyles[formation.type]|default('background:#f3f4f6;color:#374151;border:1px solid #d1d5db;') %}

            {# ── Hero ── #}
            <section class="hero-banner animate-slide-up">
                <div class="hero-badge"><span class="dot"></span>RH Control Center</div>
                <h2>Sessions de Formation</h2>
                <p class="sub">{{ formation.titre }}</p>
                <div class="hero-meta">
                    <span class="hero-chip" style="padding:.3rem .85rem; font-size:.75rem; font-weight:700; border-radius:99px; {{ typeStyle }}">{{ formation.type }}</span>
                    <span class="hero-chip">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10" stroke-width="2"/></svg>
                        {{ formation.duree }} jours
                    </span>
                    <span class="hero-chip">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/></svg>
                        {{ formation.organisme }}
                    </span>
                    <span class="hero-chip">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
                        {{ sessions|length }} session{{ sessions|length != 1 ? 's' : '' }}
                    </span>
                </div>
            </section>

            {# ── Sessions card ── #}
            <section class="fp-surface p-6 animate-slide-up">

                <div style="display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:1.5rem;">
                    <div style="display:flex; align-items:center; gap:.75rem;">
                        <div style="width:36px;height:36px;border-radius:.6rem;background:linear-gradient(135deg,var(--primary),var(--accent));display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                            <svg class="w-4 h-4" fill="none" stroke="white" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                        </div>
                        <div>
                            <p style="font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:0;">Planning</p>
                            <p style="font-size:.95rem;font-weight:800;color:var(--deep);margin:0;">Sessions programmées</p>
                        </div>
                    </div>
                    <a href="{{ path('rh_formation_session_create', {id: formation.id}) }}" class="btn-new-session">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                        Nouvelle Session
                    </a>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
                    {% for session in sessions %}
                        {% set occupees = session.acceptedCount|default(0) %}
                        {% set dispo = max(0, session.capaciteMax - occupees) %}
                        {% set capPercent = session.capaciteMax > 0 ? ((dispo / session.capaciteMax) * 100)|round : 0 %}
                        {% set modeNorm = session.mode|lower %}
                        {% set modeClass = modeNorm starts with 'en ligne' ? 'mode-online' : (modeNorm starts with 'presentiel' ? 'mode-present' : 'mode-hybrid') %}

                        {# Status class #}
                        {% set statClass = '' %}
                        {% if session.statut == 'Planifiee' %}{% set statClass = 's-planifiee' %}
                        {% elseif session.statut == 'En cours' %}{% set statClass = 's-encours' %}
                        {% elseif session.statut == 'Terminee' %}{% set statClass = 's-terminee' %}
                        {% elseif session.statut == 'Annulee' %}{% set statClass = 's-annulee' %}
                        {% endif %}

                        <article class="session-card">

                            {# Header: dates + status #}
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:.75rem;">
                                <div>
                                    <p style="font-size:.6rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:0 0 .2rem;">Période</p>
                                    <p style="font-size:.95rem;font-weight:800;color:var(--deep);margin:0;" class="mono-num">{{ session.dateDebut|date('d M Y') }}</p>
                                    <p style="font-size:.75rem;color:var(--muted);margin:0;" class="mono-num">au {{ session.dateFin|date('d M Y') }}</p>
                                </div>
                                <span class="badge-status {{ statClass }}">
                                    <span class="dot"></span>{{ session.statut }}
                                </span>
                            </div>

                            {# Lieu + Mode #}
                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:.6rem;">
                                <div class="info-tile">
                                    {% set lowerLieu = (session.lieu|default(''))|lower %}
                                    {% set isLink = lowerLieu starts with 'http://' or lowerLieu starts with 'https://' %}
                                    <p class="lbl">{{ isLink ? 'Lien session' : 'Lieu' }}</p>
                                    {% if isLink %}
                                        <a href="{{ session.lieu }}" target="_blank" rel="noopener noreferrer"
                                           style="font-size:.78rem;font-weight:700;color:var(--primary);text-decoration:underline;display:inline-flex;align-items:center;gap:.3rem;">
                                            {{ 'meet.jit.si' in session.lieu ? 'Ouvrir Jitsi' : 'Ouvrir le lien' }}
                                            <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H18m0 0v4.5M18 6l-7.5 7.5"/></svg>
                                        </a>
                                    {% else %}
                                        <p class="val">{{ session.lieu ?: '—' }}</p>
                                    {% endif %}
                                </div>
                                <div class="info-tile">
                                    <p class="lbl">Mode</p>
                                    <span class="mode-badge {{ modeClass }}">{{ session.mode }}</span>
                                </div>
                            </div>

                            {# Capacity ── #}
                            <div class="info-tile">
                                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.35rem;">
                                    <p class="lbl" style="margin:0;">Capacité</p>
                                    <span style="font-size:.78rem;font-weight:800;color:var(--deep);" class="mono-num">{{ dispo }} / {{ session.capaciteMax }} places dispo</span>
                                </div>
                                <div class="cap-bar-track">
                                    <div class="cap-bar-fill" style="width:{{ capPercent }}%"></div>
                                </div>
                            </div>

                            {# Actions ── #}
                            <div style="display:flex;flex-wrap:wrap;gap:.45rem;padding-top:.25rem;border-top:1px solid var(--border);">
                                <a href="{{ path('rh_formation_session_participants', {id: session.id}) }}" class="btn-action btn-participants">
                                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                                    Participants
                                </a>
                                {% if session.statut == 'En cours' %}
                                    <a href="{{ path('rh_formation_session_presence', {id: session.id}) }}" class="btn-action btn-presence">
                                        <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        Présences
                                    </a>
                                {% endif %}
                                <a href="{{ path('rh_formation_session_edit', {id: session.id}) }}" class="btn-action btn-edit">
                                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                    Modifier
                                </a>
                                <button type="button" class="btn-action btn-delete"
                                        data-delete-session-open="delete-session-modal-{{ session.id }}">
                                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 7h12m-9 0V5a1 1 0 011-1h4a1 1 0 011 1v2m-8 0l.7 11.2a2 2 0 001.99 1.8h4.62a2 2 0 001.99-1.8L18 7"/></svg>
                                    Supprimer
                                </button>
                            </div>

                        </article>

                        {# ── Delete modal ── #}
                        <div id="delete-session-modal-{{ session.id }}" class="delete-session-modal fixed inset-0 z-[9999]"
                             role="dialog" aria-modal="true"
                             aria-labelledby="delete-session-title-{{ session.id }}" aria-hidden="true">
                            <div class="delete-session-backdrop fixed inset-0 bg-slate-950/55 backdrop-blur-sm"
                                 data-delete-session-close="delete-session-modal-{{ session.id }}"></div>
                            <div class="fixed inset-0 flex items-center justify-center p-4">
                                <div class="delete-session-panel relative w-full max-w-md overflow-hidden rounded-2xl bg-white shadow-2xl" style="border:1px solid var(--border);">

                                    <div class="modal-header-blue">
                                        <div style="display:flex;align-items:flex-start;gap:.75rem;">
                                            <div style="width:40px;height:40px;border-radius:.625rem;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                                <svg class="w-5 h-5" fill="none" stroke="white" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M4.93 19h14.14c1.54 0 2.5-1.67 1.73-3L13.73 4c-.77-1.33-2.69-1.33-3.46 0L3.2 16c-.77 1.33.19 3 1.73 3z"/></svg>
                                            </div>
                                            <div>
                                                <h4 id="delete-session-title-{{ session.id }}" style="font-size:1rem;font-weight:800;color:#fff;margin:0 0 .2rem;">Supprimer la session</h4>
                                                <p style="font-size:.8rem;color:#93c5fd;margin:0;">Du {{ session.dateDebut|date('d/m/Y') }} au {{ session.dateFin|date('d/m/Y') }}</p>
                                            </div>
                                        </div>
                                    </div>

                                    <div style="padding:1.25rem 1.5rem; background:#f8fafd;">
                                        <div style="background:#fff;border:1px solid var(--border);border-radius:.625rem;padding:.85rem 1rem;font-size:.82rem;color:var(--muted);line-height:1.5;">
                                            Cette action est irréversible. Les données de la session seront supprimées définitivement.
                                        </div>
                                        <div style="display:flex;justify-content:flex-end;gap:.6rem;margin-top:1rem;flex-wrap:wrap;">
                                            <button type="button" class="btn-modal-cancel"
                                                    data-delete-session-close="delete-session-modal-{{ session.id }}">
                                                Annuler
                                            </button>
                                            <form method="post" action="{{ path('rh_formation_session_delete', {id: session.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-session-' ~ session.id) }}">
                                                <button type="submit" class="btn-modal-delete">
                                                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24" style="margin-right:.3rem"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                    Oui, supprimer
                                                </button>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>

                    {% else %}
                        <div class="col-span-full">
                            <div class="empty-state">
                                <div style="width:48px;height:48px;border-radius:.75rem;background:var(--light);display:flex;align-items:center;justify-content:center;margin:0 auto .75rem;">
                                    <svg width="22" height="22" fill="none" stroke="#145EB7" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                </div>
                                <p style="font-size:.95rem;font-weight:700;color:var(--deep);margin:0 0 .3rem;">Aucune session programmée</p>
                                <p style="font-size:.82rem;color:var(--muted);margin:0 0 1.25rem;">Commencez par créer la première session pour cette formation.</p>
                                <a href="{{ path('rh_formation_session_create', {id: formation.id}) }}" class="btn-new-session">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                                    Créer la première session
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>

            </section>
        </main>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
    (function () {
        if (window.__deleteSessionModalBound) return;
        window.__deleteSessionModalBound = true;

        function openModal(modal)  { if (!modal) return; modal.classList.add('is-open'); modal.setAttribute('aria-hidden','false'); document.body.classList.add('overflow-hidden'); }
        function closeModal(modal) { if (!modal) return; modal.classList.remove('is-open'); modal.setAttribute('aria-hidden','true'); if (!document.querySelector('.delete-session-modal.is-open')) document.body.classList.remove('overflow-hidden'); }

        document.addEventListener('click', function (e) {
            var open = e.target.closest('[data-delete-session-open]');
            if (open) { openModal(document.getElementById(open.dataset.deleteSessionOpen)); return; }
            var close = e.target.closest('[data-delete-session-close]');
            if (close) { closeModal(document.getElementById(close.dataset.deleteSessionClose)); }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;
            document.querySelectorAll('.delete-session-modal.is-open').forEach(closeModal);
        });
    })();
    </script>
{% endblock %}
