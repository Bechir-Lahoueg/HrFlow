                                <td class="py-4 px-5"><div class="flex items-center gap-3"><div class="w-8 h-8 rounded-xl bg-gradient-to-br from-teal-500 to-emerald-500 flex items-center justify-center shrink-0 shadow-sm"><span class="text-[11px] font-bold text-white">{{ leave.employeeName|first|upper }}</span></div><span class="text-[13px] font-semibold text-zinc-700 dark:text-zinc-300">{{ leave.employeeName }}</span></div></td>
                                <td class="py-4 px-4"><p class="text-[13px] font-medium text-zinc-700 dark:text-zinc-300">{{ leave.startDate|date('d M') }}</p><p class="text-[11px] text-zinc-400">au {{ leave.endDate|date('d M Y') }}</p></td>
                                <td class="py-4 px-4"><div class="flex flex-col gap-1.5"><span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 w-fit">{{ leave.leaveType }}</span>{% if leave.requestCategory == 'EXCEPTION' %}<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-[10px] font-bold text-violet-700 dark:text-violet-400 bg-violet-50 dark:bg-violet-950/30 border border-violet-200 dark:border-violet-800/50 w-fit"><svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>EXCEPTION</span>{% endif %}</div></td>
                                <td class="py-4 px-4 text-center"><span class="text-[15px] font-extrabold text-zinc-800 dark:text-zinc-200 font-mono-num">{{ leave.daysCount }}</span></td>
                                <td class="py-4 px-4">{% set available = balanceMap[leave.employee.id]|default(0) %}{% set afterBalance = available - leave.daysCount %}<div class="space-y-1"><div class="flex items-center gap-1.5"><span class="w-2 h-2 rounded-full {{ afterBalance < 0 ? 'bg-rose-500' : 'bg-emerald-500' }}"></span><span class="text-[12px] font-bold {{ afterBalance < 0 ? 'text-rose-600 dark:text-rose-400' : 'text-emerald-700 dark:text-emerald-400' }} font-mono-num">{{ available|number_format(1, '.', ',') }}j</span></div><p class="text-[10px] text-zinc-400 pl-3.5 font-mono-num">Apres: {{ afterBalance|number_format(1, '.', ',') }}j</p></div></td>
                                <td class="py-4 px-4">{% if leave.status == 'ATTENTE' %}<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 dark:bg-amber-950/30 text-amber-700 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50"><span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>ATTENTE</span>{% elseif leave.status == 'ACCEPTE' %}<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 dark:bg-emerald-950/30 text-emerald-700 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>ACCEPTE</span>{% elseif leave.status == 'REFUSE' %}<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-50 dark:bg-rose-950/30 text-rose-700 dark:text-rose-400 border border-rose-200 dark:border-rose-800/50"><span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>REFUSE</span>{% endif %}</td>
                                <td class="py-4 px-4 max-w-[200px]"><div class="space-y-1"><p class="text-[12px] text-zinc-500 dark:text-zinc-400 truncate" title="{{ leave.reason }}">{{ leave.reason ?: '-' }}</p>{% if leave.requestCategory == 'EXCEPTION' %}<p class="text-[10px] font-bold text-violet-600 dark:text-violet-400">Urgence: {{ leave.urgencyLevel ?: '-' }}</p>{% if leave.attachmentPath %}<a href="{{ leave.attachmentPath }}" target="_blank" class="inline-flex items-center gap-1 text-[10px] font-bold text-sky-600 dark:text-sky-400 hover:text-sky-700 transition-colors"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13"/></svg>Justificatif</a>{% endif %}{% endif %}</div></td>
                                <td class="py-4 px-4">
                                    {% if leave.status == 'ATTENTE' %}
                                        {% if leave.requestCategory == 'EXCEPTION' and leave.workflowStatus == 'ADMIN_PENDING' %}
                                            <div class="text-[11px] action-card bg-violet-50 dark:bg-violet-950/20 border-violet-200 dark:border-violet-800/50 p-3"><div class="flex items-center gap-1.5 mb-1"><svg class="w-3 h-3 text-violet-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg><span class="font-bold text-violet-600 dark:text-violet-400">En attente Admin</span></div><p class="text-zinc-400">Pre-approuvee RH</p></div>
                                        {% else %}
                                            <div class="space-y-2 min-w-[220px]">
                                                <form method="post" action="{{ path('app_rh_leave_approve', {id: leave.id}) }}" class="action-card action-card-approve space-y-2"><input type="hidden" name="_token" value="{{ csrf_token('rh_leave_approve_' ~ leave.id) }}"><input name="rh_comment" type="text" placeholder="Commentaire (optionnel)" class="input-refined w-full rounded-lg text-[11px] bg-white dark:bg-zinc-800 py-1.5 px-2.5 placeholder:text-zinc-300 dark:placeholder:text-zinc-600"><button type="submit" class="w-full text-[11px] font-bold px-3 py-2 rounded-lg bg-emerald-600 text-white hover:bg-emerald-700 transition-all flex items-center justify-center gap-1.5 active:scale-[0.98] shadow-sm shadow-emerald-500/20"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>{{ leave.requestCategory == 'EXCEPTION' ? 'Pre-approuver' : 'Approuver' }}</button></form>
                                                <form method="post" action="{{ path('app_rh_leave_reject', {id: leave.id}) }}" class="action-card action-card-reject space-y-2" novalidate><input type="hidden" name="_token" value="{{ csrf_token('rh_leave_reject_' ~ leave.id) }}"><input name="rh_comment" type="text" placeholder="Motif du refus (obligatoire)" class="input-refined w-full rounded-lg text-[11px] bg-white dark:bg-zinc-800 py-1.5 px-2.5 placeholder:text-zinc-300 dark:placeholder:text-zinc-600"><button type="submit" class="w-full text-[11px] font-bold px-3 py-2 rounded-lg bg-rose-600 text-white hover:bg-rose-700 transition-all flex items-center justify-center gap-1.5 active:scale-[0.98] shadow-sm shadow-rose-500/20"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>Refuser</button></form>
                                            </div>
                                        {% endif %}
                                    {% else %}
                                        <div class="text-[11px] text-zinc-400 dark:text-zinc-500 card-surface p-3 space-y-2"><div><p class="font-bold text-zinc-500 dark:text-zinc-400 mb-0.5 flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/></svg>RH:</p><p>{{ leave.rhComment ?: '-' }}</p></div>{% if leave.adminComment %}<div class="pt-2 border-t border-zinc-100 dark:border-zinc-800"><p class="font-bold text-zinc-500 dark:text-zinc-400 mb-0.5 flex items-center gap-1"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/></svg>Admin:</p><p>{{ leave.adminComment }}</p></div>{% endif %}</div>
                                    {% endif %}
                                </td>
                            </tr>
                            {% else %}
                            <tr><td colspan="8" class="py-20 text-center"><div class="w-16 h-16 rounded-2xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mx-auto mb-4"><svg class="w-7 h-7 text-zinc-300 dark:text-zinc-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"/></svg></div><p class="text-sm font-semibold text-zinc-400 dark:text-zinc-500">Aucune demande trouvee</p><p class="text-xs text-zinc-300 dark:text-zinc-600 mt-1">Modifiez vos filtres</p></td></tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            {# ══════════════════════════════════════════════ #}
            {# ═══════════ PANEL 4: CALENDRIER ════════════ #}
            {# ══════════════════════════════════════════════ #}
            <div data-tab-switcher-target="panel" class="hidden">
                <section class="card-surface overflow-hidden"
                         data-controller="calendar"
                         data-calendar-leaves-value="{{ calendarLeaves|json_encode|e('html_attr') }}"
                         data-calendar-country-value="TN">

                    <div class="px-6 py-5 border-b border-zinc-100 dark:border-zinc-800/50">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-violet-500/25">
                                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-3.75h.008v.008H12v-.008z"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-base font-bold text-zinc-800 dark:text-zinc-200">Calendrier equipe</h3>
                                    <p class="text-[11px] text-zinc-400">Jours feries + conges de votre equipe</p>
                                </div>
                            </div>

                            <div class="flex items-center gap-2">
                                <button data-action="click->calendar#prev" class="w-9 h-9 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 flex items-center justify-center text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
                                </button>
                                <span data-calendar-target="monthLabel" class="text-sm font-bold text-zinc-800 dark:text-zinc-200 min-w-[140px] text-center font-mono-num"></span>
                                <button data-action="click->calendar#next" class="w-9 h-9 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 flex items-center justify-center text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
                                </button>
                                <button data-action="click->calendar#today" class="px-3 py-1.5 rounded-lg text-[11px] font-bold text-teal-700 dark:text-teal-400 bg-teal-50 dark:bg-teal-950/30 border border-teal-200 dark:border-teal-800/50 hover:bg-teal-100 dark:hover:bg-teal-950/50 transition-colors">
                                    Aujourd'hui
                                </button>
                            </div>
                        </div>

                        {# Legend #}
                        <div class="flex items-center gap-4 mt-4 flex-wrap">
                            <div class="flex items-center gap-1.5 text-[10px] font-semibold text-zinc-500"><span class="w-3 h-3 rounded bg-teal-500 border border-teal-600"></span>Aujourd'hui</div>
                            <div class="flex items-center gap-1.5 text-[10px] font-semibold text-zinc-500"><span class="w-3 h-3 rounded bg-rose-100 border border-rose-200 dark:bg-rose-950/30 dark:border-rose-800/50"></span>Jour ferie</div>
                            <div class="flex items-center gap-1.5 text-[10px] font-semibold text-zinc-500"><span class="w-3 h-3 rounded bg-teal-100 border-l-2 border-teal-500 dark:bg-teal-950/30"></span>Employe en conge</div>
                            <div class="flex items-center gap-1.5 text-[10px] font-semibold text-zinc-500"><span class="w-3 h-3 rounded bg-zinc-100 dark:bg-zinc-800"></span>Weekend</div>
                        </div>
                    </div>

                    <div class="p-6" data-calendar-target="grid"></div>
                </section>
            </div>

        </main>
    </div>
</div>
{% endblock %}
