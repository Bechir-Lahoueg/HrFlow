                        </div>
                        <span class="text-[10px] font-bold text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/30 border border-amber-200 dark:border-amber-800/50 px-2.5 py-1 rounded-lg uppercase tracking-wider font-mono-num">{{ upcomingLeaves|default([])|length }} prevu{{ upcomingLeaves|default([])|length > 1 ? 's' : '' }}</span>
                    </div>
                    {% if upcomingLeaves|default([])|length > 0 %}
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-sm">
                            <thead>
                                <tr class="border-b border-zinc-100 dark:border-zinc-800/50">
                                    <th class="text-left text-[10px] font-bold uppercase tracking-[0.1em] text-zinc-400 py-3 px-5 bg-zinc-50/60 dark:bg-zinc-800/30">Employe</th>
                                    <th class="text-left text-[10px] font-bold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Periode</th>
                                    <th class="text-center text-[10px] font-bold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Jours</th>
                                    <th class="text-left text-[10px] font-bold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Type</th>
                                    <th class="text-left text-[10px] font-bold uppercase tracking-[0.1em] text-zinc-400 py-3 px-4 bg-zinc-50/60 dark:bg-zinc-800/30">Statut</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-zinc-50 dark:divide-zinc-800/30">
                            {% for leave in upcomingLeaves %}
                                {% set isCurrentlyOnLeave = (leave.startDate|date('Y-m-d') <= 'now'|date('Y-m-d')) and (leave.endDate|date('Y-m-d') >= 'now'|date('Y-m-d')) %}
                                <tr class="row-refined">
                                    <td class="py-3.5 px-5"><div class="flex items-center gap-3"><div class="w-8 h-8 rounded-xl bg-gradient-to-br {{ isCurrentlyOnLeave ? 'from-orange-500 to-red-500' : 'from-teal-500 to-emerald-500' }} flex items-center justify-center shrink-0 shadow-sm"><span class="text-[11px] font-bold text-white">{{ leave.employeeName|first|upper }}</span></div><span class="text-[13px] font-semibold text-zinc-700 dark:text-zinc-300">{{ leave.employeeName }}</span></div></td>
                                    <td class="py-3.5 px-4"><p class="text-[13px] font-medium text-zinc-700 dark:text-zinc-300">{{ leave.startDate|date('d M') }} — {{ leave.endDate|date('d M Y') }}</p></td>
                                    <td class="py-3.5 px-4 text-center"><span class="text-[14px] font-bold text-zinc-800 dark:text-zinc-200 font-mono-num">{{ leave.daysCount }}</span></td>
                                    <td class="py-3.5 px-4"><span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">{{ leave.leaveType }}</span></td>
                                    <td class="py-3.5 px-4">
                                        {% if isCurrentlyOnLeave %}
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-orange-50 dark:bg-orange-950/30 text-orange-700 dark:text-orange-400 border border-orange-200 dark:border-orange-800/50"><span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span>En conge</span>
                                        {% else %}
                                            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-semibold bg-sky-50 dark:bg-sky-950/30 text-sky-700 dark:text-sky-400 border border-sky-200 dark:border-sky-800/50"><svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>{{ leave.startDate|date('d/m') }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                        <div class="py-16 text-center"><p class="text-sm text-zinc-400">Aucun conge a venir pour le moment</p></div>
                    {% endif %}
                </section>
            </div>

