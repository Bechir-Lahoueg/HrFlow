{% extends "base.html.twig" %}

{% block title %}Fiches de Paie - Gestion RH{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            <!-- Header -->
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white">Fiches de Paie</h1>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Gestion complète des fiches de paie des employés</p>
                </div>
                <a href="{{ path('app_rh_payroll_fiche_create') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-teal-600 hover:bg-teal-700 text-white rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg shadow-teal-500/20">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Créer une fiche
                </a>
            </div>

            <!-- Statistics Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-5 shadow-sm">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-slate-600 dark:text-slate-400 text-sm font-medium">Total Fiches</p>
                            <p class="text-3xl font-bold text-slate-900 dark:text-white mt-2">{{ stats.totalFiches ?? 0 }}</p>
                        </div>
                        <div class="bg-teal-100 dark:bg-teal-900/30 p-4 rounded-lg">
                            <svg class="w-8 h-8 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-5 shadow-sm">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-slate-600 dark:text-slate-400 text-sm font-medium">Masse Salariale</p>
                            <p class="text-3xl font-bold text-slate-900 dark:text-white mt-2">{{ stats.totalNet ?? '0.00' }} TND</p>
                        </div>
                        <div class="bg-emerald-100 dark:bg-emerald-900/30 p-4 rounded-lg">
                            <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-5 shadow-sm">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-slate-600 dark:text-slate-400 text-sm font-medium">Total Primes</p>
                            <p class="text-3xl font-bold text-slate-900 dark:text-white mt-2">{{ stats.totalPrimes ?? '0.00' }} TND</p>
                        </div>
                        <div class="bg-blue-100 dark:bg-blue-900/30 p-4 rounded-lg">
                            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2.25A4.5 4.5 0 0010.5 21h6a4.5 4.5 0 004.5-4.5v-2.25m-3-6V11m0-5.5v-1a3 3 0 00-3-3H5a3 3 0 00-3 3v1m0 0V11m0-5.5A3 3 0 015 2.5h6a3 3 0 013 3v1"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-5 shadow-sm">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-slate-600 dark:text-slate-400 text-sm font-medium">Total Déductions</p>
                            <p class="text-3xl font-bold text-slate-900 dark:text-white mt-2">{{ stats.totalDeductions ?? '0.00' }} TND</p>
                        </div>
                        <div class="bg-orange-100 dark:bg-orange-900/30 p-4 rounded-lg">
                            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17H3v-2h10v2zm-2-4H3v-2h8v2zm4-4H3V7h12v2z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Filters and Search -->
            <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-6 shadow-sm">
                <form method="get" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Employé</label>
                        <input type="text" name="employee" value="{{ filters.employee }}" placeholder="Nom de l'employé..." class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-2 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-300">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Période</label>
                        <input type="text" name="period" value="{{ filters.period }}" placeholder="Mois-Année (ex: 1-2024)..." class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-2 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-300">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Tri</label>
                        <select name="sort" class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-2 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-300">
                            <option value="createdAt-DESC" {% if filters.sort == 'createdAt-DESC' %}selected{% endif %}>Plus récent</option>
                            <option value="createdAt-ASC" {% if filters.sort == 'createdAt-ASC' %}selected{% endif %}>Plus ancien</option>
                            <option value="mois-ASC" {% if filters.sort == 'mois-ASC' %}selected{% endif %}>Mois croissant</option>
                            <option value="mois-DESC" {% if filters.sort == 'mois-DESC' %}selected{% endif %}>Mois décroissant</option>
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white rounded-lg font-semibold transition-all">
                            Filtrer
                        </button>
                    </div>
                </form>
            </div>

            <!-- Fiches Table -->
            <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 overflow-hidden shadow-sm">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-slate-50 dark:bg-zinc-700 border-b border-slate-200 dark:border-zinc-600">
                            <tr>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Employé</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Période</th>
                                <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Salaire Brut</th>
                                <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Primes</th>
                                <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Déductions</th>
                                <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Salaire Net</th>
                                <th class="px-6 py-4 text-center text-sm font-semibold text-slate-900 dark:text-white">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-zinc-600">
                            {% for fiche in fiches %}
                                <tr class="hover:bg-slate-50 dark:hover:bg-zinc-700 transition-colors">
                                    <td class="px-6 py-4 text-slate-900 dark:text-white font-medium">{{ fiche.employee.fullName }}</td>
                                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400">{{ fiche.periodLabel }}</td>
                                    <td class="px-6 py-4 text-right text-slate-900 dark:text-white font-semibold">{{ fiche.salaireBrut }} TND</td>
                                    <td class="px-6 py-4 text-right text-green-600 font-semibold">{{ fiche.totalPrimes }} TND</td>
                                    <td class="px-6 py-4 text-right text-orange-600 font-semibold">{{ fiche.totalDeductions }} TND</td>
                                    <td class="px-6 py-4 text-right text-teal-600 dark:text-teal-400 font-bold text-lg">{{ fiche.salaireNet }} TND</td>
                                    <td class="px-6 py-4 text-center">
                                        <div class="flex items-center justify-center gap-2">
                                            <a href="{{ path('app_rh_payroll_fiche_show', {id: fiche.id}) }}" class="text-teal-600 hover:text-teal-800 dark:text-teal-400 p-2 hover:bg-teal-50 dark:hover:bg-teal-900/20 rounded transition-colors" title="Voir">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                                </svg>
                                            </a>
                                            <a href="{{ path('app_rh_payroll_fiche_edit', {id: fiche.id}) }}" class="text-amber-600 hover:text-amber-800 dark:text-amber-400 p-2 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded transition-colors" title="Modifier">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                </svg>
                                            </a>
                                            <form method="post" action="{{ path('app_rh_payroll_fiche_delete', {id: fiche.id}) }}" class="inline" onsubmit="return confirm('Êtes-vous sûr ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_fiche_paie_' ~ fiche.id) }}">
                                                <button type="submit" class="text-red-600 hover:text-red-800 dark:text-red-400 p-2 hover:bg-red-50 dark:hover:bg-red-900/20 rounded transition-colors" title="Supprimer">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="7" class="px-6 py-12 text-center text-slate-600 dark:text-slate-400">
                                        <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                        </svg>
                                        <p class="text-lg font-semibold">Aucune fiche de paie trouvée</p>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="flex gap-4">
                <a href="{{ path('app_rh_payroll_primes') }}" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg shadow-blue-500/20">
                    Gérer les Primes
                </a>
                <a href="{{ path('app_rh_payroll_deductions') }}" class="px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg shadow-orange-500/20">
                    Gérer les Déductions
                </a>
            </div>
        </main>
    </div>
</div>
{% endblock %}
