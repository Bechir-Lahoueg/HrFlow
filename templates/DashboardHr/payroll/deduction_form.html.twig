{% extends "base.html.twig" %}

{% block title %}{% if isEdit %}Modifier{% else %}Ajouter{% endif %} Déduction - Gestion RH{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-3xl mx-auto">
            <!-- Header -->
            <div>
                <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white">
                    {% if isEdit %}Modifier{% else %}Ajouter{% endif %} une Déduction
                </h1>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Remplissez le formulaire ci-dessous</p>
            </div>

            <!-- Form Card -->
            <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-8 shadow-sm">
                <form method="post" class="space-y-6">
                    <input type="hidden" name="_token" value="{% if isEdit %}{{ csrf_token('edit_deduction_' ~ deduction.id) }}{% else %}{{ csrf_token('create_deduction') }}{% endif %}">

                    <!-- Employee Selection -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Employé *</label>
                        <select name="employee_id" required class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-orange-300">
                            <option value="">-- Sélectionner un employé --</option>
                            {% if deduction %}<option value="{{ deduction.employee.id }}" selected>{{ deduction.employee.fullName }}</option>{% endif %}
                            {% for employee in employees %}
                                {% if not deduction or deduction.employee.id != employee.id %}
                                    <option value="{{ employee.id }}">{{ employee.fullName }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>

                    <!-- Deduction Type -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Type de Déduction *</label>
                        <input type="text" name="type_deduction" value="{% if deduction %}{{ deduction.typeDeduction }}{% endif %}" required placeholder="Ex: Avance sur salaire..." class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-orange-300">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Amount -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Montant (TND) *</label>
                            <input type="number" name="montant" value="{% if deduction %}{{ deduction.montant }}{% endif %}" step="0.01" min="0.01" required class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-orange-300" placeholder="0.00">
                        </div>

                        <!-- Date -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Date de Déduction *</label>
                            <input type="date" name="date_deduction" value="{% if deduction %}{{ deduction.dateDeduction|date('Y-m-d') }}{% else %}{{ 'now'|date('Y-m-d') }}{% endif %}" required class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-orange-300">
                        </div>
                    </div>

                    <!-- Motif -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Motif</label>
                        <textarea name="motif" rows="4" class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-orange-300" placeholder="Motif de la déduction...">{% if deduction %}{{ deduction.motif }}{% endif %}</textarea>
                    </div>

                    <!-- Form Actions -->
                    <div class="flex gap-4 pt-6 border-t border-slate-200 dark:border-zinc-700">
                        <button type="submit" class="flex-1 px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg shadow-orange-500/20">
                            {% if isEdit %}Mettre à jour{% else %}Ajouter{% endif %}
                        </button>
                        <a href="{{ path('app_rh_payroll_deductions') }}" class="flex-1 px-6 py-3 bg-slate-200 hover:bg-slate-300 dark:bg-zinc-700 dark:hover:bg-zinc-600 text-slate-900 dark:text-white rounded-lg font-semibold transition-all text-center">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</div>
{% endblock %}
