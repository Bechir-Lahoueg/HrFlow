{% extends "base.html.twig" %}

{% block title %}{% if isEdit %}Modifier{% else %}Créer{% endif %} Fiche de Paie - Gestion RH{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-3xl mx-auto">
            <!-- Header -->
            <div>
                <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white">
                    {% if isEdit %}Modifier{% else %}Créer{% endif %} une Fiche de Paie
                </h1>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Remplissez le formulaire ci-dessous</p>
            </div>

            <!-- Form Card -->
            <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-8 shadow-sm">
                <form method="post" class="space-y-6">
                    <input type="hidden" name="_token" value="{% if isEdit %}{{ csrf_token('edit_fiche_paie_' ~ fiche.id) }}{% else %}{{ csrf_token('create_fiche_paie') }}{% endif %}">

                    <!-- Employee Selection -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Employé *</label>
                        <select name="employee_id" required class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-300">
                            <option value="">-- Sélectionner un employé --</option>
                            {% if fiche %}<option value="{{ fiche.employee.id }}" selected>{{ fiche.employee.fullName }}</option>{% endif %}
                            {% for employee in employees %}
                                {% if not fiche or fiche.employee.id != employee.id %}
                                    <option value="{{ employee.id }}">{{ employee.fullName }}</option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Month -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Mois *</label>
                            <select name="mois" required class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-300">
                                <option value="">-- Sélectionner --</option>
                                <option value="1" {% if fiche and fiche.mois == 1 %}selected{% endif %}>Janvier</option>
                                <option value="2" {% if fiche and fiche.mois == 2 %}selected{% endif %}>Février</option>
                                <option value="3" {% if fiche and fiche.mois == 3 %}selected{% endif %}>Mars</option>
                                <option value="4" {% if fiche and fiche.mois == 4 %}selected{% endif %}>Avril</option>
                                <option value="5" {% if fiche and fiche.mois == 5 %}selected{% endif %}>Mai</option>
                                <option value="6" {% if fiche and fiche.mois == 6 %}selected{% endif %}>Juin</option>
                                <option value="7" {% if fiche and fiche.mois == 7 %}selected{% endif %}>Juillet</option>
                                <option value="8" {% if fiche and fiche.mois == 8 %}selected{% endif %}>Août</option>
                                <option value="9" {% if fiche and fiche.mois == 9 %}selected{% endif %}>Septembre</option>
                                <option value="10" {% if fiche and fiche.mois == 10 %}selected{% endif %}>Octobre</option>
                                <option value="11" {% if fiche and fiche.mois == 11 %}selected{% endif %}>Novembre</option>
                                <option value="12" {% if fiche and fiche.mois == 12 %}selected{% endif %}>Décembre</option>
                            </select>
                        </div>

                        <!-- Year -->
                        <div>
                            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Année *</label>
                            <input type="number" name="annee" value="{% if fiche %}{{ fiche.annee }}{% else %}{{ 'now'|date('Y') }}{% endif %}" min="2000" max="2100" required class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-300">
                        </div>
                    </div>

                    <!-- Gross Salary -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Salaire Brut (TND) *</label>
                        <input type="number" name="salaire_brut" value="{% if fiche %}{{ fiche.salaireBrut }}{% endif %}" step="0.01" min="0" required class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-300" placeholder="Ex: 2000.00">
                        <p class="text-xs text-slate-600 dark:text-slate-400 mt-1">Les primes et déductions existantes seront automatiquement incluses</p>
                    </div>

                    <!-- Notes -->
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-3">Remarques</label>
                        <textarea name="notes" rows="4" class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-3 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-300" placeholder="Ajouter des remarques optionnelles...">{% if fiche %}{{ fiche.notes }}{% endif %}</textarea>
                    </div>

                    <!-- Form Actions -->
                    <div class="flex gap-4 pt-6 border-t border-slate-200 dark:border-zinc-700">
                        <button type="submit" class="flex-1 px-6 py-3 bg-teal-600 hover:bg-teal-700 text-white rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg shadow-teal-500/20">
                            {% if isEdit %}Mettre à jour{% else %}Créer{% endif %}
                        </button>
                        <a href="{{ path('app_rh_payroll_fiches') }}" class="flex-1 px-6 py-3 bg-slate-200 hover:bg-slate-300 dark:bg-zinc-700 dark:hover:bg-zinc-600 text-slate-900 dark:text-white rounded-lg font-semibold transition-all text-center">
                            Annuler
                        </a>
                    </div>
                </form>
            </div>
        </main>
    </div>
</div>
{% endblock %}
