{% extends "base.html.twig" %}

{% block title %}Gestion des Primes - Gestion RH{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
            <!-- Header -->
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl font-extrabold text-slate-800 dark:text-white">Gestion des Primes</h1>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Gérez les primes des employés</p>
                </div>
                <a href="{{ path('app_rh_payroll_prime_create') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg shadow-blue-500/20">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    Ajouter une prime
                </a>
            </div>

            <!-- Statistics -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-5 shadow-sm">
                    <p class="text-slate-600 dark:text-slate-400 text-sm font-medium">Total Primes</p>
                    <p class="text-3xl font-bold text-blue-600 mt-2">{{ stats.totalPrimes ?? 0 }}</p>
                </div>
                <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-5 shadow-sm">
                    <p class="text-slate-600 dark:text-slate-400 text-sm font-medium">Montant Total</p>
                    <p class="text-3xl font-bold text-blue-600 mt-2">{{ stats.totalMontant ?? '0.00' }} TND</p>
                </div>
            </div>

            <!-- Filters -->
            <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 p-6 shadow-sm">
                <form method="get" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Employé</label>
                        <input type="text" name="employee" value="{{ filters.employee }}" placeholder="Nom..." class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-2 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-300">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Type</label>
                        <input type="text" name="type" value="{{ filters.type }}" placeholder="Type de prime..." class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-2 text-slate-900 dark:text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-300">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Tri</label>
                        <select name="sort" class="w-full rounded-lg border border-slate-200 dark:border-zinc-700 bg-slate-50 dark:bg-zinc-700 px-4 py-2 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-300">
                            <option value="dateAttribution-DESC" {% if filters.sort == 'dateAttribution-DESC' %}selected{% endif %}>Plus récent</option>
                            <option value="dateAttribution-ASC" {% if filters.sort == 'dateAttribution-ASC' %}selected{% endif %}>Plus ancien</option>
                            <option value="montant-DESC" {% if filters.sort == 'montant-DESC' %}selected{% endif %}>Montant décroissant</option>
                            <option value="montant-ASC" {% if filters.sort == 'montant-ASC' %}selected{% endif %}>Montant croissant</option>
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-all">
                            Filtrer
                        </button>
                    </div>
                </form>
            </div>

            <!-- Primes Table -->
            <div class="bg-white dark:bg-zinc-800 rounded-xl border border-slate-200 dark:border-zinc-700/50 overflow-hidden shadow-sm">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-slate-50 dark:bg-zinc-700 border-b border-slate-200 dark:border-zinc-600">
                            <tr>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Employé</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Type</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Motif</th>
                                <th class="px-6 py-4 text-right text-sm font-semibold text-slate-900 dark:text-white">Montant</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-slate-900 dark:text-white">Date</th>
                                <th class="px-6 py-4 text-center text-sm font-semibold text-slate-900 dark:text-white">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-200 dark:divide-zinc-600">
                            {% for prime in primes %}
                                <tr class="hover:bg-slate-50 dark:hover:bg-zinc-700 transition-colors">
                                    <td class="px-6 py-4 text-slate-900 dark:text-white font-medium">{{ prime.employee.fullName }}</td>
                                    <td class="px-6 py-4 text-slate-700 dark:text-slate-300">{{ prime.typePrime }}</td>
                                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400 text-sm max-w-xs truncate">{{ prime.motif ?? '—' }}</td>
                                    <td class="px-6 py-4 text-right text-blue-600 dark:text-blue-400 font-bold text-lg">{{ prime.montant }} TND</td>
                                    <td class="px-6 py-4 text-slate-600 dark:text-slate-400">{{ prime.dateAttribution|date('d/m/Y') }}</td>
                                    <td class="px-6 py-4 text-center">
                                        <div class="flex items-center justify-center gap-2">
                                            <a href="{{ path('app_rh_payroll_prime_edit', {id: prime.id}) }}" class="text-amber-600 hover:text-amber-800 dark:text-amber-400 p-2 hover:bg-amber-50 dark:hover:bg-amber-900/20 rounded transition-colors" title="Modifier">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                </svg>
                                            </a>
                                            <form method="post" action="{{ path('app_rh_payroll_prime_delete', {id: prime.id}) }}" class="inline" onsubmit="return confirm('Êtes-vous sûr ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_prime_' ~ prime.id) }}">
                                                <button type="submit" class="text-red-600 hover:text-red-800 dark:text-red-400 p-2 hover:bg-red-50 dark:hover:bg-red-900/20 rounded transition-colors" title="Supprimer">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                    </svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center text-slate-600 dark:text-slate-400">
                                        <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2.25A4.5 4.5 0 0010.5 21h6a4.5 4.5 0 004.5-4.5v-2.25m-3-6V11m0-5.5v-1a3 3 0 00-3-3H5a3 3 0 00-3 3v1m0 0V11m0-5.5A3 3 0 015 2.5h6a3 3 0 013 3v1"/>
                                        </svg>
                                        <p class="text-lg font-semibold">Aucune prime trouvée</p>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="flex gap-4">
                <a href="{{ path('app_rh_payroll_fiches') }}" class="px-6 py-3 bg-teal-600 hover:bg-teal-700 text-white rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg shadow-teal-500/20">
                    Gérer les Fiches de Paie
                </a>
                <a href="{{ path('app_rh_payroll_deductions') }}" class="px-6 py-3 bg-orange-600 hover:bg-orange-700 text-white rounded-lg font-semibold transition-all transform hover:scale-105 shadow-lg shadow-orange-500/20">
                    Gérer les Déductions
                </a>
            </div>
        </main>
    </div>
</div>
{% endblock %}
