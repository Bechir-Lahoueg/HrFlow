{% extends 'base.html.twig' %}

{% block title %}{{ project is defined ? 'Modifier' : 'Nouveau' }} Projet — HRFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
:root {
    --primary: #06b6d4;
    --primary-dark: #0f172a;
    --surface: #ffffff;
    --bg: #f8f9fb;
    --border: #e2e8f0;
    --text: #1e293b;
    --text-muted: #64748b;
    --radius: 14px;
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,.1);
}
body { background: var(--bg); font-family: 'Segoe UI', system-ui, sans-serif; }

.form-wrapper {
    max-width: 800px;
    margin: 0 auto;
}
.form-card {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--border);
}
.form-header {
    background: linear-gradient(135deg, #0f172a, #1e293b 45%, #0e7490 100%);
    color: white;
    border-radius: var(--radius);
    padding: 1.75rem 2rem;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-md);
}
.form-header h1 { font-size: 1.5rem; font-weight: 700; margin: 0; }
.form-header p { margin: .3rem 0 0; opacity: .85; font-size: .875rem; }

.form-section {
    margin-bottom: 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
}
.form-section:last-child { border-bottom: none; margin-bottom: 0; }
.section-label {
    font-size: .7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: #0e7490;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: .5rem;
}
.form-label { font-weight: 600; font-size: .825rem; color: var(--text); margin-bottom: .4rem; }
.form-control, .form-select, .form-control-lg {
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: .6rem .9rem;
    font-size: .9rem;
    transition: border-color .15s, box-shadow .15s;
    background: #fafafa;
}
.form-control:focus, .form-select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(6,182,212,.15);
    background: white;
}
textarea.form-control { resize: vertical; min-height: 90px; }

.priority-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; }
.priority-option { display: none; }
.priority-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .3rem;
    padding: .75rem .5rem;
    border-radius: 10px;
    border: 2px solid var(--border);
    cursor: pointer;
    transition: all .2s;
    font-size: .8rem;
    font-weight: 600;
    text-align: center;
}
.priority-option:checked + .priority-label { border-color: var(--primary); background: #ede9fe; color: var(--primary); }
.priority-option:checked + .priority-label { background: #ecfeff; }
.priority-label:hover { border-color: var(--primary-light, #818cf8); }

.status-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
@media (max-width: 576px) { .status-grid { grid-template-columns: repeat(2, 1fr); } .priority-grid { grid-template-columns: repeat(2, 1fr); } }
.status-option { display: none; }
.status-label {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .6rem .75rem;
    border-radius: 8px;
    border: 2px solid var(--border);
    cursor: pointer;
    transition: all .2s;
    font-size: .8rem;
    font-weight: 600;
}
.status-option:checked + .status-label { border-color: var(--primary); background: #ede9fe; color: var(--primary); }
.status-option:checked + .status-label { background: #ecfeff; }

.priority-dot {
    width: .75rem;
    height: .75rem;
    border-radius: 999px;
    display: inline-block;
}

.status-dot {
    width: .6rem;
    height: .6rem;
    border-radius: 999px;
    display: inline-block;
}

.btn-submit {
    background: linear-gradient(135deg, #0f172a, #334155);
    color: white;
    border: none;
    padding: .75rem 2rem;
    border-radius: 10px;
    font-weight: 700;
    font-size: .95rem;
    cursor: pointer;
    transition: all .2s;
    box-shadow: 0 4px 15px rgba(15,23,42,.24);
}
.btn-submit:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(15,23,42,.35); }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">

    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">

        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
<div class="form-wrapper">

    <div class="form-header relative overflow-hidden">
        <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-cyan-400/15 blur-3xl"></div>
        <div class="relative z-10">
        <div class="d-flex align-items-center gap-2 mb-1" style="font-size:.8rem; opacity:.85">
            <a href="{{ path('rh_project_index') }}" style="color:#bae6fd; text-decoration:none">← Projets</a>
            {% if project is defined %}<span>/ <a href="{{ path('rh_project_show', {id: project.id}) }}" style="color:white; text-decoration:none">{{ project.name }}</a></span>{% endif %}
        </div>
        <h1>{{ project is defined ? 'Modifier le Projet' : 'Nouveau Projet' }}</h1>
        <p>{{ project is defined ? 'Mettez à jour les informations du projet.' : 'Renseignez les informations pour créer un nouveau projet.' }}</p>
        </div>
    </div>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    <div class="form-card">

        {# Résumé des erreurs côté serveur (utile si les flashes/session ne s'affichent pas) #}
        {% if errors is defined and errors|length > 0 %}
            <div class="alert alert-danger rounded-3 mb-3" role="alert">
                <strong>Veuillez corriger les erreurs suivantes :</strong>
                <ul class="mb-0 mt-2">
                    {% for message in errors %}
                        <li>{{ message }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form action="{{ project is defined ? path('rh_project_edit', {id: project.id}) : path('rh_project_new') }}" method="POST" novalidate>

            {# ── Infos générales ── #}
            <div class="form-section">
                <div class="section-label">Informations Générales</div>
                <div class="mb-3">
                    <label class="form-label">Nom du projet *</label>
                    <input type="text" name="name" class="form-control {% if errors.name is defined %}is-invalid{% endif %}"
                           value="{{ old_data.name ?? project.name ?? '' }}"
                           placeholder="Ex: Refonte site web, Migration cloud...">
                    {% if errors.name|default(null) %}
                        <div class="invalid-feedback d-block">{{ errors.name }}</div>
                    {% endif %}
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control" rows="3"
                              placeholder="Décrivez les objectifs et le périmètre du projet...">{{ old_data.description ?? project.description ?? '' }}</textarea>
                </div>
            </div>

            {# ── Statut et Priorité ── #}
            <div class="form-section">
                <div class="section-label">Statut et Priorité</div>
                <div class="mb-4">
                    <label class="form-label">Statut</label>
                    <div class="status-grid">
                        {% set statuses = [
                            {val: 'planning', label: 'Planification', color: '#64748b'},
                            {val: 'in_progress', label: 'En cours', color: '#16a34a'},
                            {val: 'on_hold', label: 'En pause', color: '#f59e0b'},
                            {val: 'completed', label: 'Termine', color: '#2563eb'},
                            {val: 'cancelled', label: 'Annule', color: '#ef4444'}
                        ] %}
                        {% for s in statuses %}
                        <div>
                            <input type="radio" name="status" id="status_{{ s.val }}" value="{{ s.val }}" class="status-option"
                                   {% if (old_data.status ?? project.status ?? 'planning') == s.val %}checked{% endif %}>
                            <label for="status_{{ s.val }}" class="status-label w-100"><span class="status-dot" style="background: {{ s.color }}"></span>{{ s.label }}</label>
                        </div>
                        {% endfor %}
                    </div>
                    {% if errors.status|default(null) %}
                        <div class="text-danger mt-2" style="font-size:.85rem; font-weight:600">{{ errors.status }}</div>
                    {% endif %}
                </div>
                <div>
                    <label class="form-label">Priorité</label>
                    <div class="priority-grid">
                        {% set priorities = [
                            {val: 'low', color: '#16a34a', label: 'Faible'},
                            {val: 'medium', color: '#f59e0b', label: 'Moyenne'},
                            {val: 'high', color: '#f97316', label: 'Haute'},
                            {val: 'critical', color: '#ef4444', label: 'Critique'}
                        ] %}
                        {% for p in priorities %}
                        <div>
                            <input type="radio" name="priority" id="prio_{{ p.val }}" value="{{ p.val }}" class="priority-option"
                                   {% if (old_data.priority ?? project.priority ?? 'medium') == p.val %}checked{% endif %}>
                            <label for="prio_{{ p.val }}" class="priority-label w-100">
                                <span class="priority-dot" style="background: {{ p.color }}"></span>
                                {{ p.label }}
                            </label>
                        </div>
                        {% endfor %}
                    </div>
                    {% if errors.priority|default(null) %}
                        <div class="text-danger mt-2" style="font-size:.85rem; font-weight:600">{{ errors.priority }}</div>
                    {% endif %}
                </div>
            </div>

            {# ── Dates ── #}
            <div class="form-section">
                <div class="section-label">Calendrier</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Date de début</label>
                        <input type="date" name="start_date" class="form-control {% if errors.start_date is defined %}is-invalid{% endif %}"
                               value="{{ old_data.start_date ?? project.start_date ?? 'now'|date('Y-m-d') }}">
                        {% if errors.start_date|default(null) %}
                            <div class="invalid-feedback d-block">{{ errors.start_date }}</div>
                        {% endif %}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Date de fin prévue</label>
                        <input type="date" name="end_date" class="form-control {% if errors.end_date is defined %}is-invalid{% endif %}"
                               value="{{ old_data.end_date ?? project.end_date ?? '' }}">
                        {% if errors.end_date|default(null) %}
                            <div class="invalid-feedback d-block">{{ errors.end_date }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# ── Budget & Heures ── #}
            <div class="form-section">
                <div class="section-label">Budget et Ressources</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Budget (€)</label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input type="number" name="budget" class="form-control {% if errors.budget is defined %}is-invalid{% endif %}"
                                   value="{{ old_data.budget ?? project.budget ?? '' }}" min="0" step="100"
                                   placeholder="0">
                            {% if errors.budget|default(null) %}
                                <div class="invalid-feedback d-block">{{ errors.budget }}</div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Heures estimées</label>
                        <div class="input-group">
                            <input type="number" name="estimated_hours" class="form-control {% if errors.estimated_hours is defined %}is-invalid{% endif %}"
                                   value="{{ old_data.estimated_hours ?? project.estimated_hours ?? '' }}" min="0"
                                   placeholder="0">
                            <span class="input-group-text">h</span>
                            {% if errors.estimated_hours|default(null) %}
                                <div class="invalid-feedback d-block">{{ errors.estimated_hours }}</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            {# ── Actions ── #}
            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <a href="{{ project is defined ? path('rh_project_show', {id: project.id}) : path('rh_project_index') }}"
                   class="btn btn-outline-secondary fw-semibold px-4">
                    Annuler
                </a>
                <button type="submit" class="btn-submit">
                    {{ project is defined ? 'Sauvegarder les modifications' : 'Creer le projet' }}
                </button>
            </div>

        </form>
    </div>

</div>
        </main>

    </div>
</div>
{% endblock %}
