{% extends 'base.html.twig' %}

{% block title %}{{ project is defined ? 'Modifier' : 'Nouveau' }} Projet — HRFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
:root {
    --project-deep:    #022E69;
    --project-primary: #145EB7;
    --project-accent:  #3FA9F5;
    --project-border:  #D0D0D0;
    --surface: #ffffff;
    --bg: #f4f7fb;
    --text: #1e293b;
    --text-muted: #64748b;
    --radius: 14px;
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,.08);
}

body { background: var(--bg); font-family: 'Segoe UI', system-ui, sans-serif; }

/* ── Wrapper ── */
.form-wrapper { max-width: 820px; margin: 0 auto; }

/* ── Hero Banner (mirrors index) ── */
.form-header {
    background: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d);
    color: white;
    border-radius: var(--radius);
    padding: 2rem 2.25rem;
    margin-bottom: 1.5rem;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(2,46,105,.35);
}
.form-header::before {
    content: '';
    position: absolute;
    left: -4rem; bottom: -4rem;
    width: 14rem; height: 14rem;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(63,169,245,.15), transparent 70%);
}
.form-header::after {
    content: '';
    position: absolute;
    right: -4rem; top: -4rem;
    width: 14rem; height: 14rem;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(20,94,183,.18), transparent 70%);
}
.form-header .rel { position: relative; z-index: 1; }
.form-header .eyebrow {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: #3FA9F5;
    margin-bottom: .75rem;
}
.form-header .eyebrow-dot {
    width: .5rem; height: .5rem;
    border-radius: 9999px;
    background: #3FA9F5;
    animation: pulse 2s infinite;
}
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.4} }
.form-header h1 { font-size: 1.65rem; font-weight: 800; margin: 0 0 .25rem; }
.form-header p  { margin: 0; opacity: .8; font-size: .875rem; }
.breadcrumb-bar { margin-bottom: .75rem; font-size: .78rem; opacity: .85; }
.breadcrumb-bar a { color: #bae6fd; text-decoration: none; }
.breadcrumb-bar a:hover { text-decoration: underline; }

/* ── Card ── */
.form-card {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 2rem;
    box-shadow: var(--shadow-md);
    border: 1px solid #e2e8f0;
}

/* ── Sections ── */
.form-section {
    margin-bottom: 1.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid #f1f5f9;
}
.form-section:last-child { border-bottom: none; margin-bottom: 0; }

.section-label {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--project-primary);
    margin-bottom: 1.1rem;
}
.section-label .icon-badge {
    width: 1.6rem; height: 1.6rem;
    border-radius: .45rem;
    display: flex; align-items: center; justify-content: center;
    background: rgba(20,94,183,.1);
    color: var(--project-primary);
}

/* ── Fields ── */
.form-label { font-weight: 600; font-size: .82rem; color: var(--text); margin-bottom: .4rem; }
.form-control, .form-select {
    border: 1.5px solid #e2e8f0;
    border-radius: 8px;
    padding: .6rem .9rem;
    font-size: .9rem;
    background: #f8faff;
    transition: border-color .15s, box-shadow .15s;
}
.form-control:focus, .form-select:focus {
    border-color: var(--project-accent);
    box-shadow: 0 0 0 3px rgba(63,169,245,.18);
    background: #fff;
    outline: none;
}
textarea.form-control { resize: vertical; min-height: 90px; }
.input-group-text { background: #f4f7fb; border: 1.5px solid #e2e8f0; color: var(--text-muted); font-size: .85rem; }

/* ── Status pills ── */
.status-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; }
@media (max-width: 576px) { .status-grid { grid-template-columns: repeat(2, 1fr); } .priority-grid { grid-template-columns: repeat(2, 1fr); } }
.status-option { display: none; }
.status-label {
    display: flex;
    align-items: center;
    gap: .5rem;
    padding: .6rem .85rem;
    border-radius: 8px;
    border: 2px solid #e2e8f0;
    cursor: pointer;
    transition: all .18s;
    font-size: .78rem;
    font-weight: 700;
    color: var(--text-muted);
}
.status-label:hover { border-color: var(--project-accent); background: #f0f7ff; color: var(--project-primary); }
.status-option:checked + .status-label {
    border-color: var(--project-primary);
    background: rgba(20,94,183,.07);
    color: var(--project-primary);
}
.status-dot { width: .55rem; height: .55rem; border-radius: 9999px; flex-shrink: 0; }

/* ── Priority pills ── */
.priority-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .5rem; }
.priority-option { display: none; }
.priority-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: .35rem;
    padding: .75rem .5rem;
    border-radius: 10px;
    border: 2px solid #e2e8f0;
    cursor: pointer;
    transition: all .18s;
    font-size: .76rem;
    font-weight: 700;
    text-align: center;
    color: var(--text-muted);
}
.priority-label:hover { border-color: var(--project-accent); background: #f0f7ff; }
.priority-option:checked + .priority-label {
    border-color: var(--project-primary);
    background: rgba(20,94,183,.07);
    color: var(--project-deep);
}
.priority-dot { width: .8rem; height: .8rem; border-radius: 9999px; }

/* ── Progress bar mini decoration ── */
.field-deco { height: 2px; border-radius: 999px; background: linear-gradient(90deg, var(--project-primary), var(--project-accent)); margin-top: 1rem; opacity: .3; }

/* ── Buttons ── */
.btn-submit {
    background: linear-gradient(135deg, var(--project-primary), var(--project-accent));
    color: white;
    border: none;
    padding: .75rem 2.2rem;
    border-radius: 10px;
    font-weight: 800;
    font-size: .92rem;
    cursor: pointer;
    transition: all .2s;
    box-shadow: 0 4px 18px rgba(20,94,183,.28);
    display: inline-flex;
    align-items: center;
    gap: .5rem;
}
.btn-submit:hover { transform: translateY(-1px); box-shadow: 0 7px 24px rgba(20,94,183,.4); }
.btn-submit svg { width: 1rem; height: 1rem; }

.btn-cancel {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .72rem 1.6rem;
    border-radius: 10px;
    border: 1.5px solid #d1d5db;
    background: white;
    color: var(--text-muted);
    font-weight: 700;
    font-size: .88rem;
    text-decoration: none;
    transition: all .18s;
}
.btn-cancel:hover { background: #f8faff; border-color: var(--project-accent); color: var(--project-primary); }

/* ── Alerts ── */
.alert-project {
    border-radius: 10px;
    font-size: .85rem;
    margin-bottom: 1rem;
    border-left: 4px solid;
}
.alert-project.danger { background: #fff0f0; border-color: #ef4444; color: #b91c1c; }
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f4f7fb] dark:bg-zinc-950 dot-grid">

    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">

        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">
<div class="form-wrapper">

    {# ── Hero Banner ── #}
    <div class="form-header">
        <div class="rel">
            <div class="breadcrumb-bar">
                <a href="{{ path('rh_project_index') }}">← Projets</a>
                {% if project is defined %}
                    <span style="color:rgba(255,255,255,.6)"> / </span>
                    <a href="{{ path('rh_project_show', {id: project.id}) }}" style="color:white">{{ project.name }}</a>
                {% endif %}
            </div>
            <div class="eyebrow">
                <span class="eyebrow-dot"></span>
                Project Studio
            </div>
            <h1>{{ project is defined ? 'Modifier le Projet' : 'Nouveau Projet' }}</h1>
            <p>{{ project is defined ? 'Mettez à jour les informations du projet.' : 'Renseignez les informations pour créer un nouveau projet.' }}</p>
        </div>
    </div>

    {# ── Flash errors ── #}
    {% for message in app.flashes('error') %}
        <div class="alert-project danger p-3 d-flex align-items-center gap-2">
            <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            {{ message }}
        </div>
    {% endfor %}

    {# ── Card ── #}
    <div class="form-card">

        {% if errors is defined and errors|length > 0 %}
            <div class="alert-project danger p-3 mb-3">
                <strong>Veuillez corriger les erreurs suivantes :</strong>
                <ul class="mb-0 mt-2 ps-3">
                    {% for message in errors %}
                        <li>{{ message }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        <form action="{{ project is defined ? path('rh_project_edit', {id: project.id}) : path('rh_project_new') }}" method="POST" novalidate>

            {# ── Infos générales ── #}
            <div class="form-section">
                <div class="section-label">
                    <span class="icon-badge">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
                    </span>
                    Informations Générales
                </div>

                <div class="mb-3">
                    <label class="form-label">Nom du projet *</label>
                    <input type="text" name="name"
                           class="form-control {% if errors.name is defined %}is-invalid{% endif %}"
                           value="{{ old_data.name ?? project.name ?? '' }}"
                           placeholder="Ex: Refonte site web...">
                    {% if errors.name|default(null) %}
                        <div class="invalid-feedback d-block" style="font-size:.8rem; font-weight:600">{{ errors.name }}</div>
                    {% endif %}
                </div>

                <div class="mb-0">
                    <label class="form-label">Description</label>
                    <textarea name="description" class="form-control" rows="3"
                              placeholder="Décrivez les objectifs et le périmètre du projet...">{{ old_data.description ?? project.description ?? '' }}</textarea>
                </div>
                <div class="field-deco"></div>
            </div>

            {# ── Statut et Priorité ── #}
            <div class="form-section">
                <div class="section-label">
                    <span class="icon-badge">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </span>
                    Statut et Priorité
                </div>

                <div class="mb-4">
                    <label class="form-label mb-2">Statut</label>
                    <div class="status-grid">
                        {% set statuses = [
                            {val: 'planning',    label: 'Planification', color: '#64748b'},
                            {val: 'in_progress', label: 'En cours',      color: '#16a34a'},
                            {val: 'on_hold',     label: 'En pause',      color: '#f59e0b'},
                            {val: 'completed',   label: 'Terminé',       color: '#145EB7'},
                            {val: 'cancelled',   label: 'Annulé',        color: '#ef4444'}
                        ] %}
                        {% for s in statuses %}
                        <div>
                            <input type="radio" name="status" id="status_{{ s.val }}" value="{{ s.val }}" class="status-option"
                                   {% if (old_data.status ?? project.status ?? 'planning') == s.val %}checked{% endif %}>
                            <label for="status_{{ s.val }}" class="status-label w-100">
                                <span class="status-dot" style="background: {{ s.color }}"></span>
                                {{ s.label }}
                            </label>
                        </div>
                        {% endfor %}
                    </div>
                    {% if errors.status|default(null) %}
                        <div class="mt-2" style="font-size:.8rem; font-weight:700; color:#b91c1c">{{ errors.status }}</div>
                    {% endif %}
                </div>

                <div>
                    <label class="form-label mb-2">Priorité</label>
                    <div class="priority-grid">
                        {% set priorities = [
                            {val: 'low',      color: '#16a34a', label: 'Faible'},
                            {val: 'medium',   color: '#f59e0b', label: 'Moyenne'},
                            {val: 'high',     color: '#f97316', label: 'Haute'},
                            {val: 'critical', color: '#ef4444', label: 'Critique'}
                        ] %}
                        {% for p in priorities %}
                        <div>
                            <input type="radio" name="priority" id="prio_{{ p.val }}" value="{{ p.val }}" class="priority-option"
                                   {% if (old_data.priority ?? project.priority ?? 'medium') == p.val %}checked{% endif %}>
                            <label for="prio_{{ p.val }}" class="priority-label w-100">
                                <span class="priority-dot" style="background: {{ p.color }}"></span>
                                {{ p.label }}
                            </label>
                        </div>
                        {% endfor %}
                    </div>
                    {% if errors.priority|default(null) %}
                        <div class="mt-2" style="font-size:.8rem; font-weight:700; color:#b91c1c">{{ errors.priority }}</div>
                    {% endif %}
                </div>
                <div class="field-deco"></div>
            </div>

            {# ── Dates ── #}
            <div class="form-section">
                <div class="section-label">
                    <span class="icon-badge">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10m-12 4h14a2 2 0 002-2V5a2 2 0 00-2-2H4a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </span>
                    Calendrier
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Date de début</label>
                        <input type="date" name="start_date"
                               class="form-control {% if errors.start_date is defined %}is-invalid{% endif %}"
                               value="{{ old_data.start_date ?? (project.start_date is defined ? project.start_date|date('Y-m-d') : 'now'|date('Y-m-d')) }}">
                        {% if errors.start_date|default(null) %}
                            <div class="invalid-feedback d-block" style="font-size:.8rem; font-weight:600">{{ errors.start_date }}</div>
                        {% endif %}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Date de fin prévue</label>
                        <input type="date" name="end_date"
                               class="form-control {% if errors.end_date is defined %}is-invalid{% endif %}"
                               value="{{ old_data.end_date ?? (project.end_date is defined ? project.end_date|date('Y-m-d') : '') }}">
                        {% if errors.end_date|default(null) %}
                            <div class="invalid-feedback d-block" style="font-size:.8rem; font-weight:600">{{ errors.end_date }}</div>
                        {% endif %}
                    </div>
                </div>
                <div class="field-deco"></div>
            </div>

            {# ── Budget & Heures ── #}
            <div class="form-section">
                <div class="section-label">
                    <span class="icon-badge">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3.75-9.75a6 6 0 000 11.25M2.25 9.75a9 9 0 0119.5 0"/></svg>
                    </span>
                    Budget et Ressources
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Budget (€)</label>
                        <div class="input-group">
                            <span class="input-group-text">€</span>
                            <input type="number" name="budget"
                                   class="form-control {% if errors.budget is defined %}is-invalid{% endif %}"
                                   value="{{ old_data.budget ?? project.budget ?? '' }}" min="0" step="100"
                                   placeholder="0">
                        </div>
                        {% if errors.budget|default(null) %}
                            <div class="mt-1" style="font-size:.8rem; font-weight:700; color:#b91c1c">{{ errors.budget }}</div>
                        {% endif %}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Heures estimées</label>
                        <div class="input-group">
                            <input type="number" name="estimated_hours"
                                   class="form-control {% if errors.estimated_hours is defined %}is-invalid{% endif %}"
                                   value="{{ old_data.estimated_hours ?? project.estimated_hours ?? '' }}" min="0"
                                   placeholder="0">
                            <span class="input-group-text">h</span>
                        </div>
                        {% if errors.estimated_hours|default(null) %}
                            <div class="mt-1" style="font-size:.8rem; font-weight:700; color:#b91c1c">{{ errors.estimated_hours }}</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# ── Actions ── #}
            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap pt-2">
                <a href="{{ project is defined ? path('rh_project_show', {id: project.id}) : path('rh_project_index') }}"
                   class="btn-cancel">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    Annuler
                </a>
                <button type="submit" class="btn-submit">
                    <svg fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                    {{ project is defined ? 'Sauvegarder les modifications' : 'Créer le projet' }}
                </button>
            </div>

        </form>
    </div>

</div>
        </main>
    </div>
</div>
{% endblock %}
