{% extends 'base.html.twig' %}

{% block title %}Gestion des Projets — HRFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .project-card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .project-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px -8px rgba(0,0,0,0.15); }

        .progress-bar-container { height: 6px; background: #e2e8f0; border-radius: 999px; overflow: hidden; }
        .progress-bar-fill { height: 100%; border-radius: 999px; transition: width 0.8s ease; }

        .priority-indicator { width: 4px; height: 40px; border-radius: 2px; }

        .badge-pill {
            font-size: 11px;
            font-weight: 700;
            padding: 2px 10px;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">

    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">

        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# Flash messages #}
            {% for type, messages in app.flashes %}
                {% for msg in messages %}
                <div class="px-4 py-3 rounded-xl {% if type == 'success' %}bg-emerald-50 border-emerald-200 text-emerald-700{% else %}bg-red-50 border-red-200 text-red-700{% endif %} border text-sm font-medium flex items-center gap-2 animate-slide-up">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    {{ msg }}
                </div>
                {% endfor %}
            {% endfor %}

            {# ══════════ Hero Banner (Aligné à Gauche) ══════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-indigo-500/10 blur-3xl"></div>

                <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                    <div class="text-left w-full"> {# Force l'alignement à gauche #}
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-indigo-200 uppercase tracking-wider">Project Control Center</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Gestion des Projets</h2>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl">Pilotez vos équipes, suivez l'avancement et atteignez vos objectifs stratégiques.</p>
                    </div>
                    <a href="{{ path('rh_project_new') }}" class="shrink-0 px-6 py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-blue-600 text-white text-sm font-bold hover:shadow-lg hover:shadow-indigo-500/30 transition-all flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4"/></svg>
                        Nouveau Projet
                    </a>
                </div>
            </section>

            {# ══════════ Stats Grid ══════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up">
                    <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Total Projets</p>
                    <div class="flex items-end justify-between mt-2">
                        <p class="text-3xl font-extrabold text-zinc-900 dark:text-white">{{ stats.total_projects }}</p>
                        <div class="p-2 bg-slate-50 rounded-lg text-slate-600">📂</div>
                    </div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up">
                    <p class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider">En cours</p>
                    <div class="flex items-end justify-between mt-2">
                        <p class="text-3xl font-extrabold text-zinc-900 dark:text-white">{{ stats.active_projects }}</p>
                        <div class="p-2 bg-emerald-50 rounded-lg text-emerald-600">🟢</div>
                    </div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up">
                    <p class="text-[11px] font-bold text-blue-600 uppercase tracking-wider">Terminés</p>
                    <div class="flex items-end justify-between mt-2">
                        <p class="text-3xl font-extrabold text-zinc-900 dark:text-white">{{ stats.completed_projects }}</p>
                        <div class="p-2 bg-blue-50 rounded-lg text-blue-600">✅</div>
                    </div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up">
                    <p class="text-[11px] font-bold text-amber-600 uppercase tracking-wider">Taux global</p>
                    <div class="flex items-end justify-between mt-2">
                        <p class="text-3xl font-extrabold text-zinc-900 dark:text-white">{{ stats.completion_rate }}%</p>
                        <div class="p-2 bg-amber-50 rounded-lg text-amber-600">📊</div>
                    </div>
                </div>
            </div>

            {# ══════════ Filtres (Avec Bouton Filtrer + Reset) ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-4 shadow-sm">
                <form method="GET" class="flex flex-wrap items-center gap-4">
                    <div class="flex-1 min-w-[200px]">
                        <input type="text" name="search" value="{{ search }}" class="w-full bg-zinc-50 border-none rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-indigo-500" placeholder="Rechercher un projet...">
                    </div>
                    <select name="status" class="bg-zinc-50 border-none rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-indigo-500">
                        <option value="">Tous les statuts</option>
                        {% for s in statuses %}
                            <option value="{{ s }}" {% if statusFilter == s %}selected{% endif %}>{{ s|replace({'_': ' '})|capitalize }}</option>
                        {% endfor %}
                    </select>

                    {# Intégration des boutons demandés #}
                    <div class="flex gap-2 min-w-[140px]">
                        <button type="submit" class="bg-amber-400 hover:bg-amber-500 text-slate-900 font-extrabold px-6 py-2 rounded-lg text-sm shadow-sm transition-all flex-1 flex items-center justify-center border border-amber-500/20">
                                Filtrer
                            </button>
                        <a href="{{ path('rh_project_index') }}" class="px-3 py-2 bg-slate-100 text-slate-500 rounded-lg hover:bg-slate-200 transition-colors flex items-center justify-center">
                            ✕
                        </a>
                    </div>
                </form>
            </section>

            {# ══════════ Grille des Projets ══════════ #}
            {% if projects is empty %}
                <div class="py-20 text-center bg-white rounded-2xl border border-dashed border-zinc-200">
                    <span class="text-5xl block mb-4">📂</span>
                    <h3 class="text-lg font-bold text-zinc-800">Aucun projet trouvé</h3>
                    <p class="text-zinc-500 text-sm">Commencez par créer une nouvelle fiche projet.</p>
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    {% for project in projects %}
                        <div class="project-card group bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-100 dark:border-zinc-800/50 overflow-hidden shadow-sm flex flex-col animate-slide-up">
                            <div class="p-5 flex-1">
                                <div class="flex justify-between items-start mb-4">
                                    <span class="badge-pill
                                        {% if project.status == 'completed' %}bg-blue-50 text-blue-700
                                        {% elseif project.status == 'in_progress' %}bg-emerald-50 text-emerald-700
                                        {% elseif project.status == 'on_hold' %}bg-amber-50 text-amber-700
                                        {% else %}bg-slate-50 text-slate-600{% endif %}">
                                        {{ project.status|replace({'_': ' '})|capitalize }}
                                    </span>

                                    <div class="flex gap-2">
                                        {% if project.is_overdue ?? false %}
                                            <span class="px-2 py-0.5 rounded bg-red-50 text-red-600 text-[10px] font-bold border border-red-100 uppercase tracking-tighter">⚠️ Retard</span>
                                        {% endif %}
                                        <div class="priority-indicator
                                            {% if project.priority == 'critical' %}bg-red-500
                                            {% elseif project.priority == 'high' %}bg-orange-500
                                            {% elseif project.priority == 'medium' %}bg-amber-400
                                            {% else %}bg-emerald-400{% endif %}">
                                        </div>
                                    </div>
                                </div>

                                <h3 class="text-lg font-bold text-zinc-900 dark:text-white group-hover:text-indigo-600 transition-colors">{{ project.name }}</h3>
                                <p class="text-sm text-zinc-500 mt-2 line-clamp-2 leading-relaxed">
                                    {{ project.description ?? 'Aucune description fournie pour ce projet.' }}
                                </p>

                                <div class="mt-6">
                                    <div class="flex justify-between items-end mb-2">
                                        <span class="text-[11px] font-bold text-zinc-400 uppercase">Avancement</span>
                                        <span class="text-sm font-black text-zinc-800">{{ project.completion_rate ?? 0 }}%</span>
                                    </div>
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill bg-gradient-to-r from-indigo-500 to-blue-500" style="width: {{ project.completion_rate ?? 0 }}%"></div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-zinc-50">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-xs">👥</div>
                                        <div>
                                            <p class="text-[10px] text-zinc-400 font-bold uppercase leading-none">Équipe</p>
                                            <p class="text-xs font-bold text-zinc-700">{{ project.team_count ?? 0 }} membres</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-xs">📅</div>
                                        <div>
                                            <p class="text-[10px] text-zinc-400 font-bold uppercase leading-none">Échéance</p>
                                            <p class="text-xs font-bold text-zinc-700">{{ project.end_date ? project.end_date|date('d M Y') : 'N/A' }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-zinc-50/50 dark:bg-zinc-800/30 px-5 py-4 flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800">
                                <div class="flex gap-3">
                                    <a href="{{ path('rh_project_show', {id: project.id}) }}" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                        Détails
                                    </a>
                                    <a href="{{ path('rh_project_edit', {id: project.id}) }}" class="text-xs font-bold text-zinc-500 hover:text-zinc-700 flex items-center gap-1">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        Modifier
                                    </a>
                                </div>
                                <form action="{{ path('rh_project_delete', {id: project.id}) }}" method="POST" onsubmit="return confirm('Supprimer définitivement ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                                    <button type="submit" class="w-8 h-8 rounded-lg flex items-center justify-center text-red-400 hover:bg-red-50 hover:text-red-600 transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </main>
    </div>
</div>
{% endblock %}