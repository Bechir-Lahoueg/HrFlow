{% extends 'base.html.twig' %}

{% block title %}Gestion des Projets — HRFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @keyframes countUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        .count-anim { animation: countUp .4s ease-out both; }
        .project-card { transition: all .2s; }
        .project-card:hover { transform: translateY(-3px); box-shadow: 0 12px 24px -12px rgba(2, 46, 105, 0.35); }

        .progress-bar-container { height: 6px; background: #e2e8f0; border-radius: 999px; overflow: hidden; }
        .progress-bar-fill { height: 100%; border-radius: 999px; transition: width 0.8s ease; }

        .priority-indicator { width: 4px; height: 40px; border-radius: 2px; }
        .table-row-hover { transition: all .15s; }
        .table-row-hover:hover { background: #f8fafc; }

        .badge-pill {
            font-size: 11px;
            font-weight: 700;
            padding: 2px 10px;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Project module color palette */
        :root {
            --project-primary-deep: #022E69;
            --project-primary: #145EB7;
            --project-accent: #3FA9F5;
            --project-border: #D0D0D0;
        }

        /* High contrast mode support */
        html.a11y-high-contrast {
            --project-primary-deep: #022E69;
            --project-primary: #145EB7;
            --project-accent: #3FA9F5;
            --project-border: #3FA9F5;
        }

        /* Page container background */
        #project-page-container {
            background-color: #f4f7fb !important;
        }

        /* Hero banner */
        .hero-banner-project {
            background: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d) !important;
        }
    </style>
{% endblock %}

{% block body %}
<div id="project-page-container" class="min-h-screen dot-grid">

    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">

        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# Flash messages #}
            {% for type, messages in app.flashes %}
                {% for msg in messages %}
                <div class="px-4 py-3 rounded-xl {% if type == 'success' %}bg-emerald-50 border-emerald-200 text-emerald-700{% else %}bg-red-50 border-red-200 text-red-700{% endif %} border text-sm font-medium flex items-center gap-2 animate-slide-up">
                    <i class="bi {{ type == 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' }}" aria-hidden="true"></i>
                    {{ msg }}
                </div>
                {% endfor %}
            {% endfor %}

            {# ══════════ Hero Banner ══════════ #}
            <section class="hero-banner-project relative overflow-hidden rounded-2xl text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full blur-3xl mesh-blob" style="background: radial-gradient(circle, rgba(63, 169, 245, 0.15), transparent 70%);"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full blur-3xl mesh-blob-alt" style="background: radial-gradient(circle, rgba(20, 94, 183, 0.15), transparent 70%);"></div>

                <div class="relative z-10 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full animate-pulse" style="background-color: #3FA9F5;"></div>
                            <span class="text-[11px] font-bold uppercase tracking-wider" style="color: #3FA9F5;">Project Studio</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Gestion des Projets</h2>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">Pilotez vos équipes, suivez l'avancement et sécurisez vos délais avec une vue RH unifiée.</p>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="rounded-xl border border-white/15 backdrop-blur-sm p-4" style="background: rgba(255, 255, 255, 0.08);">
                            <p class="text-[10px] uppercase tracking-[0.15em] font-bold" style="color: rgba(63, 169, 245, 0.7);">Projets actifs</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ stats.active_projects }}</p>
                            <p class="text-xs mt-1" style="color: rgba(63, 169, 245, 0.6);">en execution</p>
                        </div>
                        <div class="rounded-xl border border-white/15 backdrop-blur-sm p-4" style="background: rgba(255, 255, 255, 0.08);">
                            <p class="text-[10px] uppercase tracking-[0.15em] font-bold" style="color: rgba(63, 169, 245, 0.7);">Taux global</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ stats.completion_rate }}%</p>
                            <p class="text-xs mt-1" style="color: rgba(63, 169, 245, 0.6);">avancement moyen</p>
                        </div>
                    </div>
                </div>

                <div class="relative z-10 mt-6 flex flex-wrap items-center gap-3">
                    <form method="POST" action="{{ path('rh_project_send_task_reminders') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('rh-project-send-task-reminders') }}">
                        <button type="submit" class="px-4 py-2 rounded-lg text-white text-[12px] font-bold transition-all" style="background-color: #145EB7;">
                            Envoyer alertes taches
                        </button>
                    </form>
                    <a href="{{ path('rh_project_export_pdf', {
                        status: statusFilter,
                        priority: priorityFilter,
                        search: search
                    }) }}" class="px-4 py-2 rounded-lg border border-white/20 text-white text-[12px] font-bold hover:bg-white/20 transition-all">
                        Export PDF
                    </a>
                    <a href="{{ path('rh_project_new') }}" class="px-4 py-2 rounded-lg text-white text-[12px] font-bold transition-all shadow-sm" style="background: linear-gradient(135deg, #145EB7, #3FA9F5);">
                        Nouveau Projet
                    </a>
                </div>
            </section>

            {# ══════════ Stats Grid ══════════ #}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 animate-slide-up">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm count-anim">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background-color: rgba(20, 94, 183, 0.1);">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ stats.total_projects }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Total Projets</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-full rounded-full" style="background: linear-gradient(90deg, #145EB7, #3FA9F5);"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm count-anim">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3.75-9.75a6 6 0 000 11.25M2.25 9.75a9 9 0 0119.5 0"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 font-mono-num">{{ stats.active_projects }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">En cours</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-full rounded-full bg-gradient-to-r from-emerald-500 to-teal-400"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm count-anim">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-blue-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-blue-600 dark:text-blue-400 font-mono-num">{{ stats.completed_projects }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Terminés</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-2/3 rounded-full bg-gradient-to-r from-blue-500 to-cyan-400"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm count-anim">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7 12a2 2 0 110-4 2 2 0 010 4zM0 20c0-2.168 3.582-4 8-4s8 1.832 8 4m8-8a2 2 0 110-4 2 2 0 010 4zm0 0c2.118 0 4-1.343 4-3s-1.882-3-4-3-4 1.343-4 3 1.882 3 4 3zm6 10c0-2.168 1.791-4 4-4s4 1.832 4 4m-14-4c1.791 0 4-1.343 4-3s-1.209-3-4-3-4 1.343-4 3 1.209 3 4 3z"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ stats.completion_rate }}%</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Taux global</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-full rounded-full bg-gradient-to-r from-amber-500 to-orange-400"></div></div>
                </div>
            </div>

            {# ══════════ Filtres ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color: rgba(20, 94, 183, 0.1);">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/></svg>
                    </div>
                    <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Filtrer les projets</h3>
                </div>

                <form method="GET" class="flex flex-wrap gap-4 items-end">
                    <div class="flex-1 min-w-[200px]">
                        <label class="text-[11px] font-bold text-zinc-500 uppercase tracking-wider block mb-2">Rechercher</label>
                        <input type="text" name="search" value="{{ search }}" class="w-full bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200 dark:border-zinc-700 rounded-lg px-4 py-2.5 text-sm focus:border-[#145EB7] focus:ring-1 focus:ring-[#145EB7] focus:outline-none" placeholder="Rechercher un projet...">
                    </div>
                    <div>
                        <label class="text-[11px] font-bold text-zinc-500 uppercase tracking-wider block mb-2">Statut</label>
                        <select name="status" class="rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/50 px-4 py-2.5 text-sm focus:border-[#145EB7] focus:ring-1 focus:ring-[#145EB7] focus:outline-none">
                            <option value="">Tous les statuts</option>
                            {% for s in statuses %}
                                <option value="{{ s }}" {% if statusFilter == s %}selected{% endif %}>{{ s|replace({'_': ' '})|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    {# Boutons Filtrer et Reset #}
                    <div class="flex gap-2">
                        <button type="submit" class="px-4 py-2.5 rounded-lg text-white text-sm font-bold transition-all" style="background-color: #145EB7;">
                            Filtrer
                        </button>
                        <a href="{{ path('rh_project_index') }}" class="px-3 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/50 text-zinc-500 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors flex items-center justify-center" title="Réinitialiser">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                        </a>
                    </div>
                </form>
            </section>

            {# ══════════ Grille des Projets ══════════ #}
            {% if projects is empty %}
                <div class="py-20 text-center bg-white dark:bg-zinc-900 rounded-2xl border border-dashed border-zinc-200 dark:border-zinc-800/50">
                    <div class="mx-auto mb-4 w-14 h-14 rounded-2xl bg-zinc-50 dark:bg-zinc-800/50 flex items-center justify-center text-zinc-400">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-11.286.5h21.572c.5 0 .9-.4.9-.9V3.9c0-.5-.4-.9-.9-.9H2.714c-.5 0-.9.4-.9.9v16.2c0 .5.4.9.9.9z"/></svg>
                    </div>
                    <h3 class="text-lg font-bold text-zinc-800 dark:text-zinc-200">Aucun projet trouvé</h3>
                    <p class="text-zinc-500 text-sm mt-1">Commencez par créer une nouvelle fiche projet.</p>
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 animate-slide-up stagger-5">
                    {% for project in projects %}
                        <div class="project-card table-row-hover group bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 overflow-hidden shadow-sm flex flex-col">
                            <div class="p-5 flex-1">
                                <div class="flex justify-between items-start mb-4">
                                    <span class="text-[11px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider
                                        {% if project.status == 'completed' %}text-blue-700 bg-blue-50
                                        {% elseif project.status == 'in_progress' %}text-emerald-700 bg-emerald-50
                                        {% elseif project.status == 'on_hold' %}text-amber-700 bg-amber-50
                                        {% else %}text-zinc-600 bg-zinc-50{% endif %}">
                                        {{ project.status|replace({'_': ' '})|capitalize }}
                                    </span>

                                    <div class="flex gap-2">
                                        {% if project.is_overdue ?? false %}
                                            <span class="px-2 py-0.5 rounded bg-red-50 text-red-600 text-[10px] font-bold border border-red-100 uppercase tracking-tighter inline-flex items-center gap-1">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                                Retard
                                            </span>
                                        {% endif %}
                                        <div class="priority-indicator
                                            {% if project.priority == 'critical' %}bg-red-500
                                            {% elseif project.priority == 'high' %}bg-orange-500
                                            {% elseif project.priority == 'medium' %}bg-amber-400
                                            {% else %}bg-emerald-400{% endif %}">
                                        </div>
                                    </div>
                                </div>

                                <h3 class="text-lg font-bold text-zinc-900 dark:text-white group-hover:transition-colors" style="color: #022E69;">{{ project.name }}</h3>
                                <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2 line-clamp-2 leading-relaxed">
                                    {{ project.description ?? 'Aucune description fournie pour ce projet.' }}
                                </p>

                                <div class="mt-6">
                                    <div class="flex justify-between items-end mb-2">
                                        <span class="text-[11px] font-bold text-zinc-400 uppercase">Avancement</span>
                                        <span class="text-sm font-black text-zinc-800 dark:text-zinc-200">{{ project.completion_rate ?? 0 }}%</span>
                                    </div>
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill" style="background: linear-gradient(90deg, #145EB7, #3FA9F5); width: {{ project.completion_rate ?? 0 }}%"></div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/50">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-slate-50 dark:bg-zinc-800/50 flex items-center justify-center text-slate-500">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-zinc-400 font-bold uppercase leading-none">Équipe</p>
                                            <p class="text-xs font-bold text-zinc-700 dark:text-zinc-300">{{ project.team_count ?? 0 }} membres</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-slate-50 dark:bg-zinc-800/50 flex items-center justify-center text-slate-500">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10m-12 4h14a2 2 0 002-2V5a2 2 0 00-2-2H4a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-zinc-400 font-bold uppercase leading-none">Échéance</p>
                                            <p class="text-xs font-bold text-zinc-700 dark:text-zinc-300">{{ project.end_date ? project.end_date|date('d M Y') : 'N/A' }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-zinc-50/50 dark:bg-zinc-800/30 px-5 py-4 flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800">
                                <div class="flex gap-3">
                                    <a href="{{ path('rh_project_show', {id: project.id}) }}" class="text-xs font-bold flex items-center gap-1.5" style="color: #145EB7;">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                                        Détails
                                    </a>
                                    <a href="{{ path('rh_project_edit', {id: project.id}) }}" class="text-xs font-bold text-zinc-500 hover:text-zinc-700 dark:text-zinc-400 dark:hover:text-zinc-300 flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                        Modifier
                                    </a>
                                </div>
                                <form action="{{ path('rh_project_delete', {id: project.id}) }}" method="POST" onsubmit="return confirm('Supprimer définitivement ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                                    <button type="submit" class="w-8 h-8 rounded-lg flex items-center justify-center text-red-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-500/10 transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </main>
    </div>
</div>
{% endblock %}