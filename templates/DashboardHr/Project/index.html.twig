{% extends 'base.html.twig' %}

{% block title %}Gestion des Projets — HRFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @keyframes countUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        .count-anim { animation: countUp .4s ease-out both; }
        .project-card { transition: all .2s; }
        .project-card:hover { transform: translateY(-3px); box-shadow: 0 12px 24px -12px rgba(2, 6, 23, .35); }

        .progress-bar-container { height: 6px; background: #e2e8f0; border-radius: 999px; overflow: hidden; }
        .progress-bar-fill { height: 100%; border-radius: 999px; transition: width 0.8s ease; }

        .priority-indicator { width: 4px; height: 40px; border-radius: 2px; }
        .table-row-hover { transition: all .15s; }
        .table-row-hover:hover { background: #f8fafc; }

        .badge-pill {
            font-size: 11px;
            font-weight: 700;
            padding: 2px 10px;
            border-radius: 9999px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
    </style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">

    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">

        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# Flash messages #}
            {% for type, messages in app.flashes %}
                {% for msg in messages %}
                <div class="px-4 py-3 rounded-xl {% if type == 'success' %}bg-emerald-50 border-emerald-200 text-emerald-700{% else %}bg-red-50 border-red-200 text-red-700{% endif %} border text-sm font-medium flex items-center gap-2 animate-slide-up">
                    <i class="bi {{ type == 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' }}" aria-hidden="true"></i>
                    {{ msg }}
                </div>
                {% endfor %}
            {% endfor %}

            {# ══════════ Hero Banner (Style Relations) ══════════ #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-800 to-cyan-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-cyan-400/15 blur-3xl"></div>
                <div class="absolute -left-20 bottom-0 h-48 w-48 rounded-full bg-violet-300/10 blur-3xl"></div>

                <div class="relative z-10 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-cyan-200 uppercase tracking-wider">Project Studio</span>
                        </div>
                        <h2 class="text-3xl md:text-4xl font-extrabold leading-tight">Gestion des Projets</h2>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">Pilotez vos équipes, suivez l'avancement et sécurisez vos délais avec une vue RH unifiée.</p>
                    </div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">Projets actifs</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ stats.active_projects }}</p>
                            <p class="text-xs text-cyan-100/60 mt-1">en execution</p>
                        </div>
                        <div class="rounded-xl border border-white/15 bg-white/8 backdrop-blur-sm p-4">
                            <p class="text-[10px] uppercase tracking-[0.15em] text-cyan-200/70 font-bold">Taux global</p>
                            <p class="mt-1 text-3xl font-extrabold font-mono-num">{{ stats.completion_rate }}%</p>
                            <p class="text-xs text-cyan-100/60 mt-1">avancement moyen</p>
                        </div>
                    </div>
                </div>

                <div class="relative z-10 mt-6 flex flex-wrap items-center gap-3">
                    <form method="POST" action="{{ path('rh_project_send_task_reminders') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('rh-project-send-task-reminders') }}">
                        <button type="submit" class="px-4 py-2 rounded-lg bg-amber-400 border border-amber-500/30 text-slate-900 text-[12px] font-bold hover:bg-amber-500 transition-all">
                            Envoyer alertes taches
                        </button>
                    </form>
                    <a href="{{ path('rh_project_export_pdf', {
                        status: statusFilter,
                        priority: priorityFilter,
                        search: search
                    }) }}" class="px-4 py-2 rounded-lg bg-white/10 border border-white/20 text-white text-[12px] font-bold hover:bg-white/20 transition-all">
                        Export PDF
                    </a>
                    <a href="{{ path('rh_project_new') }}" class="px-4 py-2 rounded-lg bg-gradient-to-r from-slate-900 to-slate-700 text-white text-[12px] font-bold hover:from-slate-800 transition-all shadow-sm">
                        Nouveau Projet
                    </a>
                </div>
            </section>

            {# ══════════ Stats Grid ══════════ #}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm count-anim">
                    <p class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Total Projets</p>
                    <div class="flex items-end justify-between mt-2">
                        <p class="text-3xl font-extrabold text-zinc-900 dark:text-white">{{ stats.total_projects }}</p>
                        <div class="p-2 bg-slate-50 rounded-lg text-slate-600">
                            <i class="bi bi-kanban-fill text-base" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm count-anim">
                    <p class="text-[11px] font-bold text-emerald-600 uppercase tracking-wider">En cours</p>
                    <div class="flex items-end justify-between mt-2">
                        <p class="text-3xl font-extrabold text-zinc-900 dark:text-white">{{ stats.active_projects }}</p>
                        <div class="p-2 bg-emerald-50 rounded-lg text-emerald-600">
                            <i class="bi bi-play-circle-fill text-base" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm count-anim">
                    <p class="text-[11px] font-bold text-blue-600 uppercase tracking-wider">Terminés</p>
                    <div class="flex items-end justify-between mt-2">
                        <p class="text-3xl font-extrabold text-zinc-900 dark:text-white">{{ stats.completed_projects }}</p>
                        <div class="p-2 bg-blue-50 rounded-lg text-blue-600">
                            <i class="bi bi-check-circle-fill text-base" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm count-anim">
                    <p class="text-[11px] font-bold text-amber-600 uppercase tracking-wider">Taux global</p>
                    <div class="flex items-end justify-between mt-2">
                        <p class="text-3xl font-extrabold text-zinc-900 dark:text-white">{{ stats.completion_rate }}%</p>
                        <div class="p-2 bg-amber-50 rounded-lg text-amber-600">
                            <i class="bi bi-bar-chart-fill text-base" aria-hidden="true"></i>
                        </div>
                    </div>
                </div>
            </div>

            {# ══════════ Filtres (Avec Bouton Filtrer + Reset) ══════════ #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-4 shadow-sm">
                <form method="GET" class="flex flex-wrap items-center gap-4">
                    <div class="flex-1 min-w-[200px]">
                        <input type="text" name="search" value="{{ search }}" class="w-full bg-zinc-50 border-none rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-indigo-500" placeholder="Rechercher un projet...">
                    </div>
                    <select name="status" class="rounded-lg border border-zinc-200 bg-zinc-50 text-sm px-3 py-2 focus:border-cyan-400 focus:outline-none">
                        <option value="">Tous les statuts</option>
                        {% for s in statuses %}
                            <option value="{{ s }}" {% if statusFilter == s %}selected{% endif %}>{{ s|replace({'_': ' '})|capitalize }}</option>
                        {% endfor %}
                    </select>

                    {# Intégration des boutons demandés #}
                    <div class="flex gap-2 min-w-[140px]">
                        <button type="submit" class="px-4 py-2 rounded-lg bg-slate-900 text-white text-[12px] font-bold hover:bg-slate-800 transition-all flex-1">
                                Filtrer
                            </button>
                        <a href="{{ path('rh_project_index') }}" class="px-3 py-2 rounded-lg border border-zinc-200 bg-white text-zinc-500 hover:bg-zinc-50 transition-colors flex items-center justify-center" aria-label="Reinitialiser les filtres">
                            <i class="bi bi-x-lg text-sm" aria-hidden="true"></i>
                        </a>
                    </div>
                </form>
            </section>

            {# ══════════ Grille des Projets ══════════ #}
            {% if projects is empty %}
                <div class="py-20 text-center bg-white rounded-2xl border border-dashed border-zinc-200">
                    <div class="mx-auto mb-4 w-14 h-14 rounded-2xl bg-zinc-50 flex items-center justify-center text-zinc-400">
                        <i class="bi bi-kanban text-2xl" aria-hidden="true"></i>
                    </div>
                    <h3 class="text-lg font-bold text-zinc-800">Aucun projet trouvé</h3>
                    <p class="text-zinc-500 text-sm">Commencez par créer une nouvelle fiche projet.</p>
                </div>
            {% else %}
                <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                    {% for project in projects %}
                        <div class="project-card table-row-hover group bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-100 dark:border-zinc-800/50 overflow-hidden shadow-sm flex flex-col animate-slide-up">
                            <div class="p-5 flex-1">
                                <div class="flex justify-between items-start mb-4">
                                    <span class="badge-pill
                                        {% if project.status == 'completed' %}bg-blue-50 text-blue-700
                                        {% elseif project.status == 'in_progress' %}bg-emerald-50 text-emerald-700
                                        {% elseif project.status == 'on_hold' %}bg-amber-50 text-amber-700
                                        {% else %}bg-slate-50 text-slate-600{% endif %}">
                                        {{ project.status|replace({'_': ' '})|capitalize }}
                                    </span>

                                    <div class="flex gap-2">
                                        {% if project.is_overdue ?? false %}
                                            <span class="px-2 py-0.5 rounded bg-red-50 text-red-600 text-[10px] font-bold border border-red-100 uppercase tracking-tighter inline-flex items-center gap-1">
                                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                                Retard
                                            </span>
                                        {% endif %}
                                        <div class="priority-indicator
                                            {% if project.priority == 'critical' %}bg-red-500
                                            {% elseif project.priority == 'high' %}bg-orange-500
                                            {% elseif project.priority == 'medium' %}bg-amber-400
                                            {% else %}bg-emerald-400{% endif %}">
                                        </div>
                                    </div>
                                </div>

                                <h3 class="text-lg font-bold text-zinc-900 dark:text-white group-hover:text-cyan-600 transition-colors">{{ project.name }}</h3>
                                <p class="text-sm text-zinc-500 mt-2 line-clamp-2 leading-relaxed">
                                    {{ project.description ?? 'Aucune description fournie pour ce projet.' }}
                                </p>

                                <div class="mt-6">
                                    <div class="flex justify-between items-end mb-2">
                                        <span class="text-[11px] font-bold text-zinc-400 uppercase">Avancement</span>
                                        <span class="text-sm font-black text-zinc-800">{{ project.completion_rate ?? 0 }}%</span>
                                    </div>
                                    <div class="progress-bar-container">
                                        <div class="progress-bar-fill bg-gradient-to-r from-cyan-500 to-blue-500" style="width: {{ project.completion_rate ?? 0 }}%"></div>
                                    </div>
                                </div>

                                <div class="grid grid-cols-2 gap-4 mt-6 pt-6 border-t border-zinc-50">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-500">
                                            <i class="bi bi-people-fill" aria-hidden="true"></i>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-zinc-400 font-bold uppercase leading-none">Équipe</p>
                                            <p class="text-xs font-bold text-zinc-700">{{ project.team_count ?? 0 }} membres</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-full bg-slate-50 flex items-center justify-center text-slate-500">
                                            <i class="bi bi-calendar3" aria-hidden="true"></i>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-zinc-400 font-bold uppercase leading-none">Échéance</p>
                                            <p class="text-xs font-bold text-zinc-700">{{ project.end_date ? project.end_date|date('d M Y') : 'N/A' }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="bg-zinc-50/50 dark:bg-zinc-800/30 px-5 py-4 flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800">
                                <div class="flex gap-3">
                                    <a href="{{ path('rh_project_show', {id: project.id}) }}" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1">
                                        <i class="bi bi-eye-fill" aria-hidden="true"></i>
                                        Détails
                                    </a>
                                    <a href="{{ path('rh_project_edit', {id: project.id}) }}" class="text-xs font-bold text-zinc-500 hover:text-zinc-700 flex items-center gap-1">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                        Modifier
                                    </a>
                                </div>
                                <form action="{{ path('rh_project_delete', {id: project.id}) }}" method="POST" onsubmit="return confirm('Supprimer définitivement ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                                    <button type="submit" class="w-8 h-8 rounded-lg flex items-center justify-center text-red-400 hover:bg-red-50 hover:text-red-600 transition-colors">
                                        <i class="bi bi-trash-fill" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

        </main>
    </div>
</div>
{% endblock %}