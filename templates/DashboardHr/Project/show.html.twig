{% extends 'base.html.twig' %}

{% block title %}{{ project.name }} — HRFlow{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
:root {
    --project-deep:    #022E69;
    --project-primary: #145EB7;
    --project-accent:  #3FA9F5;
    --project-border:  #D0D0D0;
    --success: #10b981;
    --warning: #f59e0b;
    --danger:  #ef4444;
    --surface: #ffffff;
    --bg:      #f4f7fb;
    --border:  #e2e8f0;
    --text:    #1e293b;
    --text-muted: #64748b;
    --shadow-sm: 0 1px 3px rgba(0,0,0,.07);
    --shadow-md: 0 4px 6px -1px rgba(0,0,0,.09);
    --radius: 12px;
}
body { background: var(--bg); font-family: 'Segoe UI', system-ui, sans-serif; }

/* ── Hero ── */
.project-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d);
    border-radius: 1rem;
    padding: 2rem 2.25rem;
    color: white;
    margin-bottom: 1.5rem;
    box-shadow: 0 8px 30px rgba(2,46,105,.35);
}
.project-hero::before {
    content: '';
    position: absolute;
    left: -4rem; bottom: -4rem;
    width: 14rem; height: 14rem;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(63,169,245,.15), transparent 70%);
}
.project-hero::after {
    content: '';
    position: absolute;
    right: -4rem; top: -4rem;
    width: 14rem; height: 14rem;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(20,94,183,.18), transparent 70%);
}
.hero-rel { position: relative; z-index: 1; }
.hero-eyebrow {
    display: flex;
    align-items: center;
    gap: .5rem;
    font-size: .7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: #3FA9F5;
    margin-bottom: .5rem;
}
.hero-eyebrow-dot { width: .45rem; height: .45rem; border-radius: 9999px; background: #3FA9F5; animation: blink 2s infinite; }
@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }
.project-hero h1 { font-size: 1.65rem; font-weight: 800; margin-bottom: .3rem; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: .83rem; opacity: .88; margin-top: .75rem; }
.hero-meta span { display: flex; align-items: center; gap: .4rem; }

.progress-hero { height: 8px; background: rgba(255,255,255,.2); border-radius: 999px; overflow: hidden; margin-top: .4rem; }
.progress-hero .fill { height: 100%; background: linear-gradient(90deg, #3FA9F5, #fff); border-radius: 999px; transition: width .6s ease; }

/* ── Tabs ── */
.tab-nav {
    background: var(--surface);
    border-radius: .875rem;
    display: flex;
    gap: 0;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    overflow: hidden;
}
.tab-btn {
    padding: .95rem 1.25rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--text-muted);
    font-weight: 700;
    font-size: .77rem;
    letter-spacing: .04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all .2s;
    text-decoration: none;
    white-space: nowrap;
}
.tab-btn.active { border-bottom-color: var(--project-primary); color: var(--project-primary); background: #f0f7ff; }
.tab-btn:hover:not(.active) { color: var(--project-deep); background: #f8faff; }

.tab-content-panel { display: none; }
.tab-content-panel.active { display: block; }

/* ── Card panels ── */
.card-panel {
    background: var(--surface);
    border-radius: .875rem;
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    margin-bottom: 1rem;
}
.section-title {
    font-size: .95rem;
    font-weight: 800;
    color: var(--project-deep);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: .5rem;
}
.section-title .icon-badge {
    width: 1.6rem; height: 1.6rem;
    border-radius: .4rem;
    display: flex; align-items: center; justify-content: center;
    background: rgba(20,94,183,.1);
    color: var(--project-primary);
    flex-shrink: 0;
}

/* ── Kanban ── */
.kanban-board { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; min-height: 500px; }
@media (max-width: 1200px) { .kanban-board { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px)  { .kanban-board { grid-template-columns: 1fr; } }

.kanban-col {
    background: #f4f7fb;
    border-radius: var(--radius);
    padding: 1rem;
    border: 2px dashed var(--border);
    min-height: 400px;
    transition: border-color .2s, background .2s;
}
.kanban-col.drag-over { border-color: var(--project-accent); background: #e8f4ff; }
.kanban-col-header {
    font-size: .75rem;
    font-weight: 800;
    letter-spacing: .08em;
    text-transform: uppercase;
    margin-bottom: .75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.col-todo       .kanban-col-header { color: #64748b; }
.col-in_progress .kanban-col-header { color: #d97706; }
.col-review     .kanban-col-header { color: var(--project-primary); }
.col-done       .kanban-col-header { color: #059669; }

.task-card {
    background: white;
    border-radius: 10px;
    padding: .9rem;
    margin-bottom: .6rem;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    cursor: grab;
    transition: all .2s;
    position: relative;
}
.task-card:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.task-card:active { cursor: grabbing; }
.task-card .task-title { font-weight: 600; font-size: .875rem; margin-bottom: .4rem; color: var(--project-deep); }
.task-card .task-assignee { font-size: .75rem; color: var(--text-muted); }
.task-card .task-due { font-size: .72rem; margin-top: .4rem; }
.task-card .task-due.overdue { color: var(--danger); font-weight: 700; }
.task-priority-indicator { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; border-radius: 10px 0 0 10px; }
.task-priority-low    .task-priority-indicator { background: var(--success); }
.task-priority-medium .task-priority-indicator { background: var(--warning); }
.task-priority-high   .task-priority-indicator { background: var(--danger); }

.col-count-badge {
    background: rgba(20,94,183,.12);
    color: var(--project-primary);
    font-size: .68rem;
    padding: .2em .6em;
    border-radius: 999px;
    font-weight: 800;
}

/* ── Team ── */
.team-member-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: .75rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    margin-bottom: .5rem;
    background: #f8faff;
    transition: all .2s;
}
.team-member-row:hover { background: #e8f4ff; border-color: var(--project-accent); }
.member-avatar {
    width: 40px; height: 40px;
    background: linear-gradient(135deg, var(--project-primary), var(--project-accent));
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: white; font-weight: 800; font-size: .9rem;
    flex-shrink: 0;
}
.member-hours-bar { height: 4px; background: var(--border); border-radius: 999px; overflow: hidden; margin-top: .3rem; }
.member-hours-bar .fill { height: 100%; background: linear-gradient(90deg, var(--project-primary), var(--project-accent)); border-radius: 999px; }

/* ── Milestones ── */
.milestone-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: .75rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    margin-bottom: .5rem;
    background: #f8faff;
}
.milestone-dot { width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; margin-top: .3rem; }
.milestone-dot.pending     { background: #9ca3af; }
.milestone-dot.in_progress { background: var(--warning); }
.milestone-dot.completed   { background: var(--success); }
.milestone-dot.delayed     { background: var(--danger); }

/* ── Activity ── */
.activity-item { display: flex; gap: .75rem; padding: .75rem 0; border-bottom: 1px solid var(--border); }
.activity-icon {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(20,94,183,.1);
    display: flex; align-items: center; justify-content: center;
    color: var(--project-primary);
    flex-shrink: 0;
}

/* ── Analytics ── */
.health-score-circle {
    width: 100px; height: 100px;
    border-radius: 50%;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    font-size: 1.8rem; font-weight: 900;
    border: 6px solid;
    margin: 0 auto 1rem;
}
.health-excellent { border-color: var(--success); color: var(--success); }
.health-good      { border-color: var(--warning); color: var(--warning); }
.health-warning   { border-color: #f97316; color: #f97316; }
.health-critical  { border-color: var(--danger); color: var(--danger); }

.risk-card { border-radius: 10px; padding: 1rem; margin-bottom: .75rem; border: 2px solid; }
.risk-low      { background: #f0fdf4; border-color: #bbf7d0; }
.risk-medium   { background: #fffbeb; border-color: #fde68a; }
.risk-high     { background: #fef2f2; border-color: #fecaca; }
.risk-critical { background: #fff1f2; border-color: #fecdd3; }

.analytics-card-fixed  { height: 430px; display: flex; flex-direction: column; }
.analytics-card-scroll { flex: 1; overflow: auto; }

/* ── Modals ── */
.modal-custom .modal-content { border-radius: var(--radius); border: none; box-shadow: 0 20px 60px rgba(0,0,0,.15); }
.modal-custom .modal-header {
    background: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d);
    color: white;
    border-radius: var(--radius) var(--radius) 0 0;
}
.form-label { font-weight: 600; font-size: .825rem; color: var(--text); margin-bottom: .35rem; }
.form-control, .form-select {
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: .5rem .75rem;
    font-size: .875rem;
    background: #f8faff;
}
.form-control:focus, .form-select:focus {
    border-color: var(--project-accent);
    box-shadow: 0 0 0 3px rgba(63,169,245,.18);
    background: #fff;
    outline: none;
}

/* ── Buttons ── */
.btn-prim {
    background: linear-gradient(135deg, var(--project-primary), var(--project-accent));
    color: white;
    border: none;
    padding: .6rem 1.5rem;
    border-radius: 8px;
    font-weight: 700;
    font-size: .82rem;
    cursor: pointer;
    transition: all .2s;
    box-shadow: 0 3px 12px rgba(20,94,183,.25);
    display: inline-flex;
    align-items: center;
    gap: .4rem;
}
.btn-prim:hover { transform: translateY(-1px); box-shadow: 0 5px 18px rgba(20,94,183,.38); color: white; }

/* ── Stat mini cards ── */
.stat-mini {
    border-radius: 10px;
    padding: .9rem 1rem;
    text-align: center;
}
</style>
{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f4f7fb] dark:bg-zinc-950 dot-grid">

    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">

        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

    {% for type, messages in app.flashes %}
        {% for msg in messages %}
        <div class="px-4 py-3 rounded-xl {% if type == 'success' %}bg-emerald-50 border-emerald-200 text-emerald-700{% else %}bg-red-50 border-red-200 text-red-700{% endif %} border text-sm font-medium flex items-center gap-2 animate-slide-up mb-3">
            <i class="bi {{ type == 'success' ? 'bi-check-circle-fill' : 'bi-exclamation-triangle-fill' }}" aria-hidden="true"></i>
            {{ msg }}
        </div>
        {% endfor %}
    {% endfor %}

    {# ── HERO ── #}
    <div class="project-hero">
        <div class="hero-rel">
            <div style="font-size:.78rem; opacity:.8; margin-bottom:.5rem">
                <a href="{{ path('rh_project_index') }}" style="color:#bae6fd; text-decoration:none">← Projets</a>
            </div>
            <div class="hero-eyebrow">
                <span class="hero-eyebrow-dot"></span>
                Project Studio
            </div>
            <h1>{{ project.name }}</h1>
            <div class="hero-meta">
                <span>{{ project.status|replace({'_': ' '})|capitalize }}</span>
                <span>
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10m-12 4h14a2 2 0 002-2V5a2 2 0 00-2-2H4a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    {{ project.start_date|date('d/m/Y') }} → {{ project.end_date|date('d/m/Y') }}
                </span>
                {% if project.budget %}<span>{{ project.budget|number_format(0, ',', ' ') }} €</span>{% endif %}
                {% if project.estimated_hours %}<span>{{ project.actual_hours ?? 0 }}h / {{ project.estimated_hours }}h</span>{% endif %}
            </div>
            <div class="mt-3" style="max-width:420px">
                <div style="font-size:.78rem; opacity:.8; margin-bottom:.35rem">Avancement — {{ project.completion_rate ?? 0 }}%</div>
                <div class="progress-hero"><div class="fill" style="width:{{ project.completion_rate ?? 0 }}%"></div></div>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-4">
                <a href="{{ path('rh_project_edit', {id: project.id}) }}"
                   class="px-4 py-2 rounded-lg text-white text-xs font-bold border border-white/20 hover:bg-white/20 transition-all"
                   style="font-size:.8rem; font-weight:700; text-decoration:none; background:rgba(255,255,255,.12)">
                    Modifier
                </a>
                <form action="{{ path('rh_project_delete', {id: project.id}) }}" method="POST"
                      onsubmit="return confirm('Supprimer ce projet ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
                    <button class="btn btn-danger btn-sm fw-bold" style="font-size:.8rem">Supprimer</button>
                </form>
            </div>
        </div>
    </div>

    {# ── TABS ── #}
    <div class="tab-nav">
        <button class="tab-btn active" onclick="switchTab('kanban', this)">Kanban</button>
        <button class="tab-btn" onclick="switchTab('team', this)">Equipe ({{ team|length }})</button>
        <button class="tab-btn" onclick="switchTab('milestones', this)">Jalons ({{ milestones|length }})</button>
        <button class="tab-btn" onclick="switchTab('analytics', this)">Analytics</button>
        <button class="tab-btn" onclick="switchTab('activity', this)">Activites</button>
    </div>

    {# ══════════ KANBAN ══════════ #}
    <div id="tab-kanban" class="tab-content-panel active">
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="section-title">
                    <span class="icon-badge">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"/></svg>
                    </span>
                    Tableau Kanban
                    <small class="text-muted fw-normal" style="font-size:.8rem">— {{ analytics.completed_tasks }}/{{ analytics.total_tasks }} tâches terminées</small>
                </div>
                <button class="btn-prim" onclick="openModal('modalNewTask')">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                    Ajouter une tache
                </button>
            </div>

            <div class="kanban-board">
                {% set columns = {
                    'todo':        {label: 'A FAIRE',  class: 'col-todo'},
                    'in_progress': {label: 'EN COURS', class: 'col-in_progress'},
                    'review':      {label: 'REVIEW',   class: 'col-review'},
                    'done':        {label: 'TERMINE',  class: 'col-done'}
                } %}
                {% for statusKey, col in columns %}
                <div class="kanban-col {{ col.class }}" id="col-{{ statusKey }}"
                     ondragover="handleDragOver(event)"
                     ondrop="handleDrop(event, '{{ statusKey }}')"
                     ondragleave="handleDragLeave(event)">
                    <div class="kanban-col-header">
                        <span>{{ col.label }}</span>
                        <span class="col-count-badge">{{ tasksByStatus[statusKey]|length }}</span>
                    </div>
                    {% for task in tasksByStatus[statusKey] %}
                    <div class="task-card task-priority-{{ task.priority }}"
                         draggable="true"
                         ondragstart="handleDragStart(event, {{ task.id }})"
                         id="task-{{ task.id }}">
                        <div class="task-priority-indicator"></div>
                        <div class="ps-1">
                            <div class="task-title">{{ task.title }}</div>
                            <div class="task-assignee">
                                {% if task.assigned_to_name %}{{ task.assigned_to_name }}
                                {% else %}<span style="color:var(--danger)">Non assigne</span>{% endif %}
                            </div>
                            {% if task.due_date %}
                            <div class="task-due {% if task.due_date < 'now'|date('Y-m-d') and task.status != 'done' %}overdue{% endif %}">
                                {{ task.due_date|date('d/m/Y') }}
                            </div>
                            {% endif %}
                            <div class="mt-2 d-flex gap-1 flex-wrap">
                                {% if not task.assigned_to %}
                                <button onclick="openAiSuggestModal({{ task.id }})"
                                        class="btn btn-sm" style="font-size:.7rem; padding:.2em .65em; background:rgba(20,94,183,.08); color:var(--project-primary); border:1px solid rgba(20,94,183,.2); font-weight:700; border-radius:6px">Suggestions IA</button>
                                {% endif %}
                                <button onclick="openEditTask({{ task|json_encode|e('html_attr') }})"
                                        class="btn btn-outline-secondary btn-sm" style="font-size:.7rem; padding:.2em .6em">Modifier</button>
                                <form action="{{ path('rh_project_task_delete', {id: project.id, taskId: task.id}) }}" method="POST" class="d-inline"
                                      onsubmit="return confirm('Supprimer cette tâche ?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('task-delete' ~ task.id) }}">
                                    <button class="btn btn-outline-danger btn-sm" style="font-size:.7rem; padding:.2em .6em">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    {# ══════════ ÉQUIPE ══════════ #}
    <div id="tab-team" class="tab-content-panel">
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="section-title">
                    <span class="icon-badge">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>
                    </span>
                    Equipe du Projet
                </div>
                <button class="btn-prim" onclick="openModal('modalAddMember')">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                    Ajouter un membre
                </button>
            </div>

            {% if team is empty %}
            <div class="text-center py-5 text-muted">
                <div style="font-size:2.5rem; opacity:.3">👥</div>
                <p class="mt-2">Aucun membre dans l'équipe pour l'instant.</p>
            </div>
            {% else %}
            {% for member in team %}
            <div class="team-member-row">
                <div class="member-avatar">{{ member.username|first|upper }}</div>
                <div style="flex:1">
                    <div class="fw-bold" style="color:var(--project-deep)">{{ member.username }}</div>
                    <div style="font-size:.8rem; color:var(--text-muted)">{{ member.role ?? 'Membre' }} · Depuis {{ member.joined_date|date('d/m/Y') }}</div>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        <span style="font-size:.75rem; color:var(--text-muted)">{{ member.worked_hours ?? 0 }}h / {{ member.assigned_hours ?? '∞' }}h</span>
                        {% if member.assigned_hours %}
                        <div class="member-hours-bar" style="width:80px">
                            <div class="fill" style="width:{{ min(((member.worked_hours ?? 0) / member.assigned_hours * 100)|round, 100) }}%"></div>
                        </div>
                        {% endif %}
                    </div>
                </div>
                <form action="{{ path('rh_project_team_remove', {id: project.id, collabId: member.id}) }}" method="POST"
                      onsubmit="return confirm('Retirer {{ member.username }} du projet ?')">
                    <input type="hidden" name="_token" value="{{ csrf_token('collab-remove' ~ member.id) }}">
                    <button class="btn btn-sm btn-outline-danger" style="font-size:.78rem">Retirer</button>
                </form>
            </div>
            {% endfor %}
            {% endif %}
        </div>
    </div>

    {# ══════════ JALONS ══════════ #}
    <div id="tab-milestones" class="tab-content-panel">
        <div class="card-panel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="section-title">
                    <span class="icon-badge">
                        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0l2.77-.693a9 9 0 016.208.682l.108.054a9 9 0 006.086.71l3.114-.732a48.524 48.524 0 01-.005-10.499l-3.11.732a9 9 0 01-6.085-.711l-.108-.054a9 9 0 00-6.208-.682L3 4.5M3 15V4.5"/></svg>
                    </span>
                    Jalons ({{ milestones|length }})
                </div>
                <button class="btn-prim" onclick="openModal('modalNewMilestone')">
                    <svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                    Ajouter un jalon
                </button>
            </div>

            <div class="row g-2 mb-4 text-center">
                <div class="col-4">
                    <div class="stat-mini" style="background:rgba(16,185,129,.08); border:1px solid rgba(16,185,129,.2)">
                        <div class="fw-bold fs-5 text-success">{{ milestoneStats.completed_milestones }}</div>
                        <div style="font-size:.72rem; color:var(--text-muted)">Terminés</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="stat-mini" style="background:rgba(20,94,183,.08); border:1px solid rgba(20,94,183,.2)">
                        <div class="fw-bold fs-5" style="color:var(--project-primary)">{{ milestoneStats.total_milestones }}</div>
                        <div style="font-size:.72rem; color:var(--text-muted)">Total</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="stat-mini" style="background:rgba(239,68,68,.08); border:1px solid rgba(239,68,68,.2)">
                        <div class="fw-bold fs-5 text-danger">{{ milestoneStats.overdue_milestones }}</div>
                        <div style="font-size:.72rem; color:var(--text-muted)">En retard</div>
                    </div>
                </div>
            </div>

            {% if milestones is empty %}
            <div class="text-center py-4 text-muted"><p>Aucun jalon défini.</p></div>
            {% endif %}
            {% for milestone in milestones %}
            {% set overdue = milestone.status != 'completed' and milestone.target_date < 'now'|date('Y-m-d') %}
            <div class="milestone-item {% if overdue %}border-danger{% endif %}">
                <div class="milestone-dot {{ milestone.status }}"></div>
                <div style="flex:1">
                    <div class="fw-bold" style="color:var(--project-deep)">{{ milestone.name }}</div>
                    <div style="font-size:.8rem; color:var(--text-muted)">{{ milestone.description }}</div>
                    <div class="d-flex gap-2 align-items-center mt-1 flex-wrap">
                        <span style="font-size:.75rem">{{ milestone.target_date|date('d/m/Y') }}</span>
                        <span class="badge bg-{{ milestone.status == 'completed' ? 'success' : (overdue ? 'danger' : 'secondary') }} text-white" style="font-size:.68rem">
                            {{ milestone.status|replace({'_': ' '})|capitalize }}
                        </span>
                        <div style="font-size:.75rem; color:var(--text-muted)">{{ milestone.completion_rate ?? 0 }}%</div>
                    </div>
                </div>
                <div class="d-flex flex-column gap-1">
                    {% if milestone.status != 'completed' %}
                    <form action="{{ path('rh_project_milestone_complete', {id: project.id, milestoneId: milestone.id}) }}" method="POST">
                        <input type="hidden" name="_token" value="{{ csrf_token('ms-complete' ~ milestone.id) }}">
                        <button class="btn btn-sm btn-success" style="font-size:.72rem; white-space:nowrap">Terminer</button>
                    </form>
                    {% endif %}
                    <button onclick="openEditMilestone({{ milestone|json_encode|e('html_attr') }})"
                            class="btn btn-sm btn-outline-secondary" style="font-size:.72rem">Modifier</button>
                    <form action="{{ path('rh_project_milestone_delete', {id: project.id, milestoneId: milestone.id}) }}" method="POST"
                          onsubmit="return confirm('Supprimer ce jalon ?')">
                        <input type="hidden" name="_token" value="{{ csrf_token('ms-delete' ~ milestone.id) }}">
                        <button class="btn btn-sm btn-outline-danger" style="font-size:.72rem">Supprimer</button>
                    </form>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>

    {# ══════════ ANALYTICS ══════════ #}
    <div id="tab-analytics" class="tab-content-panel">
        <div class="row g-3">

            {# Santé #}
            <div class="col-md-4">
                <div class="card-panel text-center analytics-card-fixed">
                    <div class="section-title justify-content-center">
                        <span class="icon-badge">
                            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/></svg>
                        </span>
                        Sante du Projet
                    </div>
                    <div class="analytics-card-scroll">
                        <div class="health-score-circle health-{{ analytics.health_status }}">
                            {{ analytics.health_score }}
                            <div style="font-size:.55rem; font-weight:600; opacity:.7">/ 100</div>
                        </div>
                        {% for c in analytics.criticals ?? [] %}
                        <div class="alert alert-danger py-1 px-2 text-start" style="font-size:.8rem">{{ c }}</div>
                        {% endfor %}
                        {% for w in analytics.warnings ?? [] %}
                        <div class="alert alert-warning py-1 px-2 text-start" style="font-size:.8rem">{{ w }}</div>
                        {% endfor %}
                        {% if (analytics.criticals ?? [])|length == 0 and (analytics.warnings ?? [])|length == 0 %}
                        <div class="alert alert-success py-2" style="font-size:.85rem">Aucune alerte — projet en bonne sante</div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Prédiction #}
            <div class="col-md-4">
                <div class="card-panel analytics-card-fixed">
                    <div class="section-title">
                        <span class="icon-badge">
                            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/></svg>
                        </span>
                        Prediction de Fin
                    </div>
                    <div class="analytics-card-scroll">
                        {% if analytics.prediction %}
                        {% set pred = analytics.prediction %}
                        <div class="mb-3">
                            <span class="badge text-white" style="font-size:.78rem; background:{{ pred.status == 'on_track' ? 'var(--success)' : (pred.status == 'early' ? 'var(--project-accent)' : 'var(--danger)') }}">
                                {{ pred.status == 'on_track' ? 'Dans les temps' : (pred.status == 'early' ? 'En avance' : 'En retard') }}
                            </span>
                        </div>
                        <table class="table table-sm" style="font-size:.83rem">
                            <tr><td class="text-muted">Vélocité</td><td class="fw-semibold">{{ pred.velocity }} tâches/jour</td></tr>
                            <tr><td class="text-muted">Tâches restantes</td><td class="fw-semibold">{{ pred.remaining_tasks }}</td></tr>
                            <tr><td class="text-muted">Jours nécessaires</td><td class="fw-semibold">{{ pred.days_needed }}</td></tr>
                            <tr><td class="text-muted">Date prédite</td><td class="fw-semibold">{{ pred.predicted_date|date('d/m/Y') }}</td></tr>
                            <tr><td class="text-muted">Date planifiée</td><td class="fw-semibold">{{ project.end_date|date('d/m/Y') }}</td></tr>
                            <tr>
                                <td class="text-muted">Écart</td>
                                <td class="fw-bold {{ pred.days_diff >= 0 ? 'text-success' : 'text-danger' }}">
                                    {{ pred.days_diff >= 0 ? '+' : '' }}{{ pred.days_diff }} jours
                                </td>
                            </tr>
                        </table>
                        {% else %}
                        <div class="text-muted text-center py-4">
                            <div style="font-size:2rem; opacity:.3">📊</div>
                            <p style="font-size:.85rem" class="mt-2">Pas assez de données.<br>Terminez quelques tâches pour activer les prédictions.</p>
                        </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            {# Risques #}
            <div class="col-md-4">
                <div class="card-panel analytics-card-fixed">
                    <div class="section-title">
                        <span class="icon-badge">
                            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
                        </span>
                        Risques identifies
                    </div>
                    <div class="analytics-card-scroll">
                        {% if analytics.risks is empty %}
                        <div class="text-center py-4">
                            <div style="font-size:2rem; opacity:.3">✅</div>
                            <p class="text-success fw-bold mt-2" style="font-size:.9rem">Aucun risque détecté</p>
                        </div>
                        {% endif %}
                        {% for risk in analytics.risks %}
                        <div class="risk-card risk-{{ risk.severity }}">
                            <div class="fw-bold" style="font-size:.875rem">{{ risk.title }}</div>
                            <div style="font-size:.8rem; margin:.3rem 0">{{ risk.description }}</div>
                            <div style="font-size:.77rem; color:#059669; font-style:italic">{{ risk.recommendation }}</div>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# Stats tâches #}
            <div class="col-12">
                <div class="card-panel">
                    <div class="section-title">
                        <span class="icon-badge">
                            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z"/></svg>
                        </span>
                        Metriques des Taches
                    </div>
                    <div class="row g-3 text-center">
                        <div class="col-6 col-md-3">
                            <div class="stat-mini" style="background:rgba(20,94,183,.07); border:1px solid rgba(20,94,183,.15)">
                                <div class="fw-bold fs-4" style="color:var(--project-primary)">{{ analytics.total_tasks }}</div>
                                <div class="text-muted" style="font-size:.78rem">Total</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-mini" style="background:rgba(16,185,129,.07); border:1px solid rgba(16,185,129,.15)">
                                <div class="fw-bold fs-4 text-success">{{ analytics.completed_tasks }}</div>
                                <div class="text-muted" style="font-size:.78rem">Terminées</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-mini" style="background:rgba(239,68,68,.07); border:1px solid rgba(239,68,68,.15)">
                                <div class="fw-bold fs-4 text-danger">{{ analytics.overdue_tasks }}</div>
                                <div class="text-muted" style="font-size:.78rem">En retard</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="stat-mini" style="background:rgba(245,158,11,.07); border:1px solid rgba(245,158,11,.15)">
                                <div class="fw-bold fs-4 text-warning">{{ analytics.unassigned_tasks }}</div>
                                <div class="text-muted" style="font-size:.78rem">Non assignées</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ══════════ ACTIVITÉS ══════════ #}
    <div id="tab-activity" class="tab-content-panel">
        <div class="card-panel">
            <div class="section-title">
                <span class="icon-badge">
                    <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </span>
                Journal d'activites
            </div>

            {% for update in updates %}
            <div class="activity-item">
                <div class="activity-icon">
                    {% if update.update_type in ['comment', 'rh_comment'] %}<i class="bi bi-chat-text-fill"></i>
                    {% elseif update.update_type in ['task', 'rh_task'] %}<i class="bi bi-check-circle-fill"></i>
                    {% elseif update.update_type in ['milestone', 'rh_milestone'] %}<i class="bi bi-flag-fill"></i>
                    {% elseif update.update_type in ['status_change', 'rh_status_change'] %}<i class="bi bi-arrow-repeat"></i>
                    {% else %}<i class="bi bi-pin-angle-fill"></i>{% endif %}
                </div>
                <div style="flex:1">
                    <div class="fw-bold" style="font-size:.875rem; color:var(--project-deep)">{{ update.title }}</div>
                    <div style="font-size:.8rem; color:var(--text-muted)">{{ update.content }}</div>
                    <div style="font-size:.75rem; color:#94a3b8; margin-top:.2rem">{{ update.author_name }} · {{ update.created_at|date('d/m/Y H:i') }}</div>
                </div>
            </div>
            {% else %}
            <div class="text-center py-4 text-muted"><p>Aucune activite enregistree.</p></div>
            {% endfor %}

            <div class="mt-3 pt-3" style="border-top:1px solid var(--border)">
                <div class="section-title" style="margin-bottom:.75rem; font-size:.85rem">Ajouter un commentaire</div>
                <form action="{{ path('rh_project_comment', {id: project.id}) }}" method="POST">
                    <textarea name="content" class="form-control mb-2" rows="2" placeholder="Écrire un commentaire..."></textarea>
                    <button type="submit" class="btn-prim">Publier</button>
                </form>
            </div>

            <div class="mt-3 pt-3" style="border-top:1px solid var(--border)">
                <div class="section-title" style="margin-bottom:.75rem; font-size:.85rem">Chat d'equipe (Matrix)</div>
                <div id="rhProjectChatAlert" class="alert d-none py-2"></div>
                <div id="rhProjectChatMessages" class="border rounded p-2" style="background:#f8faff; height:260px; overflow-y:auto;"></div>
                <form id="rhProjectChatForm" class="d-flex gap-2 mt-2">
                    <input id="rhProjectChatFile" type="file" class="d-none" accept="image/*,video/*,audio/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.zip,.rar">
                    <input id="rhProjectChatInput" type="text" class="form-control" maxlength="1200" placeholder="Ecrire un message...">
                    <button id="rhProjectChatAttachBtn" type="button" class="btn btn-outline-secondary btn-sm">Fichier</button>
                    <button id="rhProjectChatVoiceBtn" type="button" class="btn btn-outline-secondary btn-sm">Vocal</button>
                    <button id="rhProjectChatVideoBtn" type="button" class="btn btn-outline-secondary btn-sm">Video</button>
                    <button type="submit" class="btn-prim" style="white-space:nowrap">Envoyer</button>
                </form>
            </div>
        </div>
    </div>

        </main>
    </div>
</div>

{# ══════════ MODALS ══════════ #}

{# Modal Suggestions IA #}
<div id="modalAiSuggest" class="modal fade modal-custom" tabindex="-1">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Suggestions IA d'assignation</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
            <div id="aiSuggestAlert" class="alert d-none py-2"></div>
            <div id="aiSuggestLoading" class="text-muted">Chargement des suggestions...</div>
            <div id="aiSuggestList" class="d-flex flex-column gap-2"></div>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button></div>
    </div></div>
</div>

{# Modal Nouvelle Tâche #}
<div id="modalNewTask" class="modal fade modal-custom" tabindex="-1">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Nouvelle Tache</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form id="newTaskForm" action="{{ path('rh_project_task_new', {id: project.id}) }}" method="POST">
            <div class="modal-body">
                <div id="newTaskAjaxAlert" class="alert d-none py-2"></div>
                {% if taskCreateErrors.project_id is defined or taskCreateErrors.project_end_date is defined %}
                <div class="alert alert-danger py-2">{{ taskCreateErrors.project_id ?? taskCreateErrors.project_end_date }}</div>
                {% endif %}
                <div class="mb-3">
                    <label class="form-label">Titre *</label>
                    <input type="text" name="title" class="form-control {% if taskCreateErrors.title is defined %}is-invalid{% endif %}" value="{{ taskCreateData.title ?? '' }}">
                    {% if taskCreateErrors.title is defined %}<div class="invalid-feedback">{{ taskCreateErrors.title }}</div>{% endif %}
                </div>
                <div class="mb-3"><label class="form-label">Description</label><textarea name="description" class="form-control" rows="2">{{ taskCreateData.description ?? '' }}</textarea></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Assigné à</label>
                        <select name="assigned_to" class="form-select">
                            <option value="">Non assigné</option>
                            {% for member in team %}<option value="{{ member.employee_id }}" {% if (taskCreateData.assigned_to ?? '') == member.employee_id %}selected{% endif %}>{{ member.username }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Priorité</label>
                        <select name="priority" class="form-select">
                            <option value="low" {% if (taskCreateData.priority ?? 'medium') == 'low' %}selected{% endif %}>Faible</option>
                            <option value="medium" {% if (taskCreateData.priority ?? 'medium') == 'medium' %}selected{% endif %}>Moyenne</option>
                            <option value="high" {% if (taskCreateData.priority ?? 'medium') == 'high' %}selected{% endif %}>Haute</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Heures estimées</label>
                        <input type="number" name="estimated_hours" class="form-control {% if taskCreateErrors.estimated_hours is defined %}is-invalid{% endif %}" value="{{ taskCreateData.estimated_hours ?? '' }}">
                        {% if taskCreateErrors.estimated_hours is defined %}<div class="invalid-feedback">{{ taskCreateErrors.estimated_hours }}</div>{% endif %}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Date de début *</label>
                        <input type="date" name="start_date" class="form-control {% if taskCreateErrors.start_date is defined %}is-invalid{% endif %}" value="{{ taskCreateData.start_date ?? '' }}">
                        {% if taskCreateErrors.start_date is defined %}<div class="invalid-feedback">{{ taskCreateErrors.start_date }}</div>{% endif %}
                    </div>
                    <div class="col-md-6"><label class="form-label">Date limite</label><input type="date" name="due_date" class="form-control" value="{{ taskCreateData.due_date ?? '' }}"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn-prim">Créer la tâche</button>
            </div>
        </form>
    </div></div>
</div>

{# Modal Modifier Tâche #}
<div id="modalEditTask" class="modal fade modal-custom" tabindex="-1">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Modifier la Tache</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form id="editTaskForm" method="POST" {% if taskEditTaskId %}action="{{ path('rh_project_task_edit', {id: project.id, taskId: taskEditTaskId}) }}"{% endif %}>
            <div class="modal-body">
                <div id="editTaskAjaxAlert" class="alert d-none py-2"></div>
                {% if taskEditErrors.project_id is defined or taskEditErrors.project_end_date is defined %}
                <div class="alert alert-danger py-2">{{ taskEditErrors.project_id ?? taskEditErrors.project_end_date }}</div>
                {% endif %}
                <div class="mb-3">
                    <label class="form-label">Titre *</label>
                    <input type="text" name="title" id="editTaskTitle" class="form-control {% if taskEditErrors.title is defined %}is-invalid{% endif %}" value="{{ taskEditData.title ?? '' }}">
                    {% if taskEditErrors.title is defined %}<div class="invalid-feedback">{{ taskEditErrors.title }}</div>{% endif %}
                </div>
                <div class="mb-3"><label class="form-label">Description</label><textarea name="description" id="editTaskDesc" class="form-control" rows="2">{{ taskEditData.description ?? '' }}</textarea></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Statut</label>
                        <select name="status" id="editTaskStatus" class="form-select">
                            <option value="todo" {% if (taskEditData.status ?? 'todo') == 'todo' %}selected{% endif %}>A faire</option>
                            <option value="in_progress" {% if (taskEditData.status ?? 'todo') == 'in_progress' %}selected{% endif %}>En cours</option>
                            <option value="review" {% if (taskEditData.status ?? 'todo') == 'review' %}selected{% endif %}>Review</option>
                            <option value="done" {% if (taskEditData.status ?? 'todo') == 'done' %}selected{% endif %}>Termine</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Assigné à</label>
                        <select name="assigned_to" id="editTaskAssignee" class="form-select">
                            <option value="">Non assigné</option>
                            {% for member in team %}<option value="{{ member.employee_id }}" {% if (taskEditData.assigned_to ?? '') == member.employee_id %}selected{% endif %}>{{ member.username }}</option>{% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Priorité</label>
                        <select name="priority" id="editTaskPriority" class="form-select">
                            <option value="low" {% if (taskEditData.priority ?? 'medium') == 'low' %}selected{% endif %}>Faible</option>
                            <option value="medium" {% if (taskEditData.priority ?? 'medium') == 'medium' %}selected{% endif %}>Moyenne</option>
                            <option value="high" {% if (taskEditData.priority ?? 'medium') == 'high' %}selected{% endif %}>Haute</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Heures estimées</label>
                        <input type="number" name="estimated_hours" id="editTaskHours" class="form-control {% if taskEditErrors.estimated_hours is defined %}is-invalid{% endif %}" value="{{ taskEditData.estimated_hours ?? '' }}">
                        {% if taskEditErrors.estimated_hours is defined %}<div class="invalid-feedback">{{ taskEditErrors.estimated_hours }}</div>{% endif %}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Date de début *</label>
                        <input type="date" name="start_date" id="editTaskStart" class="form-control {% if taskEditErrors.start_date is defined %}is-invalid{% endif %}" value="{{ taskEditData.start_date ?? '' }}">
                        {% if taskEditErrors.start_date is defined %}<div class="invalid-feedback">{{ taskEditErrors.start_date }}</div>{% endif %}
                    </div>
                    <div class="col-md-6"><label class="form-label">Date limite</label><input type="date" name="due_date" id="editTaskDue" class="form-control" value="{{ taskEditData.due_date ?? '' }}"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="submit" class="btn-prim">Sauvegarder</button>
            </div>
        </form>
    </div></div>
</div>

{# Modal Ajouter Membre #}
<div id="modalAddMember" class="modal fade modal-custom" tabindex="-1">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title">Ajouter un Membre</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <form id="addMemberForm" action="{{ path('rh_project_team_add', {id: project.id}) }}" method="POST">
            <div class="modal-body">
                <div id="addMemberAjaxAlert" class="alert d-none py-2"></div>
                {% if teamAddErrors.project_id is defined or teamAddErrors._global is defined %}
                <div class="alert alert-danger py-2">{{ teamAddErrors.project_id ?? teamAddErrors._global }}</div>
                {% endif %}
                <div class="mb-3">
                    <label class="form-label">Employe</label>
                    <select id="memberEmployeeSelect" name="employee_id" class="form-select {% if teamAddErrors.employee_id is defined %}is-invalid{% endif %}" onchange="updateSelectedEmployeeJobTitle()">
                        <option value="">Choisir un employe...</option>
                        {% for emp in availableEmployees %}
                        <option value="{{ emp.id }}" data-job-title="{{ (emp.job_title ?? 'Membre')|e('html_attr') }}" {% if (teamAddData.employee_id ?? '') == emp.id %}selected{% endif %}>{{ emp.username }} — {{ emp.job_title ?? 'Membre' }}</option>
                        {% endfor %}
