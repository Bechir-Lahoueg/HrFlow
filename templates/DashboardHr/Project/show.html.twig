                    {% if teamAddErrors.employee_id is defined %}<div class="invalid-feedback">{{ teamAddErrors.employee_id }}</div>{% endif %}
                </div>
                <div class="mb-3">
                    <label class="form-label">Role (emploi)</label>
                    <input type="text" id="selectedEmployeeJobTitle" class="form-control" value="" placeholder="Selectionnez un employe" readonly>
                    <div class="form-text">Rempli automatiquement depuis le job_title de l'employe.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Heures allouees</label>
                    <input type="number" name="assigned_hours" class="form-control {% if teamAddErrors.assigned_hours is defined %}is-invalid{% endif %}" value="{{ teamAddData.assigned_hours ?? '' }}" placeholder="0">
