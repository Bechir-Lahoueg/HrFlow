{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
// ─── TABS ────────────────────────────────────────────────────────
function switchTab(name, btn) {
    document.querySelectorAll('.tab-content-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    btn.classList.add('active');
    window.location.hash = name;
}
(function() {
    const forcedTab = '{{ activeTab ?? '' }}';
    const hash = forcedTab !== '' ? forcedTab : window.location.hash.replace('#', '');
    const map = { team: 1, milestones: 2, analytics: 3, activity: 4 };
    if (hash && map[hash] !== undefined) {
        const btns = document.querySelectorAll('.tab-btn');
        if (btns[map[hash]]) btns[map[hash]].click();
    }
})();

// ─── MODALS ──────────────────────────────────────────────────────
function openModal(id) { new bootstrap.Modal(document.getElementById(id)).show(); }

document.addEventListener('DOMContentLoaded', function () {
    const modalToOpen = '{{ openModal ?? '' }}';
    updateSelectedEmployeeJobTitle();
    if (modalToOpen) openModal(modalToOpen);
    setupAjaxModalForm('newTaskForm', 'modalNewTask', 'newTaskAjaxAlert');
    setupAjaxModalForm('editTaskForm', 'modalEditTask', 'editTaskAjaxAlert');
    setupAjaxModalForm('addMemberForm', 'modalAddMember', 'addMemberAjaxAlert', updateSelectedEmployeeJobTitle);
});

function setupAjaxModalForm(formId, modalId, alertId, afterRenderCallback) {
    const form = document.getElementById(formId);
    if (!form) return;
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        submitModalFormAjax(form, modalId, alertId, afterRenderCallback);
    });
}

function submitModalFormAjax(form, modalId, alertId, afterRenderCallback) {
    clearAjaxErrors(form, alertId);
    fetch(form.action, {
        method: 'POST',
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
        body: new FormData(form)
    })
    .then(async (response) => {
        const data = await response.json();
        if (!response.ok || data.success === false) {
            applyAjaxErrors(form, data.errors || {}, alertId, data.message || 'Veuillez corriger les erreurs.');
            openModal(modalId);
            if (typeof afterRenderCallback === 'function') afterRenderCallback();
            return;
        }
        window.location.reload();
    })
    .catch(() => { showAjaxAlert(alertId, 'danger', 'Une erreur technique est survenue.'); openModal(modalId); });
}

function clearAjaxErrors(form, alertId) {
    form.querySelectorAll('.is-invalid').forEach(i => i.classList.remove('is-invalid'));
    form.querySelectorAll('[data-ajax-error="1"]').forEach(e => e.remove());
    hideAjaxAlert(alertId);
}

function applyAjaxErrors(form, errors, alertId, fallbackMessage) {
    let hasFieldError = false;
    Object.keys(errors).forEach((field) => {
        const input = form.querySelector('[name="' + field + '"]');
        if (!input) return;
        hasFieldError = true;
        input.classList.add('is-invalid');
        const feedback = document.createElement('div');
        feedback.className = 'invalid-feedback d-block';
        feedback.setAttribute('data-ajax-error', '1');
        feedback.textContent = errors[field];
        input.insertAdjacentElement('afterend', feedback);
    });
    if (!hasFieldError) {
        showAjaxAlert(alertId, 'danger', errors._global || errors.project_id || errors.project_end_date || fallbackMessage);
    }
}

function showAjaxAlert(alertId, type, message) {
    const alert = document.getElementById(alertId);
    if (!alert) return;
    alert.className = 'alert alert-' + type + ' py-2';
    alert.textContent = message;
}

function hideAjaxAlert(alertId) {
    const alert = document.getElementById(alertId);
    if (!alert) return;
    alert.className = 'alert d-none py-2';
    alert.textContent = '';
}

function updateSelectedEmployeeJobTitle() {
    const sel = document.getElementById('memberEmployeeSelect');
    const inp = document.getElementById('selectedEmployeeJobTitle');
    if (!sel || !inp) return;
    const opt = sel.options[sel.selectedIndex];
    inp.value = sel.value ? (opt?.getAttribute('data-job-title') || 'Membre') : '';
}

// ─── EDIT TASK ───────────────────────────────────────────────────
function openEditTask(task) {
    document.getElementById('editTaskTitle').value    = task.title || '';
    document.getElementById('editTaskDesc').value     = task.description || '';
    document.getElementById('editTaskStatus').value   = task.status || 'todo';
    document.getElementById('editTaskPriority').value = task.priority || 'medium';
    document.getElementById('editTaskHours').value    = task.estimated_hours || '';
    document.getElementById('editTaskStart').value    = task.start_date || '';
    document.getElementById('editTaskDue').value      = task.due_date || '';
    const assigneeSelect = document.getElementById('editTaskAssignee');
    assigneeSelect.value = task.assigned_to ? task.assigned_to : '';
    document.getElementById('editTaskForm').action = '/rh/projects/{{ project.id }}/tasks/' + task.id + '/edit';
    openModal('modalEditTask');
}

// ─── EDIT MILESTONE ──────────────────────────────────────────────
function openEditMilestone(ms) {
    document.getElementById('editMsName').value  = ms.name || '';
    document.getElementById('editMsDesc').value  = ms.description || '';
    document.getElementById('editMsDate').value  = ms.target_date || '';
    document.getElementById('editMsRate').value  = ms.completion_rate || 0;
    document.getElementById('editMilestoneForm').action = '/rh/projects/{{ project.id }}/milestones/' + ms.id + '/edit';
    openModal('modalEditMilestone');
}

// ─── KANBAN DRAG & DROP ──────────────────────────────────────────
let draggedTaskId = null, aiSuggestionTaskId = null;

function handleDragStart(event, taskId) {
    draggedTaskId = taskId;
    event.dataTransfer.effectAllowed = 'move';
    event.currentTarget.style.opacity = '0.5';
    setTimeout(() => event.currentTarget.style.opacity = '1', 0);
}
function handleDragOver(event)  { event.preventDefault(); event.currentTarget.classList.add('drag-over'); }
function handleDragLeave(event) { event.currentTarget.classList.remove('drag-over'); }
function handleDrop(event, newStatus) {
    event.preventDefault();
    event.currentTarget.classList.remove('drag-over');
    if (!draggedTaskId) return;
    fetch('/rh/projects/{{ project.id }}/tasks/' + draggedTaskId + '/move', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: '_token={{ csrf_token("task-move") }}&status=' + encodeURIComponent(newStatus)
    }).then(r => r.json()).then(data => { if (data.success) window.location.reload(); }).catch(() => window.location.reload());
    draggedTaskId = null;
}

// ─── AI SUGGEST ──────────────────────────────────────────────────
function openAiSuggestModal(taskId) {
    aiSuggestionTaskId = taskId;
    const list = document.getElementById('aiSuggestList');
    const loading = document.getElementById('aiSuggestLoading');
    list.innerHTML = '';
    loading.classList.remove('d-none');
    hideAjaxAlert('aiSuggestAlert');
    openModal('modalAiSuggest');
    fetch('/rh/projects/{{ project.id }}/tasks/' + taskId + '/ai-suggestions', {
        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
    })
    .then(async (response) => {
        const data = await response.json();
        loading.classList.add('d-none');
        if (!response.ok || data.success === false) {
            showAjaxAlert('aiSuggestAlert', 'danger', data.message || 'Impossible de recuperer les suggestions IA.');
            return;
        }
        renderAiSuggestions(Array.isArray(data.suggestions) ? data.suggestions : []);
    })
    .catch(() => { loading.classList.add('d-none'); showAjaxAlert('aiSuggestAlert', 'danger', 'Erreur reseau.'); });
}

function renderAiSuggestions(suggestions) {
    const list = document.getElementById('aiSuggestList');
    list.innerHTML = '';
    if (!suggestions.length) { showAjaxAlert('aiSuggestAlert', 'warning', 'Aucune suggestion disponible.'); return; }
    suggestions.forEach((item) => {
        const card = document.createElement('div');
        card.className = 'border rounded p-3';
        card.innerHTML = '<div class="d-flex justify-content-between align-items-start gap-2">'
            + '<div><div class="fw-semibold">' + escapeHtml(item.username || 'N/A') + ' <span class="badge ms-1" style="background:var(--project-primary)">' + String(item.score ?? 0) + '/100</span></div>'
            + '<div class="text-muted" style="font-size:.82rem">' + escapeHtml(item.job_title || 'N/A') + '</div>'
            + '<div class="mt-1" style="font-size:.82rem">' + escapeHtml(item.reason || '') + '</div>'
            + '<div class="text-muted mt-1" style="font-size:.75rem">Charge: projet ' + String(item.active_project_tasks ?? 0) + ' | total ' + String(item.active_total_tasks ?? 0) + '</div></div>'
            + '<button type="button" class="btn btn-sm btn-success">Assigner</button></div>';
        card.querySelector('button').addEventListener('click', () => assignTaskFromSuggestion(item.employee_id));
        list.appendChild(card);
    });
}

function assignTaskFromSuggestion(employeeId) {
    if (!aiSuggestionTaskId) return;
    const payload = new URLSearchParams();
    payload.set('employee_id', String(employeeId));
    fetch('/rh/projects/{{ project.id }}/tasks/' + aiSuggestionTaskId + '/assign', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' },
        body: payload.toString()
    })
    .then(async (response) => {
        const data = await response.json();
        if (!response.ok || data.success === false) { showAjaxAlert('aiSuggestAlert', 'danger', data.message || 'Impossible d\'assigner.'); return; }
        window.location.reload();
    })
    .catch(() => showAjaxAlert('aiSuggestAlert', 'danger', 'Erreur reseau.'));
}

// ─── CHAT ────────────────────────────────────────────────────────
const rhProjectChatState = { pollHandle: null, bootstrapped: false, isLoading: false, hasLoadedOnce: false, requestSeq: 0, activeRequestSeq: 0, mediaRecorder: null, mediaChunks: [], recording: false };

function initRhProjectChat() {
    const form = document.getElementById('rhProjectChatForm');
    if (!form) return;
    form.addEventListener('submit', function (e) { e.preventDefault(); sendRhProjectChatMessage(); });
    const attachBtn = document.getElementById('rhProjectChatAttachBtn');
    const fileInput = document.getElementById('rhProjectChatFile');
    if (attachBtn && fileInput) { attachBtn.addEventListener('click', () => fileInput.click()); }
    if (fileInput) { fileInput.addEventListener('change', function () { if (fileInput.files?.[0]) uploadRhProjectChatFile(fileInput.files[0]); fileInput.value = ''; }); }
    const voiceBtn = document.getElementById('rhProjectChatVoiceBtn');
    const videoBtn = document.getElementById('rhProjectChatVideoBtn');
    if (voiceBtn) voiceBtn.addEventListener('click', toggleRhVoiceRecording);
    if (videoBtn) videoBtn.addEventListener('click', startRhVideoCall);
    const container = document.getElementById('rhProjectChatMessages');
    if (container) container.innerHTML = '<div class="text-muted small">Chargement du chat...</div>';
    bootstrapRhProjectChat();
}

function bootstrapRhProjectChat() {
    fetch('/api/projects/{{ project.id }}/chat/bootstrap', { headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' } })
    .then(async (r) => {
        const data = await r.json();
        if (!r.ok || data.success === false) { showAjaxAlert('rhProjectChatAlert', 'danger', data.message || 'Chat Matrix indisponible.'); return; }
        rhProjectChatState.bootstrapped = true;
        loadRhProjectChatMessages();
        if (rhProjectChatState.pollHandle) clearInterval(rhProjectChatState.pollHandle);
        rhProjectChatState.pollHandle = setInterval(loadRhProjectChatMessages, 3000);
    })
    .catch(() => showAjaxAlert('rhProjectChatAlert', 'danger', 'Impossible d\'initialiser le chat Matrix.'));
}

function loadRhProjectChatMessages() {
    if (!rhProjectChatState.bootstrapped || rhProjectChatState.isLoading) return;
    rhProjectChatState.isLoading = true;
    rhProjectChatState.requestSeq += 1;
    const requestId = rhProjectChatState.requestSeq;
    rhProjectChatState.activeRequestSeq = requestId;
    fetch('/api/projects/{{ project.id }}/chat/messages?limit=40', { headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' } })
    .then(async (r) => {
        const data = await r.json();
        if (requestId !== rhProjectChatState.activeRequestSeq) return;
        if (!r.ok || data.success === false) { showAjaxAlert('rhProjectChatAlert', 'danger', data.message || 'Impossible de charger.'); return; }
        hideAjaxAlert('rhProjectChatAlert');
        rhProjectChatState.hasLoadedOnce = true;
        renderRhProjectChatMessages(Array.isArray(data.messages) ? data.messages : []);
    })
    .catch(() => showAjaxAlert('rhProjectChatAlert', 'danger', 'Erreur reseau.'))
    .finally(() => { if (requestId === rhProjectChatState.activeRequestSeq) rhProjectChatState.isLoading = false; });
}

function renderRhProjectChatMessages(messages) {
    const container = document.getElementById('rhProjectChatMessages');
    if (!container) return;
    container.innerHTML = '';
    if (!messages.length) { container.innerHTML = '<div class="text-muted small">Aucun message pour le moment.</div>'; return; }
    messages.forEach((msg) => {
        const row = document.createElement('div');
        row.className = 'mb-2';
        const date = msg.origin_server_ts ? new Date(msg.origin_server_ts).toLocaleString() : '';
        const msgType = String(msg.msgtype || 'm.text');
        const body = String(msg.body || '');
        const downloadUrl = String(msg.download_url || '');
        let bodyHtml = '';
        if (msgType === 'm.image' && downloadUrl) bodyHtml = '<div class="mt-1"><img src="' + escapeHtml(downloadUrl) + '" alt="image" style="max-height:220px" class="rounded border"></div>';
        else if (msgType === 'm.video' && downloadUrl) bodyHtml = '<div class="mt-1"><video controls style="max-height:240px" class="rounded border" src="' + escapeHtml(downloadUrl) + '"></video></div>';
        else if (msgType === 'm.audio' && downloadUrl) bodyHtml = '<div class="mt-1"><audio controls src="' + escapeHtml(downloadUrl) + '" style="width:100%"></audio></div>';
        else if (msgType === 'm.file' && downloadUrl) bodyHtml = '<div class="mt-1"><a target="_blank" rel="noopener" href="' + escapeHtml(downloadUrl) + '">Fichier: ' + escapeHtml(body || 'Piece jointe') + '</a></div>';
        else bodyHtml = '<div style="font-size:.88rem; white-space:pre-wrap">' + escapeHtml(body) + '</div>';
        row.innerHTML = '<div class="small"><span class="text-muted">' + escapeHtml(date) + '</span></div>' + bodyHtml;
        const eventId = String(msg.event_id || '');
        if (eventId) {
            const reactions = (msg.reactions && typeof msg.reactions === 'object') ? msg.reactions : {};
            const reactionBar = document.createElement('div');
            reactionBar.className = 'mt-1 d-flex flex-wrap align-items-center gap-1';
            Object.keys(reactions).forEach((key) => { reactionBar.insertAdjacentHTML('beforeend', '<span class="badge bg-light text-dark border">' + escapeHtml(key) + ' ' + String(reactions[key]) + '</span>'); });
            ['+1', 'heart', 'lol'].forEach((emoji) => {
                const btn = document.createElement('button');
                btn.type = 'button'; btn.className = 'btn btn-sm btn-outline-secondary py-0 px-2'; btn.textContent = emoji;
                btn.addEventListener('click', () => sendRhReaction(eventId, emoji));
                reactionBar.appendChild(btn);
            });
            row.appendChild(reactionBar);
        }
        container.appendChild(row);
    });
    container.scrollTop = container.scrollHeight;
}

function sendRhReaction(eventId, reaction) {
    const payload = new URLSearchParams(); payload.set('eventId', eventId); payload.set('reaction', reaction);
    fetch('/api/projects/{{ project.id }}/chat/react', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }, body: payload.toString() })
    .then(async (r) => { const data = await r.json(); if (!r.ok || !data.success) { showAjaxAlert('rhProjectChatAlert', 'danger', data.message || 'Impossible.'); return; } loadRhProjectChatMessages(); })
    .catch(() => showAjaxAlert('rhProjectChatAlert', 'danger', 'Erreur reseau.'));
}

function uploadRhProjectChatFile(file) {
    const formData = new FormData(); formData.append('file', file);
    fetch('/api/projects/{{ project.id }}/chat/upload', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }, body: formData })
    .then(async (r) => { const data = await r.json(); if (!r.ok || !data.success) { showAjaxAlert('rhProjectChatAlert', 'danger', data.message || 'Impossible.'); return; } hideAjaxAlert('rhProjectChatAlert'); loadRhProjectChatMessages(); })
    .catch(() => showAjaxAlert('rhProjectChatAlert', 'danger', 'Erreur reseau.'));
}

function toggleRhVoiceRecording() {
    if (rhProjectChatState.recording) { if (rhProjectChatState.mediaRecorder) rhProjectChatState.mediaRecorder.stop(); return; }
    if (!navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === 'undefined') { showAjaxAlert('rhProjectChatAlert', 'danger', 'Enregistrement vocal non supporte.'); return; }
    navigator.mediaDevices.getUserMedia({ audio: true }).then((stream) => {
        const recorder = new MediaRecorder(stream);
        rhProjectChatState.mediaChunks = []; rhProjectChatState.mediaRecorder = recorder; rhProjectChatState.recording = true; updateRhVoiceButton();
        recorder.ondataavailable = (e) => { if (e.data?.size > 0) rhProjectChatState.mediaChunks.push(e.data); };
        recorder.onstop = () => {
            stream.getTracks().forEach(t => t.stop()); rhProjectChatState.recording = false; updateRhVoiceButton();
            if (!rhProjectChatState.mediaChunks.length) return;
            const blob = new Blob(rhProjectChatState.mediaChunks, { type: 'audio/webm' });
            uploadRhProjectChatFile(new File([blob], 'vocal-' + Date.now() + '.webm', { type: 'audio/webm' }));
            rhProjectChatState.mediaChunks = []; rhProjectChatState.mediaRecorder = null;
        };
        recorder.start();
    }).catch(() => showAjaxAlert('rhProjectChatAlert', 'danger', 'Acces micro refuse.'));
}

function updateRhVoiceButton() {
    const btn = document.getElementById('rhProjectChatVoiceBtn');
    if (!btn) return;
    btn.textContent = rhProjectChatState.recording ? 'Stop' : 'Vocal';
    btn.className = rhProjectChatState.recording ? 'btn btn-danger btn-sm' : 'btn btn-outline-secondary btn-sm';
}

function startRhVideoCall() {
    fetch('/api/projects/{{ project.id }}/chat/video-call', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' } })
    .then(async (r) => {
        const data = await r.json();
        if (!r.ok || !data.success) { showAjaxAlert('rhProjectChatAlert', 'danger', data.message || 'Impossible.'); return; }
        hideAjaxAlert('rhProjectChatAlert');
        if (data.url) window.open(String(data.url), '_blank', 'noopener');
        loadRhProjectChatMessages();
    }).catch(() => showAjaxAlert('rhProjectChatAlert', 'danger', 'Erreur reseau.'));
}

function sendRhProjectChatMessage() {
    const input = document.getElementById('rhProjectChatInput');
    if (!input) return;
    const message = String(input.value || '').trim();
    if (!message) return;
    const payload = new URLSearchParams(); payload.set('message', message);
    fetch('/api/projects/{{ project.id }}/chat/send', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }, body: payload.toString() })
    .then(async (r) => {
        const data = await r.json();
        if (!r.ok || !data.success) { showAjaxAlert('rhProjectChatAlert', 'danger', data.message || 'Impossible.'); return; }
        hideAjaxAlert('rhProjectChatAlert'); input.value = ''; loadRhProjectChatMessages();
    }).catch(() => showAjaxAlert('rhProjectChatAlert', 'danger', 'Erreur reseau.'));
}

function escapeHtml(value) {
    return String(value).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
}

document.addEventListener('DOMContentLoaded', initRhProjectChat);
</script>
{% endblock %}
