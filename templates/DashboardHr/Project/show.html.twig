{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
// ─── TAB SWITCHING ───────────────────────────────────────────────
function switchTab(name, btn) {
    document.querySelectorAll('.tab-content-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById('tab-' + name).classList.add('active');
    btn.classList.add('active');
    window.location.hash = name;
}

// Restore tab from URL hash
(function() {
    const forcedTab = '{{ activeTab ?? '' }}';
    const hash = forcedTab !== '' ? forcedTab : window.location.hash.replace('#', '');
    const map = {'team': 1, 'milestones': 2, 'analytics': 3, 'activity': 4};
    if (hash && map[hash] !== undefined) {
        const btns = document.querySelectorAll('.tab-btn');
        if (btns[map[hash]]) btns[map[hash]].click();
    }
})();

// ─── MODAL HELPER ────────────────────────────────────────────────
function openModal(id) {
    new bootstrap.Modal(document.getElementById(id)).show();
}

document.addEventListener('DOMContentLoaded', function () {
    const modalToOpen = '{{ openModal ?? '' }}';
    updateSelectedEmployeeJobTitle();
    if (modalToOpen) {
        openModal(modalToOpen);
    }

    setupAjaxModalForm('newTaskForm', 'modalNewTask', 'newTaskAjaxAlert');
    setupAjaxModalForm('editTaskForm', 'modalEditTask', 'editTaskAjaxAlert');
    setupAjaxModalForm('addMemberForm', 'modalAddMember', 'addMemberAjaxAlert', updateSelectedEmployeeJobTitle);
});

function setupAjaxModalForm(formId, modalId, alertId, afterRenderCallback) {
    const form = document.getElementById(formId);
    if (!form) {
        return;
    }

    form.addEventListener('submit', function (event) {
        event.preventDefault();
        submitModalFormAjax(form, modalId, alertId, afterRenderCallback);
    });
}

function submitModalFormAjax(form, modalId, alertId, afterRenderCallback) {
    clearAjaxErrors(form, alertId);

    fetch(form.action, {
        method: 'POST',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        },
        body: new FormData(form)
    })
    .then(async (response) => {
        const data = await response.json();

        if (!response.ok || data.success === false) {
            applyAjaxErrors(form, data.errors || {}, alertId, data.message || 'Veuillez corriger les erreurs du formulaire.');
            openModal(modalId);
            if (typeof afterRenderCallback === 'function') {
                afterRenderCallback();
            }
            return;
        }

        window.location.reload();
    })
    .catch(() => {
        showAjaxAlert(alertId, 'danger', 'Une erreur technique est survenue.');
        openModal(modalId);
    });
}

function clearAjaxErrors(form, alertId) {
    form.querySelectorAll('.is-invalid').forEach((input) => input.classList.remove('is-invalid'));
    form.querySelectorAll('[data-ajax-error="1"]').forEach((el) => el.remove());
    hideAjaxAlert(alertId);
}

function applyAjaxErrors(form, errors, alertId, fallbackMessage) {
    let hasFieldError = false;

    Object.keys(errors).forEach((field) => {
        const input = form.querySelector('[name="' + field + '"]');
        if (!input) {
            return;
        }

        hasFieldError = true;
        input.classList.add('is-invalid');

        const feedback = document.createElement('div');
        feedback.className = 'invalid-feedback d-block';
        feedback.setAttribute('data-ajax-error', '1');
        feedback.textContent = errors[field];
        input.insertAdjacentElement('afterend', feedback);
    });

    if (!hasFieldError) {
        const globalMessage = errors._global || errors.project_id || errors.project_end_date || fallbackMessage;
        showAjaxAlert(alertId, 'danger', globalMessage);
    }
}

function showAjaxAlert(alertId, type, message) {
    const alert = document.getElementById(alertId);
    if (!alert) {
        return;
    }

    alert.className = 'alert alert-' + type + ' py-2';
    alert.textContent = message;
}

function hideAjaxAlert(alertId) {
    const alert = document.getElementById(alertId);
    if (!alert) {
        return;
    }

    alert.className = 'alert d-none py-2';
    alert.textContent = '';
}

function updateSelectedEmployeeJobTitle() {
    const employeeSelect = document.getElementById('memberEmployeeSelect');
    const roleInput = document.getElementById('selectedEmployeeJobTitle');
    if (!employeeSelect || !roleInput) {
        return;
    }

    const selectedOption = employeeSelect.options[employeeSelect.selectedIndex];
    const jobTitle = selectedOption ? (selectedOption.getAttribute('data-job-title') || 'Membre') : 'Membre';
    roleInput.value = employeeSelect.value ? jobTitle : '';
}

// ─── EDIT TASK ───────────────────────────────────────────────────
function openEditTask(task) {
    document.getElementById('editTaskTitle').value = task.title || '';
    document.getElementById('editTaskDesc').value = task.description || '';
    document.getElementById('editTaskStatus').value = task.status || 'todo';
    document.getElementById('editTaskPriority').value = task.priority || 'medium';
    document.getElementById('editTaskHours').value = task.estimated_hours || '';
    document.getElementById('editTaskStart').value = task.start_date || '';
    document.getElementById('editTaskDue').value = task.due_date || '';
    const assigneeSelect = document.getElementById('editTaskAssignee');
    if (task.assigned_to) assigneeSelect.value = task.assigned_to;
    else assigneeSelect.value = '';
    document.getElementById('editTaskForm').action = '/rh/projects/{{ project.id }}/tasks/' + task.id + '/edit';
    openModal('modalEditTask');
}

// ─── EDIT MILESTONE ──────────────────────────────────────────────
function openEditMilestone(ms) {
    document.getElementById('editMsName').value = ms.name || '';
    document.getElementById('editMsDesc').value = ms.description || '';
    document.getElementById('editMsDate').value = ms.target_date || '';
    document.getElementById('editMsRate').value = ms.completion_rate || 0;
    document.getElementById('editMilestoneForm').action = '/rh/projects/{{ project.id }}/milestones/' + ms.id + '/edit';
    openModal('modalEditMilestone');
}

// ─── KANBAN DRAG & DROP ──────────────────────────────────────────
let draggedTaskId = null;
let aiSuggestionTaskId = null;

function handleDragStart(event, taskId) {
    draggedTaskId = taskId;
    event.dataTransfer.effectAllowed = 'move';
    event.currentTarget.style.opacity = '0.5';
    setTimeout(() => event.currentTarget.style.opacity = '1', 0);
}

function handleDragOver(event) {
    event.preventDefault();
    event.currentTarget.classList.add('drag-over');
}

function handleDragLeave(event) {
    event.currentTarget.classList.remove('drag-over');
}

function handleDrop(event, newStatus) {
    event.preventDefault();
    event.currentTarget.classList.remove('drag-over');
    if (!draggedTaskId) return;

    fetch('/rh/projects/{{ project.id }}/tasks/' + draggedTaskId + '/move', {
        method: 'POST',
        headers: {'Content-Type': 'application/x-www-form-urlencoded'},
        body: '_token={{ csrf_token("task-move") }}&status=' + encodeURIComponent(newStatus)
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) window.location.reload();
    })
    .catch(() => window.location.reload());

    draggedTaskId = null;
}

function openAiSuggestModal(taskId) {
    aiSuggestionTaskId = taskId;
    const list = document.getElementById('aiSuggestList');
    const loading = document.getElementById('aiSuggestLoading');
    list.innerHTML = '';
    loading.classList.remove('d-none');
    hideAjaxAlert('aiSuggestAlert');
    openModal('modalAiSuggest');

    fetch('/rh/projects/{{ project.id }}/tasks/' + taskId + '/ai-suggestions', {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        }
    })
    .then(async (response) => {
        const data = await response.json();
        loading.classList.add('d-none');

        if (!response.ok || data.success === false) {
            showAjaxAlert('aiSuggestAlert', 'danger', data.message || 'Impossible de recuperer les suggestions IA.');
            return;
        }

        renderAiSuggestions(Array.isArray(data.suggestions) ? data.suggestions : []);
    })
    .catch(() => {
        loading.classList.add('d-none');
        showAjaxAlert('aiSuggestAlert', 'danger', 'Erreur reseau lors de la recuperation des suggestions IA.');
    });
}

function renderAiSuggestions(suggestions) {
    const list = document.getElementById('aiSuggestList');
    list.innerHTML = '';

    if (!suggestions.length) {
        showAjaxAlert('aiSuggestAlert', 'warning', 'Aucune suggestion disponible pour cette tache.');
        return;
    }

    suggestions.forEach((item) => {
        const card = document.createElement('div');
        card.className = 'border rounded p-3';
        card.innerHTML =
            '<div class="d-flex justify-content-between align-items-start gap-2">'
            + '<div>'
            + '<div class="fw-semibold">' + escapeHtml(item.username || 'N/A') + ' <span class="badge bg-primary ms-1">' + String(item.score ?? 0) + '/100</span></div>'
            + '<div class="text-muted" style="font-size:.82rem">' + escapeHtml(item.job_title || 'N/A') + '</div>'
            + '<div class="mt-1" style="font-size:.82rem">' + escapeHtml(item.reason || '') + '</div>'
            + '<div class="text-muted mt-1" style="font-size:.75rem">Charge: projet ' + String(item.active_project_tasks ?? 0) + ' | total ' + String(item.active_total_tasks ?? 0) + '</div>'
            + '</div>'
            + '<button type="button" class="btn btn-sm btn-success">Assigner</button>'
            + '</div>';

        const btn = card.querySelector('button');
        btn.addEventListener('click', function () {
            assignTaskFromSuggestion(item.employee_id);
        });

        list.appendChild(card);
    });
}

function assignTaskFromSuggestion(employeeId) {
    if (!aiSuggestionTaskId) {
        return;
    }

    const payload = new URLSearchParams();
    payload.set('employee_id', String(employeeId));

    fetch('/rh/projects/{{ project.id }}/tasks/' + aiSuggestionTaskId + '/assign', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        },
        body: payload.toString(),
    })
    .then(async (response) => {
        const data = await response.json();
        if (!response.ok || data.success === false) {
            showAjaxAlert('aiSuggestAlert', 'danger', data.message || 'Impossible d\'assigner cette tache.');
            return;
        }

        window.location.reload();
    })
    .catch(() => {
        showAjaxAlert('aiSuggestAlert', 'danger', 'Erreur reseau pendant l\'assignation.');
    });
}

const rhProjectChatState = {
    pollHandle: null,
    bootstrapped: false,
};

function initRhProjectChat() {
    const form = document.getElementById('rhProjectChatForm');
    if (!form) {
        return;
    }

    form.addEventListener('submit', function (event) {
        event.preventDefault();
        sendRhProjectChatMessage();
    });

    bootstrapRhProjectChat();
}

function bootstrapRhProjectChat() {
    fetch('/api/projects/{{ project.id }}/chat/bootstrap', {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        }
    })
    .then(async (response) => {
        const data = await response.json();
        if (!response.ok || data.success === false) {
            showAjaxAlert('rhProjectChatAlert', 'danger', data.message || 'Chat Matrix indisponible.');
            return;
        }

        rhProjectChatState.bootstrapped = true;
        loadRhProjectChatMessages();

        if (rhProjectChatState.pollHandle) {
            clearInterval(rhProjectChatState.pollHandle);
        }

        rhProjectChatState.pollHandle = setInterval(loadRhProjectChatMessages, 5000);
    })
    .catch(() => {
        showAjaxAlert('rhProjectChatAlert', 'danger', 'Impossible d\'initialiser le chat Matrix.');
    });
}

function loadRhProjectChatMessages() {
    if (!rhProjectChatState.bootstrapped) {
        return;
    }

    fetch('/api/projects/{{ project.id }}/chat/messages?limit=40', {
        method: 'GET',
        headers: {
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        }
    })
    .then(async (response) => {
        const data = await response.json();
        if (!response.ok || data.success === false) {
            showAjaxAlert('rhProjectChatAlert', 'danger', data.message || 'Impossible de charger les messages.');
            return;
        }

        renderRhProjectChatMessages(Array.isArray(data.messages) ? data.messages : []);
    })
    .catch(() => {
        showAjaxAlert('rhProjectChatAlert', 'danger', 'Erreur reseau pendant le chargement du chat.');
    });
}

function renderRhProjectChatMessages(messages) {
    const container = document.getElementById('rhProjectChatMessages');
    if (!container) {
        return;
    }

    container.innerHTML = '';
    if (!messages.length) {
        container.innerHTML = '<div class="text-muted small">Aucun message pour le moment.</div>';
        return;
    }

    messages.forEach((msg) => {
        const row = document.createElement('div');
        row.className = 'mb-2';

        const date = msg.origin_server_ts ? new Date(msg.origin_server_ts).toLocaleString() : '';
        row.innerHTML =
            '<div class="small"><span class="text-muted">' + escapeHtml(date) + '</span></div>'
            + '<div style="font-size:.88rem; white-space:pre-wrap">' + escapeHtml(msg.body || '') + '</div>';

        container.appendChild(row);
    });

    container.scrollTop = container.scrollHeight;
}

function sendRhProjectChatMessage() {
    const input = document.getElementById('rhProjectChatInput');
    if (!input) {
        return;
    }

    const message = String(input.value || '').trim();
    if (message === '') {
        return;
    }

    const payload = new URLSearchParams();
    payload.set('message', message);

    fetch('/api/projects/{{ project.id }}/chat/send', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'X-Requested-With': 'XMLHttpRequest',
            'Accept': 'application/json'
        },
        body: payload.toString(),
    })
    .then(async (response) => {
        const data = await response.json();
        if (!response.ok || data.success === false) {
            showAjaxAlert('rhProjectChatAlert', 'danger', data.message || 'Impossible d\'envoyer le message.');
            return;
        }

        hideAjaxAlert('rhProjectChatAlert');
        input.value = '';
        loadRhProjectChatMessages();
    })
    .catch(() => {
        showAjaxAlert('rhProjectChatAlert', 'danger', 'Erreur reseau pendant l\'envoi du message.');
    });
}

function escapeHtml(value) {
    return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

document.addEventListener('DOMContentLoaded', function () {
    initRhProjectChat();
});
</script>
{% endblock %}
