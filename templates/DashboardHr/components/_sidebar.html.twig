<style>
    /* Sidebar Formation Module Colors - Inline Styles */
    #sidebar {
        background: linear-gradient(to bottom, #022E69 0%, #0a2854 50%, #051f3d 100%) !important;
    }

    #sidebar .bg-\[\#145EB7\]\/20 {
        background-color: rgba(20, 94, 183, 0.2) !important;
        box-shadow: 0 10px 15px -3px rgba(20, 94, 183, 0.3) !important;
    }

    #sidebar .bg-\[\#145EB7\]\/30 {
        background-color: rgba(20, 94, 183, 0.3) !important;
        color: #3FA9F5 !important;
    }

    #sidebar .text-\[\#3FA9F5\] {
        color: #3FA9F5 !important;
    }

    html.a11y-high-contrast #sidebar {
        background: linear-gradient(to bottom, #022E69 0%, #051f3d 100%) !important;
        border-right: 3px solid #3FA9F5 !important;
    }

    html.a11y-high-contrast #sidebar .bg-\[\#145EB7\]\/20 {
        background-color: #145EB7 !important;
        border: 2px solid #3FA9F5 !important;
        box-shadow: 0 0 0 3px rgba(63, 169, 245, 0.3) !important;
    }

    html.a11y-high-contrast #sidebar .bg-\[\#145EB7\]\/30 {
        background-color: #3FA9F5 !important;
        color: #022E69 !important;
    }
</style>

<aside id="sidebar" class="fixed inset-y-0 left-0 z-30 w-[272px] transform transition-transform duration-300 ease-in-out lg:translate-x-0 -translate-x-full flex flex-col overflow-hidden" style="background: linear-gradient(to bottom, #022E69 0%, #0a2854 50%, #051f3d 100%);">

    {# Subtle accent glow - Formation module palette #}
