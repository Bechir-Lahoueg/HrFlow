<aside id="sidebar" class="fixed inset-y-0 left-0 z-30 w-[272px] bg-gradient-to-b from-teal-950 via-emerald-950 to-slate-950 transform transition-transform duration-300 ease-in-out lg:translate-x-0 -translate-x-full flex flex-col overflow-hidden">

    {# Subtle accent glow #}
    <div class="absolute top-0 left-0 right-0 h-40 bg-gradient-to-b from-teal-500/10 to-transparent pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"></div>

    {# ── Brand ── #}
    <div class="relative flex items-center gap-3 px-5 h-16 border-b border-white/10 shrink-0">
        <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-teal-500 to-emerald-500 flex items-center justify-center shadow-lg shadow-teal-500/30">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
        </div>
        <div class="flex items-center gap-2">
            <span class="text-[15px] font-bold text-white tracking-tight">HrFlow</span>
            <span class="text-[9px] font-bold text-teal-300 bg-teal-500/20 px-1.5 py-0.5 rounded uppercase tracking-wider">HR</span>
        </div>
    </div>

    {# ── Navigation ── #}
    <nav class="relative flex-1 px-3 py-5 overflow-y-auto scrollbar-themed">

        <p class="px-3 mb-2.5 text-[10px] font-bold text-white/30 uppercase tracking-[0.15em]">Overview</p>

        {% set isDashboard = app.request.get('_route') == 'app_welcome_rh' %}
        <a href="{{ path('app_welcome_rh') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                  {{ isDashboard
                      ? 'bg-white/10 text-white shadow-lg shadow-teal-500/5'
                      : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
            <div class="w-7 h-7 rounded-md {{ isDashboard ? 'bg-teal-500/25 text-teal-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>
                </svg>
            </div>
            Dashboard
        </a>

        <p class="px-3 mt-6 mb-2.5 text-[10px] font-bold text-white/30 uppercase tracking-[0.15em]">HR Management</p>

        {% set isEmployees = app.request.get('_route') == 'app_rh_employees' %}
        <a href="{{ path('app_rh_employees') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                  {{ isEmployees
                      ? 'bg-white/10 text-white shadow-lg shadow-teal-500/5'
                      : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
            <div class="w-7 h-7 rounded-md {{ isEmployees ? 'bg-teal-500/25 text-teal-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>
                </svg>
            </div>
            Employees
            <span class="ml-auto text-[10px] font-bold {{ isEmployees ? 'text-teal-300 bg-teal-500/25' : 'text-zinc-500 bg-white/10' }} px-1.5 py-0.5 rounded-md">MY</span>
        </a>

        {% set isLeaves = app.request.get('_route') == 'app_rh_leave_requests' %}
        <a href="{{ path('app_rh_leave_requests') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                  {{ isLeaves
                      ? 'bg-white/10 text-white shadow-lg shadow-teal-500/5'
                      : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
            <div class="w-7 h-7 rounded-md {{ isLeaves ? 'bg-teal-500/25 text-teal-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
                </svg>
            </div>
            Leave Requests
            {% if (pendingLeaveCount|default(0)) > 0 %}
                <span class="ml-auto w-2 h-2 rounded-full bg-amber-400 glow-pulse"></span>
            {% endif %}
        </a>

        {% set isRecruitment = app.request.get('_route') in ['app_rh_job_offers', 'app_rh_applications', 'app_rh_interviews'] %}
        <a href="{{ path('app_rh_job_offers') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                  {{ isRecruitment
                      ? 'bg-white/10 text-white shadow-lg shadow-teal-500/5'
                      : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
            <div class="w-7 h-7 rounded-md {{ isRecruitment ? 'bg-teal-500/25 text-teal-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z"/>
                </svg>
            </div>
            Recruitment
        </a>

        {% set isTraining = app.request.get('_route') == 'rh_formation_list' %}

        <a href="{{ path('rh_formation_list') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
                  {{ isTraining
                      ? 'bg-white/10 text-white shadow-lg shadow-teal-500/5'
                      : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">

            <div class="w-7 h-7 rounded-md {{ isTraining ? 'bg-teal-500/25 text-teal-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"/>
                </svg>
            </div>
            Training
        </a>
    {# ── Projects Link ── #}
    {% set isProjects = app.request.get('_route') starts with 'rh_project_' %}
    <a href="{{ path('rh_project_index') }}"
       class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium transition-all duration-200
              {{ isProjects
                  ? 'bg-white/10 text-white shadow-lg shadow-teal-500/5'
                  : 'text-zinc-400 hover:bg-white/5 hover:text-zinc-200' }}">
        <div class="w-7 h-7 rounded-md {{ isProjects ? 'bg-teal-500/25 text-teal-300' : 'bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10' }} flex items-center justify-center transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-19.5 0A2.25 2.25 0 004.5 15h15a2.25 2.25 0 002.25-2.25m-19.5 0v.25A2.25 2.25 0 004.5 17.5h15a2.25 2.25 0 002.25-2.25v-.25m-16.5-6V9a2.25 2.25 0 012.25-2.25h9a2.25 2.25 0 012.25 2.25v1.5m-13.5 0h13.5" />
            </svg>
        </div>
        Projects
    </a>

        <a href="#" class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium text-zinc-400 hover:bg-white/5 hover:text-zinc-200 transition-all duration-200">
            <div class="w-7 h-7 rounded-md bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
                </svg>
            </div>
            Reports
        </a>

        <p class="px-3 mt-6 mb-2.5 text-[10px] font-bold text-white/30 uppercase tracking-[0.15em]">System</p>

        <a href="#" class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium text-zinc-400 hover:bg-white/5 hover:text-zinc-200 transition-all duration-200">
            <div class="w-7 h-7 rounded-md bg-white/5 text-zinc-500 group-hover:text-zinc-300 group-hover:bg-white/10 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            Settings
        </a>
    </nav>

    {# ── Logout ── #}
    <div class="relative px-3 py-4 border-t border-white/10 shrink-0">
        <a href="{{ path('app_logout') }}"
           class="group flex items-center gap-3 px-3 py-2 rounded-lg text-[13px] font-medium text-zinc-500 hover:bg-rose-500/10 hover:text-rose-400 transition-all duration-200">
            <div class="w-7 h-7 rounded-md bg-white/5 text-zinc-500 group-hover:bg-rose-500/15 group-hover:text-rose-400 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9"/>
                </svg>
            </div>
            Logout
        </a>
    </div>
</aside>

{# Mobile overlay #}
<div id="sidebar-overlay" class="fixed inset-0 z-20 bg-black/60 backdrop-blur-sm hidden lg:hidden" onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); this.classList.add('hidden');"></div>
