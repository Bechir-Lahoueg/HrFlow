{% extends 'base.html.twig' %}

{% block title %}Détails de la Prime{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-4xl mx-auto">

            {# Header #}
            <div class="flex items-center justify-between animate-slide-up">
                <div>
                    <h1 class="text-3xl font-extrabold text-zinc-900 dark:text-white">Détails de la Prime</h1>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2">Consultez les informations détaillées</p>
                </div>
                <a href="{{ path('app_rh_payroll_primes') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-medium hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour à la liste
                </a>
            </div>

            {# Content #}
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {# Main Info #}
                <div class="lg:col-span-2 space-y-6">
                    {# Employee Card #}
                    <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm p-6 animate-slide-up">
                        <h2 class="text-lg font-semibold text-zinc-900 dark:text-white mb-4">Employé</h2>
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-full bg-gradient-to-br from-teal-400 to-teal-600 flex items-center justify-center text-white font-bold text-lg">
                                {{ prime.employeeName|first|upper }}
                            </div>
                            <div>
                                <p class="text-lg font-semibold text-zinc-900 dark:text-white">{{ prime.employeeName }}</p>
                                <p class="text-sm text-zinc-500 dark:text-zinc-400">ID: {{ prime.employeeId }}</p>
                            </div>
                        </div>
                    </div>

                    {# Prime Details Card #}
                    <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm p-6 animate-slide-up">
                        <h2 class="text-lg font-semibold text-zinc-900 dark:text-white mb-4">Détails de la Prime</h2>
                        <div class="space-y-4">
                            <div>
                                <label class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Type de Prime</label>
                                <p class="text-lg font-semibold text-zinc-900 dark:text-white mt-1">{{ prime.typePrime.value }}</p>
                            </div>
                            <div>
                                <label class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Montant</label>
                                <p class="text-3xl font-bold text-emerald-600 dark:text-emerald-400 mt-1">{{ prime.montant }} DT</p>
                            </div>
                            <div>
                                <label class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Date d'Attribution</label>
                                <p class="text-base text-zinc-900 dark:text-white mt-1">{{ prime.dateAttribution|date('d/m/Y') }}</p>
                            </div>
                            {% if prime.motif %}
                                <div>
                                    <label class="text-sm font-medium text-zinc-600 dark:text-zinc-400">Motif</label>
                                    <p class="text-base text-zinc-900 dark:text-white mt-1 p-3 bg-zinc-50 dark:bg-zinc-800 rounded-lg">{{ prime.motif }}</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Timestamps #}
                    <div class="bg-zinc-50 dark:bg-zinc-800/50 rounded-xl p-4 text-sm text-zinc-600 dark:text-zinc-400 space-y-2">
                        <p>Créée le: {{ prime.createdAt ? prime.createdAt|date('d/m/Y H:i') : 'Non disponible' }}</p>
                        {% if prime.updatedAt %}
                            <p>Modifiée le: {{ prime.updatedAt|date('d/m/Y H:i') }}</p>
                        {% endif %}
                    </div>
                </div>

                {# Sidebar Actions #}
                <div class="lg:col-span-1">
                    <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm p-6 space-y-3 animate-slide-up sticky top-24">
                        <h3 class="text-lg font-semibold text-zinc-900 dark:text-white mb-4">Actions</h3>
                        
                        <a href="{{ path('app_rh_payroll_prime_edit', { id: prime.id }) }}" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            Modifier
                        </a>

                        <form method="POST" action="{{ path('app_rh_payroll_prime_delete', { id: prime.id }) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette prime ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_prime_' ~ prime.id) }}">
                            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
