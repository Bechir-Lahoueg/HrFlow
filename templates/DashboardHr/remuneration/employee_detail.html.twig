{% extends 'base.html.twig' %}

{% block title %}{{ employee.firstName }} {{ employee.lastName }} - Rémunération{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-lg bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-400 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# Header #}
            <div class="flex items-center justify-between animate-slide-up">
                <div class="flex items-center gap-4">
                    <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-teal-400 to-emerald-500 flex items-center justify-center text-white font-bold text-xl shadow-lg">
                        {{ employee.firstName|first }}{{ employee.lastName|first }}
                    </div>
                    <div>
                        <h1 class="text-3xl font-extrabold text-zinc-900 dark:text-white">{{ employee.firstName }} {{ employee.lastName }}</h1>
                        <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">{{ employee.email }} &bull; {{ employee.poste ?? 'Non défini' }}</p>
                    </div>
                </div>
                <a href="{{ path('app_rh_remuneration_index') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-medium hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour
                </a>
            </div>

            {# Action Buttons #}
            <div class="flex flex-wrap gap-3 animate-slide-up">
                <a href="{{ path('app_rh_payroll_fiche_create') }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-teal-600 hover:bg-teal-700 text-white font-semibold text-sm transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                    Créer Fiche de Paie
                </a>
                <a href="{{ path('app_rh_payroll_prime_create', {'employee_id': employee.id}) }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 font-semibold text-sm hover:bg-emerald-100 dark:hover:bg-emerald-500/20 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                    Ajouter Prime
                </a>
                <a href="{{ path('app_rh_payroll_deduction_create', {'employee_id': employee.id}) }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-amber-50 dark:bg-amber-500/10 text-amber-700 dark:text-amber-400 font-semibold text-sm hover:bg-amber-100 dark:hover:bg-amber-500/20 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                    Ajouter Déduction
                </a>
            </div>

            {# Fiches de Paie Table #}
            <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm overflow-hidden animate-slide-up">
                <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/50 flex items-center justify-between">
                    <h2 class="text-lg font-semibold text-zinc-900 dark:text-white">Fiches de Paie</h2>
                    <span class="text-sm text-zinc-500 dark:text-zinc-400">{{ fiches|length }} fiche(s)</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-zinc-100 dark:border-zinc-800/50 bg-zinc-50 dark:bg-zinc-800/50">
                                <th class="px-6 py-3 text-left text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Période</th>
                                <th class="px-6 py-3 text-right text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Salaire Brut</th>
                                <th class="px-6 py-3 text-right text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Primes</th>
                                <th class="px-6 py-3 text-right text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Déductions</th>
                                <th class="px-6 py-3 text-right text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Salaire Net</th>
                                <th class="px-6 py-3 text-center text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/50">
                            {% if fiches|length > 0 %}
                                {% for fiche in fiches %}
                                <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/30 transition-colors">
                                    <td class="px-6 py-4">
                                        <span class="font-semibold text-zinc-900 dark:text-zinc-100">{{ fiche.mois }}/{{ fiche.annee }}</span>
                                    </td>
                                    <td class="px-6 py-4 text-right text-sm font-mono text-zinc-700 dark:text-zinc-300">{{ fiche.salaireBrut }} DT</td>
                                    <td class="px-6 py-4 text-right text-sm font-mono text-emerald-600 dark:text-emerald-400">+{{ fiche.totalPrimes }} DT</td>
                                    <td class="px-6 py-4 text-right text-sm font-mono text-red-600 dark:text-red-400">-{{ fiche.totalDeductions }} DT</td>
                                    <td class="px-6 py-4 text-right">
                                        <span class="font-bold text-zinc-900 dark:text-zinc-100 font-mono">{{ fiche.salaireNet }} DT</span>
                                    </td>
                                    <td class="px-6 py-4 text-center">
                                        <div class="flex items-center justify-center gap-2">
                                            <a href="{{ path('app_rh_payroll_fiche_show', { id: fiche.id }) }}" class="text-teal-600 dark:text-teal-400 hover:text-teal-700 p-1.5 hover:bg-teal-50 dark:hover:bg-teal-900/20 rounded transition-colors" title="Voir">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                            </a>
                                            <a href="{{ path('app_rh_payroll_fiche_edit', { id: fiche.id }) }}" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 p-1.5 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded transition-colors" title="Éditer">
                                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                            </a>
                                            <form method="POST" action="{{ path('app_rh_payroll_fiche_delete', { id: fiche.id }) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_fiche_paie_' ~ fiche.id) }}">
                                                <button type="submit" class="text-red-600 dark:text-red-400 hover:text-red-700 p-1.5 hover:bg-red-50 dark:hover:bg-red-900/20 rounded transition-colors" title="Supprimer">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center">
                                        <div class="flex flex-col items-center gap-2">
                                            <svg class="w-12 h-12 text-zinc-300 dark:text-zinc-700" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.148.42-.248.63m5.801 0c.065.21.1.395.081.609A6.375 6.375 0 0112.75 21.75m0 0v-2.25"/></svg>
                                            <p class="text-sm text-zinc-500 dark:text-zinc-400 font-medium">Aucune fiche de paie créée</p>
                                            <a href="{{ path('app_rh_payroll_fiche_create') }}" class="text-sm text-teal-600 dark:text-teal-400 font-medium hover:underline">Créer la première fiche</a>
                                        </div>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>
</div>
{% endblock %}
