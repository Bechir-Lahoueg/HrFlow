{% extends 'base.html.twig' %}

{% block title %}Déductions - Gestion RH{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Payroll module color palette — mirrors remuneration/index */
        :root {
            --payroll-primary-deep: #022E69;
            --payroll-primary: #145EB7;
            --payroll-accent: #3FA9F5;
            --payroll-border: #D0D0D0;
        }

        html.a11y-high-contrast {
            --payroll-border: #3FA9F5;
        }

        #deductions-page-container {
            background-color: #f4f7fb !important;
        }

        @media (prefers-color-scheme: dark) {
            #deductions-page-container {
                background-color: #18181b !important;
            }
        }

        .hero-banner-deductions {
            background: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d) !important;
        }
    </style>
{% endblock %}

{% block body %}
<div id="deductions-page-container" class="min-h-screen dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/30 text-rose-700 dark:text-rose-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-rose-100 dark:bg-rose-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 lg:p-8 space-y-6 max-w-7xl mx-auto">

            {# HERO BANNER #}
            <section class="hero-banner-deductions relative overflow-hidden rounded-2xl text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full blur-3xl" style="background: radial-gradient(circle, rgba(63, 169, 245, 0.15), transparent 70%);"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full blur-3xl" style="background: radial-gradient(circle, rgba(20, 94, 183, 0.15), transparent 70%);"></div>
                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full animate-pulse" style="background-color: #3FA9F5;"></div>
                            <span class="text-[11px] font-bold uppercase tracking-wider" style="color: #3FA9F5;">Rémunération</span>
                        </div>
                        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight">Gestion des Déductions</h1>
                        <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">
                            Consultez et gérez les déductions appliquées aux salaires de vos employés.
                        </p>
                    </div>
                    <a href="{{ path('app_rh_payroll_deduction_create') }}" class="self-start sm:self-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-white font-semibold text-sm transition-all shadow-lg shrink-0" style="background: linear-gradient(135deg, #145EB7, #3FA9F5);">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                        Ajouter une Déduction
                    </a>
                </div>
            </section>

            {# ═══════════════ Stats Dashboard ═══════════════ #}
            {% set totalMontant = deductions|reduce((sum, d) => sum + d.montant, 0) %}
            {% set countByType = {} %}
            {% for d in deductions %}
                {% set key = d.typeDeduction.value %}
                {% set countByType = countByType|merge({(key): (countByType[key] is defined ? countByType[key] + 1 : 1)}) %}
            {% endfor %}
            {% set topType = '' %}
            {% set topCount = 0 %}
            {% for type, cnt in countByType %}
                {% if cnt > topCount %}{% set topType = type %}{% set topCount = cnt %}{% endif %}
            {% endfor %}
            {% set maxMontant = 0 %}
            {% for d in deductions %}
                {% if d.montant > maxMontant %}{% set maxMontant = d.montant %}{% endif %}
            {% endfor %}

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 animate-slide-up">

                {# Stat 1 — Total count #}
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-1">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background-color: rgba(20, 94, 183, 0.1);">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12H4.5"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ deductions|length }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Nombre de Déductions</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden">
                        <div class="h-full w-full rounded-full" style="background: linear-gradient(90deg, #145EB7, #3FA9F5);"></div>
                    </div>
                </div>

                {# Stat 2 — Total amount #}
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-2">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-rose-50 dark:bg-rose-950/30 flex items-center justify-center">
                            <svg class="w-5 h-5 text-rose-600 dark:text-rose-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3.75-9.75a6 6 0 000 11.25M2.25 9.75a9 9 0 0119.5 0"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-rose-600 dark:text-rose-400 font-mono-num">{{ totalMontant|number_format(2, '.', ' ') }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Montant Total (DT)</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden">
                        <div class="h-full w-full rounded-full bg-gradient-to-r from-rose-500 to-pink-400"></div>
                    </div>
                </div>

                {# Stat 3 — Max amount #}
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-3">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-amber-50 dark:bg-amber-950/30 flex items-center justify-center">
                            <svg class="w-5 h-5 text-amber-600 dark:text-amber-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-amber-600 dark:text-amber-400 font-mono-num">{{ maxMontant|number_format(2, '.', ' ') }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Déduction la Plus Élevée</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden">
                        <div class="h-full w-1/2 rounded-full bg-gradient-to-r from-amber-500 to-orange-400"></div>
                    </div>
                </div>

                {# Stat 4 — Top type #}
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-sky-50 dark:bg-sky-950/30 flex items-center justify-center">
                            <svg class="w-5 h-5 text-sky-600 dark:text-sky-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z"/><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z"/></svg>
                        </div>
                    </div>
                    <p class="text-base font-bold text-zinc-900 dark:text-zinc-100 leading-tight truncate">{{ topType ?: '—' }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Type le Plus Fréquent{% if topCount > 0 %} ({{ topCount }}){% endif %}</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden">
                        <div class="h-full w-2/3 rounded-full bg-gradient-to-r from-sky-500 to-cyan-400"></div>
                    </div>
                </div>
            </div>

            {# Filters #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color: rgba(20, 94, 183, 0.1);">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01-.293.707L13 13.414V19a1 1 0 01-.553.894l-4 2A1 1 0 017 21v-7.586L3.293 6.707A1 1 0 013 6V4z"/></svg>
                    </div>
                    <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Filtres</h3>
                </div>
                <form method="GET" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider mb-2" style="color: #022E69;">Employé</label>
                        <div class="relative">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.5 5.5a7.5 7.5 0 0010.5 10.5z"/></svg>
                            <input type="text" name="employee" value="{{ filters.employee ?? '' }}" placeholder="Rechercher un employé..."
                                class="w-full pl-9 pr-4 py-2.5 rounded-lg border text-sm focus:outline-none focus:ring-1 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400"
                                style="border-color: #D0D0D0; focus-border-color: #145EB7;">
                        </div>
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold uppercase tracking-wider mb-2" style="color: #022E69;">Type de Déduction</label>
                        <select name="type"
                            class="w-full px-4 py-2.5 rounded-lg border text-sm focus:outline-none focus:ring-1 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white"
                            style="border-color: #D0D0D0;">
                            <option value="">— Tous les types —</option>
                            <option value="Impôt sur le Revenu (IRPP)" {% if filters.type == 'Impôt sur le Revenu (IRPP)' %}selected{% endif %}>IRPP</option>
                            <option value="Cotisation CNSS" {% if filters.type == 'Cotisation CNSS' %}selected{% endif %}>CNSS</option>
                            <option value="Assurance Mutuelle" {% if filters.type == 'Assurance Mutuelle' %}selected{% endif %}>Assurance Mutuelle</option>
                            <option value="Charge Syndicale" {% if filters.type == 'Charge Syndicale' %}selected{% endif %}>Charge Syndicale</option>
                            <option value="Avance sur Salaire" {% if filters.type == 'Avance sur Salaire' %}selected{% endif %}>Avance sur Salaire</option>
                            <option value="Crédit/Remboursement" {% if filters.type == 'Crédit/Remboursement' %}selected{% endif %}>Crédit/Remboursement</option>
                            <option value="Retenue Disciplinaire" {% if filters.type == 'Retenue Disciplinaire' %}selected{% endif %}>Retenue Disciplinaire</option>
                            <option value="Impôt Local" {% if filters.type == 'Impôt Local' %}selected{% endif %}>Impôt Local</option>
                            <option value="Assurance Maladie" {% if filters.type == 'Assurance Maladie' %}selected{% endif %}>Assurance Maladie</option>
                            <option value="Autre Déduction" {% if filters.type == 'Autre Déduction' %}selected{% endif %}>Autre Déduction</option>
                        </select>
                    </div>
                    <div class="flex items-end gap-2">
                        <button type="submit"
                            class="flex-1 px-4 py-2.5 rounded-lg text-white font-semibold text-sm transition-all shadow-sm"
                            style="background: linear-gradient(135deg, #145EB7, #3FA9F5);">
                            Filtrer
                        </button>
                        {% if filters.employee or filters.type %}
                            <a href="{{ path('app_rh_payroll_deductions') }}"
                                class="px-4 py-2.5 rounded-lg border font-medium text-sm hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
                                style="border-color: #D0D0D0; color: #022E69;">
                                Reset
                            </a>
                        {% endif %}
                    </div>
                </form>
            </section>

            {# Table #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm overflow-hidden animate-slide-up stagger-6">
                <div class="px-6 py-4 border-b flex items-center justify-between" style="border-color: #D0D0D0; background: #edf4ff;">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color: rgba(20, 94, 183, 0.1);">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                        </div>
                        <span class="text-[11px] font-bold uppercase tracking-wider" style="color: #022E69;">Liste des Déductions</span>
                    </div>
                    <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full" style="background-color: rgba(20, 94, 183, 0.1); color: #145EB7;">
                        {{ deductions|length }} déduction(s)
                    </span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-[11px] font-bold uppercase tracking-wider border-b" style="color: #022E69; border-color: #D0D0D0; background: #f4f7fb;">
                                <th class="py-3 px-4">Employé</th>
                                <th class="py-3 px-4">Type</th>
                                <th class="py-3 px-4">Motif</th>
                                <th class="py-3 px-4 text-right">Montant</th>
                                <th class="py-3 px-4">Date</th>
                                <th class="py-3 px-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if deductions|length > 0 %}
                                {% for deduction in deductions %}
                                    <tr class="border-b align-middle hover:bg-blue-50/40 transition-colors" style="border-color: #eef2f8;">
                                        <td class="py-3 px-4">
                                            <div class="flex items-center gap-2.5">
                                                <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #022E69, #145EB7);">
                                                    <span class="text-[11px] font-bold text-white">
                                                        {{ deduction.employeeName|split(' ')|first|first|upper }}{{ deduction.employeeName|split(' ')|last|first|upper }}
                                                    </span>
                                                </div>
                                                <p class="text-[13px] font-semibold" style="color: #022E69;">{{ deduction.employeeName }}</p>
                                            </div>
                                        </td>
                                        <td class="py-3 px-4">
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold"
                                                style="background-color: rgba(20, 94, 183, 0.1); color: #145EB7;">
                                                {{ deduction.typeDeduction.value }}
                                            </span>
                                        </td>
                                        <td class="py-3 px-4 text-[13px] text-zinc-500 dark:text-zinc-400 max-w-xs truncate">
                                            {{ deduction.motif ?? '—' }}
                                        </td>
                                        <td class="py-3 px-4 text-right text-[13px] font-bold text-rose-600 dark:text-rose-400 font-mono-num">
                                            {{ deduction.montant|number_format(2, '.', ' ') }} DT
                                        </td>
                                        <td class="py-3 px-4 text-[13px] text-zinc-500 dark:text-zinc-400">
                                            {{ deduction.dateDeduction|date('d/m/Y') }}
                                        </td>
                                        <td class="py-3 px-4">
                                            <div class="flex items-center justify-center gap-1">
                                                <a href="{{ path('app_rh_payroll_deduction_show', { id: deduction.id }) }}"
                                                    class="w-8 h-8 rounded-lg bg-teal-50 dark:bg-teal-500/10 text-teal-600 dark:text-teal-400 hover:bg-teal-100 dark:hover:bg-teal-500/20 flex items-center justify-center transition-colors"
                                                    title="Voir">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                                </a>
                                                <a href="{{ path('app_rh_payroll_deduction_edit', { id: deduction.id }) }}"
                                                    class="w-8 h-8 rounded-lg flex items-center justify-center transition-colors text-white"
                                                    style="background-color: #145EB7;"
                                                    title="Modifier">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                                </a>
                                                <form method="POST" action="{{ path('app_rh_payroll_deduction_delete', { id: deduction.id }) }}" style="display:inline;" onsubmit="return confirm('Supprimer cette déduction ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_deduction_' ~ deduction.id) }}">
                                                    <button type="submit"
                                                        class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-500/20 flex items-center justify-center transition-colors"
                                                        title="Supprimer">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="6" class="py-12 px-4 text-center">
                                        <div class="w-12 h-12 rounded-xl flex items-center justify-center mx-auto mb-3" style="background-color: rgba(20, 94, 183, 0.08);">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                                        </div>
                                        <p class="text-sm font-semibold text-zinc-700 dark:text-zinc-300">Aucune déduction trouvée</p>
                                        <p class="text-xs text-zinc-400 mt-1">Créez votre première déduction pour commencer</p>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </section>

            {# Footer nav #}
            <div class="flex items-center justify-end animate-slide-up">
                <a href="{{ path('app_rh_remuneration_index') }}"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border font-medium text-sm hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors"
                    style="border-color: #D0D0D0; color: #022E69;">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour à la Rémunération
                </a>
            </div>

        </main>
    </div>
</div>
{% endblock %}
