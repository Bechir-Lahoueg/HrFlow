{% extends 'base.html.twig' %}

{% block title %}Déductions{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# Header #}
            <div class="flex items-center justify-between animate-slide-up">
                <div>
                    <h1 class="text-3xl font-extrabold text-zinc-900 dark:text-white">Gestion des Déductions</h1>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-2">Consultez et gérez les déductions appliquées</p>
                </div>
                <a href="{{ path('app_rh_payroll_deduction_create') }}" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-lg bg-orange-600 hover:bg-orange-700 text-white font-semibold text-sm transition-colors">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                    Ajouter une Déduction
                </a>
            </div>

            {# Filters #}
            <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm p-6 animate-slide-up">
                <h2 class="text-sm font-semibold text-zinc-900 dark:text-white mb-4">Filtres</h2>
                <form method="GET" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Employé</label>
                        <input type="text" name="employee" value="{{ filters.employee ?? '' }}" placeholder="Rechercher..." class="w-full px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Type</label>
                        <select name="type" class="w-full px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-orange-500 focus:border-transparent">
                            <option value="">-- Tous les types --</option>
                            <option value="Impôt sur le Revenu (IRPP)" {% if filters.type == 'Impôt sur le Revenu (IRPP)' %}selected{% endif %}>IRPP</option>
                            <option value="Cotisation CNSS" {% if filters.type == 'Cotisation CNSS' %}selected{% endif %}>CNSS</option>
                            <option value="Assurance Mutuelle" {% if filters.type == 'Assurance Mutuelle' %}selected{% endif %}>Assurance Mutuelle</option>
                            <option value="Charge Syndicale" {% if filters.type == 'Charge Syndicale' %}selected{% endif %}>Charge Syndicale</option>
                            <option value="Avance sur Salaire" {% if filters.type == 'Avance sur Salaire' %}selected{% endif %}>Avance sur Salaire</option>
                            <option value="Crédit/Remboursement" {% if filters.type == 'Crédit/Remboursement' %}selected{% endif %}>Crédit/Remboursement</option>
                            <option value="Retenue Disciplinaire" {% if filters.type == 'Retenue Disciplinaire' %}selected{% endif %}>Retenue Disciplinaire</option>
                            <option value="Impôt Local" {% if filters.type == 'Impôt Local' %}selected{% endif %}>Impôt Local</option>
                            <option value="Assurance Maladie" {% if filters.type == 'Assurance Maladie' %}selected{% endif %}>Assurance Maladie</option>
                            <option value="Autre Déduction" {% if filters.type == 'Autre Déduction' %}selected{% endif %}>Autre Déduction</option>
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full px-4 py-2 rounded-lg bg-orange-600 hover:bg-orange-700 text-white font-medium transition-colors">
                            Filtrer
                        </button>
                    </div>
                </form>
            </div>

            {# Table #}
            <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm overflow-hidden animate-slide-up">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-zinc-50 dark:bg-zinc-800 border-b border-zinc-200 dark:border-zinc-700">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">Employé</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">Type</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">Motif</th>
                                <th class="px-6 py-3 text-right text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">Montant</th>
                                <th class="px-6 py-3 text-left text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">Date</th>
                                <th class="px-6 py-3 text-center text-xs font-semibold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
                            {% if deductions|length > 0 %}
                                {% for deduction in deductions %}
                                    <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                                        <td class="px-6 py-4 text-sm font-medium text-zinc-900 dark:text-white">{{ deduction.employeeName }}</td>
                                        <td class="px-6 py-4 text-sm text-zinc-700 dark:text-zinc-300">
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 dark:bg-red-900/30 text-red-800 dark:text-red-400">
                                                {{ deduction.typeDeduction.value }}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-zinc-600 dark:text-zinc-400 max-w-xs truncate">{{ deduction.motif ?? '—' }}</td>
                                        <td class="px-6 py-4 text-right text-sm font-semibold text-red-600 dark:text-red-400">{{ deduction.montant }} DT</td>
                                        <td class="px-6 py-4 text-sm text-zinc-600 dark:text-zinc-400">{{ deduction.dateDeduction|date('d/m/Y') }}</td>
                                        <td class="px-6 py-4 text-center">
                                            <div class="flex items-center justify-center gap-2">
                                                <a href="{{ path('app_rh_payroll_deduction_show', { id: deduction.id }) }}" class="text-orange-600 dark:text-orange-400 hover:text-orange-700 dark:hover:text-orange-300 p-2 hover:bg-orange-50 dark:hover:bg-orange-900/20 rounded transition-colors" title="Voir">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                                </a>
                                                <a href="{{ path('app_rh_payroll_deduction_edit', { id: deduction.id }) }}" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 p-2 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded transition-colors" title="Modifier">
                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                                </a>
                                                <form method="POST" action="{{ path('app_rh_payroll_deduction_delete', { id: deduction.id }) }}" style="display:inline;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_deduction_' ~ deduction.id) }}">
                                                    <button type="submit" class="text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 p-2 hover:bg-red-50 dark:hover:bg-red-900/20 rounded transition-colors" title="Supprimer">
                                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center text-zinc-600 dark:text-zinc-400">
                                        <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                                        </svg>
                                        <p class="font-medium">Aucune déduction trouvée</p>
                                        <p class="text-sm mt-1">Créez votre première déduction pour commencer</p>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# Footer #}
            <div class="flex items-center justify-between">
                <div class="text-sm text-zinc-600 dark:text-zinc-400">
                    Total: <span class="font-semibold text-zinc-900 dark:text-white">{{ deductions|length }}</span> déduction(s)
                </div>
                <a href="{{ path('app_rh_remuneration_index') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-medium hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour à la Rémunération
                </a>
            </div>
        </main>
    </div>
</div>
{% endblock %}
