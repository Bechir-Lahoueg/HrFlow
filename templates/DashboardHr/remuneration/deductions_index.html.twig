{% extends 'base.html.twig' %}

{% block title %}Déductions{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/30 text-rose-700 dark:text-rose-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-rose-100 dark:bg-rose-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 lg:p-8 space-y-6 max-w-[1440px] mx-auto">

            {# HERO BANNER #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-orange-950 to-amber-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-orange-400/15 blur-3xl"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-amber-300/15 blur-3xl"></div>
                <div class="absolute top-1/2 left-1/3 h-32 w-32 rounded-full bg-yellow-400/10 blur-3xl"></div>
                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-amber-200 uppercase tracking-[0.15em]">Rémunération</span>
                        </div>
                        <h1 class="text-3xl sm:text-4xl font-display leading-[1.1] tracking-tight">Gestion des Déductions</h1>
                        <p class="text-slate-300/90 max-w-lg text-[14px] leading-relaxed">Consultez et gérez les déductions appliquées aux salaires.</p>
                    </div>
                    <a href="{{ path('app_rh_payroll_deduction_create') }}" class="self-start sm:self-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-white font-semibold text-sm transition-colors shadow-lg shadow-amber-900/30 shrink-0">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"/></svg>
                        Ajouter une Déduction
                    </a>
                </div>
            </section>

            {# Filters #}
            <div class="card-surface p-5 animate-slide-up stagger-1">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-2 h-2 rounded-full bg-amber-400"></div>
                    <h2 class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.15em]">Filtres</h2>
                </div>
                <form method="GET" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-[11px] font-semibold text-zinc-500 uppercase tracking-[0.08em] mb-2">Employé</label>
                        <input type="text" name="employee" value="{{ filters.employee ?? '' }}" placeholder="Rechercher..." class="input-refined w-full px-4 py-2.5 rounded-lg bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-[11px] font-semibold text-zinc-500 uppercase tracking-[0.08em] mb-2">Type</label>
                        <select name="type" class="input-refined w-full px-4 py-2.5 rounded-lg bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none">
                            <option value="">— Tous les types —</option>
                            <option value="Impôt sur le Revenu (IRPP)" {% if filters.type == 'Impôt sur le Revenu (IRPP)' %}selected{% endif %}>IRPP</option>
                            <option value="Cotisation CNSS" {% if filters.type == 'Cotisation CNSS' %}selected{% endif %}>CNSS</option>
                            <option value="Assurance Mutuelle" {% if filters.type == 'Assurance Mutuelle' %}selected{% endif %}>Assurance Mutuelle</option>
                            <option value="Charge Syndicale" {% if filters.type == 'Charge Syndicale' %}selected{% endif %}>Charge Syndicale</option>
                            <option value="Avance sur Salaire" {% if filters.type == 'Avance sur Salaire' %}selected{% endif %}>Avance sur Salaire</option>
                            <option value="Crédit/Remboursement" {% if filters.type == 'Crédit/Remboursement' %}selected{% endif %}>Crédit/Remboursement</option>
                            <option value="Retenue Disciplinaire" {% if filters.type == 'Retenue Disciplinaire' %}selected{% endif %}>Retenue Disciplinaire</option>
                            <option value="Impôt Local" {% if filters.type == 'Impôt Local' %}selected{% endif %}>Impôt Local</option>
                            <option value="Assurance Maladie" {% if filters.type == 'Assurance Maladie' %}selected{% endif %}>Assurance Maladie</option>
                            <option value="Autre Déduction" {% if filters.type == 'Autre Déduction' %}selected{% endif %}>Autre Déduction</option>
                        </select>
                    </div>
                    <div class="flex items-end gap-2">
                        <button type="submit" class="flex-1 px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-semibold text-sm transition-colors">
                            Filtrer
                        </button>
                        {% if filters.employee or filters.type %}
                            <a href="{{ path('app_rh_payroll_deductions') }}" class="px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 font-medium text-sm hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                                Reset
                            </a>
                        {% endif %}
                    </div>
                </form>
            </div>

            {# Table #}
            <div class="card-surface stat-stripe stat-stripe-amber overflow-hidden animate-slide-up stagger-2">
                <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/50 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-amber-400"></div>
                        <span class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.15em]">Liste des Déductions</span>
                    </div>
                    <span class="text-[11px] font-semibold text-zinc-400 bg-zinc-100 dark:bg-zinc-800 px-2.5 py-1 rounded-full">{{ deductions|length }} déduction(s)</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="border-b border-zinc-100 dark:border-zinc-800/50 bg-zinc-50/50 dark:bg-zinc-800/30">
                                <th class="px-6 py-3.5 text-left text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Employé</th>
                                <th class="px-6 py-3.5 text-left text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Type</th>
                                <th class="px-6 py-3.5 text-left text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Motif</th>
                                <th class="px-6 py-3.5 text-right text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Montant</th>
                                <th class="px-6 py-3.5 text-left text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Date</th>
                                <th class="px-6 py-3.5 text-center text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/50">
                            {% if deductions|length > 0 %}
                                {% for deduction in deductions %}
                                    <tr class="row-refined hover:bg-zinc-50 dark:hover:bg-zinc-800/30 transition-colors">
                                        <td class="px-6 py-4 text-sm font-semibold text-zinc-900 dark:text-white">{{ deduction.employeeName }}</td>
                                        <td class="px-6 py-4">
                                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-rose-50 dark:bg-rose-500/10 text-rose-700 dark:text-rose-400">
                                                {{ deduction.typeDeduction.value }}
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-sm text-zinc-500 dark:text-zinc-400 max-w-xs truncate">{{ deduction.motif ?? '—' }}</td>
                                        <td class="px-6 py-4 text-right text-sm font-bold text-rose-600 dark:text-rose-400 font-mono-num">{{ deduction.montant }} DT</td>
                                        <td class="px-6 py-4 text-sm text-zinc-500 dark:text-zinc-400">{{ deduction.dateDeduction|date('d/m/Y') }}</td>
                                        <td class="px-6 py-4 text-center">
                                            <div class="flex items-center justify-center gap-1">
                                                <a href="{{ path('app_rh_payroll_deduction_show', { id: deduction.id }) }}" class="w-8 h-8 rounded-lg bg-teal-50 dark:bg-teal-500/10 text-teal-600 dark:text-teal-400 hover:bg-teal-100 dark:hover:bg-teal-500/20 flex items-center justify-center transition-colors" title="Voir">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                                </a>
                                                <a href="{{ path('app_rh_payroll_deduction_edit', { id: deduction.id }) }}" class="w-8 h-8 rounded-lg bg-sky-50 dark:bg-sky-500/10 text-sky-600 dark:text-sky-400 hover:bg-sky-100 dark:hover:bg-sky-500/20 flex items-center justify-center transition-colors" title="Modifier">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                                                </a>
                                                <form method="POST" action="{{ path('app_rh_payroll_deduction_delete', { id: deduction.id }) }}" style="display:inline;" onsubmit="return confirm('Supprimer cette déduction ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_deduction_' ~ deduction.id) }}">
                                                    <button type="submit" class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-500/10 text-rose-600 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-500/20 flex items-center justify-center transition-colors" title="Supprimer">
                                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="6" class="px-6 py-16 text-center">
                                        <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mx-auto mb-3">
                                            <svg class="w-6 h-6 text-zinc-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg>
                                        </div>
                                        <p class="text-sm font-semibold text-zinc-700 dark:text-zinc-300">Aucune déduction trouvée</p>
                                        <p class="text-xs text-zinc-400 mt-1">Créez votre première déduction pour commencer</p>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
            </div>

            {# Footer #}
            <div class="flex items-center justify-end animate-slide-up stagger-3">
                <a href="{{ path('app_rh_remuneration_index') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 font-medium text-sm hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                    Retour à la Rémunération
                </a>
            </div>
        </main>
    </div>
</div>
{% endblock %}
