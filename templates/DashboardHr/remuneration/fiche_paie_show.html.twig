{% extends 'base.html.twig' %}

{% block title %}Fiche de Paie - {{ fiche.mois }}/{{ fiche.annee }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 px-4 py-3 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2 animate-slide-up">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 space-y-6 max-w-7xl mx-auto">

            {# Header #}
            <div class="flex items-center justify-between animate-slide-up">
                <div>
                    <h1 class="text-3xl font-extrabold text-zinc-900 dark:text-white">
                        Fiche de Paie — {{ fiche.mois }}/{{ fiche.annee }}
                    </h1>
                    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">{{ fiche.employeeName }}</p>
                </div>
                <div class="flex items-center gap-3">
                    <a href="{{ path('app_rh_payroll_fiche_edit', { id: fiche.id }) }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-blue-50 dark:bg-blue-500/10 text-blue-700 dark:text-blue-400 font-semibold text-sm hover:bg-blue-100 dark:hover:bg-blue-500/20 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                        Éditer
                    </a>
                    <a href="{{ path('app_rh_remuneration_index') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-medium hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                        Retour
                    </a>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                {# Left column: Summary + Tables #}
                <div class="lg:col-span-2 space-y-6">

                    {# Summary Card #}
                    <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm animate-slide-up">
                        <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/50">
                            <h2 class="text-lg font-semibold text-zinc-900 dark:text-white">Résumé</h2>
                        </div>
                        <div class="p-6 grid grid-cols-2 md:grid-cols-4 gap-6">
                            <div>
                                <p class="text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1">Salaire Brut</p>
                                <p class="text-xl font-bold text-zinc-900 dark:text-white font-mono">{{ fiche.salaireBrut }} DT</p>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1">Total Primes</p>
                                <p class="text-xl font-bold text-emerald-600 dark:text-emerald-400 font-mono">+{{ fiche.totalPrimes }} DT</p>
                            </div>
                            <div>
                                <p class="text-xs uppercase tracking-wider text-zinc-500 dark:text-zinc-400 mb-1">Total Déductions</p>
                                <p class="text-xl font-bold text-red-600 dark:text-red-400 font-mono">-{{ fiche.totalDeductions }} DT</p>
                            </div>
                            <div class="bg-teal-50 dark:bg-teal-500/10 rounded-lg p-3 -m-1">
                                <p class="text-xs uppercase tracking-wider text-teal-600 dark:text-teal-400 mb-1">Salaire Net</p>
                                <p class="text-2xl font-extrabold text-teal-700 dark:text-teal-300 font-mono">{{ fiche.salaireNet }} DT</p>
                            </div>
                        </div>
                    </div>

                    {# Primes Table #}
                    <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm overflow-hidden animate-slide-up">
                        <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/50 flex items-center justify-between">
                            <h2 class="text-lg font-semibold text-zinc-900 dark:text-white">Primes</h2>
                            <span class="text-sm text-zinc-500 dark:text-zinc-400">{{ primes|length }} prime(s)</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-zinc-100 dark:border-zinc-800/50 bg-zinc-50 dark:bg-zinc-800/50">
                                        <th class="px-6 py-3 text-left text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Type</th>
                                        <th class="px-6 py-3 text-right text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Montant</th>
                                        <th class="px-6 py-3 text-left text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Motif</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/50">
                                    {% if primes|length > 0 %}
                                        {% for prime in primes %}
                                        <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/30 transition-colors">
                                            <td class="px-6 py-3 text-sm text-zinc-900 dark:text-zinc-100">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 dark:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300">
                                                    {{ prime.typePrime.value }}
                                                </span>
                                            </td>
                                            <td class="px-6 py-3 text-right text-sm font-mono font-semibold text-emerald-600 dark:text-emerald-400">+{{ prime.montant }} DT</td>
                                            <td class="px-6 py-3 text-sm text-zinc-600 dark:text-zinc-400">{{ prime.motif ?? '—' }}</td>
                                        </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="px-6 py-8 text-center text-sm text-zinc-400 dark:text-zinc-500">Aucune prime enregistrée</td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {# Deductions Table #}
                    <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm overflow-hidden animate-slide-up">
                        <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/50 flex items-center justify-between">
                            <h2 class="text-lg font-semibold text-zinc-900 dark:text-white">Déductions</h2>
                            <span class="text-sm text-zinc-500 dark:text-zinc-400">{{ deductions|length }} déduction(s)</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-zinc-100 dark:border-zinc-800/50 bg-zinc-50 dark:bg-zinc-800/50">
                                        <th class="px-6 py-3 text-left text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Type</th>
                                        <th class="px-6 py-3 text-right text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Montant</th>
                                        <th class="px-6 py-3 text-left text-xs font-bold text-zinc-700 dark:text-zinc-400 uppercase tracking-wider">Motif</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/50">
                                    {% if deductions|length > 0 %}
                                        {% for deduction in deductions %}
                                        <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/30 transition-colors">
                                            <td class="px-6 py-3 text-sm text-zinc-900 dark:text-zinc-100">
                                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 dark:bg-red-500/20 text-red-800 dark:text-red-300">
                                                    {{ deduction.typeDeduction.value }}
                                                </span>
                                            </td>
                                            <td class="px-6 py-3 text-right text-sm font-mono font-semibold text-red-600 dark:text-red-400">-{{ deduction.montant }} DT</td>
                                            <td class="px-6 py-3 text-sm text-zinc-600 dark:text-zinc-400">{{ deduction.motif ?? '—' }}</td>
                                        </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr>
                                            <td colspan="3" class="px-6 py-8 text-center text-sm text-zinc-400 dark:text-zinc-500">Aucune déduction enregistrée</td>
                                        </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# Right column: Details #}
                <div>
                    <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 shadow-sm animate-slide-up">
                        <div class="px-6 py-4 border-b border-zinc-100 dark:border-zinc-800/50">
                            <h2 class="text-lg font-semibold text-zinc-900 dark:text-white">Détails</h2>
                        </div>
                        <div class="p-6 space-y-4 text-sm">
                            <div>
                                <p class="text-zinc-500 dark:text-zinc-400">Employé</p>
                                <p class="font-semibold text-zinc-900 dark:text-white">{{ fiche.employeeName }}</p>
                            </div>
                            <div>
                                <p class="text-zinc-500 dark:text-zinc-400">Période</p>
                                <p class="font-semibold text-zinc-900 dark:text-white">{{ fiche.mois }}/{{ fiche.annee }}</p>
                            </div>
                            <div>
                                <p class="text-zinc-500 dark:text-zinc-400">Créée le</p>
                                <p class="font-semibold text-zinc-900 dark:text-white">{{ fiche.createdAt|date('d/m/Y H:i') }}</p>
                            </div>
                            <div>
                                <p class="text-zinc-500 dark:text-zinc-400">Dernière modification</p>
                                <p class="font-semibold text-zinc-900 dark:text-white">{{ fiche.updatedAt|date('d/m/Y H:i') }}</p>
                            </div>
                            {% if fiche.notes %}
                            <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800">
                                <p class="text-zinc-500 dark:text-zinc-400 mb-2">Notes</p>
                                <p class="text-zinc-700 dark:text-zinc-300 whitespace-pre-line">{{ fiche.notes }}</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

            </div>

        </main>
    </div>
</div>
{% endblock %}
