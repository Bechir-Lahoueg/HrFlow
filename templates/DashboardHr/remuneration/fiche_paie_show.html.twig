{% extends 'base.html.twig' %}

{% block title %}Fiche de Paie - {{ fiche.mois }}/{{ fiche.annee }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 mt-4 flex items-center gap-3 px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-sm font-medium animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 lg:p-8 space-y-6 max-w-[1440px] mx-auto">

            {# HERO BANNER #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-teal-950 to-sky-900 text-white p-8 animate-slide-up">
                <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-teal-400/15 blur-3xl"></div>
                <div class="absolute -right-12 -top-12 h-48 w-48 rounded-full bg-sky-300/15 blur-3xl"></div>
                <div class="absolute left-1/2 top-0 h-40 w-40 rounded-full bg-teal-500/10 blur-3xl"></div>
                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-teal-200 uppercase tracking-[0.15em]">Fiche de Paie</span>
                        </div>
                        <h1 class="text-2xl sm:text-3xl font-display leading-[1.1] tracking-tight">{{ fiche.mois }}/{{ fiche.annee }}</h1>
                        <p class="text-slate-300/80 text-[13px] mt-1">{{ fiche.employeeName }}</p>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('app_rh_payroll_fiche_edit', { id: fiche.id }) }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold text-sm backdrop-blur-sm border border-white/20 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            Éditer
                        </a>
                        <a href="{{ path('app_rh_remuneration_index') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-medium text-sm backdrop-blur-sm border border-white/20 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                            Retour
                        </a>
                    </div>
                </div>
            </section>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                {# Left column: Summary + Tables #}
                <div class="lg:col-span-2 space-y-5">

                    {# Summary Stats #}
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 animate-slide-up stagger-1">
                        <div class="card-surface stat-stripe stat-stripe-teal p-5 group">
                            <p class="text-[11px] text-zinc-400 font-semibold uppercase tracking-[0.08em] mb-2">Salaire Brut</p>
                            <p class="text-2xl font-extrabold font-mono-num leading-none text-zinc-900 dark:text-white">{{ fiche.salaireBrut }}<span class="text-base font-semibold text-zinc-400 ml-1">DT</span></p>
                        </div>
                        <div class="card-surface stat-stripe stat-stripe-emerald p-5 group">
                            <p class="text-[11px] text-zinc-400 font-semibold uppercase tracking-[0.08em] mb-2">Total Primes</p>
                            <p class="text-2xl font-extrabold font-mono-num leading-none text-emerald-600 dark:text-emerald-400">+{{ fiche.totalPrimes }}<span class="text-base font-semibold text-zinc-400 ml-1">DT</span></p>
                        </div>
                        <div class="card-surface stat-stripe stat-stripe-rose p-5 group">
                            <p class="text-[11px] text-zinc-400 font-semibold uppercase tracking-[0.08em] mb-2">Total Déductions</p>
                            <p class="text-2xl font-extrabold font-mono-num leading-none text-rose-600 dark:text-rose-400">-{{ fiche.totalDeductions }}<span class="text-base font-semibold text-zinc-400 ml-1">DT</span></p>
                        </div>
                        <div class="card-surface stat-stripe stat-stripe-sky p-5 group bg-teal-50/50 dark:bg-teal-500/5">
                            <p class="text-[11px] text-teal-500 font-bold uppercase tracking-[0.08em] mb-2">Salaire Net</p>
                            <p class="text-2xl font-extrabold font-mono-num leading-none text-teal-700 dark:text-teal-300">{{ fiche.salaireNet }}<span class="text-base font-semibold text-teal-400 ml-1">DT</span></p>
                        </div>
                    </div>

                    {# Primes Table #}
                    <div class="card-surface stat-stripe stat-stripe-emerald overflow-hidden animate-slide-up stagger-2">
                        <div class="px-5 py-4 border-b border-zinc-100 dark:border-zinc-800/50 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
                                <span class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.15em]">Primes</span>
                            </div>
                            <span class="text-xs text-zinc-400 bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 rounded-full font-semibold">{{ primes|length }}</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-zinc-100 dark:border-zinc-800/50 bg-zinc-50/60 dark:bg-zinc-800/30">
                                        <th class="px-5 py-3 text-left text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Type</th>
                                        <th class="px-5 py-3 text-right text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Montant</th>
                                        <th class="px-5 py-3 text-left text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Motif</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/50">
                                    {% if primes|length > 0 %}
                                        {% for prime in primes %}
                                        <tr class="row-refined">
                                            <td class="px-5 py-3 text-sm">
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400">
                                                    {{ prime.typePrime.value }}
                                                </span>
                                            </td>
                                            <td class="px-5 py-3 text-right text-sm font-mono-num font-semibold text-emerald-600 dark:text-emerald-400">+{{ prime.montant }} DT</td>
                                            <td class="px-5 py-3 text-sm text-zinc-500 dark:text-zinc-400">{{ prime.motif ?? '—' }}</td>
                                        </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr><td colspan="3" class="px-5 py-8 text-center text-xs text-zinc-400">Aucune prime enregistrée</td></tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    {# Deductions Table #}
                    <div class="card-surface stat-stripe stat-stripe-rose overflow-hidden animate-slide-up stagger-3">
                        <div class="px-5 py-4 border-b border-zinc-100 dark:border-zinc-800/50 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="w-2 h-2 rounded-full bg-rose-400"></div>
                                <span class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.15em]">Déductions</span>
                            </div>
                            <span class="text-xs text-zinc-400 bg-zinc-100 dark:bg-zinc-800 px-2 py-0.5 rounded-full font-semibold">{{ deductions|length }}</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-zinc-100 dark:border-zinc-800/50 bg-zinc-50/60 dark:bg-zinc-800/30">
                                        <th class="px-5 py-3 text-left text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Type</th>
                                        <th class="px-5 py-3 text-right text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Montant</th>
                                        <th class="px-5 py-3 text-left text-[11px] font-bold text-zinc-500 uppercase tracking-[0.08em]">Motif</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-zinc-100 dark:divide-zinc-800/50">
                                    {% if deductions|length > 0 %}
                                        {% for deduction in deductions %}
                                        <tr class="row-refined">
                                            <td class="px-5 py-3 text-sm">
                                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-rose-50 dark:bg-rose-500/10 text-rose-700 dark:text-rose-400">
                                                    {{ deduction.typeDeduction.value }}
                                                </span>
                                            </td>
                                            <td class="px-5 py-3 text-right text-sm font-mono-num font-semibold text-rose-600 dark:text-rose-400">-{{ deduction.montant }} DT</td>
                                            <td class="px-5 py-3 text-sm text-zinc-500 dark:text-zinc-400">{{ deduction.motif ?? '—' }}</td>
                                        </tr>
                                        {% endfor %}
                                    {% else %}
                                        <tr><td colspan="3" class="px-5 py-8 text-center text-xs text-zinc-400">Aucune déduction enregistrée</td></tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                {# Right column: Details #}
                <div>
                    <div class="card-surface stat-stripe stat-stripe-sky p-5 space-y-4 animate-slide-up stagger-1 sticky top-24">
                        <div class="flex items-center gap-2 mb-2">
                            <div class="w-2 h-2 rounded-full bg-sky-400"></div>
                            <span class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.15em]">Détails</span>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.08em] mb-1">Employé</p>
                            <p class="text-sm font-semibold text-zinc-900 dark:text-white">{{ fiche.employeeName }}</p>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.08em] mb-1">Période</p>
                            <p class="text-sm font-semibold font-mono-num text-zinc-900 dark:text-white">{{ fiche.mois }}/{{ fiche.annee }}</p>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.08em] mb-1">Créée le</p>
                            <p class="text-sm font-semibold text-zinc-900 dark:text-white">{{ fiche.createdAt|date('d/m/Y H:i') }}</p>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.08em] mb-1">Dernière modification</p>
                            <p class="text-sm font-semibold text-zinc-900 dark:text-white">{{ fiche.updatedAt|date('d/m/Y H:i') }}</p>
                        </div>
                        {% if fiche.notes %}
                        <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/50">
                            <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.08em] mb-2">Notes</p>
                            <p class="text-sm text-zinc-600 dark:text-zinc-300 whitespace-pre-line leading-relaxed">{{ fiche.notes }}</p>
                        </div>
                        {% endif %}
                    </div>
                </div>

            </div>

        </main>
    </div>
</div>
{% endblock %}
