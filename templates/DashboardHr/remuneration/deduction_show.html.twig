{% extends 'base.html.twig' %}

{% block title %}Détails de la Déduction{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 lg:p-8 space-y-6 max-w-5xl mx-auto">

            {# HERO BANNER #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-orange-950 to-amber-900 text-white p-8 animate-slide-up">
                <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-orange-400/15 blur-3xl"></div>
                <div class="absolute -right-12 -top-12 h-48 w-48 rounded-full bg-amber-300/15 blur-3xl"></div>
                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-amber-200 uppercase tracking-[0.15em]">Détail Déduction</span>
                        </div>
                        <h1 class="text-2xl sm:text-3xl font-display leading-[1.1] tracking-tight">{{ deduction.typeDeduction.value }}</h1>
                        <p class="text-slate-300/80 text-[13px] mt-1">{{ deduction.employeeName }} &bull; {{ deduction.dateDeduction|date('d/m/Y') }}</p>
                    </div>
                    <div class="text-right">
                        <p class="text-[11px] font-bold text-amber-300 uppercase tracking-[0.12em] mb-1">Montant</p>
                        <p class="text-4xl font-extrabold font-mono-num text-rose-300">-{{ deduction.montant }} DT</p>
                    </div>
                </div>
            </section>

            {# Content Grid #}
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {# Main Info #}
                <div class="lg:col-span-2 space-y-4">
                    {# Employee Card #}
                    <div class="card-surface stat-stripe stat-stripe-amber p-6 animate-slide-up stagger-1">
                        <div class="flex items-center gap-2 mb-4">
                            <div class="w-2 h-2 rounded-full bg-amber-400"></div>
                            <span class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.15em]">Employé</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-400 to-amber-500 flex items-center justify-center text-white font-bold text-lg">
                                {{ deduction.employeeName|first|upper }}
                            </div>
                            <div>
                                <p class="text-base font-semibold text-zinc-900 dark:text-white">{{ deduction.employeeName }}</p>
                                <p class="text-xs text-zinc-500 dark:text-zinc-400">ID: {{ deduction.employeeId }}</p>
                            </div>
                        </div>
                    </div>

                    {# Deduction Details Card #}
                    <div class="card-surface stat-stripe stat-stripe-orange p-6 animate-slide-up stagger-2">
                        <div class="flex items-center gap-2 mb-4">
                            <div class="w-2 h-2 rounded-full bg-orange-400"></div>
                            <span class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.15em]">Informations</span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.08em] mb-1">Type de Déduction</p>
                                <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-sm font-semibold bg-rose-50 dark:bg-rose-500/10 text-rose-700 dark:text-rose-400">
                                    {{ deduction.typeDeduction.value }}
                                </span>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.08em] mb-1">Montant</p>
                                <p class="text-2xl font-extrabold text-rose-600 dark:text-rose-400 font-mono-num">-{{ deduction.montant }} DT</p>
                            </div>
                            <div>
                                <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.08em] mb-1">Date d'Application</p>
                                <p class="text-sm font-semibold text-zinc-900 dark:text-white">{{ deduction.dateDeduction|date('d/m/Y') }}</p>
                            </div>
                            {% if deduction.motif %}
                            <div class="sm:col-span-2">
                                <p class="text-[11px] font-bold text-zinc-400 uppercase tracking-[0.08em] mb-2">Motif</p>
                                <p class="text-sm text-zinc-700 dark:text-zinc-300 p-3 bg-zinc-50 dark:bg-zinc-800/50 rounded-xl border border-zinc-100 dark:border-zinc-800/50">{{ deduction.motif }}</p>
                            </div>
                            {% endif %}
                        </div>
                    </div>

                    {# Timestamps #}
                    <div class="px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-800/30 text-xs text-zinc-400 flex flex-wrap gap-x-6 gap-y-1">
                        <span>Créée le : <strong class="text-zinc-600 dark:text-zinc-300">{{ deduction.createdAt ? deduction.createdAt|date('d/m/Y H:i') : 'N/A' }}</strong></span>
                        {% if deduction.updatedAt %}
                            <span>Modifiée le : <strong class="text-zinc-600 dark:text-zinc-300">{{ deduction.updatedAt|date('d/m/Y H:i') }}</strong></span>
                        {% endif %}
                    </div>
                </div>

                {# Sidebar Actions #}
                <div class="lg:col-span-1">
                    <div class="card-surface p-5 space-y-3 animate-slide-up stagger-3 sticky top-24">
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-sky-400"></div>
                            <span class="text-[11px] font-bold text-zinc-500 uppercase tracking-[0.15em]">Actions</span>
                        </div>
                        <a href="{{ path('app_rh_payroll_deduction_edit', { id: deduction.id }) }}" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-sky-50 dark:bg-sky-500/10 text-sky-700 dark:text-sky-400 hover:bg-sky-100 dark:hover:bg-sky-500/20 font-semibold text-sm transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                            Modifier
                        </a>
                        <form method="POST" action="{{ path('app_rh_payroll_deduction_delete', { id: deduction.id }) }}" onsubmit="return confirm('Supprimer cette déduction ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_deduction_' ~ deduction.id) }}">
                            <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-rose-50 dark:bg-rose-500/10 text-rose-700 dark:text-rose-400 hover:bg-rose-100 dark:hover:bg-rose-500/20 font-semibold text-sm transition-colors">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                Supprimer
                            </button>
                        </form>
                        <a href="{{ path('app_rh_payroll_deductions') }}" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800 font-medium text-sm transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                            Retour à la liste
                        </a>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
