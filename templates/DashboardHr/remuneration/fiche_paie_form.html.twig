{% extends 'base.html.twig' %}
{% set fiche = fiche|default(null) %}

{% block title %}{% if fiche %}Éditer{% else %}Créer{% endif %} Fiche de Paie{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 lg:p-8 space-y-6 max-w-4xl mx-auto">

            {# HERO BANNER #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-teal-950 to-sky-900 text-white p-8 animate-slide-up">
                <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-teal-400/15 blur-3xl"></div>
                <div class="absolute -right-12 -top-12 h-48 w-48 rounded-full bg-sky-300/15 blur-3xl"></div>
                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-teal-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-teal-200 uppercase tracking-[0.15em]">Rémunération</span>
                        </div>
                        <h1 class="text-2xl sm:text-3xl font-display leading-[1.1] tracking-tight">
                            {% if fiche %}Éditer{% else %}Créer{% endif %} une Fiche de Paie
                        </h1>
                        <p class="text-slate-300/80 text-[13px] mt-1">
                            {% if fiche %}Modifiez les détails de cette fiche{% else %}Créez une nouvelle fiche de paie{% endif %}
                        </p>
                    </div>
                    <a href="{{ path('app_rh_remuneration_index') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-medium text-sm backdrop-blur-sm border border-white/20 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                        Retour
                    </a>
                </div>
            </section>

            {# Form #}
            <form method="POST" class="card-surface stat-stripe stat-stripe-teal p-6 space-y-6 animate-slide-up stagger-1">

                {# Flash messages #}
                {% for message in app.flashes('error') %}
                    <div class="px-4 py-3 rounded-lg bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-400 text-sm font-medium flex items-start gap-3">
                        <svg class="w-5 h-5 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
                        {{ message }}
                    </div>
                {% endfor %}
                {% for message in app.flashes('warning') %}
                    <div class="px-4 py-3 rounded-lg bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/30 text-amber-700 dark:text-amber-400 text-sm font-medium flex items-start gap-3">
                        <svg class="w-5 h-5 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/></svg>
                        {{ message }}
                    </div>
                {% endfor %}

                {# Employé & Période #}
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                    <div class="md:col-span-2">
                        <label class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">Employé</label>
                        {% if fiche %}
                            <div class="px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white">
                                {{ fiche.employeeName }}
                            </div>
                        {% else %}
                            <select id="employee_id" name="employee_id" class="w-full px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent" required>
                                <option value="">-- Sélectionner un employé --</option>
                                {% for emp in employees %}
                                    <option value="{{ emp.id }}">{{ emp.firstName }} {{ emp.lastName }}</option>
                                {% endfor %}
                            </select>
                        {% endif %}
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">Mois</label>
                        {% if fiche %}
                            {% set monthNames = {1:'Janvier',2:'Février',3:'Mars',4:'Avril',5:'Mai',6:'Juin',7:'Juillet',8:'Août',9:'Septembre',10:'Octobre',11:'Novembre',12:'Décembre'} %}
                            <div class="px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white">
                                {{ monthNames[fiche.mois] }}
                            </div>
                        {% else %}
                            <select id="mois" name="mois" class="w-full px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent" required>
                                {% for m in 1..12 %}
                                    <option value="{{ m }}">{{ m }}</option>
                                {% endfor %}
                            </select>
                        {% endif %}
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">Année</label>
                        {% if fiche %}
                            <div class="px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white">
                                {{ fiche.annee }}
                            </div>
                        {% else %}
                            <input type="number" id="annee" name="annee" class="w-full px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent" min="2020" max="2100" required value="{{ 'now'|date('Y') }}">
                        {% endif %}
                    </div>
                </div>

                {# Salaire Brut #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">Salaire Brut (TND)</label>
                        {% if fiche %}
                            <div class="px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white font-mono">
                                {{ fiche.salaireBrut }} DT
                            </div>
                        {% else %}
                            <div class="relative">
                                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400">DT</span>
                                <input type="number" id="salaire_brut" name="salaire_brut" class="w-full pl-10 pr-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent" step="0.01" min="0" required value="">
                            </div>
                        {% endif %}
                    </div>
                </div>

                {# Notes #}
                <div>
                    <label for="notes" class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">
                        Notes
                    </label>
                    <textarea id="notes" name="notes" rows="3" class="w-full px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent resize-none" placeholder="Notes ou remarques...">{{ fiche.notes ?? '' }}</textarea>
                </div>

                {# Info box #}
                <div class="px-4 py-3 rounded-lg bg-teal-50 dark:bg-teal-500/10 border border-teal-200 dark:border-teal-500/30 text-teal-700 dark:text-teal-400 text-sm">
                    <strong>Note :</strong> Les totaux des primes et déductions seront calculés automatiquement à partir des primes et déductions enregistrées pour cet employé sur la période sélectionnée.
                </div>

                {# CSRF Token - correct for both create and edit #}
                <input type="hidden" name="_token" value="{{ csrf_token(fiche ? 'edit_fiche_paie_' ~ fiche.id : 'create_fiche_paie') }}">

                {# Actions #}
                <div class="flex items-center gap-3 pt-4 border-t border-zinc-100 dark:border-zinc-800">
                    <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold text-sm transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        {% if fiche %}Mettre à jour{% else %}Créer{% endif %}
                    </button>
                    <a href="{{ path('app_rh_remuneration_index') }}" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-semibold text-sm hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                        Annuler
                    </a>
                </div>
            </form>

        </main>
    </div>
</div>
{% endblock %}
