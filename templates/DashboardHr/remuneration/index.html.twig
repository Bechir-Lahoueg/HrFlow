{% extends 'base.html.twig' %}

{% block title %}Rémunération - Gestion RH{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Payroll module color palette */
        :root {
            --payroll-primary-deep: #022E69;
            --payroll-primary: #145EB7;
            --payroll-accent: #3FA9F5;
            --payroll-border: #D0D0D0;
        }

        /* High contrast mode support */
        html.a11y-high-contrast {
            --payroll-primary-deep: #022E69;
            --payroll-primary: #145EB7;
            --payroll-accent: #3FA9F5;
            --payroll-border: #3FA9F5;
        }

        /* Page container background */
        #payroll-page-container {
            background-color: #f4f7fb !important;
        }

        /* Dark mode support */
        @media (prefers-color-scheme: dark) {
            #payroll-page-container {
                background-color: #18181b !important;
            }
        }

        /* Hero banner */
        .hero-banner-payroll {
            background: linear-gradient(to bottom right, #022E69, #0a3d8f, #051f3d) !important;
        }
    </style>
{% endblock %}

{% block body %}
<div id="payroll-page-container" class="min-h-screen dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 lg:p-8 space-y-6 max-w-7xl mx-auto">

            {# HERO BANNER #}
            <section class="hero-banner-payroll relative overflow-hidden rounded-2xl text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full blur-3xl mesh-blob" style="background: radial-gradient(circle, rgba(63, 169, 245, 0.15), transparent 70%);"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full blur-3xl mesh-blob-alt" style="background: radial-gradient(circle, rgba(20, 94, 183, 0.15), transparent 70%);"></div>
                <div class="relative z-10">
                    <div class="flex items-center gap-2 mb-3">
                        <div class="w-2 h-2 rounded-full animate-pulse" style="background-color: #3FA9F5;"></div>
                        <span class="text-[11px] font-bold uppercase tracking-wider" style="color: #3FA9F5;">Gestion Rémunération</span>
                    </div>
                    <h1 class="text-3xl md:text-4xl font-extrabold leading-tight">Rémunération & Paie</h1>
                    <p class="mt-3 text-[15px] text-slate-300 max-w-xl leading-relaxed">
                        Gérez les fiches de paie, primes et déductions pour vos employés en toute simplicité.
                    </p>
                </div>
            </section>

            {# ═══════════════ Statistics Grid ═══════════════ #}
            {% if stats %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 animate-slide-up">
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-1">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg flex items-center justify-center" style="background-color: rgba(20, 94, 183, 0.1);">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3.75-9.75a6 6 0 000 11.25M2.25 9.75a9 9 0 0119.5 0"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ stats.totalSalaireBrut }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Masse Salariale Brute</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-full rounded-full" style="background: linear-gradient(90deg, #145EB7, #3FA9F5);"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-2">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-emerald-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 font-mono-num">{{ stats.totalPrimes }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Total Primes</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-full rounded-full bg-gradient-to-r from-emerald-500 to-teal-400"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-3">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-amber-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12H4.5"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-amber-600 dark:text-amber-400 font-mono-num">{{ stats.totalDeductions }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Total Déductions</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-1/3 rounded-full bg-gradient-to-r from-amber-500 to-orange-400"></div></div>
                </div>
                <div class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover animate-slide-up stagger-4">
                    <div class="flex items-center justify-between mb-3">
                        <div class="w-10 h-10 rounded-lg bg-sky-50 flex items-center justify-center">
                            <svg class="w-5 h-5 text-sky-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108"/></svg>
                        </div>
                    </div>
                    <p class="text-3xl font-extrabold text-zinc-900 dark:text-zinc-100 font-mono-num">{{ stats.fichesPaieCount }}</p>
                    <p class="text-[13px] text-zinc-400 mt-1 font-medium">Fiches de Paie</p>
                    <div class="mt-3 h-1 rounded-full bg-zinc-100 overflow-hidden"><div class="h-full w-2/3 rounded-full bg-gradient-to-r from-sky-500 to-cyan-400"></div></div>
                </div>
            </div>
            {% endif %}

            {# Employees Section #}
            <section class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-6 shadow-sm animate-slide-up stagger-5">
                <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 mb-5">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg flex items-center justify-center" style="background-color: rgba(20, 94, 183, 0.1);">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color: #145EB7;"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 001.591-.68m7.08-7.071A9 9 0 1011.71 5.725m7.078 7.071L11.71 5.725"/></svg>
                        </div>
                        <h3 class="text-[15px] font-bold text-zinc-800 dark:text-zinc-200">Employés</h3>
                    </div>
                    <div class="flex gap-2">
                        <a href="{{ path('app_rh_payroll_prime_create') }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-white text-sm font-bold transition-all shadow-sm" style="background: linear-gradient(135deg, #145EB7, #3FA9F5);">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                            Prime
                        </a>
                        <a href="{{ path('app_rh_payroll_deduction_create') }}" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-white text-sm font-bold transition-all shadow-sm" style="background: linear-gradient(135deg, #145EB7, #3FA9F5);">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"></path></svg>
                            Déduction
                        </a>
                    </div>
                </div>

                {# Search Bar #}
                <div class="flex justify-end mb-6 bg-zinc-50/50 dark:bg-zinc-800/20 rounded-xl p-3 border border-zinc-100 dark:border-zinc-800/50">
                    <form method="GET" class="w-full md:w-auto">
                        <div class="relative">
                            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-zinc-400" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.5 5.5a7.5 7.5 0 0010.5 10.5z"/></svg>
                            <input type="text" name="search" class="w-full pl-10 pr-4 py-1.5 rounded-lg border-zinc-200 bg-white text-sm focus:border-[#145EB7] focus:ring-1 focus:ring-[#145EB7] shadow-sm" placeholder="Rechercher un employé..." value="{{ search }}">
                        </div>
                    </form>
                </div>

                {# Employees Table #}
                <div class="overflow-x-auto rounded-xl border" style="border-color: #D0D0D0;">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-left text-[11px] font-bold uppercase tracking-wider text-[#022E69] border-b" style="border-color: #D0D0D0; background: #edf4ff;">
                                <th class="py-3 px-4">Employé</th>
                                <th class="py-3 px-4">Email</th>
                                <th class="py-3 px-4">Poste</th>
                                <th class="py-3 px-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if employees|length > 0 %}
                                {% for employee in employees %}
                                <tr class="border-b align-middle hover:bg-blue-50/40 transition-colors" style="border-color: #eef2f8;">
                                    <td class="py-3 px-4">
                                        <div class="flex items-center gap-2.5">
                                            <div class="w-9 h-9 rounded-xl flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #022E69, #145EB7);">
                                                <span class="text-[11px] font-bold text-white">{{ employee.firstName|first|upper }}{{ employee.lastName|first|upper }}</span>
                                            </div>
                                            <div>
                                                <p class="text-[13px] font-semibold text-[#022E69]">{{ employee.firstName }} {{ employee.lastName }}</p>
                                                <p class="text-[11px] text-zinc-500">#{{ employee.id }}</p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 px-4">
                                        <p class="text-[13px] text-zinc-600 dark:text-zinc-400">{{ employee.email }}</p>
                                    </td>
                                    <td class="py-3 px-4">
                                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold" style="background-color: rgba(20, 94, 183, 0.1); color: #145EB7;">
                                            {{ employee.poste ?? '-' }}
                                        </span>
                                    </td>
                                    <td class="py-3 px-4">
                                        <a href="{{ path('app_rh_remuneration_employee_detail', { employeeId: employee.id }) }}" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-white text-xs font-bold transition-colors" style="background-color: #145EB7;">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                                            Détails
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="4" class="py-12 px-4 text-center">
                                        <p class="text-sm text-zinc-500 dark:text-zinc-400 font-medium">Aucun employé trouvé</p>
                                    </td>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>

                {# Pagination #}
                {% if totalPages > 1 %}
                <div class="flex items-center justify-center gap-2 mt-6">
                    {% if page > 1 %}
                        <a href="?page=1" class="px-3 py-2 rounded-lg border text-[13px] font-medium" style="border-color: #D0D0D0; color: #022E69;">Première</a>
                        <a href="?page={{ page - 1 }}" class="px-3 py-2 rounded-lg border text-[13px] font-medium" style="border-color: #D0D0D0; color: #022E69;">Précédente</a>
                    {% endif %}

                    {% for p in 1..totalPages %}
                        {% if p == page %}
                            <button class="px-3 py-2 rounded-lg text-white text-[13px] font-medium" style="background-color: #145EB7;">{{ p }}</button>
                        {% else %}
                            <a href="?page={{ p }}" class="px-3 py-2 rounded-lg border text-[13px] font-medium" style="border-color: #D0D0D0; color: #022E69;">{{ p }}</a>
                        {% endif %}
                    {% endfor %}

                    {% if page < totalPages %}
                        <a href="?page={{ page + 1 }}" class="px-3 py-2 rounded-lg border text-[13px] font-medium" style="border-color: #D0D0D0; color: #022E69;">Suivante</a>
                        <a href="?page={{ totalPages }}" class="px-3 py-2 rounded-lg border text-[13px] font-medium" style="border-color: #D0D0D0; color: #022E69;">Dernière</a>
                    {% endif %}
                </div>
                {% endif %}
            </section>

            {# Quick Links #}
            <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 animate-slide-up stagger-6">
                <a href="{{ path('app_rh_remuneration_index') }}" class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover cursor-pointer transition-all hover:ring-2 hover:ring-[#3FA9F5]/20">
                    <div class="flex items-start justify-between gap-2">
                        <div class="w-11 h-11 rounded-full flex items-center justify-center shrink-0" style="background: linear-gradient(135deg, #145EB7, #3FA9F5);">
                            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108"/></svg>
                        </div>
                    </div>
                    <h3 class="mt-4 text-[15px] font-bold text-[#022E69]">Fiches de Paie</h3>
                    <p class="mt-1 text-[13px] text-zinc-500">Voir toutes les fiches globales</p>
                </a>

                <a href="{{ path('app_rh_payroll_primes') }}" class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover cursor-pointer transition-all hover:ring-2 hover:ring-emerald-500/20">
                    <div class="flex items-start justify-between gap-2">
                        <div class="w-11 h-11 rounded-full flex items-center justify-center shrink-0 bg-emerald-50">
                            <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                        </div>
                    </div>
                    <h3 class="mt-4 text-[15px] font-bold text-[#022E69]">Gérer Primes</h3>
                    <p class="mt-1 text-[13px] text-zinc-500">Ajouter et modifier les primes</p>
                </a>

                <a href="{{ path('app_rh_payroll_deductions') }}" class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover cursor-pointer transition-all hover:ring-2 hover:ring-amber-500/20">
                    <div class="flex items-start justify-between gap-2">
                        <div class="w-11 h-11 rounded-full flex items-center justify-center shrink-0 bg-amber-50">
                            <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12H4.5M12 4.5v15"/></svg>
                        </div>
                    </div>
                    <h3 class="mt-4 text-[15px] font-bold text-[#022E69]">Gérer Déductions</h3>
                    <p class="mt-1 text-[13px] text-zinc-500">Ajouter et modifier les déductions</p>
                </a>

                <a href="{{ path('app_rh_payroll_salary_advance_index') }}" class="bg-white dark:bg-zinc-900 rounded-xl border border-zinc-100 dark:border-zinc-800/50 p-5 shadow-sm card-hover cursor-pointer transition-all hover:ring-2 hover:ring-orange-500/20">
                    <div class="flex items-start justify-between gap-2">
                        <div class="w-11 h-11 rounded-full flex items-center justify-center shrink-0 bg-orange-50">
                            <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m-7.5-7.5h15"/></svg>
                        </div>
                    </div>
                    <h3 class="mt-4 text-[15px] font-bold text-[#022E69]">Avances sur salaire</h3>
                    <p class="mt-1 text-[13px] text-zinc-500">Suivre et gérer les avances</p>
                </a>
            </section>

        </main>
    </div>
</div>
{% endblock %}
