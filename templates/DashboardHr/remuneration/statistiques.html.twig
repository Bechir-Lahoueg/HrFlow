{% extends 'base.html.twig' %}

{% block title %}Statistiques Rémunération{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        {# Flash messages #}
        {% for message in app.flashes('success') %}
            <div class="mx-6 lg:mx-8 mt-4 px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/30 text-emerald-700 dark:text-emerald-400 text-sm font-medium flex items-center gap-2.5 animate-slide-up">
                <div class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-500/20 flex items-center justify-center shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                {{ message }}
            </div>
        {% endfor %}

        <main class="p-6 lg:p-8 space-y-6 max-w-[1440px] mx-auto">

            {# HERO BANNER #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-indigo-950 to-violet-900 text-white p-8 md:p-10 animate-slide-up">
                <div class="absolute -left-16 bottom-0 h-56 w-56 rounded-full bg-indigo-400/15 blur-3xl"></div>
                <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-violet-300/15 blur-3xl"></div>
                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-indigo-200 uppercase tracking-[0.15em]">Analytics</span>
                        </div>
                        <h1 class="text-3xl sm:text-4xl font-display leading-[1.1] tracking-tight">Statistiques Rémunération</h1>
                        <p class="text-slate-300/90 max-w-lg text-[14px] leading-relaxed">Vue d'ensemble de la masse salariale, primes et déductions pour {{ annee }}.</p>
                    </div>
                    {# Year selector #}
                    <form method="get" action="{{ path('app_rh_payroll_stats') }}" class="self-start sm:self-auto flex items-center gap-2">
                        <select name="annee" onchange="this.form.submit()" class="rounded-xl bg-white/10 border border-white/20 text-white text-sm px-3 py-2 focus:ring-2 focus:ring-indigo-400 backdrop-blur-sm">
                            {% for y in (annee - 2)..(annee + 1) %}
                                <option value="{{ y }}" {{ y == annee ? 'selected' : '' }} class="text-gray-900">{{ y }}</option>
                            {% endfor %}
                        </select>
                    </form>
                </div>
            </section>

            {# KPI CARDS #}
            <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 animate-slide-up stagger-1">
                {# Total Brut #}
                <div class="card-surface rounded-2xl p-5 stat-stripe stat-stripe-blue">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Masse Salariale Brute</span>
                        <div class="w-8 h-8 rounded-lg bg-blue-50 dark:bg-blue-500/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        </div>
                    </div>
                    <p class="text-2xl font-display font-bold text-slate-800 dark:text-zinc-100 font-mono-num">{{ stats.totalSalaireBrut|number_format(2, '.', ' ') }} <span class="text-sm font-normal text-slate-400">DT</span></p>
                </div>

                {# Total Primes #}
                <div class="card-surface rounded-2xl p-5 stat-stripe stat-stripe-emerald">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Total Primes</span>
                        <div class="w-8 h-8 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                        </div>
                    </div>
                    <p class="text-2xl font-display font-bold text-slate-800 dark:text-zinc-100 font-mono-num">{{ stats.totalPrimes|number_format(2, '.', ' ') }} <span class="text-sm font-normal text-slate-400">DT</span></p>
                </div>

                {# Total Déductions #}
                <div class="card-surface rounded-2xl p-5 stat-stripe stat-stripe-rose">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Total Déductions</span>
                        <div class="w-8 h-8 rounded-lg bg-rose-50 dark:bg-rose-500/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12h-15"/></svg>
                        </div>
                    </div>
                    <p class="text-2xl font-display font-bold text-slate-800 dark:text-zinc-100 font-mono-num">{{ stats.totalDeductions|number_format(2, '.', ' ') }} <span class="text-sm font-normal text-slate-400">DT</span></p>
                </div>

                {# Total Net #}
                <div class="card-surface rounded-2xl p-5 stat-stripe stat-stripe-violet">
                    <div class="flex items-center justify-between mb-3">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-zinc-500">Masse Salariale Nette</span>
                        <div class="w-8 h-8 rounded-lg bg-violet-50 dark:bg-violet-500/10 flex items-center justify-center">
                            <svg class="w-4 h-4 text-violet-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/></svg>
                        </div>
                    </div>
                    <p class="text-2xl font-display font-bold text-slate-800 dark:text-zinc-100 font-mono-num">{{ stats.totalSalaireNet|number_format(2, '.', ' ') }} <span class="text-sm font-normal text-slate-400">DT</span></p>
                </div>
            </section>

            {# CHARTS ROW #}
            <section class="grid grid-cols-1 xl:grid-cols-2 gap-6 animate-slide-up stagger-2">
                {# Masse salariale evolution (Line) #}
                <div class="card-surface rounded-2xl p-6">
                    <h2 class="text-lg font-display font-bold text-slate-800 dark:text-zinc-100 mb-4">Évolution de la masse salariale</h2>
                    <div style="position:relative;height:320px">
                        <canvas id="hrEvolutionChart"></canvas>
                    </div>
                </div>

                {# Primes vs Déductions (Bar) #}
                <div class="card-surface rounded-2xl p-6">
                    <h2 class="text-lg font-display font-bold text-slate-800 dark:text-zinc-100 mb-4">Primes vs Déductions</h2>
                    <div style="position:relative;height:320px">
                        <canvas id="hrPrimesChart"></canvas>
                    </div>
                </div>
            </section>

            {# DOUGHNUT + HIGH DEDUCTION ALERTS #}
            <section class="grid grid-cols-1 xl:grid-cols-3 gap-6 animate-slide-up stagger-3">
                {# Répartition Doughnut #}
                <div class="card-surface rounded-2xl p-6">
                    <h2 class="text-lg font-display font-bold text-slate-800 dark:text-zinc-100 mb-4">Répartition globale</h2>
                    <div style="position:relative;height:280px">
                        {% set totalBrut = stats.totalSalaireBrut|default('0')|number_format(0, '.', '') %}
                        {% set totalPrimesVal = stats.totalPrimes|default('0')|number_format(0, '.', '') %}
                        {% set totalDeductionsVal = stats.totalDeductions|default('0')|number_format(0, '.', '') %}
                        <canvas id="hrDoughnutChart"></canvas>
                    </div>
                </div>

                {# High deduction employees — Jitsi suggestion #}
                <div class="xl:col-span-2 card-surface rounded-2xl p-6">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="text-lg font-display font-bold text-slate-800 dark:text-zinc-100">Employés à suivre</h2>
                        <span class="text-xs font-medium text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-500/10 px-2.5 py-1 rounded-full">≥ 3 déductions / 3 mois</span>
                    </div>

                    {% if highDeductionEmployees|length == 0 %}
                        <div class="text-center py-10">
                            <div class="w-14 h-14 rounded-2xl bg-emerald-50 dark:bg-emerald-500/10 flex items-center justify-center mx-auto mb-3">
                                <svg class="w-7 h-7 text-emerald-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </div>
                            <p class="text-sm text-slate-400 dark:text-zinc-500">Aucun employé avec un nombre élevé de déductions.</p>
                        </div>
                    {% else %}
                        <div class="space-y-3">
                            {% for item in highDeductionEmployees %}
                                <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50 dark:bg-zinc-800/50 border border-slate-100 dark:border-zinc-700/50">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-500/10 flex items-center justify-center">
                                            <span class="text-sm font-bold text-amber-600 dark:text-amber-400">{{ item.employee.firstName|first }}{{ item.employee.lastName|first }}</span>
                                        </div>
                                        <div>
                                            <p class="text-sm font-semibold text-slate-700 dark:text-zinc-200">{{ item.employee.fullName }}</p>
                                            <p class="text-xs text-slate-400 dark:text-zinc-500">{{ item.deductionCount }} déductions récentes</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <a href="{{ path('app_rh_remuneration_employee_detail', {employeeId: item.employee.id}) }}" class="text-xs font-medium text-indigo-600 dark:text-indigo-400 hover:underline">Détails</a>
                                        <a href="https://meet.jit.si/hrflow-{{ item.employee.id }}-{{ 'now'|date('Ymd') }}" target="_blank" rel="noopener"
                                           class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-500 hover:bg-indigo-600 text-white text-xs font-semibold transition-colors">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z"/></svg>
                                            Jitsi Meet
                                        </a>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </section>

            {# BACK LINK #}
            <div class="animate-slide-up stagger-4">
                <a href="{{ path('app_rh_remuneration_index') }}" class="inline-flex items-center gap-2 text-sm font-medium text-slate-500 dark:text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
                    Retour à la rémunération
                </a>
            </div>

        </main>
    </div>
</div>
<script type="module">
    import { Chart, registerables } from 'chart.js';
    Chart.register(...registerables);
    const opts = {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, padding: 16 } } },
        scales: { y: { beginAtZero: true } },
    };
    new Chart(document.getElementById('hrEvolutionChart'), {
        type: 'line',
        data: {{ { labels: monthLabels, datasets: [
            { label: "Brut", data: brutData, borderColor: "#3b82f6", backgroundColor: "rgba(59,130,246,0.08)", fill: true, tension: 0.35 },
            { label: "Net",  data: netData,  borderColor: "#8b5cf6", backgroundColor: "rgba(139,92,246,0.08)", fill: true, tension: 0.35 }
        ]}|json_encode|raw }},
        options: opts,
    });
    new Chart(document.getElementById('hrPrimesChart'), {
        type: 'bar',
        data: {{ { labels: monthLabels, datasets: [
            { label: "Primes",     data: primesData,     backgroundColor: "#10b981", borderRadius: 6 },
            { label: "Déductions", data: deductionsData, backgroundColor: "#f43f5e", borderRadius: 6 }
        ]}|json_encode|raw }},
        options: opts,
    });
    new Chart(document.getElementById('hrDoughnutChart'), {
        type: 'doughnut',
        data: {{ { labels: ["Salaire Brut","Primes","Déductions"], datasets: [{
            data: [stats.totalSalaireBrut|default(0), stats.totalPrimes|default(0), stats.totalDeductions|default(0)],
            backgroundColor: ["#3b82f6","#10b981","#f43f5e"],
            borderWidth: 0,
            hoverOffset: 8
        }]}|json_encode|raw }},
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } },
    });
</script>
{% endblock %}
