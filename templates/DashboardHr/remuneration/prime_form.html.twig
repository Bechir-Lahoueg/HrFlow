{% extends 'base.html.twig' %}{% set prime = prime|default(null) %}
{% block title %}{% if prime is defined and prime %}Éditer{% else %}Créer{% endif %} Prime{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950 dot-grid">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="lg:ml-[272px] transition-all duration-300">
        {% include 'DashboardHr/components/_header.html.twig' %}

        <main class="p-6 lg:p-8 space-y-6 max-w-4xl mx-auto">

            {# HERO BANNER #}
            <section class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-emerald-950 to-teal-900 text-white p-8 animate-slide-up">
                <div class="absolute -left-12 bottom-0 h-48 w-48 rounded-full bg-emerald-400/15 blur-3xl"></div>
                <div class="absolute -right-12 -top-12 h-48 w-48 rounded-full bg-teal-300/15 blur-3xl"></div>
                <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
                            <span class="text-[11px] font-bold text-emerald-200 uppercase tracking-[0.15em]">Rémunération</span>
                        </div>
                        <h1 class="text-2xl sm:text-3xl font-display leading-[1.1] tracking-tight">
                            {% if prime is defined and prime %}Éditer{% else %}Ajouter{% endif %} une Prime
                        </h1>
                        <p class="text-slate-300/80 text-[13px] mt-1">
                            {% if prime is defined and prime %}Modifiez les détails de cette prime{% else %}Créez une nouvelle prime d'employé{% endif %}
                        </p>
                    </div>
                    <a href="{{ path('app_rh_payroll_primes') }}" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white font-medium text-sm backdrop-blur-sm border border-white/20 transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                        Retour
                    </a>
                </div>
            </section>

            {# Form #}
            <form method="POST" class="card-surface stat-stripe stat-stripe-emerald p-6 space-y-6 animate-slide-up stagger-1">
                
                {# Flash messages #}
                {% for message in app.flashes('error') %}
                    <div class="px-4 py-3 rounded-lg bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-400 text-sm font-medium flex items-start gap-3">
                        <svg class="w-5 h-5 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
                        {{ message }}
                    </div>
                {% endfor %}

                {# Section: Employee & Type #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {# Employé #}
                    {% if preSelectedEmployeeId or isEditing %}
                        <div>
                            <label class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">
                                Employé
                            </label>
                            <div class="px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white">
                                {% if isEditing and prime %}
                                    {{ prime.employeeId }}
                                {% else %}
                                    {% for emp in employees %}
                                        {% if emp.id == preSelectedEmployeeId %}
                                            {{ emp.firstName }} {{ emp.lastName }}
                                        {% endif %}
                                    {% endfor %}
                                {% endif %}
                            </div>
                            <input type="hidden" name="employee_id" value="{% if isEditing and prime %}{{ prime.employeeId }}{% else %}{{ preSelectedEmployeeId }}{% endif %}">
                        </div>
                    {% else %}
                        <div>
                            <label for="employee_id" class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">
                                Employé <span class="text-red-500">*</span>
                            </label>
                            <select id="employee_id" name="employee_id" class="w-full px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent" required>
                                <option value="">-- Sélectionner un employé --</option>
                                {% for emp in employees %}
                                    <option value="{{ emp.id }}" {% if prime is defined and prime and prime.employeeId == emp.id %}selected{% endif %}>
                                        {{ emp.firstName }} {{ emp.lastName }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}

                    {# Type Prime #}
                    <div>
                        <label for="type_prime" class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">
                            Type {% if not isEditing %}<span class="text-red-500">*</span>{% endif %}
                        </label>
                        {% if isEditing %}
                            <div class="px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white">
                                {{ prime.typePrime.value }}
                            </div>
                            <input type="hidden" name="type_prime" value="{{ prime.typePrime.value }}">
                        {% else %}
                            <select id="type_prime" name="type_prime" class="w-full px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent" required>
                                <option value="">-- Sélectionner un type --</option>
                                {% for value, label in typeChoices %}
                                    <option value="{{ value }}" {% if prime is defined and prime and prime.typePrime.value == value %}selected{% endif %}>
                                        {{ value }}
                                    </option>
                                {% endfor %}
                            </select>
                        {% endif %}
                    </div>
                </div>

                {# Section: Amount & Date #}
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    {# Montant #}
                    <div>
                        <label for="montant" class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">
                            Montant (TND) {% if not isEditing %}<span class="text-red-500">*</span>{% endif %}
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-400">DT</span>
                            {% if isEditing %}
                                <div class="pl-8 pr-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white">
                                    {{ prime.montant }}
                                </div>
                                <input type="hidden" name="montant" value="{{ prime.montant }}">
                            {% else %}
                                <input type="number" id="montant" name="montant" class="w-full pl-8 pr-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent" step="0.01" min="0" required value="{% if prime is defined and prime %}{{ prime.montant }}{% endif %}">
                            {% endif %}
                        </div>
                        {# Validation error message #}
                        <div id="montant_error" class="mt-2 px-3 py-2 rounded-lg bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/30 text-red-700 dark:text-red-400 text-sm font-medium hidden items-start gap-2">
                            <svg class="w-4 h-4 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/></svg>
                            <span id="montant_error_text"></span>
                        </div>
                    </div>

                    {# Date Attribution #}
                    <div>
                        <label for="date_attribution" class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">
                            Date d'Attribution {% if not isEditing %}<span class="text-red-500">*</span>{% endif %}
                        </label>
                        {% if isEditing %}
                            <div class="px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-zinc-900 dark:text-white">
                                {{ prime.dateAttribution ? prime.dateAttribution|date('Y-m-d') : 'N/A' }}
                            </div>
                            <input type="hidden" name="date_attribution" value="{% if prime and prime.dateAttribution %}{{ prime.dateAttribution|date('Y-m-d') }}{% endif %}">
                        {% else %}
                            <input type="date" id="date_attribution" name="date_attribution" class="w-full px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent" required value="{% if prime is defined and prime and prime.dateAttribution %}{{ prime.dateAttribution|date('Y-m-d') }}{% endif %}">
                        {% endif %}
                    </div>
                </div>

                {# Motif #}
                <div>
                    <label for="motif" class="block text-sm font-semibold text-zinc-900 dark:text-white mb-2">
                        Motif
                    </label>
                    <textarea id="motif" name="motif" rows="4" class="w-full px-4 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent resize-none" placeholder="Raison ou justification de la prime...">{% if prime is defined and prime %}{{ prime.motif }}{% endif %}</textarea>
                </div>

                {# CSRF Token #}
                <input type="hidden" name="_token" value="{% if prime is defined and prime %}{{ csrf_token('edit_prime_' ~ prime.id) }}{% else %}{{ csrf_token('create_prime') }}{% endif %}">

                {# Actions #}
                <div class="flex items-center gap-3 pt-4 border-t border-zinc-100 dark:border-zinc-800">
                    <button type="submit" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        {% if prime is defined and prime %}Mettre à jour{% else %}Créer{% endif %}
                    </button>
                    <a href="{{ path('app_rh_payroll_primes') }}" class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-semibold text-sm hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                        Annuler
                    </a>
                </div>
            </form>

        </main>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const typePrimeSelect = document.getElementById('type_prime');
    const montantInputElement = document.getElementById('montant');
    const montantError = document.getElementById('montant_error');
    const montantErrorText = document.getElementById('montant_error_text');
    const form = document.querySelector('form');

    let validationRules = {};
    let rulesLoaded = false;
    let isEditing = false;

    // Check if montant field is an input (create mode) or div (edit mode)
    const isMontantEditable = montantInputElement && montantInputElement.tagName === 'INPUT';

    if (!typePrimeSelect || !montantError) return;

    // Fetch validation rules on page load
    async function fetchValidationRules() {
        try {
            const response = await fetch(`/api/compensation-validations`);
            if (!response.ok) {
                console.error('Failed to fetch validation rules');
                return;
            }
            
            const data = await response.json();
            validationRules = data.primes || {};
            rulesLoaded = true;
            console.log('Validation rules loaded:', validationRules);
        } catch (error) {
            console.error('Error fetching validation rules:', error);
        }
    }

    // Validate montant against rules (only in create mode)
    function validateMontant() {
        if (!isMontantEditable || isEditing) return true;

        const typeName = typePrimeSelect.value;
        const montant = parseFloat(montantInputElement.value);

        // Clear error state first
        montantInputElement.classList.remove('border-red-500');
        montantError.classList.add('hidden');
        montantError.classList.remove('flex');

        if (!typeName) {
            return true; // No type selected
        }

        // Wait for rules to load before validating
        if (!rulesLoaded || !validationRules[typeName]) {
            console.log('Rules not loaded yet or type not found:', typeName);
            return true; // Skip validation if rules not loaded
        }

        // If montant is empty or not a number, skip validation
        if (isNaN(montant) || montant === '') {
            return true;
        }

        const rules = validationRules[typeName];
        const min = parseFloat(rules.min);
        const max = parseFloat(rules.max);

        console.log(`Validating ${typeName}: ${montant} against range ${min}-${max}`);

        // Skip validation for types with no limits (max = 0)
        if (max === 0) {
            console.log('No limit for this type');
            return true;
        }

        // Validate range
        if (montant < min || montant > max) {
            montantInputElement.classList.add('border-red-500');
            montantErrorText.textContent = `${typeName} doit être entre ${min} DT et ${max} DT.`;
            montantError.classList.remove('hidden');
            montantError.classList.add('flex');
            console.log('Validation failed - showing error');
            return false;
        }

        console.log('Validation passed');
        return true;
    }

    // Auto-populate montant and rules when type changes (only in create mode)
    if (typePrimeSelect && isMontantEditable) {
        typePrimeSelect.addEventListener('change', async function() {
            const typeName = this.value;
            console.log('Type changed to:', typeName);
            
            if (!typeName) {
                montantInputElement.value = '';
                return;
            }

            try {
                const response = await fetch(`/api/prime-default/${encodeURIComponent(typeName)}`);
                if (!response.ok) return;
                
                const data = await response.json();
                console.log('Default data:', data);
                if (data.montant > 0) {
                    montantInputElement.value = data.montant;
                    montantInputElement.focus();
                    // Validate after auto-populate
                    validateMontant();
                }
            } catch (error) {
                console.error('Error fetching default montant:', error);
            }
        });

        // Validate on montant input events
        montantInputElement.addEventListener('blur', validateMontant);
        montantInputElement.addEventListener('input', validateMontant);
        montantInputElement.addEventListener('change', validateMontant);
    }

    // Prevent form submission if validation fails
    form.addEventListener('submit', function(e) {
        if (isMontantEditable && !validateMontant()) {
            e.preventDefault();
            montantInputElement.focus();
        }
    });

    // Initialize - fetch rules first
    fetchValidationRules();

    // If creating and type is already selected, populate montant on load after rules loaded
    if (isMontantEditable && typePrimeSelect.value) {
        isEditing = false;
        setTimeout(() => {
            const event = new Event('change');
            typePrimeSelect.dispatchEvent(event);
        }, 500); // Wait 500ms for rules to load
    } else if (isMontantEditable && montantInputElement.value) {
        // Validate on load if montant already has a value
        setTimeout(validateMontant, 500);
    } else if (!isMontantEditable) {
        // We're in edit mode
        isEditing = true;
    }
});
</script>
{% endblock %}
