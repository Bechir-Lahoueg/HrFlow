                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/>
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-[15px]" style="color:var(--ink)">HrFlow AI</span>
                        <span class="ai-badge">Agentic</span>
                    </div>
                    <div class="status-live">Recruitment Intelligence</div>
                </div>
            </div>
            <div class="topbar-actions">
                <div class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[.72rem] font-medium" style="background:var(--violet-soft);color:#5b21b6">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z"/></svg>
                    Gemini 2.5 Flash
                </div>
                <button class="icon-btn" title="Session memory" id="memBtn">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776"/></svg>
                </button>
                <button class="icon-btn" title="Export conversation" id="exportBtn">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
                </button>
                <button class="icon-btn" title="Nouvelle conversation" id="clearBtn">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"/></svg>
                </button>
            </div>
        </header>

        <main class="chat-main" id="chatMain">
            <div class="messages-scroll" id="messagesScroll">
                <div class="welcome-state" id="welcomeState">
                    <div class="welcome-orb">
                        <svg class="w-9 h-9 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/>
                        </svg>
                    </div>
                    <div>
                        <div class="welcome-title">Bonjour, {{ app.user.firstName|default('Responsable RH') }}</div>
                        <div class="welcome-sub mt-1">Je suis votre assistant recrutement intelligent. Posez-moi une question ou choisissez une action rapide.</div>
                    </div>
                    <div class="welcome-chips" id="welcomeChips">
                        <button class="welcome-chip" data-prompt="Classe les meilleurs candidats pour mon offre active">Classer les candidats</button>
                        <button class="welcome-chip" data-prompt="Donne-moi les stats du pipeline de recrutement">Stats du pipeline</button>
                        <button class="welcome-chip" data-prompt="Planifie des entretiens pour la semaine prochaine">Planifier des entretiens</button>
                        <button class="welcome-chip" data-prompt="Génère un rapport d'insights pour mes offres">Générer un rapport</button>
                        <button class="welcome-chip" data-prompt="Quels candidats sont en attente de décision ?">Candidats en attente</button>
                        <button class="welcome-chip" data-prompt="Exporte la liste des offres en PDF">Exporter en PDF</button>
                    </div>
                </div>
                <div id="messagesList" class="pb-4" style="display:none"></div>
                <div class="typing-row" id="typingIndicator" style="display:none">
                    <div class="msg-avatar bot">AI</div>
                    <div class="typing-bubble"><span></span><span></span><span></span></div>
                </div>
            </div>

            <div class="composer-wrap">
                <div class="quick-wrap" id="quickChips">
                    <button class="quick-chip" data-prompt="Montre-moi les interviews de cette semaine">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5"/></svg>
                        Interviews cette semaine
                    </button>
                    <button class="quick-chip" data-prompt="Top 5 candidats par score">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.43 9.71 2.25 12 2.25c2.291 0 4.545.18 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0"/></svg>
                        Top 5 candidats
                    </button>
                    <button class="quick-chip" data-prompt="Génère le rapport de performance RH">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
                        Rapport performance
                    </button>
                </div>

                <div class="composer-box">
                    <textarea id="composerInput" class="composer-input" placeholder="Ex : Planifie des entretiens pour mes 3 meilleurs candidats du Job #42…" rows="1" maxlength="2000"></textarea>
                    <div class="composer-actions">
                        <button class="send-btn" id="sendBtn" disabled title="Envoyer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.269 20.876L5.999 12zm0 0h7.5"/></svg>
                        </button>
                    </div>
                </div>
                <div class="flex items-center justify-between mt-1.5 px-1">
