                    <div class="stat-item">
                        <div class="stat-val" id="statMsgs">0</div>
                        <div class="stat-lbl">Échanges</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-val" id="statCands">—</div>
                        <div class="stat-lbl">Candidats analysés</div>
                    </div>
