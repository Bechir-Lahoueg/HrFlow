                    <span class="text-[.68rem]" style="color:var(--muted-light)" id="charCount">0 / 2000</span>
                </div>
            </div>
        </main>

        <aside class="context-panel" id="contextPanel">
            <div class="panel-section">
                <div class="panel-title">Contexte actif</div>
                <div class="active-job-card" id="activeContextCard">
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <div class="job-title-text" id="activeJobTitle">Aucun contexte</div>
                            <div class="job-meta" id="activeJobMeta">Posez une question pour commencer</div>
                        </div>
                        <span class="pill pill-green" id="activeJobBadge" style="display:none">Actif</span>
                    </div>
                    <div class="flex items-center gap-1.5 mt-2.5 flex-wrap" id="activeJobTags"></div>
