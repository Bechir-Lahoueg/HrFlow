        manage_applications: '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/></svg>',
        manage_interviews: '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z"/></svg>',
        generate_report: '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>',
        export_pdf: '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>',
        generate_chart: '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z"/><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z"/></svg>',
    };

    const state = {
        messages: [], toolCount: 0, msgCount: 0,
        candsAnalyzed: 0, planned: 0, activeContext: null,
        memory: [], isThinking: false,
    };

    const $input   = document.getElementById('composerInput');
    const $sendBtn = document.getElementById('sendBtn');
    const $scroll  = document.getElementById('messagesScroll');
    const $list    = document.getElementById('messagesList');
    const $typing  = document.getElementById('typingIndicator');
    const $welcome = document.getElementById('welcomeState');
    const $charCnt = document.getElementById('charCount');

    const scrollBottom = () => requestAnimationFrame(() => { $scroll.scrollTop = $scroll.scrollHeight; });

    const updateStats = () => {
        document.getElementById('statTools').textContent = state.toolCount;
        document.getElementById('statMsgs').textContent  = state.msgCount;
        document.getElementById('statCands').textContent = state.candsAnalyzed || '—';
        document.getElementById('statPlanned').textContent = state.planned;
    };

    const now = () => new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

    const escHtml = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');

    $input.addEventListener('input', () => {
        $input.style.height = 'auto';
        $input.style.height = Math.min($input.scrollHeight, 160) + 'px';
        $sendBtn.disabled = !$input.value.trim();
        $charCnt.textContent = `${$input.value.length} / 2000`;
    });

    $input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            if (!$sendBtn.disabled && !state.isThinking) sendMessage();
        }
    });

    $sendBtn.addEventListener('click', () => { if (!state.isThinking) sendMessage(); });

    document.querySelectorAll('[data-prompt]').forEach(el => {
        el.addEventListener('click', () => {
            $input.value = el.dataset.prompt;
            $input.dispatchEvent(new Event('input'));
            sendMessage();
        });
    });

    function showWelcome(show) {
        $welcome.style.display = show ? 'flex' : 'none';
        $list.style.display    = show ? 'none' : 'block';
    }

    function appendMsg(role, content, toolCards = null, planSteps = null) {
        showWelcome(false);
        state.msgCount++;
        updateStats();

        const row = document.createElement('div');
        row.className = `msg-row ${role}`;

        const avatar = document.createElement('div');
        avatar.className = `msg-avatar ${role}`;
        avatar.textContent = role === 'bot' ? 'AI' : ('{{ app.user.firstName|default("R") }}'.charAt(0).toUpperCase() || 'R');

        const col = document.createElement('div');

        if (planSteps && planSteps.length) {
            const strip = document.createElement('div');
            strip.className = 'plan-strip';
            strip.innerHTML = `<svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg> <span style="font-weight:700;margin-right:.25rem;">Plan :</span>`;
            planSteps.forEach((step, i) => {
                if (i > 0) strip.innerHTML += `<span class="plan-arrow">\u2192</span>`;
                strip.innerHTML += `<span class="plan-step ${step.status}">${step.label}</span>`;
            });
            col.appendChild(strip);
        }

        if (content || (toolCards && toolCards.length)) {
            const bubble = document.createElement('div');
            bubble.className = `msg-bubble ${role}`;

            if (toolCards && toolCards.length) {
                toolCards.forEach(tc => { bubble.appendChild(buildToolCard(tc)); });
            }

            if (content) {
                const p = document.createElement('div');
                p.innerHTML = marked.parse(content);
                bubble.appendChild(p);
            }

            if (toolCards) {
                toolCards.forEach(tc => {
                    if (tc.status === 'done') {
                        if (tc.download_url) {
                            bubble.appendChild(buildDownloadLink(tc.download_url, tc.file_name || tc.export_type || 'PDF'));
                        }
                        const chartCc = tc.chart_config || tc.chart_data;
                        if (chartCc) {
                            bubble.appendChild(buildChartBubble(chartCc));
                        }
                    }
                });
            }

            col.appendChild(bubble);
        }

        const ts = document.createElement('div');
        ts.className = 'msg-ts';
        ts.textContent = now();
        col.appendChild(ts);

        row.appendChild(avatar);
        row.appendChild(col);
        $list.appendChild(row);
        scrollBottom();
    }

    function getToolDisplayName(name) {
        return toolLabels[name] || name.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
    }

    function getToolIcon(name) {
        return toolIcons[name] || '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z"/></svg>';
    }

    function buildToolCard(tc) {
        state.toolCount++;
        updateStats();

        const card = document.createElement('div');
        card.className = `tool-card ${tc.open ? 'open' : ''}`;
        const statusClass = tc.status === 'error' ? 'error' : tc.status === 'running' ? 'running' : 'done';
        const statusLabel = tc.status === 'error' ? 'Erreur' : tc.status === 'running' ? 'En cours\u2026' : 'Termin\u00e9';
        const displayName = getToolDisplayName(tc.name);
        const iconSvg = getToolIcon(tc.name);

        card.innerHTML = `
            <div class="tool-header" onclick="this.closest('.tool-card').classList.toggle('open')">
                ${iconSvg}
                <span class="tool-label">${displayName}</span>
                <span class="tool-status ${statusClass}">${statusLabel}</span>
                <svg class="w-3.5 h-3.5 chevron" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
            </div>
            <div class="tool-body">
                ${tc.body || '<span style="color:var(--muted-light);font-style:italic">Aucun d\u00e9tail disponible.</span>'}
            </div>`;
        return card;
    }

    function buildCandGrid(candidates) {
        const wrap = document.createElement('div');
        wrap.className = 'cand-grid';
        candidates.forEach((c, i) => {
            const rank = c.rank || i + 1;
            const score = c.score || 0;
            wrap.innerHTML += `
                <div class="cand-card">
                    <div class="cand-rank">#${rank} \u00b7 Score ${score}%</div>
                    <div class="cand-name">${escHtml(c.name || c.candidate_name || '')}</div>
                    <div class="cand-role">${escHtml(c.role || c.job_title || '\u2014')}</div>
                    <div class="score-bar"><div class="score-fill" style="width:${score}%"></div></div>
                </div>`;
        });
        return wrap;
    }

    function buildPipelineReport(details) {
        const wrap = document.createElement('div');
        wrap.className = 'ai-data-table';
        const pipeline = details.pipeline || {};
        const total = details.total || 0;
        const statusLabels = {
            PENDING: 'En attente', REVIEWING: 'En r\u00e9vision', INTERVIEW: 'Entretien',
            OFFER: 'Offre', HIRED: 'Recrut\u00e9', REJECTED: 'Refus\u00e9',
        };
        const statusColors = {
            PENDING: '#f59e0b', REVIEWING: '#3b82f6', INTERVIEW: '#8b5cf6',
            OFFER: '#10b981', HIRED: '#059669', REJECTED: '#ef4444',
        };
        const order = ['PENDING', 'REVIEWING', 'INTERVIEW', 'OFFER', 'HIRED', 'REJECTED'];
        let statsHtml = '';
        for (const status of order) {
            if (!(status in pipeline)) continue;
            const count = pipeline[status];
            if (count === 0 && status !== 'PENDING') continue;
            const pct = total > 0 ? ((count / total) * 100).toFixed(1) : '0.0';
            const color = statusColors[status] || '#64748b';
            const label = statusLabels[status] || status;
            statsHtml += `<div class="stat-item" style="border-left:3px solid ${color}">
                <div class="stat-val" style="color:${color}">${count}</div>
                <div class="stat-lbl">${label} (${pct}%)</div>
            </div>`;
        }
        wrap.innerHTML = `
            <div class="ai-data-table-title">Pipeline de recrutement</div>
            <div style="padding:1rem;">
                <div style="font-size:.78rem;color:var(--muted);margin-bottom:.75rem;">Total: <strong style="color:var(--ink)">${total}</strong> candidature(s)</div>
                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:.5rem;">${statsHtml}</div>
            </div>`;
        return wrap;
    }

    function buildInterviewScheduled(details) {
        const wrap = document.createElement('div');
        wrap.className = 'ai-data-table';
        wrap.innerHTML = `
            <div class="ai-data-table-title" style="display:flex;align-items:center;gap:.5rem;">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                Entretien planifi\u00e9
            </div>
            <div style="padding:1rem;">
                <div style="display:grid;grid-template-columns:auto 1fr;gap:.375rem 1rem;font-size:.8rem;">
                    <span style="color:var(--muted);font-weight:600;">Candidat:</span>
                    <span style="color:var(--ink);font-weight:600;">${escHtml(details.candidate_name || 'N/A')}</span>
                    <span style="color:var(--muted);font-weight:600;">Type:</span>
                    <span style="color:var(--ink);">${escHtml(details.type || 'N/A')}</span>
                    <span style="color:var(--muted);font-weight:600;">Date:</span>
                    <span style="color:var(--ink);">${escHtml(details.date || 'N/A')}</span>
                    <span style="color:var(--muted);font-weight:600;">Dur\u00e9e:</span>
                    <span style="color:var(--ink);">${details.duration || 60} min</span>
                </div>
            </div>`;
        return wrap;
    }

    function buildStageMove(details) {
        const wrap = document.createElement('div');
        wrap.className = 'ai-data-table';
        const statusColors = {
            PENDING: '#f59e0b', REVIEWING: '#3b82f6', INTERVIEW: '#8b5cf6',
            OFFER: '#10b981', HIRED: '#059669', REJECTED: '#ef4444',
        };
        const statusLabels = {
            PENDING: 'En attente', REVIEWING: 'En r\u00e9vision', INTERVIEW: 'Entretien',
            OFFER: 'Offre', HIRED: 'Recrut\u00e9', REJECTED: 'Refus\u00e9',
        };
        const oldS = details.old_status || 'N/A';
        const newS = details.new_status || 'N/A';
        wrap.innerHTML = `
            <div class="ai-data-table-title" style="display:flex;align-items:center;gap:.5rem;">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 3m0 0l4.5 18M3 3h18m-18 0l4.5 18M21 3l-4.5 18"/></svg>
                Changement de statut
            </div>
            <div style="padding:1rem;">
                <div style="font-size:.8rem;color:var(--ink);font-weight:600;margin-bottom:.5rem;">${escHtml(details.candidate_name || 'N/A')}</div>
                <div style="display:flex;align-items:center;gap:.5rem;">
                    <span style="display:inline-block;padding:.25rem .625rem;border-radius:99px;font-size:.72rem;font-weight:600;color:#fff;background:${statusColors[oldS] || '#64748b'};">${statusLabels[oldS] || oldS}</span>
                    <svg class="w-4 h-4" style="color:var(--muted)" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
                    <span style="display:inline-block;padding:.25rem .625rem;border-radius:99px;font-size:.72rem;font-weight:600;color:#fff;background:${statusColors[newS] || '#64748b'};">${statusLabels[newS] || newS}</span>
                </div>
            </div>`;
        return wrap;
    }

    function buildApplicationsTable(apps) {
        const wrap = document.createElement('div');
        wrap.className = 'data-table-wrap';
        let html = `<table class="data-table"><thead><tr><th>Candidat</th><th>Email</th><th>Offre</th><th>Statut</th><th>Date</th></tr></thead><tbody>`;
        apps.forEach(a => {
            html += `<tr>
                <td><strong>${escHtml(a.candidate_name || '')}</strong></td>
                <td>${escHtml(a.email || '\u2014')}</td>
                <td>${escHtml(a.job_title || '\u2014')}</td>
                <td><span class="status-badge status-${(a.status || '').toLowerCase()}">${escHtml(a.status_label || a.status || '')}</span></td>
                <td>${escHtml(a.applied_at || '\u2014')}</td>
            </tr>`;
        });
        html += '</tbody></table>';
        wrap.innerHTML = html;
        return wrap;
    }

    function buildInterviewsTable(intvs) {
        const wrap = document.createElement('div');
        wrap.className = 'data-table-wrap';
        let html = `<table class="data-table"><thead><tr><th>Candidat</th><th>Offre</th><th>Type</th><th>Date</th><th>R\u00e9sultat</th><th>Score</th></tr></thead><tbody>`;
        intvs.forEach(i => {
            const rc = i.result ? 'status-' + i.result.toLowerCase() : '';
            html += `<tr>
                <td><strong>${escHtml(i.candidate_name || '')}</strong></td>
                <td>${escHtml(i.job_title || '\u2014')}</td>
                <td>${escHtml(i.type || '\u2014')}</td>
                <td>${escHtml(i.interview_date || '\u2014')}</td>
                <td><span class="status-badge ${rc}">${escHtml(i.result || '\u2014')}</span></td>
                <td>${i.score != null ? i.score + '/100' : '\u2014'}</td>
            </tr>`;
        });
        html += '</tbody></table>';
        wrap.innerHTML = html;
        return wrap;
    }

    function buildCandidatesTable(cands) {
        const wrap = document.createElement('div');
        wrap.className = 'data-table-wrap';
        const sc = {PENDING:'#f59e0b',REVIEWING:'#3b82f6',INTERVIEW:'#8b5cf6',OFFER:'#10b981',HIRED:'#059669',REJECTED:'#ef4444'};
        let html = `<table class="data-table"><thead><tr><th>Nom</th><th>Email</th><th>Poste</th><th>Statut</th></tr></thead><tbody>`;
        cands.forEach(c => {
            const name = c.candidate_name || c.full_name || c.name || '';
            const s = c.status || '';
            const c2 = sc[s] || '#64748b';
            html += `<tr>
                <td><strong>${escHtml(name)}</strong></td>
                <td>${escHtml(c.email || '\u2014')}</td>
                <td>${escHtml(c.job_title || c.role || '\u2014')}</td>
                <td><span style="display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;color:#fff;background:${c2}">${escHtml(c.status_label || c.status || '\u2014')}</span></td>
            </tr>`;
        });
        html += '</tbody></table>';
        wrap.innerHTML = html;
        return wrap;
    }

    function buildJobOffersList(offers) {
        const wrap = document.createElement('div');
        wrap.className = 'data-table-wrap';
        let html = `<table class="data-table"><thead><tr><th>Titre</th><th>D\u00e9partement</th><th>Lieu</th><th>Statut</th><th>Type</th></tr></thead><tbody>`;
        offers.forEach(o => {
            html += `<tr>
                <td><strong>${escHtml(o.title || '')}</strong></td>
                <td>${escHtml(o.department || '\u2014')}</td>
                <td>${escHtml(o.location || '\u2014')}</td>
                <td><span class="status-badge status-${(o.status || '').toLowerCase()}">${escHtml(o.status_label || o.status || '')}</span></td>
                <td>${escHtml(o.employment_type || '\u2014')}</td>
            </tr>`;
        });
        html += '</tbody></table>';
        wrap.innerHTML = html;
        return wrap;
    }

    function buildJobOfferCard(details) {
        const wrap = document.createElement('div');
        wrap.className = 'ai-data-table';
        const sc = {DRAFT:'#64748b',OPEN:'#10b981',CLOSED:'#ef4444',ON_HOLD:'#f59e0b'};
        const status = details.status || 'DRAFT';
        let extras = '';
        if (details.department) extras += `<span style="color:var(--muted);font-weight:600;">D\u00e9partement:</span><span style="color:var(--ink)">${escHtml(details.department)}</span>`;
        if (details.location) extras += `<span style="color:var(--muted);font-weight:600;">Lieu:</span><span style="color:var(--ink)">${escHtml(details.location)}</span>`;
        if (details.employment_type) extras += `<span style="color:var(--muted);font-weight:600;">Type:</span><span style="color:var(--ink)">${escHtml(details.employment_type)}</span>`;
        wrap.innerHTML = `
            <div class="ai-data-table-title" style="display:flex;align-items:center;gap:.5rem;">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                ${escHtml(details.title || "Offre d'emploi")}
            </div>
            <div style="padding:1rem;">
                <div style="display:grid;grid-template-columns:auto 1fr;gap:.375rem 1rem;font-size:.8rem;">
                    <span style="color:var(--muted);font-weight:600;">Statut:</span>
                    <span><span style="display:inline-block;padding:.15rem .5rem;border-radius:99px;font-size:.65rem;font-weight:600;color:#fff;background:${sc[status]||'#64748b'}">${status}</span></span>
                    ${extras}
                </div>
            </div>`;
        return wrap;
    }

    function buildChartBubble(chartData) {
        const wrap = document.createElement('div');
        wrap.className = 'animate-slide-up';
        wrap.style = 'background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1rem;margin-top:.75rem;';

        let chartType, title, labels, datasets;
        if (chartData.data && chartData.data.labels) {
            chartType = chartData.type || 'bar';
            title = chartData.title;
            labels = chartData.data.labels;
            datasets = chartData.data.datasets;
        } else {
            chartType = chartData.type || 'bar';
            title = chartData.title;
            labels = chartData.labels;
            datasets = chartData.datasets;
        }

        if (title) {
            const te = document.createElement('div');
            te.style = 'font-size:.875rem;font-weight:600;color:var(--ink);margin-bottom:.75rem;text-align:center;';
            te.textContent = title;
            wrap.appendChild(te);
        }

        const canvas = document.createElement('canvas');
        canvas.style.maxHeight = '280px';
        wrap.appendChild(canvas);

        const defOpts = {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: true, position: 'bottom', labels: { boxWidth: 12, font: { family: 'DM Sans', size: 11 } } } }
        };

        const opts = chartData.options ? Object.assign({}, defOpts, chartData.options) : defOpts;
        if (chartData.options && chartData.options.plugins && chartData.options.plugins.legend) {
            opts.plugins.legend = Object.assign({}, defOpts.plugins.legend, chartData.options.plugins.legend);
        }

        setTimeout(() => {
            new Chart(canvas, { type: chartType, data: { labels, datasets }, options: opts });
        }, 100);

        return wrap;
    }

    function buildDownloadLink(url, label) {
        const a = document.createElement('a');
        a.href = url;
        a.target = '_blank';
        a.className = 'animate-slide-up';
        a.style = 'display:inline-flex;align-items:center;gap:.5rem;padding:.5rem .875rem;background:var(--violet-soft);color:var(--violet);border:1px solid rgba(124,58,237,.2);border-radius:var(--radius-lg);font-size:.8rem;font-weight:600;margin-top:.75rem;text-decoration:none;transition:all .15s;';
        a.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg> T\u00e9l\u00e9charger ' + (label || 'PDF') + ' (PDF)';
        a.onmouseover = () => a.style.background = 'rgba(124,58,237,.15)';
        a.onmouseout  = () => a.style.background = 'var(--violet-soft)';
        return a;
    }

    function showTyping(show) {
        $typing.style.display = show ? 'flex' : 'none';
        if (show) scrollBottom();
    }

    function pushMemory(icon, color, text) {
        state.memory.unshift({ icon, color, text });
        if (state.memory.length > 5) state.memory.pop();
        document.getElementById('memoryList').innerHTML = state.memory.map(m =>
            `<div class="mem-item"><div class="mem-icon ${m.color}">${m.icon}</div><div class="mem-text">${m.text}</div></div>`
        ).join('');
    }

    function updateActiveContext(context) {
        if (!context) return;
        state.activeContext = context;
        document.getElementById('activeJobTitle').textContent = context.title || 'Contexte actif';
        const parts = [];
        if (context.location) parts.push(context.location);
        if (context.type) parts.push(context.type);
        if (context.entity_type) parts.push(context.entity_type);
        document.getElementById('activeJobMeta').textContent = parts.join(' \u00b7 ') || 'Contexte charg\u00e9';
        document.getElementById('activeJobBadge').style.display = 'inline-flex';
        const $tags = document.getElementById('activeJobTags');
        $tags.innerHTML = '';
        if (context.applications !== void 0) {
            $tags.innerHTML += `<span class="pill pill-violet">${context.applications} candidatures</span>`;
        }
        if (context.entity_id) {
            $tags.innerHTML += `<span class="pill pill-green">#${context.entity_id}</span>`;
        }
    }

    async function sendMessage() {
        const text = $input.value.trim();
        if (!text || state.isThinking) return;

        state.isThinking = true;
        $sendBtn.disabled = true;
        appendMsg('user', text);
        $input.value = '';
        $input.style.height = 'auto';
        $charCnt.textContent = '0 / 2000';
        showTyping(true);

        try {
            const payload = { message: text, session_id: getOrCreateSession() };
            const res = await fetch('{{ path("app_rh_ai_chat") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                body: JSON.stringify(payload),
            });

            const raw = await res.text();
            let data = null;
            try { data = JSON.parse(raw); } catch (e) {}
            showTyping(false);

            if (!data) {
                appendMsg('bot', '<span style="color:#be123c">\u26a0\ufe0f Erreur de r\u00e9ponse du serveur. Veuillez r\u00e9essayer.</span>');
                state.isThinking = false;
                $sendBtn.disabled = !$input.value.trim();
                return;
            }

            const toolCards = (data.tool_calls || []).map(t => {
                const d = t.details || {};
                return {
                    name: t.tool_name,
                    status: t.status || 'done',
                    open: false,
                    body: t.details ? formatToolBody(t.details) : null,
                    download_url: t.download_url || d.download_url || d.file_path || null,
                    file_name: t.file_name || d.file_name || null,
                    export_type: t.export_type || d.export_type || null,
                    chart_config: t.chart_config || d.chart_config || null,
                    chart_data: t.chart_data || d.chart_data || null,
                    ui_type: t.ui_type || d.type || null,
                    details: d,
                };
            });

            const planSteps = (data.plan || []).map((step, i) => ({
                label: step,
                status: i < (data.completed_steps || 999) ? 'done' : (i === (data.completed_steps || 999) ? 'active' : 'pending'),
            }));

            if (data.active_context) {
                updateActiveContext(data.active_context);
            } else if (data.active_job) {
                updateActiveContext(data.active_job);
            }

            if (data.candidates_analyzed) {
                state.candsAnalyzed = data.candidates_analyzed;
                pushMemory('\ud83d\udc64', 'teal', `<strong>${data.candidates_analyzed} candidats</strong> analys\u00e9s.`);
            }
            if (data.interviews_planned) {
                state.planned += data.interviews_planned;
                pushMemory('\ud83d\udcc5', 'amber', `<strong>${data.interviews_planned} entretien(s)</strong> planifi\u00e9(s).`);
            }
            if (data.report_type || data.report_generated) {
                pushMemory('\ud83d\udcca', 'violet', `Rapport <strong>${data.report_type || 'Insights'}</strong> g\u00e9n\u00e9r\u00e9.`);
            }
            if (data.export_type) {
                pushMemory('\ud83d\udcc4', 'violet', `Export <strong>${data.export_type}</strong> g\u00e9n\u00e9r\u00e9.`);
            }

            updateStats();

            let htmlContent = data.message || '';

            if (data.validation_error) {
                htmlContent += `<div class="validation-chip">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
                    ${data.validation_error}
                </div>`;
            }

            appendMsg('bot', htmlContent, toolCards, planSteps);

            const lastBubble = () => $list.lastElementChild?.querySelector('.msg-bubble');

            if (data.candidates && data.candidates.length) {
                const lb = lastBubble();
                if (lb) lb.appendChild(buildCandidatesTable(data.candidates));
            }
            if (data.interviews && data.interviews.length) {
                const lb = lastBubble();
                if (lb) lb.appendChild(buildInterviewsTable(data.interviews));
            }

            for (const tc of toolCards) {
                const uiType = tc.ui_type;
                const d = tc.details || {};
                const lb = lastBubble();
                if (!lb) continue;

                if (uiType === 'applications_table' && d.data && d.data.length) {
                    lb.appendChild(buildApplicationsTable(d.data));
                } else if (uiType === 'interviews_table' && d.data && d.data.length) {
                    lb.appendChild(buildInterviewsTable(d.data));
                } else if (uiType === 'candidate_grid' && d.candidates && d.candidates.length) {
                    lb.appendChild(buildCandGrid(d.candidates));
                } else if (uiType === 'pipeline_report' && d.pipeline) {
                    lb.appendChild(buildPipelineReport(d));
                } else if (uiType === 'interview_scheduled') {
                    lb.appendChild(buildInterviewScheduled(d));
                } else if (uiType === 'stage_move') {
                    lb.appendChild(buildStageMove(d));
                } else if (uiType === 'job_offers_list' && d.data && d.data.length) {
                    lb.appendChild(buildJobOffersList(d.data));
                } else if (uiType === 'job_offer_card') {
                    lb.appendChild(buildJobOfferCard(d));
                }
            }

        } catch (err) {
            showTyping(false);
            appendMsg('bot', '<span style="color:#be123c">\u26a0\ufe0f Erreur de connexion. Veuillez r\u00e9essayer.</span>');
        }

        state.isThinking = false;
        $sendBtn.disabled = !$input.value.trim();
    }

    function formatToolBody(details) {
        if (typeof details === 'string') return `<div class="code-block">${escHtml(details)}</div>`;
        const lines = Object.entries(details).map(([k, v]) =>
            `<span class="key">"${escHtml(k)}"</span>: <span class="val">${escHtml(JSON.stringify(v))}</span>`
        ).join(',\n');
        return `<div class="code-block">{\n${lines}\n}</div>`;
    }

    function getOrCreateSession() {
        let id = sessionStorage.getItem('hrflow_ai_session');
        if (!id) {
            id = 'sess_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
            sessionStorage.setItem('hrflow_ai_session', id);
        }
        return id;
    }

    document.getElementById('clearBtn').addEventListener('click', async () => {
        if (!confirm('Effacer cette conversation ?')) return;

        const sessionId = sessionStorage.getItem('hrflow_ai_session');
        if (sessionId) {
            try {
                await fetch('{{ path("app_rh_ai_chat_clear") }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({ session_id: sessionId }),
                });
            } catch (e) {}
        }

        $list.innerHTML = '';
        showWelcome(true);
        state.messages = [];
        state.toolCount = state.msgCount = state.candsAnalyzed = state.planned = 0;
        state.activeContext = null;
        state.memory = [];
        updateStats();
        document.getElementById('memoryList').innerHTML = `
            <div class="mem-item">
                <div class="mem-icon teal">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.354a15.055 15.055 0 01-4.5 0M4.5 9.75a7.5 7.5 0 1115 0c0 4.97-3.375 9-7.5 9s-7.5-4.03-7.5-9z"/></svg>
                </div>
                <div class="mem-text">La m\u00e9moire de session s'affichera ici au fil des \u00e9changes.</div>
            </div>`;
        document.getElementById('activeJobTitle').textContent = 'Aucun contexte';
        document.getElementById('activeJobMeta').textContent  = 'Posez une question pour commencer';
        document.getElementById('activeJobBadge').style.display = 'none';
        document.getElementById('activeJobTags').innerHTML = '';
    });

    document.getElementById('exportBtn').addEventListener('click', () => {
        const lines = Array.from($list.querySelectorAll('.msg-row')).map(row => {
            const role = row.classList.contains('user') ? 'RH' : 'AI';
            const text = row.querySelector('.msg-bubble')?.innerText || '';
            return `[${role}] ${text}`;
        });
        const blob = new Blob([lines.join('\n\n')], { type: 'text/plain' });
        const url  = URL.createObjectURL(blob);
        const a    = document.createElement('a');
        a.href     = url;
        a.download = `hrflow-ai-${Date.now()}.txt`;
        a.click();
        URL.revokeObjectURL(url);
    });

    document.querySelectorAll('.action-btn[data-prompt]').forEach(btn => {
        btn.addEventListener('click', () => {
            $input.value = btn.dataset.prompt;
            $input.dispatchEvent(new Event('input'));
            $input.focus();
        });
    });

    showWelcome(true);
    updateStats();
})();
</script>
{% endblock %}
