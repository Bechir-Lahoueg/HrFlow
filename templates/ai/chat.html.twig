{% extends 'base.html.twig' %}

{% block title %}AI Recruiter | HrFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap');

        :root {
            --chat-bg: #f4f6fa;
            --sidebar-w: 272px;
            --surface: #ffffff;
            --surface-soft: #f8fafc;
            --border: rgba(15,23,42,.07);
            --accent: #14b8a6;
            --accent-dark: #0d9488;
            --accent-soft: #f0fdfa;
            --violet: #7c3aed;
            --violet-soft: #f5f3ff;
            --ink: #0f172a;
            --muted: #64748b;
            --muted-light: #94a3b8;
            --user-bubble: linear-gradient(135deg,#1e293b,#0f172a);
            --bot-bubble: #ffffff;
            --radius-xl: 1.25rem;
            --radius-lg: .875rem;
            --shadow-card: 0 1px 3px rgba(15,23,42,.06),0 4px 16px rgba(15,23,42,.06);
            --shadow-float: 0 8px 32px rgba(15,23,42,.12);
            --glass-bg: rgba(255,255,255,.7);
            --glass-border: rgba(255,255,255,.2);
            --glass-shadow: 0 8px 32px rgba(15,23,42,.08);
        }
        .dark {
            --chat-bg: #09090b;
            --surface: #18181b;
            --surface-soft: #1c1c20;
            --border: rgba(255,255,255,.06);
            --accent-soft: #0d2d29;
            --violet-soft: #1e1b4b;
            --ink: #f1f5f9;
            --muted: #94a3b8;
            --bot-bubble: #1e1e24;
            --shadow-card: 0 1px 3px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.3);
            --glass-bg: rgba(24,24,27,.8);
            --glass-border: rgba(255,255,255,.06);
            --glass-shadow: 0 8px 32px rgba(0,0,0,.3);
        }

        * { font-family: 'DM Sans', sans-serif; box-sizing: border-box; }
        code, pre, .mono { font-family: 'JetBrains Mono', monospace; }

        .chat-shell {
            position: fixed; inset: 0; left: var(--sidebar-w); top: 0; bottom: 0;
            display: grid; grid-template-columns: 1fr 300px; grid-template-rows: 60px 1fr;
            background: var(--chat-bg); overflow: hidden; transition: left .3s;
        }
        @media (max-width: 1024px) { .chat-shell { left: 0; grid-template-columns: 1fr; } }
        @media (max-width: 768px) { .chat-shell { grid-template-columns: 1fr; } .context-panel { display: none; } }

        .chat-topbar {
            grid-column: 1 / -1; display: flex; align-items: center;
            justify-content: space-between; padding: 0 1.25rem;
            background: var(--glass-bg); backdrop-filter: blur(16px) saturate(180%);
            border-bottom: 1px solid var(--border); gap: 1rem;
            -webkit-backdrop-filter: blur(16px) saturate(180%);
        }
        .topbar-brand { display: flex; align-items: center; gap: .75rem; }
        .ai-badge {
            display: inline-flex; align-items: center; gap: .375rem;
            background: linear-gradient(135deg,#14b8a6,#7c3aed); color: #fff;
            font-size: .65rem; font-weight: 700; letter-spacing: .08em;
            text-transform: uppercase; padding: .2rem .6rem; border-radius: 99px;
        }
        .status-live {
            display: inline-flex; align-items: center; gap: .375rem;
            font-size: .75rem; color: var(--muted); font-weight: 500;
        }
        .status-live::before {
            content: ''; width: 7px; height: 7px; border-radius: 50%;
            background: #10b981; box-shadow: 0 0 0 2px #d1fae5;
            animation: pulse-dot 2s infinite;
        }
        @keyframes pulse-dot { 0%,100% { box-shadow: 0 0 0 2px #d1fae5; } 50% { box-shadow: 0 0 0 4px #a7f3d0; } }
        .topbar-actions { display: flex; align-items: center; gap: .375rem; }
        .icon-btn {
            width: 34px; height: 34px; border-radius: .625rem;
            display: flex; align-items: center; justify-content: center;
            color: var(--muted); background: transparent; border: none; cursor: pointer;
            transition: all .15s;
        }
        .icon-btn:hover { background: rgba(15,23,42,.06); color: var(--ink); transform: scale(1.05); }
        .dark .icon-btn:hover { background: rgba(255,255,255,.07); }

        .chat-main { display: flex; flex-direction: column; overflow: hidden; position: relative; }

        .messages-scroll {
            flex: 1; overflow-y: auto; overflow-x: hidden;
            padding: 1.25rem 1.25rem 0; scroll-behavior: smooth;
        }
        .messages-scroll::-webkit-scrollbar { width: 4px; }
        .messages-scroll::-webkit-scrollbar-track { background: transparent; }
        .messages-scroll::-webkit-scrollbar-thumb { background: rgba(15,23,42,.1); border-radius: 4px; }
        .dark .messages-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,.08); }

        .day-sep {
            display: flex; align-items: center; gap: .75rem;
            color: var(--muted-light); font-size: .7rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: .07em; margin: 1.25rem 0;
        }
        .day-sep::before, .day-sep::after {
            content: ''; flex: 1; height: 1px;
            background: linear-gradient(90deg,transparent,var(--border),transparent);
        }

        .msg-row { display: flex; gap: .75rem; margin-bottom: 1rem; animation: msg-in .3s cubic-bezier(.34,1.56,.64,1); }
        .msg-row.user { flex-direction: row-reverse; }
        @keyframes msg-in {
            from { opacity: 0; transform: translateY(10px) scale(.97); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        .msg-avatar {
            width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            font-size: .7rem; font-weight: 700; align-self: flex-end;
            transition: transform .2s;
        }
        .msg-avatar.bot {
            background: linear-gradient(135deg,#14b8a6,#7c3aed); color: #fff;
            box-shadow: 0 2px 8px rgba(20,184,166,.35);
        }
        .msg-avatar.user { background: var(--ink); color: #fff; }
        .msg-avatar:hover { transform: scale(1.1); }

        .msg-bubble {
            max-width: min(520px, 80%);
            padding: .75rem 1rem; border-radius: var(--radius-xl);
            font-size: .875rem; line-height: 1.6; position: relative;
        }
        .msg-bubble.bot {
            background: var(--bot-bubble); color: var(--ink);
            border: 1px solid var(--border); box-shadow: var(--shadow-card);
            border-bottom-left-radius: .375rem;
        }
        .msg-bubble.user {
            background: var(--user-bubble); color: #e2e8f0;
            border-bottom-right-radius: .375rem;
        }
        .msg-bubble.bot p { margin: 0 0 .5em; }
        .msg-bubble.bot p:last-child { margin-bottom: 0; }

        .msg-ts { font-size: .65rem; color: var(--muted-light); margin-top: .25rem; }
        .msg-row.user .msg-ts { text-align: right; }

        .tool-card {
            margin: .5rem 0; background: var(--accent-soft);
            border: 1px solid rgba(20,184,166,.15);
            border-radius: var(--radius-lg); overflow: hidden;
            transition: box-shadow .2s;
        }
        .tool-card:hover { box-shadow: 0 2px 12px rgba(20,184,166,.08); }
        .dark .tool-card { background: rgba(20,184,166,.06); border-color: rgba(20,184,166,.12); }
        .tool-header {
            display: flex; align-items: center; gap: .5rem;
            padding: .5rem .75rem; cursor: pointer;
            font-size: .78rem; font-weight: 600; color: var(--accent-dark);
            user-select: none;
        }
        .tool-header svg { flex-shrink: 0; }
        .tool-header .tool-label { flex: 1; display: flex; align-items: center; gap: .375rem; }
        .tool-header .tool-status {
            font-size: .65rem; font-weight: 700; letter-spacing: .05em;
            text-transform: uppercase; padding: .15rem .5rem; border-radius: 99px;
            white-space: nowrap;
        }
        .tool-status.done { background: #d1fae5; color: #065f46; }
        .tool-status.running { background: #fef3c7; color: #92400e; animation: blink .8s infinite; }
        .tool-status.error { background: #fee2e2; color: #991b1b; }
        @keyframes blink { 0%,100% { opacity:1 } 50% { opacity:.5 } }
        .tool-body {
            display: none; padding: .625rem .75rem;
            border-top: 1px solid rgba(20,184,166,.1);
            font-size: .775rem; color: var(--muted);
            background: rgba(255,255,255,.4);
        }
        .dark .tool-body { background: rgba(0,0,0,.2); }
        .tool-card.open .tool-body { display: block; }
        .tool-card.open .chevron { transform: rotate(180deg); }
        .chevron { transition: transform .25s cubic-bezier(.34,1.56,.64,1); }

        .cand-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(190px,1fr)); gap: .5rem; margin-top: .625rem; }
        .cand-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius-lg); padding: .75rem;
            box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: .25rem;
            transition: transform .15s, box-shadow .15s;
        }
        .cand-card:hover { transform: translateY(-1px); box-shadow: var(--shadow-float); }
        .cand-rank { font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); }
        .cand-name { font-size: .85rem; font-weight: 700; color: var(--ink); }
        .cand-role { font-size: .75rem; color: var(--muted); }
        .score-bar { height: 4px; background: rgba(15,23,42,.08); border-radius: 99px; margin-top: .375rem; overflow: hidden; }
        .score-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg,#14b8a6,#10b981); transition: width .6s ease; }

        .typing-row { display: flex; gap: .75rem; margin-bottom: 1rem; animation: msg-in .2s ease; }
        .typing-bubble {
            padding: .75rem 1rem; background: var(--bot-bubble);
            border: 1px solid var(--border); border-radius: var(--radius-xl);
            border-bottom-left-radius: .375rem;
            display: flex; align-items: center; gap: .35rem; box-shadow: var(--shadow-card);
        }
        .typing-bubble span {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--muted-light); animation: bounce 1s infinite;
        }
        .typing-bubble span:nth-child(2) { animation-delay: .15s; }
        .typing-bubble span:nth-child(3) { animation-delay: .3s; }
        @keyframes bounce { 0%,80%,100% { transform:translateY(0) } 40% { transform:translateY(-5px) } }

        .plan-strip {
            display: flex; align-items: center; gap: .5rem;
            padding: .5rem .75rem; margin-bottom: .5rem;
            background: var(--violet-soft); border: 1px solid rgba(124,58,237,.12);
            border-radius: var(--radius-lg); font-size: .75rem; color: #5b21b6; font-weight: 500;
            overflow-x: auto; white-space: nowrap;
        }
        .plan-step {
            display: inline-flex; align-items: center; gap: .3rem;
            padding: .2rem .55rem; border-radius: 99px;
            font-size: .68rem; font-weight: 600;
        }
        .plan-step.done { background: #d1fae5; color: #065f46; }
        .plan-step.active { background: #fef3c7; color: #92400e; animation: blink .8s infinite; }
        .plan-step.pending { background: rgba(15,23,42,.06); color: var(--muted); }
        .plan-arrow { color: var(--muted-light); font-size: .65rem; }

        .composer-wrap {
            padding: .875rem 1.25rem 1rem;
            border-top: 1px solid var(--border);
            background: var(--glass-bg); backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
        }
        .composer-box {
            display: flex; align-items: flex-end; gap: .625rem;
            background: var(--chat-bg); border: 1.5px solid var(--border);
            border-radius: var(--radius-xl); padding: .5rem .5rem .5rem .875rem;
            transition: border-color .2s, box-shadow .2s;
        }
        .composer-box:focus-within {
            border-color: rgba(20,184,166,.5);
            box-shadow: 0 0 0 3px rgba(20,184,166,.1);
        }
        .composer-input {
            flex: 1; border: none; background: transparent; outline: none;
            resize: none; font-size: .875rem; color: var(--ink);
            line-height: 1.55; max-height: 160px; overflow-y: auto;
            padding: .3rem 0; min-height: 1.55em;
        }
        .composer-input::placeholder { color: var(--muted-light); }
        .composer-actions { display: flex; gap: .25rem; align-items: flex-end; flex-shrink: 0; }
        .send-btn {
            width: 34px; height: 34px; border-radius: .625rem;
            border: none; background: linear-gradient(135deg,#14b8a6,#0d9488);
            color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
            transition: transform .15s, box-shadow .15s, opacity .15s;
            box-shadow: 0 2px 8px rgba(20,184,166,.4);
        }
        .send-btn:hover { transform: scale(1.07); box-shadow: 0 4px 16px rgba(20,184,166,.5); }
        .send-btn:active { transform: scale(.96); }
        .send-btn:disabled { opacity: .4; pointer-events: none; }

        .quick-wrap { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: .625rem; }
        .quick-chip {
            display: inline-flex; align-items: center; gap: .35rem;
            padding: .3rem .7rem; border-radius: 99px; border: 1px solid var(--border);
            background: var(--surface); color: var(--muted); font-size: .75rem;
            cursor: pointer; transition: all .15s; white-space: nowrap;
        }
        .quick-chip:hover {
            border-color: var(--accent); color: var(--accent);
            background: var(--accent-soft); transform: translateY(-1px);
        }

        .context-panel {
            border-left: 1px solid var(--border);
            background: var(--surface); overflow-y: auto;
            display: flex; flex-direction: column;
        }
        .panel-section { padding: 1.125rem 1.125rem; border-bottom: 1px solid var(--border); }
        .panel-title {
            font-size: .65rem; font-weight: 700; letter-spacing: .1em;
            text-transform: uppercase; color: var(--muted); margin-bottom: .75rem;
        }

        .active-job-card {
            background: linear-gradient(135deg,rgba(20,184,166,.08),rgba(124,58,237,.05));
            border: 1px solid rgba(20,184,166,.2);
            border-radius: var(--radius-lg); padding: .875rem;
            transition: box-shadow .2s;
        }
        .active-job-card:hover { box-shadow: var(--shadow-card); }
        .job-title-text { font-size: .875rem; font-weight: 700; color: var(--ink); }
        .job-meta { font-size: .72rem; color: var(--muted); margin-top: .2rem; }
        .pill {
            display: inline-flex; align-items: center; gap: .25rem;
            font-size: .65rem; font-weight: 600; padding: .2rem .55rem; border-radius: 99px;
        }
        .pill-green { background: #d1fae5; color: #065f46; }
        .pill-violet { background: #ede9fe; color: #5b21b6; }

        .mem-item {
            display: flex; align-items: flex-start; gap: .625rem;
            padding: .5rem; border-radius: .625rem; margin-bottom: .375rem;
            transition: background .15s;
        }
        .mem-item:hover { background: rgba(15,23,42,.03); cursor: pointer; }
        .mem-icon {
            width: 28px; height: 28px; border-radius: .5rem; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: .78rem;
        }
        .mem-icon.teal { background: var(--accent-soft); color: var(--accent); }
        .mem-icon.violet { background: var(--violet-soft); color: var(--violet); }
        .mem-icon.amber { background: #fffbeb; color: #d97706; }
        .mem-text { font-size: .78rem; color: var(--muted); line-height: 1.45; }
        .mem-text strong { color: var(--ink); font-weight: 600; }

        .stat-row { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
        .stat-item {
            background: rgba(15,23,42,.03); border-radius: .625rem;
            padding: .625rem; text-align: center;
        }
        .dark .stat-item { background: rgba(255,255,255,.04); }
        .stat-val { font-size: 1.25rem; font-weight: 800; color: var(--ink); }
        .stat-lbl { font-size: .65rem; color: var(--muted); margin-top: .1rem; }

        .action-btn {
            width: 100%; display: flex; align-items: center; gap: .625rem;
            padding: .625rem .75rem; border-radius: .75rem; border: 1px solid var(--border);
            background: transparent; cursor: pointer; text-align: left;
            font-size: .78rem; font-weight: 500; color: var(--muted);
            transition: all .15s; margin-bottom: .375rem;
        }
        .action-btn:hover {
            background: var(--accent-soft); border-color: rgba(20,184,166,.25);
            color: var(--accent-dark); transform: translateX(2px);
        }
        .action-btn-icon {
            width: 26px; height: 26px; border-radius: .5rem; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
        }

        .welcome-state {
            flex: 1; display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 1.25rem; padding: 2rem; text-align: center;
            animation: fade-in .4s ease;
        }
        @keyframes fade-in { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
        .welcome-orb {
            width: 80px; height: 80px; border-radius: 50%;
            background: linear-gradient(135deg,#14b8a6,#7c3aed);
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 0 0 12px rgba(20,184,166,.1), 0 0 0 24px rgba(20,184,166,.05);
            animation: orb-pulse 3s ease-in-out infinite;
        }
        @keyframes orb-pulse {
            0%,100% { box-shadow: 0 0 0 12px rgba(20,184,166,.1),0 0 0 24px rgba(20,184,166,.05); }
            50% { box-shadow: 0 0 0 16px rgba(20,184,166,.12),0 0 0 32px rgba(20,184,166,.06); }
        }
        .welcome-title { font-size: 1.4rem; font-weight: 800; color: var(--ink); }
        .welcome-sub { font-size: .875rem; color: var(--muted); max-width: 380px; line-height: 1.55; }
        .welcome-chips { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; max-width: 480px; }
        .welcome-chip {
            padding: .45rem .9rem; border-radius: 99px;
            border: 1px solid var(--border); background: var(--surface);
            font-size: .8rem; color: var(--muted); cursor: pointer;
            transition: all .15s;
        }
        .welcome-chip:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); transform: translateY(-1px); }

        .validation-chip {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .5rem .875rem; border-radius: var(--radius-lg);
            background: #fff1f2; border: 1px solid #fecdd3;
            color: #be123c; font-size: .8rem; font-weight: 600; margin-top: .375rem;
        }

        @keyframes slide-up { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }
        .animate-slide-up { animation: slide-up .3s ease both; }

        .code-block {
            background: #0f172a; color: #94a3b8;
            border-radius: .625rem; padding: .75rem 1rem;
            font-size: .775rem; overflow-x: auto; margin: .5rem 0;
        }
        .code-block .key { color: #7dd3fc; }
        .code-block .val { color: #86efac; }
        .code-block .str { color: #fca5a5; }

        .data-table-wrap { margin: .625rem 0; overflow-x: auto; }
        .data-table {
            width: 100%; border-collapse: collapse;
            font-size: .75rem; background: var(--surface);
            border-radius: .5rem; overflow: hidden;
        }
        .data-table th {
            background: rgba(15,23,42,.04); padding: .5rem .625rem;
            text-align: left; font-weight: 600; color: var(--muted);
            border-bottom: 1px solid var(--border); white-space: nowrap;
        }
        .dark .data-table th { background: rgba(255,255,255,.04); }
        .data-table td {
            padding: .5rem .625rem; border-bottom: 1px solid var(--border); color: var(--ink);
        }
        .data-table tr:last-child td { border-bottom: none; }
        .data-table tr:hover td { background: rgba(15,23,42,.02); }
        .dark .data-table tr:hover td { background: rgba(255,255,255,.02); }
        .status-badge {
            display: inline-block; padding: .15rem .5rem; border-radius: 99px;
            font-size: .65rem; font-weight: 600;
        }
        .status-pending { background: #fef3c7; color: #92400e; }
        .status-reviewing { background: #dbeafe; color: #1e40af; }
        .status-interview { background: #ede9fe; color: #5b21b6; }
        .status-offer { background: #d1fae5; color: #065f46; }
        .status-hired { background: #ccfbf1; color: #0f766e; }
        .status-rejected { background: #fee2e2; color: #991b1b; }
        .status-passed { background: #d1fae5; color: #065f46; }
        .status-failed { background: #fee2e2; color: #991b1b; }

        .reasoning-wrap { margin: 0 -1rem .5rem; padding: 0 1rem; }
        .reasoning-toggle {
            display: flex; align-items: center; gap: .5rem;
            width: 100%; padding: .5rem .75rem; border: none; background: transparent;
            cursor: pointer; color: var(--muted); font-size: .72rem; font-weight: 600;
            border-radius: var(--radius-lg); transition: background .15s;
        }
        .reasoning-toggle:hover { background: rgba(15,23,42,.04); }
        .dark .reasoning-toggle:hover { background: rgba(255,255,255,.04); }
        .reasoning-chevron { width: 14px; height: 14px; transition: transform .2s; }
        .reasoning-wrap.open .reasoning-chevron { transform: rotate(90deg); }
        .reasoning-content { padding: .5rem .75rem .75rem; border-left: 2px solid var(--accent); margin-left: .5rem; }
        .reasoning-plan-title, .reasoning-tools-title {
            font-size: .65rem; font-weight: 700; color: var(--muted);
            text-transform: uppercase; letter-spacing: .08em; margin-bottom: .5rem;
        }
        .reasoning-step {
            display: flex; align-items: center; gap: .5rem;
            padding: .25rem 0; font-size: .75rem; color: var(--muted);
        }
        .reasoning-step.done { color: var(--accent-dark); }
        .reasoning-step-icon {
            width: 16px; height: 16px; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: .6rem; font-weight: 700; flex-shrink: 0;
        }
        .reasoning-step.done .reasoning-step-icon { background: #d1fae5; color: #065f46; }
        .reasoning-step.pending .reasoning-step-icon { background: rgba(15,23,42,.06); color: var(--muted-light); }
        .reasoning-tool-item {
            display: flex; align-items: center; justify-content: space-between;
            padding: .35rem .5rem; margin-top: .25rem; border-radius: .375rem;
            font-size: .72rem; background: rgba(15,23,42,.02);
        }
        .dark .reasoning-tool-item { background: rgba(255,255,255,.02); }
        .reasoning-tool-name { font-weight: 600; color: var(--ink); }
        .reasoning-tool-status {
            font-size: .65rem; font-weight: 600; padding: .1rem .4rem;
            border-radius: 99px; text-transform: uppercase;
        }
        .reasoning-tool-item.done .reasoning-tool-status { background: #d1fae5; color: #065f46; }
        .reasoning-tool-item.error .reasoning-tool-status { background: #fee2e2; color: #991b1b; }

        .ai-data-table {
            margin: .75rem 0; border-radius: var(--radius-lg); overflow: hidden;
            border: 1px solid var(--border); background: var(--surface);
        }
        .ai-data-table-title {
            padding: .75rem 1rem; font-size: .8rem; font-weight: 700;
            color: var(--ink); background: rgba(20,184,166,.04);
            border-bottom: 1px solid var(--border);
        }
        .ai-data-table-scroll { overflow-x: auto; }
        .ai-table {
            width: 100%; border-collapse: collapse; font-size: .78rem;
        }
        .ai-table th {
            background: rgba(15,23,42,.03); padding: .6rem .75rem;
            text-align: left; font-weight: 600; color: var(--muted);
            border-bottom: 1px solid var(--border); white-space: nowrap;
            font-size: .68rem; text-transform: uppercase; letter-spacing: .05em;
        }
        .dark .ai-table th { background: rgba(255,255,255,.04); }
        .ai-table td {
            padding: .55rem .75rem; border-bottom: 1px solid var(--border);
            color: var(--ink); max-width: 200px; overflow: hidden;
            text-overflow: ellipsis; white-space: nowrap;
        }
        .ai-table tr:last-child td { border-bottom: none; }
        .ai-table tr:hover td { background: rgba(15,23,42,.02); }
        .dark .ai-table tr:hover td { background: rgba(255,255,255,.02); }
        .ai-data-table-footer {
            padding: .5rem .75rem; font-size: .68rem; color: var(--muted-light);
            border-top: 1px solid var(--border); background: rgba(15,23,42,.01);
        }

        .ai-pdf-chip {
            display: inline-flex; align-items: center; gap: .75rem;
            padding: .625rem 1rem; margin-top: .5rem;
            background: linear-gradient(135deg, var(--violet-soft), rgba(20,184,166,.06));
            border: 1px solid rgba(124,58,237,.15); border-radius: var(--radius-lg);
            color: var(--violet); text-decoration: none; font-size: .8rem;
            transition: all .15s;
        }
        .ai-pdf-chip:hover {
            border-color: rgba(124,58,237,.3); transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(124,58,237,.1);
        }
        .ai-pdf-chip-title { font-weight: 700; }
        .ai-pdf-chip-name { color: var(--muted); font-size: .72rem; }

        @keyframes shimmer { 0% { background-position:200% 0; } 100% { background-position:-200% 0; } }
        .skeleton {
            background: linear-gradient(90deg, rgba(15,23,42,.04) 25%, rgba(15,23,42,.08) 50%, rgba(15,23,42,.04) 75%);
            background-size: 200% 100%; animation: shimmer 1.5s infinite;
            border-radius: .375rem;
        }
        .dark .skeleton { background: linear-gradient(90deg, rgba(255,255,255,.03) 25%, rgba(255,255,255,.06) 50%, rgba(255,255,255,.03) 75%); background-size: 200% 100%; }
    </style>
{% endblock %}

{% block body %}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    <div class="chat-shell" id="chatShell">
        <header class="chat-topbar">
            <div class="topbar-brand">
