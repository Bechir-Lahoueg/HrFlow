{% extends 'base.html.twig' %}

{% block title %}AI Recruiter | HrFlow{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* ── Google Font ── */
        @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap');

        /* ── CSS Variables ── */
        :root {
            --chat-bg:       #f8f9fb;
            --sidebar-w:     272px;
            --surface:       #ffffff;
            --border:        rgba(15,23,42,.07);
            --accent:        #14b8a6;
            --accent-dark:   #0f9689;
            --accent-soft:   #f0fdfa;
            --violet:        #7c3aed;
            --violet-soft:   #f5f3ff;
            --ink:           #0f172a;
            --muted:         #64748b;
            --muted-light:   #94a3b8;
            --user-bubble:   linear-gradient(135deg,#1e293b 0%,#0f172a 100%);
            --bot-bubble:    #ffffff;
            --radius-xl:     1.25rem;
            --radius-lg:     .875rem;
            --shadow-card:   0 1px 3px rgba(15,23,42,.06),0 4px 16px rgba(15,23,42,.06);
            --shadow-float:  0 8px 32px rgba(15,23,42,.12);
        }
        .dark {
            --chat-bg:       #09090b;
            --surface:       #18181b;
            --border:        rgba(255,255,255,.06);
            --accent-soft:   #0d2d29;
            --violet-soft:   #1e1b4b;
            --ink:           #f1f5f9;
            --muted:         #94a3b8;
            --bot-bubble:    #1e1e24;
            --shadow-card:   0 1px 3px rgba(0,0,0,.3),0 4px 16px rgba(0,0,0,.3);
        }

        /* ── Layout ── */
        * { font-family: 'DM Sans', sans-serif; box-sizing: border-box; }
        code, pre, .mono { font-family: 'JetBrains Mono', monospace; }

        .chat-shell {
            position: fixed;
            inset: 0;
            left: var(--sidebar-w);
            top: 0;
            bottom: 0;
            display: grid;
            grid-template-columns: 1fr 320px;
            grid-template-rows: 64px 1fr;
            background: var(--chat-bg);
            overflow: hidden;
            transition: left .3s;
        }
        @media (max-width: 1024px) { .chat-shell { left: 0; grid-template-columns: 1fr; } }
        @media (max-width: 768px)  { .chat-shell { grid-template-columns: 1fr; } .context-panel { display: none; } }

        /* ── Top Bar ── */
        .chat-topbar {
            grid-column: 1 / -1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            backdrop-filter: blur(12px);
            gap: 1rem;
        }
        .topbar-brand { display: flex; align-items: center; gap: .75rem; }
        .ai-badge {
            display: inline-flex; align-items: center; gap: .375rem;
            background: linear-gradient(135deg,#14b8a6,#7c3aed);
            color: #fff; font-size: .65rem; font-weight: 700;
            letter-spacing: .08em; text-transform: uppercase;
            padding: .2rem .6rem; border-radius: 99px;
        }
        .status-live {
            display: inline-flex; align-items: center; gap: .375rem;
            font-size: .78rem; color: var(--muted); font-weight: 500;
        }
        .status-live::before {
            content: ''; width: 7px; height: 7px; border-radius: 50%;
            background: #10b981; box-shadow: 0 0 0 2px #d1fae5;
            animation: pulse-dot 2s infinite;
        }
        @keyframes pulse-dot {
            0%,100% { box-shadow: 0 0 0 2px #d1fae5; }
            50%      { box-shadow: 0 0 0 4px #a7f3d0; }
        }
        .topbar-actions { display: flex; align-items: center; gap: .5rem; }
        .icon-btn {
            width: 36px; height: 36px; border-radius: .625rem;
            display: flex; align-items: center; justify-content: center;
            color: var(--muted); background: transparent; border: none; cursor: pointer;
            transition: background .15s, color .15s;
        }
        .icon-btn:hover { background: rgba(15,23,42,.05); color: var(--ink); }
        .dark .icon-btn:hover { background: rgba(255,255,255,.07); }

        /* ── Main Chat Area ── */
        .chat-main {
            display: flex; flex-direction: column;
            overflow: hidden; position: relative;
        }

        /* ── Messages ── */
        .messages-scroll {
            flex: 1; overflow-y: auto; overflow-x: hidden;
            padding: 1.5rem 1.5rem 0;
            scroll-behavior: smooth;
        }
        .messages-scroll::-webkit-scrollbar { width: 4px; }
        .messages-scroll::-webkit-scrollbar-track { background: transparent; }
        .messages-scroll::-webkit-scrollbar-thumb { background: rgba(15,23,42,.1); border-radius: 4px; }

        /* Day divider */
        .day-sep {
            display: flex; align-items: center; gap: .75rem;
            color: var(--muted-light); font-size: .72rem; font-weight: 600;
            text-transform: uppercase; letter-spacing: .07em; margin: 1.5rem 0;
        }
        .day-sep::before, .day-sep::after {
            content: ''; flex: 1; height: 1px;
            background: linear-gradient(90deg,transparent,var(--border),transparent);
        }

        /* Message row */
        .msg-row {
            display: flex; gap: .75rem; margin-bottom: 1rem;
            animation: msg-in .25s cubic-bezier(.34,1.56,.64,1);
        }
        .msg-row.user { flex-direction: row-reverse; }
        @keyframes msg-in {
            from { opacity: 0; transform: translateY(8px) scale(.98); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        /* Avatar */
        .msg-avatar {
            width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            font-size: .72rem; font-weight: 700; align-self: flex-end;
        }
        .msg-avatar.bot {
            background: linear-gradient(135deg,#14b8a6,#7c3aed);
            color: #fff; box-shadow: 0 2px 8px rgba(20,184,166,.35);
        }
        .msg-avatar.user {
            background: var(--ink); color: #fff;
        }

        /* Bubble */
        .msg-bubble {
            max-width: min(480px, 78%);
            padding: .75rem 1rem;
            border-radius: var(--radius-xl);
            font-size: .875rem; line-height: 1.6;
            position: relative;
        }
        .msg-bubble.bot {
            background: var(--bot-bubble);
            color: var(--ink);
            border: 1px solid var(--border);
            box-shadow: var(--shadow-card);
            border-bottom-left-radius: .375rem;
        }
        .msg-bubble.user {
            background: var(--user-bubble);
            color: #e2e8f0;
            border-bottom-right-radius: .375rem;
        }
        .msg-bubble.bot p { margin: 0 0 .5em; }
        .msg-bubble.bot p:last-child { margin-bottom: 0; }

        /* Timestamp */
        .msg-ts { font-size: .68rem; color: var(--muted-light); margin-top: .25rem; }
        .msg-row.user .msg-ts { text-align: right; }

        /* ── Tool Execution Card (inside bot bubble) ── */
        .tool-card {
            margin: .5rem 0; background: var(--accent-soft);
            border: 1px solid rgba(20,184,166,.18);
            border-radius: var(--radius-lg); overflow: hidden;
        }
        .dark .tool-card { background: var(--accent-dark)/10; border-color: rgba(20,184,166,.2); }
        .tool-header {
            display: flex; align-items: center; gap: .5rem;
            padding: .5rem .75rem; cursor: pointer;
            font-size: .78rem; font-weight: 600; color: var(--accent-dark);
        }
        .tool-header svg { flex-shrink: 0; }
        .tool-header .tool-label { flex: 1; }
        .tool-header .tool-status {
            font-size: .68rem; font-weight: 700; letter-spacing: .05em;
            text-transform: uppercase; padding: .15rem .5rem;
            border-radius: 99px;
        }
        .tool-status.done { background: #d1fae5; color: #065f46; }
        .tool-status.running { background: #fef3c7; color: #92400e; animation: blink .8s infinite; }
        .tool-status.error { background: #fee2e2; color: #991b1b; }
        @keyframes blink { 0%,100%{ opacity:1 } 50%{ opacity:.5 } }
        .tool-body {
            display: none; padding: .625rem .75rem;
            border-top: 1px solid rgba(20,184,166,.12);
            font-size: .775rem; color: var(--muted);
            background: rgba(255,255,255,.5);
        }
        .dark .tool-body { background: rgba(0,0,0,.2); }
        .tool-card.open .tool-body { display: block; }
        .tool-card.open .chevron { transform: rotate(180deg); }
        .chevron { transition: transform .2s; }

        /* ── Candidate Card (rich result inside bot bubble) ── */
        .cand-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(200px,1fr)); gap: .5rem; margin-top: .625rem; }
        .cand-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius-lg); padding: .75rem;
            box-shadow: var(--shadow-card); display: flex; flex-direction: column; gap: .25rem;
        }
        .cand-rank {
            font-size: .65rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: .08em; color: var(--accent);
        }
        .cand-name { font-size: .85rem; font-weight: 700; color: var(--ink); }
        .cand-role { font-size: .75rem; color: var(--muted); }
        .score-bar { height: 4px; background: rgba(15,23,42,.08); border-radius: 99px; margin-top: .375rem; overflow: hidden; }
        .score-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg,#14b8a6,#10b981); }

        /* ── Typing Indicator ── */
        .typing-row { display: flex; gap: .75rem; margin-bottom: 1rem; }
        .typing-bubble {
            padding: .75rem 1rem; background: var(--bot-bubble);
            border: 1px solid var(--border); border-radius: var(--radius-xl);
            border-bottom-left-radius: .375rem;
            display: flex; align-items: center; gap: .35rem;
            box-shadow: var(--shadow-card);
        }
        .typing-bubble span {
            width: 6px; height: 6px; border-radius: 50%;
            background: var(--muted-light); animation: bounce .9s infinite;
        }
        .typing-bubble span:nth-child(2) { animation-delay: .15s; }
        .typing-bubble span:nth-child(3) { animation-delay: .3s; }
        @keyframes bounce { 0%,80%,100%{ transform:translateY(0) } 40%{ transform:translateY(-5px) } }

        /* ── Step Planner (shown above first tool card) ── */
        .plan-strip {
            display: flex; align-items: center; gap: .5rem;
            padding: .5rem .75rem; margin-bottom: .5rem;
            background: var(--violet-soft); border: 1px solid rgba(124,58,237,.12);
            border-radius: var(--radius-lg); font-size: .78rem; color: #5b21b6; font-weight: 500;
            overflow-x: auto; white-space: nowrap;
        }
        .plan-step {
            display: inline-flex; align-items: center; gap: .3rem;
            padding: .2rem .55rem; border-radius: 99px;
            font-size: .7rem; font-weight: 600;
        }
        .plan-step.done { background: #d1fae5; color: #065f46; }
        .plan-step.active { background: #fef3c7; color: #92400e; }
        .plan-step.pending { background: rgba(15,23,42,.06); color: var(--muted); }
        .plan-arrow { color: var(--muted-light); font-size: .7rem; }

        /* ── Composer ── */
        .composer-wrap {
            padding: 1rem 1.5rem 1.25rem;
            border-top: 1px solid var(--border);
            background: var(--surface);
        }
        .composer-box {
            display: flex; align-items: flex-end; gap: .625rem;
            background: var(--chat-bg); border: 1.5px solid var(--border);
            border-radius: var(--radius-xl); padding: .5rem .5rem .5rem .875rem;
            transition: border-color .2s, box-shadow .2s;
        }
        .composer-box:focus-within {
            border-color: rgba(20,184,166,.5);
            box-shadow: 0 0 0 3px rgba(20,184,166,.1);
        }
        .composer-input {
            flex: 1; border: none; background: transparent; outline: none;
            resize: none; font-size: .875rem; color: var(--ink);
            line-height: 1.55; max-height: 160px; overflow-y: auto;
            padding: .3rem 0; min-height: 1.55em;
        }
        .composer-input::placeholder { color: var(--muted-light); }
        .composer-actions { display: flex; gap: .25rem; align-items: flex-end; flex-shrink: 0; }
        .attach-btn {
            width: 34px; height: 34px; border-radius: .625rem;
            border: none; background: transparent; cursor: pointer;
            display: flex; align-items: center; justify-content: center;
            color: var(--muted); transition: background .15s, color .15s;
        }
        .attach-btn:hover { background: rgba(15,23,42,.05); color: var(--accent); }
        .send-btn {
            width: 34px; height: 34px; border-radius: .625rem;
            border: none; background: linear-gradient(135deg,#14b8a6,#0d9488);
            color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
            transition: transform .15s, box-shadow .15s, opacity .15s;
            box-shadow: 0 2px 8px rgba(20,184,166,.4);
        }
        .send-btn:hover { transform: scale(1.07); box-shadow: 0 4px 16px rgba(20,184,166,.5); }
        .send-btn:active { transform: scale(.96); }
        .send-btn:disabled { opacity: .4; pointer-events: none; }

        /* Quick suggestions */
        .quick-wrap { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: .625rem; }
        .quick-chip {
            display: inline-flex; align-items: center; gap: .35rem;
            padding: .3rem .7rem; border-radius: 99px; border: 1px solid var(--border);
            background: var(--surface); color: var(--muted); font-size: .775rem;
            cursor: pointer; transition: all .15s; white-space: nowrap;
        }
        .quick-chip:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

        /* ── Context Panel (right side) ── */
        .context-panel {
            border-left: 1px solid var(--border);
            background: var(--surface); overflow-y: auto; display: flex; flex-direction: column; gap: 0;
        }
        .panel-section { padding: 1.25rem 1.25rem; border-bottom: 1px solid var(--border); }
        .panel-title {
            font-size: .68rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
            color: var(--muted); margin-bottom: .875rem;
        }

        /* Active Job */
        .active-job-card {
            background: linear-gradient(135deg,rgba(20,184,166,.08),rgba(124,58,237,.05));
            border: 1px solid rgba(20,184,166,.2);
            border-radius: var(--radius-lg); padding: .875rem;
        }
        .job-title-text { font-size: .875rem; font-weight: 700; color: var(--ink); }
        .job-meta { font-size: .75rem; color: var(--muted); margin-top: .2rem; }
        .pill {
            display: inline-flex; align-items: center; gap: .25rem;
            font-size: .68rem; font-weight: 600; padding: .2rem .55rem;
            border-radius: 99px;
        }
        .pill-green { background: #d1fae5; color: #065f46; }
        .pill-violet { background: #ede9fe; color: #5b21b6; }

        /* Memory items */
        .mem-item {
            display: flex; align-items: flex-start; gap: .625rem;
            padding: .5rem; border-radius: .625rem; margin-bottom: .375rem;
            transition: background .15s;
        }
        .mem-item:hover { background: rgba(15,23,42,.03); cursor: pointer; }
        .mem-icon {
            width: 28px; height: 28px; border-radius: .5rem; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center; font-size: .78rem;
        }
        .mem-icon.teal { background: var(--accent-soft); color: var(--accent); }
        .mem-icon.violet { background: var(--violet-soft); color: var(--violet); }
        .mem-icon.amber { background: #fffbeb; color: #d97706; }
        .mem-text { font-size: .78rem; color: var(--muted); line-height: 1.45; }
        .mem-text strong { color: var(--ink); font-weight: 600; }

        /* Stat row */
        .stat-row { display: grid; grid-template-columns: 1fr 1fr; gap: .5rem; }
        .stat-item {
            background: rgba(15,23,42,.03); border-radius: .625rem;
            padding: .625rem; text-align: center;
        }
        .dark .stat-item { background: rgba(255,255,255,.04); }
        .stat-val { font-size: 1.3rem; font-weight: 800; color: var(--ink); }
        .stat-lbl { font-size: .68rem; color: var(--muted); margin-top: .1rem; }

        /* Suggested actions */
        .action-btn {
            width: 100%; display: flex; align-items: center; gap: .625rem;
            padding: .625rem .75rem; border-radius: .75rem; border: 1px solid var(--border);
            background: transparent; cursor: pointer; text-align: left;
            font-size: .8rem; font-weight: 500; color: var(--muted);
            transition: all .15s; margin-bottom: .375rem;
        }
        .action-btn:hover {
            background: var(--accent-soft); border-color: rgba(20,184,166,.25);
            color: var(--accent-dark);
        }
        .action-btn-icon {
            width: 26px; height: 26px; border-radius: .5rem; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
        }

        /* ── Welcome / Empty State ── */
        .welcome-state {
            flex: 1; display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            gap: 1.25rem; padding: 2rem; text-align: center;
        }
        .welcome-orb {
            width: 80px; height: 80px; border-radius: 50%;
            background: linear-gradient(135deg,#14b8a6,#7c3aed);
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 0 0 12px rgba(20,184,166,.1), 0 0 0 24px rgba(20,184,166,.05);
            animation: orb-pulse 3s ease-in-out infinite;
        }
        @keyframes orb-pulse {
            0%,100% { box-shadow: 0 0 0 12px rgba(20,184,166,.1),0 0 0 24px rgba(20,184,166,.05); }
            50%      { box-shadow: 0 0 0 16px rgba(20,184,166,.12),0 0 0 32px rgba(20,184,166,.06); }
        }
        .welcome-title { font-size: 1.5rem; font-weight: 800; color: var(--ink); }
        .welcome-sub { font-size: .9rem; color: var(--muted); max-width: 380px; line-height: 1.55; }
        .welcome-chips { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; max-width: 480px; }
        .welcome-chip {
            padding: .45rem .9rem; border-radius: 99px;
            border: 1px solid var(--border); background: var(--surface);
            font-size: .815rem; color: var(--muted); cursor: pointer;
            transition: all .15s;
        }
        .welcome-chip:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

        /* ── Validation Error Chip ── */
        .validation-chip {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .5rem .875rem; border-radius: var(--radius-lg);
            background: #fff1f2; border: 1px solid #fecdd3;
            color: #be123c; font-size: .8rem; font-weight: 600;
            margin-top: .375rem;
        }

        /* ── Slide animations ── */
        @keyframes slide-up {
            from { opacity:0; transform:translateY(12px); }
            to   { opacity:1; transform:translateY(0); }
        }
        .animate-slide-up { animation: slide-up .3s ease both; }

        /* ── Code block ── */
        .code-block {
            background: #0f172a; color: #94a3b8;
            border-radius: .625rem; padding: .75rem 1rem;
            font-size: .775rem; overflow-x: auto; margin: .5rem 0;
        }
        .code-block .key { color: #7dd3fc; }
        .code-block .val { color: #86efac; }
        .code-block .str { color: #fca5a5; }

        /* ── Data Table ── */
        .data-table-wrap {
            margin: .625rem 0; overflow-x: auto;
        }
        .data-table {
            width: 100%; border-collapse: collapse;
            font-size: .75rem; background: var(--surface);
            border-radius: .5rem; overflow: hidden;
        }
        .data-table th {
            background: rgba(15,23,42,.04); padding: .5rem .625rem;
            text-align: left; font-weight: 600; color: var(--muted);
            border-bottom: 1px solid var(--border); white-space: nowrap;
        }
        .dark .data-table th { background: rgba(255,255,255,.04); }
        .data-table td {
            padding: .5rem .625rem; border-bottom: 1px solid var(--border);
            color: var(--ink);
        }
        .data-table tr:last-child td { border-bottom: none; }
        .data-table tr:hover td { background: rgba(15,23,42,.02); }
        .dark .data-table tr:hover td { background: rgba(255,255,255,.02); }
        .status-badge {
            display: inline-block; padding: .15rem .5rem; border-radius: 99px;
            font-size: .65rem; font-weight: 600;
        }
        .status-pending { background: #fef3c7; color: #92400e; }
        .status-reviewing { background: #dbeafe; color: #1e40af; }
        .status-interview { background: #ede9fe; color: #5b21b6; }
        .status-offer { background: #d1fae5; color: #065f46; }
        .status-hired { background: #ccfbf1; color: #0f766e; }
        .status-rejected { background: #fee2e2; color: #991b1b; }
        .status-passed { background: #d1fae5; color: #065f46; }
        .status-failed { background: #fee2e2; color: #991b1b; }
    </style>
{% endblock %}

{% block body %}
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div class="min-h-screen bg-[#f8f9fb] dark:bg-zinc-950">
    {% include 'DashboardHr/components/_sidebar.html.twig' %}

    {# ════════════════════════════════════════════════════════ CHAT SHELL ═══ #}
    <div class="chat-shell" id="chatShell">

        {# ─── Top Bar ─── #}
        <header class="chat-topbar">
            <div class="topbar-brand">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-teal-500 to-violet-600 flex items-center justify-center shadow-lg">
                    <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"/>
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-[15px]" style="color:var(--ink)">HrFlow AI</span>
                        <span class="ai-badge">Agentic</span>
                    </div>
                    <div class="status-live">Recruitment Intelligence · Session active</div>
                </div>
            </div>

            <div class="topbar-actions">
                {# Model info #}
                <div class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[.75rem] font-medium" style="background:var(--violet-soft);color:#5b21b6">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 002.25-2.25V6.75a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 6.75v10.5a2.25 2.25 0 002.25 2.25zm.75-12h9v9h-9v-9z"/></svg>
                    Llama 3.1 8B (Groq)
                </div>

                {# Memory toggle #}
                <button class="icon-btn" title="Session memory" id="memBtn">
                    <svg class="w-4.5 h-4.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 9.776c.112-.017.227-.026.344-.026h15.812c.117 0 .232.009.344.026m-16.5 0a2.25 2.25 0 00-1.883 2.542l.857 6a2.25 2.25 0 002.227 1.932H19.05a2.25 2.25 0 002.227-1.932l.857-6a2.25 2.25 0 00-1.883-2.542m-16.5 0V6A2.25 2.25 0 016 3.75h3.879a1.5 1.5 0 011.06.44l2.122 2.12a1.5 1.5 0 001.06.44H18A2.25 2.25 0 0120.25 9v.776"/></svg>
                </button>

                {# Export #}
                <button class="icon-btn" title="Export conversation" id="exportBtn">
