{# ════════════════════════════════════════════════ JAVASCRIPT ═══ #}
<script>
(function () {
    'use strict';

    /* ── State ── */
    const state = {
        messages: [],
        toolCount: 0,
        msgCount: 0,
        candsAnalyzed: 0,
        planned: 0,
        activeJob: null,
        memory: [],
        isThinking: false,
    };

    /* ── DOM refs ── */
    const $input    = document.getElementById('composerInput');
    const $sendBtn  = document.getElementById('sendBtn');
    const $scroll   = document.getElementById('messagesScroll');
    const $list     = document.getElementById('messagesList');
    const $typing   = document.getElementById('typingIndicator');
    const $welcome  = document.getElementById('welcomeState');
    const $charCnt  = document.getElementById('charCount');

    /* ── Helpers ── */
    const scrollBottom = () => {
        requestAnimationFrame(() => { $scroll.scrollTop = $scroll.scrollHeight; });
    };

    const updateStats = () => {
        document.getElementById('statTools').textContent = state.toolCount;
        document.getElementById('statMsgs').textContent  = state.msgCount;
        document.getElementById('statCands').textContent = state.candsAnalyzed || '—';
        document.getElementById('statPlanned').textContent = state.planned;
    };

    const now = () => new Date().toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

    /* ── Composer auto-resize ── */
    $input.addEventListener('input', () => {
        $input.style.height = 'auto';
        $input.style.height = Math.min($input.scrollHeight, 160) + 'px';
        $sendBtn.disabled = !$input.value.trim();
        $charCnt.textContent = `${$input.value.length} / 2000`;
    });

    $input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            if (!$sendBtn.disabled && !state.isThinking) sendMessage();
        }
    });

    $sendBtn.addEventListener('click', () => {
        if (!state.isThinking) sendMessage();
    });

    /* ── Welcome chips & quick chips ── */
    document.querySelectorAll('[data-prompt]').forEach(el => {
        el.addEventListener('click', () => {
            $input.value = el.dataset.prompt;
            $input.dispatchEvent(new Event('input'));
            sendMessage();
        });
    });

    /* ── Show/hide welcome ── */
    function showWelcome(show) {
        $welcome.style.display = show ? 'flex' : 'none';
        $list.style.display    = show ? 'none' : 'block';
    }

    /* ── Append message ── */
    function appendMsg(role, content, toolCards = null, planSteps = null) {
        showWelcome(false);
        state.msgCount++;
        updateStats();

        const row = document.createElement('div');
        row.className = `msg-row ${role}`;

        const avatar = document.createElement('div');
        avatar.className = `msg-avatar ${role}`;
        avatar.textContent = role === 'bot' ? 'AI' : (('{{ app.user.firstName|default("R") }}'.charAt(0).toUpperCase() || 'R'));

        const col = document.createElement('div');

        /* Plan strip */
        if (planSteps && planSteps.length) {
            const strip = document.createElement('div');
            strip.className = 'plan-strip';
            strip.innerHTML = `<svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
            <span style="font-weight:700;margin-right:.25rem;">Plan :</span>`;
            planSteps.forEach((step, i) => {
                if (i > 0) strip.innerHTML += `<span class="plan-arrow">→</span>`;
                strip.innerHTML += `<span class="plan-step ${step.status}">${step.label}</span>`;
            });
            col.appendChild(strip);
        }

        /* Text content */
        if (content || (toolCards && toolCards.length)) {
            const bubble = document.createElement('div');
            bubble.className = `msg-bubble ${role}`;

            if (toolCards && toolCards.length) {
                toolCards.forEach(tc => {
                    const card = buildToolCard(tc);
                    bubble.appendChild(card);
                });
            }

            if (content) {
                const p = document.createElement('div');
                p.innerHTML = marked.parse(content);
                bubble.appendChild(p);
            }

            /* Download Link */
            if (toolCards) {
                toolCards.forEach(tc => {
                    if (tc.status === 'done' && tc.download_url) {
                        bubble.appendChild(buildDownloadLink(tc.download_url, tc.name));
                    }
                    if (tc.status === 'done' && tc.chart_data) {
                        bubble.appendChild(buildChartBubble(tc.chart_data));
                    }
                });
            }

            col.appendChild(bubble);
        }

        const ts = document.createElement('div');
        ts.className = 'msg-ts';
        ts.textContent = now();

        col.appendChild(ts);

        row.appendChild(avatar);
        row.appendChild(col);
        $list.appendChild(row);
        scrollBottom();
    }

    /* ── Build Tool Card ── */
    function buildToolCard(tc) {
        state.toolCount++;
        updateStats();
        const card = document.createElement('div');
        card.className = `tool-card ${tc.open ? 'open' : ''}`;
        const statusClass = { done: 'done', running: 'running', error: 'error' }[tc.status] || 'done';
        const statusLabel = { done: 'Terminé', running: 'En cours…', error: 'Erreur' }[tc.status] || 'Terminé';

        card.innerHTML = `
            <div class="tool-header" onclick="this.closest('.tool-card').classList.toggle('open')">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z"/>
                </svg>
                <span class="tool-label">${tc.name}</span>
                <span class="tool-status ${statusClass}">${statusLabel}</span>
                <svg class="w-3.5 h-3.5 chevron" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
            </div>
            <div class="tool-body">
                ${tc.body || '<span style="color:var(--muted-light);font-style:italic">Aucun détail disponible.</span>'}
            </div>`;
        return card;
    }

    /* ── Build Candidate Grid ── */
    function buildCandGrid(candidates) {
        const wrap = document.createElement('div');
        wrap.className = 'cand-grid';
        candidates.forEach((c, i) => {
            wrap.innerHTML += `
                <div class="cand-card">
                    <div class="cand-rank">#${i+1} · Score ${c.score}%</div>
                    <div class="cand-name">${c.name}</div>
                    <div class="cand-role">${c.role || '—'}</div>
                    <div class="score-bar"><div class="score-fill" style="width:${c.score}%"></div></div>
                </div>`;
        });
        return wrap;
    }

    /* ── Build Data Table for Applications ── */
    function buildApplicationsTable(apps) {
        const wrap = document.createElement('div');
        wrap.className = 'data-table-wrap';
        let html = `<table class="data-table">
            <thead><tr>
                <th>Candidat</th>
                <th>Email</th>
                <th>Offre</th>
                <th>Statut</th>
                <th>Date</th>
            </tr></thead>
            <tbody>`;
        apps.forEach(a => {
            const statusClass = 'status-' + (a.status || '').toLowerCase();
            html += `<tr>
                <td><strong>${escHtml(a.candidate_name || '')}</strong></td>
                <td>${escHtml(a.email || '—')}</td>
                <td>${escHtml(a.job_title || '—')}</td>
                <td><span class="status-badge ${statusClass}">${escHtml(a.status_label || a.status || '')}</span></td>
                <td>${escHtml(a.applied_at || '—')}</td>
            </tr>`;
        });
        html += '</tbody></table>';
        wrap.innerHTML = html;
        return wrap;
    }

    /* ── Build Data Table for Interviews ── */
    function buildInterviewsTable(intvs) {
        const wrap = document.createElement('div');
        wrap.className = 'data-table-wrap';
        let html = `<table class="data-table">
            <thead><tr>
                <th>Candidat</th>
                <th>Offre</th>
                <th>Type</th>
                <th>Date</th>
                <th>Résultat</th>
                <th>Score</th>
            </tr></thead>
            <tbody>`;
        intvs.forEach(i => {
            const resultClass = i.result ? 'status-' + i.result.toLowerCase() : '';
            html += `<tr>
                <td><strong>${escHtml(i.candidate_name || '')}</strong></td>
                <td>${escHtml(i.job_title || '—')}</td>
                <td>${escHtml(i.type || '—')}</td>
                <td>${escHtml(i.interview_date || '—')}</td>
                <td><span class="status-badge ${resultClass}">${escHtml(i.result || '—')}</span></td>
                <td>${i.score !== null ? i.score + '/100' : '—'}</td>
            </tr>`;
        });
        html += '</tbody></table>';
        wrap.innerHTML = html;
        return wrap;
    }

    /* ── Build Data Table for Candidates ── */
    function buildCandidatesTable(cands) {
        const wrap = document.createElement('div');
        wrap.className = 'data-table-wrap';
        let html = `<table class="data-table">
            <thead><tr>
                <th>Nom</th>
                <th>Email</th>
                <th>Poste</th>
                <th>Statut</th>
            </tr></thead>
            <tbody>`;
        cands.forEach(c => {
            // Status badge colors
            const statusColors = {
                'PENDING': '#f59e0b',
                'REVIEWING': '#3b82f6',
                'INTERVIEW': '#8b5cf6',
                'OFFER': '#10b981',
                'HIRED': '#059669',
                'REJECTED': '#ef4444'
            };
            const statusColor = statusColors[c.status] || '#64748b';
            const statusLabel = c.status_label || c.status || '—';

            html += `<tr>
                <td><strong>${escHtml(c.full_name || c.username || '')}</strong></td>
                <td>${escHtml(c.email || '—')}</td>
                <td>${escHtml(c.job_title || '—')}</td>
                <td><span style="display:inline-block;padding:2px 8px;border-radius:4px;font-size:11px;font-weight:600;color:#fff;background:${statusColor}">${escHtml(statusLabel)}</span></td>
            </tr>`;
        });
        html += '</tbody></table>';
        wrap.innerHTML = html;
        return wrap;
    }

    /* ── Build Chart Bubble ── */
    function buildChartBubble(chartData) {
        const wrap = document.createElement('div');
        wrap.className = 'chart-container animate-slide-up';
        wrap.style = 'background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1rem;margin-top:.75rem;';

        // Add chart title if present
        if (chartData.title) {
            const title = document.createElement('div');
            title.className = 'chart-title';
            title.style = 'font-size:.875rem;font-weight:600;color:var(--ink);margin-bottom:.75rem;text-align:center;';
            title.textContent = chartData.title;
            wrap.appendChild(title);
        }

        const canvas = document.createElement('canvas');
        canvas.style.maxHeight = (chartData.height || 240) + 'px';
        wrap.appendChild(canvas);

        // Merge default options with provided options
        const defaultOptions = {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: true,
                    position: 'bottom',
                    labels: { boxWidth: 12, font: { family: 'DM Sans', size: 11 } }
                }
            }
        };

        const chartOptions = chartData.options ? Object.assign({}, defaultOptions, chartData.options) : defaultOptions;

        // Ensure legend position is respected
        if (chartData.options && chartData.options.plugins && chartData.options.plugins.legend) {
            chartOptions.plugins.legend = Object.assign({}, defaultOptions.plugins.legend, chartData.options.plugins.legend);
        }

        setTimeout(() => {
            new Chart(canvas, {
                type: chartData.type || 'bar',
                data: {
                    labels: chartData.labels,
                    datasets: chartData.datasets
                },
                options: chartOptions
            });
        }, 100);

        return wrap;
    }

    /* ── Build Download Link ── */
    function buildDownloadLink(url, label) {
        const a = document.createElement('a');
        a.href = url;
        a.target = '_blank';
        a.className = 'download-chip animate-slide-up';
        a.style = 'display:inline-flex;align-items:center;gap:.5rem;padding:.5rem .875rem;background:var(--violet-soft);color:var(--violet);border:1px solid rgba(124,58,237,.2);border-radius:var(--radius-lg);font-size:.8rem;font-weight:600;margin-top:.75rem;text-decoration:none;transition:all .15s;';
        a.innerHTML = `
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
            Télécharger ${label} (PDF)
        `;
        a.onmouseover = () => a.style.background = 'rgba(124,58,237,.15)';
        a.onmouseout  = () => a.style.background = 'var(--violet-soft)';
        return a;
    }

    /* ── Show/hide typing ── */
    function showTyping(show) {
        $typing.style.display = show ? 'flex' : 'none';
        if (show) scrollBottom();
    }

    /* ── Update memory panel ── */
    function pushMemory(icon, color, text) {
        state.memory.unshift({ icon, color, text });
        if (state.memory.length > 5) state.memory.pop();
        const $mem = document.getElementById('memoryList');
        $mem.innerHTML = '';
        state.memory.forEach(m => {
            $mem.innerHTML += `
                <div class="mem-item">
                    <div class="mem-icon ${m.color}">${m.icon}</div>
                    <div class="mem-text">${m.text}</div>
                </div>`;
        });
    }

    /* ── Send message + simulate agentic flow ── */
    async function sendMessage() {
        const text = $input.value.trim();
        if (!text || state.isThinking) return;

        console.log('[AI Chat] Sending message:', text);
        state.isThinking = true;
        $sendBtn.disabled = true;
        appendMsg('user', text);
        $input.value = '';
        $input.style.height = 'auto';
        $charCnt.textContent = '0 / 2000';

        showTyping(true);

        try {
            /* ── POST to Symfony AI chat endpoint ── */
            const payload = {
                message: text,
                session_id: getOrCreateSession(),
            };
            console.log('[AI Chat] Request payload:', payload);

            const res = await fetch('{{ path("app_rh_ai_chat") }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest',
                },
                body: JSON.stringify(payload),
            });

            const reqId = res.headers.get('X-Request-Id');
            console.log('[AI Chat] Response status:', res.status, 'request_id=', reqId);

            const raw = await res.text();
            let data = null;
            try { data = JSON.parse(raw); } catch (e) { /* ignore */ }
            console.log('[AI Chat] Response data:', data ?? raw);
            if (!res.ok) {
                console.error('[AI Chat] Server error', { status: res.status, request_id: reqId, body: data ?? raw });
            }
            showTyping(false);

            /* Build tool cards from planner steps */
            const toolCards = (data.tool_calls || []).map(t => ({
                name: t.tool_name,
                status: t.status || 'done',
                open: false,
                body: t.details ? formatToolBody(t.details) : null,
                download_url: t.details?.download_url || null,
                chart_data: t.details?.chart_data || null,
            }));

            /* Plan steps */
            const planSteps = (data.plan || []).map((step, i) => ({
                label: step,
                status: i < (data.completed_steps || 999) ? 'done' : (i === (data.completed_steps || 999) ? 'active' : 'pending'),
            }));

            /* Update active job if returned */
            if (data.active_job) {
                state.activeJob = data.active_job;
                document.getElementById('activeJobTitle').textContent = data.active_job.title;
                document.getElementById('activeJobMeta').textContent  = data.active_job.location || '';
                document.getElementById('activeJobBadge').style.display = '';
                document.getElementById('activeJobTags').innerHTML =
                    `<span class="pill pill-violet">${data.active_job.applications || 0} candidatures</span>`;
            }

            /* Update counters */
            if (data.candidates_analyzed) {
                state.candsAnalyzed = data.candidates_analyzed;
                pushMemory('👤', 'teal', `<strong>${data.candidates_analyzed} candidats</strong> analysés pour cette session.`);
            }
            if (data.interviews_planned) {
                state.planned += data.interviews_planned;
                pushMemory('📅', 'amber', `<strong>${data.interviews_planned} entretien(s)</strong> planifié(s).`);
            }
            if (data.report_generated) {
                pushMemory('📊', 'violet', `Rapport <strong>${data.report_type || 'Insights'}</strong> généré.`);
            }

            updateStats();

            /* Build HTML content */
            let htmlContent = data.message || '';

            /* Validation error */
            if (data.validation_error) {
                htmlContent += `<div class="validation-chip">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
                    ${data.validation_error}
                </div>`;
            }

            /* Candidates grid */
            if (data.candidates && data.candidates.length) {
                appendMsg('bot', htmlContent, toolCards, planSteps);
                const lastBubble = $list.lastElementChild.querySelector('.msg-bubble');
                lastBubble.appendChild(buildCandGrid(data.candidates));
            } else if (data.applications && data.applications.length) {
                appendMsg('bot', htmlContent, toolCards, planSteps);
                const lastBubble = $list.lastElementChild.querySelector('.msg-bubble');
                lastBubble.appendChild(buildApplicationsTable(data.applications));
            } else if (data.interviews && data.interviews.length) {
                appendMsg('bot', htmlContent, toolCards, planSteps);
                const lastBubble = $list.lastElementChild.querySelector('.msg-bubble');
                lastBubble.appendChild(buildInterviewsTable(data.interviews));
            } else if (data.candidates_list && data.candidates_list.length) {
                appendMsg('bot', htmlContent, toolCards, planSteps);
                const lastBubble = $list.lastElementChild.querySelector('.msg-bubble');
                lastBubble.appendChild(buildCandidatesTable(data.candidates_list));
            } else {
                appendMsg('bot', htmlContent, toolCards, planSteps);
            }

        } catch (err) {
            showTyping(false);
            console.error('[AI Chat] Network/client error:', err);
            appendMsg('bot', `<span style="color:#be123c">⚠️ Erreur de connexion. Veuillez réessayer.</span>`);
        }

        state.isThinking = false;
        $sendBtn.disabled = !$input.value.trim();
    }

    /* ── Format tool body as code block ── */
    function formatToolBody(details) {
        if (typeof details === 'string') return `<div class="code-block">${escHtml(details)}</div>`;
        const lines = Object.entries(details).map(([k, v]) =>
            `<span class="key">"${escHtml(k)}"</span>: <span class="val">${escHtml(JSON.stringify(v))}</span>`
        ).join(',\n');
        return `<div class="code-block">{\n${lines}\n}</div>`;
    }

    function escHtml(s) {
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    /* ── Session ID ── */
    function getOrCreateSession() {
        let id = sessionStorage.getItem('hrflow_ai_session');
        if (!id) {
            id = 'sess_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
            sessionStorage.setItem('hrflow_ai_session', id);
        }
        return id;
    }

    /* ── Clear conversation ── */
    document.getElementById('clearBtn').addEventListener('click', async () => {
        if (!confirm('Effacer cette conversation ?')) return;

        // Clear server-side session memory
        const sessionId = sessionStorage.getItem('hrflow_ai_session');
        if (sessionId) {
            try {
                await fetch('{{ path("app_rh_ai_chat_clear") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest',
                    },
                    body: JSON.stringify({ session_id: sessionId }),
                });
            } catch (e) {
                console.log('[AI Chat] Server clear failed, continuing with local clear');
            }
        }

        $list.innerHTML = '';
        showWelcome(true);
        state.messages = [];
        state.toolCount = state.msgCount = state.candsAnalyzed = state.planned = 0;
        state.activeJob = null;
        state.memory = [];
        updateStats();
        document.getElementById('memoryList').innerHTML = `
            <div class="mem-item">
                <div class="mem-icon teal">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.354a15.055 15.055 0 01-4.5 0M4.5 9.75a7.5 7.5 0 1115 0c0 4.97-3.375 9-7.5 9s-7.5-4.03-7.5-9z"/></svg>
                </div>
                <div class="mem-text">La mémoire de session s'affichera ici au fil des échanges.</div>
            </div>`;
        document.getElementById('activeJobTitle').textContent = 'Aucune offre sélectionnée';
        document.getElementById('activeJobMeta').textContent  = 'Mentionnez un Job ID dans le chat';
        document.getElementById('activeJobBadge').style.display = 'none';
        document.getElementById('activeJobTags').innerHTML = '';
        sessionStorage.removeItem('hrflow_ai_session');
    });

    /* ── Export ── */
    document.getElementById('exportBtn').addEventListener('click', () => {
        const lines = Array.from($list.querySelectorAll('.msg-row')).map(row => {
            const role = row.classList.contains('user') ? 'RH' : 'AI';
            const text = row.querySelector('.msg-bubble')?.innerText || '';
            return `[${role}] ${text}`;
        });
        const blob = new Blob([lines.join('\n\n')], { type: 'text/plain' });
        const url  = URL.createObjectURL(blob);
        const a    = document.createElement('a');
        a.href     = url;
        a.download = `hrflow-ai-${Date.now()}.txt`;
        a.click();
        URL.revokeObjectURL(url);
    });

    /* ── Action buttons in context panel ── */
    document.querySelectorAll('.action-btn[data-prompt]').forEach(btn => {
        btn.addEventListener('click', () => {
            $input.value = btn.dataset.prompt;
            $input.dispatchEvent(new Event('input'));
            $input.focus();
        });
    });

    /* ── Init ── */
    showWelcome(true);
    updateStats();

})();
</script>
{% endblock %}
