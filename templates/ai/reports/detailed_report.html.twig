<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body { 
            font-family: 'Helvetica', sans-serif; 
            color: #334155; 
            line-height: 1.6;
            margin: 0;
            padding: 0;
        }
        
        /* Professional header with border */
        .header { 
            background: #0f172a;
            color: white;
            padding: 50px 40px;
            margin-bottom: 30px;
        }
        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
        }
        .logo { 
            font-size: 18px; 
            font-weight: 700; 
            color: #14b8a6;
            letter-spacing: 1px;
        }
        .doc-type {
            font-size: 10px;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 6px 12px;
            border: 1px solid #334155;
            border-radius: 4px;
        }
        .title { 
            font-size: 32px; 
            font-weight: 300; 
            margin: 0 0 12px;
            letter-spacing: -0.5px;
        }
        .subtitle { 
            font-size: 14px; 
            color: #94a3b8;
            margin-bottom: 20px;
        }
        .meta-grid {
            display: flex;
            gap: 40px;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #334155;
        }
        .meta-item {
            font-size: 11px;
            color: #64748b;
        }
        .meta-label {
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }
        .meta-value {
            color: #e2e8f0;
            font-size: 13px;
        }
        
        /* Content area */
        .content { padding: 0 40px 40px; }
        
        /* Executive summary box */
        .exec-summary {
            background: #f8fafc;
            border-left: 4px solid #14b8a6;
            padding: 24px;
            margin-bottom: 30px;
        }
        .exec-summary h3 {
            margin: 0 0 12px;
            font-size: 13px;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .exec-summary p {
            margin: 0;
            font-size: 14px;
            color: #475569;
        }
        
        /* Section styling */
        .section {
            margin-bottom: 30px;
            page-break-inside: avoid;
        }
        .section-title {
            font-size: 13px;
            font-weight: 700;
            color: #0f172a;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 16px;
            padding-bottom: 8px;
            border-bottom: 2px solid #e2e8f0;
        }
        
        /* Stats boxes */
        .stats-grid {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-box {
            flex: 1;
            background: white;
            border: 1px solid #e2e8f0;
            padding: 20px;
            text-align: center;
        }
        .stat-box.accent { border-top: 3px solid #14b8a6; }
        .stat-val { font-size: 28px; font-weight: 700; color: #0f172a; }
        .stat-lbl { font-size: 11px; color: #64748b; text-transform: uppercase; letter-spacing: 1px; margin-top: 6px; }
        
        /* Tables */
        table { 
            width: 100%; 
            border-collapse: collapse; 
            margin: 16px 0;
            font-size: 12px;
        }
        th {
            background: #f1f5f9;
            text-align: left;
            padding: 14px;
            font-size: 10px;
            font-weight: 700;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #cbd5e1;
        }
        td {
            padding: 14px;
            border-bottom: 1px solid #e2e8f0;
            color: #475569;
        }
        tr:nth-child(even) { background: #f8fafc; }
        
        /* Highlight boxes */
        .highlight-box {
            background: #fefce8;
            border: 1px solid #fde047;
            padding: 20px;
            margin: 16px 0;
        }
        .info-box {
            background: #eff6ff;
            border: 1px solid #3b82f6;
            padding: 20px;
            margin: 16px 0;
        }
        
        /* Status indicators */
        .status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            font-weight: 500;
        }
        .status::before {
            content: '';
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }
        .status.success { color: #059669; }
        .status.success::before { background: #10b981; }
        .status.warning { color: #d97706; }
        .status.warning::before { background: #f59e0b; }
        .status.danger { color: #dc2626; }
        .status.danger::before { background: #ef4444; }
        
        /* Footer */
        .footer {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            padding: 16px 40px;
            font-size: 10px;
            color: #94a3b8;
            display: flex;
            justify-content: space-between;
        }
        
        /* Page break helpers */
        .page-break { page-break-after: always; }
    </style>
</head>
<body>
    <div class="header">
        <div class="header-top">
            <div class="logo">HrFlow AI</div>
            <div class="doc-type">Rapport Détaillé</div>
        </div>
        <h1 class="title">{{ title }}</h1>
        {% if subtitle %}<div class="subtitle">{{ subtitle }}</div>{% endif %}
        
        <div class="meta-grid">
            <div class="meta-item">
                <div class="meta-label">Généré par</div>
                <div class="meta-value">{{ user_name }}</div>
            </div>
            {% if include_date %}
            <div class="meta-item">
                <div class="meta-label">Date</div>
                <div class="meta-value">{{ "now"|date("d/m/Y H:i") }}</div>
            </div>
            {% endif %}
            <div class="meta-item">
                <div class="meta-label">Classification</div>
                <div class="meta-value">Confidentiel</div>
            </div>
        </div>
    </div>

    <div class="content">
        {# Executive Summary / Stats #}
        {% if stats is defined and stats|length > 0 %}
        <div class="exec-summary">
            <h3>Résumé Exécutif</h3>
            <div class="stats-grid">
                {% for stat in stats %}
                <div class="stat-box accent">
                    <div class="stat-val">{{ stat.value }}</div>
                    <div class="stat-lbl">{{ stat.label }}</div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        {# Main Content Sections #}
        {{ custom_content|raw }}
    </div>

    <div class="footer">
        <span>{{ footer_text|default('HrFlow Recruitment System') }}</span>
        <span>Page {PAGE_NUM} sur {PAGE_COUNT}</span>
    </div>
</body>
</html>
