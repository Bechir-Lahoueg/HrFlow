<!DOCTYPE html>
<html lang="fr">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"></head>
<body style="margin:0;padding:0;background:#f5f3ff;font-family:'Segoe UI',Roboto,Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:radial-gradient(circle at top,#ede9fe 0%,#f5f3ff 45%,#fafafa 100%);padding:40px 12px;">
<tr><td align="center">
<table width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:18px;overflow:hidden;box-shadow:0 10px 30px rgba(124,58,237,0.12);">

    {# Header #}
    <tr><td style="padding:20px 32px 12px;background:#ffffff;text-align:center;">
        <img src="{{ absolute_url(asset('logo.png')) }}" alt="HrFlow" width="124" style="display:block;margin:0 auto;border:0;outline:none;text-decoration:none;max-width:124px;height:auto;">
    </td></tr>

    <tr><td style="background:linear-gradient(140deg,#6d28d9,#8b5cf6 45%,#a78bfa);padding:30px 32px;">
        <p style="margin:0;color:rgba(255,255,255,0.92);font-size:12px;letter-spacing:0.8px;text-transform:uppercase;font-weight:700;">Escalade exception</p>
        <h1 style="margin:8px 0 0;color:#fff;font-size:24px;font-weight:800;line-height:1.2;">Validation administrateur requise</h1>
        <p style="margin:8px 0 0;color:rgba(255,255,255,0.9);font-size:14px;line-height:1.5;">Cette demande exceptionnelle attend votre decision finale.</p>
    </td></tr>

    {# Body #}
    <tr><td style="padding:30px 32px 28px;">
        <p style="margin:0 0 16px;color:#18181b;font-size:15px;">Bonjour Administrateur,</p>

        <p style="margin:0 0 20px;color:#3f3f46;font-size:14px;line-height:1.6;">
            Une demande de conge exceptionnelle de <strong>{{ employee.fullName }}</strong>
            a ete <strong style="color:#059669;">pre-approuvee par le RH</strong> et necessite votre validation finale.
        </p>

        <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border-radius:12px;border:1px solid #e2e8f0;margin-bottom:20px;">
            <tr><td style="padding:16px;">
                <table width="100%" cellpadding="0" cellspacing="0">
                    <tr>
                        <td style="color:#71717a;font-size:12px;font-weight:600;padding:4px 0;">EMPLOYE</td>
                        <td style="color:#18181b;font-size:13px;text-align:right;padding:4px 0;">{{ employee.fullName }}</td>
                    </tr>
                    <tr>
                        <td style="color:#71717a;font-size:12px;font-weight:600;padding:4px 0;">TYPE</td>
                        <td style="color:#18181b;font-size:13px;text-align:right;padding:4px 0;">{{ leave.leaveType }}</td>
                    </tr>
                    <tr>
                        <td style="color:#71717a;font-size:12px;font-weight:600;padding:4px 0;">PERIODE</td>
                        <td style="color:#18181b;font-size:13px;text-align:right;padding:4px 0;">{{ leave.startDate|date('d/m/Y') }} — {{ leave.endDate|date('d/m/Y') }}</td>
                    </tr>
                    <tr>
                        <td style="color:#71717a;font-size:12px;font-weight:600;padding:4px 0;">JOURS</td>
                        <td style="color:#18181b;font-size:13px;text-align:right;padding:4px 0;">{{ leave.daysCount }} jour{{ leave.daysCount > 1 ? 's' : '' }}</td>
                    </tr>
                    {% if leave.urgencyLevel %}
                    <tr>
                        <td style="color:#71717a;font-size:12px;font-weight:600;padding:4px 0;">URGENCE</td>
                        <td style="font-size:13px;text-align:right;padding:4px 0;">
                            {% if leave.urgencyLevel == 'HIGH' %}
                                <span style="color:#dc2626;font-weight:700;">HIGH</span>
                            {% elseif leave.urgencyLevel == 'MEDIUM' %}
                                <span style="color:#d97706;font-weight:700;">MEDIUM</span>
                            {% else %}
                                <span style="color:#6b7280;">LOW</span>
                            {% endif %}
                        </td>
                    </tr>
                    {% endif %}
                    {% if leave.reason %}
                    <tr>
                        <td style="color:#71717a;font-size:12px;font-weight:600;padding:4px 0;">MOTIF</td>
                        <td style="color:#18181b;font-size:13px;text-align:right;padding:4px 0;">{{ leave.reason }}</td>
                    </tr>
                    {% endif %}
                </table>
            </td></tr>
        </table>

        {% if leave.rhComment %}
        <table width="100%" cellpadding="0" cellspacing="0" style="background:#f0fdf4;border-radius:8px;border:1px solid #bbf7d0;margin-bottom:20px;">
            <tr><td style="padding:16px;">
                <p style="margin:0 0 4px;color:#166534;font-size:12px;font-weight:600;">COMMENTAIRE RH</p>
                <p style="margin:0;color:#15803d;font-size:13px;">{{ leave.rhComment }}</p>
            </td></tr>
        </table>
        {% endif %}

        <p style="margin:0;color:#64748b;font-size:12px;line-height:1.6;">Connectez-vous a HrFlow pour approuver ou refuser cette demande.</p>
    </td></tr>

    {# Footer #}
    <tr><td style="padding:18px 32px 24px;border-top:1px solid #eef2f7;text-align:center;background:#fcfbff;">
        <p style="margin:0;color:#94a3b8;font-size:11px;">HrFlow - Gestion des ressources humaines</p>
    </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
