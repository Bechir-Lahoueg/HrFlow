<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
    <meta name="x-apple-disable-message-reformatting">
    <title>Certificat disponible – HR Flow</title>
    <style>
        @media (max-width: 450px) {
            .mobile-hide { display: none !important; }
            .mobile-show { display: table !important; }
            .mobile-full { width: 100% !important; }
        }
    </style>
</head>
<body style="width:100%;-webkit-text-size-adjust:100%;text-size-adjust:100%;background-color:#f0f1f5;margin:0;padding:0;">

<table width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#f0f1f5" style="background-color:#f0f1f5;">
    <tbody>
    <tr>
        <td style="background-color:#f0f1f5;">

            <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation"
                   style="max-width:600px;min-height:600px;margin:0 auto;background-color:#ffffff;">
                <tbody>

                {# ── Header dégradé ── #}
                <tr>
                    <td style="vertical-align:top;">
                        <table border="0" cellpadding="0" cellspacing="0" align="center"
                               style="width:100%;max-width:100%;background:linear-gradient(90deg,#3fa9f5,#145eb7,#022e69);">
                            <tbody>
                            <tr>
                                <td style="text-align:center;padding:16px 20px;">
                                    <table border="0" cellpadding="0" cellspacing="0"
                                           style="width:100%;max-width:538px;margin:0 auto;">
                                        <tbody>
                                        <tr>
                                            <td style="vertical-align:middle;">
                                                <span style="color:#ffffff;font-size:17px;font-weight:700;
                                                             font-family:Helvetica,Arial,sans-serif;
                                                             line-height:1.2;display:block;text-align:right;">
                                                    Certificat disponible – HR Flow
                                                </span>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>

                {# ── Corps principal ── #}
                <tr>
                    <td style="vertical-align:top;padding:0;">
                        <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation">
                            <tbody>

                            {# Salutation + intro #}
                            <tr>
                                <td style="padding:20px 20px 0;">
                                    <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0"
                                           role="presentation"
                                           style="font-family:Helvetica,Arial,sans-serif;border-collapse:collapse;">
                                        <tbody>
                                        <tr>
                                            <td style="color:#022e69;font-size:14px;text-align:left;">
                                                Bonjour <strong>{{ employee.fullName }}</strong>,
                                                <br><br>
                                                Félicitations ! Votre certificat pour la formation
                                                <strong>{{ formation.titre }}</strong> est maintenant disponible.
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                            <tr><td style="height:16px;">&nbsp;</td></tr>

                            {# Bloc "Certificat disponible" #}
                            <tr>
                                <td style="padding:0 20px;">
                                    <table border="0" cellpadding="0" cellspacing="0"
                                           style="width:100%;border-collapse:separate;border-spacing:0;">
                                        <tbody>
                                        <tr>
                                            {# Icône / illustration #}
                                            <td width="22%" style="vertical-align:middle;border-radius:20px;">
                                                <img src="{{ absolute_url(asset('images/certificate.png')) }}"
                                                     width="125" height="99" alt="Certificat"
                                                     style="display:block;width:100%;height:auto;max-width:125px;">
                                            </td>
                                            <td width="17px" style="font-size:0;">&nbsp;</td>
                                            {# Texte #}
                                            <td style="vertical-align:middle;background-color:#ffffff;
                                                       border-radius:20px;padding:11px;
                                                       border:1px solid #e8eaf0;">
                                                <span style="color:#022e69;font-size:16px;font-weight:700;
                                                             font-family:Helvetica,Arial,sans-serif;display:block;">
                                                    Votre certificat est prêt
                                                </span>
                                                <span style="color:#022e69;font-size:13px;
                                                             font-family:Helvetica,Arial,sans-serif;
                                                             display:block;margin-top:10px;line-height:1.5;">
                                                    Connectez-vous à votre espace employé HR Flow, ouvrez la section
                                                    <strong>Mes Demandes</strong>, puis téléchargez votre certificat.
                                                </span>
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                            <tr><td style="height:16px;">&nbsp;</td></tr>

                            {# Titre détails formation #}
                            <tr>
                                <td style="color:#022e69;font-size:19px;font-weight:700;
                                           font-family:Helvetica,Arial,sans-serif;
                                           text-align:center;padding:0 20px;">
                                    Détails de la formation
                                </td>
                            </tr>

                            <tr><td style="height:16px;">&nbsp;</td></tr>

                            {# Tableau des détails #}
                            <tr>
                                <td style="padding:0 20px;">
                                    <table border="0" cellpadding="0" cellspacing="0"
                                           style="width:100%;border-collapse:collapse;">
                                        <tbody>
                                        {# En-têtes #}
                                        <tr>
                                            <td style="padding:10px;border:2px solid #cccccc;
                                                       color:#022e69;font-size:13px;font-weight:700;
                                                       font-family:Helvetica,Arial,sans-serif;
                                                       text-align:center;width:50%;">
                                                Formation
                                            </td>
                                            <td style="padding:10px;border:2px solid #cccccc;
                                                       color:#022e69;font-size:13px;font-weight:700;
                                                       font-family:Helvetica,Arial,sans-serif;
                                                       text-align:center;width:50%;">
                                                Employé
                                            </td>
                                        </tr>
                                        {# Valeurs dynamiques #}
                                        <tr>
                                            <td style="padding:10px;border:2px solid #cccccc;
                                                       color:#022e69;font-size:13px;
                                                       font-family:Helvetica,Arial,sans-serif;
                                                       text-align:center;">
                                                {{ formation.titre }}
                                            </td>
                                            <td style="padding:10px;border:2px solid #cccccc;
                                                       color:#022e69;font-size:13px;
                                                       font-family:Helvetica,Arial,sans-serif;
                                                       text-align:center;">
                                                {{ employee.fullName }}
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                            <tr><td style="height:16px;">&nbsp;</td></tr>

                            {# Message bas du tableau #}
                            <tr>
                                <td style="color:#022e69;font-size:13px;
                                           font-family:Helvetica,Arial,sans-serif;
                                           text-align:center;padding:0 20px;line-height:1.6;">
                                    Bravo pour votre progression et bonne continuation sur HR Flow.
                                </td>
                            </tr>

                            <tr><td style="height:16px;">&nbsp;</td></tr>

                            {# Séparateur #}
                            <tr>
                                <td style="padding:0 20px;">
                                    <table cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                                        <tbody>
                                        <tr>
                                            <td style="height:1px;background-color:#000000;line-height:1px;font-size:0;">&nbsp;</td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                            <tr><td style="height:16px;">&nbsp;</td></tr>

                            {# Section Next Steps #}
                            <tr>
                                <td style="color:#022e69;font-size:25px;font-weight:700;
                                           font-family:Helvetica,Arial,sans-serif;
                                           text-align:center;padding:0 20px;">
                                    Next Steps
                                </td>
                            </tr>

                            <tr><td style="height:16px;">&nbsp;</td></tr>

                            <tr>
                                <td style="padding:0 20px;">
                                    <table width="100%" cellpadding="0" cellspacing="0"
                                           style="border-collapse:collapse;font-family:Helvetica,Arial,sans-serif;">
                                        <tbody>
                                        <tr>
                                            <td style="width:24px;vertical-align:top;padding-right:8px;
                                                       text-align:right;white-space:nowrap;">
                                                <span style="font-size:13px;color:#022e69;">•</span>
                                            </td>
                                            <td style="font-size:13px;color:#022e69;vertical-align:top;padding-bottom:8px;">
                                                <strong>Télécharger votre certificat :</strong>
                                                connectez-vous à votre espace employé, puis accédez à la section <strong>Mes Demandes</strong>.
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="width:24px;vertical-align:top;padding-right:8px;
                                                       text-align:right;white-space:nowrap;">
                                                <span style="font-size:13px;color:#022e69;">•</span>
                                            </td>
                                            <td style="font-size:13px;color:#022e69;vertical-align:top;padding-bottom:8px;">
                                                <strong>Partager votre réussite :</strong>
                                                ajoutez votre certificat à votre profil professionnel pour valoriser votre progression.
                                            </td>
                                        </tr>
                                        <tr>
                                            <td style="width:24px;vertical-align:top;padding-right:8px;
                                                       text-align:right;white-space:nowrap;">
                                                <span style="font-size:13px;color:#022e69;">•</span>
                                            </td>
                                            <td style="font-size:13px;color:#022e69;vertical-align:top;">
                                                <strong>Contacter le support :</strong>
                                                pour toute question, contactez notre équipe d'assistance
                                                &lt; <a href="mailto:hr.flow26@gmail.com"
                                                        style="color:#022e69;text-decoration:none;">hr.flow26@gmail.com</a> &gt;
                                            </td>
                                        </tr>
                                        </tbody>
                                    </table>
                                </td>
                            </tr>

                            <tr><td style="height:24px;">&nbsp;</td></tr>

                            </tbody>
                        </table>
                    </td>
                </tr>

                {# ── Footer dégradé ── #}
                <tr>
                    <td style="vertical-align:top;">
                        <table border="0" cellpadding="0" cellspacing="0" align="center"
                               style="width:100%;max-width:100%;
                                      background:linear-gradient(90deg,#3fa9f5,#145eb7,#022e69);">
                            <tbody>
                            <tr>
                                <td style="padding:20px;text-align:center;">
                                    <span style="color:#ffffff;font-size:11px;
                                                 font-family:Helvetica,Arial,sans-serif;
                                                 line-height:1.4;display:block;">
                                        HR Flow, gestion des ressources humaines<br>
                                        &copy; {{ "now"|date("Y") }} HR Flow, Inc. All rights reserved. &nbsp; Privacy Policy
                                    </span>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>

                </tbody>
            </table>

        </td>
    </tr>
    </tbody>
</table>

</body>
</html>
